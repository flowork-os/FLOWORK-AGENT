# [FL_INDEX: keywords="gitignore, security, credentials, dev_flowork, hygiene" | purpose="Standard Git ignore rules to prevent credential and residual leak"]
# Flowork OS & Developer sensitive files
**/.flowork/*.flowork
**/.flowork/dev.flowork
!**/.flowork/.gitkeep
*.flowork
*.secret
*.key
*.pem
*.token
*.env
*.env.*
!.env.example
akungithub
akungithub.txt
*vault*.json
account_pool.json
cloud_soul.json
flowrk-standalone-oauth-token

# Large model blobs (> 100MB exceeds GitHub hard limit)
**/.flowork/models/**/blobs/
**/models/**/blobs/

# Temporary and cache directories
.FL_BIN/
.flowork_spam/
**/target/
**/node_modules/
**/__pycache__/
*.pyc
*.log

# OS generated files
.DS_Store
Thumbs.db

# Developer Mode & Circuit Breaker Triggers
dev.flowork
dev.flow
devloper.flow
*.flowork
*.flow

# Developer Feature Upload & Multi-OS Sync Scripts (Private/Local)
upload_features.*
deploy_features.*
sync_features.*
upload_to_os.*
upload_to_repo.*
upload_to_github.*
sync_upstream.*


# Protected Developer & Enclave Assets (Zero-Leak)
promp/
**/promp/
prompts/
**/prompts/
DEVLOPER/connector/
**/connector/
**/sealed_connector/
**/sealed_tools/
GEMINI.md
AGENTS.md


models_cache/

# =============================================================================
# 🔒 STRICT SOVEREIGN ENCLAVE: ROOT DIRECTORY RESTRICTION
# Doktrin: HANYA DEVLOPER/ yang boleh dilacak di repositori project ini.
# Segala direktori dan skrip distribusi dilarang keras masuk git.
# =============================================================================
/flowork/
/flowork-lander/
/linux/
/macos/
/windows/
/prompts_extracted/
/runtimes/
/swarmflow/
/system/
/*.bat
/*.sh
/*.ps1
/*.exe
/*.command
/*.desktop
/*.tar*
/*.zip
/STRUCTURE.MD
/VERSION
/README.MD
/FL_GOAL.MD
/release_checksums.json
