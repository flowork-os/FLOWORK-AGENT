# [FL_INDEX: keywords="gitignore, security, credentials, dev_flowork, hygiene" | purpose="Standard Git ignore rules to prevent credential and residual leak"]
# Flowork OS & Developer sensitive files
**/.flowork/*.flowork
**/.flowork/dev.flowork
!**/.flowork/.gitkeep
*.flowork
*.secret
*.key
*.pem
*.token
*.env
*.env.*
!.env.example
akungithub
akungithub.txt
*vault*.json
account_pool.json
cloud_soul.json
flowrk-standalone-oauth-token

# Large model blobs (> 100MB exceeds GitHub hard limit)
**/.flowork/models/**/blobs/
**/models/**/blobs/

# Temporary and cache directories
.FL_BIN/
.flowork_spam/
**/target/
**/node_modules/
**/__pycache__/
*.pyc
*.log

# OS generated files
.DS_Store
Thumbs.db

# Developer Mode & Circuit Breaker Triggers
dev.flowork
dev.flow
devloper.flow
*.flowork
*.flow

# Developer Feature Upload & Multi-OS Sync Scripts (Private/Local)
upload_features.*
deploy_features.*
sync_features.*
upload_to_os.*
upload_to_repo.*
upload_to_github.*
sync_upstream.*


# Ensure fallback sealed_connector is tracked for non-AVX2 fallback
!**/portable-home/.flowork/sealed_connector/**
