{
  "version": "1.0.0",
  "policy": "sovereign_zero_trust",
  "blacklisted_commands": [
    "rm -rf /",
    "rm -rf /*",
    "mkfs",
    "dd if=",
    ":(){ :|:& };:"
  ],
  "protected_paths": [
    "/etc/shadow",
    "/etc/sudoers",
    "~/.ssh/id_rsa",
    "~/.ssh/id_ed25519"
  ],
  "protected_tokens": [
    "@lock",
    "@frozen",
    "@endlock",
    "@endfrozen"
  ]
}
