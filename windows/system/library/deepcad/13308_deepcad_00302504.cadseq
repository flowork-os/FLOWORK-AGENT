# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00302504" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.078125, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.594079, 0.000000).threePointArc((0.668339, 0.074260), (0.594079, 0.148520)).lineTo(0.000000, 0.148520).threePointArc((-0.074260, 0.074260), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.077796).circle(0.035362)
loop2=wp_sketch0.moveTo(0.594079, 0.077796).circle(0.035362)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
