loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.053785, -0.129849), (0.183635, -0.183635)).lineTo(0.398931, -0.183635).threePointArc((0.542213, -0.124285), (0.601562, 0.018997)).lineTo(0.601562, 0.025329).threePointArc((0.547777, 0.155178), (0.417928, 0.208964)).lineTo(0.202632, 0.208964).threePointArc((0.059349, 0.149614), (0.000000, 0.006332)).lineTo(0.000000, 0.000000).close()
