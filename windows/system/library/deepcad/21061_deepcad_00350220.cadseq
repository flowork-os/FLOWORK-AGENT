# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00350220" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, -0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.289062, 0.000000).lineTo(0.289062, 0.289062).lineTo(0.270806, 0.289062).lineTo(0.270806, 0.018257).lineTo(0.018257, 0.018257).lineTo(0.018257, 0.289062).lineTo(0.000000, 0.289062).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.249671, 0.000000).lineTo(0.249671, 0.515625).lineTo(0.184539, 0.515625).threePointArc((0.127549, 0.458635), (0.070559, 0.515625)).lineTo(0.000000, 0.515625).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.032566, 0.483059).circle(0.016283)
loop3=wp_sketch1.moveTo(0.124836, 0.217105).circle(0.097697)
loop4=wp_sketch1.moveTo(0.124836, 0.054276).circle(0.027138)
loop5=wp_sketch1.moveTo(0.124836, 0.379934).circle(0.027138)
loop6=wp_sketch1.moveTo(0.217105, 0.483059).circle(0.016283)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).extrude(0.023438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
