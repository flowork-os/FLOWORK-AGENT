# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267109" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, -0.453125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.328125, 0.000000).lineTo(1.328125, 0.838816).lineTo(0.000000, 0.838816).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.181743, 0.657072).circle(0.069901)
loop2=wp_sketch0.moveTo(0.433388, 0.657072).lineTo(0.517270, 0.657072).lineTo(0.559211, 0.726974).lineTo(0.517270, 0.796875).lineTo(0.447368, 0.796875).lineTo(0.405428, 0.726974).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.296875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, 0.000000, 0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.071053, 0.000000).circle(0.069572)
solid1=wp_sketch1.add(loop3).extrude(0.359375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
