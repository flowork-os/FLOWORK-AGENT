# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00353890" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.505263, 0.094737).lineTo(0.678947, 0.410526).lineTo(0.315789, 0.394737).close()
loop2=wp_sketch0.moveTo(0.457895, -0.442105).lineTo(0.584211, -0.410526).lineTo(0.584211, -0.268421).lineTo(0.457895, -0.236842).lineTo(0.394737, -0.331579).close()
loop3=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.189474)
loop4=wp_sketch0.moveTo(1.105263, 0.300000).circle(0.078947)
loop5=wp_sketch0.moveTo(1.294737, -0.110526).lineTo(1.294737, 0.000000).lineTo(1.136842, 0.000000).lineTo(1.136842, -0.110526).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.093750, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
