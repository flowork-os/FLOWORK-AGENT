# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00254509" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.632812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.070312, 0.000000).lineTo(0.070312, 0.069572).lineTo(0.000000, 0.069572).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.562500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.140625, 0.000000).lineTo(0.140625, 0.139145).lineTo(0.068092, 0.139145).lineTo(0.068092, 0.072533).lineTo(0.000000, 0.072533).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.101562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.632812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.118421, 0.000000).circle(0.118421)
loop3=wp_sketch2.moveTo(0.192434, -0.074013).lineTo(0.192434, 0.069079).lineTo(0.118421, 0.069079).lineTo(0.049342, 0.069079).lineTo(0.049342, 0.000000).lineTo(0.049342, -0.074013).close()
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.101562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
