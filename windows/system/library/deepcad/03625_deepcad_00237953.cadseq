import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.205263, 0.000000).circle(0.205263)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.061324, -0.124117), (0.188158, -0.179605)).lineTo(0.188158, -0.076974).threePointArc((0.147005, -0.056769), (0.124013, -0.017105)).lineTo(0.021382, -0.017105).close()
loop2=wp_sketch0.moveTo(0.124013, 0.017105).threePointArc((0.147005, 0.056769), (0.188158, 0.076974)).lineTo(0.188158, 0.179605).threePointArc((0.075134, 0.128770), (0.021382, 0.017105)).close()
loop3=wp_sketch0.moveTo(0.205263, 0.000000).circle(0.038487)
loop4=wp_sketch0.moveTo(0.021382, 0.017105).threePointArc((0.196886, -0.066290), (0.384868, -0.017105)).lineTo(0.282237, -0.017105).threePointArc((0.259245, -0.056769), (0.218092, -0.076974)).lineTo(0.218092, -0.179605).close()
loop5=wp_sketch0.moveTo(0.218092, -0.179605).threePointArc((0.220329, -0.071521), (0.282237, 0.017105)).lineTo(0.384868, 0.017105).threePointArc((0.331116, 0.128770), (0.218092, 0.179605)).lineTo(0.218092, 0.076974).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
