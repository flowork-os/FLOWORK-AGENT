wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.164062, -0.023438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.076480, -0.642434).threePointArc((0.168257, -0.724595), (0.260033, -0.642434)).lineTo(0.328865, 0.000000).threePointArc((0.164433, 0.183676), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.091776, -0.642434).threePointArc((0.168257, -0.710902), (0.244737, -0.642434)).lineTo(0.321217, 0.000000).threePointArc((0.168257, 0.170861), (0.015296, 0.000000)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
