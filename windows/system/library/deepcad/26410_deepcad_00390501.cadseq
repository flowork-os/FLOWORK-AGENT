# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00390501" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.562500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.055496, -0.133978), (0.189474, -0.189474)).lineTo(1.310526, -0.189474).threePointArc((1.444504, -0.133978), (1.500000, 0.000000)).lineTo(1.500000, 1.121053).threePointArc((1.444504, 1.255031), (1.310526, 1.310526)).lineTo(0.189474, 1.310526).threePointArc((0.055496, 1.255031), (0.000000, 1.121053)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.757895, 0.568421).circle(0.110526)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
