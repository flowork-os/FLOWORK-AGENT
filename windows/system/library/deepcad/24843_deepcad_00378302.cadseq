# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00378302" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.921875, 0.000000).lineTo(0.921875, 0.116447).lineTo(0.203783, 0.116447).lineTo(0.203783, 0.766612).lineTo(0.921875, 0.766612).lineTo(0.921875, 0.883059).lineTo(0.000000, 0.883059).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.726562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.078125, 0.359375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.201316, 0.000000).circle(0.201316)
loop2=wp_sketch1.moveTo(0.201316, 0.000000).circle(0.109046)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.070312)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.164062, 0.359375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.110526, 0.000000).circle(0.110526)
solid2=wp_sketch2.add(loop3).extrude(-0.070312)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
