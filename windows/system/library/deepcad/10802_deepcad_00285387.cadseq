# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.039062, 0.039062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.106250, -0.109375).lineTo(0.256250, -0.071875).lineTo(0.296875, 0.075000).lineTo(0.190625, 0.184375).lineTo(0.040625, 0.146875).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(-0.179688)
