import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.678947).lineTo(0.000000, 0.678947).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.047368, 0.047368).circle(0.031579)
loop2=wp_sketch0.moveTo(0.047368, 0.631579).circle(0.031579)
loop3=wp_sketch0.moveTo(1.452632, 0.047368).circle(0.031579)
loop4=wp_sketch0.moveTo(1.452632, 0.631579).circle(0.031579)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.268421, 0.000000).circle(0.268421)
solid1=wp_sketch1.add(loop5).extrude(0.414062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.171875, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.268421, 0.000000).circle(0.268421)
solid2=wp_sketch2.add(loop6).extrude(0.414062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.171875, 0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch3.moveTo(0.343750, 0.000000).lineTo(0.343750, 0.148355).lineTo(0.000000, 0.148355).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop7).extrude(0.109375)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, -0.328125, 0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch4.moveTo(0.312500, 0.000000).lineTo(0.312500, 0.075658).lineTo(0.000000, 0.075658).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop8).extrude(0.062500)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
