# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00293493" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.595066, 0.000000).lineTo(0.595066, 0.749342).threePointArc((0.297533, 1.046875), (0.000000, 0.749342)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.154276, 0.154276).circle(0.033059)
loop2=wp_sketch0.moveTo(0.297533, 0.749342).circle(0.077138)
loop3=wp_sketch0.moveTo(0.297533, 0.154276).circle(0.033059)
loop4=wp_sketch0.moveTo(0.451809, 0.154276).circle(0.033059)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
