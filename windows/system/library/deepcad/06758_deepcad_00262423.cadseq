# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00262423" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.585938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.168421).lineTo(0.000000, 1.168421).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.468421, 0.047368).lineTo(1.468421, 1.136842).lineTo(0.031579, 1.136842).lineTo(0.031579, 0.047368).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.078125, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, -0.546875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.429688, 0.000000).lineTo(1.429688, 1.083553).lineTo(0.000000, 1.083553).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(1.384539, 0.030099).lineTo(1.384539, 1.053454).lineTo(0.045148, 1.053454).lineTo(0.045148, 0.030099).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.507812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(1.351562, 0.000000).lineTo(1.351562, 1.010115).lineTo(0.000000, 1.010115).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.070312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
