# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00254876" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.061087, -0.069532), (0.140625, -0.022204)).threePointArc((0.317051, 0.316959), (0.658717, 0.488487)).threePointArc((0.702344, 0.571100), (0.629112, 0.629112)).threePointArc((0.184263, 0.444849), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.555099, 0.555099).circle(0.037007)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
