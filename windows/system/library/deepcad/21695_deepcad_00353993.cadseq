loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.042657, -0.102984), (0.145641, -0.145641)).lineTo(1.257812, -0.145641).lineTo(1.257812, 0.278043).lineTo(0.556086, 0.278043).threePointArc((0.459722, 0.323442), (0.423684, 0.423684)).lineTo(0.423684, 1.257812).lineTo(0.000000, 1.257812).lineTo(0.000000, 0.000000).close()
