# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.382812, 0.000000).lineTo(1.382812, 0.014556).lineTo(1.106250, 0.014556).lineTo(1.106250, 0.043668).lineTo(0.829688, 0.043668).lineTo(0.829688, 0.058224).lineTo(0.553125, 0.058224).lineTo(0.553125, 0.072780).lineTo(0.276562, 0.072780).lineTo(0.276562, 0.087336).lineTo(0.000000, 0.087336).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.273438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
