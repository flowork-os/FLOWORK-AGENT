# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00286353" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.134211, 0.000000).circle(0.134211)
loop1=wp_sketch0.moveTo(0.134211, 0.000000).circle(0.044737)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.484375, 0.000000, 0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.134211, 0.000000).circle(0.134211)
loop3=wp_sketch1.moveTo(0.134211, 0.000000).circle(0.044737)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.085938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, 0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.344243, -0.703454).threePointArc((0.533867, -0.748656), (0.538816, -0.553783)).threePointArc((0.535141, -0.063551), (1.017763, -0.149671)).threePointArc((1.090458, -0.207409), (1.182401, -0.194572)).lineTo(1.421875, -0.059868).threePointArc((1.217249, 0.018173), (1.347039, 0.194572)).lineTo(0.119737, 0.194572).threePointArc((0.234087, -0.009925), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.359211, -0.089803).circle(0.044901)
loop6=wp_sketch2.moveTo(0.449013, -0.643586).circle(0.044901)
loop7=wp_sketch2.moveTo(1.122533, -0.089803).circle(0.044901)
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).add(loop7).extrude(0.085938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
