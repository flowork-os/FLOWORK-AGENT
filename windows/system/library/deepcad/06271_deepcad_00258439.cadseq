# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.296875, 0.625000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch5.moveTo(0.000000, 0.000000).threePointArc((-0.021502, -0.118910), (0.033388, -0.226562)).lineTo(0.071546, -0.226562).threePointArc((0.041437, -0.100256), (0.102549, 0.014309)).lineTo(0.000000, 0.000000).close()
