import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.351562, 0.000000).lineTo(0.351562, 0.299753).lineTo(0.000000, 0.299753).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.625000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.023438, -0.625000, 0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.150000, 0.000000).circle(0.150000)
loop2=wp_sketch1.moveTo(0.150000, 0.000000).circle(0.087500)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.125000)
solid=solid.union(solid1)
