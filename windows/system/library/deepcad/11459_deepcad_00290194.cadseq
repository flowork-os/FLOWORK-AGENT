# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00290194" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.039474, -0.039474), (0.078947, 0.000000)).lineTo(0.078947, 0.710526).threePointArc((0.039474, 0.750000), (0.000000, 0.710526)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.039474, 0.000000).circle(0.023684)
loop2=wp_sketch0.moveTo(0.039474, 0.710526).circle(0.023684)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.007812, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
