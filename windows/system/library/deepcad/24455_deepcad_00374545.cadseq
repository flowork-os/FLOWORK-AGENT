# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00374545" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.232208, -0.479559), (0.726316, -0.678947)).lineTo(0.726316, -0.031579).lineTo(0.063158, -0.031579).close()
loop2=wp_sketch0.moveTo(0.726316, 0.031579).lineTo(0.726316, 0.678947).threePointArc((0.269878, 0.483167), (0.063158, 0.031579)).close()
loop3=wp_sketch0.moveTo(0.063158, 0.031579).threePointArc((0.737819, -0.264944), (1.436842, -0.031579)).lineTo(0.773684, -0.031579).lineTo(0.773684, -0.678947).close()
loop4=wp_sketch0.moveTo(1.436842, 0.031579).threePointArc((1.230122, 0.483167), (0.773684, 0.678947)).lineTo(0.773684, 0.031579).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
