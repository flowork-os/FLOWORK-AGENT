# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00353740" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.000000, -0.539062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.070312, 0.000000).lineTo(1.070312, 1.070312).lineTo(0.000000, 1.070312).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.539062, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, -0.539062, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.320312, 0.000000).lineTo(0.320312, 0.320312).lineTo(0.000000, 0.320312).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.320312)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.140625, -0.539062, -0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.234375, 0.000000).lineTo(0.115954, 0.180099).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.210938)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, -0.539062, -0.250000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.142105, 0.000000).circle(0.142105)
solid3=wp_sketch3.add(loop3).extrude(0.210938)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.140625, -0.539062, -0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.234375, 0.000000).lineTo(0.115954, 0.180099).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.210938)
solid=solid.union(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.125000, -0.539062, 0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch5.moveTo(0.051727, -0.170395).lineTo(0.231250, -0.173437).lineTo(0.289062, -0.006086).lineTo(0.146053, 0.103454).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop5).extrude(-0.257812)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
