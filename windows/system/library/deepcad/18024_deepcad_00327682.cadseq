# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00327682" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, -0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.960526, 0.000000).threePointArc((1.140625, 0.180099), (0.960526, 0.360197)).lineTo(0.000000, 0.360197).threePointArc((-0.180099, 0.180099), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.180099).circle(0.072039)
loop2=wp_sketch0.moveTo(0.960526, 0.180099).circle(0.084046)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.101562, 0.148438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.476562, 0.000000).lineTo(0.476562, 0.195641).lineTo(0.000000, 0.195641).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.250000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
