# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00385237" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, -0.289062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.828125, 0.000000).lineTo(0.828125, 0.592763).lineTo(0.000000, 0.592763).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.810691, 0.017434).lineTo(0.810691, 0.575329).lineTo(0.017434, 0.575329).lineTo(0.017434, 0.017434).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.726562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
