# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00352370" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.281250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.421875, 0.000000).lineTo(1.421875, 0.613651).lineTo(0.000000, 0.613651).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.194572, 0.104770).circle(0.029934)
loop2=wp_sketch0.moveTo(0.194572, 0.508882).circle(0.029934)
loop3=wp_sketch0.moveTo(0.942928, 0.508882).circle(0.029934)
loop4=wp_sketch0.moveTo(1.287171, 0.104770).circle(0.029934)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.203125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
