# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00247471" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.142105, 0.000000).lineTo(0.142105, -0.521053).lineTo(0.836842, -0.521053).lineTo(0.836842, -0.663158).lineTo(1.500000, -0.663158).lineTo(1.500000, -0.173684).lineTo(0.410526, 0.126316).lineTo(0.000000, 0.126316).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.247368, -0.410526).circle(0.110526)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.398438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.140789, 0.000000).lineTo(0.835938, 0.000000).lineTo(0.835938, 0.140789).lineTo(0.140789, 0.140789).lineTo(0.140789, 0.668750).lineTo(0.000000, 0.668750).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.585938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
