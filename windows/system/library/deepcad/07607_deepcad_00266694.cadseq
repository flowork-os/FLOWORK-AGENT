# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00266694" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, -0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.376974, 0.000000).threePointArc((1.446346, 0.015132), (1.376974, 0.030263)).lineTo(0.000000, 0.030263).threePointArc((-0.069372, 0.015132), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.030263, 0.015132).circle(0.015132)
loop2=wp_sketch0.moveTo(1.407237, 0.015132).circle(0.015132)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
