# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288480" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.209211, 0.000000).circle(0.209211)
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.000000, 0.085938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.422368, 0.000000).circle(0.422368)
loop2=wp_sketch1.moveTo(0.422368, 0.000000).circle(0.211184)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.664062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, 0.750000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.209211, 0.000000).circle(0.209211)
solid2=wp_sketch2.add(loop3).extrude(-0.625000)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.000000, 0.750000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.418421, 0.000000).circle(0.418421)
loop5=wp_sketch3.moveTo(0.418421, 0.000000).circle(0.209211)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(-0.625000)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, 0.539062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.136719, -0.041473), (0.273438, 0.000000)).threePointArc((0.136719, 0.081946), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop6).extrude(-0.406250)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
