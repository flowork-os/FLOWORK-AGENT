import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.218032, -0.526376), (0.744408, -0.744408)).lineTo(1.056579, -0.744408).threePointArc((1.140625, -0.660362), (1.056579, -0.576316)).lineTo(0.744408, -0.576316).threePointArc((0.342894, -0.405030), (0.180099, 0.000000)).lineTo(0.180099, 0.300164).threePointArc((0.090049, 0.390214), (0.000000, 0.300164)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.084046, 0.300164).circle(0.036020)
loop2=wp_sketch0.moveTo(1.056579, -0.660362).circle(0.036020)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.695312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
