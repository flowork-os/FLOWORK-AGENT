wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.083824, -0.014022), (0.154194, -0.061678)).threePointArc((0.400905, -0.167434), (0.647615, -0.061678)).threePointArc((0.717986, -0.014022), (0.801809, 0.000000)).threePointArc((0.977785, 0.169613), (0.801809, 0.339227)).threePointArc((0.717986, 0.353249), (0.647615, 0.400905)).threePointArc((0.400905, 0.506661), (0.154194, 0.400905)).threePointArc((0.083824, 0.353249), (0.000000, 0.339227)).threePointArc((-0.175976, 0.169613), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.010280, 0.164474).circle(0.071957)
loop2=wp_sketch0.moveTo(0.400905, 0.164474).circle(0.236431)
