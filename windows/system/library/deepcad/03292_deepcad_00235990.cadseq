# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00235990" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.268421).lineTo(0.000000, 0.268421).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.031579, 0.015789).threePointArc((0.039474, 0.023684), (0.031579, 0.031579)).lineTo(0.015789, 0.031579).threePointArc((0.007895, 0.023684), (0.015789, 0.015789)).close()
loop2=wp_sketch0.moveTo(0.031579, 0.236842).threePointArc((0.039474, 0.244737), (0.031579, 0.252632)).lineTo(0.015789, 0.252632).threePointArc((0.007895, 0.244737), (0.015789, 0.236842)).close()
loop3=wp_sketch0.moveTo(1.484211, 0.015789).threePointArc((1.492105, 0.023684), (1.484211, 0.031579)).lineTo(1.468421, 0.031579).threePointArc((1.460526, 0.023684), (1.468421, 0.015789)).close()
loop4=wp_sketch0.moveTo(1.484211, 0.236842).threePointArc((1.492105, 0.244737), (1.484211, 0.252632)).lineTo(1.468421, 0.252632).threePointArc((1.460526, 0.244737), (1.468421, 0.236842)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.107072, 0.017270).threePointArc((0.050971, 0.028368), (0.003454, -0.003454)).lineTo(0.105921, -0.003454).threePointArc((0.108363, -0.002442), (0.109375, 0.000000)).lineTo(0.109375, 0.047204).threePointArc((0.108363, 0.049646), (0.105921, 0.050658)).lineTo(0.003454, 0.050658).threePointArc((0.001012, 0.049646), (0.000000, 0.047204)).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch1.moveTo(0.009211, 0.041447).circle(0.004605)
solid1=wp_sketch1.add(loop5).add(loop6).extrude(0.007812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
