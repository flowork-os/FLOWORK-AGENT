solid2=wp_sketch2.add(loop2).extrude(0.750000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.024671, 0.000000).lineTo(0.024671, 0.152961).threePointArc((0.031504, 0.172348), (0.049342, 0.182566)).lineTo(0.194901, 0.204770).lineTo(0.197368, 0.204770).threePointArc((0.208746, 0.220623), (0.194901, 0.234375)).lineTo(0.000000, 0.234375).lineTo(0.000000, 0.000000).close()
