wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, -0.453125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.151974, 0.000000).lineTo(0.455921, 0.455921).lineTo(0.747204, 0.000000).lineTo(0.899178, 0.000000).lineTo(1.127138, 0.253289).threePointArc((1.201479, 0.449589), (1.127138, 0.645888)).lineTo(0.899178, 0.899178).lineTo(0.709211, 0.899178).threePointArc((0.449589, 0.749992), (0.189967, 0.899178)).lineTo(0.000000, 0.899178).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0

