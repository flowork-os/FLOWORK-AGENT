# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220768" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, -0.539062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.210321, -0.210321), (0.420641, 0.000000)).lineTo(0.420641, 1.071957).threePointArc((0.210321, 1.282278), (0.000000, 1.071957)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.217105, 0.000000).circle(0.067845)
loop2=wp_sketch0.moveTo(0.217105, 1.071957).circle(0.067845)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
