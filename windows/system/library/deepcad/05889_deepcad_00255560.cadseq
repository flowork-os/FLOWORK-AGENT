# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00255560" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.078947).lineTo(1.342105, 0.078947).lineTo(1.342105, 0.173684).lineTo(1.326316, 0.821053).lineTo(1.168421, 0.821053).lineTo(0.331579, 0.821053).lineTo(0.157895, 0.821053).lineTo(0.157895, 0.173684).lineTo(0.157895, 0.078947).lineTo(0.000000, 0.078947).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.221053, 0.363158).circle(0.047368)
loop2=wp_sketch0.moveTo(0.284211, 0.678947).circle(0.047368)
loop3=wp_sketch0.moveTo(1.215789, 0.678947).circle(0.047368)
loop4=wp_sketch0.moveTo(1.278947, 0.363158).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.335938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.653947, 0.000000).lineTo(0.875000, 0.000000).lineTo(0.875000, 0.175000).lineTo(0.653947, 0.128947).lineTo(0.414474, 0.128947).lineTo(0.414474, 0.082895).lineTo(0.359211, 0.073684).lineTo(0.101316, 0.073684).lineTo(0.101316, 0.018421).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(-1.000000)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.653947, 0.000000).lineTo(0.875000, 0.000000).lineTo(0.875000, 0.175000).lineTo(0.653947, 0.128947).lineTo(0.414474, 0.128947).lineTo(0.414474, 0.082895).lineTo(0.359211, 0.073684).lineTo(0.101316, 0.073684).lineTo(0.101316, 0.018421).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(-0.992188)
solid_temp=solid_temp.union(solid1)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
