# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00351387" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, -0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.250000, 0.000000).lineTo(1.250000, 0.171053).lineTo(0.907895, 0.171053).lineTo(0.907895, 0.460526).threePointArc((0.625000, 0.177632), (0.342105, 0.460526)).lineTo(0.342105, 0.171053).lineTo(0.000000, 0.171053).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.631579, 0.460526).circle(0.157895)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.453125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.055263, 0.000000).circle(0.055263)
solid1=wp_sketch1.add(loop2).extrude(-0.281250)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.515625, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.063158, 0.000000).circle(0.063158)
solid2=wp_sketch2.add(loop3).extrude(-0.281250)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
