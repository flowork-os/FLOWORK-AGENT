wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.289062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.023123, -0.055824), (0.078947, -0.078947)).lineTo(1.421053, -0.078947).threePointArc((1.476877, -0.055824), (1.500000, 0.000000)).lineTo(1.500000, 0.584211).threePointArc((1.476877, 0.640035), (1.421053, 0.663158)).lineTo(0.078947, 0.663158).threePointArc((0.023123, 0.640035), (0.000000, 0.584211)).lineTo(0.000000, 0.000000).close()
