import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.139309, -0.215296).lineTo(0.810526, -0.253289).lineTo(0.810526, -0.367270).lineTo(1.051151, -0.278618).lineTo(1.177796, -0.202632).lineTo(1.139803, -0.101316).lineTo(1.203125, -0.025329).lineTo(1.000493, 0.126645).lineTo(0.658553, 0.227961).lineTo(0.379934, 0.164638).lineTo(0.063322, 0.126645).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.455921, 0.063322).circle(0.063322)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.187500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
