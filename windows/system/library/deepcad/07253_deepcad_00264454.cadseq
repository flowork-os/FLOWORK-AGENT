# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00264454" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.302632, 0.000000).lineTo(0.302632, 0.151316).lineTo(0.368832, 0.151316).lineTo(0.368832, 0.747122).lineTo(0.302632, 0.747122).lineTo(0.302632, 0.898438).lineTo(0.000000, 0.898438).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.151316, 0.151316).circle(0.037829)
loop2=wp_sketch0.moveTo(0.151316, 0.453947).circle(0.037829)
loop3=wp_sketch0.moveTo(0.151316, 0.747122).circle(0.037829)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
