import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.281826, 0.000000).lineTo(0.563651, 0.000000).threePointArc((0.658960, -0.039478), (0.698438, -0.134786)).lineTo(0.698438, -0.183799).lineTo(1.164062, -0.183799).lineTo(1.164062, 0.122533).lineTo(1.164062, 0.784211).lineTo(0.416612, 0.784211).lineTo(0.000000, 0.784211).lineTo(0.000000, 0.171546).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.281826, 0.171546).circle(0.098026)
loop2=wp_sketch0.moveTo(1.041530, 0.502385).threePointArc((1.115049, 0.575905), (1.041530, 0.649424)).lineTo(0.502385, 0.649424).threePointArc((0.428865, 0.575905), (0.502385, 0.502385)).close()
loop3=wp_sketch0.moveTo(0.943503, 0.122533).circle(0.183799)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.234375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
