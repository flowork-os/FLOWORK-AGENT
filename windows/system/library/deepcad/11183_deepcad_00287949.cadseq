loop2=wp_sketch2.moveTo(0.117434, 0.000000).threePointArc((0.143422, 0.082031), (0.117434, 0.164062)).lineTo(0.000000, 0.164062).threePointArc((-0.082031, 0.082031), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.140625)
