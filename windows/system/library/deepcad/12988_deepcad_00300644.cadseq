# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00300644" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, -0.578125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.177632, 0.000000).lineTo(0.177632, 0.051809).lineTo(0.177632, 0.136924).lineTo(0.177632, 0.277549).lineTo(0.177632, 0.351562).lineTo(0.000000, 0.351562).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, -0.531250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.524260, 0.000000).lineTo(0.664062, 0.000000).lineTo(0.664062, 0.090872).lineTo(0.000000, 0.090872).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.171875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, -0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.180099, 0.000000).lineTo(0.180099, -0.072039).lineTo(0.180099, -0.216118).lineTo(0.840461, -0.216118).lineTo(0.840461, -0.300164).lineTo(0.696382, -0.300164).lineTo(0.180099, -0.300164).lineTo(0.180099, -0.348191).lineTo(1.140625, -0.348191).lineTo(1.140625, -0.060033).lineTo(0.444243, 0.348191).lineTo(0.000000, 0.348191).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.171875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
