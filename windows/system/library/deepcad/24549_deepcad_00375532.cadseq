loop3=wp_sketch3.moveTo(0.045395, 0.000000).lineTo(0.090789, 0.000000).lineTo(0.128618, 0.000000).lineTo(0.174013, 0.000000).lineTo(0.242105, 0.000000).lineTo(0.718750, 0.000000).lineTo(0.718750, 0.113487).lineTo(0.000000, 0.113487).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.070312)
