# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00314825" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
solid0=wp_sketch0.add(loop0).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.148438, 0.093750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.365638, -0.417332), (0.703618, 0.022697)).threePointArc((0.643205, 0.183098), (0.537171, 0.317763)).threePointArc((0.438932, 0.506292), (0.446382, 0.718750)).threePointArc((0.140171, 0.410935), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.252669, -0.191250), (0.559868, -0.113487)).threePointArc((0.622561, -0.082147), (0.643092, -0.015132)).threePointArc((0.619258, 0.086438), (0.552303, 0.166447)).threePointArc((0.549271, 0.059939), (0.506908, -0.037829)).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.046875)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
