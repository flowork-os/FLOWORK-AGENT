# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00286769" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, 0.000000, 0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.584211, 0.000000).circle(0.584211)
loop1=wp_sketch0.moveTo(0.462500, 0.060855).lineTo(0.462500, 0.292105).lineTo(0.219079, 0.304276).lineTo(0.219079, 0.060855).close()
loop2=wp_sketch0.moveTo(0.219079, 0.060855).threePointArc((0.509473, -0.389650), (0.973684, -0.121711)).lineTo(0.328618, -0.121711).close()
loop3=wp_sketch0.moveTo(1.046711, 0.060855).lineTo(1.046711, 0.304276).lineTo(0.815461, 0.292105).lineTo(0.815461, 0.060855).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
