import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, -0.492188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.176809, 0.000000).lineTo(1.176809, 0.405345).lineTo(0.889145, 0.575329).lineTo(0.889145, 0.732237).lineTo(1.176809, 0.902220).lineTo(1.176809, 1.242188).lineTo(0.876069, 1.242188).lineTo(0.601480, 1.111431).lineTo(0.169984, 1.111431).lineTo(0.000000, 0.575329).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.164062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
