# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231499" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.025146, -0.060709), (0.085855, -0.085855)).lineTo(0.505592, -0.085855).lineTo(0.505592, 0.906250).lineTo(0.085855, 0.906250).threePointArc((0.025146, 0.881104), (0.000000, 0.820395)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.085855, 0.000000).circle(0.057237)
loop2=wp_sketch0.moveTo(0.085855, 0.820395).circle(0.057237)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.242188, -0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.417763, 0.000000).threePointArc((0.479007, 0.029694), (0.501316, 0.093997)).lineTo(0.501316, 0.898191).threePointArc((0.479007, 0.962493), (0.417763, 0.992188)).lineTo(0.000000, 0.992188).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.417763, 0.093997).circle(0.052220)
loop5=wp_sketch1.moveTo(0.417763, 0.898191).circle(0.052220)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.148438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
