import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.000000, -0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.296875, 0.000000).lineTo(1.296875, 0.928289).lineTo(0.000000, 0.928289).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.163816, 0.464145).circle(0.054605)
loop2=wp_sketch0.moveTo(1.023849, 0.095559).lineTo(1.023849, 0.832730).lineTo(0.273026, 0.832730).lineTo(0.273026, 0.095559).close()
loop3=wp_sketch0.moveTo(1.133059, 0.464145).circle(0.054605)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, -0.148438, -0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(1.296875, 0.000000).lineTo(1.296875, 0.928289).lineTo(0.000000, 0.928289).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(1.023849, 0.095559).lineTo(1.023849, 0.423191).threePointArc((1.288730, 0.464145), (1.023849, 0.505099)).lineTo(1.023849, 0.832730).lineTo(0.273026, 0.832730).lineTo(0.273026, 0.505099).threePointArc((0.008145, 0.464145), (0.273026, 0.423191)).lineTo(0.273026, 0.095559).close()
solid1=wp_sketch1.add(loop4).add(loop5).extrude(0.523438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.148438, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch2.moveTo(0.742188, 0.000000).lineTo(0.742188, 0.335938).threePointArc((0.736752, 0.371094), (0.742188, 0.406250)).lineTo(0.742188, 0.742188).lineTo(0.000000, 0.742188).lineTo(0.000000, 0.406250).threePointArc((0.005436, 0.371094), (0.000000, 0.335938)).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch2.moveTo(0.703125, 0.039062).lineTo(0.703125, 0.703125).lineTo(0.039062, 0.703125).lineTo(0.039062, 0.039062).close()
solid2=wp_sketch2.add(loop6).add(loop7).extrude(0.523438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
