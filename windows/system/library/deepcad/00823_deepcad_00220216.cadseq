loop4=wp_sketch3.moveTo(0.104523, 0.000000).threePointArc((0.160156, 0.055633), (0.215789, 0.000000)).lineTo(0.320312, 0.000000).threePointArc((0.160156, 0.093342), (0.000000, 0.000000)).close()
