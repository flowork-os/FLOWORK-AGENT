# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00384760" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.351562, -0.023438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.651316, 0.000000).lineTo(0.651316, 0.716447).lineTo(0.537336, 0.773437).lineTo(0.000000, 0.773437).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.626891, 0.024424).lineTo(0.626891, 0.700164).lineTo(0.537336, 0.749013).lineTo(0.024424, 0.749013).lineTo(0.024424, 0.024424).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.367188, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
