# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00244449" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.375000, 0.000000).lineTo(1.375000, 0.506579).lineTo(1.056579, 0.998684).lineTo(0.000000, 0.998684).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.246053, 0.622368).circle(0.130263)
loop2=wp_sketch0.moveTo(0.752632, 0.376316).circle(0.246053)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.250000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
