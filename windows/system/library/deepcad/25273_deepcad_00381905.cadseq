import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.090872, -0.090872).lineTo(0.160773, -0.090872).lineTo(0.251645, 0.000000).lineTo(0.251645, 0.573191).lineTo(0.160773, 0.664062).lineTo(0.090872, 0.664062).lineTo(0.000000, 0.573191).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.125822, 0.615132).circle(0.006990)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
