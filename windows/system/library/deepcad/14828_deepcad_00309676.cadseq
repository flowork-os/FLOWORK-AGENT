# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00309676" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.152208, -0.376604), (0.215625, -0.204276)).threePointArc((0.238029, -0.147240), (0.295066, -0.124836)).lineTo(1.078125, -0.124836).lineTo(1.078125, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, -0.215625).circle(0.147533)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.296875, -0.148438, 0.218750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.048912, -0.086016), (0.147862, -0.085855)).lineTo(0.405428, 0.066776).threePointArc((0.453081, 0.154022), (0.400658, 0.238487)).lineTo(0.143092, 0.381579).threePointArc((0.046879, 0.379764), (0.000000, 0.295724)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.100164, 0.000000).circle(0.042928)
loop4=wp_sketch1.moveTo(0.100164, 0.295724).circle(0.042928)
loop5=wp_sketch1.moveTo(0.352961, 0.152632).circle(0.042928)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
