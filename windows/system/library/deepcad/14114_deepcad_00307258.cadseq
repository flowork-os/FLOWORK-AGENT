# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.000000, -0.531250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.876316, 0.000000).lineTo(0.876316, 0.248684).lineTo(0.627632, 0.248684).lineTo(0.627632, 0.876316).lineTo(0.876316, 0.876316).lineTo(0.876316, 1.125000).lineTo(0.000000, 1.125000).lineTo(0.000000, 0.876316).lineTo(0.248684, 0.876316).lineTo(0.248684, 0.248684).lineTo(0.000000, 0.248684).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
