# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00226457" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.002303, 0.000000).lineTo(0.009211, 0.063322).lineTo(0.009211, 0.085197).lineTo(0.004605, 0.109375).threePointArc((0.003050, 0.108628), (0.002303, 0.107072)).lineTo(0.006908, 0.085197).lineTo(0.002303, 0.085197).lineTo(0.002303, 0.107072).threePointArc((0.001628, 0.108701), (0.000000, 0.109375)).lineTo(0.000000, 0.037993).lineTo(0.002303, 0.072533).lineTo(0.006908, 0.072533).lineTo(0.006908, 0.063322).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.003947).lineTo(0.000822, 0.000082).threePointArc((-0.000333, 0.007479), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
