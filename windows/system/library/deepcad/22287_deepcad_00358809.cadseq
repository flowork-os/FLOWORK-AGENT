wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.230921, 0.000000).lineTo(0.230921, 0.914062).lineTo(0.192434, 0.914062).threePointArc((0.165220, 0.902790), (0.153947, 0.875576)).lineTo(0.153947, 0.798602).lineTo(0.115461, 0.798602).threePointArc((0.088246, 0.787329), (0.076974, 0.760115)).lineTo(0.076974, 0.567681).threePointArc((0.049759, 0.556408), (0.038487, 0.529194)).lineTo(0.038487, 0.307895).threePointArc((0.011273, 0.296622), (0.000000, 0.269408)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.187500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
