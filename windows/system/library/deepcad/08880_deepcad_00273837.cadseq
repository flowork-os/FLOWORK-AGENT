# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00273837" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.018750, 0.000000).threePointArc((0.148438, 0.129688), (0.278125, 0.000000)).lineTo(0.296875, 0.000000).threePointArc((0.279718, 0.070719), (0.231250, 0.125000)).lineTo(0.231250, 0.184375).lineTo(0.212500, 0.184375).lineTo(0.084375, 0.184375).lineTo(0.068750, 0.184375).lineTo(0.068750, 0.125000).threePointArc((0.018311, 0.071335), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(-0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.015625, 0.187500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.127220, 0.000000).lineTo(0.127220, 0.710938).lineTo(0.000000, 0.710938).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.078125)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
