wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.026409, -0.065488), (0.040296, -0.088651)).lineTo(0.451316, 0.137007).threePointArc((0.653945, 0.133863), (0.757566, -0.040296)).threePointArc((0.761595, -0.044228), (0.765625, -0.040296)).threePointArc((0.665642, 0.159963), (0.443257, 0.185362)).lineTo(0.000000, 0.000000).close()
