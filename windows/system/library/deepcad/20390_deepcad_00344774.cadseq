# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00344774" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.570312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.562253, 0.000000).lineTo(0.562253, 1.137582).lineTo(0.457648, 1.242188).threePointArc((0.281127, 1.163941), (0.104605, 1.242188)).lineTo(0.000000, 1.137582).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.421875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
