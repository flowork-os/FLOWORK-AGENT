# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00383967" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.086201, 0.056144), (0.071053, 0.157895)).threePointArc((0.045539, 0.234445), (0.078947, 0.307895)).threePointArc((0.111514, 0.362631), (0.110526, 0.426316)).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.442105).threePointArc((0.055263, 0.386842), (0.000000, 0.331579)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.000000, 0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.003036, -0.061505), (0.026645, -0.115461)).threePointArc((0.060740, -0.189210), (0.035526, -0.266447)).threePointArc((0.021170, -0.366965), (0.106579, -0.421875)).lineTo(0.106579, -0.088816).threePointArc((0.162089, -0.033306), (0.106579, 0.022204)).lineTo(0.106579, 0.324178).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.007812, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.046875, 0.007812, 0.093750), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.047368, 0.000000).circle(0.047368)
solid2=wp_sketch2.add(loop2).extrude(0.109375)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.023438, 0.117188, 0.093750), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.023684, 0.000000).circle(0.023684)
solid3=wp_sketch3.add(loop3).extrude(-0.109375)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
