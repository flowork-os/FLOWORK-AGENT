import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.007812, -0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.742188, 0.000000).lineTo(0.742188, 0.007812).lineTo(0.000000, 0.007812).threePointArc((-0.001290, 0.003906), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(-0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, -0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
