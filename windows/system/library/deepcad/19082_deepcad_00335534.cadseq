solid1=wp_sketch1.add(loop1).extrude(-0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, -0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.005551, -0.005551), (0.011102, 0.000000)).threePointArc((0.006776, 0.000915), (0.004934, 0.004934)).lineTo(0.004934, 0.117188).lineTo(0.000000, 0.117188).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.015625)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, -0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.812500, 0.000000).lineTo(0.812500, 0.059868).lineTo(0.068421, 0.059868).threePointArc((0.064145, 0.055592), (0.059868, 0.059868)).lineTo(0.059868, 0.171053).lineTo(0.000000, 0.171053).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.007812)
