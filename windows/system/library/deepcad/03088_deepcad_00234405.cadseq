# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00234405" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.632812, -0.257812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.370724, -0.370724).lineTo(0.887089, -0.370724).lineTo(1.257812, 0.000000).lineTo(1.257812, 0.516365).lineTo(0.887089, 0.887089).lineTo(0.370724, 0.887089).lineTo(0.000000, 0.516365).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.257812, -0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.154276, -0.154276).lineTo(0.369161, -0.154276).lineTo(0.523438, 0.000000).lineTo(0.523438, 0.214885).lineTo(0.369161, 0.369161).lineTo(0.154276, 0.369161).lineTo(0.000000, 0.214885).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.296875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.750000, -0.257812, -0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.154276, -0.154276).lineTo(0.369161, -0.154276).lineTo(0.523438, 0.000000).lineTo(0.523438, 0.214885).lineTo(0.369161, 0.369161).lineTo(0.154276, 0.369161).lineTo(0.000000, 0.214885).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.296875)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
