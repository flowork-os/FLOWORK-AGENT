import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.000000, 0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.069572, 0.000000).lineTo(0.085033, 0.626151).lineTo(0.533388, 0.618421).lineTo(0.517928, -0.007730).lineTo(0.587500, -0.015461).lineTo(0.587500, 0.231908).lineTo(0.695724, 0.231908).lineTo(0.687993, -0.015461).lineTo(0.718914, -0.015461).lineTo(0.718914, 0.734375).lineTo(0.000000, 0.734375).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
