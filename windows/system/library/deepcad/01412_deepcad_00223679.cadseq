# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00223679" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, -0.515625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.threePointArc((0.239803, -0.239803), (0.479605, 0.000000)).lineTo(0.479605, 1.025822).threePointArc((0.239803, 1.265625), (0.000000, 1.025822)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.239803, 0.000000).circle(0.093257)
loop2=wp_sketch0.moveTo(0.239803, 1.025822).circle(0.093257)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.257812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.312500, 0.257812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.226480, 0.000000).lineTo(0.226480, 0.632812).lineTo(0.000000, 0.632812).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.429688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
