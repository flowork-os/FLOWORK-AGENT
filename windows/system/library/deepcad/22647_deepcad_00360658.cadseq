loop4=wp_sketch3.moveTo(0.099013, -0.335938).threePointArc((0.155592, -0.260620), (0.212171, -0.335938)).lineTo(0.307648, 0.000000).threePointArc((0.153824, -0.115553), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop4).extrude(0.296875)
