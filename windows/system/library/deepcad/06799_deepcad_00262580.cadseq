# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00262580" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.312500, 0.000000).lineTo(0.312500, 0.052632).lineTo(0.052632, 0.052632).lineTo(0.052632, 0.250000).lineTo(0.000000, 0.250000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.054030, 0.000000).lineTo(0.054030, -0.198109).lineTo(0.318174, -0.198109).lineTo(0.318174, -0.252138).lineTo(0.474260, -0.252138).lineTo(0.570312, -0.252138).lineTo(0.570312, -0.066036).lineTo(0.156086, 0.048026).lineTo(0.000000, 0.048026).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.474260, -0.156086).circle(0.042023)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.054688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.312500, 0.000000).lineTo(0.312500, 0.052632).lineTo(0.052632, 0.052632).lineTo(0.052632, 0.250000).lineTo(0.000000, 0.250000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.218750)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
