# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00233161" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757812, 0.000000).lineTo(0.757812, 0.047862).lineTo(0.000000, 0.047862).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.015954, 0.023931).circle(0.007977)
loop2=wp_sketch0.moveTo(0.733882, 0.023931).circle(0.007977)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
