# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.750000, -0.156250, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.312500, 0.000000).lineTo(0.312500, 0.032895).lineTo(0.273026, 0.032895).lineTo(0.203947, 0.131579).threePointArc((0.150424, 0.158483), (0.098684, 0.128289)).lineTo(0.039474, 0.032895).lineTo(0.000000, 0.032895).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.093750)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.750000, -0.031250, 0.187500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.031579, 0.000000).circle(0.031579)
solid4=wp_sketch4.add(loop4).extrude(-0.140625)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.750000, -0.078125, 0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch5.moveTo(0.046053, 0.000000).lineTo(0.046053, -0.041118).lineTo(0.078947, -0.041118).lineTo(0.108553, -0.041118).lineTo(0.108553, 0.000000).lineTo(0.156250, 0.000000).lineTo(0.156250, 0.031250).lineTo(0.108553, 0.031250).lineTo(0.108553, 0.052632).lineTo(0.046053, 0.052632).lineTo(0.046053, 0.031250).lineTo(0.000000, 0.031250).lineTo(0.000000, 0.000000).close()
