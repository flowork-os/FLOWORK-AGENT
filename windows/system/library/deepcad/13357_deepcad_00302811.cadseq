loop1=wp_sketch1.moveTo(0.078947, 0.000000).lineTo(0.078947, 0.156250).lineTo(0.041118, 0.156250).lineTo(0.000000, 0.108553).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.312500)
