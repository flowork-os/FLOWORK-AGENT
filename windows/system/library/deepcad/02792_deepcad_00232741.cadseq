import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.031250, -0.531250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.071737, -0.192898), (0.117434, -0.111842)).lineTo(0.117434, 0.531250).lineTo(0.027961, 0.531250).lineTo(0.027961, 0.027961).threePointArc((0.019571, 0.008389), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.005592, -0.111842).circle(0.044737)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.234375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
