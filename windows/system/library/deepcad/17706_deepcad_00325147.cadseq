# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00325147" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.275918, 0.306410), (0.568421, 0.015789)).threePointArc((0.616296, 0.130879), (0.726316, 0.189474)).threePointArc((0.750000, 0.214350), (0.773684, 0.189474)).threePointArc((0.883704, 0.130879), (0.931579, 0.015789)).threePointArc((0.948163, 0.000000), (0.931579, -0.015789)).threePointArc((0.883704, -0.130879), (0.773684, -0.189474)).threePointArc((0.750000, -0.214350), (0.726316, -0.189474)).threePointArc((0.616296, -0.130879), (0.568421, -0.015789)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.139145, -0.003865).threePointArc((0.123630, -0.089873), (0.166201, -0.166201)).threePointArc((0.183594, -0.149641), (0.200987, -0.166201)).threePointArc((0.313821, -0.112834), (0.367188, 0.000000)).threePointArc((0.348788, 0.019326), (0.367188, 0.038651)).threePointArc((0.313129, 0.149553), (0.200987, 0.200987)).threePointArc((0.183594, 0.184427), (0.166201, 0.200987)).threePointArc((0.054058, 0.149553), (0.000000, 0.038651)).threePointArc((0.018400, 0.019326), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.185526, 0.019326).circle(0.119819)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.117188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
