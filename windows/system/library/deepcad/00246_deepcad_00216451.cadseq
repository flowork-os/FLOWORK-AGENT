# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00216451" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.044223, -0.106764), (0.150987, -0.150987)).lineTo(0.754934, -0.150987).threePointArc((1.201604, 0.295683), (0.754934, 0.742352)).lineTo(0.150987, 0.742352).threePointArc((0.044223, 0.698129), (0.000000, 0.591365)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.754934, 0.289391).circle(0.138405)
loop2=wp_sketch0.moveTo(0.754934, 0.088076).circle(0.050329)
loop3=wp_sketch0.moveTo(0.754934, 0.503289).circle(0.050329)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.109375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
