# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00389794" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.695312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.264720, 0.000000).lineTo(1.264720, 1.320312).lineTo(0.750493, 1.320312).lineTo(0.750493, 0.500329).lineTo(0.000000, 0.500329).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.333553, 0.250164).circle(0.097286)
loop2=wp_sketch0.moveTo(1.014556, 0.986760).circle(0.222368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.250000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
