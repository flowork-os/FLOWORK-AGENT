# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257016" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.062171, 0.000000).lineTo(0.062171, 0.124342).lineTo(0.442105, 0.124342).lineTo(0.442105, 0.186513).lineTo(0.497368, 0.186513).lineTo(0.497368, 0.124342).lineTo(0.656250, 0.124342).lineTo(0.656250, 0.248684).lineTo(0.000000, 0.248684).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.671875, 0.000000).lineTo(0.671875, 0.247533).lineTo(0.615296, 0.247533).lineTo(0.615296, 0.120230).lineTo(0.417270, 0.120230).lineTo(0.417270, 0.169737).lineTo(0.360691, 0.169737).lineTo(0.360691, 0.120230).lineTo(0.000000, 0.120230).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.125000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
