wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, -0.515625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.956826, 0.000000).lineTo(1.398438, -0.073602).lineTo(1.398438, 0.235526).lineTo(0.721299, 0.250247).lineTo(0.721299, 0.500493).lineTo(0.588816, 0.809622).lineTo(0.588816, 1.000987).lineTo(0.250247, 1.000987).lineTo(0.250247, 0.780181).lineTo(0.000000, 0.588816).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.156250)
solid=solid0

if __name__ == '__main__':
    import sys
