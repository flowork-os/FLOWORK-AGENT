# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00292137" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, 0.429688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.073026, 0.000000).circle(0.073026)
loop1=wp_sketch0.moveTo(0.937171, -0.219079).threePointArc((1.156250, 0.000000), (0.937171, 0.219079)).lineTo(0.073026, 0.219079).threePointArc((0.292105, 0.000000), (0.073026, -0.219079)).close()
loop2=wp_sketch0.moveTo(0.937171, 0.000000).circle(0.073026)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.070312, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
