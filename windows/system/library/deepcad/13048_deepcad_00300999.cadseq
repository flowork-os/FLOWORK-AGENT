# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00300999" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.540789, 0.000000).circle(0.540789)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.314330, -0.223155), (0.698520, -0.191530)).lineTo(0.698520, 0.191530).threePointArc((0.535156, 0.251115), (0.371793, 0.191530)).lineTo(0.371793, -0.191530).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.335938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
