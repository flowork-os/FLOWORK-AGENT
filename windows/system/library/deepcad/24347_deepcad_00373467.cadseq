import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.000000, 0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.680921, -0.665789).lineTo(1.376974, 0.000000).threePointArc((1.171765, 0.575180), (0.680921, 0.211842)).threePointArc((0.197643, 0.564979), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.590132, -0.166447).lineTo(0.544737, -0.317763).lineTo(0.847368, -0.317763).lineTo(0.786842, -0.166447).lineTo(0.847368, -0.030263).threePointArc((0.688487, 0.117330), (0.529605, -0.030263)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.250000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
