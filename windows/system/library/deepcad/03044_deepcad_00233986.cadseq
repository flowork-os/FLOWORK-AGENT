# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00233986" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.505263, 0.000000).circle(0.494737)
loop1=wp_sketch0.moveTo(0.505263, 0.000000).circle(0.442105)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.164062, -0.476562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.537336, 0.189062).threePointArc((0.571669, 0.211034), (0.587089, 0.248766)).lineTo(0.587089, 0.696546).threePointArc((0.571669, 0.734279), (0.537336, 0.756250)).lineTo(0.000000, 0.945312).threePointArc((0.337240, 0.472656), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.457730, 0.328372).circle(0.079605)
loop4=wp_sketch1.moveTo(0.457730, 0.616941).circle(0.079605)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).extrude(0.078125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
