import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.394737, 0.000000).lineTo(0.394737, 0.585938).lineTo(0.000000, 0.585938).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.166530, 0.141859).lineTo(0.209704, 0.141859).lineTo(0.259046, 0.191201).lineTo(0.259046, 0.265214).lineTo(0.222039, 0.265214).lineTo(0.148026, 0.265214).lineTo(0.117188, 0.265214).lineTo(0.117188, 0.191201).close()
loop2=wp_sketch0.moveTo(0.172697, 0.407072).lineTo(0.215872, 0.407072).lineTo(0.265214, 0.462582).lineTo(0.265214, 0.530428).lineTo(0.234375, 0.530428).lineTo(0.160362, 0.530428).lineTo(0.123355, 0.530428).lineTo(0.123355, 0.462582).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.046875)
solid=solid0

if __name__ == '__main__':
