# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.648698, -0.806045), (1.100000, 0.125000)).threePointArc((0.788562, 0.100408), (0.700000, 0.400000)).threePointArc((0.494775, 0.402190), (0.300000, 0.337500)).threePointArc((0.290231, 0.044100), (0.000000, 0.000000)).close()
loop5=wp_sketch4.moveTo(0.312500, -0.050000).circle(0.050000)
loop6=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.286810, -0.560907), (0.912500, -0.487500)).lineTo(0.812500, -0.375000).threePointArc((0.587500, -0.491738), (0.362500, -0.375000)).lineTo(0.275000, -0.462500).close()
