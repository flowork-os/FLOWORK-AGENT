wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.117188, 0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.229863, -0.095473), (0.401316, -0.275905)).threePointArc((0.370872, 0.109632), (0.000000, 0.000000)).close()
