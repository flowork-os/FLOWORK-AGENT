# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00319529" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.126316)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, 0.375000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.509211, 0.000000).circle(0.509211)
loop3=wp_sketch1.moveTo(0.509211, 0.000000).circle(0.137911)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch2.moveTo(0.607895, 0.000000).circle(0.607895)
loop5=wp_sketch2.moveTo(0.607895, 0.000000).circle(0.139309)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(-0.242188)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, 0.242188), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop6=wp_sketch3.moveTo(0.244737, 0.000000).circle(0.244737)
loop7=wp_sketch3.moveTo(0.244737, 0.000000).circle(0.132566)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.117188)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
