import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.157895, 0.000000).threePointArc((0.306925, 0.025005), (0.457895, 0.031579)).lineTo(0.757895, 0.031579).lineTo(1.042105, 0.031579).threePointArc((1.193075, 0.025005), (1.342105, 0.000000)).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.221053).lineTo(1.342105, 0.221053).threePointArc((1.193075, 0.196048), (1.042105, 0.189474)).lineTo(0.757895, 0.189474).lineTo(0.457895, 0.189474).threePointArc((0.306925, 0.196048), (0.157895, 0.221053)).lineTo(0.000000, 0.221053).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
