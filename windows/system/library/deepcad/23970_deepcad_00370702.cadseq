# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.469490, -0.170724).threePointArc((0.604646, -0.194176), (0.739803, -0.170724)).lineTo(1.195066, 0.000000).threePointArc((1.345362, 0.213405), (1.195066, 0.426809)).lineTo(0.739803, 0.583306).threePointArc((0.604646, 0.606758), (0.469490, 0.583306)).lineTo(0.000000, 0.426809).threePointArc((-0.150296, 0.213405), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.071135, 0.213405).circle(0.099589)
loop2=wp_sketch0.moveTo(0.597533, 0.213405).circle(0.327220)
loop3=wp_sketch0.moveTo(1.123931, 0.213405).circle(0.113816)
