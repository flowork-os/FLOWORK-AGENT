loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009249, -0.022330), (0.031579, -0.031579)).lineTo(0.718421, -0.031579).threePointArc((0.740751, -0.022330), (0.750000, 0.000000)).lineTo(0.750000, 0.686842).threePointArc((0.740751, 0.709172), (0.718421, 0.718421)).lineTo(0.031579, 0.718421).threePointArc((0.009249, 0.709172), (0.000000, 0.686842)).lineTo(0.000000, 0.000000).close()
