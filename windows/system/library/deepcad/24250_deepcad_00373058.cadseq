wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.050658, 0.000000).lineTo(0.050658, 0.506579).threePointArc((0.065495, 0.542399), (0.101316, 0.557237)).lineTo(1.101809, 0.557237).threePointArc((1.137630, 0.542399), (1.152467, 0.506579)).lineTo(1.152467, 0.000000).lineTo(1.203125, 0.000000).lineTo(1.203125, 0.519243).threePointArc((1.183492, 0.579306), (1.127138, 0.607895)).lineTo(0.075987, 0.607895).threePointArc((0.019633, 0.579306), (0.000000, 0.519243)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0

