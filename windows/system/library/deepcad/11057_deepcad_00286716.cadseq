# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00286716" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.040707, 0.004523).threePointArc((0.213313, 0.214844), (0.040707, 0.425164)).lineTo(0.000000, 0.429688).threePointArc((-0.214844, 0.214844), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.217105).circle(0.162829)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.320312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.039062, 0.109375).threePointArc((0.935156, 0.213281), (1.039062, 0.317187)).lineTo(0.000000, 0.426562).threePointArc((0.175035, 0.213281), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.689062, 0.153125).threePointArc((0.743750, 0.207812), (0.689062, 0.262500)).lineTo(0.262500, 0.262500).threePointArc((0.207812, 0.207812), (0.262500, 0.153125)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.218750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.531250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.110526, 0.000000).circle(0.108224)
loop5=wp_sketch2.moveTo(0.110526, 0.000000).circle(0.055263)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.273438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
