loop2=wp_sketch1.moveTo(1.429688, 0.000000).threePointArc((1.365211, 0.067722), (1.429688, 0.135444)).lineTo(0.000000, 0.075247).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.085938)
