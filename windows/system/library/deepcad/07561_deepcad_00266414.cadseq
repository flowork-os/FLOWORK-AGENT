wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.671875, 0.070312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.003701, -0.150748), (0.007401, 0.000000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.007401, -0.069572).circle(0.017763)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.101562)
