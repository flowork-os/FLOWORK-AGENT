loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.057370, -0.030671), (0.120066, -0.048026)).lineTo(0.366201, -0.090049).lineTo(0.366201, 0.570312).lineTo(0.120066, 0.528289).threePointArc((0.057370, 0.510934), (0.000000, 0.480263)).threePointArc((-0.015008, 0.387212), (0.078043, 0.372204)).threePointArc((0.332598, 0.240132), (0.078043, 0.108059)).threePointArc((-0.015008, 0.093051), (0.000000, 0.000000)).close()
