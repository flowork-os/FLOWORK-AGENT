wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.114011, -0.191227), (0.336513, -0.183553)).lineTo(0.897368, 0.081579).threePointArc((0.959911, 0.232347), (0.805592, 0.285526)).lineTo(0.458882, 0.173355).threePointArc((0.390216, 0.188520), (0.367105, 0.254934)).lineTo(0.428289, 0.540461).threePointArc((0.352057, 0.656856), (0.224342, 0.601645)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.224342, 0.000000).circle(0.071382)
