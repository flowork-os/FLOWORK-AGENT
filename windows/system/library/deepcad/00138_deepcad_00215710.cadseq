# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00215710" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.453947, 0.000000).lineTo(0.453947, 0.937500).lineTo(0.000000, 0.937500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.355263, 0.108553).lineTo(0.355263, 0.641447).lineTo(0.098684, 0.641447).lineTo(0.098684, 0.108553).close()
loop2=wp_sketch0.moveTo(0.226974, 0.750000).circle(0.078947)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
