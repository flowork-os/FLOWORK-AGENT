import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009249, -0.022330), (0.031579, -0.031579)).lineTo(0.663158, -0.031579).threePointArc((0.746053, 0.051316), (0.663158, 0.134211)).lineTo(0.031579, 0.134211).threePointArc((0.009249, 0.124961), (0.000000, 0.102632)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.663158, 0.047368).circle(0.031579)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
