wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.687500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.018499, -0.044659), (0.063158, -0.063158)).lineTo(0.686842, -0.063158).threePointArc((0.731501, -0.044659), (0.750000, 0.000000)).lineTo(0.750000, 0.623684).threePointArc((0.731501, 0.668344), (0.686842, 0.686842)).lineTo(0.063158, 0.686842).threePointArc((0.018499, 0.668344), (0.000000, 0.623684)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.063158, 0.000000).circle(0.015789)
