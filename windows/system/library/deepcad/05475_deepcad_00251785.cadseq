# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00251785" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.221053, 0.000000).circle(0.221053)
loop1=wp_sketch0.moveTo(0.221053, 0.000000).circle(0.147368)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.218750, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.585938, 0.164062, -0.218750), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.167969, 0.167969), (0.000000, 0.335938)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.585938, 0.164062, -0.218750), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch2.moveTo(0.000000, 0.335938).threePointArc((-0.167969, 0.167969), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(-0.109375)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.140625, 0.164062, -0.218750), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch3.moveTo(0.445312, 0.000000).threePointArc((0.276562, 0.168750), (0.445312, 0.337500)).lineTo(0.000000, 0.337500).threePointArc((0.078549, 0.168750), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop4).extrude(-0.109375)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.507812, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.075000, 0.000000).circle(0.073438)
solid4=wp_sketch4.add(loop5).extrude(-0.179688)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.218750, -0.039062, -0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch5.moveTo(0.187500, 0.000000).lineTo(0.187500, 0.073026).lineTo(0.000000, 0.073026).threePointArc((0.003144, 0.036513), (0.000000, 0.000000)).close()
solid5=wp_sketch5.add(loop6).extrude(0.328125)
solid=solid.union(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
