import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, -0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.246957, 0.000000).lineTo(0.246957, 0.037993).lineTo(0.050658, 0.037993).threePointArc((0.032748, 0.045412), (0.025329, 0.063322)).lineTo(0.025329, 0.538240).threePointArc((0.032748, 0.556150), (0.050658, 0.563569)).lineTo(0.246957, 0.563569).lineTo(0.246957, 0.601562).lineTo(0.000000, 0.601562).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
