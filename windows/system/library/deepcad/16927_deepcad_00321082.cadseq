import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.119079, 0.000000).threePointArc((1.305592, 0.186513), (1.119079, 0.373026)).lineTo(0.000000, 0.373026).threePointArc((-0.186513, 0.186513), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.193421).circle(0.096711)
loop2=wp_sketch0.moveTo(1.119079, 0.193421).circle(0.096711)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.093750, 0.187500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.186513, 0.000000).lineTo(0.186513, 0.186513).threePointArc((0.093257, 0.279770), (0.000000, 0.186513)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.094737, 0.186513).circle(0.047368)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.281250)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.093750, 0.187500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.186513, 0.000000).lineTo(0.186513, 0.186513).threePointArc((0.093257, 0.279770), (0.000000, 0.186513)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.094737, 0.186513).circle(0.047368)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(-0.281250)
solid_temp=solid_temp.union(solid1)
solid=solid.union(solid_temp)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.320312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.093750, -0.093750), (0.187500, 0.000000)).lineTo(0.187500, 0.150000).lineTo(0.000000, 0.150000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop5).extrude(-0.187500)
solid_temp=solid2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.320312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.093750, -0.093750), (0.187500, 0.000000)).lineTo(0.187500, 0.150000).lineTo(0.000000, 0.150000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop5).extrude(-0.187500)
solid_temp=solid_temp.union(solid2)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
