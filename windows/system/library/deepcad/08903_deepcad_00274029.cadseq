# workplane for sketch 6
wp_sketch6 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.085938, 0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
