# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.882812, 0.000000).lineTo(0.882812, 0.176562).lineTo(0.000000, 0.176562).lineTo(0.000000, 0.000000).close()
