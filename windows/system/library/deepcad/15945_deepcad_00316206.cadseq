loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.017728, -0.042799), (0.060526, -0.060526)).lineTo(0.257237, -0.060526).lineTo(0.257237, 0.000000).lineTo(0.862500, 0.000000).lineTo(0.862500, -0.060526).lineTo(1.044079, -0.060526).threePointArc((1.086878, -0.042799), (1.104605, 0.000000)).lineTo(1.104605, 1.376974).threePointArc((1.086878, 1.419772), (1.044079, 1.437500)).lineTo(0.060526, 1.437500).threePointArc((0.017728, 1.419772), (0.000000, 1.376974)).lineTo(0.000000, 0.000000).close()
