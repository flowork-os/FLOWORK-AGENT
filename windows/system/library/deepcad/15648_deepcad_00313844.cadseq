import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000145, -0.000349), (0.000493, -0.000493)).lineTo(0.004523, -0.000493).threePointArc((0.004872, -0.000349), (0.005016, 0.000000)).lineTo(0.005016, 0.007319).threePointArc((0.004872, 0.007668), (0.004523, 0.007812)).lineTo(0.000493, 0.007812).threePointArc((0.000145, 0.007668), (0.000000, 0.007319)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.004523, 0.000000).lineTo(0.004523, 0.007319).lineTo(0.000493, 0.007319).lineTo(0.000493, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
