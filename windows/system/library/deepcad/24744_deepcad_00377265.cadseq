# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00377265" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.125000, 0.000000).threePointArc((0.120375, 0.011165), (0.109211, 0.015789)).lineTo(0.031579, 0.015789).threePointArc((0.020414, 0.020414), (0.015789, 0.031579)).lineTo(0.015789, 0.109211).threePointArc((0.011165, 0.120375), (0.000000, 0.125000)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.640625, 0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.015789, 0.000000).circle(0.015789)
solid1=wp_sketch1.add(loop1).extrude(-0.015625)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.078125, 0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.015789, 0.000000).circle(0.015789)
solid2=wp_sketch2.add(loop2).extrude(-0.015625)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.359375, 0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.015789, 0.000000).circle(0.015789)
solid3=wp_sketch3.add(loop3).extrude(-0.015625)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
