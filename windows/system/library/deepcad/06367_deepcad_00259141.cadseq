import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.270313, 0.000000).lineTo(0.270313, -0.099589).lineTo(0.298766, -0.142270).lineTo(1.052796, -0.142270).lineTo(1.081250, -0.099589).lineTo(1.081250, 0.000000).lineTo(1.351562, 0.000000).lineTo(1.351562, 0.512171).threePointArc((1.301559, 0.632891), (1.180839, 0.682895)).lineTo(0.156497, 0.682895).lineTo(0.000000, 0.597533).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.199178, 0.199178).circle(0.099589)
loop2=wp_sketch0.moveTo(0.640214, 0.469490).circle(0.170724)
loop3=wp_sketch0.moveTo(1.223520, 0.099589).circle(0.028454)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.171875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
