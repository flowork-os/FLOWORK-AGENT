# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236233" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.429688, 0.000000).lineTo(0.429688, 0.429688).lineTo(0.000000, 0.429688).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.081414, 0.081414).circle(0.027138)
loop2=wp_sketch0.moveTo(0.081414, 0.348273).circle(0.027138)
loop3=wp_sketch0.moveTo(0.348273, 0.081414).circle(0.027138)
loop4=wp_sketch0.moveTo(0.348273, 0.348273).circle(0.027138)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.164062, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
