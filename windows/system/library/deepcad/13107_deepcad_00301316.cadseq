wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.323684, 0.000000).threePointArc((0.347368, 0.023684), (0.323684, 0.047368)).lineTo(0.071053, 0.094737).threePointArc((0.056934, 0.105974), (0.039474, 0.110526)).lineTo(0.039474, 0.623684).threePointArc((0.046884, 0.646080), (0.063158, 0.663158)).lineTo(0.268421, 0.702632).threePointArc((0.240789, 0.722368), (0.260526, 0.750000)).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.625000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
