import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.000000, -0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.658553, 0.000000).lineTo(0.658553, 0.211678).lineTo(0.658553, 1.117188).lineTo(0.493914, 1.117188).lineTo(0.493914, 0.176398).lineTo(0.000000, 0.176398).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.328125)
solid=solid0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.000000, -0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.658553, 0.000000).lineTo(0.658553, 0.211678).lineTo(0.658553, 1.117188).lineTo(0.493914, 1.117188).lineTo(0.493914, 0.176398).lineTo(0.000000, 0.176398).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.289062)
solid=solid.union(solid0)
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.218750, -0.101562, 0.468750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.102632, 0.000000).circle(0.102632)
solid1=wp_sketch1.add(loop1).extrude(-0.539062)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.218750, -0.101562, 0.468750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.099196, 0.100910), (0.201316, 0.002961)).lineTo(0.195395, 0.281250).lineTo(0.000000, 0.281250).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.539062)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
