wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001084, -0.002617), (0.003701, -0.003701)).lineTo(0.066612, -0.003701).threePointArc((0.069229, -0.002617), (0.070312, 0.000000)).lineTo(0.070312, 0.063651).threePointArc((0.069075, 0.065898), (0.066612, 0.066612)).lineTo(0.003701, 0.066612).threePointArc((0.001237, 0.065898), (0.000000, 0.063651)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001697, -0.001136), (0.003701, -0.000740)).lineTo(0.066612, -0.000740).threePointArc((0.067135, -0.000523), (0.067352, 0.000000)).lineTo(0.067352, 0.063651).threePointArc((0.066982, 0.063805), (0.066612, 0.063651)).lineTo(0.003701, 0.063651).threePointArc((0.003331, 0.063805), (0.002961, 0.063651)).lineTo(0.002961, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.002961, 0.000000).threePointArc((0.002564, -0.002004), (0.003701, -0.003701)).lineTo(0.066612, -0.003701).threePointArc((0.069229, -0.002617), (0.070312, 0.000000)).lineTo(0.070312, 0.063651).threePointArc((0.069075, 0.065898), (0.066612, 0.066612)).lineTo(0.003701, 0.066612).threePointArc((0.001237, 0.065898), (0.000000, 0.063651)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.001697, -0.001136), (0.003701, -0.000740)).lineTo(0.066612, -0.000740).threePointArc((0.067135, -0.000523), (0.067352, 0.000000)).lineTo(0.067352, 0.063651).threePointArc((0.066982, 0.063805), (0.066612, 0.063651)).lineTo(0.003701, 0.063651).threePointArc((0.003331, 0.063805), (0.002961, 0.063651)).lineTo(0.002961, 0.000000).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.109375, 0.023438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.003947, 0.000000).circle(0.003865)
solid2=wp_sketch2.add(loop4).extrude(-0.015625)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
