import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.168092, 0.000000).lineTo(0.168092, 0.792434).lineTo(0.168092, 0.972533).lineTo(0.168092, 1.140625).lineTo(0.000000, 1.140625).lineTo(0.000000, 0.972533).lineTo(0.084046, 0.972533).lineTo(0.084046, 0.792434).lineTo(0.000000, 0.792434).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.687500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
