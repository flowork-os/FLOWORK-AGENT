# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00305544" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.671875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.287664, -0.078454).lineTo(0.200493, 0.828125).lineTo(0.000000, 0.671217).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.261513, -0.034868).lineTo(0.174342, 0.767105).lineTo(0.026151, 0.662500).lineTo(0.026151, 0.026151).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
