import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, -0.523438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.751234, 0.000000).lineTo(1.132812, -0.023849).lineTo(1.132812, 0.226562).lineTo(0.584293, 0.226562).lineTo(0.584293, 0.429276).lineTo(0.476974, 0.655839).lineTo(0.476974, 0.810855).lineTo(0.202714, 0.810855).lineTo(0.202714, 0.631990).lineTo(0.000000, 0.476974).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
