import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.031579, 0.000000).circle(0.031579)
loop1=wp_sketch0.moveTo(0.031579, 0.000000).circle(0.023684)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.148438, 0.000000, 0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.114474, 0.000000).circle(0.114474)
loop3=wp_sketch1.moveTo(0.114474, 0.000000).circle(0.031003)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.296875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.000000, 0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.014881, -0.029914), (0.047697, -0.036184)).lineTo(0.065789, -0.029605).threePointArc((-0.137897, -0.086235), (0.000000, 0.074013)).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(-0.044408, -0.027961).circle(0.029605)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.078125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.114474, 0.000000).circle(0.112089)
loop7=wp_sketch3.moveTo(0.114474, 0.000000).circle(0.031003)
loop8=wp_sketch3.moveTo(0.174095, 0.050082).circle(0.014309)
solid3=wp_sketch3.add(loop6).add(loop7).add(loop8).extrude(0.187500)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
