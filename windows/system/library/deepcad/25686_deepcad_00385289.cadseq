# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00385289" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.678947)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.492188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.686842, 0.000000).circle(0.686842)
loop3=wp_sketch1.moveTo(0.257566, 0.000000).circle(0.157401)
loop4=wp_sketch1.moveTo(0.686842, 0.000000).circle(0.243257)
loop5=wp_sketch1.moveTo(0.686842, 0.457895).circle(0.171711)
loop6=wp_sketch1.moveTo(0.686842, -0.443586).circle(0.157401)
loop7=wp_sketch1.moveTo(1.130428, 0.000000).circle(0.171711)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).add(loop7).extrude(0.492188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
