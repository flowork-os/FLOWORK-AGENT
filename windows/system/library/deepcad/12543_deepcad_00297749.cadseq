# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297749" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.227961, -0.092790), (0.455921, 0.000000)).threePointArc((0.301714, 0.233882), (0.455921, 0.467763)).threePointArc((0.227961, 0.560553), (0.000000, 0.467763)).threePointArc((0.154207, 0.233882), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.154533, 0.234375), (0.000000, 0.468750)).threePointArc((-0.098770, 0.234375), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.000000, 0.236842).circle(0.034539)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.226562, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.098770, 0.234375), (0.000000, 0.468750)).threePointArc((-0.154533, 0.234375), (0.000000, 0.000000)).close()
loop4=wp_sketch2.moveTo(0.000000, 0.236842).circle(0.034539)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.078125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
