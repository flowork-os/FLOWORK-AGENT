# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00263029" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.210938, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.056743, 0.000000).threePointArc((0.090715, -0.013206), (0.107813, -0.045395)).threePointArc((0.133813, -0.127238), (0.181579, -0.198602)).lineTo(0.238322, -0.198602).lineTo(0.539062, 0.153207).lineTo(0.539062, 0.351809).lineTo(0.487993, 0.402878).lineTo(0.238322, 0.402878).threePointArc((0.150031, 0.309045), (0.022697, 0.289391)).lineTo(0.000000, 0.295066).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.460938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.074013, -0.074013).lineTo(0.351562, -0.074013).lineTo(0.351562, 0.222039).lineTo(0.144326, 0.259046).lineTo(0.074013, 0.259046).lineTo(0.000000, 0.185033).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.144326, 0.074013).circle(0.074013)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.460938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
