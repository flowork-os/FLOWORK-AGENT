# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00319155" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.098684, 0.000000).circle(0.098684)
loop1=wp_sketch0.moveTo(0.043174, -0.039062).lineTo(0.086349, -0.065789).lineTo(0.135691, -0.053454).lineTo(0.164474, -0.010280).lineTo(0.152138, 0.039062).lineTo(0.108964, 0.065789).lineTo(0.059622, 0.053454).lineTo(0.030839, 0.010280).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.875000, 0.000000).threePointArc((0.862641, 0.050658), (0.875000, 0.101316)).lineTo(0.000000, 0.101316).threePointArc((0.015028, 0.050658), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.488158, 0.027632).threePointArc((0.515789, 0.055263), (0.488158, 0.082895)).lineTo(0.193421, 0.082895).threePointArc((0.165789, 0.055263), (0.193421, 0.027632)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.023438, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.593750, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.034539, 0.004934).threePointArc((0.009868, -0.060855), (0.075658, -0.085526)).lineTo(0.118421, -0.047697).lineTo(0.149671, -0.019737).threePointArc((-0.046456, -0.117007), (0.074013, 0.065789)).lineTo(0.042763, 0.037829).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.023438, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.289474, 0.000000).threePointArc((0.314145, 0.024671), (0.289474, 0.049342)).lineTo(0.000000, 0.049342).threePointArc((-0.024671, 0.024671), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop5).extrude(0.015625, both=True)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
