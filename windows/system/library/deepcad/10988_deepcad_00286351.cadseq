loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.012673, -0.124625), (0.137911, -0.127303)).threePointArc((0.498602, 0.009295), (0.859293, -0.127303)).threePointArc((0.979227, -0.119934), (0.986595, 0.000000)).lineTo(0.848684, 0.201563).threePointArc((0.769120, 0.244720), (0.689556, 0.201563)).threePointArc((0.493298, 0.091969), (0.297039, 0.201563)).threePointArc((0.217475, 0.244720), (0.137911, 0.201563)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.074260, -0.053043).circle(0.031826)
