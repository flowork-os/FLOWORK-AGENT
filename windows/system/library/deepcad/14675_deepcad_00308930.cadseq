loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000096, -0.000233), (0.000329, -0.000329)).lineTo(0.007484, -0.000329).threePointArc((0.007716, -0.000233), (0.007812, 0.000000)).lineTo(0.007812, 0.002138).lineTo(0.007648, 0.002138).lineTo(0.007648, 0.000164).threePointArc((0.007535, -0.000027), (0.007319, -0.000082)).lineTo(0.000493, -0.000082).threePointArc((0.000278, -0.000027), (0.000164, 0.000164)).lineTo(0.000164, 0.001151).lineTo(0.000000, 0.001151).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
