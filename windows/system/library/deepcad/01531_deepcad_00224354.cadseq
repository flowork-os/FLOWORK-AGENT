# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00224354" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.098684, 0.000000).circle(0.098684)
solid0=wp_sketch0.add(loop0).extrude(0.796875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, -0.328125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.804688, 0.000000).lineTo(0.804688, 0.660691).lineTo(0.000000, 0.660691).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.415049, 0.330345).circle(0.101645)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.328125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.000000, 0.898438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.601562, -0.436924).lineTo(0.601562, 0.044326).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.234375)
solid_temp=solid2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.000000, 0.898438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.601562, -0.436924).lineTo(0.601562, 0.044326).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.234375)
solid_temp=solid_temp.union(solid2)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
