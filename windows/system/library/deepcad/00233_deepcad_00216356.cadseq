loop0=wp_sketch0.moveTo(0.023026, -0.017270).threePointArc((0.029355, -0.019003), (0.034539, -0.023026)).lineTo(0.310855, 0.011513).lineTo(0.523849, 0.034539).threePointArc((0.549763, 0.061019), (0.529605, 0.092105)).lineTo(0.437500, 0.120888).threePointArc((0.383520, 0.135761), (0.328125, 0.143914)).lineTo(0.333882, 0.069079).lineTo(0.011513, 0.034539).threePointArc((-0.005783, 0.021116), (0.000000, 0.000000)).close()
