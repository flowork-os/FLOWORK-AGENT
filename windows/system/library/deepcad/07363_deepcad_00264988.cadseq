# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00264988" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.118421, 0.000000).lineTo(0.118421, 0.111842).threePointArc((0.197450, 0.186091), (0.269737, 0.105263)).lineTo(0.269737, 0.000000).lineTo(0.467105, 0.000000).lineTo(0.467105, 0.197368).lineTo(0.625000, 0.197368).lineTo(0.625000, 0.276316).threePointArc((0.563819, 0.400891), (0.427632, 0.427632)).lineTo(0.000000, 0.315789).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.593750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.085938, 0.593750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.106579, 0.000000).circle(0.106579)
solid1=wp_sketch1.add(loop1).extrude(0.156250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
