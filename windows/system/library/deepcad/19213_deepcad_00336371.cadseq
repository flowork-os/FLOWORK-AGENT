wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.035682, 0.153253), (0.150493, 0.260855)).threePointArc((0.270888, 0.767814), (0.391283, 0.260855)).threePointArc((0.506094, 0.153253), (0.541776, 0.000000)).threePointArc((0.925168, -0.358825), (0.421382, -0.210691)).threePointArc((0.270888, -0.256342), (0.120395, -0.210691)).threePointArc((-0.383391, -0.358825), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.150493, -0.220724).circle(0.210691)
loop2=wp_sketch0.moveTo(0.270888, 0.020066).circle(0.210691)
loop3=wp_sketch0.moveTo(0.270888, 0.501645).circle(0.210691)
loop4=wp_sketch0.moveTo(0.682237, -0.220724).circle(0.210691)
