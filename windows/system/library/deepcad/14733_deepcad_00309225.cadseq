# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00309225" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.000000, -0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.445970, -0.476727).lineTo(1.091859, -0.415214).lineTo(1.460938, 0.123026).lineTo(1.261020, 0.753536).lineTo(0.645888, 0.984211).lineTo(0.092270, 0.645888).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.500000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.468750, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(0.989177, 0.000000, 0.146730)))
loop1=wp_sketch1.moveTo(0.225000, 0.000000).circle(0.225000)
solid1=wp_sketch1.add(loop1).extrude(-0.046875)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, -0.445312, 0.640625), cq.Vector(0.404330, 0.881921, -0.242346), cq.Vector(0.514103, 0.000000, 0.857729)))
loop2=wp_sketch2.moveTo(0.225000, 0.000000).circle(0.225000)
solid2=wp_sketch2.add(loop2).extrude(-0.046875)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.031250, -0.250000, 0.710938), cq.Vector(0.932993, 0.000000, -0.359895), cq.Vector(0.359895, 0.000000, 0.932993)))
loop3=wp_sketch3.moveTo(0.225000, 0.000000).circle(0.225000)
solid3=wp_sketch3.add(loop3).extrude(-0.046875)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
