# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00258394" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.900000, 0.000000).lineTo(0.900000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.157895, 0.157895).circle(0.047368)
loop2=wp_sketch0.moveTo(0.157895, 1.357895).circle(0.047368)
loop3=wp_sketch0.moveTo(0.757895, 0.157895).circle(0.047368)
loop4=wp_sketch0.moveTo(0.757895, 1.357895).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, 0.359375, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop5=wp_sketch1.moveTo(0.537171, 0.000000).lineTo(0.537171, 0.718750).lineTo(0.000000, 0.718750).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.296875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.273438, -0.273438, -0.242188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch2.moveTo(0.539062, 0.000000).lineTo(0.539062, 0.181579).lineTo(0.000000, 0.181579).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(-0.421875)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
