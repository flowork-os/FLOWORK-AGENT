# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, -0.492188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.248438, -0.261513).lineTo(0.640707, 0.117681).lineTo(0.993750, -0.261513).lineTo(1.216036, -0.052303).lineTo(0.876069, 0.300740).lineTo(1.242188, 0.653783).lineTo(1.006826, 0.902220).lineTo(0.640707, 0.549178).lineTo(0.235362, 0.928372).lineTo(0.013076, 0.719161).lineTo(0.366118, 0.353043).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.304688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
