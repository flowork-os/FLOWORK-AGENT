# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00323185" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.032999, -0.079666), (0.112664, -0.112664)).lineTo(0.968914, -0.112664).threePointArc((1.042947, -0.077332), (1.070312, 0.000000)).lineTo(1.070312, 0.540789).lineTo(0.000000, 0.540789).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.157730, 0.056332).circle(0.056332)
loop2=wp_sketch0.moveTo(0.912582, 0.056332).circle(0.056332)
loop3=wp_sketch0.moveTo(0.912582, 0.371793).circle(0.056332)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.109375, 0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.640625, 0.000000).lineTo(0.640625, 0.215789).lineTo(0.000000, 0.215789).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop4).extrude(0.640625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
