# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00366954" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.609375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.796875, 0.000000).lineTo(0.796875, 0.796875).lineTo(0.000000, 0.796875).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, -0.406250, 0.046875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.008459, -0.111709), (0.056990, -0.202632)).threePointArc((-0.007304, -0.114875), (0.000000, -0.006332)).threePointArc((0.041637, 0.036451), (0.101316, 0.037993)).threePointArc((0.339795, 0.199465), (0.101316, 0.360937)).threePointArc((0.041637, 0.362480), (0.000000, 0.405263)).threePointArc((-0.007304, 0.513806), (0.056990, 0.601562)).threePointArc((-0.008459, 0.510640), (0.000000, 0.398931)).threePointArc((0.043061, 0.359676), (0.101316, 0.360937)).threePointArc((0.342976, 0.199465), (0.101316, 0.037993)).threePointArc((0.043061, 0.039255), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(-0.398438)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
