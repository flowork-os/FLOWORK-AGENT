loop0=wp_sketch0.moveTo(0.015543, 0.000000).lineTo(0.015543, 0.124342).threePointArc((0.023314, 0.121123), (0.031086, 0.124342)).lineTo(1.445477, 0.124342).threePointArc((1.453248, 0.121123), (1.461020, 0.124342)).lineTo(1.461020, 0.000000).lineTo(1.476562, 0.000000).lineTo(1.476562, 0.139885).threePointArc((1.479782, 0.147656), (1.476562, 0.155428)).lineTo(0.000000, 0.155428).threePointArc((-0.003219, 0.147656), (0.000000, 0.139885)).lineTo(0.000000, 0.000000).close()
