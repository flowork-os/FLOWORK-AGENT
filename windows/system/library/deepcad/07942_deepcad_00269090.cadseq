import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.632812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.549589).threePointArc((-0.087130, 0.636719), (0.000000, 0.723849)).lineTo(0.000000, 1.273438).threePointArc((-0.636719, 0.636719), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.632812, 0.023438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.549589).threePointArc((-0.087130, 0.636719), (0.000000, 0.723849)).lineTo(0.000000, 1.273438).threePointArc((-0.636719, 0.636719), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.004801, 0.022009), (-0.026809, 0.026809)).lineTo(-0.026809, 0.522780).threePointArc((-0.106893, 0.591997), (-0.093832, 0.697039)).lineTo(-0.455757, 1.058964).close()
loop3=wp_sketch1.moveTo(-0.080428, 0.710444).threePointArc((-0.056601, 0.734528), (-0.026809, 0.750658)).lineTo(-0.026809, 1.246628).threePointArc((-0.244101, 1.196934), (-0.428947, 1.072368)).close()
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.367188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.117188, 0.382812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.000000, 0.023849).threePointArc((-0.090625, 0.114474), (0.000000, 0.205099)).lineTo(0.000000, 0.226562).threePointArc((-0.113281, 0.113281), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop4).extrude(0.367188)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, -1.000000, 0.296875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.011595, 0.000000).circle(0.011842)
solid3=wp_sketch3.add(loop5).extrude(-0.023438)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, -0.210938, 0.296875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.011842, 0.000000).circle(0.011842)
solid4=wp_sketch4.add(loop6).extrude(-0.023438)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
