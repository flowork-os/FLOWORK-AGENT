import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.234375, -0.171875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.017053, -0.041170), (0.058224, -0.058224)).lineTo(0.402714, -0.058224).threePointArc((0.443884, -0.041170), (0.460938, 0.000000)).lineTo(0.460938, 0.344490).threePointArc((0.443884, 0.385660), (0.402714, 0.402714)).lineTo(0.058224, 0.402714).threePointArc((0.017053, 0.385660), (0.000000, 0.344490)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.023083, -0.026614), (0.058224, -0.029112)).lineTo(0.402714, -0.029112).threePointArc((0.423299, -0.020585), (0.431826, 0.000000)).lineTo(0.431826, 0.344490).threePointArc((0.423299, 0.365075), (0.402714, 0.373602)).lineTo(0.058224, 0.373602).threePointArc((0.037639, 0.365075), (0.029112, 0.344490)).lineTo(0.029112, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
