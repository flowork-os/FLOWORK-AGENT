import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.046246, -0.111648), (0.157895, -0.157895)).lineTo(1.357895, -0.157895).threePointArc((1.461648, -0.108378), (1.500000, 0.000000)).lineTo(1.500000, 0.442105).threePointArc((1.461648, 0.550484), (1.357895, 0.600000)).lineTo(0.157895, 0.600000).threePointArc((0.046246, 0.553754), (0.000000, 0.442105)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.312500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
