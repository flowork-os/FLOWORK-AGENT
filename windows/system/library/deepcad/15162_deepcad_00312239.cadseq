# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00312239" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.617188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.339696, -0.617187), (0.000000, -1.234375)).lineTo(0.818586, -1.234375).threePointArc((1.158282, -0.617188), (0.818586, 0.000000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(-0.025987, -1.052467).circle(0.038980)
loop2=wp_sketch0.moveTo(-0.025987, -0.181908).circle(0.038980)
loop3=wp_sketch0.moveTo(0.844572, -1.052467).circle(0.038980)
loop4=wp_sketch0.moveTo(0.844572, -0.181908).circle(0.038980)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
