loop1=wp_sketch0.moveTo(0.574095, 0.235526).lineTo(0.574095, 0.117763).threePointArc((0.647697, 0.044161), (0.721299, 0.117763)).lineTo(0.721299, 0.235526).lineTo(1.295395, 0.279688).threePointArc((1.368775, 0.360650), (1.295395, 0.441612)).lineTo(0.721299, 0.485773).lineTo(0.721299, 0.603536).threePointArc((0.647697, 0.677138), (0.574095, 0.603536)).lineTo(0.574095, 0.471053).lineTo(0.103043, 0.441612).threePointArc((0.028753, 0.360650), (0.103043, 0.279688)).close()
