wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.008864, -0.021399), (0.030263, -0.030263)).lineTo(0.128618, -0.030263).threePointArc((0.150018, -0.021399), (0.158882, 0.000000)).lineTo(0.158882, 0.688487).threePointArc((0.150018, 0.709886), (0.128618, 0.718750)).lineTo(0.030263, 0.718750).threePointArc((0.008864, 0.709886), (0.000000, 0.688487)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.075658, 0.060526).lineTo(0.113487, 0.151316).lineTo(0.075658, 0.249671).lineTo(0.045395, 0.151316).close()
loop2=wp_sketch0.moveTo(0.075658, 0.340461).lineTo(0.113487, 0.438816).lineTo(0.075658, 0.529605).lineTo(0.045395, 0.438816).close()
loop3=wp_sketch0.moveTo(0.075658, 0.620395).circle(0.030263)
