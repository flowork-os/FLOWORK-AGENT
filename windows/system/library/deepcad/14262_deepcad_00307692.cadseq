# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, -0.656250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.052796, 0.000000).lineTo(1.052796, 0.298766).lineTo(0.754030, 0.298766).lineTo(0.754030, 1.052796).lineTo(1.052796, 1.052796).lineTo(1.052796, 1.351562).lineTo(0.000000, 1.351562).lineTo(0.000000, 1.052796).lineTo(0.298766, 1.052796).lineTo(0.298766, 0.298766).lineTo(0.000000, 0.298766).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
