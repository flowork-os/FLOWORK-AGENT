import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.018499, -0.044659), (0.063158, -0.063158)).lineTo(1.436842, -0.063158).threePointArc((1.481501, -0.044659), (1.500000, 0.000000)).lineTo(1.500000, 0.142105).threePointArc((1.481501, 0.186765), (1.436842, 0.205263)).lineTo(0.063158, 0.205263).threePointArc((0.018499, 0.186765), (0.000000, 0.142105)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.063158, 0.063158).circle(0.031579)
loop2=wp_sketch0.moveTo(1.436842, 0.063158).circle(0.031579)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
