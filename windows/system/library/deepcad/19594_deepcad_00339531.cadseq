# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00339531" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.132812, 0.000000).lineTo(1.132812, 0.190789).lineTo(0.977796, 0.190789).threePointArc((0.833791, 0.162662), (0.965872, 0.226562)).lineTo(1.132812, 0.226562).lineTo(1.132812, 0.310033).lineTo(0.000000, 0.310033).lineTo(0.000000, 0.226562).lineTo(0.166941, 0.226562).threePointArc((0.299021, 0.162662), (0.155016, 0.190789)).lineTo(0.000000, 0.190789).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.572368, 0.190789).circle(0.107319)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.114474, 0.000000).circle(0.114474)
solid1=wp_sketch1.add(loop2).extrude(0.156250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
