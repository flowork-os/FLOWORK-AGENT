# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00298772" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.180592, 0.000000).lineTo(0.180592, 0.055181).lineTo(0.295970, 0.055181).lineTo(0.295970, 0.000000).lineTo(0.476562, 0.000000).lineTo(0.476562, 0.311020).lineTo(0.000000, 0.311020).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.130428, 0.150493).circle(0.045148)
loop2=wp_sketch0.moveTo(0.346135, 0.150493).circle(0.045148)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.289062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
