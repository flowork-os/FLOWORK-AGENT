import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.687500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.023191, -0.069572).lineTo(0.023191, -0.687993).lineTo(0.015461, -0.734375).threePointArc((0.050247, -0.705105), (0.085033, -0.734375)).lineTo(0.077303, -0.687993).lineTo(0.077303, -0.069572).lineTo(0.092763, -0.015461).lineTo(0.100493, 0.000000).lineTo(0.100493, 0.015461).threePointArc((0.095163, 0.041784), (0.077303, 0.061842)).lineTo(0.077303, 0.000000).lineTo(0.023191, 0.000000).lineTo(0.023191, 0.061842).threePointArc((0.000745, 0.034990), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.687500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.023191, -0.069572).lineTo(0.023191, -0.687993).lineTo(0.015461, -0.734375).threePointArc((0.050247, -0.705105), (0.085033, -0.734375)).lineTo(0.077303, -0.687993).lineTo(0.077303, -0.069572).lineTo(0.092763, -0.015461).lineTo(0.100493, 0.000000).lineTo(0.100493, 0.015461).threePointArc((0.095163, 0.041784), (0.077303, 0.061842)).lineTo(0.077303, 0.000000).lineTo(0.023191, 0.000000).lineTo(0.023191, 0.061842).threePointArc((0.000745, 0.034990), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.015625, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, -0.054688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.035526, 0.000000).circle(0.035526)
loop3=wp_sketch2.moveTo(0.035526, 0.000000).circle(0.026645)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.015625, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
