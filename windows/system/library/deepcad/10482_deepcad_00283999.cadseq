wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.640625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.032372, -0.078154), (0.110526, -0.110526)).lineTo(1.389474, -0.110526).threePointArc((1.467628, -0.078154), (1.500000, 0.000000)).lineTo(1.500000, 1.278947).threePointArc((1.467628, 1.357101), (1.389474, 1.389474)).lineTo(0.110526, 1.389474).threePointArc((0.032372, 1.357101), (0.000000, 1.278947)).lineTo(0.000000, 0.000000).close()
