import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, -0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.246053, 0.000000).lineTo(1.214885, 0.000000).lineTo(1.460938, 0.000000).lineTo(1.460938, 0.123026).lineTo(1.384046, 0.246053).threePointArc((0.730469, 0.555172), (0.076891, 0.246053)).lineTo(0.000000, 0.123026).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.246053, 0.076891).circle(0.030757)
loop2=wp_sketch0.moveTo(1.184128, 0.246053).threePointArc((0.730469, 0.408375), (0.276809, 0.246053)).close()
loop3=wp_sketch0.moveTo(1.214885, 0.076891).circle(0.030757)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
