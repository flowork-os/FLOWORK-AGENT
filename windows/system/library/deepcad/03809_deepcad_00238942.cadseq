wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.061354, -0.231245), (0.177878, -0.228701)).threePointArc((0.193173, -0.213800), (0.211760, -0.203289)).threePointArc((0.418469, -0.159097), (0.626809, -0.194819)).threePointArc((0.644141, -0.197491), (0.660691, -0.203289)).threePointArc((0.788702, -0.183977), (0.753865, -0.059293)).threePointArc((0.749474, -0.055214), (0.745395, -0.050822)).threePointArc((0.385137, 0.080791), (0.008470, 0.008470)).threePointArc((0.004313, 0.004157), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.059293, -0.135526).circle(0.076234)
