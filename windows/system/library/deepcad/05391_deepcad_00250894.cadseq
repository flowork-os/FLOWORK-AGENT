import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, -0.578125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.476562, 0.000000).lineTo(1.476562, 1.165707).lineTo(0.000000, 1.165707).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.746053, 0.575082).circle(0.466283)
loop2=wp_sketch0.moveTo(1.414391, 0.979194).lineTo(1.414391, 1.103536).lineTo(1.134622, 1.103536).lineTo(1.134622, 0.979194).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.203125)
solid=solid0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, -0.578125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.476562, 0.000000).lineTo(1.476562, 1.165707).lineTo(0.000000, 1.165707).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.746053, 0.575082).circle(0.466283)
