# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.359375, -0.476562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.718174, 0.000000).lineTo(0.718174, 0.960938).lineTo(0.000000, 0.960938).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.093750, 0.000000, -0.476562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.640625, 0.000000).lineTo(0.640625, 0.087664).lineTo(0.000000, 0.087664).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.359375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.093750, 0.000000, -0.476562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.640625, 0.000000).lineTo(0.640625, 0.087664).lineTo(0.000000, 0.087664).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.359375)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.093750, 0.000000, -0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.552632, 0.000000).threePointArc((0.657057, 0.248898), (0.542763, 0.493421)).threePointArc((0.591920, 0.671053), (0.542763, 0.848684)).threePointArc((0.274178, 0.935450), (0.000000, 0.868421)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.523026, 0.542763).threePointArc((0.544796, 0.678330), (0.503289, 0.809211)).threePointArc((0.291000, 0.881916), (0.069079, 0.848684)).lineTo(0.069079, 0.542763).close()
loop5=wp_sketch3.moveTo(0.513158, 0.049342).threePointArc((0.601267, 0.244631), (0.523026, 0.444079)).lineTo(0.078947, 0.453947).lineTo(0.078947, 0.049342).close()
solid3=wp_sketch3.add(loop3).add(loop4).add(loop5).extrude(0.320312)
