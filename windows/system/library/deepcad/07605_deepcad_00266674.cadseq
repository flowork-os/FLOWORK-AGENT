import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.099424, 0.000000).lineTo(0.099424, 0.010197).lineTo(0.142763, 0.010197).lineTo(0.142763, 0.000000).lineTo(0.242188, 0.000000).lineTo(0.242188, 0.076480).lineTo(0.000000, 0.076480).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.109375, 0.000000).lineTo(0.109375, 0.011513).lineTo(0.011513, 0.011513).lineTo(0.011513, 0.087500).lineTo(0.000000, 0.087500).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.085938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.023438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.109375, 0.000000).lineTo(0.109375, 0.087500).lineTo(0.099013, 0.087500).lineTo(0.099013, 0.011513).lineTo(0.000000, 0.011513).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.085938)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.023684, 0.000000).lineTo(0.046875, 0.000000).lineTo(0.046875, 0.011842).lineTo(0.046875, 0.023684).lineTo(0.000000, 0.023684).lineTo(0.000000, 0.011842).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.726562)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
