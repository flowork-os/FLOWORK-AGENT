# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00261641" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.079934, -0.079934).lineTo(0.156908, -0.079934).lineTo(0.156908, 0.000000).threePointArc((0.078454, 0.078454), (0.156908, 0.156908)).lineTo(0.156908, 0.281250).lineTo(0.079934, 0.281250).lineTo(0.000000, 0.201316).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.484375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.236842, 0.000000).threePointArc((0.273277, -0.013413), (0.292105, -0.047368)).threePointArc((0.315855, -0.135310), (0.363158, -0.213158)).lineTo(0.426316, -0.213158).lineTo(0.750000, 0.157895).lineTo(0.750000, 0.371053).lineTo(0.694737, 0.426316).lineTo(0.426316, 0.426316).threePointArc((0.332046, 0.339985), (0.205263, 0.323684)).lineTo(0.000000, 0.355263).lineTo(0.000000, 0.236842).threePointArc((0.078947, 0.157895), (0.000000, 0.078947)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.484375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
