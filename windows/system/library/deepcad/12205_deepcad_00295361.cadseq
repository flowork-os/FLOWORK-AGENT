import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.012862, -0.031052), (0.043914, -0.043914)).lineTo(0.651398, -0.043914).threePointArc((0.682450, -0.031052), (0.695312, 0.000000)).lineTo(0.695312, 0.014638).threePointArc((0.682450, 0.045690), (0.651398, 0.058553)).lineTo(0.043914, 0.058553).threePointArc((0.012862, 0.045690), (0.000000, 0.014638)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.043914, 0.007319).circle(0.014638)
loop2=wp_sketch0.moveTo(0.592845, 0.007319).circle(0.007319)
loop3=wp_sketch0.moveTo(0.666036, 0.007319).circle(0.007319)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
