# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00358501" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.023438, -0.515625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.531743, 0.000000).lineTo(0.531743, 0.752467).threePointArc((0.389857, 0.811238), (0.331086, 0.953125)).lineTo(0.000000, 0.953125).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.359375, 0.437500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.193257, 0.000000).lineTo(0.193257, -0.193257).threePointArc((0.329910, 0.136653), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.226562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.359375, 0.437500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.057206, -0.138107), (0.195312, -0.195312)).lineTo(0.195312, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.226562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
