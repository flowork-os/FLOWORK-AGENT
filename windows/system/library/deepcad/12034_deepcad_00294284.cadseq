import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.267188, 0.000000).lineTo(0.267188, -0.112500).lineTo(0.295313, -0.140625).lineTo(1.054688, -0.140625).lineTo(1.068750, -0.112500).lineTo(1.068750, 0.000000).lineTo(1.335938, 0.000000).lineTo(1.335938, 0.506250).threePointArc((1.286512, 0.625574), (1.167188, 0.675000)).lineTo(0.154688, 0.675000).lineTo(0.000000, 0.590625).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.196875, 0.196875).circle(0.098437)
loop2=wp_sketch0.moveTo(0.632812, 0.464062).circle(0.168750)
loop3=wp_sketch0.moveTo(1.209375, 0.098437).circle(0.028125)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.164062)
solid=solid0

