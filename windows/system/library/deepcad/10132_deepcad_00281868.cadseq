# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00281868" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.434622, 0.000000).lineTo(1.030674, 0.000000).threePointArc((1.179688, 0.149013), (1.030674, 0.298026)).lineTo(0.434622, 0.298026).lineTo(0.000000, 0.298026).threePointArc((-0.149013, 0.149013), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.149013).circle(0.074507)
loop2=wp_sketch0.moveTo(1.030674, 0.149013).circle(0.074507)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.007812, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.148438, 0.000000).threePointArc((0.043476, 0.043476), (0.000000, 0.148438)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.007812, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.043476, -0.104961), (0.148438, -0.148438)).lineTo(0.109375, -0.123438).lineTo(0.045313, -0.071875).lineTo(0.018750, -0.012500).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(-0.007812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
