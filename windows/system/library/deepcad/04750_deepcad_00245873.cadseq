import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.111020, 0.000000).lineTo(0.111020, -0.191201).lineTo(0.000000, -0.191201).threePointArc((-0.388569, 0.197368), (0.000000, 0.585938)).lineTo(0.000000, 0.394737).threePointArc((-0.197368, 0.197368), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.003783, -0.000023), (0.007566, 0.000000)).lineTo(0.718750, 0.000000).lineTo(0.718750, 0.189145).lineTo(0.000000, 0.196711).lineTo(0.000000, 0.189145).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.195312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.250000, -0.390625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.115132, 0.000000).threePointArc((0.506468, 0.394788), (0.106908, 0.781250)).lineTo(0.115132, 0.583882).threePointArc((0.312500, 0.386513), (0.115132, 0.189145)).lineTo(0.000000, 0.189145).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.195312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.195312, 0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.531250, 0.000000).lineTo(0.531250, 0.229276).threePointArc((0.265625, -0.036349), (0.000000, 0.229276)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.268421, 0.229276).circle(0.128618)
solid3=wp_sketch3.add(loop3).add(loop4).extrude(-0.187500)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
