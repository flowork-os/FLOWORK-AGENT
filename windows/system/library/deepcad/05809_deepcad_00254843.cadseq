# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00254843" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.789474).lineTo(0.000000, 0.789474).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.189474, 0.063158).lineTo(0.189474, 0.710526).lineTo(0.047368, 0.710526).lineTo(0.047368, 0.063158).close()
loop2=wp_sketch0.moveTo(0.757895, 0.394737).circle(0.268421)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.015625, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
