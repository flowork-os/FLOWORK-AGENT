import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.000000, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.382812, 0.000000).lineTo(1.382812, 0.829688).lineTo(0.000000, 0.829688).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.476562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.437500, 0.000000).lineTo(1.437500, 0.060526).lineTo(0.060526, 0.060526).lineTo(0.060526, 0.892763).lineTo(1.437500, 0.892763).lineTo(1.437500, 0.938158).lineTo(0.000000, 0.938158).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.328125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.328125, 0.476562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(1.437500, 0.000000).lineTo(1.437500, 0.121053).lineTo(0.000000, 0.121053).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.062500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.328125, -0.593750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(1.437500, 0.000000).lineTo(1.437500, 0.121053).lineTo(0.000000, 0.121053).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.062500)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
