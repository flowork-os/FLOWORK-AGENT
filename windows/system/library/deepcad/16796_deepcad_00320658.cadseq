# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00320658" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.031250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.757895)
loop2=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.726316)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.664062, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.039302, -0.059567), (0.109375, -0.046053)).threePointArc((0.053839, -0.025041), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(-0.078125)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.664062, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.053757, -0.025038), (0.109211, -0.046053)).threePointArc((0.118419, -0.035086), (0.125000, -0.022368)).threePointArc((0.064715, 0.000087), (0.006579, 0.027632)).threePointArc((0.001757, 0.014181), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop4).extrude(-0.078125)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, -0.640625, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.055710, -0.026493), (0.113487, -0.048109)).threePointArc((0.079645, 0.029970), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop5).extrude(-0.078125)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
