# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00295899" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.619737, 0.000000).circle(0.619737)
loop1=wp_sketch0.moveTo(0.258224, -0.348602).circle(0.038734)
loop2=wp_sketch0.moveTo(0.258224, 0.348602).circle(0.038734)
loop3=wp_sketch0.moveTo(0.619737, 0.193668).circle(0.219490)
loop4=wp_sketch0.moveTo(0.968339, -0.348602).circle(0.038734)
loop5=wp_sketch0.moveTo(0.968339, 0.348602).circle(0.038734)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(-0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.054688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.225000, 0.000000).circle(0.225000)
loop7=wp_sketch1.moveTo(0.225000, 0.000000).circle(0.173437)
solid1=wp_sketch1.add(loop6).add(loop7).extrude(-0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
