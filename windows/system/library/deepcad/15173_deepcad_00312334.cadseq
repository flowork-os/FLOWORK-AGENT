# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00312334" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.820313, 0.000000).lineTo(0.820313, 0.069079).lineTo(0.820313, 0.138158).lineTo(0.000000, 0.138158).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.112253, 0.025905).lineTo(0.112253, 0.112253).lineTo(0.025905, 0.112253).lineTo(0.025905, 0.025905).close()
loop2=wp_sketch0.moveTo(0.794408, 0.025905).lineTo(0.794408, 0.069079).lineTo(0.794408, 0.112253).lineTo(0.708059, 0.112253).lineTo(0.708059, 0.025905).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
