# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00287456" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.742105)
loop1=wp_sketch0.moveTo(0.552632, -0.094737).threePointArc((0.530133, 0.000000), (0.552632, 0.094737)).lineTo(0.315789, 0.505263).threePointArc((0.084362, 0.000000), (0.315789, -0.505263)).close()
loop2=wp_sketch0.moveTo(0.315789, -0.505263).threePointArc((0.947312, -0.565297), (1.405263, -0.126316)).lineTo(0.931579, -0.126316).threePointArc((0.855986, -0.194308), (0.757895, -0.221053)).lineTo(0.536842, -0.631579).close()
loop3=wp_sketch0.moveTo(0.757895, 0.221053).threePointArc((0.855986, 0.194308), (0.931579, 0.126316)).lineTo(1.405263, 0.126316).threePointArc((1.086766, 0.577830), (0.536842, 0.631579)).close()
loop4=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.078947)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
