wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001012, -0.002442), (0.003454, -0.003454)).lineTo(0.051234, -0.003454).threePointArc((0.053676, -0.002442), (0.054687, 0.000000)).lineTo(0.054687, 0.047780).threePointArc((0.053676, 0.050222), (0.051234, 0.051234)).lineTo(0.003454, 0.051234).threePointArc((0.001012, 0.050222), (0.000000, 0.047780)).lineTo(0.000000, 0.000000).close()
