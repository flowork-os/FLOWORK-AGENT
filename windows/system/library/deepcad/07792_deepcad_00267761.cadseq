# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.002878, 0.000000).threePointArc((0.002451, -0.001846), (0.003454, -0.003454)).lineTo(0.051234, -0.003454).threePointArc((0.053676, -0.002442), (0.054687, 0.000000)).lineTo(0.054687, 0.047780).threePointArc((0.053676, 0.050222), (0.051234, 0.051234)).lineTo(0.003454, 0.051234).threePointArc((0.001012, 0.050222), (0.000000, 0.047780)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.001608, -0.001003), (0.003454, -0.000576)).lineTo(0.051234, -0.000576).threePointArc((0.051641, -0.000407), (0.051809, 0.000000)).lineTo(0.051809, 0.047780).threePointArc((0.051641, 0.048187), (0.051234, 0.048355)).lineTo(0.003454, 0.048355).threePointArc((0.003047, 0.048187), (0.002878, 0.047780)).lineTo(0.002878, 0.000000).close()
