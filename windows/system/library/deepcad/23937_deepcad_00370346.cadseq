loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.031209, -0.093627), (0.124836, -0.062418)).lineTo(0.221299, 0.136184).threePointArc((0.246881, 0.164888), (0.283717, 0.175905)).lineTo(0.470970, 0.175905).threePointArc((0.539062, 0.243997), (0.470970, 0.312089)).lineTo(0.283717, 0.312089).threePointArc((0.174012, 0.281875), (0.096464, 0.198602)).lineTo(0.000000, 0.000000).close()
