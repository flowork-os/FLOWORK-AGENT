import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, -0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.343421, 0.000000).lineTo(0.343421, 0.679688).lineTo(0.000000, 0.679688).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.314803, 0.021464).lineTo(0.314803, 0.658224).lineTo(0.021464, 0.658224).lineTo(0.021464, 0.021464).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, -0.320312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.293092, 0.000000).lineTo(0.293092, 0.632812).lineTo(0.000000, 0.632812).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.186513, 0.213158).circle(0.026645)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.742188, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.335938, 0.000000).lineTo(0.335938, 0.021217).lineTo(0.000000, 0.021217).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.046875)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.085938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.335938, 0.000000).lineTo(0.335938, 0.021217).lineTo(0.000000, 0.021217).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.046875)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
