import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.053289, -0.086595).threePointArc((0.061482, -0.095956), (0.073273, -0.099918)).lineTo(0.539556, -0.099918).threePointArc((0.551748, -0.096557), (0.559539, -0.086595)).lineTo(0.632812, 0.139885).threePointArc((0.634864, 0.149877), (0.632812, 0.159868)).lineTo(0.572862, 0.259786).threePointArc((0.561785, 0.270939), (0.546217, 0.273109)).lineTo(0.059951, 0.139885).threePointArc((0.053558, 0.059836), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.339720, 0.033306).circle(0.039967)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.053289, -0.086595).threePointArc((0.061482, -0.095956), (0.073273, -0.099918)).lineTo(0.539556, -0.099918).threePointArc((0.551748, -0.096557), (0.559539, -0.086595)).lineTo(0.632812, 0.139885).threePointArc((0.634864, 0.149877), (0.632812, 0.159868)).lineTo(0.572862, 0.259786).threePointArc((0.561785, 0.270939), (0.546217, 0.273109)).lineTo(0.452961, 0.246464).lineTo(0.479605, 0.159868).threePointArc((0.409085, 0.022981), (0.279770, 0.106579)).lineTo(0.259786, 0.193174).lineTo(0.059951, 0.139885).threePointArc((0.053558, 0.059836), (0.000000, 0.000000)).close()
