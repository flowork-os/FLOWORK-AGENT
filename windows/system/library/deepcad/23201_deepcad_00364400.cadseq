wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, -0.734375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.015625, 0.000000).lineTo(0.015625, 1.156250).threePointArc((0.107154, 1.377221), (0.328125, 1.468750)).lineTo(0.437500, 1.468750).threePointArc((0.658471, 1.377221), (0.750000, 1.156250)).lineTo(0.750000, 0.000000).lineTo(0.765625, 0.000000).lineTo(0.765625, 1.156250).threePointArc((0.669519, 1.388269), (0.437500, 1.484375)).lineTo(0.328125, 1.484375).threePointArc((0.096106, 1.388269), (0.000000, 1.156250)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.421875)
solid=solid0

if __name__ == '__main__':
