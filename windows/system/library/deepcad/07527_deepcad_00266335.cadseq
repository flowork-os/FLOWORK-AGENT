wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.429688, 0.203125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.035526, 0.000000).circle(0.034786)
solid3=wp_sketch3.add(loop3).extrude(-0.140625)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.429688, 0.609375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.035526, 0.000000).circle(0.034786)
