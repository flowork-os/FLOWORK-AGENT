# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.617188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.067105, 0.000000).circle(0.067105)
loop3=wp_sketch2.moveTo(0.067105, 0.000000).circle(0.033553)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.132812)
