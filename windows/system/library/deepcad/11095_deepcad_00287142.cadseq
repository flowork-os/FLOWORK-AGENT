wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.015625, 0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.086032, -0.043999), (0.120230, -0.134375)).lineTo(0.155592, -0.134375).threePointArc((0.165949, -0.109370), (0.190954, -0.099013)).lineTo(0.459704, -0.099013).threePointArc((0.484709, -0.109370), (0.495066, -0.134375)).lineTo(0.594079, -0.134375).threePointArc((0.618870, -0.085307), (0.671875, -0.070724)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
