# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00364795" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.053674, 0.122792), (0.173684, 0.063158)).threePointArc((0.345562, 0.407208), (0.694737, 0.568421)).threePointArc((0.750000, 0.626466), (0.805263, 0.568421)).threePointArc((1.154438, 0.407208), (1.326316, 0.063158)).threePointArc((1.392653, 0.000000), (1.326316, -0.063158)).threePointArc((1.154438, -0.407208), (0.805263, -0.568421)).threePointArc((0.750000, -0.626466), (0.694737, -0.568421)).threePointArc((0.345562, -0.407208), (0.173684, -0.063158)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.132072, -0.048026).threePointArc((0.238125, -0.341454), (0.504276, -0.504276)).threePointArc((0.570312, -0.441405), (0.636349, -0.504276)).threePointArc((0.976962, -0.340613), (1.140625, 0.000000)).threePointArc((1.083469, 0.060033), (1.140625, 0.120066)).threePointArc((0.979069, 0.466682), (0.636349, 0.636349)).threePointArc((0.570312, 0.573477), (0.504276, 0.636349)).threePointArc((0.161556, 0.466682), (0.000000, 0.120066)).threePointArc((0.057156, 0.060033), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.054688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
