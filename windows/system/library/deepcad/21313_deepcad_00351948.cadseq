# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00351948" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.158224, 0.000000).lineTo(0.158224, 0.097368).lineTo(0.419901, 0.097368).lineTo(0.419901, 0.000000).lineTo(0.578125, 0.000000).lineTo(0.578125, 0.194737).lineTo(0.000000, 0.194737).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.265625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.000000, 0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.578125, 0.000000).lineTo(0.578125, 0.261678).threePointArc((0.289062, 0.550740), (0.000000, 0.261678)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.292105, 0.261678).circle(0.133882)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, 0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.134211, 0.000000).circle(0.134211)
loop4=wp_sketch2.moveTo(0.134211, 0.000000).circle(0.067105)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.187500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
