# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257655" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.868750, 0.000000).threePointArc((1.085938, 0.217188), (0.868750, 0.434375)).lineTo(0.582977, 0.434375).lineTo(0.582977, 0.365789).lineTo(0.285773, 0.365789).lineTo(0.285773, 0.434375).lineTo(0.000000, 0.434375).threePointArc((-0.217188, 0.217188), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.217188).circle(0.091447)
loop2=wp_sketch0.moveTo(0.868750, 0.217188).circle(0.091447)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
