import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.031579, -0.126316).lineTo(0.363158, -0.047368).threePointArc((0.750000, 0.005171), (1.136842, -0.047368)).lineTo(1.468421, -0.126316).lineTo(1.500000, 0.000000).lineTo(1.168421, 0.094737).threePointArc((0.750000, 0.151565), (0.331579, 0.094737)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.195312, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.193257, 0.000000).lineTo(0.394243, 0.000000).lineTo(0.394243, 0.734375).lineTo(0.216447, 0.077303).lineTo(0.177796, 0.077303).lineTo(0.000000, 0.734375).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-1.000000, both=True)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.000000, 0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, -0.015132).lineTo(0.332895, 0.060526).threePointArc((0.718750, 0.112932), (1.104605, 0.060526)).lineTo(1.437500, -0.015132).lineTo(1.437500, 0.000000).lineTo(1.104605, 0.090789).threePointArc((0.718750, 0.143195), (0.332895, 0.090789)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.289062, both=True)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
