wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.429688, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.155592, -0.343750).lineTo(0.314803, 0.000000).lineTo(0.256908, 0.043421).lineTo(0.184539, 0.047039).lineTo(0.130263, 0.047039).lineTo(0.036184, 0.028947).lineTo(0.000000, 0.000000).close()
