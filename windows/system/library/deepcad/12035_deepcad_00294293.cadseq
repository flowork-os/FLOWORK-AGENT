import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.296875, -0.304688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.338651, 0.000000).lineTo(0.438816, 0.000000).threePointArc((0.448934, 0.004191), (0.453125, 0.014309)).lineTo(0.453125, 0.414967).threePointArc((0.446140, 0.431831), (0.429276, 0.438816)).lineTo(0.352961, 0.438816).threePointArc((0.342842, 0.434625), (0.338651, 0.424507)).lineTo(0.338651, 0.357730).lineTo(0.000000, 0.310033).lineTo(0.000000, 0.257566).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.203125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, -0.289062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.003685, -0.008897), (0.012582, -0.012582)).lineTo(0.285197, -0.012582).lineTo(0.398438, -0.012582).lineTo(0.398438, 0.247451).lineTo(0.285197, 0.247451).lineTo(0.285197, 0.285197).lineTo(0.012582, 0.247451).threePointArc((0.004703, 0.245639), (0.000000, 0.239063)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.203125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
