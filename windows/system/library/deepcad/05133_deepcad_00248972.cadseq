wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.005034, -0.012153), (0.017188, -0.017188)).lineTo(0.068750, -0.017188).threePointArc((0.080903, -0.012153), (0.085938, 0.000000)).lineTo(0.085938, 0.051562).threePointArc((0.080903, 0.063716), (0.068750, 0.068750)).lineTo(0.017188, 0.068750).threePointArc((0.005034, 0.063716), (0.000000, 0.051562)).lineTo(0.000000, 0.000000).close()
