# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00292944" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.140625, -0.706970), (0.281250, 0.000000)).lineTo(0.281250, 0.414474).lineTo(0.162829, 0.414474).lineTo(0.162829, -0.088816).threePointArc((0.140625, -0.540788), (0.118421, -0.088816)).lineTo(0.118421, 0.414474).lineTo(0.000000, 0.414474).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.578125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.460938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.079112, -0.124753).lineTo(0.079112, 0.289062).lineTo(0.000000, 0.164309).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.578125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.460938, 0.242188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.082895, -0.046628).lineTo(0.164062, 0.000000).lineTo(0.164062, 0.094984).lineTo(0.082895, 0.141612).lineTo(0.000000, 0.094984).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.085938)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
