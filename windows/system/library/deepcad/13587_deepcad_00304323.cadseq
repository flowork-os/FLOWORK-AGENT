# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00304323" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.126316, 0.000000).circle(0.126316)
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.226562, 0.000000, -0.093750), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.135855, -0.135855).lineTo(0.325082, -0.135855).lineTo(0.460938, 0.000000).lineTo(0.460938, 0.189227).lineTo(0.325082, 0.325082).lineTo(0.135855, 0.325082).lineTo(0.000000, 0.189227).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.232895, 0.097039).circle(0.126151)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.250000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
