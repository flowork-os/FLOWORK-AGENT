wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.064711, 0.043435), (0.141118, 0.058799)).lineTo(0.729112, 0.058799).threePointArc((0.797872, 0.046503), (0.858470, 0.011760)).threePointArc((1.127690, 0.141118), (0.858470, 0.270477)).threePointArc((0.797872, 0.235734), (0.729112, 0.223438)).lineTo(0.141118, 0.223438).threePointArc((0.064711, 0.238802), (0.000000, 0.282237)).threePointArc((-0.346692, 0.141118), (0.000000, 0.000000)).close()
