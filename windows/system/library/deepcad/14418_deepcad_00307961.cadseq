# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.055263, -0.031579).lineTo(0.750000, 0.378947).lineTo(0.750000, 0.442105).lineTo(0.000000, 0.000000).close()
