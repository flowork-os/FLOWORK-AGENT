# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.476562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.750000, 0.442105).lineTo(0.694737, 0.481579).lineTo(0.000000, 0.071053).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.031250, both=True)
