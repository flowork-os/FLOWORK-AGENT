# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00309795" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.051316, 0.000000).circle(0.051316)
solid0=wp_sketch0.add(loop0).extrude(-0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.051316, 0.000000).circle(0.051316)
solid1=wp_sketch1.add(loop1).extrude(-0.125000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.484375, 0.000000).lineTo(0.484375, 0.040789).lineTo(0.000000, 0.040789).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.039062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.488487, 0.000000).lineTo(0.488487, 0.009046).threePointArc((0.496435, 0.028236), (0.515625, 0.036184)).lineTo(0.750822, 0.036184).threePointArc((0.859375, 0.144737), (0.750822, 0.253289)).lineTo(0.515625, 0.253289).threePointArc((0.494562, 0.265761), (0.488487, 0.289474)).lineTo(0.488487, 0.298520).lineTo(0.000000, 0.298520).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.560855, 0.144737).circle(0.054276)
loop5=wp_sketch3.moveTo(0.750822, 0.144737).circle(0.054276)
solid3=wp_sketch3.add(loop3).add(loop4).add(loop5).extrude(0.039062)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch4.moveTo(0.484375, 0.000000).lineTo(0.484375, 0.040789).lineTo(0.000000, 0.040789).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(0.039062)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
