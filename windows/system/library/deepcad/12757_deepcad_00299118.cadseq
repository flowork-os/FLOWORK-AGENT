# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00299118" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.584211, 0.000000).lineTo(0.584211, 0.457895).threePointArc((0.292105, 0.750000), (0.000000, 0.457895)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.292105, 0.647368).circle(0.047368)
loop2=wp_sketch0.moveTo(0.292105, 0.063158).circle(0.039474)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.343750, 0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.217105, 0.000000).circle(0.217105)
solid1=wp_sketch1.add(loop3).extrude(-0.039062)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
