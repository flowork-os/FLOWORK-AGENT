# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00333484" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.086842).lineTo(0.244737, 0.086842).lineTo(0.244737, 0.371053).lineTo(0.118421, 0.371053).lineTo(0.118421, 0.086842).lineTo(0.000000, 0.086842).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.234375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.359375, -0.195312, 0.093750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.246135, 0.000000).threePointArc((0.318627, 0.072492), (0.246135, 0.144984)).lineTo(0.000000, 0.144984).threePointArc((-0.072492, 0.072492), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.117188, -0.171875, 0.234375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.055263, 0.000000).circle(0.055263)
solid2=wp_sketch2.add(loop2).extrude(-0.140625)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.117188, -0.234375, 0.234375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.117188, 0.117188), (0.234375, 0.000000)).lineTo(0.234375, 0.140625).lineTo(0.000000, 0.140625).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.140625)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.046875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.679688, 0.000000).lineTo(0.093010, 0.343421).threePointArc((0.024256, 0.177736), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop4).extrude(-0.125000)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
