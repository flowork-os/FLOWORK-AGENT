# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00326177" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.067105, -0.375000).lineTo(0.355263, -0.375000).lineTo(0.355263, -0.331579).lineTo(0.102632, -0.331579).lineTo(0.043421, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.128289, -0.354934).lineTo(0.406250, -0.354934).lineTo(0.406250, -0.312171).lineTo(0.153947, -0.312171).lineTo(0.042763, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.125000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.242188, 0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.251234, -0.299342).lineTo(0.507812, -0.299342).lineTo(0.507812, -0.256579).lineTo(0.256579, -0.256579).lineTo(0.042763, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.125000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
