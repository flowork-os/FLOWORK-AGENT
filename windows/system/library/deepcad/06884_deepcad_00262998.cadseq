# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00262998" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, 0.554688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.232154, -0.686557), (0.223684, -1.250000)).lineTo(0.223684, -1.223684).threePointArc((-0.206321, -0.682097), (0.013158, -0.026316)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(-0.223684, -0.552632).circle(0.013158)
loop2=wp_sketch0.moveTo(-0.013158, -1.078947).circle(0.013158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.726562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.709448, -0.593493), (0.255839, -1.399589)).lineTo(0.255839, -1.429688).threePointArc((0.742070, -0.592160), (0.000000, 0.030099)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.526727, -1.249095).circle(0.015049)
loop5=wp_sketch1.moveTo(0.737418, -0.722368).circle(0.015049)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
