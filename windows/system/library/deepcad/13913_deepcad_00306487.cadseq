# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306487" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.335938, 0.000000).lineTo(1.335938, 0.590625).threePointArc((1.167188, 0.759375), (0.998437, 0.590625)).lineTo(0.998437, 0.337500).threePointArc((0.961368, 0.248007), (0.871875, 0.210938)).lineTo(0.464062, 0.210938).threePointArc((0.374569, 0.248007), (0.337500, 0.337500)).lineTo(0.337500, 0.590625).threePointArc((0.168750, 0.759375), (0.000000, 0.590625)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.168750, 0.590625).circle(0.084375)
loop2=wp_sketch0.moveTo(1.167188, 0.590625).circle(0.084375)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.210938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.092110, -0.038153), (0.130263, -0.130263)).lineTo(0.130263, -0.201316).threePointArc((0.179838, -0.332841), (0.307895, -0.390789)).lineTo(0.817105, -0.390789).threePointArc((0.945162, -0.332841), (0.994737, -0.201316)).lineTo(0.994737, -0.130263).threePointArc((1.032890, -0.038153), (1.125000, 0.000000)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.817105, -0.284211).threePointArc((0.900000, -0.201316), (0.817105, -0.118421)).lineTo(0.307895, -0.118421).threePointArc((0.225000, -0.201316), (0.307895, -0.284211)).close()
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.210938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
