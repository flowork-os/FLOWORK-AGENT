wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.351562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.023123, -0.055824), (0.078947, -0.078947)).lineTo(1.421053, -0.078947).threePointArc((1.476877, -0.055824), (1.500000, 0.000000)).lineTo(1.500000, 0.710526).threePointArc((1.476877, 0.766351), (1.421053, 0.789474)).lineTo(0.047368, 0.789474).threePointArc((0.013874, 0.775600), (0.000000, 0.742105)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.189474, 0.678947).circle(0.078947)
loop2=wp_sketch0.moveTo(1.310526, 0.031579).circle(0.078947)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.210938)
solid=solid0

