# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387284" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, 0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.015625, -0.000164).threePointArc((0.007816, 0.000206), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, 0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.120243, -0.137920), (0.013158, -0.263158)).lineTo(1.131579, -0.250000).threePointArc((1.248556, -0.131579), (1.131579, -0.013158)).lineTo(0.013158, 0.000000).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.013158, -0.131579).circle(0.078947)
loop3=wp_sketch1.moveTo(1.131579, -0.131579).circle(0.078947)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.156250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
