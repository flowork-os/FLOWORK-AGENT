loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.230921, -0.295898), (0.461842, 0.000000)).lineTo(0.461842, 0.577303).lineTo(1.141776, 0.577303).lineTo(1.141776, 0.192434).lineTo(1.218750, 0.192434).lineTo(1.218750, 0.654276).lineTo(0.461842, 0.654276).lineTo(0.372039, 0.654276).lineTo(0.372039, 0.000000).threePointArc((0.237336, -0.204301), (0.102632, 0.000000)).lineTo(0.102632, 0.115461).threePointArc((0.032717, 0.091815), (0.000000, 0.025658)).lineTo(0.000000, 0.000000).close()
