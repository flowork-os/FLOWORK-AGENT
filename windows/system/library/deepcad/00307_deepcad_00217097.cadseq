import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, 0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.125000, -0.131292), (0.250000, 0.000000)).lineTo(0.218750, 0.648438).lineTo(0.218750, 0.656250).threePointArc((0.121281, 0.741601), (0.031250, 0.648438)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.125000, 0.648438).circle(0.054688)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
