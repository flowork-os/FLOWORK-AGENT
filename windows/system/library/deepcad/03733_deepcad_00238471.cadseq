import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.213158, 0.000000).circle(0.213158)
loop1=wp_sketch0.moveTo(0.213158, 0.000000).circle(0.195395)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.039062, 0.750000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.076974, -0.159868).lineTo(0.230921, -0.242763).lineTo(0.408553, -0.213158).lineTo(0.532895, -0.094737).lineTo(0.562500, 0.082895).lineTo(0.485526, 0.236842).lineTo(0.331579, 0.319737).lineTo(0.153947, 0.296053).lineTo(0.029605, 0.171711).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.284211, 0.041447).circle(0.207237)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.179688, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch2.moveTo(0.006579, -0.011924).threePointArc((0.023285, -0.003265), (0.039062, 0.006990)).lineTo(0.032484, 0.018503).threePointArc((0.016696, 0.008454), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop4).extrude(-0.726562)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.078125, -0.179688, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop5=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.016696, -0.008454), (0.032484, -0.018503)).lineTo(0.039062, -0.006990).threePointArc((0.023285, 0.003265), (0.006579, 0.011924)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(-0.726562)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.015625, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop6=wp_sketch4.moveTo(0.014391, 0.000000).threePointArc((0.013432, 0.019531), (0.014391, 0.039062)).lineTo(0.000000, 0.039062).threePointArc((-0.000960, 0.019531), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop6).extrude(-0.726562)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
