loop2=wp_sketch2.moveTo(0.075658, 0.000000).threePointArc((0.359375, 0.283717), (0.643092, 0.000000)).lineTo(0.718750, 0.000000).threePointArc((0.359375, 0.359375), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.070312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, -0.070312, -0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.355263, 0.000000).circle(0.355263)
loop4=wp_sketch3.moveTo(0.355263, 0.000000).circle(0.281250)
