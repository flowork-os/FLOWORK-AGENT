wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, -0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.threePointArc((0.357730, 0.357730), (0.715461, 0.000000)).lineTo(0.715461, 0.263158).lineTo(0.715461, 0.781250).lineTo(0.000000, 0.781250).lineTo(0.000000, 0.263158).lineTo(0.000000, 0.000000).close()
