loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.359375, -0.359375), (0.718750, 0.000000)).lineTo(0.643092, 0.000000).threePointArc((0.359375, -0.283717), (0.075658, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.070312)
