# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.012829, -0.012829).lineTo(0.307895, 0.500329).threePointArc((0.318991, 0.510209), (0.333553, 0.513158)).lineTo(0.885197, 0.513158).threePointArc((0.899759, 0.510209), (0.910855, 0.500329)).lineTo(1.205921, -0.012829).lineTo(1.218750, 0.000000).lineTo(0.923684, 0.513158).threePointArc((0.907906, 0.531185), (0.885197, 0.538816)).lineTo(0.333553, 0.538816).threePointArc((0.310844, 0.531185), (0.295066, 0.513158)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
