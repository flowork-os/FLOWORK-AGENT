# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00368073" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.007812, 0.000000).lineTo(1.007812, 0.392516).lineTo(0.848684, 0.392516).lineTo(0.848684, 0.190954).lineTo(0.159128, 0.190954).lineTo(0.159128, 0.392516).lineTo(0.000000, 0.392516).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.406250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.789474).lineTo(1.263158, 0.789474).lineTo(1.263158, 0.394737).lineTo(0.236842, 0.394737).lineTo(0.236842, 0.789474).lineTo(0.000000, 0.789474).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.164062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
