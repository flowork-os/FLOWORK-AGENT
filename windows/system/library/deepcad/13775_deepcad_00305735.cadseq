loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002023, -0.004885), (0.006908, -0.006908)).lineTo(0.102467, -0.006908).threePointArc((0.107352, -0.004885), (0.109375, 0.000000)).lineTo(0.109375, 0.024178).threePointArc((0.107352, 0.029062), (0.102467, 0.031086)).lineTo(0.031086, 0.031086).threePointArc((0.028626, 0.038174), (0.021875, 0.041447)).lineTo(0.009211, 0.041447).threePointArc((0.002459, 0.038174), (0.000000, 0.031086)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
