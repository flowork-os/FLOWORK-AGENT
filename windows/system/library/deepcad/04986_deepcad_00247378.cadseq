wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.067599, 0.000000).threePointArc((0.321094, 0.253495), (0.574589, 0.000000)).lineTo(0.642188, 0.000000).lineTo(0.642188, 0.754852).threePointArc((0.321094, 1.075946), (0.000000, 0.754852)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.217371, 0.232131), (0.529523, 0.292928)).lineTo(0.529523, 0.754852).threePointArc((0.321094, 0.958227), (0.112664, 0.754852)).lineTo(0.112664, 0.292928).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
