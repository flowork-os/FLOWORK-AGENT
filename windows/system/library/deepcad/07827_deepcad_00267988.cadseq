wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, 0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.063322, 0.000000).lineTo(0.063322, -0.037993).lineTo(0.544572, -0.037993).lineTo(0.544572, 0.000000).lineTo(0.601562, 0.000000).lineTo(0.601562, 0.177303).lineTo(0.544572, 0.177303).lineTo(0.544572, 0.360937).threePointArc((0.303947, 0.120312), (0.063322, 0.360937)).lineTo(0.063322, 0.177303).lineTo(0.000000, 0.177303).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.303947, 0.360937).circle(0.151974)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.210938)
solid=solid0

if __name__ == '__main__':
