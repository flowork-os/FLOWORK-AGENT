import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, -0.562500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.124342, -0.179605).lineTo(0.290132, -0.179605).lineTo(0.290132, -0.041447).threePointArc((0.386842, 1.168393), (0.483553, -0.041447)).lineTo(0.483553, -0.179605).lineTo(0.649342, -0.179605).lineTo(0.787500, 0.000000).threePointArc((1.080149, 0.806738), (0.386842, 1.312500)).threePointArc((-0.299557, 0.801549), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.207237, -0.110526).circle(0.041447)
loop2=wp_sketch0.moveTo(0.580263, -0.110526).circle(0.041447)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.046875)
solid=solid0

