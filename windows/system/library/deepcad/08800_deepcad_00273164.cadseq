# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00273164" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.679688, 0.000000, 0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.020968, 0.010786), (0.039062, 0.025905)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.095764, -0.234982), (0.349507, -0.236431)).lineTo(0.904605, 0.123355).lineTo(0.945724, 0.154194).threePointArc((0.948208, 0.302875), (0.801809, 0.328947)).lineTo(0.462582, 0.143914).threePointArc((0.375702, 0.131284), (0.328947, 0.205592)).lineTo(0.339227, 0.503701).threePointArc((0.242956, 0.642352), (0.113076, 0.534539)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.226151, -0.051398).circle(0.071957)
loop3=wp_sketch1.moveTo(0.226151, 0.534539).circle(0.061678)
loop4=wp_sketch1.moveTo(0.863487, 0.236431).circle(0.061678)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.078125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
