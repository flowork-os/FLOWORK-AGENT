# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00246417" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.499860, -0.418310), (0.134704, -0.269408)).lineTo(0.404112, -0.269408).threePointArc((0.325204, -0.078908), (0.134704, 0.000000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(-0.205263, -0.269408).circle(0.070559)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.164062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
