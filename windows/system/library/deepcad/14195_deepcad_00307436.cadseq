import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.134211, 0.000000).threePointArc((0.153592, -0.007052), (0.165789, -0.023684)).threePointArc((0.361992, -0.252872), (0.655263, -0.323684)).threePointArc((0.702128, -0.330003), (0.742105, -0.355263)).lineTo(0.750000, -0.347368).threePointArc((0.706810, -0.317604), (0.655263, -0.307895)).threePointArc((0.367216, -0.239753), (0.173684, -0.015789)).threePointArc((0.158737, 0.005987), (0.134211, 0.015789)).lineTo(0.000000, 0.015789).threePointArc((-0.059211, 0.075000), (0.000000, 0.134211)).lineTo(0.647368, 0.134211).lineTo(0.647368, 0.150000).lineTo(0.000000, 0.150000).threePointArc((-0.075000, 0.075000), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(-0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.164062, -0.023438, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.484375, 0.000000).lineTo(0.484375, 0.020395).lineTo(0.000000, 0.020395).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
