# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387318" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.317105, 0.000000).threePointArc((1.391189, 0.030686), (1.421875, 0.104770)).lineTo(1.421875, 0.374178).threePointArc((1.391189, 0.448261), (1.317105, 0.478947)).lineTo(0.000000, 0.478947).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.299342, 0.239474).circle(0.104770)
loop2=wp_sketch0.moveTo(0.987829, 0.239474).circle(0.059868)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.203125, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
