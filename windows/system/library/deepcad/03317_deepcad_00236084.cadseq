# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, -0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.525000, 0.000000).lineTo(0.525000, -0.393750).lineTo(0.740625, -0.393750).lineTo(0.740625, -0.346875).lineTo(0.890625, -0.346875).lineTo(0.890625, 0.590625).lineTo(0.187500, 0.581250).lineTo(0.187500, 0.121875).lineTo(0.159375, 0.121875).lineTo(0.159375, 0.300000).lineTo(0.000000, 0.300000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, -0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.524013, 0.000000).lineTo(0.524013, -0.397862).lineTo(0.776316, -0.397862).lineTo(0.776316, -0.339638).lineTo(0.921875, -0.339638).lineTo(0.921875, 0.621053).lineTo(0.184375, 0.611349).lineTo(0.184375, 0.329934).lineTo(0.000000, 0.329934).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.543421, 0.009704).lineTo(0.543421, -0.378454).lineTo(0.756908, -0.378454).lineTo(0.756908, -0.329934).lineTo(0.912171, -0.329934).lineTo(0.912171, 0.601645).lineTo(0.203783, 0.601645).lineTo(0.203783, 0.135855).lineTo(0.174671, 0.135855).lineTo(0.174671, 0.310526).lineTo(0.009704, 0.310526).lineTo(0.009704, 0.009704).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.437500)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
