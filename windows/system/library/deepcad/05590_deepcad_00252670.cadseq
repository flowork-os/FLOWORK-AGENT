# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00252670" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.071053, -0.276316), (0.205263, -0.347368)).lineTo(0.284211, -0.300000).threePointArc((0.292105, -0.260526), (0.252632, -0.252632)).lineTo(0.173684, -0.300000).close()
loop2=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.426316)
loop3=wp_sketch0.moveTo(0.173684, -0.300000).threePointArc((0.907895, -0.181579), (0.789474, 0.552632)).lineTo(0.789474, 0.647368).threePointArc((0.750000, 0.686842), (0.710526, 0.647368)).lineTo(0.710526, 0.552632).close()
loop4=wp_sketch0.moveTo(1.121053, -0.521053).threePointArc((1.160526, -0.528947), (1.168421, -0.489474)).lineTo(1.121053, -0.410526).threePointArc((1.073684, -0.410526), (1.073684, -0.457895)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
