# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00358764" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.351562, 0.000000).lineTo(0.329359, 0.085115).lineTo(0.103618, 0.085115).threePointArc((0.091719, 0.089206), (0.085115, 0.099918)).threePointArc((-0.063072, 0.139939), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.085115).circle(0.048109)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.453125, 0.000000, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.296875, 0.000000).lineTo(0.296875, 0.056250).threePointArc((0.287722, 0.078347), (0.265625, 0.087500)).lineTo(0.146875, 0.087500).lineTo(0.000000, 0.087500).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.117188, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
