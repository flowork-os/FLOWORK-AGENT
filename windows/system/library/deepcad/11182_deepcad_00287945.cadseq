loop3=wp_sketch2.moveTo(0.042516, -0.061842).threePointArc((0.021949, -0.059334), (0.023191, -0.038651)).threePointArc((0.175863, -0.115500), (0.328536, -0.038651)).threePointArc((0.321957, -0.008421), (0.351727, 0.000000)).threePointArc((0.341546, 0.172258), (0.197122, 0.266694)).threePointArc((0.175863, 0.246702), (0.154605, 0.266694)).threePointArc((0.010181, 0.172258), (0.000000, 0.000000)).close()
loop4=wp_sketch2.moveTo(0.173931, 0.077303).circle(0.154605)
