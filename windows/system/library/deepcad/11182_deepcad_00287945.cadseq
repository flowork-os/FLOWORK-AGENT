# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.232895, 0.000000).circle(0.232895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.056693, 0.147122), (0.208635, 0.189227)).threePointArc((0.230469, 0.212443), (0.252303, 0.189227)).threePointArc((0.397097, 0.094874), (0.407566, -0.077632)).threePointArc((0.416073, -0.109937), (0.383306, -0.116447)).threePointArc((0.230469, -0.193379), (0.077632, -0.116447)).threePointArc((0.044865, -0.109937), (0.053372, -0.077632)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.153947, 0.000000).circle(0.150740)
