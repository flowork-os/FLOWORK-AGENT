import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, 0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.036264, -0.015545), (0.051809, -0.051809)).lineTo(0.051809, -0.984375).lineTo(0.217599, -0.984375).lineTo(0.217599, 0.207237).threePointArc((-0.132924, 0.357428), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.010362, 0.207237).circle(0.082895)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.445312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
