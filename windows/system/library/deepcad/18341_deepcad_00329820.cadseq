# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00329820" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.024836, 0.000000).lineTo(0.024836, 0.720230).lineTo(0.596053, 0.720230).lineTo(1.154852, 0.720230).lineTo(1.154852, 0.000000).lineTo(1.179688, 0.000000).lineTo(1.179688, 0.745066).lineTo(0.596053, 0.745066).lineTo(0.000000, 0.745066).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.531250, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
