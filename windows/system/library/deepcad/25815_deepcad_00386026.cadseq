# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.578125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.026316, 0.029605).threePointArc((0.037201, 0.024552), (0.046053, 0.016447)).lineTo(0.085526, 0.016447).lineTo(0.226974, 0.016447).lineTo(0.256579, 0.016447).threePointArc((0.286314, 0.011607), (0.312500, -0.003289)).threePointArc((0.158087, 0.172891), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.105263, 0.111842).circle(0.019737)
