# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00315590" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.710938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, -0.422122).threePointArc((0.038816, -0.460938), (0.077632, -0.422122)).lineTo(0.077632, 0.000000).threePointArc((0.038816, -0.038816), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.038816, 0.000000).circle(0.014556)
loop2=wp_sketch0.moveTo(0.038816, -0.422122).circle(0.014556)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
