wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.119105, -0.021581), (0.215789, -0.094408)).threePointArc((0.525987, -0.222896), (0.836184, -0.094408)).threePointArc((0.939612, -0.019979), (1.065461, 0.000000)).threePointArc((1.287993, 0.222533), (1.065461, 0.445066)).threePointArc((0.939612, 0.465045), (0.836184, 0.539474)).threePointArc((0.525987, 0.667962), (0.215789, 0.539474)).threePointArc((0.119105, 0.466646), (0.000000, 0.445066)).threePointArc((-0.222533, 0.222533), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.215789).circle(0.094408)
