# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.108553, 0.000000).lineTo(0.108553, 0.054276).lineTo(0.108553, 0.334704).lineTo(0.217105, 0.334704).lineTo(0.321135, 0.334704).lineTo(0.321135, 0.054276).lineTo(0.321135, 0.000000).lineTo(0.429688, 0.000000).lineTo(0.429688, 0.135691).lineTo(0.429688, 0.388980).lineTo(0.000000, 0.388980).lineTo(0.000000, 0.135691).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.429688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
