# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00335304" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.024568, -0.059313), (0.083882, -0.083882)).lineTo(0.580181, -0.083882).threePointArc((0.639494, -0.059313), (0.664062, 0.000000)).lineTo(0.664062, 0.335526).lineTo(0.000000, 0.335526).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, -0.039062, 0.085938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.043421, 0.000000).circle(0.042516)
solid1=wp_sketch1.add(loop1).extrude(-0.085938)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.203125, -0.039062, 0.085938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.043421, 0.000000).circle(0.042516)
solid2=wp_sketch2.add(loop2).extrude(-0.085938)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
