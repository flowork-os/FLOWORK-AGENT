loop2=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.203812, -0.334152), (0.584211, -0.426316)).lineTo(0.915789, -0.426316).threePointArc((1.094427, -0.352322), (1.168421, -0.173684)).lineTo(1.168421, 0.173684).threePointArc((1.094427, 0.352322), (0.915789, 0.426316)).lineTo(0.836842, 0.426316).lineTo(0.836842, 0.600000).lineTo(0.663158, 0.600000).lineTo(0.663158, 0.426316).lineTo(0.584211, 0.426316).threePointArc((0.405573, 0.352322), (0.331579, 0.173684)).lineTo(0.331579, -0.173684).close()
