# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00338203" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.038158, -0.193174).lineTo(0.195559, -0.193174).lineTo(0.143092, -0.095395).lineTo(0.226562, -0.095395).lineTo(0.226562, -0.031003).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.671875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.023438, 0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.093750, 0.000000).lineTo(0.093750, 0.058224).lineTo(0.000000, 0.058224).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.671875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
