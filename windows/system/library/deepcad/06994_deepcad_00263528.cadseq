loop0=wp_sketch0.moveTo(1.421875, 0.000000).lineTo(1.421875, 0.119737).lineTo(1.122533, 0.119737).lineTo(1.122533, 0.478947).lineTo(1.002796, 0.478947).lineTo(0.793257, 0.239474).lineTo(0.793257, 0.119737).lineTo(0.673520, 0.119737).lineTo(0.673520, 0.239474).lineTo(0.419079, 0.478947).lineTo(0.299342, 0.478947).lineTo(0.299342, 0.119737).lineTo(0.000000, 0.119737).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.710938)
