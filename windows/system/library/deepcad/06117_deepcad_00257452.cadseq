# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, 0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.436431, -0.316036).lineTo(0.270888, -0.842763).lineTo(0.722368, -0.526727).lineTo(1.158799, -0.842763).lineTo(0.993257, -0.316036).lineTo(1.429688, 0.000000).lineTo(0.887911, 0.000000).lineTo(0.722368, 0.526727).lineTo(0.541776, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.375000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
