# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.138915, -0.219656), (0.396875, -0.187993)).lineTo(0.950411, 0.271546).threePointArc((0.973566, 0.433057), (0.814638, 0.469984)).lineTo(0.480428, 0.281990).threePointArc((0.404981, 0.280314), (0.365543, 0.344655)).lineTo(0.365543, 0.605757).threePointArc((0.254902, 0.725059), (0.125329, 0.626645)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.240214, 0.000000).circle(0.083553)
loop2=wp_sketch0.moveTo(0.240214, 0.605757).circle(0.062664)
loop3=wp_sketch0.moveTo(0.866859, 0.365543).circle(0.062664)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.078125)
