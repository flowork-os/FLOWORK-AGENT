# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.015625, -0.359375).lineTo(0.187500, -0.671875).lineTo(0.500000, -0.859375).lineTo(0.859375, -0.890625).lineTo(1.187500, -0.750000).lineTo(1.406250, -0.468750).lineTo(1.484375, -0.125000).lineTo(1.390625, 0.218750).lineTo(1.140625, 0.484375).lineTo(0.796875, 0.593750).lineTo(0.437500, 0.531250).lineTo(0.156250, 0.328125).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
