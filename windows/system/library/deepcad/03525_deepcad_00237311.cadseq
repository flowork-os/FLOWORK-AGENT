import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, 0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.267763, -0.377303).lineTo(0.073026, -0.851974).lineTo(0.523355, -0.608553).lineTo(0.925000, -0.864145).lineTo(0.742434, -0.462500).lineTo(1.156250, -0.292105).lineTo(0.645066, -0.206908).lineTo(0.523355, 0.279934).lineTo(0.389474, -0.158224).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
