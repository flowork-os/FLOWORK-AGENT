# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00331044" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.585938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.526891, 0.000000).lineTo(0.526891, 1.164062).lineTo(0.000000, 1.164062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.183799, 0.404359).circle(0.061266)
loop2=wp_sketch0.moveTo(0.183799, 1.017023).circle(0.061266)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.109375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
