import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.063706, -0.010657), (0.117188, -0.046875)).threePointArc((0.304688, -0.127250), (0.492188, -0.046875)).threePointArc((0.545669, -0.010657), (0.609375, 0.000000)).threePointArc((0.743117, 0.128906), (0.609375, 0.257812)).threePointArc((0.545669, 0.268469), (0.492188, 0.304688)).threePointArc((0.304688, 0.385062), (0.117188, 0.304688)).threePointArc((0.063706, 0.268469), (0.000000, 0.257812)).threePointArc((-0.133742, 0.128906), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.007812, 0.125000).circle(0.054688)
loop2=wp_sketch0.moveTo(0.304688, 0.125000).circle(0.179688)
loop3=wp_sketch0.moveTo(0.617188, 0.125000).circle(0.054688)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
