# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285328" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.078125, 0.113487).threePointArc((0.959172, 0.221299), (1.078125, 0.329112)).lineTo(0.000000, 0.431250).threePointArc((0.195431, 0.215625), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.737664, 0.158882).threePointArc((0.794408, 0.215625), (0.737664, 0.272368)).lineTo(0.306414, 0.272368).threePointArc((0.249671, 0.215625), (0.306414, 0.158882)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.218750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.221053, 0.000000).circle(0.221053)
loop3=wp_sketch1.moveTo(0.221053, 0.000000).circle(0.165789)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.328125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.531250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.110526, 0.000000).circle(0.108224)
loop5=wp_sketch2.moveTo(0.110526, 0.000000).circle(0.055263)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.273438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
