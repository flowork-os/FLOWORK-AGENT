# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00243942" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.165789, 0.165789).circle(0.039474)
loop2=wp_sketch0.moveTo(0.165789, 0.584211).circle(0.039474)
loop3=wp_sketch0.moveTo(0.584211, 0.165789).circle(0.039474)
loop4=wp_sketch0.moveTo(0.584211, 0.584211).circle(0.039474)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.664062, 0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.209704, 0.000000).threePointArc((0.292969, -0.071825), (0.376234, 0.000000)).lineTo(0.585938, 0.000000).lineTo(0.585938, 0.024671).lineTo(0.376234, 0.024671).threePointArc((0.292969, 0.096496), (0.209704, 0.024671)).lineTo(0.000000, 0.024671).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.835938)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
