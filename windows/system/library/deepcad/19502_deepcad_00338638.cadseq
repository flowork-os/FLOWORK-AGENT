import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.505263, 0.000000).lineTo(1.000000, 0.000000).lineTo(1.000000, 0.084211).lineTo(0.747368, 0.084211).lineTo(0.747368, 0.684211).lineTo(0.705263, 0.684211).threePointArc((0.500000, 0.476413), (0.294737, 0.684211)).lineTo(0.252632, 0.684211).lineTo(0.252632, 0.084211).lineTo(0.000000, 0.084211).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
