wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.032372, -0.078154), (0.110526, -0.110526)).lineTo(1.389474, -0.110526).threePointArc((1.467628, -0.078154), (1.500000, 0.000000)).lineTo(1.500000, 0.805263).threePointArc((1.467628, 0.883417), (1.389474, 0.915789)).lineTo(0.110526, 0.915789).threePointArc((0.032372, 0.883417), (0.000000, 0.805263)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
