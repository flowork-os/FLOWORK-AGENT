# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00311429" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.065402, -0.113390), (0.196299, -0.113980)).lineTo(0.538240, 0.082319).threePointArc((0.603736, 0.196299), (0.538240, 0.310280)).lineTo(0.196299, 0.506579).threePointArc((0.065402, 0.505988), (0.000000, 0.392599)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.132977, 0.000000).circle(0.056990)
loop2=wp_sketch0.moveTo(0.132977, 0.392599).circle(0.056990)
loop3=wp_sketch0.moveTo(0.468586, 0.196299).circle(0.056990)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.210938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, 0.000000, 0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.209346, -0.574884), (0.324671, -0.276316)).threePointArc((0.347714, -0.198904), (0.421382, -0.165789)).lineTo(0.552632, -0.165789).lineTo(0.552632, 0.000000).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(0.000000, -0.331579).circle(0.193421)
solid1=wp_sketch1.add(loop4).add(loop5).extrude(0.328125, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
