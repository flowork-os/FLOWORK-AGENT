# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00331340" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, 0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.621094, 0.147500), (1.242188, 0.000000)).lineTo(1.242188, 0.261513).lineTo(0.000000, 0.261513).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.078454, 0.130757).circle(0.026151)
loop2=wp_sketch0.moveTo(0.627632, 0.196135).circle(0.026151)
loop3=wp_sketch0.moveTo(1.137582, 0.130757).circle(0.026151)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
