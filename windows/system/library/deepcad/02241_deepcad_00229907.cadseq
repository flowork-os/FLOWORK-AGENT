import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.055263).threePointArc((0.740751, 0.077593), (0.718421, 0.086842)).lineTo(0.576316, 0.086842).lineTo(0.576316, 0.197368).threePointArc((0.573326, 0.212481), (0.560526, 0.221053)).lineTo(0.505263, 0.221053).threePointArc((0.490552, 0.148627), (0.450000, 0.086842)).lineTo(0.086842, 0.086842).threePointArc((-0.061407, 0.148249), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.086842).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
