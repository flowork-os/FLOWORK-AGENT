import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.000000, -0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.243750, 0.000000).lineTo(0.243750, 0.179605).lineTo(0.667105, 0.179605).lineTo(0.667105, 0.000000).lineTo(0.846711, 0.000000).lineTo(0.846711, 0.243750).lineTo(1.218750, 0.243750).lineTo(1.218750, 0.731250).lineTo(0.000000, 0.731250).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.734375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
