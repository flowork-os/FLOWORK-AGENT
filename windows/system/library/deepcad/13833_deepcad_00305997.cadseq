wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001156, -0.002791), (0.003947, -0.003947)).lineTo(0.058553, -0.003947).threePointArc((0.061344, -0.002791), (0.062500, 0.000000)).lineTo(0.062500, 0.054605).threePointArc((0.061344, 0.057396), (0.058553, 0.058553)).lineTo(0.003947, 0.058553).threePointArc((0.001156, 0.057396), (0.000000, 0.054605)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.005752, -0.000070), (0.009868, 0.003947)).lineTo(0.052632, 0.003947).threePointArc((0.054027, 0.004525), (0.054605, 0.005921)).lineTo(0.054605, 0.048684).threePointArc((0.054027, 0.050080), (0.052632, 0.050658)).lineTo(0.009868, 0.050658).threePointArc((0.008473, 0.050080), (0.007895, 0.048684)).lineTo(0.007895, 0.005921).close()
