# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322290" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, -0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.156250, 0.000000).lineTo(0.156250, 0.131579).lineTo(0.000000, 0.131579).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.304688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, 0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.155921, 0.000000).lineTo(0.617188, 0.000000).lineTo(0.311842, 0.441776).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.304688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.158059, 0.000000).lineTo(0.158059, 0.484375).lineTo(0.000000, 0.484375).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.304688)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, -0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.461266, 0.000000).lineTo(0.461266, 0.617188).lineTo(0.000000, 0.617188).lineTo(0.000000, 0.129934).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.220888, 0.259868).circle(0.136431)
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.304688)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
