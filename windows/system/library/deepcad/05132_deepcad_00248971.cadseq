import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004119, -0.009944), (0.014063, -0.014063)).lineTo(0.056250, -0.014063).threePointArc((0.066194, -0.009944), (0.070312, 0.000000)).lineTo(0.070312, 0.042188).threePointArc((0.066194, 0.052131), (0.056250, 0.056250)).lineTo(0.014063, 0.056250).threePointArc((0.004119, 0.052131), (0.000000, 0.042188)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
