import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.126316, 0.000000).lineTo(0.126316, -0.110526).lineTo(1.373684, -0.110526).lineTo(1.373684, 0.000000).lineTo(1.500000, 0.000000).threePointArc((1.376801, 0.182216), (1.168421, 0.252632)).lineTo(0.331579, 0.252632).threePointArc((0.123199, 0.182216), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.343750, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
