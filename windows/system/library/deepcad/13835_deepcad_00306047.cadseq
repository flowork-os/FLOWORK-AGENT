wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, -0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002746, -0.006629), (0.009375, -0.009375)).lineTo(0.139063, -0.009375).threePointArc((0.145692, -0.006629), (0.148438, 0.000000)).lineTo(0.148438, 0.129688).threePointArc((0.145692, 0.136317), (0.139063, 0.139063)).lineTo(0.009375, 0.139063).threePointArc((0.002746, 0.136317), (0.000000, 0.129688)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013660, -0.000167), (0.023438, 0.009375)).lineTo(0.125000, 0.009375).threePointArc((0.128315, 0.010748), (0.129688, 0.014063)).lineTo(0.129688, 0.115625).threePointArc((0.128315, 0.118940), (0.125000, 0.120313)).lineTo(0.023438, 0.120313).threePointArc((0.020123, 0.118940), (0.018750, 0.115625)).lineTo(0.018750, 0.014063).close()
