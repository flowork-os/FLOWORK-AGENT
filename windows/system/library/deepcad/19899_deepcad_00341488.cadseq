import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.000000, 0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.115132, -0.131579).threePointArc((0.396627, -0.046711), (0.682566, -0.115132)).lineTo(0.781250, 0.008224).threePointArc((0.389295, 0.130504), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(-0.328125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.000000, 0.531250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.484416, -1.190086), (0.968832, 0.000000)).lineTo(0.880757, -0.125822).threePointArc((1.031726, -0.473183), (0.905921, -0.830428)).lineTo(0.616530, -0.629112).lineTo(0.515872, -0.276809).lineTo(0.515872, -0.742352).lineTo(0.717187, -0.968832).threePointArc((0.478125, -1.033413), (0.239062, -0.968832)).lineTo(0.440378, -0.767516).lineTo(0.440378, -0.276809).lineTo(0.327138, -0.616530).lineTo(0.075493, -0.805263).threePointArc((-0.048397, -0.478125), (0.075493, -0.150987)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.328125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
