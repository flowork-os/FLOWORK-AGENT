# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00353195" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.000000, -0.632812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.034107, -0.082341), (0.116447, -0.116447)).lineTo(0.844243, -0.116447).threePointArc((0.926584, -0.082341), (0.960691, 0.000000)).lineTo(0.960691, 1.382812).lineTo(0.000000, 1.382812).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.480345, 0.305674).circle(0.276562)
loop2=wp_sketch0.moveTo(0.480345, 1.077138).circle(0.160115)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.093750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
