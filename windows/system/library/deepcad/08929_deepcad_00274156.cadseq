# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00274156" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.031579)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.225000, -0.312500).lineTo(0.600000, -0.437500).lineTo(0.962500, -0.312500).lineTo(1.187500, 0.000000).lineTo(1.187500, 0.387500).lineTo(0.962500, 0.700000).lineTo(0.600000, 0.812500).lineTo(0.225000, 0.700000).lineTo(0.000000, 0.387500).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.250000, -0.287500).lineTo(0.600000, -0.400000).lineTo(0.937500, -0.287500).lineTo(1.162500, 0.012500).lineTo(1.162500, 0.375000).lineTo(0.937500, 0.675000).lineTo(0.600000, 0.787500).lineTo(0.250000, 0.675000).lineTo(0.025000, 0.375000).lineTo(0.025000, 0.012500).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.039062)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
