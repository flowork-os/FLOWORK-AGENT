wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, -0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000482, -0.001163), (0.001645, -0.001645)).lineTo(0.014145, -0.001645).threePointArc((0.015226, -0.001129), (0.015625, 0.000000)).lineTo(0.015625, 0.012500).threePointArc((0.015226, 0.013629), (0.014145, 0.014145)).lineTo(0.001645, 0.014145).threePointArc((0.000482, 0.013663), (0.000000, 0.012500)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000754, -0.000505), (0.001645, -0.000329)).lineTo(0.014145, -0.000329).threePointArc((0.014377, -0.000233), (0.014474, 0.000000)).lineTo(0.014474, 0.012500).threePointArc((0.014377, 0.012733), (0.014145, 0.012829)).lineTo(0.001645, 0.012829).threePointArc((0.001330, 0.012767), (0.001151, 0.012500)).lineTo(0.001151, 0.000000).close()
