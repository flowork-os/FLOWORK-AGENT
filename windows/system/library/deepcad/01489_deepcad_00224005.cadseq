import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.340789).threePointArc((-0.111881, 0.610894), (0.158224, 0.499013)).lineTo(0.705921, 0.499013).threePointArc((1.017580, 0.628107), (0.888487, 0.316447)).lineTo(0.888487, 0.048684).threePointArc((1.083910, -0.393724), (0.632895, -0.219079)).lineTo(0.219079, -0.219079).threePointArc((-0.154912, -0.373991), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.609375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
