import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.179688, 0.000000).threePointArc((0.052629, 0.052629), (0.000000, 0.179688)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.218750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.053280, -0.128628), (0.181908, -0.181908)).lineTo(1.182401, -0.181908).threePointArc((1.219152, -0.166685), (1.234375, -0.129934)).lineTo(1.234375, 0.038980).threePointArc((1.219152, 0.075731), (1.182401, 0.090954)).lineTo(0.974507, 0.090954).lineTo(0.974507, 0.298849).threePointArc((0.959284, 0.335600), (0.922533, 0.350822)).lineTo(0.701645, 0.350822).lineTo(0.701645, 0.558717).threePointArc((0.689113, 0.601965), (0.649671, 0.623684)).lineTo(0.181908, 0.623684).threePointArc((0.053280, 0.570405), (0.000000, 0.441776)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.181908, 0.000000).circle(0.090954)
loop3=wp_sketch1.moveTo(0.181908, 0.441776).circle(0.090954)
loop4=wp_sketch1.moveTo(0.649671, 0.532730).circle(0.038980)
loop5=wp_sketch1.moveTo(0.883553, 0.259868).circle(0.038980)
loop6=wp_sketch1.moveTo(1.169408, 0.000000).circle(0.038980)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).extrude(0.218750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
