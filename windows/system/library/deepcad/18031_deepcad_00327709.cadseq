import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.027748, -0.066989), (0.094737, -0.094737)).lineTo(1.405263, -0.094737).threePointArc((1.472252, -0.066989), (1.500000, 0.000000)).lineTo(1.500000, 0.300000).threePointArc((1.472252, 0.366989), (1.405263, 0.394737)).lineTo(0.094737, 0.394737).threePointArc((0.027748, 0.366989), (0.000000, 0.300000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.157895, 0.157895).circle(0.078947)
loop2=wp_sketch0.moveTo(0.552632, 0.157895).circle(0.094737)
loop3=wp_sketch0.moveTo(0.947368, 0.157895).circle(0.094737)
loop4=wp_sketch0.moveTo(1.357895, 0.157895).circle(0.078947)
