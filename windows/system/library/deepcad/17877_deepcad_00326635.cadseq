# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00326635" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, -0.632812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.116447, -0.116447), (0.232895, 0.000000)).lineTo(0.232895, 1.266365).threePointArc((0.116447, 1.382812), (0.000000, 1.266365)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.116447, 0.000000).circle(0.043668)
loop2=wp_sketch0.moveTo(0.116447, 1.266365).circle(0.043668)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
