# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00233468" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.257812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.059704, 0.005428).threePointArc((0.256667, 0.257812), (0.059704, 0.510197)).lineTo(0.000000, 0.515625).threePointArc((-0.257812, 0.257812), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.065132, 0.227961).threePointArc((0.000000, 0.185588), (0.065132, 0.227961)).lineTo(0.113980, 0.227961).lineTo(0.113980, 0.287664).lineTo(0.065132, 0.287664).threePointArc((0.000000, 0.330037), (-0.065132, 0.287664)).lineTo(-0.113980, 0.287664).lineTo(-0.113980, 0.227961).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.062500, 0.000000, 0.250000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(-0.110526, 0.221053).threePointArc((0.226094, -0.096346), (0.000000, -0.500000)).lineTo(0.494737, -0.436842).threePointArc((0.312805, -0.247401), (0.500000, -0.063158)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.189474, 0.000000).circle(0.185526)
loop4=wp_sketch2.moveTo(0.189474, 0.000000).circle(0.078947)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.109375)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
