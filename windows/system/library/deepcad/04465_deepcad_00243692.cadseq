import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.062500, 0.000000).lineTo(1.062500, 0.212500).lineTo(0.894737, 0.212500).lineTo(0.894737, 0.425000).lineTo(1.062500, 0.425000).lineTo(1.062500, 0.637500).lineTo(0.000000, 0.637500).lineTo(0.000000, 0.425000).lineTo(0.167763, 0.425000).lineTo(0.167763, 0.212500).lineTo(0.000000, 0.212500).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.132812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
