# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.000000, -0.742188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.468750, 0.000000).lineTo(1.468750, 1.484375).lineTo(0.000000, 1.484375).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.265625)
solid=solid0
