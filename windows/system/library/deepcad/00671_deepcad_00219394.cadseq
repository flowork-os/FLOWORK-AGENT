# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.164062, 0.000000).lineTo(0.164062, 0.113980).lineTo(0.000000, 0.113980).lineTo(0.000000, 0.000000).close()
