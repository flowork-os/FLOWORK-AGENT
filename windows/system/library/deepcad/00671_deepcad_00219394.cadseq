loop1=wp_sketch0.moveTo(0.051234, 0.000000).circle(0.029276)
loop2=wp_sketch0.moveTo(0.395230, 0.000000).circle(0.029276)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.031250)
