# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00241595" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.311842, 0.000000).circle(0.305345)
loop1=wp_sketch0.moveTo(0.311842, 0.000000).circle(0.279359)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.687500, 0.312500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.562500, 0.000000).lineTo(0.562500, 0.284211).threePointArc((0.533526, 0.348239), (0.467763, 0.373026)).lineTo(0.094737, 0.373026).threePointArc((0.028974, 0.348239), (0.000000, 0.284211)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.515132, 0.047368).lineTo(0.515132, 0.284211).threePointArc((0.500031, 0.314745), (0.467763, 0.325658)).lineTo(0.094737, 0.325658).threePointArc((0.062469, 0.314745), (0.047368, 0.284211)).lineTo(0.047368, 0.047368).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.093750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
