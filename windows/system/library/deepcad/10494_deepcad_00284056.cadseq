import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.053618, 0.000000).lineTo(0.053618, -0.308306).lineTo(1.273438, -0.308306).lineTo(1.273438, 0.482566).lineTo(0.053618, 0.482566).lineTo(0.053618, 0.174260).lineTo(0.000000, 0.174260).threePointArc((-0.087130, 0.087130), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.093832).circle(0.053618)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
