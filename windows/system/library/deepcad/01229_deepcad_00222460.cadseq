# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00222460" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.054276, 0.000000).lineTo(0.054276, 0.234375).lineTo(0.000000, 0.234375).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.185033, 0.000000).lineTo(0.185033, 0.351562).lineTo(0.000000, 0.351562).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.107319, 0.037007).lineTo(0.107319, 0.314556).lineTo(0.074013, 0.314556).lineTo(0.074013, 0.037007).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, -0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.125822, 0.000000).lineTo(0.125822, 0.351562).lineTo(0.000000, 0.351562).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.088816, 0.059211).lineTo(0.088816, 0.292352).lineTo(0.037007, 0.292352).lineTo(0.037007, 0.059211).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
