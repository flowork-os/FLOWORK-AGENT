wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.726562, -0.015625), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch3.moveTo(0.003947, 0.000000).circle(0.003947)
solid3=wp_sketch3.add(loop3).extrude(-0.023438)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, -0.726562, -0.015625), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch4.moveTo(0.003947, 0.000000).circle(0.003947)
