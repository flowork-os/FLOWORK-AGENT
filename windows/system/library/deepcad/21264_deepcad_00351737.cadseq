wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.437500, 0.726562, -0.015625), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch2.moveTo(0.003947, 0.000000).circle(0.003947)
