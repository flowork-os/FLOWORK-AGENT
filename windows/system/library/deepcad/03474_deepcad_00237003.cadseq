loop0=wp_sketch0.moveTo(1.140625, 0.000000).lineTo(1.140625, 0.336184).lineTo(0.900493, 0.576316).lineTo(0.672368, 0.576316).lineTo(0.672368, 0.396217).lineTo(0.852467, 0.396217).lineTo(0.852467, 0.168092).lineTo(0.276151, 0.168092).lineTo(0.276151, 0.396217).lineTo(0.444243, 0.396217).lineTo(0.444243, 0.576316).lineTo(0.216118, 0.576316).lineTo(0.000000, 0.336184).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.687500)
