import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.000000, -0.453125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.453947, 0.000000).lineTo(0.453947, 0.189145).lineTo(0.453947, 0.709293).lineTo(0.453947, 0.898438).lineTo(0.000000, 0.898438).lineTo(0.000000, 0.709293).lineTo(0.000000, 0.189145).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.226974, 0.453947).circle(0.094572)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.320312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
