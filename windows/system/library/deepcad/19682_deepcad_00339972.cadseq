# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00339972" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.093257, -0.497368).lineTo(0.481826, -0.839309).lineTo(0.994737, -0.839309).lineTo(1.383306, -0.497368).lineTo(1.476562, 0.000000).lineTo(1.227878, 0.450740).lineTo(0.746053, 0.621711).lineTo(0.248684, 0.450740).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.078125, 0.140625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.055757, -0.297368).lineTo(0.288076, -0.501809).lineTo(0.594737, -0.501809).lineTo(0.827056, -0.297368).lineTo(0.882812, 0.000000).lineTo(0.734128, 0.269490).lineTo(0.446053, 0.371711).lineTo(0.148684, 0.269490).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.882812)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
