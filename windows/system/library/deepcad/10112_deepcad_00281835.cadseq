# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00281835" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.929687, 0.000000).lineTo(0.929687, 0.489309).lineTo(0.000000, 0.489309).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.234868, 0.244655).circle(0.078289)
loop2=wp_sketch0.moveTo(0.694819, 0.166365).lineTo(0.694819, 0.322944).lineTo(0.538240, 0.322944).lineTo(0.538240, 0.166365).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
