import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.089319, -0.036997), (0.126316, -0.126316)).lineTo(0.252632, -0.126316).threePointArc((0.375000, -0.003947), (0.497368, -0.126316)).lineTo(0.623684, -0.126316).threePointArc((0.660681, -0.036997), (0.750000, 0.000000)).lineTo(0.750000, 0.394737).threePointArc((0.660681, 0.431734), (0.623684, 0.521053)).lineTo(0.497368, 0.521053).threePointArc((0.371004, 0.401121), (0.252632, 0.528947)).lineTo(0.126316, 0.528947).threePointArc((0.093266, 0.441264), (0.007895, 0.402632)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.189474, 0.197368).circle(0.126316)
loop2=wp_sketch0.moveTo(0.560526, 0.197368).circle(0.126316)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.250000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
