# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00275413" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, -0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.843750, 0.000000).lineTo(0.843750, 0.843750).lineTo(0.000000, 0.843750).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.088816, 0.097697).circle(0.035526)
loop2=wp_sketch0.moveTo(0.088816, 0.746053).circle(0.035526)
loop3=wp_sketch0.moveTo(0.426316, 0.426316).circle(0.248684)
loop4=wp_sketch0.moveTo(0.754934, 0.097697).circle(0.035526)
loop5=wp_sketch0.moveTo(0.754934, 0.746053).circle(0.035526)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
