# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239319" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.884211, 0.000000).lineTo(0.884211, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.094737, 1.294737).circle(0.015789)
loop2=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.584211, 0.110526), (0.473684, 0.694737)).lineTo(0.473684, 1.089474).threePointArc((0.442105, 1.121053), (0.410526, 1.089474)).lineTo(0.410526, 0.694737).close()
loop3=wp_sketch0.moveTo(0.442105, 0.157895).circle(0.015789)
loop4=wp_sketch0.moveTo(0.789474, 1.294737).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
