wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, 0.312500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.023447, -0.033636), (0.032237, -0.073684)).lineTo(0.032237, -0.313158).lineTo(0.119737, -0.313158).lineTo(0.119737, -0.073684).threePointArc((0.128527, -0.033636), (0.151974, 0.000000)).lineTo(0.151974, 0.437500).lineTo(0.073684, 0.437500).lineTo(0.000000, 0.437500).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0

