# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00329132" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.562500, 0.000000).lineTo(0.562500, 0.562500).lineTo(0.000000, 0.562500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.284211, 0.284211).circle(0.094737)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.281250, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.465789, 0.000000).threePointArc((0.746053, 0.280263), (0.465789, 0.560526)).lineTo(0.000000, 0.560526).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.189474, 0.189474).circle(0.047368)
loop4=wp_sketch1.moveTo(0.189474, 0.378947).circle(0.047368)
loop5=wp_sketch1.moveTo(0.465789, 0.189474).circle(0.047368)
loop6=wp_sketch1.moveTo(0.465789, 0.378947).circle(0.047368)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).extrude(0.093750, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
