# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00374687" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.000000, 0.695312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.059211, 0.000000).circle(0.057977)
solid0=wp_sketch0.add(loop0).extrude(0.054688, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.382812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.098684, 0.000000).circle(0.098684)
solid1=wp_sketch1.add(loop1).extrude(0.156250, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.398438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.096217, 0.085079), (0.192434, 0.000000)).lineTo(0.153947, 0.304688).threePointArc((0.096217, 0.239399), (0.038487, 0.304688)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.039062, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.048849, -0.373026).threePointArc((0.132239, -0.338485), (0.097697, -0.421875)).lineTo(0.266447, -0.421875).threePointArc((0.220263, -0.379222), (0.257566, -0.328618)).lineTo(0.195395, -0.341941).threePointArc((0.159277, -0.332600), (0.146546, -0.297533)).lineTo(0.190954, 0.000000).threePointArc((0.095477, -0.083386), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(0.039062, both=True)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
