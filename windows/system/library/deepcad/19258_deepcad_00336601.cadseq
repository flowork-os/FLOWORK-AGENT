# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00336601" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, 0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.042928, -1.359375).lineTo(0.071546, -1.359375).lineTo(0.028618, 0.000000).lineTo(0.257566, 0.114474).lineTo(0.300493, 0.057237).lineTo(0.286184, 0.057237).lineTo(0.286184, 0.042928).lineTo(0.300493, 0.028618).lineTo(0.329112, 0.042928).lineTo(0.343421, 0.028618).lineTo(0.271875, 0.143092).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, 0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.042928, -1.359375).lineTo(0.071546, -1.359375).lineTo(0.028618, 0.000000).lineTo(0.257566, 0.114474).lineTo(0.300493, 0.057237).lineTo(0.286184, 0.057237).lineTo(0.286184, 0.042928).lineTo(0.300493, 0.028618).lineTo(0.329112, 0.042928).lineTo(0.343421, 0.028618).lineTo(0.271875, 0.143092).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.007812, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
