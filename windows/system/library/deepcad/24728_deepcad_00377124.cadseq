# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00377124" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.773437, 0.000000).lineTo(0.773437, 0.488487).lineTo(0.000000, 0.488487).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.765296, 0.008141).lineTo(0.765296, 0.480345).lineTo(0.008141, 0.480345).lineTo(0.008141, 0.008141).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.757812, 0.000000).lineTo(0.757812, 0.478618).lineTo(0.000000, 0.478618).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.749836, 0.079770).lineTo(0.749836, 0.390872).lineTo(0.007977, 0.390872).lineTo(0.007977, 0.079770).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.007812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
