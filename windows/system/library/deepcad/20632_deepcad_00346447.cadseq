# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00346447" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, -0.176398).lineTo(0.153947, -0.262993).lineTo(0.304688, -0.176398).lineTo(0.304688, 0.000000).lineTo(0.150740, 0.086595).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.057730, -0.141118).lineTo(0.153947, -0.195641).lineTo(0.246957, -0.141118).lineTo(0.246957, -0.035280).lineTo(0.150740, 0.019243).lineTo(0.057730, -0.035280).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
