# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232882" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.304688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.269408, 0.000000).lineTo(0.269408, 0.104770).lineTo(0.553783, 0.104770).lineTo(0.553783, 0.000000).lineTo(1.421875, 0.000000).lineTo(1.197368, 0.269408).lineTo(0.000000, 0.269408).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.273438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
