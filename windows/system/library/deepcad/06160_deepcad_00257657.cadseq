# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257657" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.339227, -0.339227).lineTo(0.339227, -0.705592).lineTo(0.936266, -0.705592).lineTo(0.936266, -0.217105).lineTo(1.289062, -0.094984).lineTo(0.936266, 0.325658).lineTo(0.339227, 0.339227).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.265625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
