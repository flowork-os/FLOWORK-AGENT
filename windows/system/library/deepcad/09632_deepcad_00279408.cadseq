# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00279408" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.359375, 0.000000).lineTo(1.359375, 0.615296).threePointArc((1.338420, 0.665887), (1.287829, 0.686842)).lineTo(0.844243, 0.686842).lineTo(0.844243, 0.472204).lineTo(0.515132, 0.472204).lineTo(0.515132, 0.686842).lineTo(0.071546, 0.686842).threePointArc((0.020955, 0.665887), (0.000000, 0.615296)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.453125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, -0.453125, 0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.213158, 0.000000).circle(0.213158)
solid1=wp_sketch1.add(loop1).extrude(-0.109375)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
