# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00384979" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.394737, 0.000000).circle(0.386513)
loop1=wp_sketch0.moveTo(0.452303, -0.065789).lineTo(0.452303, 0.065789).lineTo(0.394737, 0.065789).lineTo(0.328947, 0.065789).lineTo(0.328947, 0.000000).lineTo(0.328947, -0.065789).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.289474, -0.057895).threePointArc((0.164898, -0.112475), (0.028947, -0.108553)).lineTo(0.231579, -0.108553).lineTo(0.231579, -0.173684).lineTo(0.361842, -0.173684).lineTo(0.361842, -0.108553).lineTo(0.564474, -0.108553).threePointArc((0.566759, -0.051026), (0.593421, 0.000000)).threePointArc((0.296711, 0.647792), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.296711, 0.253289).circle(0.224342)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.132812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
