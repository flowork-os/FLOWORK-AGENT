# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, 0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.023123, -0.129142), (0.140625, -0.187500)).lineTo(1.218750, -0.187500).lineTo(1.484375, -0.156250).lineTo(1.484375, -0.140625).lineTo(0.140625, -0.140625).threePointArc((0.061808, -0.102082), (0.046875, -0.015625)).lineTo(0.078125, 0.187500).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.492188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
