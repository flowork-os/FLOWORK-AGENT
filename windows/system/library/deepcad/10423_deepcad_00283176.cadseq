# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00283176" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.393503, 0.000000).lineTo(0.343421, 0.057237).lineTo(0.579523, 0.057237).lineTo(0.522286, 0.000000).lineTo(0.679688, 0.000000).lineTo(0.679688, 0.157401).lineTo(0.236102, 0.157401).lineTo(0.236102, 0.472204).lineTo(0.000000, 0.472204).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.398438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.851562, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.122368, 0.000000).circle(0.119819)
solid1=wp_sketch1.add(loop1).extrude(0.398438)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
