# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00376436" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.000000, -0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.671875, 0.000000).lineTo(0.671875, 0.671875).lineTo(0.000000, 0.671875).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.339474, 0.339474).circle(0.297039)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.085938, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.296053, 0.000000).circle(0.296053)
solid1=wp_sketch1.add(loop2).extrude(0.164062, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.164062, 0.164062, -0.164062), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.335938, 0.000000).lineTo(0.335938, 0.335938).lineTo(0.000000, 0.335938).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.169737, 0.169737).circle(0.127303)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.500000, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
