import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.173684, -0.173684).lineTo(1.326316, -0.173684).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.063158).lineTo(1.326316, 0.236842).lineTo(0.173684, 0.236842).lineTo(0.000000, 0.063158).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.284211, -0.047368).threePointArc((0.363158, 0.031579), (0.284211, 0.110526)).lineTo(0.173684, 0.110526).threePointArc((0.094737, 0.031579), (0.173684, -0.047368)).close()
loop2=wp_sketch0.moveTo(1.326316, -0.047368).threePointArc((1.405263, 0.031579), (1.326316, 0.110526)).lineTo(1.215789, 0.110526).threePointArc((1.136842, 0.031579), (1.215789, -0.047368)).close()
