# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00343995" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.045559, 0.000000).threePointArc((1.273438, 0.227878), (1.045559, 0.455757)).lineTo(0.000000, 0.455757).threePointArc((-0.227878, 0.227878), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.227878).circle(0.053618)
loop2=wp_sketch0.moveTo(1.045559, 0.227878).circle(0.053618)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.109375, 0.132812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.217105, 0.000000).lineTo(0.217105, 0.203947).threePointArc((0.108553, 0.312500), (0.000000, 0.203947)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.108553, 0.203947).circle(0.032895)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(-0.234375, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.091776, -0.049782), (0.183553, 0.000000)).lineTo(0.183553, 0.242188).lineTo(0.000000, 0.242188).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop5).extrude(-0.203125, both=True)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
