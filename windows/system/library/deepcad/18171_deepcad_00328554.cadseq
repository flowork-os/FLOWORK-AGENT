import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.406579, 0.050822).lineTo(0.398109, -0.076234).lineTo(0.406579, -0.076234).lineTo(0.406579, -0.127056).lineTo(0.389638, -0.127056).lineTo(0.338816, -0.728454).lineTo(0.804688, -0.728454).lineTo(0.804688, -0.601398).lineTo(0.296464, 0.643750).lineTo(0.000000, 0.643750).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.187500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
