# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322026" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.859375, 0.000000).lineTo(0.859375, 0.678454).lineTo(0.000000, 0.678454).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.531250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.101562, -0.101562, 0.531250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.138158, 0.000000).circle(0.135280)
solid1=wp_sketch1.add(loop1).extrude(-0.351562)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, -0.742188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.312500, 0.000000).lineTo(0.312500, 0.236842).lineTo(0.000000, 0.236842).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.218750)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, -0.343750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.201316, 0.000000).circle(0.197122)
solid3=wp_sketch3.add(loop3).extrude(-0.218750)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.078125, 0.531250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.134211, 0.000000).circle(0.131414)
solid4=wp_sketch4.add(loop4).extrude(0.218750)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
