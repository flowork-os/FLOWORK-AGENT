# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00354052" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.236842, 0.000000).circle(0.231908)
loop1=wp_sketch0.moveTo(0.236842, 0.000000).circle(0.177632)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.179688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, 0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.151207, -0.214904), (0.010526, -0.436842)).threePointArc((0.175794, -0.419234), (0.321053, -0.500000)).threePointArc((0.210026, -0.214737), (0.326316, 0.068421)).threePointArc((0.173307, -0.014192), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.179688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.414474, 0.000000).circle(0.414474)
loop4=wp_sketch2.moveTo(0.414474, 0.000000).circle(0.354030)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.179688)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
