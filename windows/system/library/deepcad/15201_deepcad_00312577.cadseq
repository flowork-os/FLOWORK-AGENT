# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00312577" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.484375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.268421, 0.000000).circle(0.268421)
loop1=wp_sketch0.moveTo(0.268421, 0.000000).circle(0.173355)
loop2=wp_sketch0.moveTo(0.156579, -0.190132).circle(0.016776)
loop3=wp_sketch0.moveTo(0.156579, 0.190132).circle(0.016776)
loop4=wp_sketch0.moveTo(0.374671, -0.190132).circle(0.016776)
loop5=wp_sketch0.moveTo(0.374671, 0.190132).circle(0.016776)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(-0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
