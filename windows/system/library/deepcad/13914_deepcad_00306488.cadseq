# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306488" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.189474, 0.000000).lineTo(0.189474, 0.094737).lineTo(0.560526, 0.094737).lineTo(0.560526, 0.000000).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.750000).lineTo(0.560526, 0.750000).lineTo(0.560526, 0.655263).lineTo(0.189474, 0.655263).lineTo(0.189474, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.378947, 0.378947).circle(0.086842)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.750000, 0.000000, -0.296875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.150000, 0.000000).lineTo(0.150000, 0.078947).lineTo(0.600000, 0.078947).lineTo(0.600000, 0.000000).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.078947).lineTo(0.750000, 0.300000).lineTo(0.000000, 0.300000).lineTo(0.000000, 0.078947).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.148438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.289062, 0.375000, 0.148438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.086842, 0.000000).circle(0.086842)
solid2=wp_sketch2.add(loop3).extrude(-0.054688)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.226562, 0.375000, 0.148438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.150000, 0.000000).circle(0.150000)
loop5=wp_sketch3.moveTo(0.150000, 0.000000).circle(0.084375)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(-0.054688)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
