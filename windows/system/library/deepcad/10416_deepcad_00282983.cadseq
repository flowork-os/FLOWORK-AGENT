# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00282983" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, 0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.093257, -0.497368).lineTo(0.481826, -0.839309).lineTo(0.994737, -0.839309).lineTo(1.383306, -0.497368).lineTo(1.476562, 0.000000).lineTo(1.227878, 0.450740).lineTo(0.746053, 0.621711).lineTo(0.248684, 0.450740).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.664062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, -0.664062, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.402632, 0.000000).circle(0.402632)
solid1=wp_sketch1.add(loop1).extrude(-1.000000)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
