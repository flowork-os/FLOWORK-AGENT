import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.000000, -0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.037500, 0.000000).threePointArc((0.074219, -0.030134), (0.110938, 0.000000)).lineTo(0.148438, 0.000000).lineTo(0.148438, 0.015625).lineTo(0.110938, 0.015625).threePointArc((0.074219, 0.045759), (0.037500, 0.015625)).lineTo(0.000000, 0.015625).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, -0.750000, -0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.039062, 0.000000).threePointArc((0.038313, 0.007607), (0.039062, 0.015214)).lineTo(0.000000, 0.015214).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.109375)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.023438, -0.750000, -0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.039062, 0.000000).lineTo(0.039062, 0.015214).lineTo(0.000000, 0.015214).threePointArc((0.000749, 0.007607), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(-0.109375)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.082895, 0.000000).circle(0.081168)
loop4=wp_sketch3.moveTo(0.044901, -0.006908).threePointArc((0.082031, -0.037380), (0.119161, -0.006908)).lineTo(0.157155, -0.006908).lineTo(0.157155, 0.006908).lineTo(0.119161, 0.006908).threePointArc((0.082031, 0.037380), (0.044901, 0.006908)).lineTo(0.006908, 0.006908).lineTo(0.006908, -0.006908).close()
solid3=wp_sketch3.add(loop3).add(loop4).extrude(-0.109375)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
