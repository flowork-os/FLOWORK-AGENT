# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00227597" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.070312, 0.000000, 0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.085197, 0.000000).lineTo(0.085197, 0.289062).lineTo(0.000000, 0.289062).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.115461, -0.115461), (0.230921, 0.000000)).lineTo(0.230921, 0.609375).lineTo(0.153947, 0.609375).lineTo(0.153947, 0.320724).lineTo(0.070559, 0.320724).lineTo(0.070559, 0.609375).lineTo(0.000000, 0.609375).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.080181, -0.080181), (0.160362, 0.000000)).lineTo(0.160362, 0.179605).threePointArc((0.115461, 0.134704), (0.070559, 0.179605)).lineTo(0.070559, 0.000000).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.085938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
