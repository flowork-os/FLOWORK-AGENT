# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00219066" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.562500, 0.203125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.054276, -0.256381), (0.108553, 0.000000)).lineTo(0.108553, 0.065132).lineTo(0.000000, 0.065132).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.054276, -0.122122).circle(0.081414)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.164062, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.078125, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.266859, 0.000000).threePointArc((0.321135, 0.054276), (0.375411, 0.000000)).lineTo(0.429688, 0.000000).threePointArc((0.402792, 0.081414), (0.429688, 0.162829)).lineTo(0.375411, 0.162829).threePointArc((0.321135, 0.108553), (0.266859, 0.162829)).lineTo(0.000000, 0.162829).threePointArc((-0.081414, 0.081414), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.108553, 0.036184).threePointArc((0.151521, 0.079153), (0.108553, 0.122122)).lineTo(0.000000, 0.122122).threePointArc((-0.042969, 0.079153), (0.000000, 0.036184)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.054688, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
