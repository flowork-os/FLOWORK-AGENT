# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231077" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.437500, 0.000000).lineTo(0.437500, 0.437500).lineTo(0.000000, 0.437500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.396053, 0.046053).lineTo(0.396053, 0.396053).lineTo(0.046053, 0.396053).lineTo(0.046053, 0.046053).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.703125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.398438, -0.531250, 0.046875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.351562, 0.000000).lineTo(0.351562, 0.351562).lineTo(0.000000, 0.351562).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.398438, -0.531250, 0.398438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.351562, 0.000000).lineTo(0.351562, 0.351562).lineTo(0.000000, 0.351562).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.177632, 0.177632).circle(0.044408)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.046875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
