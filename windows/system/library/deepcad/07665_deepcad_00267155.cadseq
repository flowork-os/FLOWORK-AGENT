# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.908717, 0.000000).lineTo(1.328125, -0.055921).lineTo(1.328125, 0.237664).lineTo(0.685033, 0.237664).lineTo(0.685033, 0.475329).lineTo(0.559211, 0.768914).lineTo(0.559211, 0.950658).lineTo(0.237664, 0.950658).lineTo(0.237664, 0.740954).lineTo(0.000000, 0.559211).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
