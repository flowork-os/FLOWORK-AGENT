# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00305460" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, -0.437500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.762500, 0.000000).lineTo(0.762500, 1.187500).lineTo(0.000000, 1.187500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.487500, 0.050000).lineTo(0.487500, 0.825000).lineTo(0.050000, 0.825000).lineTo(0.050000, 0.050000).close()
loop2=wp_sketch0.moveTo(0.562500, 1.037500).circle(0.037500)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, -0.382812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.435197, 0.000000).lineTo(0.435197, 0.765625).lineTo(0.000000, 0.765625).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.054688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, -0.437500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.762500, 0.000000).lineTo(0.762500, 1.187500).lineTo(0.000000, 1.187500).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.487500, 0.050000).lineTo(0.487500, 0.825000).lineTo(0.050000, 0.825000).lineTo(0.050000, 0.050000).close()
loop6=wp_sketch2.moveTo(0.562500, 1.037500).circle(0.037500)
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).extrude(0.054688)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
