# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288588" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, 0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.171875, 0.000000).lineTo(0.579770, 0.419408).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.431743, 0.000000).lineTo(0.431743, 0.333059).lineTo(0.579770, 0.333059).lineTo(0.715461, 0.333059).lineTo(0.715461, 0.000000).lineTo(1.171875, 0.000000).lineTo(1.171875, 0.999178).lineTo(0.000000, 0.999178).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.283717, 0.530428).lineTo(0.419408, 0.530428).lineTo(0.419408, 0.666118).lineTo(0.419408, 0.814145).lineTo(0.283717, 0.814145).lineTo(0.135691, 0.814145).lineTo(0.135691, 0.666118).lineTo(0.135691, 0.530428).close()
loop3=wp_sketch1.moveTo(0.925164, 0.530428).lineTo(1.060855, 0.530428).lineTo(1.060855, 0.666118).lineTo(1.060855, 0.814145).lineTo(0.925164, 0.814145).lineTo(0.777138, 0.814145).lineTo(0.777138, 0.666118).lineTo(0.777138, 0.530428).close()
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.250000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
