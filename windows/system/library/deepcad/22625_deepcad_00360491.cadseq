import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.687500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.103125, -0.210938).threePointArc((0.126104, -0.238893), (0.159375, -0.253125)).lineTo(0.445312, -0.295312).lineTo(0.229687, -0.028125).threePointArc((0.208958, -0.009550), (0.182812, 0.000000)).lineTo(0.014062, 0.023438).threePointArc((0.000007, 0.015933), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
