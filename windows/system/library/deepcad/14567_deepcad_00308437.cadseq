wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.426316).lineTo(0.663158, 0.426316).lineTo(0.663158, 0.126316).threePointArc((0.646972, 0.087239), (0.607895, 0.071053)).lineTo(0.126316, 0.071053).threePointArc((0.087239, 0.087239), (0.071053, 0.126316)).lineTo(0.071053, 0.426316).lineTo(0.000000, 0.426316).lineTo(0.000000, 0.000000).close()
