import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.265625, 0.265625).lineTo(0.019572, 0.265625).threePointArc((0.005733, 0.259892), (0.000000, 0.246053)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.085938, 0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.258635, -0.258635).lineTo(0.594161, -0.258635).threePointArc((0.643589, -0.238161), (0.664062, -0.188734)).lineTo(0.664062, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.507812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.126562, 0.000000).threePointArc((0.221714, 0.037471), (0.262500, 0.131250)).lineTo(0.262500, 0.182812).lineTo(0.000000, 0.445312).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.015625)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.264474, -0.258964).lineTo(0.523438, 0.000000).lineTo(0.264474, 0.258964).lineTo(0.000000, 0.000000).close()
