# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00255265" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.015625, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.019737, -0.019737), (0.039474, 0.000000)).lineTo(0.039474, 0.734211).threePointArc((0.019737, 0.753947), (0.000000, 0.734211)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.015789, 0.000000).circle(0.007895)
loop2=wp_sketch0.moveTo(0.015789, 0.734211).circle(0.007895)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
