# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231093" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.645477, -0.384539).lineTo(1.304688, 0.000000).lineTo(1.304688, 0.741612).lineTo(0.659211, 1.126151).lineTo(0.000000, 0.755345).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.659211, 0.370806).circle(0.398273)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.648438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
