import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.105263, 0.000000).threePointArc((1.318820, 0.186513), (1.105263, 0.373026)).lineTo(0.000000, 0.373026).lineTo(0.000000, 0.359211).threePointArc((0.172697, 0.186513), (0.000000, 0.013816)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.132895, 0.179605).circle(0.096711)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.265625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.105263, 0.000000).threePointArc((1.318820, 0.186513), (1.105263, 0.373026)).lineTo(0.000000, 0.373026).lineTo(0.000000, 0.359211).threePointArc((0.172697, 0.186513), (0.000000, 0.013816)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(1.132895, 0.179605).circle(0.096711)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.406250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.177632, 0.000000).circle(0.173931)
loop5=wp_sketch2.moveTo(0.177632, 0.000000).circle(0.088816)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.406250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
