loop5=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.002187, -0.006757), (0.005263, -0.013158)).lineTo(0.125000, -0.013158).lineTo(0.125000, 0.061842).lineTo(0.000000, 0.061842).lineTo(0.000000, 0.000000).close()
