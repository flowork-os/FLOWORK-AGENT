# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00252413" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.173684, -0.552632).lineTo(0.678947, -0.821053).lineTo(1.231579, -0.647368).lineTo(1.500000, -0.126316).lineTo(1.326316, 0.410526).lineTo(0.821053, 0.678947).lineTo(0.268421, 0.505263).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.460938, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
