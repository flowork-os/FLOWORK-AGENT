# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00386883" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.531250, 0.000000).lineTo(0.531250, 0.329934).lineTo(0.000000, 0.329934).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.425000, 0.111842).threePointArc((0.478125, 0.164967), (0.425000, 0.218092)).lineTo(0.106250, 0.218092).threePointArc((0.053125, 0.164967), (0.106250, 0.111842)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.051809, 0.000000).lineTo(0.051809, 0.328125).lineTo(0.000000, 0.328125).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.051809, 0.000000).lineTo(0.051809, 0.328125).lineTo(0.000000, 0.328125).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.023438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
