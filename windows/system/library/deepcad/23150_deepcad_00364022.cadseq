# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00364022" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.615789, 0.000000).circle(0.602961)
loop1=wp_sketch0.moveTo(0.166776, 0.000000).circle(0.102632)
loop2=wp_sketch0.moveTo(0.615789, 0.000000).circle(0.218092)
loop3=wp_sketch0.moveTo(0.615789, -0.449013).circle(0.102632)
loop4=wp_sketch0.moveTo(0.615789, 0.449013).circle(0.102632)
loop5=wp_sketch0.moveTo(1.051974, 0.000000).circle(0.102632)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, 0.195312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.288158, 0.000000).circle(0.282155)
loop7=wp_sketch1.moveTo(0.288158, 0.000000).circle(0.222122)
solid1=wp_sketch1.add(loop6).add(loop7).extrude(0.554688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop8=wp_sketch2.moveTo(0.288158, 0.000000).circle(0.282155)
loop9=wp_sketch2.moveTo(0.288158, 0.000000).circle(0.222122)
solid2=wp_sketch2.add(loop8).add(loop9).extrude(0.085938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
