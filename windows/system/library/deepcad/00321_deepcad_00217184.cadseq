# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00217184" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.022658, -0.064730), (0.078454, -0.104605)).lineTo(0.261513, -0.169984).lineTo(0.496875, -0.169984).lineTo(0.679934, -0.104605).threePointArc((0.693654, -0.099355), (0.706086, -0.091530)).lineTo(1.242188, -0.091530).lineTo(1.242188, 0.091530).lineTo(0.000000, 0.091530).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.117681, 0.000000).circle(0.039227)
loop2=wp_sketch0.moveTo(0.640707, 0.000000).circle(0.039227)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.043421, 0.000000).circle(0.043421)
solid1=wp_sketch1.add(loop3).extrude(0.375000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.043421, 0.000000).circle(0.043421)
solid2=wp_sketch2.add(loop4).extrude(0.375000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
