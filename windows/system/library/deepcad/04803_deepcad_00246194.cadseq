# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.009951, 0.000000).lineTo(0.009951, 0.040707).lineTo(0.055181, 0.040707).lineTo(0.055181, 0.000000).lineTo(0.065132, 0.000000).lineTo(0.065132, 0.085938).lineTo(0.055181, 0.085938).lineTo(0.055181, 0.049753).lineTo(0.009951, 0.049753).lineTo(0.009951, 0.085938).lineTo(0.000000, 0.085938).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
