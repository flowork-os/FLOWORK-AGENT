# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322354" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.000000, -0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.620724, 0.000000).lineTo(0.620724, 0.620724).lineTo(0.304276, 1.156250).lineTo(0.000000, 0.620724).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.231250, 0.231250).circle(0.073026)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.617188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
