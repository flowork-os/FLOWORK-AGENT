# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00290196" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.055263, -0.055263), (0.110526, 0.000000)).lineTo(0.110526, 0.694737).threePointArc((0.055263, 0.750000), (0.000000, 0.694737)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.055263, 0.000000).circle(0.023684)
loop2=wp_sketch0.moveTo(0.055263, 0.694737).circle(0.023684)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.015625, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
