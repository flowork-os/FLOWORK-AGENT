# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00356826" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.607895, 0.000000).threePointArc((0.746053, 0.138158), (0.607895, 0.276316)).lineTo(0.000000, 0.276316).threePointArc((-0.138158, 0.138158), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.142105).circle(0.055263)
loop2=wp_sketch0.moveTo(0.607895, 0.142105).circle(0.055263)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.194490, 0.000000).lineTo(0.194490, 0.335938).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.218750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.194490, 0.000000).lineTo(0.000000, 0.335938).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.218750)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
