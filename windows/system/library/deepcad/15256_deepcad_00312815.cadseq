import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.510691, 0.000000).lineTo(0.510691, 0.539062).lineTo(0.000000, 0.539062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.255345, 0.272368).circle(0.249671)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.179688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
