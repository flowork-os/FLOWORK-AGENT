loop3=wp_sketch1.moveTo(0.255345, 0.272368).circle(0.249671)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, -0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.217105, 0.000000).circle(0.217105)
solid2=wp_sketch2.add(loop4).extrude(-0.062500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, -0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.248684, 0.000000).circle(0.248684)
loop6=wp_sketch3.moveTo(0.248684, 0.000000).circle(0.217599)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(-0.062500)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, -0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch4.moveTo(0.217105, 0.000000).circle(0.217105)
solid4=wp_sketch4.add(loop7).extrude(-0.117188)
