import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.012645, -0.030529), (0.043174, -0.043174)).lineTo(0.656250, -0.043174).lineTo(0.820313, -0.043174).lineTo(0.820313, 0.060444).lineTo(0.656250, 0.060444).lineTo(0.043174, 0.060444).threePointArc((0.012645, 0.047799), (0.000000, 0.017270)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.043174, 0.008635).circle(0.008635)
loop2=wp_sketch0.moveTo(0.587171, 0.008635).circle(0.008635)
loop3=wp_sketch0.moveTo(0.673520, 0.008635).circle(0.008635)
loop4=wp_sketch0.moveTo(0.751234, 0.008635).circle(0.025905)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.046875)
solid=solid0

