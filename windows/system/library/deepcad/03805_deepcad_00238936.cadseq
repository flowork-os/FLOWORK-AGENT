# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00238936" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.398438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.303454, 0.000000).threePointArc((0.337472, 0.014091), (0.351562, 0.048109)).lineTo(0.351562, 0.281250).lineTo(0.000000, 0.140625).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.103618, 0.092516).circle(0.070312)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.486431, 0.000000).threePointArc((0.501550, 0.006263), (0.507812, 0.021382)).lineTo(0.507812, 0.138980).threePointArc((0.487459, 0.188117), (0.438322, 0.208470)).lineTo(0.368832, 0.208470).threePointArc((0.353713, 0.202208), (0.347451, 0.187089)).lineTo(0.347451, 0.138980).lineTo(0.208470, 0.138980).threePointArc((0.193351, 0.145243), (0.187089, 0.160362)).lineTo(0.187089, 0.208470).threePointArc((0.166736, 0.257607), (0.117599, 0.277961)).lineTo(0.021382, 0.277961).threePointArc((0.006263, 0.271698), (0.000000, 0.256579)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.117188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
