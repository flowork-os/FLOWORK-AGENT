import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.011513, 0.000000).threePointArc((0.019326, 0.007812), (0.027138, 0.000000)).lineTo(0.039062, 0.000000).lineTo(0.039062, 0.011513).threePointArc((0.031250, 0.019326), (0.039062, 0.027138)).lineTo(0.039062, 0.039062).lineTo(0.027138, 0.039062).threePointArc((0.019326, 0.031250), (0.011513, 0.039062)).lineTo(0.000000, 0.039062).lineTo(0.000000, 0.027138).threePointArc((0.007812, 0.019326), (0.000000, 0.011513)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
