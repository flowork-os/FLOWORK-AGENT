import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, -0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.252385, -0.317516).threePointArc((0.337870, -0.357948), (0.423355, -0.317516)).lineTo(0.675740, 0.000000).threePointArc((0.337870, 0.714366), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.212829, 0.006210), (0.268668, 0.211678)).threePointArc((0.210487, 0.354237), (0.056990, 0.366365)).close()
loop2=wp_sketch0.moveTo(0.056990, 0.366365).threePointArc((0.337870, 0.158050), (0.618750, 0.366365)).threePointArc((0.465253, 0.354237), (0.407072, 0.211678)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.210938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
