# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00352138" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.101562, 0.000000, 0.625000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.648438, -0.505099).lineTo(0.648438, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.593750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.240543, 0.000000).lineTo(0.240543, 0.320724).lineTo(0.000000, 0.507812).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.593750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.406250, 0.000000).lineTo(0.000000, 0.316447).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.593750)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, 0.507812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.237664, -0.181743).lineTo(0.643092, -0.503289).lineTo(1.328125, -0.503289).lineTo(1.328125, -0.377467).lineTo(0.685033, 0.125822).lineTo(0.000000, 0.125822).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.489309, -0.055921).circle(0.069901)
loop5=wp_sketch3.moveTo(0.838816, -0.377467).circle(0.069901)
solid3=wp_sketch3.add(loop3).add(loop4).add(loop5).extrude(0.593750)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
