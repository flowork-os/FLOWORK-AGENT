# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00325364" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.476562, -0.750000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.156908, 0.000000).lineTo(0.156908, 0.156908).lineTo(0.745313, 0.156908).lineTo(0.745313, 0.000000).lineTo(0.915296, 0.000000).lineTo(0.915296, 0.156908).lineTo(0.915296, 1.242188).lineTo(0.000000, 1.242188).lineTo(0.000000, 0.156908).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.405345, 0.353043).circle(0.013076)
loop2=wp_sketch0.moveTo(0.405345, 1.137582).circle(0.013076)
loop3=wp_sketch0.moveTo(0.549178, 0.353043).circle(0.013076)
loop4=wp_sketch0.moveTo(0.549178, 1.137582).circle(0.013076)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.031250, -0.476562, -0.750000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.164062, 0.000000).lineTo(0.164062, 0.036266).lineTo(0.000000, 0.036266).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.210938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.273438, -0.750000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch2.moveTo(0.164062, 0.000000).lineTo(0.164062, 0.036266).lineTo(0.000000, 0.036266).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(0.210938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
