# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00333471" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.284211).lineTo(0.000000, 0.284211).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.500000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.252632).lineTo(0.000000, 0.252632).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.252632, 0.126316).circle(0.047368)
loop3=wp_sketch1.moveTo(0.505263, 0.126316).circle(0.047368)
loop4=wp_sketch1.moveTo(0.757895, 0.126316).circle(0.047368)
loop5=wp_sketch1.moveTo(0.994737, 0.126316).circle(0.063158)
loop6=wp_sketch1.moveTo(1.247368, 0.126316).circle(0.078947)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).extrude(-0.500000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch2.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.284211).lineTo(0.000000, 0.284211).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop7).extrude(-0.500000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch3.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.252632).lineTo(0.000000, 0.252632).lineTo(0.000000, 0.000000).close()
loop9=wp_sketch3.moveTo(0.252632, 0.126316).circle(0.047368)
loop10=wp_sketch3.moveTo(0.505263, 0.126316).circle(0.047368)
loop11=wp_sketch3.moveTo(0.757895, 0.126316).circle(0.047368)
loop12=wp_sketch3.moveTo(0.994737, 0.126316).circle(0.063158)
loop13=wp_sketch3.moveTo(1.247368, 0.126316).circle(0.078947)
solid3=wp_sketch3.add(loop8).add(loop9).add(loop10).add(loop11).add(loop12).add(loop13).extrude(-0.015625)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
