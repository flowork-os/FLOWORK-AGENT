# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00242360" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.015789, 0.000000).lineTo(0.015789, 0.015789).lineTo(0.031579, 0.015789).lineTo(0.031579, 0.000000).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.031579).lineTo(0.000000, 0.031579).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.023520, 0.000000).lineTo(0.023520, 0.017105).lineTo(0.014967, 0.008553).lineTo(0.014967, 0.038487).lineTo(0.023520, 0.029934).lineTo(0.023520, 0.071628).lineTo(0.014967, 0.063076).lineTo(0.014967, 0.093010).lineTo(0.023520, 0.084457).lineTo(0.023520, 0.101562).lineTo(0.000000, 0.101562).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
