import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.063158, 0.000000).lineTo(0.063158, 0.126316).lineTo(0.647368, 0.126316).lineTo(0.647368, 0.157895).lineTo(0.852632, 0.157895).lineTo(0.852632, 0.126316).lineTo(1.436842, 0.126316).lineTo(1.436842, 0.000000).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.205263).lineTo(0.000000, 0.205263).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.617188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
