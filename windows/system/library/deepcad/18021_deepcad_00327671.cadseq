# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00327671" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, 0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.010691, -1.015625).threePointArc((0.224507, -0.791118), (0.449013, -1.004934)).lineTo(0.438322, 0.010691).threePointArc((0.224507, -0.213816), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.213816, 0.000000).circle(0.096217)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.000000, -0.515625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.217105, 0.000000).circle(0.217105)
loop3=wp_sketch1.moveTo(0.217105, 0.000000).circle(0.104030)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.750000, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, 0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.010691, -1.015625).threePointArc((0.224507, -0.791118), (0.449013, -1.004934)).lineTo(0.438322, 0.010691).threePointArc((0.224507, -0.213816), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.213816, 0.000000).circle(0.096217)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.476562, both=True)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
