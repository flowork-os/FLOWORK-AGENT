# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00234893" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.252632, 0.000000).lineTo(0.500000, 0.000000).lineTo(0.500000, 0.252632).lineTo(0.500000, 0.500000).lineTo(0.252632, 0.500000).lineTo(0.000000, 0.500000).lineTo(0.000000, 0.252632).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.157895, 0.084211).lineTo(0.347368, 0.084211).lineTo(0.442105, 0.252632).lineTo(0.342105, 0.415789).lineTo(0.152632, 0.415789).lineTo(0.063158, 0.252632).lineTo(0.057895, 0.247368).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.500000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.096711, -0.165214).lineTo(0.290132, -0.161184).lineTo(0.382813, 0.004030).lineTo(0.286102, 0.169243).lineTo(0.092681, 0.165214).lineTo(0.000000, 0.004030).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.500000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.252632, 0.000000).lineTo(0.500000, 0.000000).lineTo(0.500000, 0.252632).lineTo(0.500000, 0.500000).lineTo(0.252632, 0.500000).lineTo(0.000000, 0.500000).lineTo(0.000000, 0.252632).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.157895, 0.084211).lineTo(0.347368, 0.084211).lineTo(0.442105, 0.252632).lineTo(0.342105, 0.415789).lineTo(0.152632, 0.415789).lineTo(0.063158, 0.252632).lineTo(0.057895, 0.247368).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
