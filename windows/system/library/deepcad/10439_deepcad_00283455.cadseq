# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.226891, -0.283492), (0.453783, 0.000000)).lineTo(0.307401, 0.629441).threePointArc((0.226891, 0.693876), (0.146382, 0.629441)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.211340, -0.273434), (0.431826, -0.007319)).lineTo(0.292763, 0.629441).threePointArc((0.226891, 0.682161), (0.161020, 0.629441)).lineTo(0.014638, -0.007319).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.093750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
