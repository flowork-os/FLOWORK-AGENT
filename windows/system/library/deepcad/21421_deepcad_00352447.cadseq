# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00352447" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.054688, -0.734375, -0.007812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.006250, 0.000000).lineTo(0.007812, 0.148438).lineTo(0.001563, 0.148438).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, -0.578125, -0.007812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.001809, -0.153783).lineTo(0.007237, -0.151974).lineTo(0.009046, -0.171875).lineTo(0.066941, -0.171875).lineTo(0.126645, -0.171875).lineTo(0.126645, -0.151974).lineTo(0.128454, 0.000000).lineTo(0.128454, 0.019901).lineTo(0.066941, 0.019901).lineTo(0.005428, 0.019901).lineTo(0.005428, 0.000000).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.106743, -0.151974).lineTo(0.106743, -0.074178).lineTo(0.027138, -0.074178).lineTo(0.027138, -0.151974).close()
loop3=wp_sketch1.moveTo(0.106743, -0.045230).lineTo(0.106743, -0.005428).lineTo(0.028947, -0.005428).lineTo(0.028947, -0.045230).close()
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.007812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
