import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.055263).lineTo(0.473684, 0.055263).lineTo(0.363158, 0.126316).threePointArc((0.368294, 0.134211), (0.363158, 0.142105)).lineTo(0.268421, 0.197368).lineTo(0.260526, 0.189474).threePointArc((0.256579, 0.191109), (0.252632, 0.189474)).lineTo(0.157895, 0.244737).threePointArc((0.159530, 0.248684), (0.157895, 0.252632)).lineTo(0.181579, 0.292105).lineTo(0.173684, 0.300000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.086842, 0.055263).lineTo(0.157895, 0.007895).lineTo(0.544737, 0.007895).lineTo(0.181579, 0.221053).threePointArc((0.158572, 0.221333), (0.142105, 0.205263)).lineTo(0.063158, 0.063158).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.296875, -0.031250, 0.179688), cq.Vector(0.870087, 0.000000, -0.492898), cq.Vector(0.492898, 0.000000, 0.870087)))
loop2=wp_sketch1.moveTo(0.005921, 0.005921).threePointArc((-0.028916, -0.023629), (0.001480, -0.057730)).lineTo(0.039967, -0.057730).threePointArc((0.070290, -0.029624), (0.041447, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.023438)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
