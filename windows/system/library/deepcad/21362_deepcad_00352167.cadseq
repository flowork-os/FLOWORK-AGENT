# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00352167" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.757895).lineTo(0.000000, 0.757895).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.378947, 0.000000).circle(0.371053)
solid1=wp_sketch1.add(loop1).extrude(0.500000, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.189474, 0.000000).circle(0.185526)
solid2=wp_sketch2.add(loop2).extrude(-0.500000, both=True)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, 0.500000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.189474, 0.000000).circle(0.185526)
solid3=wp_sketch3.add(loop3).extrude(-0.250000)
solid_temp=solid3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, 0.500000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.189474, 0.000000).circle(0.185526)
solid3=wp_sketch3.add(loop3).extrude(-0.125000)
solid_temp=solid_temp.union(solid3)
solid=solid.cut(solid_temp)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, 0.500000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.252632, 0.000000).circle(0.252632)
loop5=wp_sketch4.moveTo(0.252632, 0.000000).circle(0.189474)
solid4=wp_sketch4.add(loop4).add(loop5).extrude(-0.250000)
solid_temp=solid4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, 0.500000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.252632, 0.000000).circle(0.252632)
loop5=wp_sketch4.moveTo(0.252632, 0.000000).circle(0.189474)
solid4=wp_sketch4.add(loop4).add(loop5).extrude(-0.125000)
solid_temp=solid_temp.union(solid4)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
