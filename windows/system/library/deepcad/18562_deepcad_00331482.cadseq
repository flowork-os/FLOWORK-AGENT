# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00331482" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.156250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.176480, 0.000000).lineTo(0.176480, 0.166941).lineTo(0.453125, 0.166941).lineTo(0.453125, 0.295724).lineTo(0.000000, 0.295724).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.179688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.171875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.631579).lineTo(0.450000, 0.631579).lineTo(0.450000, 0.497368).lineTo(0.450000, 0.489474).threePointArc((0.561648, 0.219931), (0.292105, 0.331579)).lineTo(0.173684, 0.331579).lineTo(0.000000, 0.331579).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.179688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
