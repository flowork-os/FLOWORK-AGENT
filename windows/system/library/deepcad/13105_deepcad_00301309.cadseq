loop0=wp_sketch0.moveTo(0.387747, 0.000000).threePointArc((0.416118, 0.028372), (0.387747, 0.056743)).lineTo(0.104030, 0.094572).threePointArc((0.064913, 0.112199), (0.047286, 0.151316)).lineTo(0.047286, 0.453947).lineTo(0.047286, 0.747122).threePointArc((0.064913, 0.786238), (0.104030, 0.803865)).lineTo(0.387747, 0.841694).threePointArc((0.416118, 0.870066), (0.387747, 0.898438)).lineTo(0.000000, 0.898438).lineTo(0.000000, 0.453947).lineTo(0.000000, 0.000000).close()
