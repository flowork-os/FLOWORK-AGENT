# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00293341" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, -0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.140625, 0.000000).lineTo(1.140625, 0.192105).lineTo(0.696382, 0.528289).lineTo(0.444243, 0.528289).lineTo(0.000000, 0.192105).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.054688, 0.000000, 0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.113158).lineTo(0.000000, 0.113158).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.437500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.101562, -0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.071053, 0.000000).circle(0.069572)
solid2=wp_sketch2.add(loop2).extrude(0.476562)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, -0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.515625, 0.000000).lineTo(0.515625, 0.065132).lineTo(0.385362, 0.189967).lineTo(0.113980, 0.189967).lineTo(0.000000, 0.065132).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.437500)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
