# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382274" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.205263, 0.221053).threePointArc((0.121087, 0.360800), (0.284211, 0.363158)).lineTo(0.678947, 0.584211).threePointArc((0.750000, 0.707861), (0.821053, 0.584211)).lineTo(1.215789, 0.363158).threePointArc((1.378913, 0.360800), (1.294737, 0.221053)).lineTo(1.294737, -0.221053).threePointArc((1.378913, -0.360800), (1.215789, -0.363158)).lineTo(0.821053, -0.584211).threePointArc((0.750000, -0.707861), (0.678947, -0.584211)).lineTo(0.284211, -0.363158).threePointArc((0.121087, -0.360800), (0.205263, -0.221053)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.148602, -0.160033).threePointArc((0.104456, -0.162592), (0.080016, -0.125740)).lineTo(0.468668, -0.354359).threePointArc((0.542969, -0.311663), (0.617270, -0.354359)).lineTo(1.005921, -0.125740).threePointArc((1.009802, -0.039880), (1.085938, 0.000000)).lineTo(1.085938, 0.457237).threePointArc((1.009802, 0.497117), (1.005921, 0.582977)).lineTo(0.617270, 0.811595).threePointArc((0.542969, 0.768900), (0.468668, 0.811595)).lineTo(0.080016, 0.582977).threePointArc((0.076135, 0.497117), (0.000000, 0.457237)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.548684, 0.228618).circle(0.228618)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.171875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
