loop0=wp_sketch0.moveTo(0.500000, 0.000000).lineTo(0.452632, 0.273684).lineTo(0.410526, 0.263158).lineTo(0.447368, 0.068421).lineTo(0.226316, 0.031579).lineTo(0.173684, 0.326316).lineTo(0.136842, 0.321053).lineTo(0.152632, 0.215789).threePointArc((0.145052, 0.133711), (0.094737, 0.068421)).lineTo(0.000000, 0.000000).close()
