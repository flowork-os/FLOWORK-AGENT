loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.016186, -0.039077), (0.055263, -0.055263)).lineTo(0.694737, -0.055263).threePointArc((0.733814, -0.039077), (0.750000, 0.000000)).lineTo(0.750000, 0.639474).threePointArc((0.733814, 0.678551), (0.694737, 0.694737)).lineTo(0.055263, 0.694737).threePointArc((0.016186, 0.678551), (0.000000, 0.639474)).lineTo(0.000000, 0.000000).close()
