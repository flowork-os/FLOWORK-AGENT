# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00250840" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, -0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.992188, 0.000000).lineTo(0.992188, 0.992188).lineTo(0.000000, 0.992188).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.511760, 0.501316).circle(0.313322)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.742188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(1.484211, 0.000000).lineTo(1.484211, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(1.247368, 0.252632).lineTo(1.247368, 1.247368).lineTo(0.252632, 1.247368).lineTo(0.252632, 0.252632).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.500000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
