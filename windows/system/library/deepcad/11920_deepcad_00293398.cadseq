# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00293398" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.049589).lineTo(0.038569, 0.077138).lineTo(0.038569, 0.523438).lineTo(0.110197, 0.523438).lineTo(0.297533, 0.077138).lineTo(0.297533, -0.225905).lineTo(0.198355, -0.330592).threePointArc((-0.188481, -0.337891), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.257812, 0.148438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.197780, -0.093091), (0.248684, -0.305674)).lineTo(0.300493, -0.253865).lineTo(0.300493, 0.046628).lineTo(0.113980, 0.492187).lineTo(0.036266, 0.492187).lineTo(0.036266, 0.046628).lineTo(0.000000, 0.020724).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.148438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
