# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00337290" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.687500, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.014556, 0.000000).lineTo(0.698684, 0.000000).lineTo(1.368257, 0.000000).lineTo(1.382812, 0.000000).threePointArc((0.691406, 0.124345), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.117188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.019243, 0.000000).lineTo(0.070312, 0.056990).lineTo(0.056990, 0.056990).lineTo(0.038487, 0.056990).lineTo(0.038487, 0.038487).lineTo(0.019243, 0.038487).lineTo(0.019243, 0.019243).lineTo(0.000000, 0.019243).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.117188, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.671875, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.018092, -0.020559).lineTo(0.058388, -0.060855).lineTo(0.078125, -0.060855).lineTo(0.078125, -0.040296).lineTo(0.058388, -0.040296).lineTo(0.058388, -0.020559).lineTo(0.037829, -0.020559).lineTo(0.037829, 0.000000).lineTo(0.018092, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.117188, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
