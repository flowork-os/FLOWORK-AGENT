import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.007812, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.007895, 0.000000).circle(0.007895)
solid0=wp_sketch0.add(loop0).extrude(0.625000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.023438, -0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.024671, -0.024671), (0.049342, 0.000000)).lineTo(0.049342, 0.161842).threePointArc((0.024671, 0.186513), (0.000000, 0.161842)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.025658, -0.005921).circle(0.007895)
loop3=wp_sketch1.moveTo(0.025658, 0.169737).circle(0.007895)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(-0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.625000, -0.046875, 0.117188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.049712, -0.242145), (0.099424, 0.000000)).threePointArc((0.086558, 0.000360), (0.076480, -0.007648)).threePointArc((0.049712, -0.022168), (0.022944, -0.007648)).threePointArc((0.012867, 0.000360), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.050987, -0.114720).circle(0.010197)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.062500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.687500, -0.031250, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.027632, 0.000000).circle(0.027632)
loop7=wp_sketch3.moveTo(0.027632, 0.000000).circle(0.009211)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.062500)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
