# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00244183" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.000000, 0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.115461, 0.000000).lineTo(0.115461, -0.359211).lineTo(0.590132, -0.359211).lineTo(0.590132, -0.474671).lineTo(1.218750, -0.474671).lineTo(1.218750, -0.076974).lineTo(0.333553, 0.166776).lineTo(0.000000, 0.166776).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.013487, -0.282237).circle(0.089803)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.000000, -0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.117270, 0.000000).lineTo(0.117270, 0.117270).lineTo(0.117270, 0.484375).lineTo(0.000000, 0.484375).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.476562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
