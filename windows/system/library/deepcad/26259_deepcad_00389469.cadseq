# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00389469" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.080183, -0.093674), (0.012500, -0.175000)).lineTo(0.987500, -0.225000).threePointArc((1.183048, -0.062500), (0.987500, 0.100000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.067835, -0.081174), (0.012500, -0.150000)).lineTo(1.012500, -0.212500).threePointArc((1.169722, -0.055689), (1.000000, 0.087500)).lineTo(0.000000, -0.025000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
