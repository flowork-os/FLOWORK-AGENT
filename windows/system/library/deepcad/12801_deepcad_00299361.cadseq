import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.125658, 0.000000).lineTo(0.125658, -0.109951).lineTo(0.738240, -0.109951).lineTo(1.350822, -0.109951).lineTo(1.350822, 0.000000).lineTo(1.492188, 0.000000).threePointArc((1.471610, 0.193277), (1.350822, 0.345559)).lineTo(0.738240, 0.345559).lineTo(0.125658, 0.345559).threePointArc((0.012724, 0.191000), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.335938, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.210938, 0.445312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.115461, 0.000000).lineTo(0.115461, 0.421875).lineTo(0.000000, 0.421875).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.125000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.617188, -0.210938, 0.445312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.115461, 0.000000).lineTo(0.115461, 0.421875).lineTo(0.000000, 0.421875).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.125000)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.210938, 0.445312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(1.226562, 0.000000).lineTo(1.226562, 0.426069).lineTo(0.000000, 0.426069).lineTo(0.000000, 0.000000).close()
