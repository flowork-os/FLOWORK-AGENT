# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, -0.132812, 0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((-0.004214, -0.059112), (0.005345, -0.117599)).lineTo(0.497122, -0.117599).threePointArc((0.506681, -0.059112), (0.502467, 0.000000)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.156250)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, -0.132812, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.161842, 0.000000).circle(0.161842)
solid4=wp_sketch4.add(loop4).extrude(-0.265625)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.312500, -0.093750, 0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch5.moveTo(0.039474, 0.000000).circle(0.039474)
solid5=wp_sketch5.add(loop5).extrude(-0.156250)
solid=solid.cut(solid5)
# workplane for sketch 6
wp_sketch6 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.132812, 0.210938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch6.moveTo(0.164062, 0.000000).lineTo(0.164062, 0.112253).lineTo(0.000000, 0.112253).lineTo(0.000000, 0.000000).close()
