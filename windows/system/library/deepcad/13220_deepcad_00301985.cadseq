import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.656250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.026977, -0.065128), (0.092105, -0.092105)).lineTo(0.454770, -0.092105).threePointArc((0.519898, -0.065128), (0.546875, 0.000000)).lineTo(0.546875, 0.362664).threePointArc((0.519898, 0.427793), (0.454770, 0.454770)).lineTo(0.092105, 0.454770).threePointArc((0.026977, 0.427793), (0.000000, 0.362664)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.092105, 0.000000).circle(0.017270)
loop2=wp_sketch0.moveTo(0.092105, 0.362664).circle(0.017270)
loop3=wp_sketch0.moveTo(0.276316, 0.184211).circle(0.017270)
loop4=wp_sketch0.moveTo(0.454770, 0.000000).circle(0.017270)
loop5=wp_sketch0.moveTo(0.454770, 0.362664).circle(0.017270)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.312500, 0.351562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.023684, 0.000000).circle(0.023191)
solid1=wp_sketch1.add(loop6).extrude(0.093750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.242188, 0.351562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch2.moveTo(0.090789, 0.000000).circle(0.088898)
loop8=wp_sketch2.moveTo(0.090789, 0.000000).circle(0.020806)
solid2=wp_sketch2.add(loop7).add(loop8).extrude(-0.367188)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
