# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00255734" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.757895).lineTo(1.310526, 0.757895).threePointArc((0.750000, 0.197368), (0.189474, 0.757895)).lineTo(0.000000, 0.757895).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.189474, 0.189474).circle(0.094737)
loop2=wp_sketch0.moveTo(1.310526, 0.189474).circle(0.094737)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.468750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.468750, 0.468750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.263487, 0.000000).threePointArc((0.206779, 0.135638), (0.186513, 0.281250)).lineTo(0.000000, 0.281250).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.187500)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.468750, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.750000).lineTo(0.560526, 0.750000).threePointArc((0.396352, 0.353648), (0.000000, 0.189474)).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.560526, 0.189474).circle(0.094737)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(-0.187500)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
