# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284002" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, -0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.848684, 0.000000).threePointArc((0.913530, 0.030948), (0.937500, 0.098684)).lineTo(0.937500, 0.473684).threePointArc((0.911486, 0.536486), (0.848684, 0.562500)).lineTo(0.000000, 0.562500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.375000, 0.276316).circle(0.049342)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.027459, -0.066291), (0.093750, -0.093750)).lineTo(0.187500, -0.093750).lineTo(0.187500, 0.468750).lineTo(0.093750, 0.468750).threePointArc((0.027459, 0.441291), (0.000000, 0.375000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
