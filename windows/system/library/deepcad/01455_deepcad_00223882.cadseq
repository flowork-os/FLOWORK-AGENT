# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00223882" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, -0.562500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.186513, -0.186513), (0.373026, 0.000000)).lineTo(0.373026, 1.119079).threePointArc((0.186513, 1.305592), (0.000000, 1.119079)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.193421, 0.000000).circle(0.069079)
loop2=wp_sketch0.moveTo(0.193421, 1.119079).circle(0.069079)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, -0.312500, 0.125000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.625000).lineTo(0.000000, 0.625000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, -0.312500, 0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.250000, 0.000000).threePointArc((0.125000, 0.125000), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop4).extrude(-0.625000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, -0.312500, 0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.063158, 0.000000).circle(0.063158)
solid3=wp_sketch3.add(loop5).extrude(-0.625000)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.125000, -0.156250, 0.375000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.312500, 0.000000).lineTo(0.312500, 0.312500).lineTo(0.000000, 0.312500).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(-0.375000)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.125000, -0.156250, 0.375000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop7=wp_sketch5.moveTo(0.000000, 0.000000).threePointArc((0.156250, -0.156250), (0.312500, 0.000000)).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop7).extrude(-0.375000)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
