wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, 0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.060526, -0.030263).lineTo(0.098355, 0.030263).threePointArc((0.135661, 0.117401), (0.143750, 0.211842)).lineTo(0.136184, 0.355592).lineTo(0.174013, 0.355592).lineTo(0.174013, 0.718750).lineTo(0.060526, 0.718750).lineTo(0.060526, 0.340461).lineTo(0.068092, 0.211842).threePointArc((0.062568, 0.125575), (0.030263, 0.045395)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.289062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.382812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.056414, 0.000000).lineTo(0.048355, -0.141036).threePointArc((0.053344, -0.235071), (0.088651, -0.322368)).lineTo(0.112829, -0.382813).lineTo(0.173273, -0.350576).lineTo(0.145066, -0.306250).threePointArc((0.111302, -0.224870), (0.104770, -0.137007)).lineTo(0.112829, -0.008059).lineTo(0.112829, 0.362664).lineTo(0.000000, 0.362664).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.289062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
