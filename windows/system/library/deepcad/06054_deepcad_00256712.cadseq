# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00256712" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.437500, 0.000000).threePointArc((1.407237, 0.030263), (1.437500, 0.060526)).lineTo(0.000000, 0.060526).threePointArc((0.030263, 0.030263), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.718750, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.062500).threePointArc((-0.031250, 0.031250), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.171875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.718750, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.031250, 0.031250), (0.000000, 0.062500)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.171875)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.031250, 0.031250), (0.000000, 0.062500)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.171875)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.000000, 0.062500).threePointArc((-0.031250, 0.031250), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop4).extrude(0.171875)
solid=solid.union(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.000000, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch5.moveTo(0.109375, 0.000000).lineTo(0.109375, 0.109375).lineTo(0.000000, 0.109375).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop5).extrude(-0.328125, both=True)
solid=solid.cut(solid5)
# workplane for sketch 6
wp_sketch6 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch6.moveTo(0.109375, 0.000000).lineTo(0.109375, 0.109375).lineTo(0.000000, 0.109375).lineTo(0.000000, 0.000000).close()
solid6=wp_sketch6.add(loop6).extrude(-0.328125, both=True)
solid=solid.cut(solid6)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
