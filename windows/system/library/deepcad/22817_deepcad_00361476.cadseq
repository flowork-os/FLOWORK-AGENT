# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00361476" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.102632, 0.000000).circle(0.100493)
loop1=wp_sketch0.moveTo(0.141118, -0.040625).lineTo(0.141118, 0.040625).lineTo(0.062007, 0.040625).lineTo(0.062007, -0.040625).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.179688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, -0.671875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.186020, -0.121875).threePointArc((0.234128, -0.048109), (0.160362, 0.000000)).lineTo(0.160362, 0.609375).threePointArc((0.080181, 0.570241), (0.000000, 0.609375)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.132812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.078125, 0.000000).lineTo(0.078125, 0.078125).lineTo(0.000000, 0.078125).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.039474, 0.039474).circle(0.019737)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.015625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
