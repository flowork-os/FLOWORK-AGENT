import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.003758, -0.009071), (0.012829, -0.012829)).lineTo(0.088734, -0.012829).threePointArc((0.097805, -0.009071), (0.101562, 0.000000)).lineTo(0.101562, 0.075905).threePointArc((0.097805, 0.084976), (0.088734, 0.088734)).lineTo(0.012829, 0.088734).threePointArc((0.003758, 0.084976), (0.000000, 0.075905)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.091941, -0.002138).lineTo(0.091941, 0.079112).lineTo(0.010691, 0.079112).lineTo(0.010691, -0.002138).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
