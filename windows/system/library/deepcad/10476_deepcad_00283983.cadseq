# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00283983" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.007130, -0.017212), (0.024342, -0.024342)).lineTo(0.505099, -0.024342).lineTo(0.505099, 0.578125).lineTo(0.024342, 0.578125).threePointArc((0.007130, 0.570995), (0.000000, 0.553783)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.243421, 0.279934).circle(0.024342)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.304688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.007804, -0.018841), (0.026645, -0.026645)).lineTo(0.532895, -0.026645).lineTo(0.532895, 0.000000).lineTo(0.046628, 0.000000).threePointArc((0.031118, 0.009184), (0.026645, 0.026645)).lineTo(0.026645, 0.586184).threePointArc((0.032498, 0.600315), (0.046628, 0.606168)).lineTo(0.532895, 0.606168).lineTo(0.532895, 0.632812).lineTo(0.026645, 0.632812).threePointArc((0.007804, 0.625008), (0.000000, 0.606168)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.726562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
