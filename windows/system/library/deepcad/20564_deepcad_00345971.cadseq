# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00345971" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.663158, 0.000000).circle(0.663158)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.587171, -0.587171), (1.174342, 0.000000)).threePointArc((1.132895, 0.041447), (1.091447, 0.000000)).lineTo(0.690789, 0.000000).lineTo(0.663158, 0.000000).lineTo(0.621711, 0.000000).lineTo(0.221053, 0.000000).threePointArc((0.179605, 0.041447), (0.138158, 0.000000)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.092105, 0.000000).threePointArc((0.483553, -0.391447), (0.875000, 0.000000)).lineTo(0.469737, 0.000000).lineTo(0.442105, -0.055263).lineTo(0.405263, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.078125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
