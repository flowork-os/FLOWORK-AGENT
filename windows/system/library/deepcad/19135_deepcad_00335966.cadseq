# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00335966" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.382812, 0.000000, 0.351562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.367188, -0.286020).lineTo(0.367188, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.335938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.133224, 0.000000).lineTo(0.133224, 0.180592).lineTo(0.000000, 0.281250).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.335938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.132812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.250000, 0.000000).lineTo(0.000000, 0.184211).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.335938)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.134211, -0.102632).lineTo(0.386842, -0.284211).lineTo(0.750000, -0.284211).lineTo(0.750000, -0.213158).lineTo(0.386842, 0.071053).lineTo(0.000000, 0.071053).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.276316, -0.031579).circle(0.039474)
loop5=wp_sketch3.moveTo(0.473684, -0.213158).circle(0.039474)
solid3=wp_sketch3.add(loop3).add(loop4).add(loop5).extrude(0.335938)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
