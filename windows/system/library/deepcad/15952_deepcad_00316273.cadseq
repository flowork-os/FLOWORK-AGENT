# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00316273" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, -0.039474).lineTo(0.694737, 0.063158).lineTo(0.734211, 0.110526).lineTo(0.686842, 0.189474).lineTo(0.734211, 0.244737).lineTo(0.686842, 0.339474).lineTo(0.000000, 0.339474).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.110526, 0.268421).circle(0.023684)
loop2=wp_sketch0.moveTo(0.292105, 0.268421).circle(0.023684)
loop3=wp_sketch0.moveTo(0.615789, 0.078947).circle(0.023684)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
