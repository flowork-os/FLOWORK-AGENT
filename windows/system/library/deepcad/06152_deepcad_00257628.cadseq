# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257628" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).threePointArc((0.750000, 0.750000), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.726316, 0.078947).lineTo(0.442105, 0.347368).lineTo(0.315789, 0.457895).threePointArc((0.186977, 0.285459), (0.126316, 0.078947)).close()
loop2=wp_sketch0.moveTo(0.726316, 0.126316).lineTo(0.726316, 0.473684).lineTo(0.726316, 0.631579).threePointArc((0.524962, 0.592207), (0.347368, 0.489474)).close()
loop3=wp_sketch0.moveTo(1.042105, 0.394737).lineTo(1.136842, 0.505263).threePointArc((0.965425, 0.597637), (0.773684, 0.631579)).lineTo(0.773684, 0.473684).lineTo(0.773684, 0.126316).close()
loop4=wp_sketch0.moveTo(1.373684, 0.078947).threePointArc((1.307800, 0.295424), (1.168421, 0.473684)).lineTo(1.073684, 0.378947).lineTo(0.773684, 0.078947).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
