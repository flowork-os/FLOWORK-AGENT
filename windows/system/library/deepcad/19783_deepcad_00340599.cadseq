# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00340599" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, -0.664062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.012171, 0.000000).lineTo(1.012171, 1.414062).lineTo(0.000000, 1.414062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.982401, 0.029770).lineTo(0.982401, 1.384293).lineTo(0.029770, 1.384293).lineTo(0.029770, 0.029770).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
