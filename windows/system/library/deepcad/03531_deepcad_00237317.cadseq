import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.484211, 0.000000).lineTo(0.484211, -0.136184).lineTo(1.437500, -0.136184).lineTo(0.680921, 0.408553).lineTo(0.181579, 0.408553).lineTo(0.000000, 0.408553).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.445312)
solid=solid0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.484211, 0.000000).lineTo(0.484211, -0.136184).lineTo(1.437500, -0.136184).lineTo(0.680921, 0.408553).lineTo(0.181579, 0.408553).lineTo(0.000000, 0.408553).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.460938)
solid=solid.union(solid0)
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.148438, 0.468750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.312500, 0.000000).lineTo(0.312500, 0.072368).lineTo(0.000000, 0.072368).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.906250)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.062500, -0.265625, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch2.moveTo(0.625000, 0.000000).lineTo(0.625000, 0.184211).lineTo(0.000000, 0.184211).lineTo(0.000000, 0.000000).close()
