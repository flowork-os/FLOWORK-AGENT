loop5=wp_sketch5.moveTo(0.000000, 0.000000).threePointArc((0.027459, -0.066291), (0.093750, -0.093750)).lineTo(0.093750, 0.000000).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop5).extrude(-0.187500)
