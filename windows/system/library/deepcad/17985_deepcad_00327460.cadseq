# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00327460" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.615296, 0.000000).lineTo(0.701151, 0.014309).lineTo(1.316447, 0.014309).threePointArc((1.359375, 0.057237), (1.316447, 0.100164)).lineTo(0.701151, 0.100164).lineTo(0.615296, 0.100164).lineTo(0.000000, 0.100164).threePointArc((-0.050082, 0.050082), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.214638, 0.028618).threePointArc((0.236102, 0.050082), (0.214638, 0.071546)).lineTo(0.000000, 0.071546).threePointArc((-0.021464, 0.050082), (0.000000, 0.028618)).close()
loop2=wp_sketch0.moveTo(0.558059, 0.028618).threePointArc((0.579523, 0.050082), (0.558059, 0.071546)).lineTo(0.343421, 0.071546).threePointArc((0.321957, 0.050082), (0.343421, 0.028618)).close()
loop3=wp_sketch0.moveTo(1.001645, 0.057237).circle(0.014309)
loop4=wp_sketch0.moveTo(1.073191, 0.028618).lineTo(1.244901, 0.028618).threePointArc((1.223437, 0.050082), (1.244901, 0.071546)).lineTo(1.073191, 0.071546).threePointArc((1.051727, 0.050082), (1.073191, 0.028618)).close()
loop5=wp_sketch0.moveTo(1.316447, 0.057237).circle(0.014309)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch1.moveTo(0.773437, 0.000000).lineTo(0.683882, 0.008141).lineTo(0.000000, 0.008141).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop6).extrude(-0.046875, both=True)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
