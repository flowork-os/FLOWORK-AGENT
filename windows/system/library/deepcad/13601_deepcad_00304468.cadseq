# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00304468" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.593750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.184211).lineTo(0.000000, 1.184211).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.179688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.085938, 0.179688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(1.406250, 0.000000).lineTo(1.406250, 0.444079).lineTo(0.000000, 0.444079).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, -0.531250, 0.179688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(1.406250, 0.000000).lineTo(1.406250, 0.444079).lineTo(0.000000, 0.444079).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.015625)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.531250, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch3.moveTo(1.406250, 0.000000).lineTo(1.406250, 1.050987).lineTo(0.000000, 1.050987).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.015625)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
