# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00357100" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.607895, 0.000000).circle(0.607895)
loop1=wp_sketch0.moveTo(0.265954, -0.189967).lineTo(0.455921, 0.000000).lineTo(0.265954, 0.189967).lineTo(0.063322, 0.000000).close()
loop2=wp_sketch0.moveTo(0.607895, -0.531908).lineTo(0.797862, -0.341941).lineTo(0.607895, -0.151974).lineTo(0.405263, -0.341941).close()
loop3=wp_sketch0.moveTo(0.607895, 0.151974).lineTo(0.797862, 0.341941).lineTo(0.607895, 0.531908).lineTo(0.405263, 0.341941).close()
loop4=wp_sketch0.moveTo(0.607895, 0.000000).circle(0.075987)
loop5=wp_sketch0.moveTo(0.937171, -0.189967).lineTo(1.139803, 0.000000).lineTo(0.937171, 0.189967).lineTo(0.747204, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.453125, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.757895)
loop7=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.600000)
solid1=wp_sketch1.add(loop6).add(loop7).extrude(0.523438, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
