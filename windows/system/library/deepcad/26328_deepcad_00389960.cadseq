# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00389960" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, -0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.039474, 0.000000).lineTo(0.039474, 0.093750).lineTo(0.019737, 0.093750).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.047368).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.071957, 0.000000).lineTo(0.071957, 0.049342).lineTo(0.071957, 0.195312).lineTo(0.000000, 0.195312).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.039062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.001480, 0.000000).lineTo(0.001480, 0.046875).lineTo(0.000000, 0.046875).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.039062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.001480, 0.000000).lineTo(0.022204, 0.000000).lineTo(0.022204, 0.140625).lineTo(0.000000, 0.140625).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.039062)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
