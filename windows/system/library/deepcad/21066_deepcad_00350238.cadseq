# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.539062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.023123, -0.055824), (0.078947, -0.078947)).lineTo(1.421053, -0.078947).threePointArc((1.476877, -0.055824), (1.500000, 0.000000)).lineTo(1.500000, 1.089474).threePointArc((1.476877, 1.145298), (1.421053, 1.168421)).lineTo(0.078947, 1.168421).threePointArc((0.023123, 1.145298), (0.000000, 1.089474)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
