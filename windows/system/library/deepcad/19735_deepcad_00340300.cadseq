# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00340300" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.175329, 0.000000).lineTo(0.175329, 0.047204).lineTo(0.640625, 0.047204).lineTo(0.640625, 0.377632).lineTo(0.155099, 0.377632).lineTo(0.155099, 0.067434).lineTo(0.000000, 0.067434).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.262993, 0.215789).circle(0.040461)
loop2=wp_sketch0.moveTo(0.492270, 0.215789).circle(0.047204)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.382812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, -0.171875, 0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.042763, -0.093010).lineTo(0.101562, -0.008553).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.250000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.203125, 0.210938), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.055263, 0.000000).circle(0.055263)
solid2=wp_sketch2.add(loop4).extrude(-0.125000)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.500000, 0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.126316, 0.000000).circle(0.123684)
solid3=wp_sketch3.add(loop5).extrude(0.078125)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
