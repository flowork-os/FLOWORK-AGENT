# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239564" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.622944, 0.000000).lineTo(0.622944, 0.755839).lineTo(0.556497, 0.755839).lineTo(0.531579, 0.780757).lineTo(0.440214, 0.780757).lineTo(0.157812, 0.789062).lineTo(0.141201, 0.755839).lineTo(0.033224, 0.755839).lineTo(0.000000, 0.755839).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.581414, 0.041530).lineTo(0.581414, 0.714309).lineTo(0.531579, 0.714309).lineTo(0.514967, 0.747533).lineTo(0.440214, 0.747533).lineTo(0.182730, 0.747533).lineTo(0.166118, 0.714309).lineTo(0.041530, 0.714309).lineTo(0.041530, 0.041530).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.546299, 0.000000).lineTo(0.546299, 0.681003).lineTo(0.493914, 0.681003).lineTo(0.478947, 0.703454).lineTo(0.404112, 0.703454).lineTo(0.142187, 0.710938).lineTo(0.127220, 0.681003).lineTo(0.000000, 0.681003).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.007812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
