# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00342685" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, -0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.711349, 0.000000).lineTo(0.711349, 0.284539).lineTo(1.351562, 0.284539).lineTo(1.351562, 1.123931).lineTo(0.000000, 1.123931).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.284539, 0.426809).circle(0.042681)
loop2=wp_sketch0.moveTo(0.284539, 0.910526).circle(0.042681)
loop3=wp_sketch0.moveTo(1.024342, 0.426809).circle(0.042681)
loop4=wp_sketch0.moveTo(1.024342, 0.910526).circle(0.042681)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
