# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00372464" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.497368).lineTo(0.000000, 0.497368).lineTo(0.000000, 0.347368).threePointArc((0.094737, 0.252632), (0.000000, 0.157895)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.686842, 0.086842).lineTo(0.686842, 0.134211).lineTo(0.386842, 0.134211).lineTo(0.386842, 0.086842).close()
loop2=wp_sketch0.moveTo(0.686842, 0.363158).lineTo(0.686842, 0.410526).lineTo(0.386842, 0.410526).lineTo(0.386842, 0.363158).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.225658, 0.211842).threePointArc((0.087839, 0.107067), (0.064474, -0.064474)).lineTo(0.373026, -0.064474).lineTo(0.373026, 0.092105).threePointArc((0.278618, 0.186513), (0.373026, 0.280921)).lineTo(0.373026, 0.437500).lineTo(0.064474, 0.437500).threePointArc((0.018884, 0.418616), (0.000000, 0.373026)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.188816, 0.013816).circle(0.032237)
loop5=wp_sketch1.moveTo(0.188816, 0.359211).circle(0.032237)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.062500)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
