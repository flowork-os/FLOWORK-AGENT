# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00311436" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.151438, -0.380410), (0.218421, -0.204770)).threePointArc((0.238108, -0.147450), (0.293503, -0.122862)).lineTo(0.648438, -0.122862).lineTo(0.648438, 0.000000).lineTo(0.389063, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, -0.218421).circle(0.150164)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.296875, -0.148438, 0.218750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.049204, -0.085704), (0.148026, -0.086349)).lineTo(0.353618, 0.032895).lineTo(0.353618, 0.259046).lineTo(0.148026, 0.378289).threePointArc((0.049204, 0.377645), (0.000000, 0.291941)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.039062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.648438, -0.109375, 0.218750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.047697, 0.028618).threePointArc((0.097040, 0.113281), (0.047697, 0.197944)).lineTo(0.000000, 0.226562).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.039062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
