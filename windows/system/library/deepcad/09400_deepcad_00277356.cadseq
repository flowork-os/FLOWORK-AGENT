# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00277356" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.835938, 0.000000).lineTo(0.835938, 0.501563).lineTo(0.000000, 0.501563).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.087993, 0.422368).circle(0.017599)
loop2=wp_sketch0.moveTo(0.448766, 0.395970).circle(0.017599)
loop3=wp_sketch0.moveTo(0.536760, 0.369572).circle(0.026398)
loop4=wp_sketch0.moveTo(0.615954, 0.351974).circle(0.017599)
loop5=wp_sketch0.moveTo(0.756743, 0.422368).circle(0.017599)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
