wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.304688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.410526, 0.000000).threePointArc((0.750000, -0.152977), (1.089474, 0.000000)).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.615789).lineTo(1.089474, 0.615789).threePointArc((0.750000, 0.768767), (0.410526, 0.615789)).lineTo(0.000000, 0.615789).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.284211, 0.236842).lineTo(0.284211, 0.378947).lineTo(0.063158, 0.378947).lineTo(0.063158, 0.236842).close()
loop2=wp_sketch0.moveTo(0.757895, 0.300000).circle(0.284211)
loop3=wp_sketch0.moveTo(1.436842, 0.236842).lineTo(1.436842, 0.378947).lineTo(1.215789, 0.378947).lineTo(1.215789, 0.236842).close()
