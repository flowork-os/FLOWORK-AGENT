# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00256571" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.687500, 0.000000).lineTo(0.687500, 0.687500).lineTo(0.000000, 0.687500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.115789, 0.115789).circle(0.050658)
loop2=wp_sketch0.moveTo(0.115789, 0.571711).circle(0.050658)
loop3=wp_sketch0.moveTo(0.571711, 0.115789).circle(0.050658)
loop4=wp_sketch0.moveTo(0.571711, 0.571711).circle(0.050658)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.281250, 0.023438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.205263, 0.000000).circle(0.205263)
loop6=wp_sketch1.moveTo(0.205263, 0.000000).circle(0.162500)
solid1=wp_sketch1.add(loop5).add(loop6).extrude(0.226562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.062500, 0.023438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch2.moveTo(0.687500, 0.000000).lineTo(0.687500, 0.036184).lineTo(0.000000, 0.036184).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop7).extrude(0.226562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
