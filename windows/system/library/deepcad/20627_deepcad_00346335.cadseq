import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.742105, 0.000000).lineTo(0.742105, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.142105, 0.015789).lineTo(0.142105, 0.734211).lineTo(0.015789, 0.734211).lineTo(0.015789, 0.015789).close()
loop2=wp_sketch0.moveTo(0.292105, 0.015789).lineTo(0.292105, 0.734211).lineTo(0.157895, 0.734211).lineTo(0.157895, 0.015789).close()
loop3=wp_sketch0.moveTo(0.418421, 0.015789).lineTo(0.418421, 0.734211).lineTo(0.307895, 0.734211).lineTo(0.307895, 0.015789).close()
loop4=wp_sketch0.moveTo(0.568421, 0.015789).lineTo(0.568421, 0.734211).lineTo(0.426316, 0.734211).lineTo(0.426316, 0.015789).close()
loop5=wp_sketch0.moveTo(0.726316, 0.015789).lineTo(0.726316, 0.734211).lineTo(0.584211, 0.734211).lineTo(0.584211, 0.015789).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(-0.046875)
solid=solid0

