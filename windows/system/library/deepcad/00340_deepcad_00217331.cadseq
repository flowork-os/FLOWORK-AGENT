# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00217331" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.109375, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.273438, 0.000000).lineTo(0.273438, 0.273438).lineTo(0.000000, 0.273438).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.518092, 0.000000).lineTo(0.518092, 0.546875).lineTo(0.000000, 0.546875).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.397204, 0.138158).lineTo(0.397204, 0.408717).lineTo(0.120888, 0.408717).lineTo(0.120888, 0.138158).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.140625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
