# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00339793" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.521053).lineTo(0.000000, 0.521053).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.150000, 0.007895).lineTo(0.150000, 0.513158).lineTo(0.007895, 0.513158).lineTo(0.007895, 0.007895).close()
loop2=wp_sketch0.moveTo(0.307895, 0.007895).lineTo(0.307895, 0.513158).lineTo(0.165789, 0.513158).lineTo(0.165789, 0.007895).close()
loop3=wp_sketch0.moveTo(0.457895, 0.007895).lineTo(0.457895, 0.513158).lineTo(0.315789, 0.513158).lineTo(0.315789, 0.007895).close()
loop4=wp_sketch0.moveTo(0.607895, 0.007895).lineTo(0.607895, 0.513158).lineTo(0.465789, 0.513158).lineTo(0.465789, 0.007895).close()
loop5=wp_sketch0.moveTo(0.742105, 0.007895).lineTo(0.742105, 0.513158).lineTo(0.623684, 0.513158).lineTo(0.623684, 0.007895).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
