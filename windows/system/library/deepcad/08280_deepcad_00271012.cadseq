import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.792105, 0.000000).lineTo(0.792105, 1.343750).lineTo(0.000000, 1.343750).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.212171, 0.876974).threePointArc((0.189238, 0.966488), (0.268750, 0.919408)).lineTo(0.537500, 0.919408).threePointArc((0.617012, 0.966488), (0.594079, 0.876974)).lineTo(0.594079, 0.466776).threePointArc((0.617012, 0.377262), (0.537500, 0.424342)).lineTo(0.268750, 0.424342).threePointArc((0.189238, 0.377262), (0.212171, 0.466776)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.210938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, -0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.071546, 0.157401).threePointArc((0.105472, 0.048516), (0.052467, -0.052467)).lineTo(0.324342, -0.052467).threePointArc((0.342094, -0.014379), (0.381579, 0.000000)).lineTo(0.381579, 0.400658).threePointArc((0.342094, 0.415037), (0.324342, 0.453125)).lineTo(0.052467, 0.453125).threePointArc((0.037100, 0.416025), (0.000000, 0.400658)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.210938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
