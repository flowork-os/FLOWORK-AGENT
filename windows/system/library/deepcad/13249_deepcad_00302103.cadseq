import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.011842, -0.005249), (0.023684, 0.000000)).threePointArc((0.142105, 0.081246), (0.260526, 0.000000)).lineTo(0.371053, 0.000000).lineTo(0.489474, 0.000000).threePointArc((0.607895, 0.082319), (0.726316, 0.000000)).threePointArc((0.738158, -0.005249), (0.750000, 0.000000)).threePointArc((0.723486, 0.100813), (0.631579, 0.150000)).lineTo(0.607895, 0.150000).lineTo(0.142105, 0.150000).lineTo(0.118421, 0.150000).threePointArc((0.026514, 0.100813), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.703125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, -0.531250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.078947, 0.000000).circle(0.078947)
solid1=wp_sketch1.add(loop1).extrude(0.156250)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.078125, 0.078125), (0.000000, 0.156250)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.156250)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.156250).threePointArc((-0.078125, 0.078125), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(0.156250)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
