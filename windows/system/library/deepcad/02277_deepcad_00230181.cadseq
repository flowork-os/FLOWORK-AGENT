wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.000480, -0.199581), (0.171711, -0.300493)).lineTo(0.329112, -0.300493).lineTo(0.479359, -0.300493).threePointArc((0.651550, -0.199581), (0.651069, 0.000000)).lineTo(0.500822, 0.264720).threePointArc((0.325535, 0.365445), (0.150247, 0.264720)).lineTo(0.000000, 0.000000).close()
