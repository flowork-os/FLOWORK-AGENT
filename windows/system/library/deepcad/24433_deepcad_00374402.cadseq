wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.042922, -0.103624), (0.146546, -0.146546)).lineTo(1.065789, -0.146546).threePointArc((1.207095, -0.088016), (1.265625, 0.053289)).lineTo(1.265625, 0.612829).threePointArc((1.210997, 0.744714), (1.079112, 0.799342)).lineTo(0.146546, 0.799342).threePointArc((0.042922, 0.756420), (0.000000, 0.652796)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.359375)
solid=solid0

if __name__ == '__main__':
