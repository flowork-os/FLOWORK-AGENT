# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00381230" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.189474, 0.000000).circle(0.185526)
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.213158, 0.000000).circle(0.208717)
loop2=wp_sketch1.moveTo(0.213158, 0.000000).circle(0.190954)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.171875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, 0.171875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.201316, 0.000000).circle(0.201316)
loop4=wp_sketch2.moveTo(0.201316, 0.000000).circle(0.188734)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.015625)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, -0.054688, 0.171875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.010691, 0.000000).threePointArc((0.016954, 0.050781), (0.010691, 0.101562)).lineTo(0.000000, 0.101562).threePointArc((0.006580, 0.050781), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop5).extrude(-0.140625)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, -0.054688, 0.171875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch4.moveTo(0.382401, 0.000000).threePointArc((0.389061, 0.051398), (0.382401, 0.102796)).lineTo(0.000000, 0.102796).threePointArc((-0.006660, 0.051398), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop6).extrude(-0.140625)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, -0.054688, 0.171875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch5.moveTo(0.010691, 0.000000).threePointArc((0.004111, 0.050781), (0.010691, 0.101562)).lineTo(0.000000, 0.101562).threePointArc((-0.006263, 0.050781), (0.000000, 0.000000)).close()
solid5=wp_sketch5.add(loop7).extrude(-0.140625)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
