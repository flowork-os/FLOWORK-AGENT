# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00377870" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.157895, -0.600000).threePointArc((0.323541, -0.752043), (0.481579, -0.592105)).lineTo(0.481579, 0.000000).threePointArc((0.240789, 0.237853), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.236842, 0.000000).circle(0.126316)
loop2=wp_sketch0.moveTo(0.315789, -0.592105).circle(0.063158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.109375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
