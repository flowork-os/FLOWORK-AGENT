# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00283982" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.006503, -0.015701), (0.022204, -0.022204)).lineTo(0.658717, -0.022204).lineTo(0.658717, 0.703125).lineTo(0.022204, 0.703125).threePointArc((0.006503, 0.696622), (0.000000, 0.680921)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.318257, 0.340461).circle(0.022204)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.006937, -0.016747), (0.023684, -0.023684)).lineTo(0.678947, -0.023684).lineTo(0.678947, 0.000000).lineTo(0.047368, 0.000000).threePointArc((0.030621, 0.006937), (0.023684, 0.023684)).lineTo(0.023684, 0.702632).threePointArc((0.030621, 0.719379), (0.047368, 0.726316)).lineTo(0.678947, 0.726316).lineTo(0.678947, 0.750000).lineTo(0.023684, 0.750000).threePointArc((0.006937, 0.743063), (0.000000, 0.726316)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.726562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
