wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.006720, -0.016224), (0.022944, -0.022944)).lineTo(0.451234, -0.022944).threePointArc((0.471281, -0.017808), (0.481826, 0.000000)).lineTo(0.481826, 0.703618).threePointArc((0.471281, 0.721426), (0.451234, 0.726562)).lineTo(0.022944, 0.726562).threePointArc((0.006720, 0.719842), (0.000000, 0.703618)).lineTo(0.000000, 0.000000).close()
