import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.469737, 0.000000).lineTo(0.469737, 0.173355).lineTo(0.346711, 0.246053).lineTo(0.346711, 0.313158).lineTo(0.469737, 0.385855).lineTo(0.469737, 0.531250).lineTo(0.357895, 0.531250).lineTo(0.240461, 0.475329).lineTo(0.055921, 0.475329).lineTo(0.000000, 0.246053).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
