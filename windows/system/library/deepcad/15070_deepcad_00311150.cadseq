import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.004276, -0.004276).lineTo(0.106908, -0.004276).lineTo(0.106908, 0.000000).lineTo(0.106908, 0.094079).lineTo(0.299342, 0.094079).lineTo(0.299342, 0.000000).lineTo(0.299342, -0.004276).lineTo(0.401974, -0.004276).lineTo(0.406250, 0.000000).lineTo(0.406250, 0.158224).lineTo(0.401974, 0.162500).lineTo(0.004276, 0.162500).lineTo(0.000000, 0.158224).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
