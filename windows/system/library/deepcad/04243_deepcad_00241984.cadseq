# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00241984" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, -0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.921875, 0.000000).lineTo(0.921875, 0.485197).lineTo(0.000000, 0.485197).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.853947, 0.067928).lineTo(0.853947, 0.417270).lineTo(0.067928, 0.417270).lineTo(0.067928, 0.067928).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.523438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.781250, 0.000000).lineTo(0.781250, 0.345395).lineTo(0.000000, 0.345395).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.748355, 0.032895).lineTo(0.748355, 0.320724).lineTo(0.032895, 0.320724).lineTo(0.032895, 0.032895).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.593750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, -0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.921875, 0.000000).lineTo(0.921875, 0.485197).lineTo(0.000000, 0.485197).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.853947, 0.067928).lineTo(0.853947, 0.417270).lineTo(0.067928, 0.417270).lineTo(0.067928, 0.067928).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(-0.593750)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
