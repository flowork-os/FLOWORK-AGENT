import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.053025, 0.101939), (0.167516, 0.111678)).lineTo(0.709951, 0.119655).threePointArc((0.760544, 0.171505), (0.709951, 0.223355)).lineTo(0.167516, 0.231332).threePointArc((0.053025, 0.241071), (0.000000, 0.343010)).threePointArc((-0.163286, 0.171505), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.709951, 0.175493).circle(0.031908)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
