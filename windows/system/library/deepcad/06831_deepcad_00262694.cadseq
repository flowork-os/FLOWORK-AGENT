import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.076974, -0.500329).lineTo(0.198849, -0.500329).lineTo(0.198849, -0.205263).threePointArc((0.304688, -0.311102), (0.410526, -0.205263)).lineTo(0.410526, -0.500329).lineTo(0.532401, -0.500329).lineTo(0.609375, 0.000000).lineTo(0.609375, 0.519572).lineTo(0.500329, 0.519572).lineTo(0.500329, 0.590132).lineTo(0.109046, 0.590132).lineTo(0.109046, 0.519572).lineTo(0.000000, 0.519572).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.398438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -1.000000, 0.195312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.414062, 0.000000).lineTo(1.414062, 0.431661).lineTo(0.000000, 0.431661).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.531250, both=True)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.000000, 0.398438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.203125, -0.117599).lineTo(0.203125, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-1.000000)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, 0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.203125, 0.117599).lineTo(0.000000, 0.117599).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-1.000000)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
