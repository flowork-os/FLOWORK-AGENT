import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, 0.664062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.026151, -0.414062).lineTo(0.191776, -0.383553).lineTo(0.296382, -0.313816).lineTo(0.335609, -0.235362).lineTo(0.326891, -0.122039).lineTo(0.287664, -0.047944).lineTo(0.191776, 0.013076).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.218750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, 0.718750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.078947, -0.027632).lineTo(0.130263, -0.086842).lineTo(0.157895, -0.169737).lineTo(0.157895, -0.240789).lineTo(0.130263, -0.327632).lineTo(0.078947, -0.375000).lineTo(0.157895, -0.375000).lineTo(0.228947, -0.307895).lineTo(0.228947, -0.240789).lineTo(0.228947, -0.169737).lineTo(0.201316, -0.059211).lineTo(0.130263, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.218750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, -0.359375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.984375, 0.000000).lineTo(0.984375, 0.528454).lineTo(0.000000, 0.528454).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.218750)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
