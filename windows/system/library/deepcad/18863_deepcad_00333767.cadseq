# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00333767" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.167105, 0.000000).lineTo(0.167105, 0.992188).lineTo(0.000000, 0.992188).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.083553, 0.062664).circle(0.031332)
loop2=wp_sketch0.moveTo(0.083553, 0.908635).circle(0.031332)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
