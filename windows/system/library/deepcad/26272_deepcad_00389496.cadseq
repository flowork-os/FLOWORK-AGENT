# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00389496" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.437500, 0.000000).lineTo(1.437500, 0.741447).lineTo(0.000000, 0.741447).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.147422, -0.007881), (0.257237, 0.090789)).lineTo(0.514474, 0.090789).threePointArc((0.632170, 0.139541), (0.680921, 0.257237)).lineTo(0.680921, 0.469079).threePointArc((0.635304, 0.594341), (0.514474, 0.650658)).lineTo(0.257237, 0.650658).threePointArc((0.128841, 0.597475), (0.075658, 0.469079)).lineTo(0.075658, 0.257237).close()
loop2=wp_sketch0.moveTo(0.741447, 0.635526).circle(0.045395)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.015625, 0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.043421, 0.000000).circle(0.043421)
solid1=wp_sketch1.add(loop3).extrude(0.117188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
