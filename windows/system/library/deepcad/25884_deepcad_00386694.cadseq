wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.367188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.615789, 0.000000).lineTo(0.710526, 0.260526).lineTo(0.750000, 0.371053).lineTo(0.750000, 0.481579).lineTo(0.655263, 0.481579).lineTo(0.655263, 0.386842).lineTo(0.615789, 0.300000).lineTo(0.544737, 0.094737).lineTo(0.094737, 0.094737).lineTo(0.094737, 0.371053).lineTo(0.094737, 0.481579).lineTo(0.000000, 0.481579).lineTo(0.000000, 0.371053).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
