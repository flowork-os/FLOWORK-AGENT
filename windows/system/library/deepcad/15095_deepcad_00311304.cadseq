import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.041694, 0.000000).lineTo(0.041694, 0.041694).lineTo(0.138980, 0.041694).threePointArc((0.660156, 0.562870), (1.181332, 0.041694)).lineTo(1.278618, 0.041694).lineTo(1.278618, 0.000000).lineTo(1.320312, 0.000000).lineTo(1.320312, 0.083388).lineTo(1.223026, 0.083388).threePointArc((0.660156, 0.606268), (0.097286, 0.083388)).lineTo(0.000000, 0.083388).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.500000, 0.750000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
