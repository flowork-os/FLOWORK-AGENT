import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.025000, -0.025000).lineTo(1.162500, -0.025000).lineTo(1.187500, 0.000000).lineTo(1.187500, 0.437500).lineTo(1.162500, 0.475000).lineTo(0.025000, 0.475000).lineTo(0.000000, 0.437500).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.038240, -0.038240).lineTo(1.172697, -0.038240).lineTo(1.210938, 0.000000).lineTo(1.210938, 0.446135).lineTo(1.172697, 0.484375).lineTo(0.038240, 0.484375).lineTo(0.000000, 0.446135).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.038240, -0.025493).lineTo(1.172697, -0.025493).lineTo(1.198191, 0.000000).lineTo(1.198191, 0.446135).lineTo(1.172697, 0.471628).lineTo(0.038240, 0.471628).lineTo(0.012747, 0.446135).lineTo(0.012747, 0.000000).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.132484, -0.132484).lineTo(0.426891, -0.132484).threePointArc((0.699219, -0.257219), (0.971546, -0.132484)).lineTo(1.265954, -0.132484).lineTo(1.398438, 0.000000).lineTo(1.398438, 0.441612).lineTo(1.265954, 0.574095).lineTo(0.132484, 0.574095).lineTo(0.000000, 0.441612).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.132484, -0.044161).lineTo(1.265954, -0.044161).lineTo(1.310115, 0.000000).lineTo(1.310115, 0.441612).lineTo(1.265954, 0.485773).lineTo(0.132484, 0.485773).lineTo(0.088322, 0.441612).lineTo(0.088322, 0.000000).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.070312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
