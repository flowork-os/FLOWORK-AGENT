# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00362943" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.000000, 0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.422368, 0.000000).circle(0.422368)
loop1=wp_sketch0.moveTo(0.061595, 0.000000).circle(0.035197)
loop2=wp_sketch0.moveTo(0.422368, 0.000000).circle(0.052796)
loop3=wp_sketch0.moveTo(0.413569, 0.360773).circle(0.035197)
loop4=wp_sketch0.moveTo(0.422368, -0.360773).circle(0.035197)
loop5=wp_sketch0.moveTo(0.774342, 0.000000).circle(0.035197)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
