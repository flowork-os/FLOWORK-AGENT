# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00248921" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, 0.398438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.024178, -1.148438).lineTo(0.108799, -1.148438).lineTo(0.132977, 0.000000).threePointArc((0.066488, -0.058792), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.048355, -0.991283).threePointArc((0.066488, -1.009195), (0.084622, -0.991283)).lineTo(0.096711, -0.157155).threePointArc((0.066488, -0.126559), (0.036266, -0.157155)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, 0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, -0.019572).threePointArc((0.069497, -0.074796), (0.132812, -0.012582)).lineTo(0.132812, -0.005592).threePointArc((0.069004, 0.058892), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.065707, -0.008388).circle(0.025164)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.062500, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, 0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.008964, -0.833635).threePointArc((0.031373, -0.855771), (0.053783, -0.833635)).lineTo(0.062747, 0.000000).threePointArc((0.031373, 0.031761), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop4).extrude(0.015625, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
