# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00227552" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.000000, -0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.688651, 0.174342).threePointArc((0.826355, 0.353043), (0.688651, 0.531743)).lineTo(0.000000, 0.714803).threePointArc((0.275407, 0.357401), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.645066, 0.357401).circle(0.095888)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.371053, 0.000000).circle(0.371053)
loop3=wp_sketch1.moveTo(0.371053, 0.000000).circle(0.216447)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.546875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
