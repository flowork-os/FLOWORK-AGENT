# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00221009" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, -0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.859375, 0.009046).lineTo(0.388980, 0.814145).lineTo(0.000000, 0.814145).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.210938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, -0.210938, -0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.503289, 0.000000).lineTo(0.230921, 0.556579).lineTo(0.000000, 0.562500).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.539062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.609375, 0.226562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(0.903989, 0.000000, 0.427555)))
loop2=wp_sketch2.moveTo(0.118421, 0.000000).circle(0.118421)
solid2=wp_sketch2.add(loop2).extrude(-0.210938)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
