# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284650" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.234375, 0.000000).lineTo(1.234375, 0.441776).lineTo(0.000000, 0.441776).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.414062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.546875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(1.234375, 0.000000).lineTo(1.234375, 0.792599).lineTo(0.000000, 0.792599).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.272862, 0.454770).circle(0.155921)
loop3=wp_sketch1.moveTo(0.974507, 0.454770).circle(0.142928)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.414062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
