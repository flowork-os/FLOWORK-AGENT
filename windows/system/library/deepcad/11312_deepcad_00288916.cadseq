# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288916" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.145066, 0.000000).threePointArc((0.284103, 0.208084), (0.492187, 0.347122)).lineTo(0.492187, 0.492187).lineTo(0.000000, 0.492187).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.257812, 0.070312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.145066, 0.000000).threePointArc((0.284103, 0.208084), (0.492187, 0.347122)).lineTo(0.492187, 0.492187).lineTo(0.000000, 0.492187).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.119161, 0.036266).threePointArc((0.257259, 0.234928), (0.455921, 0.373026)).lineTo(0.455921, 0.455921).lineTo(0.036266, 0.455921).lineTo(0.036266, 0.036266).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.039062)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
