# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.539062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop9=wp_sketch3.moveTo(0.000000, 0.000000).circle(0.007895)
loop10=wp_sketch3.moveTo(0.718421, -0.031579).threePointArc((0.750000, 0.000000), (0.718421, 0.031579)).lineTo(0.000000, 0.031579).threePointArc((0.031579, 0.000000), (0.000000, -0.031579)).close()
loop11=wp_sketch3.moveTo(0.718421, 0.000000).circle(0.007895)
