loop5=wp_sketch1.moveTo(0.325329, 0.000000).circle(0.003783)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.000000, 0.000000).circle(0.005181)
loop7=wp_sketch2.moveTo(0.461102, -0.031086).threePointArc((0.492187, 0.000000), (0.461102, 0.031086)).lineTo(0.000000, 0.031086).threePointArc((0.031086, 0.000000), (0.000000, -0.031086)).close()
loop8=wp_sketch2.moveTo(0.461102, 0.000000).circle(0.005181)
solid2=wp_sketch2.add(loop6).add(loop7).add(loop8).extrude(0.023438)
