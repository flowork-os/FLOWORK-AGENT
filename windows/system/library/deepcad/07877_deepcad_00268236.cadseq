import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.193174, 0.000000).threePointArc((0.225370, 0.032196), (0.193174, 0.064391)).lineTo(0.000000, 0.064391).threePointArc((-0.032196, 0.032196), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.033388).circle(0.002385)
loop2=wp_sketch0.moveTo(0.193174, 0.033388).circle(0.002385)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.003783, 0.000000).circle(0.003783)
