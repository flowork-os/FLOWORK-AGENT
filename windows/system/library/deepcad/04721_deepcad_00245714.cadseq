solid2=wp_sketch2.add(loop2).extrude(-1.000000)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.289062, -0.015625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.154276, 0.000000).threePointArc((-0.593947, 0.013775), (0.154276, 0.027549)).lineTo(0.000000, 0.027549).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.867188)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.289062, -0.015625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.156250, 0.000000).threePointArc((0.156523, 0.014803), (0.156250, 0.029605)).lineTo(0.000000, 0.029605).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(-0.867188)
