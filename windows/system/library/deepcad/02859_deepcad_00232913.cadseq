wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.695312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013874, -0.033495), (0.047368, -0.047368)).lineTo(1.452632, -0.047368).threePointArc((1.486126, -0.033495), (1.500000, 0.000000)).lineTo(1.500000, 1.389474).threePointArc((1.489396, 1.430863), (1.452632, 1.452632)).lineTo(0.047368, 1.452632).threePointArc((0.010604, 1.430863), (0.000000, 1.389474)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
