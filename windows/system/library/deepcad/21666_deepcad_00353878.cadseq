# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.218750, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop5=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.051715, -0.113629), (0.123355, -0.215872)).lineTo(0.450247, -0.191201).lineTo(0.585938, 0.067845).threePointArc((0.496513, 0.139396), (0.481086, 0.252878)).lineTo(0.197368, 0.265214).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(-1.000000)
