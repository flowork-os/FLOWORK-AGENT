# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.148438, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop6=wp_sketch5.moveTo(0.129523, -0.252878).lineTo(0.462582, -0.289885).threePointArc((0.533938, -0.190726), (0.585938, -0.080181)).lineTo(0.400905, 0.191201).lineTo(0.111020, 0.185033).threePointArc((0.092508, 0.070318), (0.000000, 0.000000)).close()
