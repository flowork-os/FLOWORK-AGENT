# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231612" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.631579, 0.000000).circle(0.631579)
loop1=wp_sketch0.moveTo(0.631579, 0.000000).circle(0.526316)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.710938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.452632).lineTo(0.000000, 1.452632).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.173684, 0.173684).circle(0.078947)
loop4=wp_sketch1.moveTo(0.173684, 1.247368).circle(0.078947)
loop5=wp_sketch1.moveTo(0.757895, 0.710526).circle(0.631579)
loop6=wp_sketch1.moveTo(1.326316, 0.173684).circle(0.078947)
loop7=wp_sketch1.moveTo(1.326316, 1.247368).circle(0.078947)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).add(loop7).extrude(-0.125000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
