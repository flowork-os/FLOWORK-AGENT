# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.035232, -0.033104), (0.047862, -0.079770)).lineTo(0.047862, -0.263240).threePointArc((0.183470, -0.398849), (0.319079, -0.263240)).lineTo(0.319079, -0.079770).threePointArc((0.331708, -0.033104), (0.366941, 0.000000)).threePointArc((0.183470, 0.772558), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
