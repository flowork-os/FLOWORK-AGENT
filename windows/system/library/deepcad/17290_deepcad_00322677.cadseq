# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322677" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, 0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.049342, 0.000000).lineTo(0.049342, -0.029605).lineTo(0.898026, -0.029605).threePointArc((0.934056, -0.005183), (0.907895, 0.029605)).lineTo(0.000000, 0.029605).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.177632, 0.000000).circle(0.019737)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
