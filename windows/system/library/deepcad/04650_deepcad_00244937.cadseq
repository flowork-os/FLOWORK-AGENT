# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00244937" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.531250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.217105, 0.000000).lineTo(0.217105, 0.515625).lineTo(0.000000, 0.515625).lineTo(0.000000, 0.260526).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.151974, 0.135691).circle(0.043421)
loop2=wp_sketch0.moveTo(0.151974, 0.379934).circle(0.043421)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.453125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.113980, 0.000000).lineTo(0.113980, 0.515625).lineTo(0.000000, 0.515625).lineTo(0.000000, 0.260526).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.054276, 0.162829).circle(0.027138)
loop5=wp_sketch1.moveTo(0.054276, 0.352796).circle(0.027138)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.265625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.445312, 0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.171875, 0.000000).lineTo(0.171875, 0.429688).lineTo(0.000000, 0.429688).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(0.062500)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
