# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00309757" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.150750, -0.384006), (0.221053, -0.205263)).threePointArc((0.239370, -0.150302), (0.292105, -0.126316)).lineTo(0.750000, -0.126316).lineTo(0.750000, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, -0.221053).circle(0.150000)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.296875, -0.148438, 0.218750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.049264, -0.085410), (0.147862, -0.085855)).lineTo(0.405428, 0.062007).threePointArc((0.455466, 0.147862), (0.405428, 0.233717)).lineTo(0.147862, 0.376809).threePointArc((0.050634, 0.378749), (0.000000, 0.295724)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
