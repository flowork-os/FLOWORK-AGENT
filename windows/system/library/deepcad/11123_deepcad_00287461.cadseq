# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00287461" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.200000, -0.416237), (0.400000, 0.000000)).threePointArc((0.421052, 0.093750), (0.400000, 0.187500)).threePointArc((0.200000, 0.590977), (0.000000, 0.187500)).threePointArc((-0.021052, 0.093750), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.200000, -0.162500).circle(0.168750)
loop2=wp_sketch0.moveTo(0.200000, 0.343750).circle(0.168750)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.125000, 0.054688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.122368, 0.000000).circle(0.122368)
solid1=wp_sketch1.add(loop3).extrude(0.242188)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.125000, 0.054688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.122368, 0.000000).circle(0.122368)
solid1=wp_sketch1.add(loop3).extrude(-0.242188)
solid_temp=solid_temp.union(solid1)
solid=solid.union(solid_temp)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.242188, 0.171875, 0.054688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.075000, 0.000000).circle(0.075000)
solid2=wp_sketch2.add(loop4).extrude(-0.062500)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.171875, 0.054688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.075000, 0.000000).circle(0.075000)
solid3=wp_sketch3.add(loop5).extrude(-0.062500)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch4.moveTo(0.169737, 0.000000).circle(0.166201)
solid4=wp_sketch4.add(loop6).extrude(0.187500, both=True)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch5.moveTo(0.169737, 0.000000).circle(0.166201)
solid5=wp_sketch5.add(loop7).extrude(0.187500, both=True)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
