# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.273438, -0.359375, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch5.moveTo(0.171711, 0.000000).lineTo(0.171711, 0.187500).lineTo(0.000000, 0.187500).lineTo(0.000000, 0.000000).close()
