loop3=wp_sketch3.moveTo(0.241530, 0.000000).lineTo(0.241530, 0.257812).lineTo(0.000000, 0.257812).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.054688)
