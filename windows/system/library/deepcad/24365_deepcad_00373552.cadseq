loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.017342, -0.041868), (0.059211, -0.059211)).lineTo(1.273026, -0.059211).threePointArc((1.322296, -0.044934), (1.347039, 0.000000)).lineTo(1.347039, 1.347039).threePointArc((1.322296, 1.391973), (1.273026, 1.406250)).lineTo(0.059211, 1.406250).threePointArc((0.017342, 1.388908), (0.000000, 1.347039)).lineTo(0.000000, 0.000000).close()
