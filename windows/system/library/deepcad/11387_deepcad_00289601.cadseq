# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00289601" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, -0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.708388, 0.000000).threePointArc((0.504605, 0.203783), (0.708388, 0.407566)).lineTo(0.708388, 0.921875).threePointArc((0.129224, 0.633809), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.727796, 0.000000).threePointArc((0.592380, 0.641318), (0.000000, 0.921875)).lineTo(0.000000, 0.407566).threePointArc((0.203783, 0.203783), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.101562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
