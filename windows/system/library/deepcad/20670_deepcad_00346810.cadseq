import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, 0.000000, -0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.687500, 0.000000).lineTo(0.687500, 0.347368).lineTo(0.123026, 0.347368).lineTo(0.094079, 0.260526).threePointArc((0.065705, 0.242832), (0.043421, 0.267763)).lineTo(0.043421, 0.347368).lineTo(0.000000, 0.347368).lineTo(0.000000, 0.253289).lineTo(0.028947, 0.253289).lineTo(0.028947, 0.238816).lineTo(0.000000, 0.238816).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.343750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.046875, -0.187500, -0.171875), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.067105, 0.000000).circle(0.065707)
solid1=wp_sketch1.add(loop1).extrude(-0.500000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, -0.664062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.086842, 0.000000).circle(0.085033)
solid2=wp_sketch2.add(loop2).extrude(0.343750)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.054688, -0.664062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.086842, 0.000000).circle(0.086842)
solid3=wp_sketch3.add(loop3).extrude(0.343750)
