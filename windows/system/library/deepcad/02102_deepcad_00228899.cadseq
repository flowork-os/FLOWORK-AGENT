# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00228899" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.094737, 0.000000).lineTo(0.094737, 0.465789).lineTo(0.142105, 0.481579).lineTo(0.142105, 0.655263).lineTo(0.094737, 0.671053).lineTo(0.094737, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.078947, 0.497368).lineTo(0.078947, 0.631579).lineTo(0.015789, 0.631579).lineTo(0.015789, 0.497368).close()
loop2=wp_sketch0.moveTo(0.071053, 0.094737).lineTo(0.071053, 0.315789).lineTo(0.023684, 0.315789).lineTo(0.023684, 0.094737).close()
loop3=wp_sketch0.moveTo(0.047368, 0.031579).circle(0.007895)
loop4=wp_sketch0.moveTo(0.047368, 0.410526).circle(0.007895)
loop5=wp_sketch0.moveTo(0.047368, 0.710526).circle(0.007895)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
