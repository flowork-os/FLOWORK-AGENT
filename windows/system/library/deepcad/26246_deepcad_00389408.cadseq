loop3=wp_sketch3.moveTo(0.578125, 0.000000).lineTo(0.578125, 0.553783).lineTo(0.000000, 0.553783).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.289062)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, 0.578125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.240789, 0.000000).circle(0.240789)
solid4=wp_sketch4.add(loop4).extrude(-0.289062)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, -0.289062, 0.578125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch5.moveTo(0.953125, 0.000000).lineTo(0.953125, 0.571875).lineTo(0.000000, 0.571875).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch5.moveTo(0.481579, 0.290954).circle(0.240789)
solid5=wp_sketch5.add(loop5).add(loop6).extrude(-0.289062)
