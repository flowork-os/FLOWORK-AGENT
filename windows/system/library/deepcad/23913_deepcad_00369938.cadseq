wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, 0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001445, -0.003489), (0.004934, -0.004934)).lineTo(0.034128, -0.004934).threePointArc((0.037617, -0.003489), (0.039062, 0.000000)).lineTo(0.039062, 0.029194).threePointArc((0.037617, 0.032683), (0.034128, 0.034128)).lineTo(0.004934, 0.034128).threePointArc((0.001445, 0.032683), (0.000000, 0.029194)).lineTo(0.000000, 0.000000).close()
