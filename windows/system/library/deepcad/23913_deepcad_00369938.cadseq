# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.015625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.003701, 0.003701).threePointArc((0.002529, -0.000872), (0.004934, -0.004934)).lineTo(0.034128, -0.004934).threePointArc((0.037617, -0.003489), (0.039062, 0.000000)).lineTo(0.039062, 0.029194).threePointArc((0.037617, 0.032683), (0.034128, 0.034128)).lineTo(0.004934, 0.034128).threePointArc((0.001445, 0.032683), (0.000000, 0.029194)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.004062, -0.002405), (0.008635, -0.001234)).lineTo(0.030428, -0.001234).threePointArc((0.033917, 0.000212), (0.035362, 0.003701)).lineTo(0.035362, 0.025493).threePointArc((0.033917, 0.028982), (0.030428, 0.030428)).lineTo(0.008635, 0.030428).threePointArc((0.005146, 0.028982), (0.003701, 0.025493)).lineTo(0.003701, 0.003701).close()
