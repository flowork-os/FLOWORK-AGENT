# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00300928" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.195312).threePointArc((-0.077180, 0.097656), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.328125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.617188, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.067000, 0.097656), (0.000000, 0.195312)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.328125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(1.296875, 0.000000).lineTo(1.296875, 0.191118).lineTo(0.000000, 0.191118).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.273026, 0.095559).circle(0.040954)
loop4=wp_sketch2.moveTo(0.682566, 0.095559).circle(0.040954)
loop5=wp_sketch2.moveTo(1.023849, 0.095559).circle(0.040954)
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.328125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
