# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.185444, -0.325658).lineTo(0.244243, -0.325658).lineTo(0.429688, 0.000000).lineTo(0.402549, 0.049753).lineTo(0.280428, 0.049753).lineTo(0.280428, -0.090461).threePointArc((0.214844, -0.156044), (0.149260, -0.090461)).lineTo(0.149260, 0.049753).lineTo(0.027138, 0.049753).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.023438)
