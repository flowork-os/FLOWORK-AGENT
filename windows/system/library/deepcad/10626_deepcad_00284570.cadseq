wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.010959, -0.026458), (0.037418, -0.037418)).lineTo(0.329276, -0.037418).threePointArc((0.355735, -0.026458), (0.366694, 0.000000)).lineTo(0.366694, 0.673520).threePointArc((0.355735, 0.699978), (0.329276, 0.710938)).lineTo(0.037418, 0.710938).threePointArc((0.010959, 0.699978), (0.000000, 0.673520)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.112253, 0.463980).circle(0.029934)
loop2=wp_sketch0.moveTo(0.329276, 0.082319).lineTo(0.329276, 0.194572).lineTo(0.127220, 0.194572).lineTo(0.127220, 0.082319).close()
