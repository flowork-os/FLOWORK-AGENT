# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.156250, 0.250000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop8=wp_sketch5.moveTo(0.343750, 0.000000).lineTo(0.343750, 0.231579).lineTo(0.311184, 0.231579).lineTo(0.311184, 0.025329).lineTo(0.032566, 0.025329).lineTo(0.032566, 0.231579).lineTo(0.000000, 0.231579).lineTo(0.000000, 0.000000).close()
