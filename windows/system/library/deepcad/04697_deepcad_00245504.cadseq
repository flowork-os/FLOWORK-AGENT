# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, -0.078125, 0.250000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop7=wp_sketch4.moveTo(0.032566, 0.000000).lineTo(0.032566, -0.209868).lineTo(0.311184, -0.209868).lineTo(0.311184, 0.000000).lineTo(0.343750, 0.000000).lineTo(0.343750, 0.090461).lineTo(0.000000, 0.090461).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop7).extrude(-0.007812)
