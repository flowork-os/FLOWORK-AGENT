import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.687500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.018499, -0.044659), (0.063158, -0.063158)).lineTo(1.436842, -0.063158).threePointArc((1.481501, -0.044659), (1.500000, 0.000000)).lineTo(1.500000, 1.373684).threePointArc((1.481501, 1.418344), (1.436842, 1.436842)).lineTo(0.063158, 1.436842).threePointArc((0.018499, 1.418344), (0.000000, 1.373684)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.757895, 0.694737).circle(0.521053)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
