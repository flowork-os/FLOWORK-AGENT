wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.179688, 0.656250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.062171, 0.000000).threePointArc((0.145210, -0.034396), (0.179605, -0.117434)).lineTo(0.179605, -0.656250).lineTo(0.414474, -0.656250).lineTo(0.414474, -0.027632).threePointArc((0.380078, 0.055407), (0.297039, 0.089803)).lineTo(0.000000, 0.089803).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
