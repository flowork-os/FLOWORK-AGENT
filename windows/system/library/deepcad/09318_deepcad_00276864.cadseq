# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00276864" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.031250, 0.000000).lineTo(0.031250, 0.031250).lineTo(0.000000, 0.031250).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.015625, 0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.031250, 0.000000).lineTo(0.031250, 0.031250).lineTo(0.000000, 0.031250).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.029934, 0.001316).lineTo(0.029934, 0.029934).lineTo(0.001316, 0.029934).lineTo(0.001316, 0.001316).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.312500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.015625, 0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.031250, 0.000000).lineTo(0.031250, 0.031250).lineTo(0.000000, 0.031250).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.029934, 0.001316).lineTo(0.029934, 0.029934).lineTo(0.001316, 0.029934).lineTo(0.001316, 0.001316).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.312500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.015625, 0.703125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.031250, 0.000000).lineTo(0.031250, 0.031250).lineTo(0.000000, 0.031250).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch3.moveTo(0.029934, 0.001316).lineTo(0.029934, 0.029934).lineTo(0.001316, 0.029934).lineTo(0.001316, 0.001316).close()
solid3=wp_sketch3.add(loop5).add(loop6).extrude(0.312500)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
