# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, -0.601562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.514638, 0.000000).lineTo(0.514638, 0.159293).lineTo(0.722944, 0.159293).lineTo(0.722944, 0.355345).lineTo(0.992516, 0.355345).lineTo(0.992516, 0.600411).lineTo(1.164062, 0.600411).lineTo(1.164062, 0.784211).lineTo(0.000000, 0.784211).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
