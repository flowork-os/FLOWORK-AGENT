# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00226338" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.101562, 0.000000, -0.515625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.159868, 0.000000).lineTo(0.159868, 0.519572).lineTo(0.479605, 0.519572).lineTo(0.479605, 1.265625).lineTo(0.000000, 1.265625).lineTo(0.000000, 0.519572).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.343750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
