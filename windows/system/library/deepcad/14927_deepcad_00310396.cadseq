# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00310396" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.867188, 0.000000).lineTo(0.867188, 0.219079).lineTo(0.712007, 0.219079).lineTo(0.000000, 0.219079).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.421875, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.281250, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.157895, 0.000000).lineTo(0.157895, 0.098684).threePointArc((0.223089, 0.243819), (0.375000, 0.291118)).lineTo(0.424342, 0.286184).lineTo(0.424342, 0.434211).lineTo(0.468750, 0.434211).lineTo(0.394737, 0.444079).threePointArc((0.119546, 0.360322), (0.000000, 0.098684)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.171875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
