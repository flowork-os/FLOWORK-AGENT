# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.296875, -0.390625, 0.242188), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.028904, -0.069780), (0.098684, -0.098684)).lineTo(0.098684, -0.041118).threePointArc((0.057566, 0.000000), (0.098684, 0.041118)).lineTo(0.098684, 0.148026).lineTo(0.098684, 0.250822).threePointArc((0.055510, 0.293997), (0.098684, 0.337171)).lineTo(0.098684, 0.390625).threePointArc((0.028904, 0.361721), (0.000000, 0.291941)).lineTo(0.000000, 0.000000).close()
