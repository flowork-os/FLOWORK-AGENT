wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.049342, 0.000000).threePointArc((0.234375, 0.185033), (0.419408, 0.000000)).lineTo(0.468750, 0.000000).lineTo(0.468750, 0.123355).lineTo(0.468750, 0.542763).threePointArc((0.234375, 0.777138), (0.000000, 0.542763)).lineTo(0.000000, 0.123355).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.162777, 0.170769), (0.394737, 0.213816)).lineTo(0.394737, 0.542763).threePointArc((0.238487, 0.699013), (0.082237, 0.542763)).lineTo(0.082237, 0.213816).close()
