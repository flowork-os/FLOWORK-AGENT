# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382936" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, 0.000000, 0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.274589, -0.831192), (0.549178, 0.000000)).threePointArc((0.274589, 0.379896), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.278947, 0.252796).circle(0.095888)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.226562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
