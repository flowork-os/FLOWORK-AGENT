import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.058882, 0.000000).lineTo(1.058882, 0.365132).lineTo(0.766776, 0.450329).lineTo(0.766776, 0.693750).lineTo(1.022368, 0.851974).lineTo(1.022368, 1.156250).lineTo(0.742434, 1.156250).lineTo(0.486842, 0.791118).lineTo(0.097368, 0.791118).lineTo(0.000000, 0.511184).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
