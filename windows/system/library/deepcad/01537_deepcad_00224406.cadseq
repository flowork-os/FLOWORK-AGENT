# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00224406" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.000000, -0.703125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.375000, 0.000000).lineTo(1.375000, 0.694737).lineTo(0.810526, 0.998684).lineTo(0.622368, 0.998684).threePointArc((0.287497, 0.935574), (0.000000, 0.752632)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.318421, 0.665789).circle(0.188158)
loop2=wp_sketch0.moveTo(1.071053, 0.289474).circle(0.115789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.281250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
