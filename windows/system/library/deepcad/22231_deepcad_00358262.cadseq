# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00358262" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, -0.671875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.273438, -0.075670), (0.546875, 0.000000)).lineTo(0.546875, 1.039062).lineTo(0.000000, 1.039062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.273438, 0.678125).circle(0.087500)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.273438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
