# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322547" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.164062, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.585938, -0.154194).lineTo(0.246711, 0.308388).lineTo(0.135691, 0.185033).lineTo(0.018503, 0.462582).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.281250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.140625, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.026974, -0.121382).lineTo(0.283224, -0.094408).lineTo(0.320312, 0.077549).lineTo(0.138240, 0.195559).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.119390, -0.107361), (0.182072, 0.040461)).threePointArc((0.216835, 0.012975), (0.236020, -0.026974)).lineTo(0.262993, 0.053947).lineTo(0.182072, 0.080921).threePointArc((0.099855, 0.097293), (0.097780, 0.013487)).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.859375)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
