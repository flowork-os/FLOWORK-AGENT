# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00217505" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.473684, 0.000000).circle(0.473684)
solid0=wp_sketch0.add(loop0).extrude(-0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, -0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.429688, 0.000000).lineTo(0.429688, 0.420641).lineTo(0.000000, 0.420641).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.375000)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, -0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.429688, 0.000000).lineTo(0.429688, 0.420641).lineTo(0.000000, 0.420641).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.750000)
solid_temp=solid_temp.union(solid1)
solid=solid.union(solid_temp)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.210938, -0.289062, 0.210938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.005757, 0.000000).lineTo(0.005757, 0.109375).lineTo(0.000000, 0.109375).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.375000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, -0.289062, 0.210938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.351562, 0.000000).lineTo(0.351562, 0.111020).lineTo(0.000000, 0.111020).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.375000)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.588158, 0.000000).circle(0.588158)
loop5=wp_sketch4.moveTo(0.796464, -0.208306).lineTo(0.796464, 0.208306).lineTo(0.367599, 0.208306).lineTo(0.367599, -0.208306).close()
solid4=wp_sketch4.add(loop4).add(loop5).extrude(0.375000)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
