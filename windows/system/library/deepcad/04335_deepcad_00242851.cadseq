# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00242851" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.000000, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.250000, 0.000000).lineTo(1.250000, 0.157895).lineTo(0.973684, 0.157895).lineTo(0.973684, 0.447368).lineTo(0.815789, 0.447368).lineTo(0.815789, 0.263158).lineTo(0.434211, 0.263158).lineTo(0.434211, 0.447368).lineTo(0.276316, 0.447368).lineTo(0.276316, 0.157895).lineTo(0.000000, 0.157895).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.421875, -0.250000, -0.414062), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.202632, 0.000000).lineTo(0.202632, 0.250000).lineTo(0.000000, 0.250000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.156250)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.250000, -0.414062), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch2.moveTo(0.202632, 0.000000).lineTo(0.202632, 0.250000).lineTo(0.000000, 0.250000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.156250)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
