# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00308994" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.011513, 0.000000).lineTo(0.011513, 0.027138).lineTo(0.007812, 0.027138).lineTo(0.007812, 0.039062).lineTo(0.000000, 0.039062).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.109375, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.011513, 0.000000).lineTo(0.011513, 0.039062).lineTo(0.003701, 0.039062).lineTo(0.003701, 0.027138).lineTo(0.000000, 0.027138).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.023438, 0.742188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.226562, 0.000000).lineTo(0.226562, 0.009539).lineTo(0.000000, 0.009539).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.039062)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, -0.023438, 0.742188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.002632, 0.000000).lineTo(0.002632, 0.007812).lineTo(0.000000, 0.007812).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.039062)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
