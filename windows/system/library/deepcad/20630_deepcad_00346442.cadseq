import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, -0.750822).lineTo(0.655263, -1.119408).lineTo(1.296875, -0.750822).lineTo(1.296875, 0.000000).lineTo(0.641612, 0.368586).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.245724, -0.600658).lineTo(0.655263, -0.832730).lineTo(1.051151, -0.600658).lineTo(1.051151, -0.150164).lineTo(0.641612, 0.081908).lineTo(0.245724, -0.150164).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.375000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
