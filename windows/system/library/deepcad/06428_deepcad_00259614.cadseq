# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00259614" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, -0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.281250, 0.000000).lineTo(0.281250, 0.281250).lineTo(0.000000, 0.281250).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.263487, 0.017763).lineTo(0.263487, 0.263487).lineTo(0.017763, 0.263487).lineTo(0.017763, 0.017763).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.125000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.027632, 0.000000).lineTo(0.027632, 0.065132).lineTo(0.027632, 0.093750).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.140625, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.031250, 0.187500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.187500, 0.000000).lineTo(0.187500, 0.027632).lineTo(0.000000, 0.027632).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.140625, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.218750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.027632, 0.000000).lineTo(0.027632, 0.027632).lineTo(0.027632, 0.093750).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.140625, both=True)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.031250, -0.218750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.187500, 0.000000).lineTo(0.187500, 0.027632).lineTo(0.000000, 0.027632).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(0.140625, both=True)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
