# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00372875" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.250000, -0.250000).lineTo(1.171875, -0.250000).lineTo(1.484375, -0.031250).lineTo(1.484375, 0.390625).lineTo(1.359375, 0.390625).lineTo(1.359375, 0.031250).lineTo(1.234375, -0.046875).lineTo(0.734375, -0.046875).lineTo(0.234375, -0.046875).lineTo(0.125000, 0.046875).lineTo(0.125000, 0.421875).lineTo(0.000000, 0.421875).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.328125, -0.156250).circle(0.046875)
loop2=wp_sketch0.moveTo(1.140625, -0.156250).circle(0.046875)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.070312, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, 0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.143092, -0.143092).lineTo(1.201974, -0.143092).lineTo(1.359375, -0.028618).lineTo(1.359375, 0.586678).lineTo(1.302138, 0.586678).lineTo(1.302138, 0.000000).lineTo(1.173355, -0.085855).lineTo(0.171711, -0.085855).lineTo(0.057237, 0.028618).lineTo(0.057237, 0.586678).lineTo(0.000000, 0.586678).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.023438, both=True)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
