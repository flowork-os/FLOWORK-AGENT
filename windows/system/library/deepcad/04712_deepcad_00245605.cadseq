# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00245605" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.402632).lineTo(0.000000, 0.402632).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.062500, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.367188, 0.000000).lineTo(0.367188, 0.286020).lineTo(0.000000, 0.286020).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.367188, 0.062500, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.382813, 0.000000).lineTo(0.382813, 0.282072).lineTo(0.000000, 0.282072).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.226562)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.140625, 0.203125, 0.164062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.063158, 0.000000).circle(0.061842)
solid3=wp_sketch3.add(loop3).extrude(-0.164062)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.453125, 0.203125, 0.304688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.102632, 0.000000).circle(0.102632)
solid4=wp_sketch4.add(loop4).extrude(-0.078125)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.500000, 0.203125, 0.226562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch5.moveTo(0.063158, 0.000000).circle(0.061842)
solid5=wp_sketch5.add(loop5).extrude(-0.328125)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
