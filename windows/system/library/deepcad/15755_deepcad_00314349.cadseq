# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00314349" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.109375, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.188651, 0.000000).threePointArc((-0.433966, 0.147862), (0.188651, 0.295724)).lineTo(0.000000, 0.295724).threePointArc((-0.293751, 0.147862), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.055263, 0.000000).lineTo(0.055263, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.078125, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, 0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.240543, -0.240543).lineTo(0.240543, 0.507812).lineTo(0.000000, 0.267270).threePointArc((-0.055353, 0.133635), (0.000000, 0.000000)).close()
loop3=wp_sketch2.moveTo(0.133635, 0.133635).circle(0.074836)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.078125, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
