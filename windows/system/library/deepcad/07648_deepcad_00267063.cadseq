# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267063" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.228947).lineTo(0.000000, 0.228947).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.031250, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.023684).lineTo(0.000000, 0.023684).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.218750, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch2.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.023684).lineTo(0.000000, 0.023684).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.007812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
