# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00227201" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.126316, 0.126316).circle(0.063158)
loop2=wp_sketch0.moveTo(0.126316, 1.389474).circle(0.063158)
loop3=wp_sketch0.moveTo(1.389474, 0.126316).circle(0.063158)
loop4=wp_sketch0.moveTo(1.389474, 1.389474).circle(0.063158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.296875, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop5=wp_sketch1.moveTo(0.593750, 0.000000).lineTo(0.593750, 0.593750).lineTo(0.000000, 0.593750).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch1.moveTo(0.300000, 0.300000).circle(0.200000)
solid1=wp_sketch1.add(loop5).add(loop6).extrude(0.195312)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
