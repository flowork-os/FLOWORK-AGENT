wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.390625, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002023, -0.004885), (0.006908, -0.006908)).lineTo(0.020230, -0.006908).threePointArc((0.024868, -0.004782), (0.026645, 0.000000)).lineTo(0.026645, 0.039967).threePointArc((0.024868, 0.044750), (0.020230, 0.046875)).lineTo(0.006908, 0.046875).threePointArc((0.002023, 0.044852), (0.000000, 0.039967)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002739, -0.003158), (0.006908, -0.003454)).lineTo(0.020230, -0.003454).threePointArc((0.022673, -0.002442), (0.023684, 0.000000)).lineTo(0.023684, 0.039967).threePointArc((0.022673, 0.042409), (0.020230, 0.043421)).lineTo(0.006908, 0.043421).threePointArc((0.004466, 0.042409), (0.003454, 0.039967)).lineTo(0.003454, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.750000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.003454, 0.000000).threePointArc((0.003750, -0.004169), (0.006908, -0.006908)).lineTo(0.020230, -0.006908).threePointArc((0.024868, -0.004782), (0.026645, 0.000000)).lineTo(0.026645, 0.039967).threePointArc((0.024868, 0.044750), (0.020230, 0.046875)).lineTo(0.006908, 0.046875).threePointArc((0.002023, 0.044852), (0.000000, 0.039967)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.002739, -0.003158), (0.006908, -0.003454)).lineTo(0.020230, -0.003454).threePointArc((0.022673, -0.002442), (0.023684, 0.000000)).lineTo(0.023684, 0.039967).threePointArc((0.022673, 0.042409), (0.020230, 0.043421)).lineTo(0.006908, 0.043421).threePointArc((0.004466, 0.042409), (0.003454, 0.039967)).lineTo(0.003454, 0.000000).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.750000, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.101562, -0.046875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.019737, 0.000000).circle(0.019326)
solid2=wp_sketch2.add(loop4).extrude(0.554688, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
