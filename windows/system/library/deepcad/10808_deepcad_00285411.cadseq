# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.007322, -0.017678), (0.025000, -0.025000)).lineTo(1.162500, -0.025000).threePointArc((1.180178, -0.017678), (1.187500, 0.000000)).lineTo(1.187500, 0.550000).threePointArc((1.182767, 0.573928), (1.162500, 0.587500)).lineTo(0.025000, 0.587500).threePointArc((0.004733, 0.573928), (0.000000, 0.550000)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
