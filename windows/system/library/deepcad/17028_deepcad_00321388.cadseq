import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.648438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.252632, -0.434211).threePointArc((0.375000, -0.401154), (0.497368, -0.434211)).lineTo(0.750000, 0.000000).threePointArc((0.375000, 0.101303), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.378947, -0.173684).circle(0.197368)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.100120, -0.374926), (0.375411, -0.648438)).lineTo(0.627961, -0.211595).threePointArc((0.537949, -0.122393), (0.505099, 0.000000)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.341283, -0.238898).circle(0.197944)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.125000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.125000, 0.000000, -0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.250000, -0.434211).threePointArc((0.524585, -0.162494), (0.625000, 0.210526)).lineTo(0.125000, 0.210526).threePointArc((0.090936, 0.088379), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.289474, -0.026316).circle(0.197368)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.125000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.248684, 0.000000).circle(0.248684)
loop7=wp_sketch3.moveTo(0.248684, 0.000000).circle(0.202056)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.125000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
