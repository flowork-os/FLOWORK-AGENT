# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257654" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.554688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.900000, 0.000000).threePointArc((1.125000, 0.225000), (0.900000, 0.450000)).lineTo(0.603947, 0.450000).lineTo(0.603947, 0.378947).lineTo(0.296053, 0.378947).lineTo(0.296053, 0.450000).lineTo(0.000000, 0.450000).threePointArc((-0.225000, 0.225000), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.225000).circle(0.094737)
loop2=wp_sketch0.moveTo(0.900000, 0.225000).circle(0.094737)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.375000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
