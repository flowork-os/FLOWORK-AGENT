# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00329397" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.430181, 0.000000).threePointArc((1.468627, 0.038446), (1.430181, 0.076891)).lineTo(0.000000, 0.076891).threePointArc((-0.038446, 0.038446), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.030757).circle(0.015378)
loop2=wp_sketch0.moveTo(0.707401, 0.030757).circle(0.015378)
loop3=wp_sketch0.moveTo(1.430181, 0.030757).circle(0.015378)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
