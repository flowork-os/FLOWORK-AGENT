# workplane for sketch 6
wp_sketch6 = cq.Workplane(cq.Plane(cq.Vector(0.054688, -0.007812, -0.750000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
