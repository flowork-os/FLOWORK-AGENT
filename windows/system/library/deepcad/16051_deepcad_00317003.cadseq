# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00317003" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.011842, 0.000000).circle(0.011842)
loop1=wp_sketch0.moveTo(0.011842, 0.000000).circle(0.009868)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.703125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.011842, 0.000000).circle(0.011842)
loop3=wp_sketch1.moveTo(0.011842, 0.000000).circle(0.009868)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.664062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.011842, 0.000000).circle(0.011842)
loop5=wp_sketch2.moveTo(0.011842, 0.000000).circle(0.009868)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.750000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.011842, 0.000000).circle(0.011842)
loop7=wp_sketch3.moveTo(0.011842, 0.000000).circle(0.009868)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.570312)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
