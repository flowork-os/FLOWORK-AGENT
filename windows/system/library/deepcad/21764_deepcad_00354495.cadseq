import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.273438, 0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.036842, 0.000000).lineTo(0.036842, -0.069079).lineTo(0.138158, -0.069079).lineTo(0.138158, 0.036842).lineTo(0.437500, 0.036842).lineTo(0.437500, 0.128947).threePointArc((0.218173, 0.181439), (0.000000, 0.124342)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
