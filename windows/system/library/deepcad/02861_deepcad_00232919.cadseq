# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232919" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.032977, 0.000000).lineTo(1.032977, 0.313816).lineTo(1.242188, 0.313816).lineTo(1.242188, 0.823766).lineTo(0.313816, 0.823766).lineTo(0.313816, 0.627632).lineTo(0.000000, 0.627632).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.196135, 0.248438).circle(0.104605)
loop2=wp_sketch0.moveTo(0.862993, 0.196135).circle(0.078454)
loop3=wp_sketch0.moveTo(1.019901, 0.666859).circle(0.130757)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
