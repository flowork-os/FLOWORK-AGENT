# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00237194" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.046875, -0.004934).threePointArc((0.023559, -0.001316), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.445312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.153947, 0.000000).circle(0.150740)
loop2=wp_sketch1.moveTo(0.153947, 0.000000).circle(0.096217)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.375000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.023438, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.593750, 0.062500).threePointArc((0.424803, 0.215625), (0.593750, 0.368750)).lineTo(0.018750, 0.425000).threePointArc((0.190417, 0.204513), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.375000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((-0.023419, -0.462603), (0.045230, -0.004523)).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch3.moveTo(0.000000, -0.217105).circle(0.158306)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.375000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
