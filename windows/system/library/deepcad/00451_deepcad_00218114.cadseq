wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.640625, -0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.045903, 0.008674), (0.087829, 0.029276)).lineTo(1.200329, 0.029276).threePointArc((1.242255, 0.008674), (1.288158, 0.000000)).threePointArc((1.391518, 0.058553), (1.288158, 0.117105)).threePointArc((1.242255, 0.108431), (1.200329, 0.087829)).lineTo(0.087829, 0.087829).threePointArc((0.045903, 0.108431), (0.000000, 0.117105)).threePointArc((-0.103360, 0.058553), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.029276, 0.058553).circle(0.029276)
loop2=wp_sketch0.moveTo(1.317434, 0.058553).circle(0.029276)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.085938)
