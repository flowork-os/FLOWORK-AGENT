# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00388144" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.059211, 0.000000).lineTo(0.027138, -0.053043).lineTo(0.082648, 0.000000).lineTo(0.082648, -0.033306).lineTo(0.115954, 0.027138).lineTo(0.117188, 0.046875).lineTo(0.090049, 0.069079).lineTo(0.090049, 0.046875).lineTo(0.040707, 0.086349).lineTo(0.059211, 0.046875).lineTo(0.000000, 0.046875).lineTo(0.059211, 0.025905).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.039062, 0.000000).lineTo(0.039062, 0.017681).lineTo(0.001234, 0.017681).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
