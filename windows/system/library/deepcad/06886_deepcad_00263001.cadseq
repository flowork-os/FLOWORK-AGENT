# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00263001" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.000000, 0.546875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.010033, -0.010033).threePointArc((0.227510, 0.119706), (0.476562, 0.165543)).lineTo(0.476562, 0.170559).threePointArc((0.474054, 0.173067), (0.476562, 0.175576)).lineTo(0.476562, 0.180592).threePointArc((0.222042, 0.133149), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, -0.679688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.961457, 0.553590), (0.251645, 1.406250)).threePointArc((0.244243, 1.398849), (0.251645, 1.391447)).threePointArc((0.954129, 0.551714), (0.000000, 0.014803)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.754934, 1.184211).circle(0.014803)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
