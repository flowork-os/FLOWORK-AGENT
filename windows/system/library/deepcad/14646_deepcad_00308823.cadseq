loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000963, -0.002326), (0.003289, -0.003289)).lineTo(0.074836, -0.003289).threePointArc((0.077162, -0.002326), (0.078125, 0.000000)).lineTo(0.078125, 0.071546).threePointArc((0.077162, 0.073872), (0.074836, 0.074836)).lineTo(0.003289, 0.074836).threePointArc((0.000963, 0.073872), (0.000000, 0.071546)).lineTo(0.000000, 0.000000).close()
