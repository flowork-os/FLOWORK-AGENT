import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.390625, 0.000000).lineTo(0.390625, 0.238487).lineTo(0.000000, 0.238487).lineTo(0.000000, 0.197368).lineTo(0.152138, 0.197368).lineTo(0.152138, 0.090461).threePointArc((0.138891, 0.058478), (0.106908, 0.045230)).lineTo(0.000000, 0.045230).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
