loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.005363, 0.110905), (0.030839, 0.215872)).threePointArc((0.056049, 0.382903), (0.222039, 0.351562)).threePointArc((0.517640, 0.248970), (0.555099, -0.061678)).threePointArc((0.545655, -0.231562), (0.376234, -0.215872)).threePointArc((0.256435, -0.228345), (0.141859, -0.191201)).threePointArc((-0.028257, -0.169190), (0.000000, 0.000000)).close()
