# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.109112, -0.263421), (0.372533, -0.372533)).lineTo(0.956168, -0.372533).threePointArc((1.114220, -0.307065), (1.179688, -0.149013)).lineTo(1.179688, 1.130016).lineTo(0.757484, 1.130016).threePointArc((0.221862, 0.908155), (0.000000, 0.372533)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.132812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
