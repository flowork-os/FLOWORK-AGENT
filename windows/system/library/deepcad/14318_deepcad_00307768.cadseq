# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00307768" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.857566, 0.000000).lineTo(0.857566, 0.532730).threePointArc((0.428783, 1.238258), (0.000000, 0.532730)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.428783, 0.753618).circle(0.129934)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.726562, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
