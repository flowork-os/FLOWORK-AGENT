# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00349936" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.030428, -0.006086).lineTo(0.237336, 0.565954).threePointArc((0.223876, 0.569463), (0.212993, 0.578125)).lineTo(0.206908, 0.578125).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.210938, 0.695312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.010831, -0.006675), (0.023438, -0.008388)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.039062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.210938, 0.695312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.024178, -0.008635).threePointArc((0.032483, 0.052786), (0.000000, 0.000000)).close()
loop3=wp_sketch2.moveTo(0.021875, 0.023026).circle(0.014967)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.039062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.304688, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.307895, 0.000000).circle(0.307895)
loop5=wp_sketch3.moveTo(0.307895, 0.000000).circle(0.192434)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.046875)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.064063, 0.000000).lineTo(0.050000, 0.014063).lineTo(0.114063, 0.106250).lineTo(0.114063, 0.148438).lineTo(0.079688, 0.148438).lineTo(0.079688, 0.106250).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(0.054688, both=True)
solid=solid.union(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.109375, 0.054688, 0.242188), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop7=wp_sketch5.moveTo(0.011842, 0.000000).circle(0.011595)
solid5=wp_sketch5.add(loop7).extrude(-0.132812)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
