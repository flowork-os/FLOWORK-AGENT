import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.882812, 0.000000).lineTo(0.882812, 0.111513).lineTo(0.576151, 0.111513).lineTo(0.576151, 0.808470).lineTo(0.427467, 0.808470).lineTo(0.427467, 0.111513).lineTo(0.000000, 0.111513).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.501809, 0.065049).lineTo(0.501809, 0.009293).lineTo(0.538980, 0.009293).lineTo(0.538980, 0.065049).lineTo(0.548273, 0.065049).threePointArc((0.520395, 0.114973), (0.492516, 0.065049)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
