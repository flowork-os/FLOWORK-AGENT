import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, -0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.265625, 0.000000).lineTo(0.265625, 0.134211).lineTo(0.000000, 0.134211).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.089474, 0.041941).lineTo(0.089474, 0.089474).lineTo(0.041941, 0.089474).lineTo(0.041941, 0.041941).close()
loop2=wp_sketch0.moveTo(0.223684, 0.041941).lineTo(0.223684, 0.089474).lineTo(0.176151, 0.089474).lineTo(0.176151, 0.041941).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.484375, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.260526, 0.000000).lineTo(0.260526, 0.281250).lineTo(0.000000, 0.281250).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.088816, 0.074013).lineTo(0.088816, 0.121382).lineTo(0.041447, 0.121382).lineTo(0.041447, 0.074013).close()
loop5=wp_sketch1.moveTo(0.088816, 0.192434).lineTo(0.088816, 0.239803).lineTo(0.041447, 0.239803).lineTo(0.041447, 0.192434).close()
loop6=wp_sketch1.moveTo(0.219079, 0.074013).lineTo(0.219079, 0.121382).lineTo(0.171711, 0.121382).lineTo(0.171711, 0.074013).close()
loop7=wp_sketch1.moveTo(0.219079, 0.192434).lineTo(0.219079, 0.239803).lineTo(0.171711, 0.239803).lineTo(0.171711, 0.192434).close()
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).add(loop6).add(loop7).extrude(0.031250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
