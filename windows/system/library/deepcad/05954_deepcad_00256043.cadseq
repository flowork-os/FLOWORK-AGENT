# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00256043" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.006186, -0.201581), (0.195395, -0.195395)).threePointArc((0.422509, -0.087525), (0.657237, -0.177632)).threePointArc((0.808224, -0.177632), (0.808224, -0.026645)).threePointArc((0.407449, 0.087902), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.088816, -0.106579).circle(0.071053)
loop2=wp_sketch0.moveTo(0.737171, -0.106579).circle(0.044408)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.148438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
