# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00241706" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, -0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.209704, 0.000000).lineTo(0.209704, 0.167763).lineTo(0.000000, 0.167763).threePointArc((-0.164268, 0.332031), (0.000000, 0.496299)).lineTo(0.209704, 0.496299).lineTo(0.209704, 0.664062).lineTo(0.000000, 0.664062).threePointArc((-0.332031, 0.332031), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.414062, 0.000000).lineTo(0.414062, 0.165625).lineTo(0.000000, 0.165625).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.164062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.210938, -0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.209704, 0.000000).threePointArc((0.541735, 0.332031), (0.209704, 0.664062)).lineTo(0.000000, 0.664062).lineTo(0.000000, 0.496299).lineTo(0.209704, 0.496299).threePointArc((0.373972, 0.332031), (0.209704, 0.167763)).lineTo(0.000000, 0.167763).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.164062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
