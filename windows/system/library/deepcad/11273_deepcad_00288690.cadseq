wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, -0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.671875, 0.000000).lineTo(0.671875, 0.049507).lineTo(0.049507, 0.049507).lineTo(0.049507, 0.396053).threePointArc((0.078507, 0.466066), (0.148520, 0.495066)).lineTo(0.671875, 0.495066).lineTo(0.671875, 0.544572).lineTo(0.000000, 0.544572).lineTo(0.000000, 0.000000).close()
