import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.140625, 0.000000, 0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000987, -0.015625).threePointArc((0.000733, -0.007797), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000987, 0.015625).threePointArc((0.000254, 0.007828), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.070312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.146053, -0.146053), (0.292105, 0.000000)).lineTo(0.284211, 0.015789).lineTo(0.244737, 0.655263).threePointArc((0.146053, 0.748071), (0.047368, 0.655263)).lineTo(0.000000, 0.015789).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.142105, 0.268421).circle(0.023684)
loop4=wp_sketch2.moveTo(0.142105, 0.394737).circle(0.023684)
loop5=wp_sketch2.moveTo(0.142105, 0.521053).circle(0.023684)
loop6=wp_sketch2.moveTo(0.142105, 0.639474).circle(0.023684)
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).extrude(0.070312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch3.moveTo(0.142105, 0.000000).circle(0.142105)
loop8=wp_sketch3.moveTo(0.142105, 0.000000).circle(0.085855)
solid3=wp_sketch3.add(loop7).add(loop8).extrude(0.117188)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.000000, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop9=wp_sketch4.moveTo(0.078947, 0.000000).circle(0.078947)
solid4=wp_sketch4.add(loop9).extrude(-0.031250)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
