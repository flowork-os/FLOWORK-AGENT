# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00298617" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.000000, -0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.476562, 0.000000).lineTo(1.476562, 1.150164).lineTo(0.000000, 1.150164).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.461020, 0.015543).lineTo(1.461020, 1.134622).lineTo(0.015543, 1.134622).lineTo(0.015543, 0.015543).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.000000, -0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(1.476562, 0.000000).lineTo(1.476562, 1.150164).lineTo(0.000000, 1.150164).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(1.414391, 0.046628).lineTo(1.414391, 1.103536).lineTo(0.062171, 1.103536).lineTo(0.062171, 0.046628).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.078125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
