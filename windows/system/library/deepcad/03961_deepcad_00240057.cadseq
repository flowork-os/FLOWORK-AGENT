# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00240057" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.130263, -0.130263), (0.260526, 0.000000)).lineTo(0.260526, 0.623684).threePointArc((0.130263, 0.753947), (0.000000, 0.623684)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.126316, 0.000000).circle(0.063158)
loop2=wp_sketch0.moveTo(0.126316, 0.623684).circle(0.063158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.132812, 0.000000, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.128906, -0.128906), (0.257812, 0.000000)).lineTo(0.257812, 0.002714).threePointArc((0.128906, 0.130048), (0.000000, 0.002714)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.130263, 0.000000).circle(0.065132)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.304688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
