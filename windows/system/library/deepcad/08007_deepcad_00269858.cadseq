loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.047041, -0.113567), (0.160609, -0.160609)).lineTo(0.244737, -0.160609).threePointArc((0.358304, -0.113567), (0.405345, 0.000000)).lineTo(0.405345, 0.565954).threePointArc((0.358304, 0.679521), (0.244737, 0.726562)).lineTo(0.160609, 0.726562).threePointArc((0.047041, 0.679521), (0.000000, 0.565954)).lineTo(0.000000, 0.000000).close()
