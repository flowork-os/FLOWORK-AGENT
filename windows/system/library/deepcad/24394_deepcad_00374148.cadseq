# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.142105, 0.000000).threePointArc((0.425889, 0.105262), (0.726316, 0.142105)).lineTo(0.757895, 0.142105).lineTo(0.773684, 0.142105).threePointArc((1.074111, 0.105262), (1.357895, 0.000000)).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.236842).lineTo(0.000000, 0.236842).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
