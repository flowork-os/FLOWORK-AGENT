# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382430" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.629605, 0.000000).lineTo(0.629605, 0.753618).lineTo(0.505592, 0.906250).lineTo(0.162171, 0.906250).lineTo(0.000000, 0.753618).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.314803, 0.629605).circle(0.104934)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.343750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
