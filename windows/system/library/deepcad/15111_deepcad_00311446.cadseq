loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.024237, -0.003131), (0.046875, -0.012336)).lineTo(0.000000, 0.014309).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.039062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.648438, -0.101562, 0.218750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.097656, 0.097656), (0.000000, 0.195312)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.039062)
