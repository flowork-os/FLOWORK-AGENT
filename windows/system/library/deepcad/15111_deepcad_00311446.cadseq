# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.296875, -0.148438, 0.218750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.049204, -0.085704), (0.148026, -0.086349)).lineTo(0.353618, 0.032895).lineTo(0.353618, 0.049342).lineTo(0.353618, 0.242599).lineTo(0.353618, 0.259046).lineTo(0.148026, 0.378289).threePointArc((0.049204, 0.377645), (0.000000, 0.291941)).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(0.039062)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
