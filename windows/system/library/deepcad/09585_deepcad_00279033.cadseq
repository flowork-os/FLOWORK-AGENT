import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.010959, -0.026458), (0.037418, -0.037418)).lineTo(0.112253, -0.037418).threePointArc((0.138712, -0.026458), (0.149671, 0.000000)).lineTo(0.149671, 0.673520).threePointArc((0.138712, 0.699978), (0.112253, 0.710938)).lineTo(0.037418, 0.710938).threePointArc((0.010959, 0.699978), (0.000000, 0.673520)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.074836, 0.037418).circle(0.007484)
loop2=wp_sketch0.moveTo(0.074836, 0.269408).circle(0.007484)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
