# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.023438, -0.007812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000361, -0.000872), (0.001234, -0.001234)).lineTo(0.037829, -0.001234).threePointArc((0.038701, -0.000872), (0.039062, 0.000000)).lineTo(0.039062, 0.017270).threePointArc((0.038701, 0.018142), (0.037829, 0.018503)).lineTo(0.001234, 0.018503).threePointArc((0.000361, 0.018142), (0.000000, 0.017270)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.037829, 0.000000).lineTo(0.037829, 0.017270).lineTo(0.001234, 0.017270).lineTo(0.001234, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
