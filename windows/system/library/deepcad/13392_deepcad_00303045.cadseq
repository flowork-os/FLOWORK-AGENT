wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.000000, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.024857, -0.060011), (0.084868, -0.084868)).lineTo(0.251069, -0.084868).threePointArc((0.311080, -0.060011), (0.335938, 0.000000)).lineTo(0.335938, 0.169737).threePointArc((0.310348, 0.227980), (0.251069, 0.251069)).lineTo(0.084868, 0.251069).threePointArc((0.025590, 0.227980), (0.000000, 0.169737)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.033646, -0.038794), (0.084868, -0.042434)).lineTo(0.251069, -0.042434).threePointArc((0.281075, -0.030006), (0.293503, 0.000000)).lineTo(0.293503, 0.169737).threePointArc((0.280342, 0.197974), (0.251069, 0.208635)).lineTo(0.084868, 0.208635).threePointArc((0.055595, 0.197974), (0.042434, 0.169737)).lineTo(0.042434, 0.000000).close()
