# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257851" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.351562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.024292, -0.054727), (0.080921, -0.074178)).lineTo(0.640625, 0.013487).lineTo(0.640625, 0.418092).lineTo(0.438322, 0.532730).lineTo(0.000000, 0.377632).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.197368, -0.197368).lineTo(0.197368, -0.402632).lineTo(0.544737, -0.402632).lineTo(0.544737, -0.118421).lineTo(0.750000, -0.039474).lineTo(0.544737, 0.197368).lineTo(0.197368, 0.197368).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.156250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
