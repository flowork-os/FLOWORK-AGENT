# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00311560" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.110279, -0.407482), (0.197368, -0.118421)).lineTo(0.750000, -0.118421).lineTo(0.750000, 0.039474).lineTo(0.307895, 0.039474).lineTo(0.307895, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, -0.213158).circle(0.142105)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.476562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
