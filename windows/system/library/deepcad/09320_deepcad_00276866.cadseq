# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00276866" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.453289, 0.000000).lineTo(0.828125, 0.000000).lineTo(0.828125, 0.226645).lineTo(0.828125, 0.305099).lineTo(0.679934, 0.601480).lineTo(0.148191, 0.601480).lineTo(0.000000, 0.601480).lineTo(0.000000, 0.374836).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.148191, 0.374836).circle(0.078454)
loop2=wp_sketch0.moveTo(0.453289, 0.226645).circle(0.148191)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.375000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
