# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00349012" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.245313, 0.000000).lineTo(0.426069, 0.167845).lineTo(0.800493, 0.167845).lineTo(0.981250, 0.000000).lineTo(1.226562, 0.000000).lineTo(1.226562, 0.051645).lineTo(0.994161, 0.051645).lineTo(0.813405, 0.219490).lineTo(0.413158, 0.219490).lineTo(0.232401, 0.051645).lineTo(0.000000, 0.051645).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.250000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
