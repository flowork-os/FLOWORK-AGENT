# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00359178" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, -0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.031250, 0.000000).lineTo(1.031250, 0.108553).lineTo(0.618750, 0.108553).threePointArc((0.475157, 0.163534), (0.412500, 0.303947)).lineTo(0.412500, 0.618750).threePointArc((0.206250, 0.825000), (0.000000, 0.618750)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.206250, 0.618750).circle(0.108553)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.617188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
