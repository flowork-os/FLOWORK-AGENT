# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.143750, 0.000000).threePointArc((0.152455, -0.005664), (0.162664, -0.007566)).lineTo(0.249671, -0.098355).threePointArc((0.293565, -0.102725), (0.306414, -0.060526)).threePointArc((0.269544, 0.124836), (0.306414, 0.310197)).threePointArc((0.296586, 0.352197), (0.253454, 0.351809)).lineTo(0.000000, 0.124836).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.276151, -0.071875).circle(0.015132)
loop2=wp_sketch0.moveTo(0.276151, 0.325329).circle(0.015132)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
solid=solid0

