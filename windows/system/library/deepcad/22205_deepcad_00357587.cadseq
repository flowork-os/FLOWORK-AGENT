# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.023438, 0.000000).lineTo(0.023438, 0.001234).threePointArc((0.023221, 0.001757), (0.022697, 0.001974)).lineTo(0.005921, 0.001974).threePointArc((0.003130, 0.003130), (0.001974, 0.005921)).lineTo(0.001974, 0.022697).threePointArc((0.001757, 0.023221), (0.001234, 0.023438)).lineTo(0.000000, 0.023438).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
