solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.671875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, -0.250000, 0.718750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(1.289062, 0.000000).lineTo(1.289062, 0.678454).lineTo(0.000000, 0.678454).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(1.261924, 0.027138).lineTo(1.261924, 0.651316).lineTo(0.027138, 0.651316).lineTo(0.027138, 0.027138).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.015625, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.210938, 0.718750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(1.210938, 0.000000).lineTo(1.210938, 0.599095).lineTo(0.000000, 0.599095).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(-0.015625, both=True)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, -0.218750, 0.718750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch4.moveTo(1.226562, 0.000000).lineTo(1.226562, 0.619737).lineTo(0.000000, 0.619737).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch4.moveTo(1.213651, 0.012911).lineTo(1.213651, 0.606826).lineTo(0.012911, 0.606826).lineTo(0.012911, 0.012911).close()
solid4=wp_sketch4.add(loop6).add(loop7).extrude(-0.015625, both=True)
