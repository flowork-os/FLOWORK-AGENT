# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00227579" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.131743, 0.000000).threePointArc((0.103389, 0.067819), (0.093257, 0.140625)).lineTo(0.000000, 0.140625).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.281250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.375000, 0.000000).lineTo(0.375000, 0.375000).lineTo(0.280263, 0.375000).threePointArc((0.198176, 0.176824), (0.000000, 0.094737)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.280263, 0.094737).circle(0.047368)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.281250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.375000, 0.000000).lineTo(0.375000, 0.094737).threePointArc((0.233970, 0.130759), (0.130263, 0.232895)).lineTo(0.000000, 0.232895).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.094737, 0.094737).circle(0.047368)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.281250)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.375000, 0.000000).lineTo(0.375000, 0.094737).threePointArc((0.233970, 0.130759), (0.130263, 0.232895)).lineTo(0.000000, 0.232895).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch3.moveTo(0.094737, 0.094737).circle(0.047368)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(0.375000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
