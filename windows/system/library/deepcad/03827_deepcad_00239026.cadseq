# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239026" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, -0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.632812, 0.000000).lineTo(0.632812, 0.099918).lineTo(0.632812, 0.173191).threePointArc((0.607449, 0.234423), (0.546217, 0.259786)).lineTo(0.459622, 0.259786).threePointArc((0.440781, 0.251982), (0.432977, 0.233141)).lineTo(0.432977, 0.173191).lineTo(0.259786, 0.173191).threePointArc((0.240946, 0.180995), (0.233141, 0.199836)).lineTo(0.233141, 0.259786).threePointArc((0.207778, 0.321018), (0.146546, 0.346382)).lineTo(0.026645, 0.346382).threePointArc((0.007804, 0.338578), (0.000000, 0.319737)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.320312, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.126645, 0.000000).lineTo(0.370888, 0.000000).threePointArc((0.412466, 0.017222), (0.429688, 0.058799)).lineTo(0.429688, 0.343750).lineTo(0.000000, 0.171875).lineTo(0.000000, 0.113076).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.126645, 0.113076).circle(0.085938)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.140625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
