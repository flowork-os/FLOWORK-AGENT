# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.828125, 0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.814145, 0.000000).threePointArc((0.838215, 0.005407), (0.859375, 0.018092)).lineTo(0.859375, 0.036184).lineTo(0.859375, 0.081414).threePointArc((0.846127, 0.049432), (0.814145, 0.036184)).lineTo(0.000000, 0.036184).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.531250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.468750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.145395, 0.000000).threePointArc((0.180795, -0.012892), (0.196711, -0.047039)).lineTo(0.196711, -0.342105).lineTo(0.196711, -0.389145).lineTo(0.196711, -0.406250).threePointArc((0.219294, -0.377732), (0.226645, -0.342105)).lineTo(0.226645, -0.047039).threePointArc((0.202847, 0.010413), (0.145395, 0.034211)).lineTo(0.000000, 0.034211).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.531250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.078125, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.079441, 0.000000).lineTo(0.079441, 0.527714).lineTo(0.000000, 0.527714).threePointArc((0.355770, 0.263857), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(-0.203125)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.078125, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.083882, 0.000000).lineTo(0.083882, 0.531250).lineTo(0.000000, 0.531250).threePointArc((-0.197001, 0.265625), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(-0.203125)
