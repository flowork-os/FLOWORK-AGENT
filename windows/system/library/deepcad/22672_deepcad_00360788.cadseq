# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.197368).lineTo(0.000000, 0.197368).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.056221, -0.009414), (0.102632, 0.023684)).lineTo(0.647368, 0.023684).threePointArc((0.686445, 0.039870), (0.702632, 0.078947)).lineTo(0.702632, 0.126316).threePointArc((0.684810, 0.161445), (0.647368, 0.173684)).lineTo(0.102632, 0.173684).threePointArc((0.065190, 0.161445), (0.047368, 0.126316)).lineTo(0.047368, 0.078947).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
