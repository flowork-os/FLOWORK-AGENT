# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322640" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, -0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.343914, 0.053947).lineTo(0.242763, -0.586678).lineTo(0.640625, -0.586678).lineTo(0.640625, -0.472039).lineTo(0.188816, 0.505757).lineTo(0.000000, 0.505757).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.405839, 0.000000).lineTo(0.301480, 0.649342).lineTo(0.649342, 0.591365).lineTo(0.649342, 1.101562).lineTo(0.452220, 1.101562).lineTo(0.000000, 0.115954).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.156250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.109375, 0.351562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.078125, 0.000000).lineTo(0.078125, 0.078125).lineTo(0.000000, 0.078125).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.078125)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.531250, -0.109375, 0.351562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.078125, 0.000000).lineTo(0.078125, 0.078125).lineTo(0.000000, 0.078125).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.078125)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
