# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00313652" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.374836, 0.000000).lineTo(0.374836, 0.414062).lineTo(0.000000, 0.414062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.239720, 0.139474).lineTo(0.239720, 0.274589).lineTo(0.174342, 0.274589).lineTo(0.174342, 0.139474).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.374836, 0.000000).lineTo(0.374836, 0.414062).lineTo(0.000000, 0.414062).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.239720, 0.139474).lineTo(0.239720, 0.274589).lineTo(0.174342, 0.274589).lineTo(0.174342, 0.139474).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.281250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
