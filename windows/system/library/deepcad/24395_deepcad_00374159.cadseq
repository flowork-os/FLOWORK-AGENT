# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00374159" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.831579, -0.116941).threePointArc((1.230748, 0.227385), (0.831579, 0.571711)).lineTo(0.000000, 0.441776).threePointArc((-0.190539, 0.220888), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.844572, -0.103947).threePointArc((1.228679, 0.227385), (0.844572, 0.558717)).lineTo(0.000000, 0.428783).threePointArc((-0.179331, 0.220888), (0.000000, 0.012993)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.031250, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.185526, 0.000000).circle(0.185526)
solid1=wp_sketch1.add(loop2).extrude(0.031250, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.093750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.307895, 0.000000).circle(0.307895)
solid2=wp_sketch2.add(loop3).extrude(0.031250, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
