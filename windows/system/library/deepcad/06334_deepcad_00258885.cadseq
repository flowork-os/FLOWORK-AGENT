# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00258885" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.495066, 0.000000).lineTo(0.495066, 0.424342).threePointArc((0.247533, 0.671875), (0.000000, 0.424342)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.247533, 0.424342).circle(0.077796)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.500000, 0.000000).lineTo(0.500000, 0.026316).lineTo(0.000000, 0.026316).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.023438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.105263, 0.000000).lineTo(0.105263, 1.000000).lineTo(0.000000, 1.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.585938)
solid=solid.intersect(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.648438, 0.023438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.105263, 0.000000).lineTo(0.105263, 1.000000).lineTo(0.000000, 1.000000).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.585938)
solid=solid.intersect(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.023684).lineTo(0.647368, 0.023684).lineTo(0.102632, 0.023684).lineTo(0.000000, 0.023684).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(0.585938)
solid=solid.intersect(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
