# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.464145, 0.191118).lineTo(0.648438, 0.129688).lineTo(0.525576, 0.245724).lineTo(0.648438, 0.464145).lineTo(0.464145, 0.464145).lineTo(0.368586, 0.627961).lineTo(0.266201, 0.464145).lineTo(0.088734, 0.464145).lineTo(0.225247, 0.245724).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.312500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
