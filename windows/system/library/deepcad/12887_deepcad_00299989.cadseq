# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.109375, -0.117188, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch4.moveTo(0.070312, 0.000000).lineTo(0.070312, 0.070312).lineTo(0.000000, 0.070312).lineTo(0.000000, 0.000000).close()
