# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00315293" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.153947, 0.000000).circle(0.153947)
loop1=wp_sketch0.moveTo(0.153947, 0.000000).circle(0.076974)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.150215, -0.153947), (0.000000, -0.307895)).lineTo(0.602961, -0.288651).threePointArc((0.468257, -0.147533), (0.609375, -0.012829)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.156250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.476562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.138158, 0.000000).circle(0.138158)
loop4=wp_sketch2.moveTo(0.138158, 0.000000).circle(0.074836)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.156250)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.078947, 0.000000).circle(0.078947)
loop6=wp_sketch3.moveTo(0.062500, -0.014803).lineTo(0.062500, -0.069079).lineTo(0.093750, -0.069079).lineTo(0.093750, -0.014803).lineTo(0.143092, -0.014803).lineTo(0.143092, 0.016447).lineTo(0.093750, 0.016447).lineTo(0.093750, 0.064145).lineTo(0.062500, 0.064145).lineTo(0.062500, 0.016447).lineTo(0.011513, 0.016447).lineTo(0.011513, -0.014803).close()
solid3=wp_sketch3.add(loop5).add(loop6).extrude(0.375000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
