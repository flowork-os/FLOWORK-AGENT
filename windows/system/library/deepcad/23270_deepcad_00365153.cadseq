# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00365153" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.515625, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.525000, 0.000000).circle(0.525000)
loop1=wp_sketch0.moveTo(0.525000, 0.000000).circle(0.185937)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.695312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.632812, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.639474, 0.000000).circle(0.626151)
loop3=wp_sketch1.moveTo(0.639474, 0.000000).circle(0.519572)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.695312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.695312, -0.492188, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.497368, 0.000000).circle(0.497368)
loop5=wp_sketch2.moveTo(0.497368, 0.000000).circle(0.186513)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(-0.578125)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
