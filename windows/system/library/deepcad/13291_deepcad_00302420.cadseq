# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.129490, -0.312616), (0.442105, -0.442105)).lineTo(1.089474, -0.442105).threePointArc((1.379760, -0.321865), (1.500000, -0.031579)).lineTo(1.500000, 0.678947).threePointArc((1.385739, 0.939009), (1.121053, 1.042105)).lineTo(0.331579, 1.042105).threePointArc((0.097117, 0.944988), (0.000000, 0.710526)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
