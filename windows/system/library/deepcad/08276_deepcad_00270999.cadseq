# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00270999" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.242188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.438322, 0.000000).threePointArc((0.487459, 0.020353), (0.507812, 0.069490)).lineTo(0.507812, 0.416941).threePointArc((0.487459, 0.466078), (0.438322, 0.486431)).lineTo(0.000000, 0.486431).threePointArc((-0.243215, 0.243215), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.245888).circle(0.176398)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.484375, 0.210938, 0.140625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.099687, -0.094409), (0.195312, 0.004112)).lineTo(0.195312, 0.034951).lineTo(0.195312, 0.065789).threePointArc((0.098672, 0.163283), (0.000000, 0.067845)).lineTo(0.000000, 0.061678).lineTo(0.000000, 0.034951).lineTo(0.000000, 0.006168).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.084293, 0.010280).lineTo(0.084293, -0.043174).lineTo(0.111020, -0.043174).lineTo(0.111020, 0.010280).lineTo(0.170641, 0.010280).lineTo(0.170641, 0.059622).lineTo(0.111020, 0.059622).lineTo(0.111020, 0.111020).lineTo(0.084293, 0.111020).lineTo(0.084293, 0.059622).lineTo(0.024671, 0.059622).lineTo(0.024671, 0.010280).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
