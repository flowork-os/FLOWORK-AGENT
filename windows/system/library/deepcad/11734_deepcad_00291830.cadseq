import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.377632, -0.377632).lineTo(0.875000, -0.377632).lineTo(0.875000, -0.128947).lineTo(0.690789, -0.128947).lineTo(0.690789, 0.128947).lineTo(0.442105, 0.377632).lineTo(0.248684, 0.377632).lineTo(0.248684, 0.626316).lineTo(0.000000, 0.626316).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, -0.640625, 0.101562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(0.707107, 0.000000, 0.707107)))
loop1=wp_sketch1.moveTo(0.063158, 0.000000).circle(0.061842)
solid1=wp_sketch1.add(loop1).extrude(-0.578125)
solid=solid.cut(solid1)
