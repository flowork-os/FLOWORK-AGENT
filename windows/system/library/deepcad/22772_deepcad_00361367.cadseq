import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.262500, -0.062500).lineTo(1.100000, -0.062500).threePointArc((1.114645, -0.027145), (1.150000, -0.012500)).lineTo(1.187500, -0.012500).lineTo(1.187500, 0.075000).lineTo(0.312500, 0.075000).lineTo(0.262500, 0.087500).lineTo(0.037500, 0.087500).lineTo(0.000000, 0.075000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
