# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00237264" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.695312, 0.000000).lineTo(0.695312, 0.695312).lineTo(0.497697, 0.695312).lineTo(0.497697, 0.351316).threePointArc((0.347656, 0.201275), (0.197615, 0.351316)).lineTo(0.197615, 0.695312).lineTo(0.000000, 0.695312).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.234375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.146382, 0.000000).lineTo(0.146382, 0.461102).lineTo(0.204934, 0.461102).lineTo(0.256168, 0.461102).lineTo(0.256168, 0.000000).lineTo(0.402549, 0.000000).lineTo(0.402549, 0.695312).lineTo(0.000000, 0.695312).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.234375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
