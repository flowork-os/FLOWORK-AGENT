# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00342219" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.054688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.639474, 0.000000).lineTo(0.639474, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.063158, 0.560526).circle(0.007895)
loop2=wp_sketch0.moveTo(0.221053, 0.442105).lineTo(0.426316, 0.442105).lineTo(0.536842, 0.442105).lineTo(0.536842, 0.678947).lineTo(0.110526, 0.678947).lineTo(0.110526, 0.442105).close()
loop3=wp_sketch0.moveTo(0.426316, 0.189474).circle(0.031579)
loop4=wp_sketch0.moveTo(0.584211, 0.560526).circle(0.007895)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.055263, 0.000000).lineTo(0.055263, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.054688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch2.moveTo(0.378947, 0.000000).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.560526).lineTo(0.750000, 0.615789).lineTo(0.639474, 0.615789).lineTo(0.000000, 0.615789).lineTo(0.000000, 0.055263).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch2.moveTo(0.181579, 0.339474).circle(0.015789)
loop8=wp_sketch2.moveTo(0.378947, 0.339474).circle(0.063158)
loop9=wp_sketch2.moveTo(0.378947, 0.165789).circle(0.015789)
loop10=wp_sketch2.moveTo(0.378947, 0.505263).circle(0.015789)
loop11=wp_sketch2.moveTo(0.568421, 0.339474).circle(0.015789)
solid2=wp_sketch2.add(loop6).add(loop7).add(loop8).add(loop9).add(loop10).add(loop11).extrude(0.054688)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
