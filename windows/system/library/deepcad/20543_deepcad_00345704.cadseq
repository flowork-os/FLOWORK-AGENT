# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00345704" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.019737, 0.000000).circle(0.019737)
loop1=wp_sketch0.moveTo(0.019737, 0.000000).circle(0.015625)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, -0.703125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.029276, 0.000000).lineTo(0.029276, 0.695312).threePointArc((0.014638, 0.687944), (0.000000, 0.695312)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.023438, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
