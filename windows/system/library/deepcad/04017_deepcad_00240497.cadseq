# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.468750, 0.031250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.010983, -0.026517), (0.037500, -0.037500)).lineTo(0.593750, -0.037500).lineTo(0.593750, 0.106250).lineTo(0.037500, 0.106250).threePointArc((0.010983, 0.095267), (0.000000, 0.068750)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.429688, 0.031250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.138158, 0.000000).threePointArc((0.150951, 0.005299), (0.156250, 0.018092)).lineTo(0.156250, 0.121711).threePointArc((0.151292, 0.135326), (0.138158, 0.141447)).lineTo(0.000000, 0.141447).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.015625)
