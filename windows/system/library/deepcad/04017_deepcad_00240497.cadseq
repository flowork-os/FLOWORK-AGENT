wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, -0.593750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.003709, -0.008955), (0.012664, -0.012664)).lineTo(0.291283, -0.012664).threePointArc((0.306570, -0.011578), (0.316612, 0.000000)).lineTo(0.316612, 1.190461).threePointArc((0.306570, 1.202039), (0.291283, 1.203125)).lineTo(0.012664, 1.203125).threePointArc((0.003709, 1.199416), (0.000000, 1.190461)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
