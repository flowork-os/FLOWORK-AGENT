# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00308264" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.368421, 0.000000).lineTo(0.368421, -0.483553).lineTo(1.093750, -0.483553).lineTo(1.093750, -0.241776).lineTo(0.610197, -0.241776).lineTo(0.610197, 0.241776).lineTo(0.000000, 0.241776).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.609375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, 0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.362664, 0.005181).lineTo(0.362664, 0.492187).lineTo(0.000000, 0.492187).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.242188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
