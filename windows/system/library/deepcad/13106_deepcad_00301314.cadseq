# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00301314" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.710938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.133224, 0.000000).lineTo(0.133224, 0.053289).lineTo(0.499589, 0.053289).lineTo(0.499589, 0.000000).lineTo(0.632812, 0.000000).lineTo(0.632812, 0.166530).lineTo(0.000000, 0.166530).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.421875, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.539062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.631579, 0.000000).lineTo(0.631579, -0.167763).lineTo(0.937500, 0.256579).lineTo(0.937500, 0.542763).lineTo(0.720395, 0.542763).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.070312, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.179688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.205263, 0.000000).circle(0.200987)
loop3=wp_sketch2.moveTo(0.205263, 0.000000).circle(0.124013)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(-0.281250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
