# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232479" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.422368, 0.000000).lineTo(0.835938, 0.000000).lineTo(0.835938, 0.140789).lineTo(0.554359, 0.756743).lineTo(0.422368, 0.756743).lineTo(0.281579, 0.756743).lineTo(0.000000, 0.140789).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.061595, 0.070395).circle(0.026398)
loop2=wp_sketch0.moveTo(0.422368, 0.615954).circle(0.087993)
loop3=wp_sketch0.moveTo(0.774342, 0.070395).circle(0.026398)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.031250, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
