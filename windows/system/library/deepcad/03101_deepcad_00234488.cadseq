# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00234488" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.839391, 0.000000).lineTo(1.351562, 0.597533).lineTo(1.351562, 1.010115).lineTo(0.000000, 1.237747).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.024342, 0.512171).circle(0.085362)
loop2=wp_sketch0.moveTo(1.024342, 0.768257).circle(0.071135)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
