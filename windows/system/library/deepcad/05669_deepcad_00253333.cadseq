# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00253333" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.562500, 0.000000).lineTo(0.562500, 0.562500).lineTo(0.000000, 0.562500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.272368, 0.017763).lineTo(0.272368, 0.272368).lineTo(0.017763, 0.272368).lineTo(0.017763, 0.017763).close()
loop2=wp_sketch0.moveTo(0.272368, 0.290132).lineTo(0.272368, 0.544737).lineTo(0.017763, 0.544737).lineTo(0.017763, 0.290132).close()
loop3=wp_sketch0.moveTo(0.544737, 0.017763).lineTo(0.544737, 0.272368).lineTo(0.290132, 0.272368).lineTo(0.290132, 0.017763).close()
loop4=wp_sketch0.moveTo(0.544737, 0.290132).lineTo(0.544737, 0.544737).lineTo(0.290132, 0.544737).lineTo(0.290132, 0.290132).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.562500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
