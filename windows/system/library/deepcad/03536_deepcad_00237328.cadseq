# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00237328" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.066201, -0.406661).lineTo(0.170230, -0.406661).lineTo(0.170230, -0.160773).threePointArc((0.255345, -0.245888), (0.340461, -0.160773)).lineTo(0.340461, -0.406661).lineTo(0.435033, -0.406661).lineTo(0.501234, 0.000000).lineTo(0.501234, 0.898438).lineTo(0.000000, 0.898438).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.218750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.234375, 0.750000, 0.218750), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.500000, 0.000000).lineTo(0.500000, 0.121053).lineTo(0.326316, 0.221053).lineTo(0.173684, 0.221053).lineTo(0.000000, 0.121053).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.265625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
