# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231769" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.102632, 0.000000).circle(0.102632)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.182023, -0.287418), (0.119737, 0.047039)).lineTo(0.119737, 0.070559).lineTo(0.083388, 0.070559).lineTo(0.083388, 0.047039).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.757895)
loop3=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.631579)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.078125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
