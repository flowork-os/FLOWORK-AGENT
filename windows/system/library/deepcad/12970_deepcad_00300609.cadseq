# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00300609" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.452220, 0.000000).threePointArc((0.591606, 0.057736), (0.649342, 0.197122)).lineTo(0.649342, 0.347862).lineTo(1.101562, 0.347862).lineTo(1.101562, 0.498602).lineTo(0.347862, 0.498602).threePointArc((0.208476, 0.440866), (0.150740, 0.301480)).lineTo(0.150740, 0.150740).lineTo(0.000000, 0.150740).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.405839, 0.255099).circle(0.150740)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.101316, 0.000000).lineTo(0.101316, 0.151974).lineTo(0.101316, 0.601562).lineTo(0.000000, 0.601562).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, 0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.098438, 0.000000).lineTo(0.098438, 0.148438).lineTo(0.000000, 0.148438).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
