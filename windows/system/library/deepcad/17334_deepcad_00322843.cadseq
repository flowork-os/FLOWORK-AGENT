import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.554688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.105263).lineTo(0.994737, 1.105263).lineTo(0.757895, 0.710526).lineTo(0.505263, 1.105263).lineTo(0.000000, 1.105263).lineTo(0.000000, 0.552632).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.323684, 0.213158), (0.110526, 0.536842)).lineTo(0.110526, 0.584211).threePointArc((0.102632, 0.592105), (0.094737, 0.584211)).lineTo(0.094737, 0.552632).lineTo(0.094737, 0.536842).close()
loop2=wp_sketch0.moveTo(0.094737, 0.536842).threePointArc((0.750000, -0.118421), (1.405263, 0.536842)).lineTo(1.405263, 0.584211).threePointArc((1.397368, 0.592105), (1.389474, 0.584211)).lineTo(1.389474, 0.536842).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.015625)
solid=solid0

