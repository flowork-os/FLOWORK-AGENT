wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.368421, 0.000000).lineTo(0.368421, 0.151974).lineTo(0.276316, 0.151974).lineTo(0.276316, 0.437500).lineTo(0.230263, 0.437500).lineTo(0.216447, 0.409868).lineTo(0.216447, 0.188816).lineTo(0.165789, 0.188816).lineTo(0.165789, 0.409868).lineTo(0.147368, 0.437500).lineTo(0.101316, 0.437500).lineTo(0.101316, 0.151974).lineTo(0.000000, 0.151974).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
