loop0=wp_sketch0.moveTo(0.008635, -0.051809).lineTo(0.034539, -0.043174).lineTo(0.094984, -0.457648).lineTo(0.069079, -0.457648).lineTo(0.077714, -0.509457).lineTo(0.094984, -0.509457).lineTo(0.112253, -0.604441).lineTo(0.673520, -0.604441).lineTo(0.708059, -0.604441).lineTo(0.820313, 0.138158).lineTo(0.785773, 0.146793).lineTo(0.000000, 0.146793).lineTo(0.025905, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.708059, -0.509457).lineTo(0.716694, -0.457648).lineTo(0.690789, -0.457648).lineTo(0.682155, -0.509457).close()
loop2=wp_sketch0.moveTo(0.777138, -0.051809).lineTo(0.785773, 0.000000).lineTo(0.759868, 0.008635).lineTo(0.751234, -0.043174).close()
