# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297188" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.105839, 0.000000).lineTo(0.105839, -0.105839).threePointArc((0.127549, -0.107708), (0.149260, -0.105839)).lineTo(0.149260, 0.000000).lineTo(0.255099, 0.000000).threePointArc((0.256968, 0.021711), (0.255099, 0.043421)).lineTo(0.149260, 0.043421).lineTo(0.149260, 0.149260).threePointArc((0.127549, 0.151129), (0.105839, 0.149260)).lineTo(0.105839, 0.043421).lineTo(0.000000, 0.043421).threePointArc((-0.001870, 0.021711), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, 0.015625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.015789, 0.000000).circle(0.015789)
solid1=wp_sketch1.add(loop1).extrude(0.734375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
