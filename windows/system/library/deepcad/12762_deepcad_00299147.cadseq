# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00299147" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.678947, 0.000000).threePointArc((0.750000, 0.071053), (0.678947, 0.142105)).lineTo(0.000000, 0.142105).threePointArc((-0.071053, 0.071053), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.071053).circle(0.023684)
loop2=wp_sketch0.moveTo(0.678947, 0.039474).threePointArc((0.710526, 0.071053), (0.678947, 0.102632)).lineTo(0.126316, 0.102632).threePointArc((0.095797, 0.074374), (0.118421, 0.039474)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
