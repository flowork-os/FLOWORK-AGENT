# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00301518" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.193421, 0.000000).circle(0.193421)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.046340, -0.175288), (0.221628, -0.128947)).lineTo(0.221628, -0.080592).threePointArc((0.191406, -0.050370), (0.161184, -0.080592)).lineTo(0.161184, -0.128947).close()
loop2=wp_sketch0.moveTo(0.161184, -0.128947).threePointArc((0.296176, -0.054400), (0.221628, 0.080592)).lineTo(0.221628, 0.128947).threePointArc((0.191406, 0.098725), (0.161184, 0.128947)).lineTo(0.161184, 0.080592).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
