# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00335302" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, -0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.793750, 0.000000).threePointArc((0.992188, 0.198437), (0.793750, 0.396875)).lineTo(0.000000, 0.396875).threePointArc((-0.198437, 0.198437), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.793750, 0.104441).threePointArc((0.887747, 0.198437), (0.793750, 0.292434)).lineTo(0.396875, 0.292434).threePointArc((0.490872, 0.198437), (0.396875, 0.104441)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.140625, 0.195312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.201316, 0.000000).circle(0.197122)
loop3=wp_sketch1.moveTo(0.201316, 0.000000).circle(0.100658)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.398438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
