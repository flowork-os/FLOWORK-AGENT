import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, -0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.091283, 0.000000).threePointArc((0.118668, -0.022757), (0.146053, 0.000000)).lineTo(0.867188, 0.000000).lineTo(0.867188, 0.009128).lineTo(0.146053, 0.009128).threePointArc((0.118668, 0.031885), (0.091283, 0.009128)).lineTo(0.000000, 0.009128).threePointArc((-0.057097, 0.004564), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.036513, 0.009128).circle(0.027385)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
