# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00313095" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.014474, 0.000000).lineTo(0.014474, 0.014474).lineTo(0.039803, 0.014474).lineTo(0.039803, 0.000000).lineTo(0.343750, 0.000000).lineTo(0.343750, 0.028947).lineTo(0.000000, 0.028947).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.329276, 0.007237).threePointArc((0.336513, 0.014474), (0.329276, 0.021711)).lineTo(0.206250, 0.021711).threePointArc((0.199013, 0.014474), (0.206250, 0.007237)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.015625, 0.273438, 0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.436431, 0.000000).lineTo(0.436431, 0.015049).lineTo(0.461513, 0.015049).lineTo(0.461513, 0.000000).lineTo(0.476562, 0.000000).lineTo(0.476562, 0.025082).lineTo(0.000000, 0.025082).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.135444, 0.005016).threePointArc((0.142969, 0.012541), (0.135444, 0.020066)).lineTo(0.015049, 0.020066).threePointArc((0.007525, 0.012541), (0.015049, 0.005016)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
