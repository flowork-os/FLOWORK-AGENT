# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00354533" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, -0.468750, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.059704, 0.099507).threePointArc((-0.133899, 0.472656), (0.059704, 0.845806)).lineTo(0.000000, 0.945312).threePointArc((-0.248923, 0.472656), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(-1.000000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.515625, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.051809, -0.103618).threePointArc((0.471938, -0.121265), (0.699424, -0.474918)).lineTo(0.820313, -0.474918).threePointArc((0.535213, -0.021451), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(-1.000000)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, -0.515625, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.535213, 0.021451), (0.820313, 0.474918)).lineTo(0.699424, 0.474918).threePointArc((0.471938, 0.121265), (0.051809, 0.103618)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-1.000000)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
