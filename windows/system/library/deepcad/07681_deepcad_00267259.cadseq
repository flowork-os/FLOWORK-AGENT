# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267259" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.531250, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.531250, 0.000000).lineTo(0.531250, 0.218092).lineTo(0.251645, 0.218092).lineTo(0.000000, 0.123026).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.520066, 0.011184).lineTo(0.520066, 0.206908).lineTo(0.251645, 0.206908).lineTo(0.011184, 0.117434).lineTo(0.011184, 0.011184).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
