# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00314133" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.695312, 0.000000).lineTo(0.695312, 0.204934).lineTo(0.000000, 0.204934).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.175658, 0.102467).circle(0.051234)
loop2=wp_sketch0.moveTo(0.519655, 0.102467).circle(0.051234)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
