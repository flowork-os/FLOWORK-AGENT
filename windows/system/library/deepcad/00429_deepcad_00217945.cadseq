# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00217945" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.023684, 0.000000).circle(0.023684)
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.315296, 0.000000).threePointArc((0.337277, 0.009105), (0.346382, 0.031086)).lineTo(0.346382, 0.390789).threePointArc((0.337277, 0.412770), (0.315296, 0.421875)).lineTo(0.000000, 0.421875).lineTo(0.000000, 0.417434).lineTo(0.115461, 0.417434).lineTo(0.115461, 0.004441).lineTo(0.000000, 0.004441).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.182072, 0.004441).lineTo(0.182072, 0.417434).lineTo(0.115461, 0.417434).lineTo(0.115461, 0.004441).close()
loop3=wp_sketch1.moveTo(0.253125, 0.004441).lineTo(0.253125, 0.417434).lineTo(0.186513, 0.417434).lineTo(0.186513, 0.004441).close()
loop4=wp_sketch1.moveTo(0.315296, 0.004441).threePointArc((0.334137, 0.012245), (0.341941, 0.031086)).lineTo(0.341941, 0.390789).threePointArc((0.334137, 0.409630), (0.315296, 0.417434)).lineTo(0.257566, 0.417434).lineTo(0.257566, 0.004441).close()
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.023438, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
