wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.148438, -0.015625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.085033, -0.672533).threePointArc((0.150740, -0.732086), (0.216447, -0.672533)).lineTo(0.301480, 0.000000).threePointArc((0.301906, 0.035263), (0.293750, 0.069572)).lineTo(0.247368, 0.193257).threePointArc((0.150740, 0.259551), (0.054112, 0.193257)).lineTo(0.007730, 0.069572).threePointArc((-0.000425, 0.035263), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.146875, 0.015461).circle(0.108224)
loop2=wp_sketch0.moveTo(0.146875, -0.672533).circle(0.038651)
loop3=wp_sketch0.moveTo(0.146875, 0.193257).circle(0.023191)
