# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00304259" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.625000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.250000, 0.000000).lineTo(1.250000, 1.250000).lineTo(0.000000, 1.250000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.631579, 0.631579).circle(0.131579)
loop2=wp_sketch0.moveTo(1.000000, 0.236842).circle(0.078947)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.484375, 0.250000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.075000, 0.000000).circle(0.075000)
solid1=wp_sketch1.add(loop3).extrude(0.500000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.234375, 0.492188, 0.250000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.075000, 0.000000).circle(0.073438)
solid2=wp_sketch2.add(loop4).extrude(0.500000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, -0.320312, 0.250000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.075000, 0.000000).circle(0.075000)
solid3=wp_sketch3.add(loop5).extrude(0.500000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
