# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00247308" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.523438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.236102, -0.586678).threePointArc((0.458574, -0.659529), (0.500822, -0.429276)).lineTo(0.372039, -0.221793).lineTo(0.186020, 0.093010).threePointArc((0.050338, 0.131850), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.093010, 0.035773).circle(0.050082)
loop2=wp_sketch0.moveTo(0.379194, -0.522286).circle(0.085855)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.632812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.084872, 0.031314), (0.161184, -0.017270)).lineTo(0.351151, -0.333882).threePointArc((0.350331, -0.251272), (0.420230, -0.207237)).threePointArc((0.540805, -0.107480), (0.489309, 0.040296)).threePointArc((0.236597, 0.117987), (0.000000, 0.000000)).close()
loop4=wp_sketch1.moveTo(0.408717, -0.069079).circle(0.051809)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.132812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
