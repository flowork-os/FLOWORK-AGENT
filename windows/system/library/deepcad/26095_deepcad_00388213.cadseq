# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.546875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.126316, 0.000000).threePointArc((0.378947, 0.479697), (0.631579, 0.000000)).lineTo(0.757895, 0.000000).lineTo(0.884211, 0.000000).threePointArc((1.128947, 0.471704), (1.373684, 0.000000)).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.631579).lineTo(0.000000, 0.631579).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.500000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
