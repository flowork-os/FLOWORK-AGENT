# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.094737).lineTo(0.000000, 0.094737).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.742105, 0.007895).lineTo(0.742105, 0.086842).lineTo(0.007895, 0.086842).lineTo(0.007895, 0.007895).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.094737).lineTo(0.000000, 0.094737).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
