loop3=wp_sketch2.moveTo(0.005757, 0.000000).lineTo(0.005757, 0.078125).lineTo(0.000000, 0.078125).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.070312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.546875, -0.007812, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.005757, 0.000000).lineTo(0.005757, 0.078125).lineTo(0.000000, 0.078125).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.070312)
