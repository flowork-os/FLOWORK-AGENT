# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.171875, -0.007812, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.005757, 0.000000).lineTo(0.005757, 0.078125).lineTo(0.000000, 0.078125).lineTo(0.000000, 0.000000).close()
