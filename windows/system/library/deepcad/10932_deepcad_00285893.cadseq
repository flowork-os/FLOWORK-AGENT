# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285893" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, -0.351562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.179688, 0.000000).lineTo(1.179688, 0.695395).lineTo(0.000000, 0.695395).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.359375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.593750, -0.179688, 0.179688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.181579, 0.000000).circle(0.181579)
solid1=wp_sketch1.add(loop1).extrude(0.156250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.289062, 0.359375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.421875, 0.000000).lineTo(0.421875, 0.119901).lineTo(0.000000, 0.119901).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.007812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, -0.421875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(1.289062, 0.000000).lineTo(1.289062, 0.841283).lineTo(0.000000, 0.841283).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(1.261924, 0.067845).lineTo(1.261924, 0.773438).lineTo(0.027138, 0.773438).lineTo(0.027138, 0.067845).close()
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.992188)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
