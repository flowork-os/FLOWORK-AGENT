# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00280148" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.382812, 0.000000).lineTo(1.382812, 0.727796).lineTo(0.000000, 0.727796).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.465789, 0.247451).lineTo(0.465789, 0.480345).lineTo(0.218339, 0.480345).lineTo(0.218339, 0.247451).close()
loop2=wp_sketch0.moveTo(1.033470, 0.363898).circle(0.116447)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.179688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
