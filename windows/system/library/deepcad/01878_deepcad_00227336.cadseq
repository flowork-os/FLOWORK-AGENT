# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00227336" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.421875, 0.000000).lineTo(0.421875, 0.079934).lineTo(0.341941, 0.079934).lineTo(0.341941, 0.133224).lineTo(0.421875, 0.133224).lineTo(0.421875, 0.315296).lineTo(0.262007, 0.315296).lineTo(0.262007, 0.213158).lineTo(0.159868, 0.213158).lineTo(0.159868, 0.315296).lineTo(0.000000, 0.315296).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.328125, 0.000000, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.210938, -0.052837), (0.421875, 0.000000)).lineTo(0.421875, 0.106579).lineTo(0.159868, 0.106579).lineTo(0.159868, 0.262007).threePointArc((0.047744, 0.217403), (0.000000, 0.106579)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.132812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
