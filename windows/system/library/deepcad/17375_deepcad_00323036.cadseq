# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00323036" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.070312, 0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.226562, 0.000000).lineTo(0.226562, 0.226562).lineTo(0.000000, 0.226562).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.114474, 0.114474).circle(0.073931)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.179688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.226562, 0.000000).lineTo(0.226562, 0.226562).lineTo(0.000000, 0.226562).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.183635, 0.042928).lineTo(0.183635, 0.088240).threePointArc((0.211061, 0.115666), (0.183635, 0.143092)).lineTo(0.183635, 0.183635).lineTo(0.042928, 0.183635).lineTo(0.042928, 0.140707).threePointArc((0.070354, 0.113281), (0.042928, 0.085855)).lineTo(0.042928, 0.042928).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.156250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
