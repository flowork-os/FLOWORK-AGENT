# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00303182" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.363158, -0.063158).threePointArc((0.426316, 0.000000), (0.363158, 0.063158)).lineTo(0.221053, 0.063158).threePointArc((0.157895, 0.000000), (0.221053, -0.063158)).close()
loop2=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.221053)
loop3=wp_sketch0.moveTo(0.221053, -0.063158).threePointArc((0.292105, -0.592105), (0.821053, -0.521053)).lineTo(0.821053, -0.394737).threePointArc((0.750000, -0.323684), (0.678947, -0.394737)).lineTo(0.678947, -0.521053).close()
loop4=wp_sketch0.moveTo(0.678947, -0.521053).threePointArc((1.207895, -0.134211), (0.821053, 0.394737)).lineTo(0.821053, 0.521053).threePointArc((0.750000, 0.592105), (0.678947, 0.521053)).lineTo(0.678947, 0.394737).close()
loop5=wp_sketch0.moveTo(1.278947, -0.063158).threePointArc((1.342105, 0.000000), (1.278947, 0.063158)).lineTo(1.136842, 0.063158).threePointArc((1.073684, 0.000000), (1.136842, -0.063158)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.132812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
