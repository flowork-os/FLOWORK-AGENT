loop0=wp_sketch0.moveTo(0.079934, 0.000000).lineTo(0.095477, 0.002220).lineTo(0.195395, 0.002220).threePointArc((0.199062, 0.002121), (0.202056, 0.000000)).lineTo(0.208717, -0.017763).lineTo(0.210938, -0.017763).lineTo(0.204276, 0.000000).threePointArc((0.200509, 0.003567), (0.195395, 0.004441)).lineTo(0.093257, 0.004441).lineTo(0.079934, 0.002220).lineTo(0.000000, 0.002220).lineTo(0.000000, 0.000000).close()
