# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387641" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, 0.000000, -0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.880181, 0.000000).lineTo(0.868750, 0.868750).lineTo(0.685855, 1.085938).lineTo(0.194326, 1.085938).lineTo(0.000000, 0.868750).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.422944, 0.777303).circle(0.171464)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.406250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
