# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285966" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.687500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.019077, -0.046055), (0.065132, -0.065132)).lineTo(0.376316, -0.065132).lineTo(0.376316, 0.188158).threePointArc((0.249671, 0.314803), (0.376316, 0.441447)).lineTo(0.376316, 0.687500).lineTo(0.065132, 0.687500).threePointArc((0.019077, 0.668423), (0.000000, 0.622368)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.375000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.315789, 0.000000).threePointArc((0.360449, 0.018499), (0.378947, 0.063158)).lineTo(0.378947, 0.686842).threePointArc((0.360449, 0.731501), (0.315789, 0.750000)).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.505263).threePointArc((0.130263, 0.375000), (0.000000, 0.244737)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.031250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
