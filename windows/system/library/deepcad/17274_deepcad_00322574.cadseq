import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.686842, 0.000000).threePointArc((0.746053, 0.059211), (0.686842, 0.118421)).lineTo(0.000000, 0.118421).threePointArc((-0.059211, 0.059211), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.686842, 0.007895).threePointArc((0.738158, 0.059211), (0.686842, 0.110526)).lineTo(0.000000, 0.110526).threePointArc((-0.051316, 0.059211), (0.000000, 0.007895)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.171875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
