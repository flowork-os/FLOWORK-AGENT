# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00304222" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.584211).lineTo(0.000000, 0.584211).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.213158, 0.007895).lineTo(0.213158, 0.284211).lineTo(0.007895, 0.284211).lineTo(0.007895, 0.007895).close()
loop2=wp_sketch0.moveTo(0.213158, 0.300000).lineTo(0.213158, 0.450000).lineTo(0.007895, 0.450000).lineTo(0.007895, 0.300000).close()
loop3=wp_sketch0.moveTo(0.742105, 0.465789).lineTo(0.742105, 0.568421).lineTo(0.007895, 0.568421).lineTo(0.007895, 0.465789).close()
loop4=wp_sketch0.moveTo(0.371053, 0.007895).lineTo(0.378947, 0.007895).lineTo(0.742105, 0.007895).lineTo(0.742105, 0.450000).lineTo(0.378947, 0.450000).lineTo(0.371053, 0.450000).lineTo(0.221053, 0.450000).lineTo(0.221053, 0.007895).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.359375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
