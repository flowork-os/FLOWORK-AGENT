# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00325242" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.000000, -0.593750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.817681, 0.000000).lineTo(0.817681, 1.273438).lineTo(0.000000, 1.273438).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.294901, 0.911513).lineTo(0.294901, 0.965132).lineTo(0.107237, 0.965132).lineTo(0.107237, 0.911513).close()
loop2=wp_sketch0.moveTo(0.737253, 0.361924).lineTo(0.737253, 0.428947).lineTo(0.147451, 0.428947).lineTo(0.147451, 0.361924).close()
loop3=wp_sketch0.moveTo(0.348520, 0.576398).lineTo(0.348520, 0.616612).lineTo(0.294901, 0.616612).lineTo(0.294901, 0.576398).close()
loop4=wp_sketch0.moveTo(0.522780, 0.576398).lineTo(0.522780, 0.616612).lineTo(0.442352, 0.616612).lineTo(0.442352, 0.576398).close()
loop5=wp_sketch0.moveTo(0.737253, 0.898109).lineTo(0.737253, 0.991941).lineTo(0.469161, 0.991941).lineTo(0.469161, 0.898109).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.250000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, 0.312500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch1.moveTo(0.195312, 0.000000).lineTo(0.195312, 0.057566).lineTo(0.000000, 0.057566).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop6).extrude(0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
