# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00333576" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.539062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.671875, 0.000000).lineTo(0.671875, 0.360691).lineTo(0.000000, 0.360691).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.622368, 0.056579).lineTo(0.622368, 0.311184).lineTo(0.063651, 0.311184).lineTo(0.544572, 0.198026).lineTo(0.049507, 0.056579).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
