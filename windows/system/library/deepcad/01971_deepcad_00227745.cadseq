import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.648438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.315789).lineTo(1.263158, 0.315789).lineTo(1.263158, 0.647368).lineTo(1.263158, 0.978947).lineTo(1.500000, 0.978947).lineTo(1.500000, 1.294737).lineTo(0.000000, 1.294737).lineTo(0.000000, 0.978947).lineTo(0.236842, 0.978947).lineTo(0.236842, 0.647368).lineTo(0.236842, 0.315789).lineTo(0.000000, 0.315789).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.242188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
