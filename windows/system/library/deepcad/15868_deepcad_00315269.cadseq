# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.375000, 0.289062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch4.moveTo(1.125000, 0.000000).lineTo(1.125000, 1.125000).lineTo(0.000000, 1.125000).lineTo(0.000000, 0.000000).close()
loop8=wp_sketch4.moveTo(1.030263, 0.094737).lineTo(1.030263, 1.030263).lineTo(0.094737, 1.030263).lineTo(0.094737, 0.094737).close()
