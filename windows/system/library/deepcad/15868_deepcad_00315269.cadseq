loop4=wp_sketch2.moveTo(0.655263, 0.094737).lineTo(0.655263, 0.655263).lineTo(0.094737, 0.655263).lineTo(0.094737, 0.094737).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.093750)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, -0.281250, 0.195312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.937500, 0.000000).lineTo(0.937500, 0.937500).lineTo(0.000000, 0.937500).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch3.moveTo(0.848684, 0.098684).lineTo(0.848684, 0.848684).lineTo(0.098684, 0.848684).lineTo(0.098684, 0.098684).close()
solid3=wp_sketch3.add(loop5).add(loop6).extrude(0.093750)
