# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.000000, 0.656250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.071053, 0.000000).circle(0.069572)
loop6=wp_sketch3.moveTo(0.071053, 0.000000).circle(0.037007)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(-0.273438)
