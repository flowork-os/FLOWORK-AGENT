# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297260" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.010444, 0.000000).lineTo(0.010444, 0.010444).lineTo(0.981743, 0.010444).lineTo(0.981743, 0.000000).lineTo(0.992188, 0.000000).lineTo(0.992188, 0.302878).lineTo(0.981743, 0.302878).lineTo(0.981743, 0.020888).lineTo(0.010444, 0.020888).lineTo(0.010444, 0.302878).lineTo(0.000000, 0.302878).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.726562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.484375, -0.742188, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.015214, 0.000000).lineTo(0.015214, 0.289062).lineTo(0.000000, 0.289062).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.968750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
