# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.074013, -0.082237).lineTo(0.106908, -0.082237).lineTo(0.106908, 0.008224).lineTo(0.106908, 0.197368).threePointArc((0.254542, 0.562012), (0.616776, 0.715461)).lineTo(0.616776, 0.781250).threePointArc((0.208022, 0.608532), (0.041118, 0.197368)).lineTo(0.041118, 0.032895).lineTo(0.000000, 0.032895).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.242188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.687500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.365358, -0.151336), (0.516694, -0.516694)).lineTo(0.516694, -0.711513).lineTo(0.516694, -0.804688).lineTo(0.550576, -0.804688).lineTo(0.626809, -0.719984).lineTo(0.626809, -0.686102).lineTo(0.584457, -0.686102).lineTo(0.584457, -0.516694).threePointArc((0.413274, -0.103420), (0.000000, 0.067763)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.242188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
