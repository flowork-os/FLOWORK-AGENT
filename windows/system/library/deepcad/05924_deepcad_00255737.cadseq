# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00255737" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, -0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.146382, 0.000000).threePointArc((0.114877, 0.075355), (0.103618, 0.156250)).lineTo(0.000000, 0.156250).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.312500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.421875, 0.000000).lineTo(0.421875, 0.421875).lineTo(0.315296, 0.421875).threePointArc((0.222948, 0.198927), (0.000000, 0.106579)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.315296, 0.097697).circle(0.053289)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.312500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.421875, 0.000000).lineTo(0.421875, 0.106579).threePointArc((0.263217, 0.147104), (0.146546, 0.262007)).lineTo(0.000000, 0.262007).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.106579, 0.097697).circle(0.053289)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.421875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
