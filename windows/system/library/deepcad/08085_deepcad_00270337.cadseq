# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00270337" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, -0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.585938, 0.000000).lineTo(0.585938, 0.308388).lineTo(0.000000, 0.308388).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.585938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.585938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.157895, 0.000000).circle(0.157895)
solid1=wp_sketch1.add(loop1).extrude(0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, 0.695312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.059211, 0.000000).circle(0.059211)
solid2=wp_sketch2.add(loop2).extrude(0.054688)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.007812, -0.062500, 0.695312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.076305, 0.061842), (0.000000, 0.123684)).threePointArc((0.013092, 0.061842), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(-0.132812)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.007812, -0.062500, 0.695312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.013231, 0.062500), (0.000000, 0.125000)).threePointArc((-0.050654, 0.062500), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop4).extrude(-0.132812)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
