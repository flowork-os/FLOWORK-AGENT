# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00366236" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.546875, 0.000000).lineTo(0.546875, -0.171875).lineTo(0.953125, -0.171875).lineTo(0.953125, -0.015625).lineTo(1.390625, -0.015625).lineTo(1.484375, 0.156250).lineTo(0.953125, 0.156250).lineTo(0.953125, 0.328125).lineTo(0.546875, 0.328125).lineTo(0.546875, 0.171875).lineTo(0.093750, 0.171875).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.750000, 0.281250).circle(0.031250)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
