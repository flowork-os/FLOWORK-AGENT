# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00268021" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.085938, 0.054688), cq.Vector(0.995028, -0.033821, -0.093678), cq.Vector(0.098510, 0.195707, 0.975702)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.023684).lineTo(0.000000, 0.023684).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
