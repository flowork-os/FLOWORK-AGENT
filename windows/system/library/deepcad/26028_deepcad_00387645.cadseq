# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387645" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.647368)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.328125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.757895)
loop3=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.647368)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.382812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.651316, 0.000000).circle(0.651316)
loop5=wp_sketch2.moveTo(0.244243, 0.000000).circle(0.176398)
loop6=wp_sketch2.moveTo(0.651316, 0.000000).circle(0.217105)
loop7=wp_sketch2.moveTo(0.651316, -0.393503).circle(0.176398)
loop8=wp_sketch2.moveTo(0.651316, 0.393503).circle(0.176398)
loop9=wp_sketch2.moveTo(1.044819, 0.000000).circle(0.176398)
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).add(loop7).add(loop8).add(loop9).extrude(0.164062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
