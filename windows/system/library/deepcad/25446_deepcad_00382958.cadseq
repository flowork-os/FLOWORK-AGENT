# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382958" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.015625, -0.289062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.047862, 0.000000).lineTo(0.047862, -0.462664).lineTo(0.095724, -0.462664).lineTo(0.191447, 0.287171).lineTo(0.303125, 0.662089).threePointArc((0.227962, 0.758263), (0.119655, 0.701974)).lineTo(0.000000, 0.287171).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.095724, 0.287171).circle(0.047862)
loop2=wp_sketch0.moveTo(0.207401, 0.662089).circle(0.047862)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.046875, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.015625, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.048520, 0.000000).lineTo(0.048520, 0.460938).lineTo(0.000000, 0.460938).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.093750, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
