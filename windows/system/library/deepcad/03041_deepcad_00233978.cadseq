# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00233978" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.069687, -0.094644), (0.070724, -0.212171)).threePointArc((0.170433, -0.521120), (0.495066, -0.523355)).threePointArc((0.608224, -0.486741), (0.721382, -0.523355)).threePointArc((1.053087, -0.526232), (1.159868, -0.212171)).threePointArc((1.160905, -0.094644), (1.230592, 0.000000)).threePointArc((1.329752, 0.315948), (1.060855, 0.509211)).threePointArc((0.948319, 0.543113), (0.876974, 0.636513)).threePointArc((0.615296, 0.825654), (0.353618, 0.636513)).threePointArc((0.282273, 0.543113), (0.169737, 0.509211)).threePointArc((-0.099160, 0.315948), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.608224, 0.084868).circle(0.169737)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, 0.273438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.576316, 0.000000).circle(0.576316)
loop3=wp_sketch1.moveTo(0.408224, -0.288158).lineTo(0.732401, -0.288158).lineTo(0.900493, 0.000000).lineTo(0.732401, 0.288158).lineTo(0.408224, 0.288158).lineTo(0.240132, 0.000000).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.273438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
