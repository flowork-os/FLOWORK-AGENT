import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.000000, -0.671875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.032971, -0.064597), (0.104770, -0.074836)).lineTo(1.047697, 0.254441).threePointArc((1.082002, 0.284746), (1.092599, 0.329276)).lineTo(1.092599, 0.673520).lineTo(1.092599, 1.002796).threePointArc((1.082002, 1.047326), (1.047697, 1.077632)).lineTo(0.104770, 1.421875).threePointArc((0.032971, 1.411636), (0.000000, 1.347039)).lineTo(0.000000, 0.673520).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.149671, 0.104770).circle(0.074836)
loop2=wp_sketch0.moveTo(0.149671, 1.227303).circle(0.074836)
loop3=wp_sketch0.moveTo(0.942928, 0.389145).circle(0.074836)
loop4=wp_sketch0.moveTo(0.942928, 0.957895).circle(0.074836)
