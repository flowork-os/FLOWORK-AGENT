# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00366378" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.236842, -0.367105).lineTo(0.663158, -0.461842).lineTo(1.030263, -0.225000).lineTo(1.125000, 0.213158).lineTo(0.888158, 0.580263).lineTo(0.461842, 0.663158).lineTo(0.094737, 0.426316).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.319737, 0.011842).lineTo(0.473684, -0.130263).lineTo(0.686842, -0.106579).lineTo(0.817105, 0.047368).lineTo(0.805263, 0.260526).lineTo(0.639474, 0.390789).lineTo(0.438158, 0.367105).lineTo(0.296053, 0.213158).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.437500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.016283, -0.206250).lineTo(0.173684, -0.341941).lineTo(0.379934, -0.325658).lineTo(0.515625, -0.168257).lineTo(0.499342, 0.037993).lineTo(0.341941, 0.173684).lineTo(0.135691, 0.157401).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.437500)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
