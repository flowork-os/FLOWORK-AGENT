# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.099918, 0.003701).lineTo(0.092516, 0.140625).lineTo(0.185033, 0.000000).lineTo(0.296053, 0.003701).lineTo(0.173931, 0.192434).lineTo(0.240543, 0.236842).lineTo(0.203536, 0.351562).lineTo(0.066612, 0.351562).lineTo(0.000000, 0.288651).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.375000, 0.000000, 0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.189474, 0.000000).circle(0.189474)
loop3=wp_sketch2.moveTo(0.189474, 0.000000).circle(0.055263)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.250000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.107072, 0.000000).lineTo(0.138158, 0.117434).lineTo(0.200329, 0.117434).lineTo(0.227961, 0.000000).lineTo(0.328125, 0.006908).lineTo(0.245230, 0.307401).lineTo(0.079441, 0.293586).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.250000)
