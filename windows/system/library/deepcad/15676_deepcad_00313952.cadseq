# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.000000, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.081250, -0.018750).threePointArc((-0.296727, 0.053557), (0.078125, 0.140625)).lineTo(0.003125, 0.093750).threePointArc((-0.219858, 0.054256), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.250000)
