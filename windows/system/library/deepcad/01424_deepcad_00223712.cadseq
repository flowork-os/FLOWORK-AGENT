# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00223712" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.221053, 0.000000).lineTo(0.221053, 0.250000).lineTo(0.000000, 0.250000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.055263, 0.165789).circle(0.028947)
loop2=wp_sketch0.moveTo(0.139474, 0.084211).circle(0.034211)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, -0.085938, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch1.moveTo(0.223684, 0.000000).lineTo(0.223684, -0.251645).lineTo(0.335526, -0.251645).lineTo(0.335526, 0.664062).lineTo(0.000000, 0.664062).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.055921, 0.111842).circle(0.027961)
loop5=wp_sketch1.moveTo(0.055921, 0.552220).circle(0.027961)
loop6=wp_sketch1.moveTo(0.279605, 0.167763).circle(0.027961)
loop7=wp_sketch1.moveTo(0.279605, 0.608141).circle(0.027961)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).add(loop6).add(loop7).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.164062, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop8=wp_sketch2.moveTo(0.221053, 0.000000).lineTo(0.221053, 0.250000).lineTo(0.000000, 0.250000).lineTo(0.000000, 0.000000).close()
loop9=wp_sketch2.moveTo(0.055263, 0.084211).circle(0.028947)
loop10=wp_sketch2.moveTo(0.139474, 0.165789).circle(0.034211)
solid2=wp_sketch2.add(loop8).add(loop9).add(loop10).extrude(0.023438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
