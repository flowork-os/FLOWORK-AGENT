# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00274701" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.742105)
loop1=wp_sketch0.moveTo(0.205263, 0.000000).circle(0.126316)
loop2=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.268421)
loop3=wp_sketch0.moveTo(0.757895, -0.552632).circle(0.126316)
loop4=wp_sketch0.moveTo(0.757895, 0.552632).circle(0.126316)
loop5=wp_sketch0.moveTo(1.294737, 0.000000).circle(0.126316)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.242188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.242188), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.351316, 0.000000).circle(0.343997)
loop7=wp_sketch1.moveTo(0.351316, 0.000000).circle(0.270806)
solid1=wp_sketch1.add(loop6).add(loop7).extrude(0.101562)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.242188), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.351316, 0.000000).circle(0.343997)
loop7=wp_sketch1.moveTo(0.351316, 0.000000).circle(0.270806)
solid1=wp_sketch1.add(loop6).add(loop7).extrude(-0.921875)
solid_temp=solid_temp.union(solid1)
solid=solid.union(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
