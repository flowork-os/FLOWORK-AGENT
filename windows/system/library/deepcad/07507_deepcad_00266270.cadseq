# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00266270" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, -0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.484375, 0.000000).lineTo(1.484375, 0.781250).lineTo(0.000000, 0.781250).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.812500, 0.375000).circle(0.015625)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, -0.054688, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.031579, 0.000000).circle(0.031579)
solid1=wp_sketch1.add(loop2).extrude(-0.234375)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, -0.054688, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.031579, 0.000000).circle(0.030921)
loop4=wp_sketch2.moveTo(0.025000, 0.000000).circle(0.012500)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.234375)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, -0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(1.484375, 0.000000).lineTo(1.484375, 0.781250).lineTo(0.000000, 0.781250).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch3.moveTo(0.812500, 0.375000).circle(0.015625)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(-0.460938)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
