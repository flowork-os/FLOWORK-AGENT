# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00255735" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.203125, 0.000000).lineTo(1.203125, 0.607895).lineTo(1.051151, 0.607895).threePointArc((0.601562, 0.158306), (0.151974, 0.607895)).lineTo(0.000000, 0.607895).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.151974, 0.151974).circle(0.075987)
loop2=wp_sketch0.moveTo(1.051151, 0.151974).circle(0.075987)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.601562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.375000, 0.601562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.212253, 0.000000).threePointArc((0.167764, 0.109419), (0.152632, 0.226562)).lineTo(0.000000, 0.226562).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.148438)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.601562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.601562, 0.000000).lineTo(0.601562, 0.601562).lineTo(0.449589, 0.601562).threePointArc((0.317907, 0.283655), (0.000000, 0.151974)).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.449589, 0.151974).circle(0.075987)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(-0.148438)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
