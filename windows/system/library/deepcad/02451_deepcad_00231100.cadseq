wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.359375, 0.203125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.008224, -0.053454).threePointArc((0.195312, -0.111463), (0.382401, -0.053454)).lineTo(0.390625, 0.000000).threePointArc((0.386087, 0.017120), (0.370066, 0.024671)).lineTo(0.201480, 0.024671).lineTo(0.201480, -0.028783).lineTo(0.189145, -0.028783).lineTo(0.189145, 0.024671).lineTo(0.020559, 0.024671).threePointArc((0.004538, 0.017120), (0.000000, 0.000000)).close()
