# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288920" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.757812, -0.765625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.522862, 0.000000).lineTo(1.522862, 1.539062).lineTo(0.000000, 1.539062).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.312500, 0.601562, 0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.162596, -0.118760), (0.283717, -0.279605)).lineTo(0.390625, -0.279605).lineTo(0.390625, 0.111020).lineTo(0.000000, 0.111020).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.070312)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.320312, 0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.106908, 0.000000).threePointArc((0.228029, 0.160845), (0.390625, 0.279605)).lineTo(0.390625, 0.390625).lineTo(0.000000, 0.390625).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.070312)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
