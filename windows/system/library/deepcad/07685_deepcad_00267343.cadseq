loop5=wp_sketch2.moveTo(0.315789, 0.000000).threePointArc((0.333132, 0.041868), (0.375000, 0.059211)).lineTo(0.375000, 0.375000).threePointArc((0.109835, 0.265165), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop5).extrude(0.015625)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.109835, -0.265165), (0.375000, -0.375000)).lineTo(0.375000, -0.059211).threePointArc((0.333132, -0.041868), (0.315789, 0.000000)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop6).extrude(0.015625)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.371094, 0.371094), (0.000000, 0.742188)).lineTo(0.000000, 0.429688).threePointArc((0.058594, 0.371094), (0.000000, 0.312500)).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop7).extrude(0.015625)
