loop3=wp_sketch1.moveTo(0.078947, 0.000000).circle(0.078947)
loop4=wp_sketch1.moveTo(0.078947, 0.000000).circle(0.055921)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.015625)
solid=solid.union(solid1)
