import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.488487, -0.222039).threePointArc((1.060163, 0.149877), (0.488487, 0.521793)).lineTo(0.000000, 0.299753).threePointArc((-0.097505, 0.149877), (0.000000, 0.000000)).close()
