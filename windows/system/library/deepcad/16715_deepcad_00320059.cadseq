# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00320059" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.296875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.141612, -0.151727).lineTo(0.738405, 0.627138).threePointArc((0.751941, 0.637105), (0.768750, 0.637253)).lineTo(0.859786, 0.606908).lineTo(0.900247, 0.576562).lineTo(0.900247, 0.505757).lineTo(0.960938, 0.586678).lineTo(0.880016, 0.647368).lineTo(0.748520, 0.647368).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.289062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.296875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.141612, -0.151727).lineTo(0.738405, 0.627138).threePointArc((0.751941, 0.637105), (0.768750, 0.637253)).lineTo(0.859786, 0.606908).lineTo(0.900247, 0.576562).lineTo(0.900247, 0.505757).lineTo(0.960938, 0.586678).lineTo(0.880016, 0.647368).lineTo(0.748520, 0.647368).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.289062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
