# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00341716" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.540789, 0.000000).circle(0.540789)
solid0=wp_sketch0.add(loop0).extrude(0.671875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.607895, 0.000000).circle(0.607895)
loop2=wp_sketch1.moveTo(0.607895, 0.000000).circle(0.531908)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.671875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.757895, 0.000000).circle(0.757895)
loop4=wp_sketch2.moveTo(0.757895, 0.000000).circle(0.600000)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.164062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.078125, 0.382812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.164062, 0.000000).lineTo(0.164062, 0.164062).lineTo(0.000000, 0.164062).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.835938)
solid_temp=solid3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.078125, 0.382812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.164062, 0.000000).lineTo(0.164062, 0.164062).lineTo(0.000000, 0.164062).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(-0.835938)
solid_temp=solid_temp.union(solid3)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
