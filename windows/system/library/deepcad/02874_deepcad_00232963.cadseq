import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.980757, 0.000000).lineTo(0.936678, 0.396711).lineTo(0.672204, 0.484868).lineTo(0.672204, 0.628125).lineTo(0.914638, 0.771382).lineTo(0.914638, 1.046875).lineTo(0.694243, 1.046875).lineTo(0.539967, 0.881579).lineTo(0.176316, 0.881579).lineTo(0.000000, 0.473849).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
