import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.205263, 0.000000).lineTo(0.205263, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.236842).lineTo(0.063158, 0.236842).threePointArc((0.086842, 0.213158), (0.063158, 0.189474)).lineTo(0.000000, 0.189474).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
