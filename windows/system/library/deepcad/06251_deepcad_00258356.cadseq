# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00258356" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.119737, 0.000000).threePointArc((0.355469, 0.235732), (0.591201, 0.000000)).lineTo(0.710938, 0.000000).threePointArc((0.355469, 0.355469), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.071053, 0.000000).threePointArc((0.355263, 0.284211), (0.639474, 0.000000)).lineTo(0.710526, 0.000000).lineTo(0.710526, 0.623684).lineTo(0.710526, 0.750000).lineTo(0.592105, 0.750000).lineTo(0.592105, 0.623684).lineTo(0.592105, 0.315789).threePointArc((0.355263, 0.392423), (0.118421, 0.315789)).lineTo(0.118421, 0.623684).lineTo(0.118421, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.576316).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.031250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
