# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00301697" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.039062, -0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.070312, 0.000000).lineTo(0.070312, 0.070312).lineTo(0.000000, 0.070312).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002680, 0.000190), (0.004441, 0.002220)).lineTo(0.065872, 0.002220).threePointArc((0.067442, 0.002871), (0.068092, 0.004441)).lineTo(0.068092, 0.065872).threePointArc((0.067442, 0.067442), (0.065872, 0.068092)).lineTo(0.004441, 0.068092).threePointArc((0.002871, 0.067442), (0.002220, 0.065872)).lineTo(0.002220, 0.004441).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
