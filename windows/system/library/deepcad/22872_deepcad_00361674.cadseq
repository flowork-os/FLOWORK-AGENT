loop0=wp_sketch0.moveTo(0.907895, 0.000000).lineTo(0.907895, 0.197368).threePointArc((0.751364, 0.473684), (0.907895, 0.750000)).lineTo(0.907895, 1.144737).threePointArc((0.877064, 1.219169), (0.802632, 1.250000)).lineTo(0.105263, 1.250000).threePointArc((0.030831, 1.219169), (0.000000, 1.144737)).lineTo(0.000000, 0.750000).threePointArc((0.152083, 0.473684), (0.000000, 0.197368)).lineTo(0.000000, 0.000000).close()
