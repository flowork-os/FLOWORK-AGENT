# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00277777" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.045559, 0.000000).threePointArc((1.266735, 0.221176), (1.045559, 0.442352)).lineTo(0.000000, 0.442352).threePointArc((-0.221176, 0.221176), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.227878).circle(0.053618)
loop2=wp_sketch0.moveTo(0.522780, 0.227878).circle(0.053618)
loop3=wp_sketch0.moveTo(1.045559, 0.227878).circle(0.053618)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
