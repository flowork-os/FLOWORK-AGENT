# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387336" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.359375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.320312, 0.000000).lineTo(0.320312, 0.165214).lineTo(0.000000, 0.165214).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.367188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.316941, 0.000000).lineTo(0.316941, 0.640625).lineTo(0.000000, 0.640625).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.367188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.000000, -0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.577303, 0.000000).lineTo(0.577303, 0.461842).lineTo(0.410526, 0.609375).lineTo(0.160362, 0.609375).lineTo(0.000000, 0.461842).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.288651, 0.416941).circle(0.102632)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.367188)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
