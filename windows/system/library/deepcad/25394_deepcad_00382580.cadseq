loop3=wp_sketch0.moveTo(-0.345395, -1.136924).threePointArc((-0.101390, -0.576678), (0.100740, 0.000000)).threePointArc((0.064762, 0.041195), (0.028783, 0.000000)).close()
loop4=wp_sketch0.moveTo(0.028783, 0.000000).threePointArc((0.163959, -0.602951), (0.474918, -1.136924)).lineTo(0.129523, -0.820312).lineTo(0.129523, -1.295230).close()
loop5=wp_sketch0.moveTo(0.561266, -1.050576).threePointArc((0.626565, -0.437221), (0.129523, -0.071957)).lineTo(0.129523, -0.676398).close()
