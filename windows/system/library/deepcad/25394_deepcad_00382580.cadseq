loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.064762, -1.318251), (0.129523, 0.000000)).threePointArc((0.064762, 0.065561), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, -0.676398).lineTo(0.000000, -0.071957).threePointArc((-0.497042, -0.437221), (-0.431743, -1.050576)).close()
