loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.024279, -0.058615), (0.082895, -0.082895)).lineTo(0.573355, -0.082895).threePointArc((0.631971, -0.058615), (0.656250, 0.000000)).lineTo(0.656250, 0.490461).threePointArc((0.631971, 0.549076), (0.573355, 0.573355)).lineTo(0.082895, 0.573355).threePointArc((0.024279, 0.549076), (0.000000, 0.490461)).lineTo(0.000000, 0.000000).close()
