wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.718750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.460938, 0.000000).lineTo(1.460938, 0.445970).lineTo(1.168750, 0.738158).lineTo(0.876562, 0.738158).lineTo(0.876562, 0.507484).lineTo(1.091859, 0.507484).lineTo(1.091859, 0.215296).lineTo(0.369079, 0.215296).lineTo(0.369079, 0.507484).lineTo(0.584375, 0.507484).lineTo(0.584375, 0.738158).lineTo(0.292187, 0.738158).lineTo(0.000000, 0.430592).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.367188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
