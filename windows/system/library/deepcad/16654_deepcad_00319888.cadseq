import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.171875, 0.000000).lineTo(1.171875, 1.484375).lineTo(0.000000, 1.484375).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.656250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.000000, 0.359375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.082895, 0.000000).circle(0.082895)
solid1=wp_sketch1.add(loop1).extrude(-0.656250)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.000000, 0.359375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.082895, 0.000000).circle(0.082895)
solid1=wp_sketch1.add(loop1).extrude(-0.328125)
solid_temp=solid_temp.union(solid1)
solid=solid.cut(solid_temp)
