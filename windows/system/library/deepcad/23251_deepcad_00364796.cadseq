import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.481579, 0.000000).circle(0.481579)
loop1=wp_sketch0.moveTo(0.481579, 0.000000).circle(0.371217)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.094396, -0.197305), (0.106250, -0.284375)).lineTo(0.228125, -0.246875).threePointArc((0.156953, -0.109400), (0.134375, 0.043750)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.046875, -0.143750).circle(0.068750)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.390625, 0.000000, -0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.134375, -0.042434).threePointArc((0.327097, 0.054811), (0.229852, 0.247533)).lineTo(0.091941, 0.293503).threePointArc((0.070508, 0.139065), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.183882, 0.102549).circle(0.067187)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.007812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.453125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.152344, 0.025472), (0.304688, 0.000000)).lineTo(0.304688, 0.141118).threePointArc((0.152344, 0.293462), (0.000000, 0.141118)).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch3.moveTo(0.153947, 0.141118).circle(0.067352)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.007812)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
