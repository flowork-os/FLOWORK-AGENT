import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.289062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.030397, -0.058962), (0.092516, -0.082237)).lineTo(0.277549, -0.082237).lineTo(0.699013, -0.082237).lineTo(0.884046, -0.082237).threePointArc((0.946165, -0.058962), (0.976563, 0.000000)).threePointArc((0.946165, 0.058962), (0.884046, 0.082237)).lineTo(0.092516, 0.082237).threePointArc((0.030397, 0.058962), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.092516, 0.010280).circle(0.030839)
loop2=wp_sketch0.moveTo(0.884046, 0.010280).circle(0.030839)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.066920, -0.030035), (0.090461, -0.099507)).threePointArc((0.214844, -0.235061), (0.339227, -0.099507)).threePointArc((0.362767, -0.030035), (0.429688, 0.000000)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.217105, -0.108553).circle(0.104030)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.117188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.066920, -0.030035), (0.090461, -0.099507)).threePointArc((0.214844, -0.235061), (0.339227, -0.099507)).threePointArc((0.362767, -0.030035), (0.429688, 0.000000)).lineTo(0.000000, 0.000000).close()
