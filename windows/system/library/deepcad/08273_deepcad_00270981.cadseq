import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.008799, -0.395970).lineTo(0.334375, -0.395970).lineTo(0.835938, -0.395970).lineTo(0.835938, 0.000000).lineTo(0.492763, 0.000000).lineTo(0.492763, 0.272780).lineTo(0.237582, 0.263980).lineTo(0.237582, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
