# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.414062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.169737, 0.000000).circle(0.169737)
loop4=wp_sketch3.moveTo(0.169737, 0.000000).circle(0.130839)
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.390625)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.036842, 0.004605).threePointArc((0.219285, 0.218750), (0.036842, 0.432895)).lineTo(0.000000, 0.437500).threePointArc((-0.218750, 0.218750), (0.000000, 0.000000)).close()
loop6=wp_sketch4.moveTo(0.175000, 0.138158).lineTo(0.175000, 0.299342).lineTo(0.105921, 0.299342).threePointArc((-0.138035, 0.218750), (0.105921, 0.138158)).close()
solid4=wp_sketch4.add(loop5).add(loop6).extrude(0.390625)
