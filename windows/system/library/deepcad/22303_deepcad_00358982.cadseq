# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00358982" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.252632, 0.000000).circle(0.252632)
loop1=wp_sketch0.moveTo(0.252632, 0.000000).circle(0.221053)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.221053, 0.000000).circle(0.221053)
loop3=wp_sketch1.moveTo(0.221053, 0.000000).circle(0.032237)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.252632, 0.000000).circle(0.252632)
loop5=wp_sketch2.moveTo(0.252632, 0.000000).circle(0.221053)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.062500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, 0.625000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.031579, 0.000000).circle(0.031579)
solid3=wp_sketch3.add(loop6).extrude(0.312500, both=True)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
