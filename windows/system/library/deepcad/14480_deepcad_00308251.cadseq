# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00308251" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.288158, 0.000000).circle(0.288158)
loop1=wp_sketch0.moveTo(0.156086, -0.132072).circle(0.024013)
loop2=wp_sketch0.moveTo(0.156086, 0.132072).circle(0.024013)
loop3=wp_sketch0.moveTo(0.288158, 0.000000).circle(0.144079)
loop4=wp_sketch0.moveTo(0.420230, -0.132072).circle(0.024013)
loop5=wp_sketch0.moveTo(0.420230, 0.132072).circle(0.024013)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.601562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch1.moveTo(0.146053, 0.000000).circle(0.146053)
loop7=wp_sketch1.moveTo(0.146053, 0.000000).circle(0.097368)
solid1=wp_sketch1.add(loop6).add(loop7).extrude(0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
