wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, -0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.414474, -0.236842).threePointArc((0.651316, -0.300823), (0.888158, -0.236842)).lineTo(1.317434, 0.000000).threePointArc((1.411000, 0.162829), (1.317434, 0.325658)).lineTo(0.888158, 0.562500).threePointArc((0.651316, 0.626481), (0.414474, 0.562500)).lineTo(0.000000, 0.325658).threePointArc((-0.093566, 0.162829), (0.000000, 0.000000)).close()
