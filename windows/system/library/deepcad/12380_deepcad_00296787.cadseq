import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.468750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.022112, -0.053382), (0.075493, -0.075493)).lineTo(1.119819, -0.075493).threePointArc((1.173201, -0.053382), (1.195312, 0.000000)).lineTo(1.195312, 0.805263).threePointArc((1.173201, 0.858645), (1.119819, 0.880757)).lineTo(0.075493, 0.880757).threePointArc((0.022112, 0.858645), (0.000000, 0.805263)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
