# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00389425" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.769737, -0.067352).threePointArc((0.911296, 0.062541), (0.769737, 0.192434)).lineTo(0.000000, 0.125082).threePointArc((-0.057387, 0.062541), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.779359, -0.048109).threePointArc((0.899946, 0.062541), (0.779359, 0.173191)).lineTo(0.000000, 0.115461).threePointArc((-0.044144, 0.067352), (0.000000, 0.019243)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
