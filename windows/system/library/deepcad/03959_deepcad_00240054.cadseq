loop3=wp_sketch1.moveTo(0.104852, 0.000000).lineTo(0.209704, 0.000000).lineTo(0.209704, 0.293586).threePointArc((0.104852, 0.398438), (0.000000, 0.293586)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.104852, 0.293586).circle(0.041941)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(-0.351562)
