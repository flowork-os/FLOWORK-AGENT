# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.195312, 0.351562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.191776, -0.098012), (0.383553, 0.000000)).lineTo(0.383553, 0.414062).lineTo(0.000000, 0.414062).lineTo(0.000000, 0.000000).close()
