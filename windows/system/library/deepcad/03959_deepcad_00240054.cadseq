# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, -0.578125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.167763, -0.167763), (0.335526, 0.000000)).lineTo(0.335526, 1.160362).threePointArc((0.167763, 1.328125), (0.000000, 1.160362)).lineTo(0.000000, 0.000000).close()
