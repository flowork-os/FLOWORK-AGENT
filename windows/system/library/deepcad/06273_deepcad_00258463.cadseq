# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00258463" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.437500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.844243, -0.271875).lineTo(1.359375, 0.443586).lineTo(0.844243, 1.159046).lineTo(0.000000, 0.887171).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.600987, 0.443586).circle(0.343421)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.382812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
