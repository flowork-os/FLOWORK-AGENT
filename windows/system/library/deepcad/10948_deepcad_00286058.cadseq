import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, -0.601562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.149383, -0.149383), (0.298766, 0.000000)).lineTo(0.298766, 1.195066).threePointArc((0.149383, 1.344449), (0.000000, 1.195066)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.156497, 0.000000).circle(0.085362)
loop2=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.234745, -0.007113), (0.241859, 0.227632)).lineTo(0.241859, 0.455263).threePointArc((0.149383, 0.547738), (0.056908, 0.455263)).lineTo(0.056908, 0.227632).close()
loop3=wp_sketch0.moveTo(0.056908, 0.227632).threePointArc((0.412582, 0.398355), (0.241859, 0.754030)).lineTo(0.241859, 0.981661).threePointArc((0.149383, 1.074137), (0.056908, 0.981661)).lineTo(0.056908, 0.754030).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
