# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00364521" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.119079, 0.000000).threePointArc((1.305592, 0.186513), (1.119079, 0.373026)).lineTo(0.000000, 0.373026).threePointArc((-0.186513, 0.186513), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.193421).circle(0.096711)
loop2=wp_sketch0.moveTo(1.119079, 0.193421).circle(0.096711)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.046875, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
