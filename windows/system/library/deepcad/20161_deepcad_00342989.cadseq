# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00342989" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.492188, 0.000000).lineTo(1.492188, 0.596875).lineTo(0.000000, 0.596875).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.392681, 0.251316).circle(0.109951)
loop2=wp_sketch0.moveTo(1.115214, 0.267023).circle(0.109951)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.445312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.359375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(1.492188, 0.000000).lineTo(1.492188, 0.157072).lineTo(0.000000, 0.157072).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.335938)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.359375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(1.492188, 0.000000).lineTo(1.492188, 0.157072).lineTo(0.000000, 0.157072).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.109375)
solid_temp=solid_temp.union(solid1)
solid=solid.union(solid_temp)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.343750, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.114474, 0.000000).circle(0.114474)
solid2=wp_sketch2.add(loop4).extrude(0.875000)
solid_temp=solid2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.343750, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.114474, 0.000000).circle(0.114474)
solid2=wp_sketch2.add(loop4).extrude(-0.992188)
solid_temp=solid_temp.union(solid2)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
