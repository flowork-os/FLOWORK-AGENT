import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, -0.578125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.509996, -0.068644), (0.915296, 0.248438)).lineTo(1.085280, 0.248438).lineTo(1.085280, 0.902220).lineTo(0.915296, 0.902220).threePointArc((0.509996, 1.219301), (0.000000, 1.150658)).lineTo(0.078454, 1.006826).threePointArc((0.829371, 0.575329), (0.078454, 0.143832)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.500000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.750000, 0.320312, 0.203125), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.043503, 0.000000).lineTo(0.043503, -0.090789).lineTo(0.122944, -0.090789).lineTo(0.122944, 0.179688).lineTo(0.043503, 0.179688).lineTo(0.043503, 0.088898).lineTo(0.000000, 0.088898).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.453125)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.796875, 0.320312, 0.203125), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.044326, 0.000000).lineTo(0.044326, 0.085938).lineTo(0.000000, 0.085938).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.453125)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
