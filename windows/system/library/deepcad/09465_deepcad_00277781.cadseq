# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.114474, 0.000000).circle(0.114474)
loop7=wp_sketch3.moveTo(0.114474, 0.000000).circle(0.033388)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.007812)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch4.moveTo(0.150000, 0.000000).circle(0.150000)
loop9=wp_sketch4.moveTo(0.150000, 0.000000).circle(0.065625)
