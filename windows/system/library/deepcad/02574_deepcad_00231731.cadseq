# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231731" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.657072, 0.000000).lineTo(0.657072, 0.496299).lineTo(0.489309, 0.664062).lineTo(0.000000, 0.664062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.608141, 0.041941).lineTo(0.608141, 0.475329).lineTo(0.468339, 0.622122).lineTo(0.041941, 0.622122).lineTo(0.041941, 0.041941).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
