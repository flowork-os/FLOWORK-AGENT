# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.062500, -0.687500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch2.moveTo(0.632812, 0.000000).lineTo(0.632812, 0.632812).lineTo(0.000000, 0.632812).lineTo(0.000000, 0.000000).close()
