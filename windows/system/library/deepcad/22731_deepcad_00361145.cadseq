# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00361145" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, 0.250000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.199674, -0.410886), (0.245888, -0.310033)).lineTo(0.497122, -0.310033).lineTo(0.497122, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, -0.256579).circle(0.037418)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.289062, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
