# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00265236" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.679688, 0.054688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.234375, 0.000000).lineTo(1.234375, 0.493750).lineTo(0.675658, 0.493750).lineTo(0.688651, 0.480757).lineTo(0.467763, 0.285855).lineTo(0.298849, 0.493750).lineTo(0.000000, 0.493750).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.390625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.390625, 0.562500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.012336, -0.016447).lineTo(0.201480, -0.016447).lineTo(0.390625, -0.016447).lineTo(0.217928, 0.185033).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.390625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
