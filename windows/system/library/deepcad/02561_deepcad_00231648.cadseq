loop1=wp_sketch1.moveTo(0.298191, 0.000000).lineTo(0.298191, 0.765625).lineTo(0.282072, 0.765625).lineTo(0.282072, 0.548026).lineTo(0.282072, 0.016118).lineTo(0.016118, 0.016118).lineTo(0.016118, 0.265954).lineTo(0.000000, 0.265954).lineTo(0.000000, 0.000000).close()
