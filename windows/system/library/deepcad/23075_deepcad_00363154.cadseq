# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00363154" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, -0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.398931, 0.061680), (0.797862, 0.000000)).threePointArc((1.152841, 0.259910), (0.797862, 0.519819)).threePointArc((0.398931, 0.458139), (0.000000, 0.519819)).threePointArc((-0.354979, 0.259910), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.084622, 0.253865).circle(0.120888)
loop2=wp_sketch0.moveTo(0.882484, 0.253865).circle(0.120888)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
