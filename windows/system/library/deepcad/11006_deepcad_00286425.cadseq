wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.721628, 0.000000).lineTo(1.054688, -0.044408).lineTo(1.054688, 0.188734).lineTo(0.543997, 0.188734).lineTo(0.543997, 0.377467).lineTo(0.444079, 0.610609).lineTo(0.444079, 0.754934).lineTo(0.188734, 0.754934).lineTo(0.188734, 0.588405).lineTo(0.000000, 0.444079).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.117188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
