wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, -0.664062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.026158, -0.063151), (0.089309, -0.089309)).lineTo(0.744243, -0.089309).threePointArc((0.807395, -0.063151), (0.833553, 0.000000)).lineTo(0.833553, 1.324753).threePointArc((0.807395, 1.387904), (0.744243, 1.414062)).lineTo(0.089309, 1.414062).threePointArc((0.026158, 1.387904), (0.000000, 1.324753)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.119079, 0.000000).circle(0.044655)
loop2=wp_sketch0.moveTo(0.119079, 1.324753).circle(0.044655)
loop3=wp_sketch0.moveTo(0.580510, 0.163734).lineTo(0.580510, 0.669819).lineTo(0.580510, 1.161020).lineTo(0.253043, 1.161020).lineTo(0.253043, 0.669819).lineTo(0.253043, 0.163734).close()
