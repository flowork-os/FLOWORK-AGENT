# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00304187" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, 0.671875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.082895, 0.000000).circle(0.082895)
loop1=wp_sketch0.moveTo(0.082895, 0.000000).circle(0.041447)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.125000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.081250, 0.081250), (0.162500, 0.000000)).lineTo(0.162500, 0.812500).threePointArc((0.081250, 0.731250), (0.000000, 0.812500)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.125000, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.082895, 0.000000).circle(0.082895)
loop4=wp_sketch2.moveTo(0.082895, 0.000000).circle(0.041447)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.125000, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.078125, 0.539062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.160609, 0.000000).lineTo(0.160609, 0.242188).lineTo(0.000000, 0.242188).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(-0.078125, both=True)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.132812, -0.234375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.048355, 0.000000).lineTo(0.048355, 0.164062).lineTo(0.000000, 0.164062).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(-0.078125, both=True)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.078125, -0.234375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop7=wp_sketch5.moveTo(0.048355, 0.000000).lineTo(0.048355, 0.164062).lineTo(0.000000, 0.164062).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop7).extrude(-0.078125, both=True)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
