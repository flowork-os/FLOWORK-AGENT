wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.242188, 0.000000, 0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.026533, -0.041972), (0.010691, -0.074836)).lineTo(0.507812, -0.074836).lineTo(0.486431, -0.058799).lineTo(0.016036, -0.058799).threePointArc((-0.002576, -0.042367), (0.010691, -0.021382)).lineTo(0.507812, 0.138980).lineTo(0.497122, 0.160362).lineTo(0.000000, 0.000000).close()
