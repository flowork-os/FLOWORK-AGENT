# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00372986" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.087664, -0.202303).threePointArc((0.283224, -0.329528), (0.478783, -0.202303)).lineTo(0.566447, 0.000000).lineTo(0.566447, 0.640625).lineTo(0.000000, 0.640625).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, -0.070312, 0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.115132, 0.000000).lineTo(0.227385, 0.000000).threePointArc((0.271998, 0.044613), (0.227385, 0.089227)).lineTo(0.115132, 0.089227).lineTo(0.000000, 0.089227).threePointArc((-0.044613, 0.044613), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(-0.562500)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
