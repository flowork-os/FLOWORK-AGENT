# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00372283" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.012500, 0.000000).lineTo(0.012500, 0.012500).lineTo(0.060938, 0.012500).lineTo(0.060938, -0.112500).lineTo(0.075000, -0.112500).lineTo(0.087500, -0.112500).lineTo(0.087500, 0.012500).lineTo(0.137500, 0.012500).lineTo(0.137500, 0.000000).lineTo(0.148438, 0.000000).lineTo(0.148438, 0.034375).lineTo(0.075000, 0.034375).lineTo(0.000000, 0.034375).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
