loop0=wp_sketch0.moveTo(0.268668, -0.260526).threePointArc((0.334498, -0.357458), (0.358224, -0.472204)).threePointArc((0.381949, -0.357458), (0.447780, -0.260526)).lineTo(0.708306, 0.000000).threePointArc((0.674663, 0.323530), (0.366365, 0.219819)).lineTo(0.358224, 0.187253).lineTo(0.341941, 0.219819).threePointArc((0.033643, 0.323530), (0.000000, 0.000000)).close()
