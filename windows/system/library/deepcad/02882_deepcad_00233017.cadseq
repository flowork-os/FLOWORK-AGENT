# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00233017" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.062500, 0.000000).lineTo(0.062500, 0.003289).threePointArc((0.061537, 0.005615), (0.059211, 0.006579)).lineTo(0.012500, 0.006579).threePointArc((0.008313, 0.008313), (0.006579, 0.012500)).lineTo(0.006579, 0.059211).threePointArc((0.005615, 0.061537), (0.003289, 0.062500)).lineTo(0.000000, 0.062500).lineTo(0.000000, 0.006579).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
