# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, -0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.603947, 0.000000).lineTo(1.195312, 0.000000).lineTo(1.195312, 0.075493).lineTo(0.792681, 0.075493).threePointArc((0.876458, 0.385925), (0.629112, 0.591365)).lineTo(0.629112, 0.515872).threePointArc((0.597656, 0.150597), (0.566201, 0.515872)).lineTo(0.566201, 0.591365).threePointArc((0.318854, 0.385925), (0.402632, 0.075493)).lineTo(0.000000, 0.075493).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
