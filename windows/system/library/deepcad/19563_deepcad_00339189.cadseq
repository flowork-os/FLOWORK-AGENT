wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.378947, 0.000000).lineTo(0.378947, 0.315789).lineTo(0.165789, 0.315789).lineTo(0.165789, 0.513158).lineTo(0.378947, 0.513158).lineTo(0.378947, 0.710526).lineTo(0.284211, 0.710526).lineTo(0.284211, 0.568421).lineTo(0.221053, 0.568421).lineTo(0.221053, 0.710526).lineTo(0.142105, 0.710526).lineTo(0.142105, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.252632, 0.205263).circle(0.007895)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625)
solid=solid0

