# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00344478" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.746053, 0.000000).circle(0.746053)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.139688, 0.346746), (0.481826, 0.497368)).threePointArc((0.319482, 0.541054), (0.248684, 0.388569)).close()
loop2=wp_sketch0.moveTo(0.404112, 0.248684).circle(0.108799)
loop3=wp_sketch0.moveTo(1.212336, -0.295312).threePointArc((0.785965, -0.229490), (0.357484, -0.279770)).close()
loop4=wp_sketch0.moveTo(0.963651, 0.264227).circle(0.108799)
loop5=wp_sketch0.moveTo(0.357484, -0.279770).threePointArc((0.666907, 0.168907), (1.165707, 0.388569)).threePointArc((1.108319, 0.504456), (0.979194, 0.497368)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.148438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
