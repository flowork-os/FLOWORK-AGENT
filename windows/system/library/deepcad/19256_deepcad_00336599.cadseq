import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, 0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.042928, -1.359375).lineTo(0.128783, -1.359375).lineTo(0.143092, -1.359375).lineTo(0.343421, -1.359375).lineTo(0.343421, -1.330757).lineTo(0.143092, -1.330757).lineTo(0.143092, -0.071546).lineTo(0.343421, 0.028618).lineTo(0.271875, 0.143092).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
