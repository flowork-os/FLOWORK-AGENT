# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00301016" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, -0.484375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.060033, 0.000000).lineTo(0.060033, -0.264145).lineTo(0.216118, -0.264145).lineTo(0.216118, -0.204112).lineTo(0.420230, -0.204112).lineTo(0.420230, -0.264145).lineTo(0.570312, -0.264145).lineTo(0.570312, 0.408224).lineTo(0.060033, 0.408224).lineTo(0.060033, 0.204112).lineTo(0.000000, 0.204112).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.507812, 0.000000).lineTo(0.256579, 0.203125).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.256579, 0.074836).circle(0.058799)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.101562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
