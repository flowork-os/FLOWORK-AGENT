# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00269985" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.023438, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.313569, 0.000000).lineTo(0.328865, 0.015296).threePointArc((0.336513, 0.030037), (0.344161, 0.015296)).lineTo(0.359457, 0.000000).lineTo(0.673026, 0.000000).lineTo(0.688322, 0.015296).threePointArc((0.699794, 0.037407), (0.711266, 0.015296)).lineTo(0.718914, 0.000000).threePointArc((0.703592, 0.047709), (0.665378, 0.015296)).lineTo(0.367105, 0.015296).threePointArc((0.336513, 0.048636), (0.305921, 0.015296)).lineTo(0.007648, 0.015296).threePointArc((0.005055, 0.007033), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.012664, 0.012664).threePointArc((0.023602, 0.033745), (0.034539, 0.012664)).lineTo(0.047204, 0.000000).threePointArc((0.023602, 0.051529), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.046875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
