import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.142105, 0.000000).threePointArc((0.158853, 0.006937), (0.165789, 0.023684)).lineTo(0.165789, 0.094737).threePointArc((0.166276, 0.098684), (0.165789, 0.102632)).lineTo(0.292105, 0.347368).threePointArc((0.299027, 0.375000), (0.292105, 0.402632)).lineTo(0.165789, 0.647368).threePointArc((0.166276, 0.651316), (0.165789, 0.655263)).lineTo(0.165789, 0.726316).threePointArc((0.158853, 0.743063), (0.142105, 0.750000)).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.236842, 0.378947).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
