# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220104" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, -0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.973684, 0.060855).threePointArc((1.156824, 0.255592), (0.973684, 0.450329)).lineTo(0.012171, 0.511184).threePointArc((0.223840, 0.250407), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.961513, 0.255592).circle(0.109539)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.260526, 0.000000).circle(0.255099)
loop3=wp_sketch1.moveTo(0.260526, 0.000000).circle(0.130263)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.515625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
