# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00254411" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, -0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.007812).threePointArc((-0.000024, 0.003906), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.359375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.000024, 0.003906), (0.000000, 0.007812)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, -0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.718750, 0.000000).lineTo(0.718750, 0.287500).threePointArc((0.540954, 0.111873), (0.363158, 0.287500)).threePointArc((0.185362, 0.102138), (0.000000, 0.279934)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.750000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.177796, 0.175627), (0.355592, 0.000000)).threePointArc((0.533388, 0.185362), (0.718750, 0.007566)).lineTo(0.718750, 0.287500).lineTo(0.000000, 0.287500).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.750000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
