# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236383" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, -0.718750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.108224, 0.000000).lineTo(0.108224, 1.468750).lineTo(0.000000, 1.468750).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.030921, 0.015461).circle(0.015461)
loop2=wp_sketch0.moveTo(0.030921, 1.453289).circle(0.015461)
loop3=wp_sketch0.moveTo(0.077303, 0.015461).circle(0.015461)
loop4=wp_sketch0.moveTo(0.077303, 1.453289).circle(0.015461)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
