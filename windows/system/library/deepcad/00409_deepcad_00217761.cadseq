# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00217761" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.039062, 0.703125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.398026, -0.343750).threePointArc((0.395765, -0.309827), (0.429688, -0.307566)).lineTo(0.031661, 0.036184).threePointArc((0.033923, 0.002262), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.054688, 0.726562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.023684, 0.000000).circle(0.023191)
loop2=wp_sketch1.moveTo(0.023684, 0.000000).circle(0.011842)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.343750, 0.382812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.023684, 0.000000).circle(0.023191)
loop4=wp_sketch2.moveTo(0.023684, 0.000000).circle(0.011842)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.031250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
