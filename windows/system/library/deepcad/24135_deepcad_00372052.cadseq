wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004408, -0.010641), (0.015049, -0.015049)).lineTo(1.414638, -0.015049).threePointArc((1.425280, -0.010641), (1.429688, 0.000000)).lineTo(1.429688, 0.210691).threePointArc((1.425280, 0.221332), (1.414638, 0.225740)).lineTo(0.015049, 0.225740).threePointArc((0.004408, 0.221332), (0.000000, 0.210691)).lineTo(0.000000, 0.000000).close()
