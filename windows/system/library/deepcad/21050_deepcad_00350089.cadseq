import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.136184, -0.438816).lineTo(0.544737, -0.438816).lineTo(1.437500, -0.438816).lineTo(1.437500, -0.090789).lineTo(1.044079, -0.090789).lineTo(0.877632, 0.242105).lineTo(0.438816, 0.242105).lineTo(0.348026, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.304688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
