# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00383935" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.148438, 0.156250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009273, -0.022388), (0.031661, -0.031661)).lineTo(0.392599, -0.031661).lineTo(0.582566, 0.018997).threePointArc((0.598396, 0.047492), (0.569901, 0.063322)).lineTo(0.392599, 0.018997).lineTo(0.139309, 0.018997).lineTo(0.139309, 0.006332).lineTo(0.050658, 0.006332).threePointArc((0.037225, 0.011896), (0.031661, 0.025329)).lineTo(0.031661, 0.101316).threePointArc((0.015831, 0.085485), (0.000000, 0.101316)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.718750, 0.203125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.007895, 0.000000).circle(0.007895)
solid1=wp_sketch1.add(loop1).extrude(-0.070312, both=True)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
