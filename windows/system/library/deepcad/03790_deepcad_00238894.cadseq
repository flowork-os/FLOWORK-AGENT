import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.421875, 0.000000).lineTo(1.421875, 0.419079).lineTo(1.137500, 0.718421).lineTo(0.853125, 0.718421).lineTo(0.853125, 0.493914).lineTo(1.062664, 0.493914).lineTo(1.062664, 0.209539).lineTo(0.359211, 0.209539).lineTo(0.359211, 0.493914).lineTo(0.568750, 0.493914).lineTo(0.568750, 0.718421).lineTo(0.284375, 0.718421).lineTo(0.000000, 0.419079).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.351562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
