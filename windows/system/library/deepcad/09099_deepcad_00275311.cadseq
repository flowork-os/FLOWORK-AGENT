# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00275311" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, -0.609375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.950203, 0.609910), (0.000000, 1.219819)).lineTo(0.227878, 0.817681).threePointArc((0.059488, 0.609910), (0.227878, 0.402138)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.281497, 0.603207).circle(0.147451)
loop2=wp_sketch0.moveTo(0.737253, 0.603207).circle(0.147451)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.421875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch1.moveTo(0.153947, 0.000000).circle(0.153947)
solid1=wp_sketch1.add(loop3).extrude(-0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.304688, 0.000000, 0.421875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.153947, 0.000000).circle(0.150740)
solid2=wp_sketch2.add(loop4).extrude(-0.062500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
