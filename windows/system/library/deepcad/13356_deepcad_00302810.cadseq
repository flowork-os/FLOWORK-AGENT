# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00302810" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, 0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.314613, -0.695298), (0.945888, -0.266447)).threePointArc((0.678230, 0.211059), (0.133224, 0.159868)).threePointArc((1.150253, -0.823101), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
