# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.515625, -0.343750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.521053, 0.000000).lineTo(0.521053, 0.687500).lineTo(0.000000, 0.687500).lineTo(0.000000, 0.000000).close()
