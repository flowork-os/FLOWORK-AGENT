# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00299422" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.930099, 0.000000).lineTo(0.930099, 0.512747).lineTo(1.132812, 0.512747).lineTo(1.132812, 1.025493).lineTo(0.930099, 1.025493).lineTo(0.930099, 0.846628).lineTo(0.000000, 0.846628).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.536595, 0.155016).lineTo(0.536595, 0.548520).lineTo(0.345806, 0.548520).lineTo(0.345806, 0.155016).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
