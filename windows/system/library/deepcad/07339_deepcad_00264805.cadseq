# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00264805" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.507812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.067710, 0.010672), (0.136184, 0.013816)).threePointArc((0.049852, 0.186708), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.061184, 0.084868).circle(0.055263)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.507812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.072835, -0.019967), (0.140625, 0.013322)).threePointArc((0.069944, 0.010548), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.070312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.507812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((-0.138246, -1.191117), (0.693010, -0.326891)).threePointArc((-0.076317, -0.841369), (0.483799, -0.104605)).threePointArc((0.322544, -0.020550), (0.143832, 0.013076)).threePointArc((0.074392, -0.020698), (0.000000, 0.000000)).close()
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.054892, -0.675465), (0.732237, -0.653783)).threePointArc((-0.282998, -1.033175), (0.117681, -0.026151)).threePointArc((-0.010217, -0.081348), (-0.117681, -0.169984)).lineTo(-0.130757, -0.169984).threePointArc((-0.143351, -0.189918), (-0.156908, -0.209211)).lineTo(-0.169984, -0.222286).threePointArc((-0.208944, -0.298127), (-0.235362, -0.379194)).lineTo(-0.248438, -0.405345).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.070312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
