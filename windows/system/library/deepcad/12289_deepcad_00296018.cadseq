# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.710938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.226562, 0.000000).lineTo(0.369655, 0.274260).lineTo(0.930099, 0.274260).lineTo(0.930099, 1.132812).lineTo(0.679688, 1.132812).lineTo(0.679688, 0.512747).lineTo(0.226562, 0.512747).lineTo(0.226562, 0.846628).lineTo(0.000000, 0.846628).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.382812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
