# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, -0.679688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.071546, 0.000000).lineTo(0.071546, 1.359375).lineTo(0.000000, 1.359375).lineTo(0.000000, 0.000000).close()
