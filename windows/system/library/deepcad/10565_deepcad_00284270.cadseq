# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.000000, 0.679688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.035526, 0.000000).lineTo(0.035526, 0.035526).lineTo(0.035526, 0.070312).lineTo(0.000000, 0.070312).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.007812, both=True)
