wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.006720, -0.016224), (0.022944, -0.022944)).lineTo(0.359457, -0.022944).lineTo(0.359457, -0.007648).lineTo(0.022944, -0.007648).threePointArc((0.017536, -0.005408), (0.015296, 0.000000)).lineTo(0.015296, 0.726562).lineTo(0.000000, 0.726562).lineTo(0.000000, 0.000000).close()
