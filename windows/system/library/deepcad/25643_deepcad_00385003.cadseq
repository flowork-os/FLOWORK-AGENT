# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00385003" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.757895).lineTo(0.000000, 0.757895).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.110526, 0.647368).circle(0.078947)
loop2=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.253754, -0.012616), (0.442105, 0.157895)).lineTo(1.057895, 0.157895).threePointArc((1.199768, 0.210120), (1.263158, 0.347368)).lineTo(1.263158, 0.394737).threePointArc((1.203038, 0.539880), (1.057895, 0.600000)).lineTo(0.442105, 0.600000).threePointArc((0.296962, 0.539880), (0.236842, 0.394737)).lineTo(0.236842, 0.347368).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
