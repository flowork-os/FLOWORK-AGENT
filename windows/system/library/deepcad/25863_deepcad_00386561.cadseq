# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00386561" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.678947, 0.000000).threePointArc((0.746053, 0.067105), (0.678947, 0.134211)).lineTo(0.000000, 0.134211).threePointArc((-0.067105, 0.067105), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.055263, 0.000000).circle(0.055263)
solid1=wp_sketch1.add(loop1).extrude(0.273438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.664062, 0.000000, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.027632, 0.000000).circle(0.027632)
solid2=wp_sketch2.add(loop2).extrude(0.054688)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.312500, 0.000000, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.027632, 0.000000).circle(0.027632)
solid3=wp_sketch3.add(loop3).extrude(0.054688)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
