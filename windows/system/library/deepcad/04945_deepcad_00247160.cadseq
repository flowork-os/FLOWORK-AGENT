import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.054688, 0.000000).lineTo(0.899260, 0.432977).lineTo(0.566201, 0.377467).lineTo(0.566201, 0.410773).lineTo(0.888158, 0.466283).lineTo(0.788240, 0.721628).lineTo(0.244243, 0.621711).lineTo(0.299753, 0.499589).lineTo(0.277549, 0.488487).lineTo(0.222039, 0.621711).lineTo(0.166530, 0.610609).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
