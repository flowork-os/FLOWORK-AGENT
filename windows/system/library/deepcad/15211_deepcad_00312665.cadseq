# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00312665" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, -0.523438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.179030, 0.000000).lineTo(1.179030, 0.378454).lineTo(1.179030, 0.436678).lineTo(1.353701, 0.611349).lineTo(0.815132, 0.436678).lineTo(0.815132, 0.174671).lineTo(0.189227, 0.174671).lineTo(0.189227, 0.786020).lineTo(1.382812, 0.786020).lineTo(1.018914, 1.222697).lineTo(0.000000, 0.786020).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.453125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.000000, -0.343750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.629112, 0.000000).lineTo(0.629112, 0.251645).lineTo(1.170148, 0.427796).lineTo(0.993997, 0.251645).lineTo(0.993997, 0.201316).lineTo(1.195312, 0.201316).lineTo(1.195312, 0.603947).lineTo(0.000000, 0.603947).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.453125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
