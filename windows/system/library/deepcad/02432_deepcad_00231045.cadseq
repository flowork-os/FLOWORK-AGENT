# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231045" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.679688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.239803, 0.000000).lineTo(0.239803, -0.679441).threePointArc((0.632812, -0.286431), (1.025822, -0.679441)).lineTo(1.025822, 0.000000).lineTo(1.265625, 0.000000).lineTo(1.265625, 0.066612).lineTo(0.000000, 0.066612).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.945888, -0.253125).lineTo(0.945888, 0.000000).lineTo(0.319737, 0.000000).lineTo(0.319737, -0.253125).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.234375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.050329, 0.000000).threePointArc((0.398438, 0.348109), (0.746546, 0.000000)).lineTo(0.796875, 0.000000).threePointArc((0.398438, 0.398438), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.234375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.398438, -0.398438), (0.796875, 0.000000)).lineTo(0.746546, 0.000000).threePointArc((0.398438, -0.348109), (0.050329, 0.000000)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.234375)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
