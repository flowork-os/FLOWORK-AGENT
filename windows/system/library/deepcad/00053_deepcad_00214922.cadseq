wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.111648, -0.046246), (0.157895, -0.157895)).lineTo(1.357895, -0.157895).threePointArc((1.402787, -0.065306), (1.500000, -0.031579)).lineTo(1.500000, 0.521053).threePointArc((1.402787, 0.554780), (1.357895, 0.647368)).lineTo(0.142105, 0.647368).threePointArc((0.097213, 0.554780), (0.000000, 0.521053)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
