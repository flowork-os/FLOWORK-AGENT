# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00336066" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, 0.000000, 0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.601562, 0.000000).lineTo(0.601562, 0.601562).lineTo(0.000000, 0.601562).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.569901, 0.031661).lineTo(0.569901, 0.569901).lineTo(0.031661, 0.569901).lineTo(0.031661, 0.031661).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.601562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
