import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.328125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.001927, -0.162979), (0.008141, -0.325658)).lineTo(0.765296, -0.325658).threePointArc((0.775364, -0.162979), (0.773437, 0.000000)).lineTo(0.675740, 0.260526).threePointArc((0.386719, 0.412739), (0.097697, 0.260526)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.056990, -0.179112).circle(0.016283)
loop2=wp_sketch0.moveTo(0.179112, 0.309375).circle(0.016283)
loop3=wp_sketch0.moveTo(0.708306, -0.179112).circle(0.016283)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
