wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.067105, 0.000000).lineTo(0.132812, 0.000000).lineTo(0.132812, 0.022368).lineTo(0.109046, 0.069901).threePointArc((0.066406, 0.096175), (0.023766, 0.069901)).lineTo(0.000000, 0.022368).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.067105, 0.005592).lineTo(0.127220, 0.005592).lineTo(0.127220, 0.020970).lineTo(0.104852, 0.067105).threePointArc((0.066406, 0.090795), (0.027961, 0.067105)).lineTo(0.005592, 0.020970).lineTo(0.005592, 0.005592).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

