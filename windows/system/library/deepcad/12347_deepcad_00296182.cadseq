loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002698, -0.006513), (0.009211, -0.009211)).lineTo(0.100164, -0.009211).threePointArc((0.106677, -0.006513), (0.109375, 0.000000)).lineTo(0.109375, 0.090954).threePointArc((0.106677, 0.097467), (0.100164, 0.100164)).lineTo(0.009211, 0.100164).threePointArc((0.002698, 0.097467), (0.000000, 0.090954)).lineTo(0.000000, 0.000000).close()
