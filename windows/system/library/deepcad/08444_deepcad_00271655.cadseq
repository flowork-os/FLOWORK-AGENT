# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00271655" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.110526).lineTo(0.000000, 0.110526).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.031579, 0.047368).circle(0.015789)
loop2=wp_sketch0.moveTo(1.421053, 0.047368).lineTo(1.421053, 0.063158).lineTo(0.078947, 0.063158).lineTo(0.078947, 0.047368).close()
loop3=wp_sketch0.moveTo(1.468421, 0.047368).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.070312, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(1.351562, 0.000000).lineTo(1.351562, 0.028454).lineTo(0.000000, 0.028454).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop4).extrude(0.070312, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.110526).lineTo(0.000000, 0.110526).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch2.moveTo(0.031579, 0.047368).circle(0.015789)
loop7=wp_sketch2.moveTo(1.421053, 0.047368).lineTo(1.421053, 0.063158).lineTo(0.078947, 0.063158).lineTo(0.078947, 0.047368).close()
loop8=wp_sketch2.moveTo(1.468421, 0.047368).circle(0.015789)
solid2=wp_sketch2.add(loop5).add(loop6).add(loop7).add(loop8).extrude(-0.062500, both=True)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
