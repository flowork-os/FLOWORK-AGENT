import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, -0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.208306, 0.000000).lineTo(0.208306, 0.171546).lineTo(0.000000, 0.171546).threePointArc((-0.165419, 0.336965), (0.000000, 0.502385)).lineTo(0.416612, 0.502385).lineTo(0.833224, 0.502385).threePointArc((0.998643, 0.336965), (0.833224, 0.171546)).lineTo(0.624918, 0.171546).lineTo(0.624918, 0.000000).lineTo(0.833224, 0.000000).threePointArc((1.164062, 0.330839), (0.833224, 0.661678)).lineTo(0.416612, 0.661678).lineTo(0.000000, 0.661678).threePointArc((-0.330839, 0.330839), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.164062, 0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.375000, 0.000000).lineTo(0.375000, 0.165789).threePointArc((0.187500, 0.353289), (0.000000, 0.165789)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.189474, 0.165789).circle(0.102632)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.164062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
