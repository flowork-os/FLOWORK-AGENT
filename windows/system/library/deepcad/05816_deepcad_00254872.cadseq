# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00254872" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.307895, -0.307895), (0.615789, 0.000000)).lineTo(0.457895, 0.607895).threePointArc((0.307895, 0.743847), (0.157895, 0.607895)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.386842, 0.134211).threePointArc((0.153281, 0.000000), (0.386842, -0.134211)).close()
loop2=wp_sketch0.moveTo(0.307895, 0.600000).circle(0.078947)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
