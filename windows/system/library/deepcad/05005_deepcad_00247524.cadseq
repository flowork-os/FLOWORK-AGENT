# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00247524" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.114474, 0.000000).circle(0.114474)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.032797, -0.061952), (0.097780, -0.088240)).lineTo(0.097780, 0.000000).lineTo(0.023849, 0.000000).close()
loop2=wp_sketch0.moveTo(0.097780, 0.009539).lineTo(0.097780, 0.088240).threePointArc((0.047546, 0.061354), (0.023849, 0.009539)).close()
loop3=wp_sketch0.moveTo(0.023849, 0.009539).threePointArc((0.111306, -0.032274), (0.202714, 0.000000)).lineTo(0.114474, 0.000000).lineTo(0.114474, -0.088240).close()
loop4=wp_sketch0.moveTo(0.202714, 0.007155).threePointArc((0.174233, 0.064716), (0.114474, 0.088240)).lineTo(0.114474, 0.016694).lineTo(0.114474, 0.007155).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
