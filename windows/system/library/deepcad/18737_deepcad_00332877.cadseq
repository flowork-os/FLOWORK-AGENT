import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.062500, -0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.050658, 0.000000).lineTo(0.050658, -0.021711).lineTo(0.636842, -0.021711).lineTo(0.636842, 0.000000).lineTo(0.687500, 0.000000).lineTo(0.687500, 0.275000).lineTo(0.636842, 0.275000).lineTo(0.636842, 0.289474).lineTo(0.050658, 0.289474).lineTo(0.050658, 0.275000).lineTo(0.000000, 0.275000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
