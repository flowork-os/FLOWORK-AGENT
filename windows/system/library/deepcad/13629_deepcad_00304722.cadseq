# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.460938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.174013, 0.000000).lineTo(1.343750, 0.000000).lineTo(1.343750, 0.084868).lineTo(0.820395, 0.084868).lineTo(0.820395, 0.438487).lineTo(0.749671, 0.438487).lineTo(0.749671, 0.396053).lineTo(0.749671, 0.084868).lineTo(0.070724, 0.084868).lineTo(0.070724, 0.834539).lineTo(0.070724, 0.876974).lineTo(0.000000, 0.876974).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.312500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.015789, 0.000000).lineTo(0.015789, 0.031250).lineTo(0.000000, 0.031250).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.312500)
