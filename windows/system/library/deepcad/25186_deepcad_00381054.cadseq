wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.351316, 0.000000).lineTo(0.351316, 0.007319).threePointArc((0.333333, 0.047889), (0.292763, 0.065872)).lineTo(0.109786, 0.080510).threePointArc((0.072876, 0.099905), (0.058553, 0.139063)).lineTo(0.058553, 0.556250).threePointArc((0.072876, 0.595408), (0.109786, 0.614803)).lineTo(0.292763, 0.629441).threePointArc((0.333333, 0.647424), (0.351316, 0.687993)).lineTo(0.351316, 0.695312).lineTo(0.000000, 0.695312).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
