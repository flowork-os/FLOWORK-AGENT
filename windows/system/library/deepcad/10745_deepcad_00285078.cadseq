# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285078" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.114474, 0.000000).circle(0.112089)
loop1=wp_sketch0.moveTo(0.114474, 0.000000).circle(0.085855)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.562500, 0.059211).threePointArc((0.500438, 0.115461), (0.562500, 0.171711)).lineTo(0.000000, 0.225000).threePointArc((0.101964, 0.112500), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.384868, 0.082895).threePointArc((0.414474, 0.112500), (0.384868, 0.142105)).lineTo(0.159868, 0.142105).threePointArc((0.130263, 0.112500), (0.159868, 0.082895)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.055263, 0.000000).circle(0.055263)
loop5=wp_sketch2.moveTo(0.055263, 0.000000).circle(0.027632)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.140625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
