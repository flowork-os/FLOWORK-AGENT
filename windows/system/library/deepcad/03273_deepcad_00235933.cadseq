wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.225415, -0.098269), (0.323684, -0.323684)).lineTo(0.378947, -0.323684).lineTo(0.426316, -0.323684).threePointArc((0.524585, -0.098269), (0.750000, 0.000000)).lineTo(0.750000, 0.047368).lineTo(0.750000, 0.094737).lineTo(0.000000, 0.094737).lineTo(0.000000, 0.047368).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625, both=True)
solid=solid0

if __name__ == '__main__':
