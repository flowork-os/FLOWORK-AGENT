# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00224437" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.453783, 0.000000).lineTo(1.273520, 0.424507).threePointArc((1.389172, 0.614803), (1.273520, 0.805099)).lineTo(0.453783, 1.258882).lineTo(0.000000, 1.258882).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.204934, 0.322039).circle(0.146382)
loop2=wp_sketch0.moveTo(0.204934, 0.995395).circle(0.146382)
loop3=wp_sketch0.moveTo(1.171053, 0.585526).threePointArc((1.253563, 0.666036), (1.171053, 0.746546)).lineTo(0.878289, 0.746546).threePointArc((0.958799, 0.666036), (0.878289, 0.585526)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.304688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
