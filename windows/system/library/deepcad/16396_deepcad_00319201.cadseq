# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00319201" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.315789).lineTo(0.000000, 0.315789).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.142105, 0.157895).circle(0.047368)
loop2=wp_sketch0.moveTo(0.378947, 0.157895).circle(0.047368)
loop3=wp_sketch0.moveTo(1.121053, 0.157895).circle(0.047368)
loop4=wp_sketch0.moveTo(1.357895, 0.157895).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.156250, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.008306, 0.034046), (0.000000, 0.068092)).threePointArc((-0.139547, 0.034046), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop5).extrude(-0.828125)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.156250, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.008577, 0.035156), (0.000000, 0.070312)).threePointArc((-0.008577, 0.035156), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop6).extrude(-0.828125)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.156250, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.139547, 0.034046), (0.000000, 0.068092)).threePointArc((0.008306, 0.034046), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop7).extrude(-0.828125)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
