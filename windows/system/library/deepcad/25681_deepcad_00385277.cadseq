# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00385277" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.138158, 0.000000).circle(0.138158)
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.000000, -0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.013459, -0.088312), (0.051974, -0.168914)).threePointArc((0.194748, -0.192843), (0.285855, -0.305345)).threePointArc((0.610699, 0.071356), (0.155921, 0.272862)).threePointArc((0.141466, 0.100142), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.064967, -0.071464).circle(0.025987)
loop3=wp_sketch1.moveTo(0.305345, 0.006497).circle(0.162418)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.132812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.161842, 0.000000).circle(0.161842)
loop5=wp_sketch2.moveTo(0.161842, 0.000000).circle(0.134868)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.375000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
