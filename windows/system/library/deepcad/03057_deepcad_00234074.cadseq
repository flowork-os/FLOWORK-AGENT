# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00234074" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.000000, -0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.832730, 0.000000).threePointArc((0.953934, 0.326069), (0.832730, 0.652138)).lineTo(0.000000, 0.652138).threePointArc((-0.121203, 0.326069), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.190625, 0.200658).threePointArc((0.316036, 0.326069), (0.190625, 0.451480)).lineTo(0.160526, 0.451480).threePointArc((0.035115, 0.326069), (0.160526, 0.200658)).close()
loop2=wp_sketch0.moveTo(0.622039, 0.331086).circle(0.180592)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.117188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
