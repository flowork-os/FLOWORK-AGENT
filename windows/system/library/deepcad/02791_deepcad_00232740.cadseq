import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.000000, 0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.038682, -0.016581), (0.055263, -0.055263)).lineTo(0.055263, -0.750000).lineTo(0.213158, -0.750000).lineTo(0.213158, 0.205263).threePointArc((-0.132842, 0.351261), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.007895, 0.205263).circle(0.078947)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.343750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
