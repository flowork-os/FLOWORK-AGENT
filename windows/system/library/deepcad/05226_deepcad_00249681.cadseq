# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00249681" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.312500, -0.046875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.310362, 0.000000).threePointArc((0.340018, 0.012284), (0.352303, 0.041941)).lineTo(0.352303, 0.796875).lineTo(0.000000, 0.796875).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.310362, 0.041941).circle(0.025164)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
