# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00386899" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.304197, -0.045139), (0.588322, 0.072533)).threePointArc((0.620559, 0.082528), (0.652796, 0.072533)).threePointArc((0.676974, 0.065842), (0.701151, 0.072533)).lineTo(0.757566, 0.104770).threePointArc((0.764512, 0.116859), (0.757566, 0.128947)).lineTo(0.701151, 0.161184).threePointArc((0.672944, 0.170120), (0.644737, 0.161184)).threePointArc((0.572025, 0.144352), (0.515789, 0.193421)).lineTo(0.370724, 0.249836).threePointArc((0.242012, 0.201536), (0.104770, 0.209539)).threePointArc((0.097264, 0.208986), (0.096711, 0.201480)).threePointArc((0.122115, 0.065335), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.118421, 0.000000).circle(0.118421)
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.275744, -0.426538), (0.135691, 0.061678)).lineTo(0.135691, 0.081414).lineTo(0.098684, 0.081414).lineTo(0.098684, 0.061678).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.085938, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
