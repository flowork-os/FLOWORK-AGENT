# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272724" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.218750, 0.000000).lineTo(1.218750, 0.525987).lineTo(0.923684, 0.756908).lineTo(0.320724, 0.756908).lineTo(0.000000, 0.551645).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.230921, 0.230921).circle(0.076974)
loop2=wp_sketch0.moveTo(0.564474, 0.372039).circle(0.192434)
loop3=wp_sketch0.moveTo(0.987829, 0.230921).circle(0.076974)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
