loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((-0.001262, -0.196151), (0.118421, -0.351562)).lineTo(0.284951, -0.351562).threePointArc((0.074882, -0.238009), (0.055510, 0.000000)).lineTo(0.000000, 0.000000).close()
