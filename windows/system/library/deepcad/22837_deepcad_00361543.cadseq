# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00361543" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.539062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.217105, 0.000000).lineTo(0.217105, 0.429688).lineTo(0.000000, 0.429688).threePointArc((0.212223, 0.214844), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.218750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.536842, 0.000000).threePointArc((0.747400, 0.213158), (0.536842, 0.426316)).lineTo(0.000000, 0.426316).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.213158, 0.213158).circle(0.110526)
loop3=wp_sketch1.moveTo(0.536842, 0.213158).circle(0.110526)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.218750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
