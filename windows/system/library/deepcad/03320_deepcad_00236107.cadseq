loop5=wp_sketch0.moveTo(0.868421, -0.536842).threePointArc((1.037344, -0.218344), (0.931579, 0.126316)).lineTo(1.278947, 0.126316).threePointArc((1.331007, 0.149405), (1.342105, 0.205263)).threePointArc((1.195179, 0.437285), (0.963158, 0.584211)).threePointArc((0.903501, 0.585103), (0.868421, 0.536842)).lineTo(0.868421, 0.189474).close()
