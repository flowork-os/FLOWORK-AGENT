loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.328307, 0.001566), (0.647368, 0.078947)).lineTo(0.757895, -0.142105).lineTo(0.852632, 0.078947).threePointArc((0.886486, 0.163016), (0.900000, 0.252632)).lineTo(0.900000, 0.315789).threePointArc((0.750000, 0.465789), (0.600000, 0.315789)).lineTo(0.600000, 0.252632).close()
