wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001566, -0.003780), (0.005345, -0.005345)).lineTo(0.096217, -0.005345).threePointArc((0.099997, -0.003780), (0.101562, 0.000000)).lineTo(0.101562, 0.091941).threePointArc((0.099775, 0.095186), (0.096217, 0.096217)).lineTo(0.005345, 0.096217).threePointArc((0.001787, 0.095186), (0.000000, 0.091941)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002451, -0.001642), (0.005345, -0.001069)).lineTo(0.096217, -0.001069).threePointArc((0.096973, -0.000756), (0.097286, 0.000000)).lineTo(0.097286, 0.091941).threePointArc((0.096973, 0.092697), (0.096217, 0.093010)).lineTo(0.005345, 0.093010).threePointArc((0.004589, 0.092697), (0.004276, 0.091941)).lineTo(0.004276, 0.000000).close()
