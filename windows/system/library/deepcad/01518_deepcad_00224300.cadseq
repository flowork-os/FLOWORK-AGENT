# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.003947, 0.000000).threePointArc((0.002263, 0.000120), (0.000987, -0.000987)).lineTo(0.092763, -0.000987).threePointArc((0.093461, -0.000698), (0.093750, 0.000000)).lineTo(0.093750, 0.090789).threePointArc((0.093665, 0.091981), (0.092763, 0.092763)).lineTo(0.000987, 0.092763).threePointArc((0.000085, 0.091981), (0.000000, 0.090789)).lineTo(0.000000, 0.000000).close()
