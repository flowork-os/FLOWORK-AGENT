wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.087145, -0.210388), (0.297533, -0.297533)).threePointArc((0.404340, -0.257856), (0.451809, -0.154276)).lineTo(1.046875, -0.154276).threePointArc((0.874867, 0.272009), (0.451809, 0.451809)).threePointArc((0.132332, 0.319477), (0.000000, 0.000000)).close()
