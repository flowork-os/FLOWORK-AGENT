# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00259042" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, 0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.042763, -0.812500).threePointArc((0.119737, -0.730652), (0.196711, -0.812500)).lineTo(0.239474, 0.000000).threePointArc((0.119737, -0.108523), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, 0.625000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, -0.015296).threePointArc((0.122249, -0.123774), (0.242188, -0.012747)).lineTo(0.242188, -0.002549).threePointArc((0.122384, 0.121314), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.119819, 0.000000).circle(0.033141)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.125000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, -0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.078947, 0.000000).circle(0.078947)
loop4=wp_sketch2.moveTo(0.078947, 0.000000).circle(0.034539)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.125000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
