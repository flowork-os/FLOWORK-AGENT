loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.007842, -0.044991), (0.012911, -0.090378)).lineTo(0.309868, -0.090378).threePointArc((1.194189, 0.096834), (0.309868, 0.284046)).lineTo(0.012911, 0.284046).threePointArc((0.007842, 0.238659), (0.000000, 0.193668)).lineTo(0.387336, 0.193668).threePointArc((1.134670, 0.096834), (0.387336, 0.000000)).lineTo(0.284046, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.382812)
