# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00324084" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.252632).lineTo(0.000000, 0.252632).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.726316, 0.039474).lineTo(0.726316, 0.213158).lineTo(0.039474, 0.213158).lineTo(0.039474, 0.039474).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.453125, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.252632).lineTo(0.000000, 0.252632).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.710526, 0.039474).lineTo(0.710526, 0.213158).lineTo(0.023684, 0.213158).lineTo(0.023684, 0.039474).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.453125, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.023438, 0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.390625, 0.000000).lineTo(0.390625, 0.168586).lineTo(0.000000, 0.168586).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(-1.000000, both=True)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.406250, 0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.390625, 0.000000).lineTo(0.390625, 0.168586).lineTo(0.000000, 0.168586).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(-1.000000, both=True)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch4.moveTo(1.421875, 0.000000).lineTo(1.421875, 0.823191).lineTo(0.000000, 0.823191).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(0.296875)
solid_temp=solid4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch4.moveTo(1.421875, 0.000000).lineTo(1.421875, 0.823191).lineTo(0.000000, 0.823191).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(-0.039062)
solid_temp=solid_temp.union(solid4)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
