# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284451" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.678947).lineTo(1.357895, 0.678947).lineTo(1.357895, 0.615789).lineTo(0.157895, 0.615789).lineTo(0.157895, 0.678947).lineTo(0.000000, 0.678947).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.357895, 0.031579).lineTo(1.357895, 0.584211).lineTo(0.157895, 0.584211).lineTo(0.157895, 0.031579).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, 0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(1.203125, 0.000000).lineTo(1.203125, 0.063322).lineTo(0.000000, 0.063322).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.148438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, -0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(1.203125, 0.000000).lineTo(1.203125, 0.557237).lineTo(0.000000, 0.557237).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.148438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
