# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.609375, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.000000, 0.093750).threePointArc((-0.046875, 0.046875), (0.000000, 0.000000)).close()
