# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.189474, 0.000000).lineTo(0.189474, -0.055263).lineTo(0.331579, -0.055263).lineTo(0.465789, -0.055263).lineTo(0.465789, 0.000000).lineTo(0.655263, 0.000000).lineTo(0.513158, 0.607895).threePointArc((0.327632, 0.754521), (0.142105, 0.607895)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.331579, 0.560526).circle(0.118421)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
