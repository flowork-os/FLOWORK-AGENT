# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284597" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, 0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.206908, 0.000000).lineTo(0.206908, -0.128618).lineTo(0.531250, -0.128618).lineTo(0.531250, 0.100658).lineTo(0.285197, 0.100658).lineTo(0.285197, 0.212500).lineTo(0.000000, 0.212500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.206908, 0.067105).lineTo(0.206908, 0.128618).lineTo(0.039145, 0.128618).lineTo(0.039145, 0.067105).close()
loop2=wp_sketch0.moveTo(0.369079, -0.011184).circle(0.067105)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.140625, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.164062, 0.000000).lineTo(0.164062, 0.082895).lineTo(0.000000, 0.082895).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.140625, 0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.162664, 0.000000).lineTo(0.162664, 0.176809).lineTo(0.587007, 0.176809).lineTo(0.587007, 0.671875).lineTo(0.000000, 0.671875).lineTo(0.000000, 0.176809).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.495066, 0.275822).circle(0.049507)
loop6=wp_sketch2.moveTo(0.495066, 0.572862).circle(0.049507)
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).extrude(0.062500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
