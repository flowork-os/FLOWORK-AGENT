# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236248" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.742105)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.222391, -0.403688), (0.631579, -0.615789)).lineTo(0.631579, -0.189474).threePointArc((0.613080, -0.144814), (0.568421, -0.126316)).lineTo(0.142105, -0.126316).close()
loop2=wp_sketch0.moveTo(0.568421, 0.126316).threePointArc((0.613080, 0.144814), (0.631579, 0.189474)).lineTo(0.631579, 0.615789).threePointArc((0.312602, 0.445293), (0.142105, 0.126316)).close()
loop3=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.126316)
loop4=wp_sketch0.moveTo(0.142105, 0.126316).threePointArc((0.711683, -0.184403), (1.357895, -0.126316)).lineTo(0.931579, -0.126316).threePointArc((0.886920, -0.144814), (0.868421, -0.189474)).lineTo(0.868421, -0.615789).close()
loop5=wp_sketch0.moveTo(0.868421, -0.615789).threePointArc((1.053695, -0.257817), (0.931579, 0.126316)).lineTo(1.357895, 0.126316).threePointArc((1.187398, 0.445293), (0.868421, 0.615789)).lineTo(0.868421, 0.189474).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.125000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
