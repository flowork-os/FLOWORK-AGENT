# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00347271" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.407237, 0.000000).threePointArc((1.460773, 0.053536), (1.407237, 0.107072)).lineTo(0.000000, 0.107072).threePointArc((-0.053536, 0.053536), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.015296, 0.045888).circle(0.015296)
loop2=wp_sketch0.moveTo(0.703618, 0.045888).circle(0.015296)
loop3=wp_sketch0.moveTo(1.422533, 0.045888).circle(0.015296)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
