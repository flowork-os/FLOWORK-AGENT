# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00301513" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.560526, 0.000000).circle(0.560526)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.134293, -0.507977), (0.642270, -0.373684)).lineTo(0.642270, -0.233553).threePointArc((0.554688, -0.145970), (0.467105, -0.233553)).lineTo(0.467105, -0.373684).close()
loop2=wp_sketch0.moveTo(0.467105, -0.373684).threePointArc((0.858306, -0.157648), (0.642270, 0.233553)).lineTo(0.642270, 0.373684).threePointArc((0.554688, 0.286102), (0.467105, 0.373684)).lineTo(0.467105, 0.233553).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
