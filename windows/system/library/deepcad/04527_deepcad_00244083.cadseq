import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.202303, -0.343914).lineTo(0.273109, -0.343914).lineTo(0.273109, 0.273109).lineTo(0.445066, 0.273109).lineTo(0.445066, -0.343914).lineTo(0.525987, -0.343914).lineTo(0.718174, 0.000000).lineTo(0.718174, 0.960938).lineTo(0.000000, 0.960938).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.203125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
