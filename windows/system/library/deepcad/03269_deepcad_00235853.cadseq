# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00235853" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.110115, -0.508224).threePointArc((0.321875, -0.677705), (0.533635, -0.508224)).lineTo(0.652220, 0.000000).threePointArc((0.656913, 0.076730), (0.643750, 0.152467)).lineTo(0.516694, 0.652220).threePointArc((0.321875, 0.802344), (0.127056, 0.652220)).lineTo(0.000000, 0.152467).threePointArc((-0.008928, 0.076234), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.321875, 0.076234).circle(0.152467)
loop2=wp_sketch0.moveTo(0.321875, -0.457401).circle(0.110115)
loop3=wp_sketch0.moveTo(0.321875, 0.601398).circle(0.110115)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.015625, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
