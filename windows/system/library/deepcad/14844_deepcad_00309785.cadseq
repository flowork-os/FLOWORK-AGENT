# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00309785" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.032372, -0.078154), (0.110526, -0.110526)).lineTo(0.639474, -0.110526).threePointArc((0.717628, -0.078154), (0.750000, 0.000000)).lineTo(0.750000, 0.268421).lineTo(0.686842, 0.268421).lineTo(0.686842, 0.000000).threePointArc((0.671333, -0.029547), (0.639474, -0.039474)).lineTo(0.110526, -0.039474).threePointArc((0.078667, -0.029547), (0.063158, 0.000000)).lineTo(0.063158, 0.268421).lineTo(0.000000, 0.268421).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.484375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.158059, 0.000000).threePointArc((0.242188, 0.084128), (0.326316, 0.000000)).lineTo(0.484375, 0.000000).threePointArc((0.242188, 0.242188), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(-0.070312)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
