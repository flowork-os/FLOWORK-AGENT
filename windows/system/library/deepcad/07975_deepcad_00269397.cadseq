import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.747533, 0.000000).lineTo(0.747533, 0.789062).lineTo(0.000000, 0.789062).lineTo(0.000000, 0.000000).close()
