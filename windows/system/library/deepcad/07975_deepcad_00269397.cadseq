loop7=wp_sketch2.moveTo(0.027632, 0.000000).circle(0.027056)
loop8=wp_sketch2.moveTo(0.027632, 0.000000).circle(0.012664)
solid2=wp_sketch2.add(loop7).add(loop8).extrude(0.039062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.343750, -0.617188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop9=wp_sketch3.moveTo(0.027632, 0.000000).circle(0.027056)
loop10=wp_sketch3.moveTo(0.027632, 0.000000).circle(0.012664)
