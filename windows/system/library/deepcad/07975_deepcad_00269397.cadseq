# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.343750, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop11=wp_sketch4.moveTo(0.027632, 0.000000).circle(0.027056)
loop12=wp_sketch4.moveTo(0.027632, 0.000000).circle(0.012664)
