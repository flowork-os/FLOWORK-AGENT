import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.189474, 0.000000).lineTo(0.189474, 0.331579).lineTo(0.552632, 0.678947).lineTo(0.963158, 1.089474).lineTo(0.963158, 1.500000).lineTo(0.773684, 1.500000).lineTo(0.773684, 1.168421).lineTo(0.410526, 0.821053).lineTo(0.000000, 0.410526).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.289062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
