# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288773" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.268421, 0.000000).circle(0.268421)
loop1=wp_sketch0.moveTo(0.184539, -0.145395).lineTo(0.346711, -0.145395).lineTo(0.430592, 0.000000).lineTo(0.346711, 0.145395).lineTo(0.184539, 0.145395).lineTo(0.100658, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.378947).lineTo(0.000000, 0.378947).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.148438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.079016, -0.187500), (0.000000, -0.375000)).lineTo(0.252632, -0.375000).lineTo(0.252632, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.148438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
