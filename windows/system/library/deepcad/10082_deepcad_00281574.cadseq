solid2=wp_sketch2.add(loop2).extrude(0.460938)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, 0.000000, 0.507812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.453125, 0.000000).lineTo(0.453125, 0.114474).lineTo(0.000000, 0.114474).lineTo(0.000000, 0.000000).close()
