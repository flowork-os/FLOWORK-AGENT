# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, -0.265625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.962171, 0.000000).lineTo(0.962171, 0.331414).lineTo(0.726974, 0.470395).lineTo(0.726974, 0.598684).lineTo(0.962171, 0.737664).lineTo(0.962171, 1.015625).lineTo(0.716283, 1.015625).lineTo(0.523849, 0.908717).lineTo(0.171053, 0.908717).lineTo(0.000000, 0.470395).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
