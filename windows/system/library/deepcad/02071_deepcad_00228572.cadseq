# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00228572" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.315789, 0.000000).lineTo(0.315789, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.142105, 0.071053).lineTo(0.142105, 0.315789).lineTo(0.039474, 0.315789).lineTo(0.039474, 0.071053).close()
loop2=wp_sketch0.moveTo(0.142105, 0.355263).lineTo(0.142105, 0.694737).lineTo(0.039474, 0.694737).lineTo(0.039474, 0.355263).close()
loop3=wp_sketch0.moveTo(0.276316, 0.071053).lineTo(0.276316, 0.315789).lineTo(0.181579, 0.315789).lineTo(0.181579, 0.071053).close()
loop4=wp_sketch0.moveTo(0.276316, 0.355263).lineTo(0.276316, 0.694737).lineTo(0.181579, 0.694737).lineTo(0.181579, 0.355263).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
