# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00354252" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, 0.000000, 0.320312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.189474, 0.000000).circle(0.189474)
loop1=wp_sketch0.moveTo(0.189474, 0.000000).circle(0.075000)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.289062, 0.000000, 0.343750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.075000, 0.000000).circle(0.073438)
solid1=wp_sketch1.add(loop2).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, -0.531250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.281250, 0.000000).lineTo(0.281250, 0.281250).lineTo(0.000000, 0.281250).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.142105, 0.142105).circle(0.074013)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.015625)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.296875, 0.000000, -0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.114474, 0.000000).circle(0.114474)
loop6=wp_sketch3.moveTo(0.114474, 0.000000).circle(0.076316)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(0.015625)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
