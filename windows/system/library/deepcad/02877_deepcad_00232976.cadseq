# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232976" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.000493, 0.000000).lineTo(1.000493, 0.303947).lineTo(1.203125, 0.303947).lineTo(1.203125, 0.797862).lineTo(0.303947, 0.797862).lineTo(0.303947, 0.607895).lineTo(0.000000, 0.607895).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.215296, 0.202632).circle(0.101316)
loop2=wp_sketch0.moveTo(0.899178, 0.101316).circle(0.075987)
loop3=wp_sketch0.moveTo(0.987829, 0.645888).circle(0.126645)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.250000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
