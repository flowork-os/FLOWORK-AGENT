wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.282977, -0.733590), (0.565954, 0.000000)).threePointArc((0.511451, 0.008246), (0.481826, -0.038240)).lineTo(0.481826, -0.061184).threePointArc((0.282977, -0.627867), (0.084128, -0.061184)).lineTo(0.084128, -0.038240).threePointArc((0.054503, 0.008246), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
