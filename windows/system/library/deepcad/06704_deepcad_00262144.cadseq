import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.085526, -0.144737).lineTo(0.230263, -0.230263).lineTo(0.394737, -0.230263).lineTo(0.539474, -0.144737).lineTo(0.625000, 0.000000).lineTo(0.625000, 0.164474).lineTo(0.539474, 0.315789).lineTo(0.394737, 0.394737).lineTo(0.230263, 0.394737).lineTo(0.085526, 0.315789).lineTo(0.000000, 0.164474).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.072368, -0.092105).lineTo(0.223684, -0.197368).lineTo(0.401316, -0.197368).lineTo(0.552632, -0.092105).lineTo(0.605263, 0.085526).lineTo(0.552632, 0.256579).lineTo(0.401316, 0.361842).lineTo(0.223684, 0.361842).lineTo(0.072368, 0.256579).lineTo(0.019737, 0.085526).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.056250, -0.175000).lineTo(0.206250, -0.281250).lineTo(0.387500, -0.281250).lineTo(0.537500, -0.175000).lineTo(0.593750, 0.000000).lineTo(0.537500, 0.175000).lineTo(0.387500, 0.281250).lineTo(0.206250, 0.281250).lineTo(0.056250, 0.175000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.125000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
