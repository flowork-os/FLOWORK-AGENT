# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00336024" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.000000, -0.312500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.464145, -0.109211).lineTo(1.296875, 0.245724).lineTo(0.791776, 0.709868).lineTo(0.273026, 0.587007).lineTo(0.000000, 0.395888).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
