# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.210938, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.295066, 0.000000).lineTo(0.295066, -0.249671).lineTo(0.539062, -0.249671).lineTo(0.539062, 0.522039).lineTo(0.295066, 0.522039).lineTo(0.295066, 0.272368).lineTo(0.000000, 0.272368).lineTo(0.000000, 0.147533).lineTo(0.226974, 0.147533).threePointArc((0.310533, 0.136184), (0.226974, 0.124836)).lineTo(0.000000, 0.124836).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.648438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
