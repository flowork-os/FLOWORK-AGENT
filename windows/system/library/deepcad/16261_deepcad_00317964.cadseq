# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00317964" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, -0.398438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.016752, -0.059894), (0.033553, -0.096464)).lineTo(0.184539, -0.096464).lineTo(0.184539, 0.398438).threePointArc((0.135724, 0.179093), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.492188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.217599, 0.000000).lineTo(0.217599, 0.492187).lineTo(0.000000, 0.492187).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.273438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.218750, 0.000000, -0.492188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.475329, 0.000000).threePointArc((0.529569, 0.044061), (0.497697, 0.106250)).threePointArc((0.201779, 0.238465), (0.000000, 0.492105)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.273438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
