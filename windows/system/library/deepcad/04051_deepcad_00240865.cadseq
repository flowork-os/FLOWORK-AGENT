# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00240865" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.307895, 0.000000).circle(0.307895)
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.123750, -0.012415), (0.227878, -0.080428)).threePointArc((0.517419, -0.211766), (0.817681, -0.107237)).threePointArc((0.919868, -0.031780), (1.045559, -0.013405)).threePointArc((1.273438, 0.214474), (1.045559, 0.442352)).threePointArc((0.901123, 0.466589), (0.790872, 0.562993)).threePointArc((0.520428, 0.650364), (0.254688, 0.549589)).threePointArc((0.143250, 0.458193), (0.000000, 0.442352)).threePointArc((-0.221176, 0.221176), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.000000, 0.214474).circle(0.080428)
loop3=wp_sketch1.moveTo(1.045559, 0.214474).circle(0.080428)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.046875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
