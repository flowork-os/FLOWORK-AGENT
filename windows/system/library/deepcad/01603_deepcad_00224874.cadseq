# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00224874" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.382812, -0.007812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.108964, 0.000000).threePointArc((1.125827, 0.006985), (1.132812, 0.023849)).lineTo(1.132812, 0.071546).threePointArc((1.125827, 0.088410), (1.108964, 0.095395)).lineTo(0.000000, 0.095395).threePointArc((-0.047697, 0.047697), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.023849, 0.047697).circle(0.023849)
loop2=wp_sketch0.moveTo(0.166941, 0.047697).circle(0.023849)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
