wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.142105, 0.000000).threePointArc((0.186039, 0.106066), (0.292105, 0.150000)).lineTo(0.607895, 0.150000).lineTo(0.607895, 0.394737).lineTo(0.750000, 0.663158).lineTo(0.150000, 0.663158).lineTo(0.150000, 0.481579).threePointArc((0.106066, 0.375513), (0.000000, 0.331579)).lineTo(0.000000, 0.000000).close()
