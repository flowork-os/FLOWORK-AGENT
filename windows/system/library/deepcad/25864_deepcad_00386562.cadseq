# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00386562" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.630181, -0.055839).threePointArc((0.760582, 0.063816), (0.630181, 0.183470)).lineTo(0.000000, 0.127632).threePointArc((-0.058556, 0.063816), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.627138, -0.053536).threePointArc((0.727157, 0.038240), (0.627138, 0.130016)).lineTo(0.000000, 0.076480).threePointArc((-0.035089, 0.038240), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.101562)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
