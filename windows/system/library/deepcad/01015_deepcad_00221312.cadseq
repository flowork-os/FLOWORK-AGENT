loop0=wp_sketch0.moveTo(0.211678, 0.000000).lineTo(0.729112, 0.000000).lineTo(0.729112, 0.164638).lineTo(0.211678, 0.164638).lineTo(0.211678, 0.470395).lineTo(0.599753, 0.470395).lineTo(0.599753, 0.635033).lineTo(0.211678, 0.635033).lineTo(0.211678, 0.905510).lineTo(0.729112, 0.905510).lineTo(0.729112, 1.117188).lineTo(0.211678, 1.117188).lineTo(0.000000, 1.117188).lineTo(0.000000, 0.000000).close()
