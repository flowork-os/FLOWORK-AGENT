wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, -0.640625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.030012, -0.072455), (0.102467, -0.102467)).lineTo(0.629441, -0.102467).threePointArc((0.701896, -0.072455), (0.731908, 0.000000)).lineTo(0.731908, 1.288158).threePointArc((0.701896, 1.360613), (0.629441, 1.390625)).lineTo(0.102467, 1.390625).threePointArc((0.030012, 1.360613), (0.000000, 1.288158)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
