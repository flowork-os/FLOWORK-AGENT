# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00362132" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.071053).lineTo(0.071053, 0.071053).lineTo(0.071053, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.062500, 0.000000, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.027138, 0.000000).lineTo(0.054276, 0.044408).lineTo(0.081414, 0.000000).lineTo(0.109786, 0.000000).lineTo(0.070312, 0.059211).lineTo(0.106086, 0.117188).lineTo(0.080181, 0.117188).lineTo(0.055510, 0.075247).lineTo(0.029605, 0.117188).lineTo(0.002467, 0.117188).lineTo(0.039474, 0.060444).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.015625)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.578125, 0.179688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.039474, -0.072780).lineTo(0.039474, -0.117188).lineTo(0.064145, -0.117188).lineTo(0.064145, -0.071546).lineTo(0.102385, 0.000000).lineTo(0.075247, 0.000000).lineTo(0.051809, -0.048109).lineTo(0.027138, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.015625)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
