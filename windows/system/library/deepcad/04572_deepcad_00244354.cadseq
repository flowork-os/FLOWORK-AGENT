import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.507812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.312418, 0.000000).lineTo(0.549424, 0.000000).lineTo(0.549424, 0.150822).lineTo(0.000000, 0.150822).threePointArc((-0.360896, 0.511719), (0.000000, 0.872615)).lineTo(0.549424, 0.872615).lineTo(0.549424, 1.023438).lineTo(0.312418, 1.023438).lineTo(0.000000, 1.023438).threePointArc((-0.475362, 0.511719), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.304688, 0.000000, 0.507812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.242188, 0.000000).lineTo(0.242188, 0.242188).lineTo(0.000000, 0.242188).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.070312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.304688, 0.000000, -0.687500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.242188, 0.000000).lineTo(0.242188, 0.178454).lineTo(0.000000, 0.178454).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.070312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
