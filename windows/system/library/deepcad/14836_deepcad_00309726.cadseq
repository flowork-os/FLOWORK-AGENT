import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.152182, -0.389281), (0.224260, -0.207648)).threePointArc((0.243532, -0.149824), (0.299013, -0.124589)).lineTo(0.789062, -0.124589).lineTo(0.789062, 0.033224).lineTo(0.299013, 0.033224).lineTo(0.299013, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, -0.224260).circle(0.149507)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.492188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
