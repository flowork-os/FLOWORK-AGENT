# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00380253" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.051316, 0.000000).circle(0.050247)
solid0=wp_sketch0.add(loop0).extrude(0.460938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.101562, 0.460938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.127549, -0.239638).lineTo(0.286020, -0.316941).threePointArc((0.263395, -0.247651), (0.332401, -0.224178)).lineTo(0.367188, -0.150740).lineTo(0.231908, 0.100493).lineTo(0.073438, 0.170066).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.226562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
