# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00389367" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.041206, -0.074786), (0.030345, -0.121382)).lineTo(0.849671, -0.010115).threePointArc((0.955048, 0.138488), (0.799095, 0.232648)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.041565, -0.065030), (0.020230, -0.111266)).lineTo(0.849671, 0.000000).threePointArc((0.944159, 0.138488), (0.799095, 0.222533)).lineTo(0.000000, -0.020230).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
