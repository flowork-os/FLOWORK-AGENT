wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, -0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.080798, -0.080798), (0.161595, 0.000000)).lineTo(0.161595, 0.032319).threePointArc((0.165675, 0.052941), (0.183141, 0.064638)).lineTo(0.377056, 0.064638).threePointArc((0.382442, 0.064074), (0.387829, 0.064638)).lineTo(0.420148, 0.043092).lineTo(0.937253, 0.043092).threePointArc((1.023438, 0.129276), (0.937253, 0.215461)).lineTo(0.000000, 0.215461).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.269326, 0.107730).circle(0.010773)
loop2=wp_sketch0.moveTo(0.861842, 0.129276).circle(0.010773)
