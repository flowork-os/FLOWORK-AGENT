# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285323" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.217105, 0.000000).circle(0.212582)
loop1=wp_sketch0.moveTo(0.217105, 0.000000).circle(0.162829)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.320312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.062500, 0.111842).threePointArc((0.945271, 0.218092), (1.062500, 0.324342)).lineTo(0.000000, 0.425000).threePointArc((0.192599, 0.212500), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.726974, 0.156579).threePointArc((0.782895, 0.212500), (0.726974, 0.268421)).lineTo(0.301974, 0.268421).threePointArc((0.246053, 0.212500), (0.301974, 0.156579)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.210938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.429688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.106579, 0.000000).circle(0.104359)
loop5=wp_sketch2.moveTo(0.106579, 0.000000).circle(0.053289)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.265625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
