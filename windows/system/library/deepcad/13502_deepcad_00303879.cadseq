import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.195312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.228618, 0.125740).lineTo(1.085938, 0.251480).lineTo(1.085938, 0.365789).lineTo(0.000000, 0.205757).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.160033, 0.137171).lineTo(0.160033, 0.182895).lineTo(0.045724, 0.160033).lineTo(0.045724, 0.080016).close()
loop2=wp_sketch0.moveTo(0.514391, 0.217188).lineTo(0.514391, 0.240049).lineTo(0.320066, 0.205757).lineTo(0.320066, 0.182895).close()
loop3=wp_sketch0.moveTo(0.857319, 0.262911).lineTo(0.857319, 0.285773).lineTo(0.685855, 0.262911).lineTo(0.685855, 0.240049).close()
loop4=wp_sketch0.moveTo(1.017352, 0.297204).circle(0.011431)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
