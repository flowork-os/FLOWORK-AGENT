# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00259033" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.041622, -0.100484), (0.142105, -0.142105)).lineTo(1.357895, -0.142105).threePointArc((1.458378, -0.100484), (1.500000, 0.000000)).lineTo(1.500000, 0.063158).threePointArc((1.487481, 0.077593), (1.468421, 0.078947)).lineTo(0.031579, 0.078947).threePointArc((0.012519, 0.077593), (0.000000, 0.063158)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.078947, 0.000000).circle(0.031579)
loop2=wp_sketch0.moveTo(0.300000, -0.078947).circle(0.031579)
loop3=wp_sketch0.moveTo(1.200000, -0.078947).circle(0.031579)
loop4=wp_sketch0.moveTo(1.421053, 0.000000).circle(0.031579)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
