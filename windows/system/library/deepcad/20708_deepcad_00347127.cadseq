# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00347127" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.609375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.215789).lineTo(0.000000, 1.215789).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.342105, 0.394737).lineTo(1.342105, 0.821053).lineTo(0.915789, 0.821053).lineTo(0.915789, 0.394737).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
