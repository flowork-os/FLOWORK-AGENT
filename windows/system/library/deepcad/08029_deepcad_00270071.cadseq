# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00270071" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, -0.445312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.015625, 0.000000).lineTo(1.015625, 0.898026).lineTo(0.000000, 0.898026).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.203125, 0.160362).circle(0.053454)
loop2=wp_sketch0.moveTo(0.203125, 0.726974).circle(0.053454)
loop3=wp_sketch0.moveTo(0.812500, 0.160362).circle(0.053454)
loop4=wp_sketch0.moveTo(0.812500, 0.726974).circle(0.053454)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
