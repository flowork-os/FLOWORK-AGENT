wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, -0.648438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.030181, -0.072862), (0.103043, -0.103043)).lineTo(1.324836, -0.103043).lineTo(1.324836, 1.324836).lineTo(1.295395, 1.324836).lineTo(1.295395, 1.368997).lineTo(1.236513, 1.368997).lineTo(1.236513, 1.398438).lineTo(0.000000, 1.398438).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
