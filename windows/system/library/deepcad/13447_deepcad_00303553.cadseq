# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00303553" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.600000).lineTo(0.000000, 0.600000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.110526, 0.473684).lineTo(0.142105, 0.505263).lineTo(0.118421, 0.544737).lineTo(0.078947, 0.536842).lineTo(0.071053, 0.497368).close()
loop2=wp_sketch0.moveTo(0.600000, 0.300000).circle(0.110526)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.187500, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
