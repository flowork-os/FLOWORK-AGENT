# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00254898" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.250000, 0.000000).lineTo(1.039474, 0.000000).lineTo(1.250000, 0.000000).lineTo(1.250000, 0.368421).lineTo(0.250000, 0.368421).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.250000, 0.065789).circle(0.013158)
loop2=wp_sketch0.moveTo(1.039474, 0.065789).circle(0.013158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.210938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.250000, 0.000000).lineTo(1.039474, 0.000000).lineTo(1.250000, 0.000000).lineTo(1.250000, 0.368421).lineTo(0.250000, 0.368421).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.250000, 0.065789).circle(0.013158)
loop5=wp_sketch1.moveTo(1.039474, 0.065789).circle(0.013158)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.414062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch2.moveTo(0.250000, 0.000000).lineTo(1.039474, 0.000000).lineTo(1.250000, 0.000000).lineTo(1.250000, 0.368421).lineTo(0.250000, 0.368421).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch2.moveTo(0.250000, 0.065789).circle(0.013158)
loop8=wp_sketch2.moveTo(1.039474, 0.065789).circle(0.013158)
solid2=wp_sketch2.add(loop6).add(loop7).add(loop8).extrude(0.210938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
