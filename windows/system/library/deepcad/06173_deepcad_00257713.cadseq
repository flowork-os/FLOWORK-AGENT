wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.421875, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.034539, 0.000000).threePointArc((0.164062, -0.129523), (0.293586, 0.000000)).lineTo(0.328125, 0.000000).lineTo(0.328125, 0.379934).threePointArc((0.164062, 0.543997), (0.000000, 0.379934)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.113944, 0.119538), (0.276316, 0.149671)).lineTo(0.276316, 0.379934).threePointArc((0.166941, 0.489309), (0.057566, 0.379934)).lineTo(0.057566, 0.149671).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
