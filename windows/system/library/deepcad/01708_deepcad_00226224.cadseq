# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00226224" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.060855, 0.000000).threePointArc((1.139358, 0.032517), (1.171875, 0.111020)).lineTo(1.171875, 0.333059).threePointArc((1.138564, 0.410768), (1.060855, 0.444079)).lineTo(0.000000, 0.444079).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.419408, 0.222039).circle(0.061678)
loop2=wp_sketch0.moveTo(0.999178, 0.172697).threePointArc((1.054688, 0.228207), (0.999178, 0.283717)).lineTo(0.764803, 0.283717).threePointArc((0.709293, 0.228207), (0.764803, 0.172697)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
