# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306659" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.363158).lineTo(0.000000, 0.363158).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.742105, 0.007895).lineTo(0.742105, 0.355263).lineTo(0.007895, 0.355263).lineTo(0.007895, 0.007895).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.609375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.734375, 0.000000).lineTo(0.734375, 0.347862).lineTo(0.000000, 0.347862).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.578125, 0.000000).threePointArc((0.694135, 0.048053), (0.742188, 0.164062)).lineTo(0.742188, 0.359375).lineTo(0.000000, 0.359375).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.601562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
