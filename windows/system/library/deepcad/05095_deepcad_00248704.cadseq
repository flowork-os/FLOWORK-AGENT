wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.015789, 0.000000).lineTo(0.015789, 0.576316).threePointArc((0.020782, 0.617844), (0.039474, 0.655263)).lineTo(0.118421, 0.742105).lineTo(0.102632, 0.750000).lineTo(0.031579, 0.663158).threePointArc((0.008255, 0.622477), (0.000000, 0.576316)).lineTo(0.000000, 0.000000).close()
