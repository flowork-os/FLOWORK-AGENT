import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.083224, 0.000000).threePointArc((1.160098, 0.219079), (1.083224, 0.438158)).lineTo(0.000000, 0.438158).threePointArc((-0.076875, 0.219079), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.535526, 0.048684).lineTo(1.022368, 0.048684).threePointArc((1.080024, 0.212993), (1.022368, 0.377303)).lineTo(0.535526, 0.377303).lineTo(0.048684, 0.377303).threePointArc((-0.008972, 0.212993), (0.048684, 0.048684)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.109375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
