# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.059746, -0.324463), (0.221793, -0.611842)).threePointArc((0.553570, -0.678826), (0.604194, -0.344161)).threePointArc((0.498932, -0.186652), (0.466530, 0.000000)).lineTo(0.466530, 0.351809).lineTo(0.000000, 0.351809).lineTo(0.000000, 0.000000).close()
