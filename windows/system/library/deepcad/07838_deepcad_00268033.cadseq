# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00268033" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.544737, 0.000000).lineTo(0.544737, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.450000, 0.157895).lineTo(0.450000, 0.647368).lineTo(0.094737, 0.647368).lineTo(0.094737, 0.157895).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.093750, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.480263, 0.000000).lineTo(0.480263, 0.625000).lineTo(0.000000, 0.625000).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.421053, 0.059211).lineTo(0.421053, 0.552632).lineTo(0.059211, 0.552632).lineTo(0.059211, 0.059211).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.046875)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.546875, 0.000000).lineTo(0.546875, 0.074836).lineTo(0.000000, 0.074836).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.312500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
