loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.015597, -0.023978), (0.022204, -0.051809)).lineTo(0.022204, -0.673520).threePointArc((0.030875, -0.694454), (0.051809, -0.703125)).lineTo(0.066612, -0.703125).threePointArc((0.091247, -0.695987), (0.103618, -0.673520)).lineTo(0.103618, -0.051809).threePointArc((0.106525, -0.024620), (0.118421, 0.000000)).threePointArc((0.059211, 0.125190), (0.000000, 0.000000)).close()
