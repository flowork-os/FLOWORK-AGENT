loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.021678, -0.052335), (0.074013, -0.074013)).lineTo(1.273026, -0.074013).threePointArc((1.317960, -0.049269), (1.332237, 0.000000)).lineTo(1.332237, 1.332237).threePointArc((1.317960, 1.381506), (1.273026, 1.406250)).lineTo(0.074013, 1.406250).threePointArc((0.021678, 1.384572), (0.000000, 1.332237)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.024744, -0.044934), (0.074013, -0.059211)).lineTo(1.273026, -0.059211).threePointArc((1.314894, -0.041868), (1.332237, 0.000000)).lineTo(1.332237, 1.332237).threePointArc((1.314894, 1.374105), (1.273026, 1.391447)).lineTo(0.074013, 1.391447).threePointArc((0.032145, 1.374105), (0.014803, 1.332237)).lineTo(0.014803, 0.000000).close()
