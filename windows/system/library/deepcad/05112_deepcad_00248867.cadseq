# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, -0.054688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.012983, -0.031343), (0.044326, -0.044326)).lineTo(0.544572, -0.044326).threePointArc((0.584870, -0.027634), (0.601562, 0.012664)).lineTo(0.601562, 0.101316).threePointArc((0.584870, 0.141614), (0.544572, 0.158306)).lineTo(0.044326, 0.158306).threePointArc((0.016717, 0.150100), (0.000000, 0.126645)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.375000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
