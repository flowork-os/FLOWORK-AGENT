# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00351417" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, -0.539062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.320312, 0.000000).lineTo(1.320312, 1.084046).lineTo(0.000000, 1.084046).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.292516, 0.027796).lineTo(1.292516, 1.056250).lineTo(0.027796, 1.056250).lineTo(0.027796, 0.027796).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.273438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
