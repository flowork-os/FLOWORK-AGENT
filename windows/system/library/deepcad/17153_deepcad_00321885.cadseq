# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00321885" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.648438, -0.140625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.398438, 0.000000).lineTo(1.398438, 0.426891).lineTo(0.000000, 0.426891).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.295395, 0.103043).threePointArc((1.369164, 0.213446), (1.295395, 0.323849)).lineTo(0.132484, 0.323849).threePointArc((0.058715, 0.213446), (0.132484, 0.103043)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
