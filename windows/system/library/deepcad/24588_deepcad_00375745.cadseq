# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00375745" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.085938, 0.000000, -0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.540296, 0.138076).threePointArc((0.356525, 0.285156), (0.540296, 0.432237)).lineTo(0.000000, 0.570312).threePointArc((0.208786, 0.285156), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.242188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.062500, 0.000000, -0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.031250, 0.006250).threePointArc((0.241752, 0.293750), (0.031250, 0.581250)).lineTo(0.000000, 0.587500).threePointArc((-0.362448, 0.293750), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(-0.062500, 0.293750).circle(0.225000)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.242188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.632812, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.009375, 0.003125).threePointArc((0.117361, 0.146875), (0.009375, 0.290625)).lineTo(0.000000, 0.293750).threePointArc((-0.183515, 0.146875), (0.000000, 0.000000)).close()
loop4=wp_sketch2.moveTo(-0.034375, 0.146875).circle(0.075000)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.242188)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.534375, 0.000000).lineTo(0.534375, 0.126562).lineTo(1.335938, 0.126562).lineTo(1.335938, 0.225000).lineTo(0.421875, 0.225000).lineTo(0.421875, 0.084375).lineTo(0.000000, 0.084375).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.296875, both=True)
solid=solid.intersect(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.632812, -0.093750, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.009375, 0.003125).threePointArc((0.117361, 0.146875), (0.009375, 0.290625)).lineTo(0.000000, 0.293750).threePointArc((-0.183515, 0.146875), (0.000000, 0.000000)).close()
loop7=wp_sketch4.moveTo(-0.034375, 0.146875).circle(0.075000)
solid4=wp_sketch4.add(loop6).add(loop7).extrude(0.148438)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
