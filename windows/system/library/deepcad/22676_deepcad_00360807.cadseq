# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.023438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.149671, -0.069079).lineTo(0.218750, 0.080592).lineTo(0.069079, 0.149671).lineTo(0.000000, 0.000000).close()
