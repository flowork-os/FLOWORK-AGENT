# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.265625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.027748, -0.066989), (0.094737, -0.094737)).lineTo(1.405263, -0.094737).threePointArc((1.472252, -0.066989), (1.500000, 0.000000)).lineTo(1.500000, 0.536842).threePointArc((1.468982, 0.595936), (1.405263, 0.615789)).lineTo(0.094737, 0.615789).threePointArc((0.031018, 0.595936), (0.000000, 0.536842)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.347368, 0.268421).circle(0.063158)
loop2=wp_sketch0.moveTo(0.615789, 0.268421).circle(0.063158)
loop3=wp_sketch0.moveTo(0.884211, 0.268421).circle(0.063158)
loop4=wp_sketch0.moveTo(1.152632, 0.268421).circle(0.063158)
