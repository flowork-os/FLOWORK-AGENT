# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, 0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.074260, -0.371299).lineTo(0.074260, -0.647122).lineTo(0.339474, -0.647122).lineTo(0.551645, -1.007812).lineTo(0.551645, -0.583470).lineTo(0.848684, -0.551645).lineTo(0.530428, -0.254605).lineTo(0.392516, 0.148520).lineTo(0.275822, -0.137911).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.187500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
