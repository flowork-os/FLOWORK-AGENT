# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00329522" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.039474, 0.000000).circle(0.039474)
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.203125, 0.000000).lineTo(0.203125, 0.025658).lineTo(0.147533, 0.025658).lineTo(0.147533, 0.059868).lineTo(0.136842, 0.059868).lineTo(0.119737, 0.089803).threePointArc((0.101562, 0.085604), (0.083388, 0.089803)).lineTo(0.066283, 0.059868).lineTo(0.055592, 0.059868).lineTo(0.055592, 0.025658).lineTo(0.000000, 0.025658).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
