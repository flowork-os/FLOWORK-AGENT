# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.429688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.050871, -0.122813), (0.173684, -0.173684)).lineTo(1.326316, -0.173684).threePointArc((1.449129, -0.122813), (1.500000, 0.000000)).lineTo(1.500000, 0.868421).threePointArc((1.445859, 0.983340), (1.326316, 1.026316)).lineTo(0.173684, 1.026316).threePointArc((0.054141, 0.983340), (0.000000, 0.868421)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.757895, 0.426316).circle(0.331579)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312)
solid=solid0

if __name__ == '__main__':
