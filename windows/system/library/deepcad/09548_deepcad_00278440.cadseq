wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.210938, -0.695312, 0.164062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.142105, 0.000000).circle(0.142105)
loop2=wp_sketch1.moveTo(0.142105, 0.000000).circle(0.088816)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.515625)
solid_temp=solid_temp.union(solid1)
solid=solid.union(solid_temp)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.210938, 0.398438, 0.164062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.134211, 0.000000).circle(0.131414)
loop4=wp_sketch2.moveTo(0.134211, 0.000000).circle(0.081086)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.179688)
solid_temp=solid2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.210938, 0.398438, 0.164062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.134211, 0.000000).circle(0.131414)
loop4=wp_sketch2.moveTo(0.134211, 0.000000).circle(0.081086)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.515625)
solid_temp=solid_temp.union(solid2)
solid=solid.union(solid_temp)

