# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00311487" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.407730, 0.000000).lineTo(0.407730, 0.319572).threePointArc((0.203865, 0.523438), (0.000000, 0.319572)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.203865, 0.319572).circle(0.071628)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.632812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
