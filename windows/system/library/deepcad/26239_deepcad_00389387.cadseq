# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, -0.054688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.684211, -0.059868).threePointArc((0.810041, 0.055592), (0.684211, 0.171053)).lineTo(0.000000, 0.111184).threePointArc((-0.051011, 0.055592), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.692763, -0.042763).threePointArc((0.799952, 0.055592), (0.692763, 0.153947)).lineTo(0.000000, 0.102632).threePointArc((-0.039239, 0.059868), (0.000000, 0.017105)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
