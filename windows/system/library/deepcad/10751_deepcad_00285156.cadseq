# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.398438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013874, -0.033495), (0.047368, -0.047368)).lineTo(1.452632, -0.047368).threePointArc((1.486126, -0.033495), (1.500000, 0.000000)).lineTo(1.500000, 0.757895).threePointArc((1.472252, 0.824884), (1.405263, 0.852632)).lineTo(0.094737, 0.852632).threePointArc((0.027748, 0.824884), (0.000000, 0.757895)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
