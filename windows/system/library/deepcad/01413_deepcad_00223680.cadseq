# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00223680" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.601562, 0.000000).threePointArc((0.481822, 0.234293), (0.601562, 0.468586)).lineTo(0.000000, 0.468586).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.179688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.288158, 0.000000).circle(0.288158)
loop2=wp_sketch1.moveTo(0.288158, 0.000000).circle(0.210115)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.398438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.187500, -0.039062, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.009046, 0.000000).lineTo(0.009046, 0.078125).lineTo(0.000000, 0.078125).threePointArc((-0.002881, 0.039062), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.320312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, -0.039062, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.343750, 0.000000).threePointArc((0.340814, 0.039803), (0.343750, 0.079605)).lineTo(0.000000, 0.079605).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.320312)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
