import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.000000, -0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.807977, 0.000000).lineTo(0.807977, 1.023438).lineTo(0.000000, 1.023438).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.484786, 0.021546).lineTo(0.484786, 0.333964).lineTo(0.021546, 0.333964).lineTo(0.021546, 0.021546).close()
loop2=wp_sketch0.moveTo(0.484786, 0.355510).lineTo(0.484786, 0.678701).lineTo(0.021546, 0.678701).lineTo(0.021546, 0.355510).close()
loop3=wp_sketch0.moveTo(0.484786, 0.700247).lineTo(0.484786, 1.001891).lineTo(0.021546, 1.001891).lineTo(0.021546, 0.700247).close()
loop4=wp_sketch0.moveTo(0.786431, 0.021546).lineTo(0.786431, 1.001891).lineTo(0.517105, 1.001891).lineTo(0.517105, 0.021546).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
