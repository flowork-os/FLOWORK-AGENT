wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.118015, -0.145304), (0.297533, -0.198355)).lineTo(0.749342, -0.198355).threePointArc((0.928860, -0.145304), (1.046875, 0.000000)).lineTo(0.947697, 0.000000).threePointArc((0.863042, -0.081239), (0.749342, -0.110197)).lineTo(0.297533, -0.110197).threePointArc((0.183833, -0.081239), (0.099178, 0.000000)).lineTo(0.000000, 0.000000).close()
