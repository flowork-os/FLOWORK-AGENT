import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.203125, -0.140625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.010691, 0.000000).threePointArc((0.016036, 0.005345), (0.021382, 0.000000)).lineTo(0.203125, 0.000000).lineTo(0.203125, 0.141118).lineTo(0.106908, 0.141118).lineTo(0.106908, 0.132566).lineTo(0.000000, 0.102632).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
