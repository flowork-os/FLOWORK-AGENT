# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00286326" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004721, -0.011397), (0.016118, -0.016118)).lineTo(0.378783, -0.016118).lineTo(0.378783, 0.334457).lineTo(0.378783, 0.382813).lineTo(0.016118, 0.334457).threePointArc((0.005007, 0.329450), (0.000000, 0.318339)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, -0.476562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.749507, 0.000000).threePointArc((0.760904, 0.004721), (0.765625, 0.016118)).lineTo(0.765625, 0.556086).threePointArc((0.756183, 0.578880), (0.733388, 0.588322)).lineTo(0.628618, 0.588322).threePointArc((0.617221, 0.583601), (0.612500, 0.572204)).lineTo(0.612500, 0.475493).lineTo(0.153125, 0.419079).lineTo(0.153125, 0.346546).lineTo(0.000000, 0.346546).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.273438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
