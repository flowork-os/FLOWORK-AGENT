# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00319980" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.125000, 0.218750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.249877, -0.000810), (0.375000, -0.217105)).lineTo(0.375000, 0.284211).lineTo(0.248684, 0.284211).lineTo(0.248684, 0.157895).lineTo(0.000000, 0.157895).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.250000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.252632, 0.000000).circle(0.252632)
loop2=wp_sketch1.moveTo(0.252632, 0.000000).circle(0.126316)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.281250, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.047039, 0.000000).threePointArc((0.090126, 0.070944), (0.153947, 0.124013)).lineTo(0.153947, 0.282237).lineTo(0.406250, 0.282237).lineTo(0.406250, 0.406250).lineTo(0.000000, 0.406250).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.250000)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.234375, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.147862, 0.000000).threePointArc((0.231990, 0.031860), (0.316118, 0.000000)).lineTo(0.484375, 0.000000).lineTo(0.484375, 0.407895).lineTo(0.356908, 0.407895).lineTo(0.356908, 0.280428).lineTo(0.107072, 0.280428).lineTo(0.107072, 0.122368).threePointArc((0.043306, 0.070136), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop4).extrude(-0.250000)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.085938, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.164062, 0.000000).threePointArc((0.082031, 0.031066), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop5).extrude(-0.250000)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch5.moveTo(0.125000, 0.000000).lineTo(0.125000, 0.593750).lineTo(0.000000, 0.593750).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop6).extrude(-1.000000, both=True)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
