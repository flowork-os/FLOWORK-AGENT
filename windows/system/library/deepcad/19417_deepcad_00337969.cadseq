# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00337969" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.607895, 0.000000).circle(0.607895)
loop1=wp_sketch0.moveTo(0.607895, 0.000000).circle(0.493914)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, -0.570312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.245313, 0.038734).lineTo(1.226562, 0.735938).lineTo(1.123273, 0.774671).lineTo(1.123273, 0.813405).lineTo(0.581003, 0.413158).lineTo(0.477714, 0.335691).lineTo(0.245313, 0.154934).lineTo(0.154934, 0.142023).lineTo(0.193668, 0.284046).lineTo(0.245313, 0.361513).lineTo(0.477714, 0.774671).lineTo(0.245313, 0.735938).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, -0.289062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.278043, 0.052385).lineTo(0.382813, 0.128947).lineTo(0.044326, 0.080592).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.007812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
