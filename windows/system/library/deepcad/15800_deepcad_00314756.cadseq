import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.344433, 0.552076), (0.305263, 0.515789)).threePointArc((0.949696, 0.541932), (0.600000, 0.000000)).threePointArc((0.300000, -0.578218), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.410118, 0.609618), (0.305263, 0.442105)).threePointArc((0.930207, 0.536879), (0.536842, 0.042105)).threePointArc((0.300000, -0.560840), (0.063158, 0.042105)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
