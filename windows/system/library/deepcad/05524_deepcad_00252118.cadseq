wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.250000, 0.000000, -0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.000000, -0.029359).lineTo(0.398438, 0.272615).lineTo(0.343914, 0.272615).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.062500, both=True)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.578125, -0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.445312, -0.295312).lineTo(0.445312, -0.271875).lineTo(0.051562, 0.000000).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(0.062500, both=True)
