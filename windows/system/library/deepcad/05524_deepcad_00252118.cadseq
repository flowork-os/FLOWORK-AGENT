loop3=wp_sketch2.moveTo(0.429688, -0.298520).lineTo(0.429688, -0.280428).lineTo(0.063322, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.062500, both=True)
