# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00252118" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.742105)
loop1=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.473684)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.132812, -0.359375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.296875, 0.000000).lineTo(0.296875, 0.031250).lineTo(0.000000, 0.031250).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.250000, both=True)
solid=solid.union(solid1)
