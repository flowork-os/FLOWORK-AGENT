# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.164062, -0.335938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch5.moveTo(0.000000, -0.018421).lineTo(0.437500, 0.276316).lineTo(0.377632, 0.271711).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop6).extrude(0.062500, both=True)
