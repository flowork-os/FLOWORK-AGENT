# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00243584" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.750000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.278947, 0.252632).lineTo(1.278947, 1.247368).lineTo(0.221053, 1.247368).lineTo(0.221053, 0.252632).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.367188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.250000, -0.210938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.500000, 0.000000).lineTo(0.500000, 0.431579).lineTo(0.000000, 0.431579).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.367188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.531250, -0.492188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(1.062500, 0.000000).lineTo(1.062500, 0.984211).lineTo(0.000000, 0.984211).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.782895, 0.279605).lineTo(0.782895, 0.704605).lineTo(0.279605, 0.704605).lineTo(0.279605, 0.279605).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.585938)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.585938, 0.531250, -0.093750), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.000000, 0.187500).threePointArc((-0.093750, 0.093750), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop5).extrude(-0.367188)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.585938, 0.531250, -0.093750), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.093750, 0.093750), (0.000000, 0.187500)).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(-0.367188)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
