import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.554688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.238487, -0.011924).lineTo(1.132812, -0.011924).lineTo(1.132812, 0.178865).lineTo(1.132812, 0.274260).lineTo(1.132812, 0.369655).lineTo(1.132812, 0.560444).lineTo(1.132812, 0.965872).lineTo(0.310033, 0.965872).lineTo(0.310033, 0.560444).lineTo(0.000000, 0.560444).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.250000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
