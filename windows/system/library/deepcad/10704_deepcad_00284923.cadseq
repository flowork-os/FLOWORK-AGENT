# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284923" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.201316, 0.000000).circle(0.197122)
loop1=wp_sketch0.moveTo(0.201316, 0.000000).circle(0.150987)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.296875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.992188, 0.104441).threePointArc((0.882716, 0.203660), (0.992188, 0.302878)).lineTo(0.000000, 0.396875).threePointArc((0.179853, 0.198437), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.678865, 0.146217).threePointArc((0.626645, 0.198437), (0.678865, 0.250658)).lineTo(0.281990, 0.250658).threePointArc((0.229770, 0.198437), (0.281990, 0.146217)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.203125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.351562, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.102632, 0.000000).circle(0.102632)
loop5=wp_sketch2.moveTo(0.102632, 0.000000).circle(0.051316)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.250000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
