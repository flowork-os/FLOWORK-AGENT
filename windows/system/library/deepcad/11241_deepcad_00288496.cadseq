# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288496" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.453125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.900000).lineTo(0.000000, 0.900000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.394737, 0.173684).circle(0.063158)
loop2=wp_sketch0.moveTo(0.394737, 0.726316).circle(0.063158)
loop3=wp_sketch0.moveTo(1.105263, 0.173684).circle(0.063158)
loop4=wp_sketch0.moveTo(1.105263, 0.726316).circle(0.063158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
