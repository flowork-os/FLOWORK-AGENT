# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00274504" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.976563, 0.000000).lineTo(0.976563, 0.976563).lineTo(0.000000, 0.976563).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.493421, 0.133635).lineTo(0.801809, 0.472862).threePointArc((0.771201, 0.757349), (0.493421, 0.688734)).threePointArc((0.210501, 0.763235), (0.174753, 0.472862)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.484375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
