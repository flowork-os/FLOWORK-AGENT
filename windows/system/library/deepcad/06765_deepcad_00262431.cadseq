# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001012, -0.002442), (0.003454, -0.003454)).lineTo(0.051234, -0.003454).threePointArc((0.053676, -0.002442), (0.054687, 0.000000)).lineTo(0.054687, 0.047780).threePointArc((0.053676, 0.050222), (0.051234, 0.051234)).lineTo(0.003454, 0.051234).threePointArc((0.001012, 0.050222), (0.000000, 0.047780)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.003454, -0.001431), (0.006908, 0.000000)).lineTo(0.047780, 0.000000).threePointArc((0.050222, 0.001012), (0.051234, 0.003454)).lineTo(0.051234, 0.044326).threePointArc((0.050222, 0.046768), (0.047780, 0.047780)).lineTo(0.006908, 0.047780).threePointArc((0.004466, 0.046768), (0.003454, 0.044326)).lineTo(0.003454, 0.003454).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, 0.726562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.054687, 0.026480).lineTo(0.000000, 0.026480).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.054688)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, 0.726562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.054687, 0.026480).lineTo(0.000000, 0.026480).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.054688)
solid_temp=solid_temp.union(solid1)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
