# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00305650" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.507812, 0.000000).lineTo(0.507812, 0.085526).lineTo(0.465049, 0.085526).lineTo(0.042763, 0.085526).lineTo(0.000000, 0.085526).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.429688, 0.000000).lineTo(0.429688, 0.085938).lineTo(0.366365, 0.085938).threePointArc((0.214844, 0.016536), (0.063322, 0.085938)).lineTo(0.000000, 0.085938).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.036184, 0.036184).circle(0.018092)
loop3=wp_sketch1.moveTo(0.393503, 0.036184).circle(0.018092)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(-0.070312)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
