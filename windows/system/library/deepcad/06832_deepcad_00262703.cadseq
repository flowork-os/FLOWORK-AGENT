# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00262703" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.226562, -0.265625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.033059, -0.429770).lineTo(0.137747, -0.429770).lineTo(0.137747, -0.176316).threePointArc((0.261719, -0.300288), (0.385691, -0.176316)).lineTo(0.385691, -0.429770).lineTo(0.490378, -0.429770).lineTo(0.523438, 0.000000).lineTo(0.523438, 0.506908).lineTo(0.000000, 0.506908).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.750000, 0.242188, 0.226562), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.523438, 0.000000).lineTo(0.523438, 0.110197).lineTo(0.418750, 0.170806).lineTo(0.104687, 0.170806).lineTo(0.000000, 0.110197).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.210938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
