# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00250750" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.228947, 0.000000).threePointArc((0.258934, 0.006346), (0.284211, 0.023684)).lineTo(0.402632, 0.134211).threePointArc((0.413689, 0.140513), (0.426316, 0.142105)).lineTo(0.750000, 0.142105).lineTo(0.750000, 0.181579).lineTo(0.426316, 0.181579).threePointArc((0.396329, 0.175233), (0.371053, 0.157895)).lineTo(0.260526, 0.047368).threePointArc((0.245522, 0.040280), (0.228947, 0.039474)).lineTo(0.000000, 0.039474).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.390625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.531250, 0.195312, 0.187500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.059211, 0.000000).circle(0.059211)
solid1=wp_sketch1.add(loop1).extrude(-0.164062)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.625000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.796875, 0.000000).lineTo(0.796875, 0.385855).lineTo(0.000000, 0.385855).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.637500, 0.192928).circle(0.058717)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.039062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
