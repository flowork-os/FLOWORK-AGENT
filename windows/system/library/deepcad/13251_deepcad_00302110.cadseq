# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00302110" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.284211).lineTo(0.694737, 0.284211).threePointArc((0.682895, 0.287645), (0.671053, 0.284211)).lineTo(0.000000, 0.284211).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.071053, 0.181579).circle(0.023684)
loop2=wp_sketch0.moveTo(0.071053, 0.244737).circle(0.023684)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.671053, 0.000000).threePointArc((0.682895, 0.040836), (0.694737, 0.000000)).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.071053).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
