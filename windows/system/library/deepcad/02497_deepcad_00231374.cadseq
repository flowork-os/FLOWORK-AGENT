# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.429688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.033553, 0.000000).lineTo(0.796875, 0.000000).lineTo(0.796875, 0.109046).threePointArc((0.792681, 0.109098), (0.788487, 0.109046)).lineTo(0.738158, 0.109046).lineTo(0.058717, 0.109046).lineTo(0.000000, 0.109046).lineTo(0.000000, 0.000000).close()
