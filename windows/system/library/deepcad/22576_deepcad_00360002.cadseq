import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.124342, 0.000000).lineTo(0.124342, 0.186513).lineTo(0.179605, 0.000000).lineTo(0.366118, 0.000000).lineTo(0.366118, 0.656250).lineTo(0.221053, 0.656250).lineTo(0.221053, 0.407566).lineTo(0.151974, 0.649342).lineTo(0.000000, 0.649342).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, -0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.102385, 0.000000).lineTo(0.143339, 0.245724).lineTo(0.211595, 0.245724).lineTo(0.259375, 0.000000).lineTo(0.361760, 0.000000).lineTo(0.245724, 0.491447).lineTo(0.211595, 0.648438).lineTo(0.102385, 0.648438).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.085938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.034128, -0.156990).lineTo(0.156990, -0.156990).lineTo(0.156990, -0.648438).lineTo(0.320806, -0.648438).lineTo(0.320806, -0.163816).lineTo(0.477796, -0.163816).lineTo(0.477796, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.085938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
