# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00325447" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.295395, 0.000000).threePointArc((1.398438, 0.103043), (1.295395, 0.206086)).lineTo(0.000000, 0.206086).threePointArc((-0.103043, 0.103043), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.103043).circle(0.044161)
loop2=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.146935, -0.101517), (0.250247, 0.044161)).lineTo(0.574095, 0.044161).threePointArc((0.625617, 0.095683), (0.574095, 0.147204)).lineTo(0.250247, 0.147204).close()
loop3=wp_sketch0.moveTo(0.750740, 0.103043).circle(0.044161)
loop4=wp_sketch0.moveTo(1.295395, 0.044161).threePointArc((1.348849, 0.095683), (1.295395, 0.147204)).lineTo(0.927385, 0.147204).threePointArc((0.871923, 0.095683), (0.927385, 0.044161)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.093750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
