# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00371578" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.228947, 0.000000).threePointArc((0.453125, 0.224178), (0.228947, 0.448355)).lineTo(0.000000, 0.448355).threePointArc((-0.224178, 0.224178), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.357730, 0.224178).circle(0.033388)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
