# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00370442" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, -0.289062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.578125, 0.000000).lineTo(0.578125, 0.578125).lineTo(0.000000, 0.578125).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.547697, 0.030428).lineTo(0.547697, 0.188651).lineTo(0.030428, 0.188651).lineTo(0.030428, 0.030428).close()
loop2=wp_sketch0.moveTo(0.547697, 0.219079).lineTo(0.547697, 0.359046).lineTo(0.030428, 0.359046).lineTo(0.030428, 0.219079).close()
loop3=wp_sketch0.moveTo(0.547697, 0.389474).lineTo(0.547697, 0.547697).lineTo(0.030428, 0.547697).lineTo(0.030428, 0.389474).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
