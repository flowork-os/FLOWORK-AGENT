import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.184211, 0.000000).lineTo(0.184211, -0.157895).lineTo(1.065789, -0.157895).lineTo(1.065789, 0.000000).lineTo(1.250000, 0.000000).lineTo(1.250000, 0.934211).lineTo(1.065789, 0.934211).lineTo(1.065789, 1.092105).lineTo(0.184211, 1.092105).lineTo(0.184211, 0.934211).lineTo(0.000000, 0.934211).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
