# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.257895, -0.221053).lineTo(0.147368, -0.506579).lineTo(0.386842, -0.294737).lineTo(0.746053, -0.515789).lineTo(0.589474, -0.221053).lineTo(0.875000, 0.000000).lineTo(0.598684, 0.000000).lineTo(0.386842, 0.442105).lineTo(0.202632, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
