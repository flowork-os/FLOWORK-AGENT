# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267706" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.976563, 0.000000).lineTo(0.976563, 0.524260).lineTo(0.750411, 0.750411).lineTo(0.226151, 0.750411).lineTo(0.000000, 0.524260).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.493421, 0.380345).circle(0.267270)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
