import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.585938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.156250, 0.000000).lineTo(0.156250, 0.146382).lineTo(0.133224, 0.146382).lineTo(0.133224, 0.023026).lineTo(0.000000, 0.023026).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.742188, -0.148438, 0.007812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.148438, 0.000000).lineTo(0.148438, 0.017188).lineTo(0.000000, 0.017188).lineTo(0.000000, 0.000000).close()
