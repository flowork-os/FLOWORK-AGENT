loop3=wp_sketch1.moveTo(0.109375, 0.009375).circle(0.003125)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.742188, 0.000000, 0.007812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.085938, 0.000000).lineTo(0.085938, 0.017188).lineTo(0.000000, 0.017188).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.039803, 0.009046).circle(0.002714)
loop6=wp_sketch2.moveTo(0.068750, 0.009046).circle(0.002714)
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).extrude(0.007812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.734375, 0.000000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch3.moveTo(0.007566, 0.000000).lineTo(0.013816, 0.000000).lineTo(0.013816, -0.013816).lineTo(0.015625, -0.013816).lineTo(0.015625, 0.001809).lineTo(0.000000, 0.001809).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop7).extrude(-0.062500)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.742188, 0.070312, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop8=wp_sketch4.moveTo(0.015625, 0.000000).lineTo(0.015625, 0.015625).lineTo(0.013816, 0.015625).lineTo(0.013816, 0.002303).lineTo(0.013816, 0.001809).lineTo(0.000000, 0.001809).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop8).extrude(0.007812)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
