# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00219081" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004794, -0.010996), (0.015789, -0.015789)).threePointArc((0.750000, -0.038322), (1.484211, -0.015789)).threePointArc((1.495206, -0.010996), (1.500000, 0.000000)).lineTo(1.500000, 0.236842).threePointArc((1.495206, 0.247838), (1.484211, 0.252632)).threePointArc((0.750000, 0.275164), (0.015789, 0.252632)).threePointArc((0.004794, 0.247838), (0.000000, 0.236842)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.140625, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.568174, -0.013948), (1.136349, 0.000000)).threePointArc((1.153495, 0.139021), (1.136349, 0.278043)).threePointArc((0.568174, 0.291991), (0.000000, 0.278043)).threePointArc((-0.017147, 0.139021), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(-0.031250)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
