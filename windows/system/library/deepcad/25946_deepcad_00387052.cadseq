import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, 0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.259727, -0.264946), (0.011513, -0.518092)).lineTo(0.575658, -0.518092).lineTo(0.575658, -0.391447).lineTo(1.093750, -0.391447).lineTo(1.093750, -0.126645).lineTo(0.575658, -0.126645).lineTo(0.575658, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, -0.253289).circle(0.126645)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.320312, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
