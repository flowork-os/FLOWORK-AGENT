import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, -0.570312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.181579, -0.181579), (0.363158, 0.000000)).lineTo(0.363158, 0.568421).threePointArc((0.181579, 0.750000), (0.000000, 0.568421)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.169737, -0.169737), (0.339474, 0.000000)).lineTo(0.339474, 0.568421).threePointArc((0.181579, 0.726316), (0.023684, 0.568421)).lineTo(0.023684, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
