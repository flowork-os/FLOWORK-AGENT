wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.265625, 0.539062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.121217, 0.000000).lineTo(0.242434, 0.198355).lineTo(0.363651, 0.000000).lineTo(0.490378, 0.000000).lineTo(0.314062, 0.264474).lineTo(0.473849, 0.523438).lineTo(0.358141, 0.523438).lineTo(0.247944, 0.336102).lineTo(0.132237, 0.523438).lineTo(0.011020, 0.523438).lineTo(0.176316, 0.269984).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.210938)
