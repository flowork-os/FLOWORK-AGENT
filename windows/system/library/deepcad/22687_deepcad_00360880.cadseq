# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.242188, 0.265625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.178947, -0.329934).lineTo(0.178947, -0.531250).lineTo(0.290789, -0.531250).lineTo(0.290789, -0.324342).lineTo(0.464145, 0.000000).lineTo(0.341118, 0.000000).lineTo(0.234868, -0.218092).lineTo(0.123026, 0.000000).lineTo(0.000000, 0.000000).close()
