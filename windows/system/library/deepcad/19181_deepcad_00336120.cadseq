loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((-0.197850, 0.107319), (0.000000, 0.214638)).lineTo(0.000000, 0.226974).lineTo(0.056743, 0.226974).lineTo(0.059211, -0.012336).lineTo(0.000000, -0.012336).lineTo(0.000000, 0.000000).close()
