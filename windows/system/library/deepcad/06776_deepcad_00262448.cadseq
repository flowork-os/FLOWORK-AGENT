loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000434, -0.001047), (0.001480, -0.001480)).lineTo(0.024178, -0.001480).lineTo(0.024178, 0.000000).lineTo(0.001480, 0.000000).lineTo(0.001480, 0.045395).lineTo(0.024178, 0.045395).lineTo(0.024178, 0.046875).lineTo(0.001480, 0.046875).threePointArc((0.000434, 0.046441), (0.000000, 0.045395)).lineTo(0.000000, 0.000000).close()
