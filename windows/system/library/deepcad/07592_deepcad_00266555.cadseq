# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.016162, -0.039019), (0.055181, -0.055181)).lineTo(0.265872, -0.055181).threePointArc((0.302382, -0.037980), (0.316036, 0.000000)).lineTo(0.316036, 0.421382).threePointArc((0.302382, 0.459361), (0.265872, 0.476562)).lineTo(0.055181, 0.476562).threePointArc((0.016162, 0.460400), (0.000000, 0.421382)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.421875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
