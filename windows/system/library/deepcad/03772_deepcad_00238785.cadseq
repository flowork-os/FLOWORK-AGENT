import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.151226, -0.274760), (0.425987, -0.425987)).threePointArc((0.546875, -0.317764), (0.667763, -0.425987)).threePointArc((0.942524, -0.274760), (1.093750, 0.000000)).threePointArc((0.980374, 0.126645), (1.093750, 0.253289)).threePointArc((0.940854, 0.522293), (0.667763, 0.667763)).threePointArc((0.546875, 0.559540), (0.425987, 0.667763)).threePointArc((0.152896, 0.522293), (0.000000, 0.253289)).threePointArc((0.113376, 0.126645), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.625000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.757895)
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.032082, 0.177800), (0.205263, 0.126316)).threePointArc((0.356606, 0.401288), (0.631579, 0.552632)).threePointArc((0.750000, 0.684911), (0.868421, 0.552632)).threePointArc((1.143394, 0.401288), (1.294737, 0.126316)).threePointArc((1.435835, 0.000000), (1.294737, -0.126316)).threePointArc((1.143394, -0.401288), (0.868421, -0.552632)).threePointArc((0.750000, -0.684911), (0.631579, -0.552632)).threePointArc((0.356606, -0.401288), (0.205263, -0.126316)).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.250000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
