wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.273438, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch4.moveTo(0.138158, 0.000000).circle(0.135280)
