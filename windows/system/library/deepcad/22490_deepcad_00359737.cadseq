# workplane for sketch 6
wp_sketch6 = cq.Workplane(cq.Plane(cq.Vector(0.250000, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
