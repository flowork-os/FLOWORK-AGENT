import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.568421).lineTo(0.000000, 0.568421).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.347368, 0.284211).circle(0.157895)
loop2=wp_sketch0.moveTo(1.152632, 0.284211).circle(0.157895)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.250000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
