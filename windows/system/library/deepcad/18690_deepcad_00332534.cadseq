# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00332534" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, -0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.501234, -0.028372).threePointArc((0.574018, -0.048304), (0.633635, -0.094572)).lineTo(0.756579, -0.236431).threePointArc((0.858167, -0.256087), (0.898438, -0.160773)).lineTo(0.784951, 0.151316).threePointArc((0.559755, -0.007033), (0.643092, 0.255345)).lineTo(0.000000, 0.217516).threePointArc((-0.102282, 0.108758), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.009457, 0.104030).circle(0.056743)
loop2=wp_sketch0.moveTo(0.822780, -0.189145).circle(0.047286)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.150000, 0.000000).circle(0.150000)
loop4=wp_sketch1.moveTo(0.150000, 0.000000).circle(0.087500)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.101562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch2.moveTo(0.150000, 0.000000).circle(0.150000)
loop6=wp_sketch2.moveTo(0.150000, 0.000000).circle(0.087500)
solid2=wp_sketch2.add(loop5).add(loop6).extrude(0.273438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
