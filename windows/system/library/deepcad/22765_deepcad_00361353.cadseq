import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.640625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.852632, 0.000000).lineTo(0.852632, 0.221053).lineTo(1.500000, 0.221053).lineTo(1.500000, 1.073684).lineTo(1.073684, 1.073684).lineTo(1.073684, 1.278947).lineTo(0.221053, 1.278947).lineTo(0.221053, 0.647368).lineTo(0.000000, 0.647368).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.426316, 0.315789).circle(0.221053)
loop2=wp_sketch0.moveTo(0.536842, 0.963158).circle(0.110526)
loop3=wp_sketch0.moveTo(0.963158, 0.757895).circle(0.110526)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.484375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
