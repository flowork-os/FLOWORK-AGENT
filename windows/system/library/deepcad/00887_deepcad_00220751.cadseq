# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220751" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.546875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.105263).lineTo(0.000000, 1.105263).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.452632, 0.047368).lineTo(1.452632, 1.042105).lineTo(0.047368, 1.042105).lineTo(0.047368, 0.047368).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, -0.500000, 0.046875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.398438, 0.000000).lineTo(1.398438, 1.000987).lineTo(0.000000, 1.000987).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.023438)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, -0.523438, 0.046875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(1.437500, 0.000000).lineTo(1.437500, 1.044079).lineTo(0.000000, 1.044079).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(1.422368, 0.015132).lineTo(1.422368, 1.013816).lineTo(0.015132, 1.013816).lineTo(0.015132, 0.015132).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.023438)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
