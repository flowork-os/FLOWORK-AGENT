import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.171880, -0.146086), (0.397451, -0.147204)).threePointArc((0.476887, 0.021542), (0.309128, 0.103043)).threePointArc((0.259700, 0.101962), (0.220806, 0.132484)).threePointArc((0.647697, 0.875386), (1.074589, 0.132484)).threePointArc((1.035695, 0.101962), (0.986266, 0.103043)).threePointArc((0.818508, 0.021542), (0.897944, -0.147204)).threePointArc((1.123515, -0.146086), (1.295395, 0.000000)).threePointArc((0.647697, 1.127163), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.353289, -0.029441).circle(0.058882)
loop2=wp_sketch0.moveTo(0.942105, -0.029441).circle(0.058882)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.078125)
