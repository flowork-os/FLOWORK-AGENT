import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.042305, -0.083486), (0.058553, -0.175658)).threePointArc((0.222618, -0.487579), (0.570888, -0.541612)).threePointArc((0.658717, -0.528584), (0.746546, -0.541612)).threePointArc((1.094817, -0.487579), (1.258882, -0.175658)).threePointArc((1.275130, -0.083486), (1.317434, 0.000000)).threePointArc((1.373335, 0.347976), (1.127138, 0.600164)).threePointArc((1.046348, 0.640541), (0.980757, 0.702632)).threePointArc((0.658717, 0.864733), (0.336678, 0.702632)).threePointArc((0.271087, 0.640541), (0.190296, 0.600164)).threePointArc((-0.055901, 0.347976), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.658717, 0.117105).circle(0.204934)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.281250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, 0.281250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.536842, 0.000000).circle(0.536842)
loop3=wp_sketch1.moveTo(0.357895, -0.290789).lineTo(0.704605, -0.290789).lineTo(0.872368, 0.000000).lineTo(0.704605, 0.290789).lineTo(0.357895, 0.290789).lineTo(0.190132, 0.000000).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.328125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
