# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00352340" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.326316, 0.000000).lineTo(1.326316, 1.500000).lineTo(1.073684, 1.500000).lineTo(1.073684, 0.947368).threePointArc((0.663158, 1.210874), (0.252632, 0.947368)).lineTo(0.252632, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.453947, 0.000000).circle(0.453947)
solid1=wp_sketch1.add(loop1).extrude(0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, 0.000000, -0.062500), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch2.moveTo(0.260526, 0.000000).circle(0.260526)
loop3=wp_sketch2.moveTo(0.260526, 0.000000).circle(0.054276)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.500000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.000000, -0.562500), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch3.moveTo(0.228947, 0.000000).circle(0.228947)
loop5=wp_sketch3.moveTo(0.228947, 0.000000).circle(0.062007)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.054688)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
