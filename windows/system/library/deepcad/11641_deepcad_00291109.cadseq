loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.011549, -0.248479), (0.259868, -0.233882)).lineTo(0.448273, -0.233882).threePointArc((0.513240, -0.168914), (0.448273, -0.103947)).lineTo(0.259868, -0.103947).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.125000)
