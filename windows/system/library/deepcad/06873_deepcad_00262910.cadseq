wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, -0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.046647, -0.068584), (0.062500, -0.150000)).lineTo(0.062500, -0.537500).threePointArc((0.118750, -0.593750), (0.175000, -0.537500)).lineTo(0.175000, -0.150000).threePointArc((0.193978, -0.067943), (0.243750, 0.000000)).threePointArc((0.295385, 0.104902), (0.268750, 0.218750)).lineTo(0.218750, 0.075000).threePointArc((0.217313, 0.067906), (0.212500, 0.062500)).lineTo(0.100000, 0.037500).threePointArc((0.092906, 0.038937), (0.087500, 0.043750)).lineTo(0.012500, 0.125000).threePointArc((0.007687, 0.130406), (0.006250, 0.137500)).lineTo(0.050000, 0.287500).threePointArc((-0.052974, 0.157311), (0.000000, 0.000000)).close()
