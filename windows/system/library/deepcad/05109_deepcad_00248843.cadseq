wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.539062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.064745, -0.156308), (0.221053, -0.221053)).lineTo(1.278947, -0.221053).threePointArc((1.435255, -0.156308), (1.500000, 0.000000)).lineTo(1.500000, 1.073684).threePointArc((1.431985, 1.222097), (1.278947, 1.278947)).lineTo(0.221053, 1.278947).threePointArc((0.068015, 1.222097), (0.000000, 1.073684)).lineTo(0.000000, 0.852632).threePointArc((0.315789, 0.536842), (0.000000, 0.221053)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.221053, 0.000000).circle(0.110526)
loop2=wp_sketch0.moveTo(0.221053, 1.073684).circle(0.110526)
loop3=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.245530, -0.166447), (0.536842, -0.110526)).lineTo(1.278947, -0.110526).threePointArc((1.357101, -0.078154), (1.389474, 0.000000)).lineTo(1.389474, 1.073684).threePointArc((1.357101, 1.151838), (1.278947, 1.184211)).lineTo(0.536842, 1.184211).threePointArc((0.458688, 1.151838), (0.426316, 1.073684)).lineTo(0.426316, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.429688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, -0.539062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.335280, 0.000000).threePointArc((0.200374, -0.009587), (0.111760, -0.111760)).lineTo(0.856826, -0.111760).threePointArc((0.935852, -0.079026), (0.968586, 0.000000)).lineTo(0.968586, 1.067928).threePointArc((0.935852, 1.146954), (0.856826, 1.179688)).lineTo(0.111760, 1.179688).threePointArc((0.032734, 1.146954), (0.000000, 1.067928)).lineTo(0.000000, 0.000000).close()
