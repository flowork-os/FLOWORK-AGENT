# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00252422" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.497368, 0.000000).circle(0.497368)
loop1=wp_sketch0.moveTo(0.497368, 0.000000).circle(0.176151)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, -0.210938, 0.750000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.006832, 0.054059), (0.059211, 0.069079)).lineTo(0.444079, -0.069079).lineTo(0.828947, 0.069079).threePointArc((0.881326, 0.054059), (0.888158, 0.000000)).threePointArc((0.933361, 0.207237), (0.888158, 0.414474)).threePointArc((0.881326, 0.360414), (0.828947, 0.345395)).lineTo(0.444079, 0.473684).lineTo(0.059211, 0.345395).threePointArc((0.006832, 0.360414), (0.000000, 0.414474)).threePointArc((-0.045203, 0.207237), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.444079, 0.207237).circle(0.177632)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.398438)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
