# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272444" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, -0.570312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.945312, 0.000000).lineTo(0.945312, 0.945312).lineTo(0.000000, 0.945312).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.199013, 0.696546).circle(0.159211)
loop2=wp_sketch0.moveTo(0.726398, 0.199013).lineTo(0.726398, 0.398026).lineTo(0.577138, 0.398026).lineTo(0.577138, 0.199013).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.476562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
