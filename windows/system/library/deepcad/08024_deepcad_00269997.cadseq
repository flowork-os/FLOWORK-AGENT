import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.544737, 0.000000).threePointArc((0.594979, -0.020811), (0.615789, -0.071053)).lineTo(0.615789, -0.615789).threePointArc((0.682895, -0.682895), (0.750000, -0.615789)).lineTo(0.750000, 0.071053).threePointArc((0.727554, 0.117347), (0.678947, 0.134211)).lineTo(0.000000, 0.134211).threePointArc((-0.067105, 0.067105), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
