import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.328125, 0.000000).lineTo(1.328125, 0.139803).lineTo(0.405428, 0.139803).lineTo(0.153783, 0.139803).lineTo(0.153783, 0.335526).lineTo(0.153783, 0.545230).lineTo(0.000000, 0.545230).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.468750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, -0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
