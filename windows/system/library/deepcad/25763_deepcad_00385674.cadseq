solid1=wp_sketch1.add(loop1).extrude(0.414062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.090081, -0.140277), (0.246711, -0.197368)).lineTo(1.171875, -0.197368).lineTo(1.171875, -0.172697).lineTo(0.246711, -0.172697).threePointArc((0.107165, -0.123025), (0.024671, 0.000000)).lineTo(0.024671, 0.197368).lineTo(0.000000, 0.197368).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.367188)
