# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.084892, -0.128605), (0.229687, -0.181332)).lineTo(1.148438, -0.181332).lineTo(1.148438, -0.145066).lineTo(0.229687, -0.145066).threePointArc((0.109999, -0.103171), (0.036266, 0.000000)).lineTo(0.036266, 0.205510).lineTo(0.000000, 0.205510).lineTo(0.000000, 0.000000).close()
