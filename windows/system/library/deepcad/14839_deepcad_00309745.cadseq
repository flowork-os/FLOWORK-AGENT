wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.208285, -0.286474), (0.126316, -0.402632)).threePointArc((0.215984, -0.310259), (0.260526, -0.189474)).threePointArc((0.284093, -0.144441), (0.331579, -0.126316)).lineTo(0.544737, -0.126316).lineTo(0.750000, -0.126316).lineTo(0.750000, 0.039474).lineTo(0.292105, 0.039474).lineTo(0.292105, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, -0.189474).circle(0.150000)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.492188)
