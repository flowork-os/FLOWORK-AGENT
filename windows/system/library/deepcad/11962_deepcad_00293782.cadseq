import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, -0.421875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.025773, -0.062221), (0.087993, -0.087993)).lineTo(0.747944, -0.087993).threePointArc((0.810165, -0.062221), (0.835938, 0.000000)).lineTo(0.835938, 0.334375).threePointArc((0.810165, 0.396596), (0.747944, 0.422368)).lineTo(0.087993, 0.422368).threePointArc((0.025773, 0.396596), (0.000000, 0.334375)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.087993, 0.000000).circle(0.035197)
loop2=wp_sketch0.moveTo(0.087993, 0.334375).circle(0.035197)
loop3=wp_sketch0.moveTo(0.747944, 0.000000).circle(0.035197)
loop4=wp_sketch0.moveTo(0.747944, 0.334375).circle(0.035197)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(-0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
