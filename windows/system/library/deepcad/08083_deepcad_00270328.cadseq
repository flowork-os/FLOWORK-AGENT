# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00270328" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.171875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.529441, 0.000000).threePointArc((0.563866, 0.014259), (0.578125, 0.048684)).lineTo(0.578125, 0.286020).threePointArc((0.563866, 0.320445), (0.529441, 0.334704)).lineTo(0.000000, 0.334704).threePointArc((-0.167352, 0.167352), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.164309).circle(0.121711)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.335938, 0.140625, 0.171875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.078125, 0.000000).lineTo(0.078125, 0.048520).lineTo(0.000000, 0.048520).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.164062)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.625000, 0.140625, 0.171875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.078125, 0.000000).lineTo(0.078125, 0.048520).lineTo(0.000000, 0.048520).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.164062)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
