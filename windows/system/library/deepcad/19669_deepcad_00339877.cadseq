# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00339877" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.187500, 0.000000).lineTo(0.187500, 0.076974).lineTo(0.169737, 0.094737).lineTo(0.017763, 0.094737).lineTo(0.000000, 0.076974).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.035526, 0.059211).circle(0.017763)
loop2=wp_sketch0.moveTo(0.094737, 0.059211).circle(0.017763)
loop3=wp_sketch0.moveTo(0.151974, 0.059211).circle(0.017763)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
