import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.107294, -0.017949), (0.197368, -0.078947)).threePointArc((0.500000, -0.208675), (0.802632, -0.078947)).threePointArc((0.900083, -0.021054), (1.013158, -0.013158)).threePointArc((1.254901, 0.190020), (1.026316, 0.407895)).threePointArc((0.911678, 0.422370), (0.815789, 0.486842)).threePointArc((0.509447, 0.628221), (0.197368, 0.500000)).threePointArc((0.107294, 0.439001), (0.000000, 0.421053)).threePointArc((-0.218423, 0.210526), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.013158, 0.210526).circle(0.078947)
loop2=wp_sketch0.moveTo(0.500000, 0.210526).circle(0.289474)
loop3=wp_sketch0.moveTo(1.039474, 0.197368).circle(0.078947)
