import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.585938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.036997, -0.089319), (0.126316, -0.126316)).lineTo(1.373684, -0.126316).threePointArc((1.463003, -0.089319), (1.500000, 0.000000)).lineTo(1.500000, 1.168421).threePointArc((1.463003, 1.257740), (1.373684, 1.294737)).lineTo(0.126316, 1.294737).threePointArc((0.036997, 1.257740), (0.000000, 1.168421)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
