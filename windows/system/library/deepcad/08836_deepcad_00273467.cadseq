import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.397204, -0.045395).lineTo(0.465296, -0.476645).lineTo(0.703618, -0.113487).lineTo(1.078125, -0.113487).lineTo(0.805757, 0.068092).lineTo(0.930592, 0.431250).lineTo(0.601480, 0.226974).lineTo(0.397204, 0.714967).lineTo(0.329112, 0.215625).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.304688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
