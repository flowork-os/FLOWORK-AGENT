import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.139145, -0.154605).threePointArc((0.102510, -0.597992), (0.541118, -0.672533)).lineTo(0.687993, -0.734375).lineTo(0.595230, -0.633882).threePointArc((0.620588, -0.187267), (0.177796, -0.123684)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.401974, -0.564309).lineTo(0.309211, -0.579770).lineTo(0.502467, -0.657072).threePointArc((0.127787, -0.568260), (0.170066, -0.185526)).lineTo(0.270559, -0.301480).lineTo(0.139145, -0.316941).close()
loop2=wp_sketch0.moveTo(0.510197, -0.355592).lineTo(0.347862, -0.386513).lineTo(0.564309, -0.610691).threePointArc((0.597990, -0.223074), (0.216447, -0.146875)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.054688, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.145313, 0.061184).threePointArc((0.583079, 0.131423), (0.550658, 0.573602)).lineTo(0.695970, 0.726562).lineTo(0.520066, 0.604194).threePointArc((0.078160, 0.544797), (0.099424, 0.099424)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.344161, 0.344161).lineTo(0.183553, 0.374753).lineTo(0.481826, 0.581250).threePointArc((0.096694, 0.512708), (0.122368, 0.122368)).close()
loop5=wp_sketch1.moveTo(0.122368, 0.122368).threePointArc((0.511015, 0.153478), (0.527714, 0.543010)).lineTo(0.420641, 0.428289).lineTo(0.558306, 0.412993).lineTo(0.290625, 0.168257).lineTo(0.382401, 0.152961).lineTo(0.191201, 0.076480).close()
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
