# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00386525" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.639474, -0.055263).threePointArc((0.746053, 0.051316), (0.639474, 0.157895)).lineTo(0.000000, 0.110526).threePointArc((-0.055263, 0.055263), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.639474, -0.039474).threePointArc((0.734211, 0.055263), (0.639474, 0.150000)).lineTo(0.000000, 0.094737).threePointArc((-0.039474, 0.055263), (0.000000, 0.015789)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
