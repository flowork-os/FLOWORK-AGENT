loop0=wp_sketch0.moveTo(0.069079, 0.000000).threePointArc((0.070707, 0.000674), (0.071382, 0.002303)).lineTo(0.071382, 0.006908).threePointArc((0.070707, 0.008536), (0.069079, 0.009211)).lineTo(0.012664, 0.011513).threePointArc((0.011061, 0.012212), (0.010362, 0.013816)).lineTo(0.009211, 0.105921).threePointArc((0.008199, 0.108363), (0.005757, 0.109375)).lineTo(0.002303, 0.109375).threePointArc((0.000674, 0.108701), (0.000000, 0.107072)).lineTo(0.000000, 0.000000).close()
