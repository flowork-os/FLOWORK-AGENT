# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00379437" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.296875, -0.296875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.475000, 0.000000).threePointArc((0.558969, 0.034781), (0.593750, 0.118750)).lineTo(0.593750, 0.487500).threePointArc((0.562630, 0.562630), (0.487500, 0.593750)).lineTo(0.118750, 0.593750).threePointArc((0.034781, 0.558969), (0.000000, 0.475000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.300000, 0.300000).circle(0.137500)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
