# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00235984" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.281250, 0.000000).lineTo(1.281250, 0.552961).lineTo(0.000000, 0.552961).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, -0.304688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(1.367188, 0.000000).lineTo(1.367188, 0.604441).lineTo(0.000000, 0.604441).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(1.324013, 0.028783).lineTo(1.324013, 0.575658).lineTo(0.043174, 0.575658).lineTo(0.043174, 0.028783).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.296875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(1.414062, 0.000000).lineTo(1.414062, 0.640049).lineTo(0.000000, 0.640049).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(1.339638, 0.044655).lineTo(1.339638, 0.595395).lineTo(0.074424, 0.595395).lineTo(0.074424, 0.044655).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
