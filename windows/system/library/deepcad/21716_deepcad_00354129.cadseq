# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00354129" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.469737, 0.000000).circle(0.469737)
loop1=wp_sketch0.moveTo(0.469737, 0.000000).circle(0.264227)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.701316, -0.624342).lineTo(0.812500, -0.393421).lineTo(0.230921, 0.179605).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.650000, -0.487500).lineTo(0.684211, -0.401974).lineTo(0.282237, 0.008553).lineTo(0.222368, -0.085526).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.273438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
