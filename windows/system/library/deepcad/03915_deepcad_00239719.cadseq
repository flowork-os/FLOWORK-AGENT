wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000169, -0.000407), (0.000576, -0.000576)).lineTo(0.005016, -0.000576).threePointArc((0.005423, -0.000407), (0.005592, 0.000000)).lineTo(0.005592, 0.007237).threePointArc((0.005423, 0.007644), (0.005016, 0.007812)).lineTo(0.000576, 0.007812).threePointArc((0.000169, 0.007644), (0.000000, 0.007237)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000254, -0.000201), (0.000576, -0.000164)).lineTo(0.005016, -0.000164).threePointArc((0.005133, -0.000116), (0.005181, 0.000000)).lineTo(0.005181, 0.007237).threePointArc((0.005133, 0.007353), (0.005016, 0.007401)).lineTo(0.000576, 0.007401).threePointArc((0.000459, 0.007353), (0.000411, 0.007237)).lineTo(0.000411, 0.000000).close()
