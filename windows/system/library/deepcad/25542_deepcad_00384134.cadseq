wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, -0.718750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009057, -0.021864), (0.030921, -0.030921)).lineTo(0.788487, -0.030921).threePointArc((0.810351, -0.021864), (0.819408, 0.000000)).lineTo(0.819408, 1.437829).threePointArc((0.810351, 1.459693), (0.788487, 1.468750)).lineTo(0.030921, 1.468750).threePointArc((0.009057, 1.459693), (0.000000, 1.437829)).lineTo(0.000000, 0.000000).close()
