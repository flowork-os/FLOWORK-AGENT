wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.045600, -0.007628), (0.083882, -0.033553)).threePointArc((0.218092, -0.091084), (0.352303, -0.033553)).threePointArc((0.390584, -0.007628), (0.436184, 0.000000)).threePointArc((0.531915, 0.092270), (0.436184, 0.184539)).threePointArc((0.390584, 0.192168), (0.352303, 0.218092)).threePointArc((0.218092, 0.275623), (0.083882, 0.218092)).threePointArc((0.045600, 0.192168), (0.000000, 0.184539)).threePointArc((-0.095731, 0.092270), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.005592, 0.089474).circle(0.039145)
