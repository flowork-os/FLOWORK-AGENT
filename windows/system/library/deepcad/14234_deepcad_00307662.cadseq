import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.000000, -0.312500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.620724, 0.000000).lineTo(0.620724, 0.176151).lineTo(0.444572, 0.176151).lineTo(0.444572, 0.620724).lineTo(0.620724, 0.620724).lineTo(0.620724, 0.796875).lineTo(0.000000, 0.796875).lineTo(0.000000, 0.620724).lineTo(0.176151, 0.620724).lineTo(0.176151, 0.176151).lineTo(0.000000, 0.176151).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.531250)
