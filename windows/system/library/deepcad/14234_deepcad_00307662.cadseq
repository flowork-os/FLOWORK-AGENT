# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, -0.406250, 0.570312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.027632, 0.000000).lineTo(0.027632, 0.044737).lineTo(0.052632, 0.044737).lineTo(0.052632, 0.000000).lineTo(0.078947, 0.000000).lineTo(0.078947, 0.125000).lineTo(0.052632, 0.125000).lineTo(0.052632, 0.080263).lineTo(0.027632, 0.080263).lineTo(0.027632, 0.125000).lineTo(0.000000, 0.125000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.445312)
