# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.000000, -0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.376316, -0.159211).threePointArc((0.636842, -0.212696), (0.897368, -0.159211)).lineTo(1.273684, 0.000000).threePointArc((1.378755, 0.188158), (1.273684, 0.376316)).lineTo(0.897368, 0.535526).threePointArc((0.635356, 0.581775), (0.376316, 0.521053)).lineTo(0.000000, 0.361842).threePointArc((-0.093868, 0.180921), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.072368, 0.188158).circle(0.101316)
loop2=wp_sketch0.moveTo(0.622368, 0.130263).circle(0.246053)
loop3=wp_sketch0.moveTo(1.157895, 0.188158).circle(0.101316)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.250000)
