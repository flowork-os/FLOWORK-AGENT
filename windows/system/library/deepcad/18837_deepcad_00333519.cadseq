# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00333519" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.426316, 0.000000).lineTo(0.426316, 0.189474).lineTo(0.544737, 0.189474).lineTo(0.544737, 0.750000).lineTo(0.300000, 0.750000).lineTo(0.300000, 0.497368).threePointArc((0.240789, 0.438158), (0.181579, 0.497368)).lineTo(0.181579, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.125000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.117188, 0.000000).lineTo(0.117188, 0.195312).lineTo(0.000000, 0.195312).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.093750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.545724, 0.000000).lineTo(0.545724, 0.617188).lineTo(0.064967, 0.617188).lineTo(0.000000, 0.617188).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.093750)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, 0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.484375, 0.000000).threePointArc((0.242188, 0.098581), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(-0.093750)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.101562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.139803, 0.000000).lineTo(0.139803, 0.195312).lineTo(0.000000, 0.195312).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.195312)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
