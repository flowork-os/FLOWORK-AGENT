import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.007812, 0.148438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.039718, -0.017026), (0.056743, -0.056743)).lineTo(0.056743, -0.898438).lineTo(0.217516, -0.898438).lineTo(0.217516, 0.208059).threePointArc((-0.133924, 0.357743), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.009457, 0.208059).circle(0.170230)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.351562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
