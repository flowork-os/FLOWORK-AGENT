import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.000000, 0.351562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.201316, 0.000000).circle(0.201316)
loop1=wp_sketch0.moveTo(0.201316, 0.000000).circle(0.100658)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.281250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.796875, 0.000000).lineTo(0.796875, 0.402632).threePointArc((0.398438, 0.801069), (0.000000, 0.402632)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.402632, 0.402632).circle(0.201316)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.117188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.000000, -0.351562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.201316, 0.000000).lineTo(0.201316, 0.150987).lineTo(0.595559, 0.150987).lineTo(0.595559, 0.000000).lineTo(0.796875, 0.000000).lineTo(0.796875, 0.301974).lineTo(0.000000, 0.301974).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.117188)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.000000, -0.351562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.201316, 0.000000).lineTo(0.201316, 0.150987).lineTo(0.595559, 0.150987).lineTo(0.595559, 0.000000).lineTo(0.796875, 0.000000).lineTo(0.796875, 0.301974).lineTo(0.000000, 0.301974).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.398438)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
