# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00344673" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, -0.429688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.642188, 0.000000).threePointArc((1.070312, 0.428125), (0.642188, 0.856250)).lineTo(0.000000, 0.856250).threePointArc((-0.428125, 0.428125), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.428125).circle(0.123931)
loop2=wp_sketch0.moveTo(0.642188, 0.428125).circle(0.045066)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.130263, 0.000000).circle(0.130263)
loop4=wp_sketch1.moveTo(0.130263, 0.000000).circle(0.065132)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.109375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
