wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.000000, -0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.101562, 0.000000).lineTo(1.101562, 0.649342).lineTo(0.904441, 0.649342).lineTo(0.904441, 0.556579).lineTo(0.985609, 0.556579).lineTo(0.985609, 0.452220).lineTo(0.602961, 0.452220).lineTo(0.602961, 0.556579).lineTo(0.684128, 0.556579).lineTo(0.684128, 0.649342).lineTo(0.475411, 0.649342).lineTo(0.324671, 0.405839).lineTo(0.000000, 0.405839).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
