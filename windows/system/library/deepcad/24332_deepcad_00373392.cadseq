import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, 0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.566201, -0.767516).lineTo(1.132401, 0.000000).threePointArc((1.058013, 0.490134), (0.566201, 0.427796)).threePointArc((0.074389, 0.490134), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
