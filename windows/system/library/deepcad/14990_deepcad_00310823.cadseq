loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.081940, 0.009415), (0.133224, 0.074013)).lineTo(0.458882, 0.074013).threePointArc((0.500750, 0.091356), (0.518092, 0.133224)).lineTo(0.518092, 0.569901).threePointArc((0.500750, 0.611769), (0.458882, 0.629112)).lineTo(0.133224, 0.629112).threePointArc((0.091356, 0.611769), (0.074013, 0.569901)).lineTo(0.074013, 0.133224).close()
