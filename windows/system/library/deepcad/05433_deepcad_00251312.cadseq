# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00251312" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.419737, -0.343421).threePointArc((0.753718, 0.281414), (0.419737, 0.906250)).lineTo(0.000000, 0.562829).threePointArc((0.281414, 0.281414), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.429276, -0.009539).circle(0.143092)
loop2=wp_sketch0.moveTo(0.429276, 0.572368).circle(0.143092)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.284211, 0.000000).circle(0.284211)
loop4=wp_sketch1.moveTo(0.390789, -0.148026).threePointArc((0.465300, -0.000000), (0.390789, 0.148026)).lineTo(0.165789, 0.148026).threePointArc((0.091279, 0.000000), (0.165789, -0.148026)).close()
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.375000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
