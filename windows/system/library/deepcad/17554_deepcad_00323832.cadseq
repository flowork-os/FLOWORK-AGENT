loop0=wp_sketch0.moveTo(0.242105, 0.000000).lineTo(0.242105, -0.157895).threePointArc((0.500000, -0.415789), (0.757895, -0.157895)).lineTo(0.757895, 0.000000).lineTo(1.000000, 0.000000).lineTo(1.000000, 0.052632).lineTo(0.705263, 0.052632).lineTo(0.705263, -0.157895).threePointArc((0.500000, -0.363158), (0.294737, -0.157895)).lineTo(0.294737, 0.052632).lineTo(0.000000, 0.052632).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.343750)
