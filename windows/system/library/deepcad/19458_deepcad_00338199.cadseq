# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00338199" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, -0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.406250, 0.000000).lineTo(0.406250, 0.316447).lineTo(0.000000, 0.316447).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.205263, 0.158224).circle(0.119737)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.156250, 0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.031086, -0.043174).lineTo(0.081168, -0.060444).lineTo(0.131250, -0.044901).lineTo(0.164062, -0.001727).lineTo(0.164062, 0.051809).lineTo(0.132977, 0.094984).lineTo(0.082895, 0.112253).lineTo(0.032813, 0.094984).lineTo(0.000000, 0.053536).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.453125)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
