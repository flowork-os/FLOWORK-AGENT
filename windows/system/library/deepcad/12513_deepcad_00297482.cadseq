# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297482" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.097039, 0.000000).threePointArc((1.138775, 0.041735), (1.097039, 0.083470)).lineTo(0.000000, 0.083470).threePointArc((-0.041735, 0.041735), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.035773).circle(0.011924)
loop2=wp_sketch0.moveTo(0.620066, 0.035773).circle(0.011924)
loop3=wp_sketch0.moveTo(1.097039, 0.023849).threePointArc((1.108964, 0.035773), (1.097039, 0.047697)).lineTo(0.727385, 0.047697).threePointArc((0.715461, 0.035773), (0.727385, 0.023849)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
