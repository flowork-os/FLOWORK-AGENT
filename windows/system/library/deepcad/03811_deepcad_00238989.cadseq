# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00238989" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.445312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.336184, 0.000000).lineTo(0.984539, 0.000000).threePointArc((1.094909, 0.045716), (1.140625, 0.156086)).lineTo(1.140625, 0.912500).lineTo(0.000000, 0.456250).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.336184, 0.300164).circle(0.228125)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.382812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
