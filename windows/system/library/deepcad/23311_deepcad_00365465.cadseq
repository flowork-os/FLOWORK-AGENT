import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.718421).lineTo(0.560526, 0.718421).lineTo(0.394737, 0.718421).lineTo(0.000000, 0.718421).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.560526, 0.078947).lineTo(0.560526, 0.323684).lineTo(0.394737, 0.323684).lineTo(0.394737, 0.078947).close()
loop2=wp_sketch0.moveTo(0.560526, 0.386842).lineTo(0.560526, 0.631579).lineTo(0.394737, 0.631579).lineTo(0.394737, 0.386842).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.000000, 0.640625), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
