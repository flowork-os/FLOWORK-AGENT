# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00324226" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.363158).lineTo(0.000000, 0.363158).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.031579, 0.173684).circle(0.015789)
loop2=wp_sketch0.moveTo(0.623684, 0.134211).lineTo(0.623684, 0.213158).lineTo(0.126316, 0.213158).lineTo(0.126316, 0.134211).close()
loop3=wp_sketch0.moveTo(0.718421, 0.173684).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.257812, 0.062500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.102632).lineTo(0.000000, 0.102632).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop4).extrude(0.296875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
