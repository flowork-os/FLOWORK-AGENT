# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257622" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.046220, -0.100608), (0.152961, -0.130016)).lineTo(0.726562, -0.022944).lineTo(0.726562, 0.405345).lineTo(0.481826, 0.543010).lineTo(0.000000, 0.367105).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.215954, -0.074753).lineTo(0.215954, -0.373766).lineTo(0.581414, -0.373766).lineTo(0.581414, -0.166118).lineTo(0.789062, 0.041530).lineTo(0.581414, 0.249178).lineTo(0.215954, 0.249178).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.164062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
