# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, -0.718750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.015132).threePointArc((0.045395, 1.494306), (0.090789, 0.015132)).lineTo(0.090789, 0.000000).threePointArc((0.045395, 1.479174), (0.000000, 0.000000)).close()
