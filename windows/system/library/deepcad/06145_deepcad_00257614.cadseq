# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257614" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).threePointArc((0.750000, 0.750000), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.726316, 0.078947).lineTo(0.473684, 0.315789).lineTo(0.300000, 0.473684).threePointArc((0.169768, 0.293354), (0.110526, 0.078947)).close()
loop2=wp_sketch0.moveTo(0.505263, 0.347368).lineTo(0.726316, 0.110526).lineTo(0.726316, 0.536842).lineTo(0.726316, 0.647368).threePointArc((0.515747, 0.601422), (0.331579, 0.489474)).close()
loop3=wp_sketch0.moveTo(1.152632, 0.521053).threePointArc((0.973320, 0.614697), (0.773684, 0.647368)).lineTo(0.773684, 0.536842).lineTo(0.773684, 0.126316).close()
loop4=wp_sketch0.moveTo(1.389474, 0.078947).threePointArc((1.317164, 0.304789), (1.168421, 0.489474)).lineTo(0.994737, 0.300000).lineTo(0.773684, 0.078947).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
