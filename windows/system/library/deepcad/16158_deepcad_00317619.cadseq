# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.242188, -0.164062, 0.570312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.070312, -0.070312), (0.140625, 0.000000)).lineTo(0.000000, 0.000000).close()
