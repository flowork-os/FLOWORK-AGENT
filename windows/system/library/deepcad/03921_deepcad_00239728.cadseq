loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000385, -0.000930), (0.001316, -0.001316)).lineTo(0.014309, -0.001316).threePointArc((0.015240, -0.000930), (0.015625, 0.000000)).lineTo(0.015625, 0.012993).threePointArc((0.015240, 0.013924), (0.014309, 0.014309)).lineTo(0.001316, 0.014309).threePointArc((0.000385, 0.013924), (0.000000, 0.012993)).lineTo(0.000000, 0.000000).close()
