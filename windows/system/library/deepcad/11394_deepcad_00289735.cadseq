loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((-0.009987, -0.162423), (0.152632, -0.168421)).lineTo(0.389474, -0.168421).threePointArc((0.447368, -0.110526), (0.389474, -0.052632)).lineTo(0.147368, -0.052632).close()
