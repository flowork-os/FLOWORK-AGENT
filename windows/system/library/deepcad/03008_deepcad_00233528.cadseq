wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, -0.726562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009105, -0.021981), (0.031086, -0.031086)).lineTo(0.808224, -0.031086).threePointArc((0.822433, -0.018762), (0.823766, 0.000000)).lineTo(0.823766, 1.445477).threePointArc((0.822433, 1.464239), (0.808224, 1.476562)).lineTo(0.031086, 1.476562).threePointArc((0.009105, 1.467458), (0.000000, 1.445477)).lineTo(0.000000, 0.000000).close()
