# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.664062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.018402, -0.044427), (0.062829, -0.062829)).lineTo(1.429359, -0.062829).threePointArc((1.473785, -0.044427), (1.492188, 0.000000)).lineTo(1.492188, 0.785362).threePointArc((1.473785, 0.829789), (1.429359, 0.848191)).lineTo(0.062829, 0.848191).threePointArc((0.018402, 0.829789), (0.000000, 0.785362)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.195312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
