import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.150000, 0.000000).circle(0.150000)
loop1=wp_sketch0.moveTo(0.150000, 0.000000).circle(0.112500)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.148438)
solid=solid0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.150000, 0.000000).circle(0.150000)
loop1=wp_sketch0.moveTo(0.150000, 0.000000).circle(0.112500)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.148438)
solid=solid.union(solid0)
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.179688, 0.000000).lineTo(0.179688, 0.068092).lineTo(0.000000, 0.068092).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.164556, 0.015132).lineTo(0.164556, 0.052961).lineTo(0.015132, 0.052961).lineTo(0.015132, 0.015132).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
