# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00333015" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, 0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, -0.015789).threePointArc((0.428832, -0.007895), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.252632, 0.000000).circle(0.126316)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.000000, 0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.013322, -0.479605).lineTo(1.265625, -0.479605).lineTo(1.265625, -0.359704).lineTo(0.386349, 0.226480).threePointArc((0.374451, -0.195997), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, -0.250000, 0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.000000, -0.026645).lineTo(0.013322, -0.373026).lineTo(0.013322, -0.506250).lineTo(1.265625, -0.506250).lineTo(1.265625, -0.373026).lineTo(0.506250, -0.373026).lineTo(0.506250, 0.000000).threePointArc((0.253125, 0.253125), (0.000000, 0.000000)).close()
loop4=wp_sketch2.moveTo(0.253125, 0.000000).circle(0.119901)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.250000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
