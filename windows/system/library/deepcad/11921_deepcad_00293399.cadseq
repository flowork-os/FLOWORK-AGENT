# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00293399" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, 0.000000, -0.382812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.739309, 0.000000).lineTo(0.739309, 0.763158).threePointArc((0.369655, 1.132812), (0.000000, 0.763158)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.178865, 0.190789).circle(0.083470)
loop2=wp_sketch0.moveTo(0.369655, 0.763158).circle(0.095395)
loop3=wp_sketch0.moveTo(0.476974, 0.190789).circle(0.083470)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.382812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.094737, 0.000000).circle(0.094737)
solid1=wp_sketch1.add(loop4).extrude(-0.187500)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
