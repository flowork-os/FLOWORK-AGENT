# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285989" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.055263).threePointArc((-0.026768, 0.082031), (0.000000, 0.108799)).lineTo(0.000000, 0.164062).threePointArc((-0.082031, 0.082031), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.664062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.082031, 0.082031), (0.000000, 0.164062)).lineTo(0.000000, 0.108799).threePointArc((0.026768, 0.082031), (0.000000, 0.055263)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.054688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.664062, 0.000000).lineTo(0.664062, 0.055921).threePointArc((0.636102, 0.083882), (0.664062, 0.111842)).lineTo(0.664062, 0.167763).lineTo(0.000000, 0.167763).lineTo(0.000000, 0.111842).threePointArc((0.027961, 0.083882), (0.000000, 0.055921)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.552220, 0.041941).threePointArc((0.594161, 0.083882), (0.552220, 0.125822)).lineTo(0.111842, 0.125822).threePointArc((0.069901, 0.083882), (0.111842, 0.041941)).close()
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.054688)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
