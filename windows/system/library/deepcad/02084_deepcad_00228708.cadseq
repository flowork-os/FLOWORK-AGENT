import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.702632, 0.000000).circle(0.702632)
loop1=wp_sketch0.moveTo(0.702632, 0.000000).circle(0.614803)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.615789, 0.000000).circle(0.602961)
loop3=wp_sketch1.moveTo(0.615789, 0.000000).circle(0.051316)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.750000)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.615789, 0.000000).circle(0.602961)
loop3=wp_sketch1.moveTo(0.615789, 0.000000).circle(0.051316)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.390625)
solid_temp=solid_temp.union(solid1)
solid=solid.union(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
