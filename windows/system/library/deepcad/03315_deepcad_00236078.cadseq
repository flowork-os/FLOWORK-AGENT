# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236078" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.578125, 0.000000).threePointArc((0.404687, 0.173437), (0.578125, 0.346875)).lineTo(0.000000, 0.346875).threePointArc((0.173437, 0.173437), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.406250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.173684, 0.000000).circle(0.173684)
loop2=wp_sketch1.moveTo(0.173684, 0.000000).circle(0.068750)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.117188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.173684, 0.000000).circle(0.170066)
loop4=wp_sketch2.moveTo(0.289474, -0.047039).lineTo(0.289474, 0.047039).lineTo(0.224342, 0.047039).threePointArc((0.097793, 0.000000), (0.224342, -0.047039)).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.234375)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
