# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.000000, -0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.953125, 0.000000).lineTo(0.953125, 0.912993).lineTo(0.953125, 0.943092).lineTo(0.000000, 0.943092).lineTo(0.000000, 0.912993).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, -0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.007812, 0.000000).lineTo(1.007812, 0.297039).lineTo(1.007812, 0.668339).lineTo(1.007812, 0.965378).lineTo(0.986595, 0.965378).lineTo(0.986595, 0.944161).lineTo(0.986595, 0.021217).lineTo(0.021217, 0.021217).lineTo(0.021217, 0.944161).lineTo(0.021217, 0.965378).lineTo(0.000000, 0.965378).lineTo(0.000000, 0.668339).lineTo(0.000000, 0.297039).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.414062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.244737, 0.000000).lineTo(0.244737, 0.375000).lineTo(0.000000, 0.375000).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.122368, 0.189474).circle(0.027632)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.093750)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.500000, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.244737, 0.000000).lineTo(0.244737, 0.375000).lineTo(0.000000, 0.375000).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch3.moveTo(0.122368, 0.189474).circle(0.027632)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.093750)
solid=solid.union(solid3)

