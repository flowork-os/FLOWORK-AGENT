# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00308297" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, -0.359375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.735691, 0.000000).lineTo(0.735691, 0.245230).lineTo(0.490461, 0.245230).lineTo(0.490461, 0.864145).lineTo(0.735691, 0.864145).lineTo(0.735691, 1.109375).lineTo(0.000000, 1.109375).lineTo(0.000000, 0.864145).lineTo(0.245230, 0.864145).lineTo(0.245230, 0.245230).lineTo(0.000000, 0.245230).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.742188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.101562, -0.617188, 0.195312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.248684, 0.000000).circle(0.248684)
solid1=wp_sketch1.add(loop1).extrude(-0.250000)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
