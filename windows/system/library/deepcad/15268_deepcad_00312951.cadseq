loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002505, -0.006048), (0.008553, -0.008553)).lineTo(0.093010, -0.008553).threePointArc((0.099057, -0.006048), (0.101562, 0.000000)).lineTo(0.101562, 0.051316).threePointArc((0.098836, 0.056829), (0.093010, 0.058799)).lineTo(0.008553, 0.058799).threePointArc((0.002726, 0.056829), (0.000000, 0.051316)).lineTo(0.000000, 0.000000).close()
