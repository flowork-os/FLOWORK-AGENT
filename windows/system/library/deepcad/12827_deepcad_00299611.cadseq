# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.116466, -0.022058), (0.215625, -0.087007)).threePointArc((0.332895, -0.087007), (0.332895, 0.030263)).threePointArc((0.180368, 0.133355), (0.000000, 0.170230)).threePointArc((-0.085115, 0.085115), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.130103, -0.001649), (0.249671, -0.052961)).threePointArc((0.298849, -0.052961), (0.298849, -0.003783)).threePointArc((0.161840, 0.088357), (0.000000, 0.121053)).threePointArc((-0.035937, 0.085115), (0.000000, 0.049178)).close()
