import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.164062, 0.000000, -0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.064598, 0.045401), (0.141859, 0.061678)).lineTo(0.487253, 0.061678).threePointArc((0.582854, 0.157278), (0.487253, 0.252878)).lineTo(0.141859, 0.252878).threePointArc((0.064598, 0.269155), (0.000000, 0.314556)).threePointArc((-0.386391, 0.157278), (0.000000, 0.000000)).close()
