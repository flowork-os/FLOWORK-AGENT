# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288065" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.078125, 0.000000).lineTo(0.078125, 0.078125).lineTo(0.000000, 0.078125).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.072368, 0.005757).lineTo(0.072368, 0.072368).lineTo(0.005757, 0.072368).lineTo(0.005757, 0.005757).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.078125, 0.000000).lineTo(0.078125, 0.078125).lineTo(0.000000, 0.078125).lineTo(0.000000, 0.000000).close()
