# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop8=wp_sketch4.moveTo(0.078125, 0.000000).lineTo(0.078125, 0.078125).lineTo(0.000000, 0.078125).lineTo(0.000000, 0.000000).close()
loop9=wp_sketch4.moveTo(0.072368, 0.005757).lineTo(0.072368, 0.072368).lineTo(0.005757, 0.072368).lineTo(0.005757, 0.005757).close()
