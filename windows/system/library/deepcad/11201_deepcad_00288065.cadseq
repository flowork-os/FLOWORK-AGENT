wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.078125, 0.000000).lineTo(0.078125, 0.078125).lineTo(0.000000, 0.078125).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.072368, 0.005757).lineTo(0.072368, 0.072368).lineTo(0.005757, 0.072368).lineTo(0.005757, 0.005757).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.750000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.078125, 0.000000).lineTo(0.078125, 0.078125).lineTo(0.000000, 0.078125).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch3.moveTo(0.072368, 0.005757).lineTo(0.072368, 0.072368).lineTo(0.005757, 0.072368).lineTo(0.005757, 0.005757).close()
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.750000)
