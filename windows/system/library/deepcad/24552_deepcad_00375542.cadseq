# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00375542" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.065132, 0.000000).lineTo(0.065132, -0.271382).threePointArc((0.520765, 0.082612), (0.423355, 0.651316)).threePointArc((0.473966, 0.844795), (0.401645, 1.031250)).threePointArc((0.219133, 0.974008), (0.086842, 0.835855)).threePointArc((0.043221, 0.839684), (0.000000, 0.846711)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.065132, 0.227961).circle(0.043421)
loop2=wp_sketch0.moveTo(0.217105, 0.542763).circle(0.108553)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, 0.000000, 0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.048241, 0.198789), (0.029112, 0.388158)).threePointArc((0.210563, 0.326172), (0.339638, 0.184375)).threePointArc((0.383127, 0.190835), (0.426974, 0.194079)).lineTo(0.426974, -0.650164).lineTo(0.359046, -0.650164).lineTo(0.359046, -0.921875).threePointArc((-0.096752, -0.568539), (0.000000, 0.000000)).close()
loop4=wp_sketch1.moveTo(0.213487, -0.106743).circle(0.106743)
loop5=wp_sketch1.moveTo(0.359046, -0.417270).circle(0.048520)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.070312)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
