import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.011562, -0.027912), (0.039474, -0.039474)).lineTo(0.710526, -0.039474).threePointArc((0.738438, -0.027912), (0.750000, 0.000000)).lineTo(0.750000, 0.023684).threePointArc((0.738438, 0.051596), (0.710526, 0.063158)).lineTo(0.039474, 0.063158).threePointArc((0.011562, 0.051596), (0.000000, 0.023684)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.039474, 0.015789).circle(0.007895)
loop2=wp_sketch0.moveTo(0.378947, 0.015789).circle(0.007895)
loop3=wp_sketch0.moveTo(0.710526, 0.015789).circle(0.007895)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
