# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00323029" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.499095, 0.000000).lineTo(0.499095, 0.499095).lineTo(0.244655, 0.929687).lineTo(0.000000, 0.499095).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.185937, 0.185937).circle(0.058717)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.500000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
