# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00315301" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.453125, 0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.259868, 0.000000).lineTo(0.454770, 0.000000).lineTo(0.454770, -0.116941).lineTo(0.454770, -0.363816).lineTo(0.617188, -0.324836).lineTo(0.617188, 0.000000).lineTo(0.402796, 0.071464).lineTo(0.051974, 0.071464).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.513240, -0.214391).circle(0.051974)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.203125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.312500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.314062, 0.000000).lineTo(0.314062, 0.523438).lineTo(0.000000, 0.523438).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.071628, 0.402220).circle(0.060609)
loop4=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.523466, -0.243327), (0.165296, 0.209375)).threePointArc((0.058437, 0.181569), (0.159786, 0.137747)).close()
loop5=wp_sketch1.moveTo(0.225905, 0.402220).circle(0.066118)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.179688, -0.351562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch2.moveTo(0.086842, 0.000000).circle(0.086842)
loop7=wp_sketch2.moveTo(0.086842, 0.000000).circle(0.061513)
solid2=wp_sketch2.add(loop6).add(loop7).extrude(0.398438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
