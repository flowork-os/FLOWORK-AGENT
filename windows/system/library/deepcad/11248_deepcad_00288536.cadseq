# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288536" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.378483, 0.065210), (0.600000, 0.378947)).lineTo(0.900000, 0.378947).threePointArc((1.056308, 0.443692), (1.121053, 0.600000)).lineTo(1.121053, 0.900000).threePointArc((1.056308, 1.056308), (0.900000, 1.121053)).lineTo(0.600000, 1.121053).threePointArc((0.443692, 1.056308), (0.378947, 0.900000)).lineTo(0.378947, 0.600000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.296875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.189474, 0.300000).threePointArc((0.097350, 0.032933), (0.221053, -0.221053)).lineTo(0.521053, -0.221053).threePointArc((0.681308, -0.157943), (0.750000, 0.000000)).lineTo(0.750000, 0.300000).threePointArc((0.681308, 0.457943), (0.521053, 0.521053)).lineTo(0.221053, 0.521053).threePointArc((0.064745, 0.456308), (0.000000, 0.300000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.296875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.064745, -0.156308), (0.221053, -0.221053)).lineTo(0.521053, -0.221053).threePointArc((0.681308, -0.157943), (0.750000, 0.000000)).lineTo(0.750000, 0.300000).threePointArc((0.681308, 0.457943), (0.521053, 0.521053)).lineTo(0.221053, 0.521053).threePointArc((0.064745, 0.456308), (0.000000, 0.300000)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.148438)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
