import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.300740, 0.000000).lineTo(0.300740, 0.169984).lineTo(0.470724, 0.169984).lineTo(0.470724, 0.000000).lineTo(0.771464, 0.000000).lineTo(0.771464, 1.242188).lineTo(0.000000, 1.242188).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.379194, 0.745313).circle(0.274589)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.148438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
