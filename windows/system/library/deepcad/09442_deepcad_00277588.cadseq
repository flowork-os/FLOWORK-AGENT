# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00277588" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.718421, 0.000000).circle(0.718421)
solid0=wp_sketch0.add(loop0).extrude(0.710938)
solid=solid0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.718421, 0.000000).circle(0.718421)
solid0=wp_sketch0.add(loop0).extrude(-0.179688)
solid=solid.union(solid0)
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.523438, 0.179688, -0.062500), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.308553, -0.418750).lineTo(0.837500, -0.363651).lineTo(1.046875, 0.121217).lineTo(0.738322, 0.539967).lineTo(0.209375, 0.484868).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.070312)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
