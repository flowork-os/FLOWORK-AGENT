wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.003035, -0.007327), (0.010362, -0.010362)).lineTo(0.466283, -0.010362).threePointArc((0.478791, -0.009473), (0.487007, 0.000000)).lineTo(0.487007, 0.974013).threePointArc((0.478791, 0.983486), (0.466283, 0.984375)).lineTo(0.010362, 0.984375).threePointArc((0.003035, 0.981340), (0.000000, 0.974013)).lineTo(0.000000, 0.000000).close()
