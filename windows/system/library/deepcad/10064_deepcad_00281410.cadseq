# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00281410" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, -0.421875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.974507, 0.000000).lineTo(0.974507, 0.419408).threePointArc((0.581993, 0.581993), (0.419408, 0.974507)).lineTo(0.419408, 1.171875).lineTo(0.000000, 1.171875).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.209704, 0.209704).circle(0.061678)
loop2=wp_sketch0.moveTo(0.209704, 0.888158).circle(0.061678)
loop3=wp_sketch0.moveTo(0.703125, 0.209704).circle(0.061678)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
