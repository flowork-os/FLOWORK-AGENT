# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00304582" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, -0.328125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.170230, 0.000000).lineTo(0.340461, 0.000000).lineTo(0.340461, 0.374507).threePointArc((0.333627, 0.399461), (0.317763, 0.419901)).lineTo(0.283717, 0.453947).threePointArc((0.273528, 0.475516), (0.272368, 0.499342)).lineTo(0.272368, 0.975987).threePointArc((0.170230, 1.078125), (0.068092, 0.975987)).lineTo(0.068092, 0.499342).threePointArc((0.052229, 0.478902), (0.045395, 0.453947)).lineTo(0.022697, 0.419901).threePointArc((0.006834, 0.399461), (0.000000, 0.374507)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.170230, 0.329112).circle(0.056743)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.328125, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.015789, 0.000000).circle(0.015789)
solid1=wp_sketch1.add(loop2).extrude(-0.132812)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
