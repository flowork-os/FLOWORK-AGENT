# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00264465" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.094737, 0.000000).circle(0.094737)
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.047536, -0.033903), (0.066201, -0.089227)).lineTo(0.273438, -0.089227).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.025796, -0.125030), (0.101316, -0.227961)).threePointArc((0.195799, -0.171746), (0.303947, -0.151974)).lineTo(0.303947, -0.303947).threePointArc((0.426502, -0.274294), (0.525576, -0.196299)).threePointArc((0.469931, -0.104983), (0.449589, 0.000000)).lineTo(0.601562, 0.000000).threePointArc((0.575766, 0.125030), (0.500247, 0.227961)).threePointArc((0.408930, 0.172315), (0.303947, 0.151974)).lineTo(0.303947, 0.303947).threePointArc((0.178227, 0.274985), (0.075987, 0.196299)).threePointArc((0.131632, 0.104983), (0.151974, 0.000000)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.015625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
