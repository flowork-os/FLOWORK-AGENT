# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272233" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, -0.671875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.351562, 0.000000).lineTo(1.351562, 1.351562).lineTo(0.000000, 1.351562).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.668668, 0.682895).circle(0.611760)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.671875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.611842, 0.000000).circle(0.611842)
loop3=wp_sketch1.moveTo(0.165707, -0.280428).lineTo(0.560855, -0.522615).lineTo(0.981497, -0.356908).lineTo(1.121711, 0.063734).lineTo(0.879523, 0.446135).lineTo(0.420641, 0.484375).lineTo(0.114720, 0.165707).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.671875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
