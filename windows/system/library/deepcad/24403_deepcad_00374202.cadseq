import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.055496, -0.133978), (0.189474, -0.189474)).lineTo(1.310526, -0.189474).threePointArc((1.444504, -0.133978), (1.500000, 0.000000)).lineTo(1.500000, 0.757895).threePointArc((1.441234, 0.883978), (1.310526, 0.931579)).lineTo(0.189474, 0.931579).threePointArc((0.058766, 0.883978), (0.000000, 0.757895)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.189474, 0.378947).circle(0.078947)
loop2=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((5.891752, -5.585227), (0.805263, 0.742105)).lineTo(0.805263, 0.789474).lineTo(0.757895, 0.789474).lineTo(0.694737, 0.789474).lineTo(0.694737, 0.742105).close()
loop3=wp_sketch0.moveTo(1.310526, 0.378947).circle(0.078947)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.562500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
