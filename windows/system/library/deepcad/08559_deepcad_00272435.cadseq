# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272435" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.695312, 0.000000).lineTo(0.695312, 0.695312).lineTo(0.000000, 0.695312).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.190296, 0.182977).circle(0.109786)
loop2=wp_sketch0.moveTo(0.365954, 0.483059).circle(0.131743)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.343750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
