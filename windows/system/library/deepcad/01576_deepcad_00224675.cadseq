# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00224675" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.054688, -0.289062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.497697, 0.095148).threePointArc((0.691653, 0.289104), (0.497697, 0.483059)).lineTo(0.000000, 0.578207).threePointArc((0.240245, 0.289104), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.497697, 0.285444).circle(0.102467)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.257812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.296053, 0.000000).circle(0.296053)
loop3=wp_sketch1.moveTo(0.154194, -0.049342).threePointArc((0.292969, -0.147078), (0.431743, -0.049342)).lineTo(0.481086, -0.049342).lineTo(0.481086, 0.049342).lineTo(0.431743, 0.049342).threePointArc((0.292969, 0.147078), (0.154194, 0.049342)).lineTo(0.104852, 0.049342).lineTo(0.104852, -0.049342).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.523438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.053454, 0.000000).threePointArc((0.044643, 0.050781), (0.053454, 0.101562)).lineTo(0.000000, 0.101562).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.523438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
