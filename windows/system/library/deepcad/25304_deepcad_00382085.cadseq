# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382085" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.189474, 0.000000).circle(0.189474)
loop1=wp_sketch0.moveTo(0.102632, -0.150000).lineTo(0.272368, -0.150000).lineTo(0.359211, 0.000000).lineTo(0.272368, 0.150000).lineTo(0.102632, 0.150000).lineTo(0.015789, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.086842, -0.148355).lineTo(0.256908, -0.148355).lineTo(0.343750, 0.000000).lineTo(0.256908, 0.148355).lineTo(0.086842, 0.148355).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.331579, 0.000000).circle(0.331579)
loop4=wp_sketch2.moveTo(0.331579, 0.000000).circle(0.186513)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.375000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.189474, 0.000000).circle(0.189474)
loop6=wp_sketch3.moveTo(0.102632, -0.150000).lineTo(0.272368, -0.150000).lineTo(0.359211, 0.000000).lineTo(0.272368, 0.150000).lineTo(0.102632, 0.150000).lineTo(0.015789, 0.000000).close()
solid3=wp_sketch3.add(loop5).add(loop6).extrude(0.375000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
