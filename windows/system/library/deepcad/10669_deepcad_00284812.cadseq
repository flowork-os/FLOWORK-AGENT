import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.008623, -0.020818), (0.029441, -0.029441)).lineTo(1.368997, -0.029441).threePointArc((1.389814, -0.020818), (1.398438, 0.000000)).lineTo(1.398438, 0.323849).lineTo(0.000000, 0.323849).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.220806, 0.147204).lineTo(0.220806, 0.206086).lineTo(0.206086, 0.206086).lineTo(0.206086, 0.147204).close()
loop2=wp_sketch0.moveTo(1.192352, 0.147204).lineTo(1.192352, 0.206086).lineTo(1.177632, 0.206086).lineTo(1.177632, 0.147204).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
