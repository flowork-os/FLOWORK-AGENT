import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, -0.515625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.031250, 0.000000).lineTo(1.031250, 1.031250).lineTo(0.000000, 1.031250).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.347368, 0.173684).threePointArc((0.385362, 0.179112), (0.379934, 0.217105)).lineTo(0.173684, 0.379934).threePointArc((0.135691, 0.374507), (0.141118, 0.336513)).close()
loop2=wp_sketch0.moveTo(0.488487, 0.683882).threePointArc((0.515625, 0.711020), (0.488487, 0.738158)).lineTo(0.227961, 0.738158).threePointArc((0.255099, 0.711020), (0.227961, 0.683882)).close()
loop3=wp_sketch0.moveTo(0.227961, 0.683882).threePointArc((0.151974, 0.282237), (0.553618, 0.206250)).lineTo(0.716447, 0.325658).threePointArc((0.727303, 0.358224), (0.694737, 0.369079)).lineTo(0.521053, 0.249671).close()
loop4=wp_sketch0.moveTo(0.521053, 0.249671).threePointArc((0.732730, 0.168257), (0.814145, 0.379934)).lineTo(0.814145, 0.662171).threePointArc((0.792434, 0.640461), (0.770724, 0.662171)).lineTo(0.770724, 0.379934).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.027632, 0.000000).circle(0.027632)
solid1=wp_sketch1.add(loop5).extrude(0.101562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.757812, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.006743, 0.000000).threePointArc((0.006503, 0.003906), (0.006743, 0.007812)).lineTo(0.000000, 0.007812).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(-0.007812)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch3.moveTo(0.006743, 0.000000).lineTo(0.006743, 0.007812).lineTo(0.000000, 0.007812).threePointArc((0.000240, 0.003906), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop7).extrude(-0.007812)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch4.moveTo(0.054687, 0.000000).threePointArc((0.054882, 0.003166), (0.054687, 0.006332)).lineTo(0.000000, 0.006332).threePointArc((-0.000195, 0.003166), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop8).extrude(-0.007812)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
