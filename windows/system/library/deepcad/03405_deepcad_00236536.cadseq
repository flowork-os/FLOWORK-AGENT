# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236536" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.273438, 0.000000).circle(0.273438)
loop1=wp_sketch0.moveTo(1.039062, -0.350000).lineTo(1.039062, 0.350000).lineTo(0.273438, 0.350000).threePointArc((0.623437, 0.000000), (0.273438, -0.350000)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.585938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.276316, 0.000000).circle(0.276316)
loop3=wp_sketch1.moveTo(0.276316, 0.000000).circle(0.149671)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.460938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.132812, -0.468750, 0.585938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.239474, 0.000000).lineTo(0.239474, 0.710938).lineTo(0.000000, 0.710938).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(-0.367188)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
