# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, -0.453125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.074187, -0.179103), (0.253289, -0.253289)).lineTo(0.607895, -0.253289).threePointArc((0.786997, -0.179103), (0.861184, 0.000000)).lineTo(0.861184, 0.949836).threePointArc((0.786997, 1.128938), (0.607895, 1.203125)).lineTo(0.253289, 1.203125).threePointArc((0.074187, 1.128938), (0.000000, 0.949836)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.430592, 0.772533).circle(0.253289)
loop2=wp_sketch0.moveTo(0.430592, 0.037993).circle(0.215296)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, 0.242188, 0.171875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.154605, -0.695724).threePointArc((0.172192, -0.549912), (0.278289, -0.448355)).lineTo(0.278289, -0.208717).threePointArc((0.363322, 0.364528), (0.448355, -0.208717)).lineTo(0.448355, -0.448355).threePointArc((0.554452, -0.549912), (0.572039, -0.695724)).lineTo(0.726645, 0.000000).threePointArc((0.363322, 0.453957), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop3).extrude(-0.156250)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
