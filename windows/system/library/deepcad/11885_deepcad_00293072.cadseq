# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00293072" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.445312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.625000, 0.000000).lineTo(0.625000, 0.236842).lineTo(0.625000, 0.480263).lineTo(0.000000, 0.480263).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.177632, 0.236842).circle(0.072368)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.125000, -0.445312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.625000, 0.000000).lineTo(0.625000, 0.480263).lineTo(0.000000, 0.480263).lineTo(0.000000, 0.236842).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.447368, 0.236842).circle(0.072368)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.148438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, -0.445312, 0.148438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.546875, 0.000000).lineTo(0.546875, 0.477796).lineTo(0.000000, 0.477796).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.031250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
