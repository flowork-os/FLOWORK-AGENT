import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.007812, 0.000000).lineTo(1.007812, 0.350082).lineTo(0.742599, 0.445559).lineTo(0.742599, 0.594079).lineTo(1.007812, 0.689556).lineTo(1.007812, 0.975987).lineTo(0.753207, 0.975987).lineTo(0.519819, 0.954770).lineTo(0.148520, 0.954770).lineTo(0.000000, 0.487993).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
