# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.393010, -0.126562).lineTo(0.632812, 0.206497).lineTo(0.393010, 0.539556).lineTo(0.000000, 0.412993).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch3.moveTo(0.346382, 0.006661).lineTo(0.492928, 0.206497).lineTo(0.346382, 0.406332).lineTo(0.113240, 0.326398).lineTo(0.113240, 0.079934).close()
