# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00253810" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.394737).lineTo(1.405263, 0.394737).lineTo(1.405263, 0.315789).lineTo(1.373684, 0.315789).lineTo(1.373684, 0.394737).lineTo(1.310526, 0.394737).lineTo(1.310526, 0.315789).lineTo(1.263158, 0.315789).lineTo(1.263158, 0.394737).lineTo(0.000000, 0.394737).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.552632, 0.094737).lineTo(0.552632, 0.331579).lineTo(0.126316, 0.331579).lineTo(0.126316, 0.094737).close()
loop2=wp_sketch0.moveTo(1.342105, 0.157895).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, -0.164062), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.125000, 0.000000).lineTo(0.125000, 0.043421).lineTo(0.000000, 0.043421).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.039062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.000000, 0.085938), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.034539, 0.000000).lineTo(0.034539, 0.093750).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.015625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
