# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00303021" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.000000, 0.562500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.477714, -0.555181).lineTo(1.226562, -0.555181).lineTo(1.226562, -0.348602).lineTo(0.723026, -0.348602).threePointArc((0.587697, -0.317256), (0.477714, -0.232401)).lineTo(0.167845, 0.142023).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.742188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, 0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.209951, -0.249671).lineTo(0.539062, -0.249671).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.109375, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
