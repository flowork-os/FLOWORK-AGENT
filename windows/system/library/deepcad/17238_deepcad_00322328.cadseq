# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322328" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.476562, 0.000000).lineTo(1.476562, 0.839309).lineTo(0.000000, 0.839309).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.414391, 0.062171).lineTo(1.414391, 0.777138).lineTo(0.062171, 0.777138).lineTo(0.062171, 0.062171).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.742188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, -0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.609375, 0.000000).lineTo(0.609375, 0.057730).lineTo(0.000000, 0.057730).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.359375)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.609375, 0.000000).lineTo(0.609375, 0.057730).lineTo(0.000000, 0.057730).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.359375)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
