# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00358261" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.656250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.343339, -0.095015), (0.686678, 0.000000)).lineTo(0.686678, 1.304688).lineTo(0.000000, 1.304688).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.343339, 0.851480).circle(0.109868)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
