# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00287380" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.236842, 0.000000).circle(0.236842)
loop1=wp_sketch0.moveTo(0.138158, -0.083882).circle(0.064145)
loop2=wp_sketch0.moveTo(0.138158, 0.093750).circle(0.064145)
loop3=wp_sketch0.moveTo(0.325658, -0.083882).circle(0.064145)
loop4=wp_sketch0.moveTo(0.325658, 0.093750).circle(0.064145)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
