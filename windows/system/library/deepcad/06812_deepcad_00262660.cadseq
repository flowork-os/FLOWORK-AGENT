import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.687500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.014474, 0.000000).lineTo(0.014474, -0.065132).lineTo(0.028947, -0.065132).lineTo(0.028947, 0.687500).lineTo(0.014474, 0.687500).lineTo(0.014474, 0.622368).lineTo(0.000000, 0.622368).lineTo(0.000000, 0.426974).lineTo(0.014474, 0.426974).lineTo(0.014474, 0.361842).lineTo(0.000000, 0.361842).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
