# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00364093" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.187500, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.478125, 0.243257).threePointArc((0.560823, 0.377467), (0.478125, 0.511678)).lineTo(0.000000, 0.754934).threePointArc((-0.612590, 0.377467), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.192928, 0.377467).circle(0.243257)
loop2=wp_sketch0.moveTo(0.411020, 0.377467).circle(0.067105)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.093750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
