# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00292116" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.600000).lineTo(0.000000, 0.600000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.363158, 0.284211).circle(0.063158)
loop2=wp_sketch0.moveTo(1.200000, 0.221053).lineTo(1.200000, 0.331579).lineTo(1.089474, 0.331579).lineTo(1.089474, 0.221053).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.335938, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.109375, 0.000000).lineTo(0.109375, 0.109375).lineTo(0.000000, 0.109375).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.296875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.055263, 0.000000).circle(0.054112)
solid2=wp_sketch2.add(loop4).extrude(0.296875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
