import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.396217, 0.000000).lineTo(0.396217, -0.096053).lineTo(0.792434, -0.096053).lineTo(0.792434, 0.000000).lineTo(1.092599, 0.000000).lineTo(1.140625, 0.132072).lineTo(0.792434, 0.132072).lineTo(0.792434, 0.228125).lineTo(0.408224, 0.228125).lineTo(0.408224, 0.132072).lineTo(0.048026, 0.132072).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.398438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
