wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.617188, 0.000000).lineTo(0.617188, 0.344326).lineTo(0.000000, 0.344326).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.081671, 0.004228), (0.136431, 0.064967)).lineTo(0.526234, 0.064967).threePointArc((0.547857, 0.071233), (0.558717, 0.090954)).lineTo(0.558717, 0.253372).threePointArc((0.549203, 0.276341), (0.526234, 0.285855)).lineTo(0.090954, 0.285855).threePointArc((0.071233, 0.274996), (0.064967, 0.253372)).lineTo(0.064967, 0.136431).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.304688)
solid=solid0

