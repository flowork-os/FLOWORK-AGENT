# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220985" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.000000, 0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.008864, -0.021399), (0.030263, -0.030263)).lineTo(0.998684, -0.030263).threePointArc((1.021382, -0.007566), (1.044079, -0.030263)).lineTo(1.437500, -0.030263).lineTo(1.437500, 0.030263).lineTo(0.000000, 0.030263).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.492188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.063158, 0.000000).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.931579).lineTo(1.105263, 0.931579).threePointArc((1.081579, 0.907895), (1.057895, 0.931579)).lineTo(0.094737, 0.931579).threePointArc((0.059888, 0.901355), (0.063158, 0.947368)).lineTo(0.063158, 0.994737).lineTo(0.000000, 0.994737).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.063158, 0.063158).circle(0.031579)
loop3=wp_sketch1.moveTo(1.089474, 0.063158).circle(0.031579)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.085938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
