# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00277169" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.406250, 0.000000).lineTo(0.406250, 0.162500).lineTo(0.000000, 0.162500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.059868, 0.081250).circle(0.038487)
loop2=wp_sketch0.moveTo(0.218092, 0.081250).circle(0.029934)
loop3=wp_sketch0.moveTo(0.393421, 0.106908).circle(0.008553)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.406250, 0.000000).lineTo(0.406250, 0.162500).lineTo(0.000000, 0.162500).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(0.012829, 0.106908).circle(0.008553)
loop6=wp_sketch1.moveTo(0.188158, 0.081250).circle(0.029934)
loop7=wp_sketch1.moveTo(0.346382, 0.081250).circle(0.038487)
solid1=wp_sketch1.add(loop4).add(loop5).add(loop6).add(loop7).extrude(0.023438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
