# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00314355" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.078947, 0.000000).circle(0.077303)
loop1=wp_sketch0.moveTo(0.078947, 0.000000).circle(0.032895)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.593750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.078947, 0.000000).circle(0.077303)
loop3=wp_sketch1.moveTo(0.078947, 0.000000).circle(0.032895)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.102467, 0.029276), (0.131743, -0.073191)).threePointArc((0.151723, -0.059940), (0.175658, -0.058553)).lineTo(1.214967, -0.058553).threePointArc((1.238902, -0.059940), (1.258882, -0.073191)).threePointArc((1.288158, 0.029276), (1.390625, 0.000000)).lineTo(1.361349, 0.058553).threePointArc((1.344733, 0.061917), (1.332072, 0.073191)).lineTo(0.058553, 0.073191).threePointArc((0.045892, 0.061917), (0.029276, 0.058553)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.046875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
