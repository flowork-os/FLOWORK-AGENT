# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, -0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.004687, 0.000000).lineTo(0.004687, 0.117188).lineTo(0.046875, 0.065625).threePointArc((0.222656, -0.024212), (0.398438, 0.065625)).lineTo(0.440625, 0.117188).lineTo(0.440625, 0.000000).lineTo(0.445312, 0.000000).lineTo(0.445312, 0.140625).lineTo(0.393750, 0.070312).threePointArc((0.222656, -0.017129), (0.051562, 0.070312)).lineTo(0.000000, 0.140625).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
