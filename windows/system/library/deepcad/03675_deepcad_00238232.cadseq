wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.531250, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.218750, 0.218750), (0.000000, 0.437500)).lineTo(0.000000, 0.386842).threePointArc((0.047611, 0.354605), (0.000000, 0.322368)).lineTo(0.000000, 0.271711).threePointArc((0.052961, 0.218750), (0.000000, 0.165789)).lineTo(0.000000, 0.115132).threePointArc((0.047611, 0.082895), (0.000000, 0.050658)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0

