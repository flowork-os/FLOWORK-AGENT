# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00356881" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.236842, 0.000000).lineTo(0.236842, 0.236842).lineTo(0.236842, 0.468750).lineTo(0.000000, 0.468750).threePointArc((-0.234375, 0.234375), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.236842).circle(0.049342)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.562500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.284211, 0.000000).lineTo(0.560526, 0.000000).lineTo(0.560526, 0.142105).lineTo(0.560526, 0.607895).lineTo(0.560526, 0.750000).lineTo(0.284211, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.607895).lineTo(0.000000, 0.378947).lineTo(0.000000, 0.142105).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.562500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.281250, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.236842, 0.000000).threePointArc((0.471217, 0.234375), (0.236842, 0.468750)).lineTo(0.000000, 0.468750).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.236842, 0.236842).circle(0.049342)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.562500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
