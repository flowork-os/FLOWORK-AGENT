wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, 0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.032184, -0.287548), (0.287500, -0.423684)).threePointArc((0.500057, -0.462026), (0.605263, -0.650658)).threePointArc((0.592604, -0.814559), (0.469079, -0.923026)).threePointArc((0.783717, -0.895653), (0.907895, -0.605263)).threePointArc((0.972672, -0.433666), (1.134868, -0.348026)).threePointArc((1.309687, -0.392887), (1.407237, -0.544737)).threePointArc((1.358523, -0.207334), (1.044079, -0.075658)).threePointArc((0.828110, 0.147022), (0.968421, 0.423684)).threePointArc((0.701189, 0.413591), (0.544737, 0.196711)).threePointArc((0.487749, -0.041143), (0.287500, -0.181579)).threePointArc((0.113757, -0.138278), (0.000000, 0.000000)).close()
