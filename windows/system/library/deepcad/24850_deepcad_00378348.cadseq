loop0=wp_sketch0.moveTo(0.117599, -0.035280).lineTo(0.164638, 0.117599).lineTo(0.693832, 0.117599).lineTo(1.070148, -0.023520).lineTo(1.117188, 0.094079).lineTo(0.682072, 0.270477).lineTo(0.070559, 0.270477).lineTo(0.000000, 0.000000).close()
