# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00253107" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.710526, 0.000000).lineTo(0.710526, 1.406250).lineTo(0.000000, 1.406250).lineTo(0.000000, 1.050987).lineTo(0.000000, 0.355263).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.355263, 0.355263).circle(0.177632)
loop2=wp_sketch0.moveTo(0.355263, 1.050987).circle(0.177632)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.304688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.177632, 0.000000).circle(0.177632)
solid1=wp_sketch1.add(loop3).extrude(0.210938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, -0.398438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.177632, 0.000000).circle(0.177632)
solid2=wp_sketch2.add(loop4).extrude(0.210938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
