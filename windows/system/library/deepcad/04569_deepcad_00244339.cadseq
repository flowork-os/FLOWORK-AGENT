import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.656250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.105839, 0.000000).lineTo(0.105839, -0.282237).lineTo(0.105839, -0.388076).lineTo(0.623273, -0.388076).lineTo(0.623273, -0.493914).lineTo(1.117188, -0.493914).lineTo(1.117188, 0.094079).lineTo(0.000000, 0.094079).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.929030, -0.305757).circle(0.082319)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.108224, 0.000000).lineTo(0.108224, 0.108224).lineTo(0.108224, 0.218750).lineTo(0.000000, 0.218750).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.437500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.106579, 0.000000).lineTo(0.106579, 0.281250).lineTo(0.000000, 0.281250).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.437500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, 0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.515625, 0.000000).lineTo(0.515625, 0.108553).lineTo(0.000000, 0.108553).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.437500)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
