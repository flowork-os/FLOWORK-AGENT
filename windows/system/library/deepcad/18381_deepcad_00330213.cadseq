# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00330213" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.119737, 0.000000).lineTo(0.119737, 0.119737).threePointArc((0.111184, 0.125227), (0.102632, 0.119737)).lineTo(0.067105, 0.040789).lineTo(0.051316, 0.040789).lineTo(0.017105, 0.119737).threePointArc((0.008553, 0.125301), (0.000000, 0.119737)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.015625, 0.000000, 0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.029112, 0.000000).lineTo(0.029112, -0.043421).threePointArc((0.037993, -0.037720), (0.046875, -0.043421)).lineTo(0.046875, 0.015296).lineTo(0.000000, 0.015296).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
