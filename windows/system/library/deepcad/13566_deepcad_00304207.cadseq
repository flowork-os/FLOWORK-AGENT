# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00304207" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.036184, 0.000000).lineTo(0.036184, 0.021053).lineTo(0.062500, 0.021053).lineTo(0.062500, 0.026316).lineTo(0.031579, 0.026316).lineTo(0.031579, 0.001316).lineTo(0.000000, 0.001316).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.070312, 0.000000, -0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.026316, 0.000000).lineTo(0.026316, -0.021053).lineTo(0.062500, -0.021053).lineTo(0.062500, -0.019079).lineTo(0.031579, -0.019079).lineTo(0.031579, 0.005263).lineTo(0.000000, 0.005263).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.014309, 0.000000).lineTo(0.045312, 0.000000).lineTo(0.181250, 0.000000).lineTo(0.212253, 0.000000).lineTo(0.226562, 0.000000).lineTo(0.226562, 0.069161).lineTo(0.000000, 0.069161).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
