# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.500000, 0.000000).lineTo(0.000000, 0.373684).lineTo(0.000000, 0.000000).close()
