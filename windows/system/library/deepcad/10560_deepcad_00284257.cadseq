# workplane for sketch 6
wp_sketch6 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.500000, 0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
