# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232728" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.588158, 0.000000).circle(0.588158)
solid0=wp_sketch0.add(loop0).extrude(0.523438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, -0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.017877, -0.108972), (0.099013, -0.183882)).lineTo(0.438487, -0.311184).threePointArc((0.671875, -0.356121), (0.905263, -0.311184)).lineTo(1.244737, -0.183882).threePointArc((1.325873, -0.108972), (1.343750, 0.000000)).lineTo(1.287171, 0.353618).threePointArc((1.213503, 0.580505), (1.060855, 0.763816)).lineTo(0.777961, 0.990132).threePointArc((0.671875, 1.026627), (0.565789, 0.990132)).lineTo(0.282895, 0.763816).threePointArc((0.130247, 0.580505), (0.056579, 0.353618)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.664803, 0.268750).circle(0.579934)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.523438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
