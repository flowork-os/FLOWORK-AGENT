# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00313817" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, -0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.734375, 0.000000).lineTo(0.734375, 0.626151).lineTo(0.000000, 0.626151).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.115954, 0.316941).circle(0.030921)
loop2=wp_sketch0.moveTo(0.371053, 0.038651).lineTo(0.510197, 0.038651).lineTo(0.510197, 0.316941).lineTo(0.510197, 0.587500).lineTo(0.371053, 0.587500).lineTo(0.224178, 0.587500).lineTo(0.224178, 0.316941).lineTo(0.224178, 0.038651).close()
loop3=wp_sketch0.moveTo(0.618421, 0.316941).circle(0.030921)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
