# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00247585" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, -0.390625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013368, -0.032273), (0.045641, -0.045641)).lineTo(1.399671, -0.045641).threePointArc((1.431944, -0.032273), (1.445312, 0.000000)).lineTo(1.445312, 0.851974).threePointArc((1.431944, 0.884247), (1.399671, 0.897615)).lineTo(0.045641, 0.897615).threePointArc((0.013368, 0.884247), (0.000000, 0.851974)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.414885, -0.015214).lineTo(1.414885, 0.867188).lineTo(0.030428, 0.867188).lineTo(0.030428, -0.015214).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.398438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.390625, 0.000000).lineTo(1.390625, 0.878289).lineTo(0.000000, 0.878289).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
