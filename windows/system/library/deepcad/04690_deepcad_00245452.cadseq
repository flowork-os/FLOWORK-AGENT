import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.632812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.473684, 0.000000).lineTo(0.473684, 0.442105).threePointArc((0.750000, 0.974675), (1.026316, 0.442105)).lineTo(1.026316, 0.000000).lineTo(1.500000, 0.000000).lineTo(1.500000, 1.263158).lineTo(0.000000, 1.263158).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.284211, 0.157895).circle(0.047368)
loop2=wp_sketch0.moveTo(0.284211, 1.089474).circle(0.047368)
loop3=wp_sketch0.moveTo(1.215789, 0.157895).circle(0.047368)
loop4=wp_sketch0.moveTo(1.215789, 1.089474).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.296875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
