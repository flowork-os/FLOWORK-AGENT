# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00311411" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.131536, -0.317556), (0.186020, -0.186020)).threePointArc((0.209769, -0.128684), (0.267105, -0.104934)).lineTo(0.453125, -0.104934).lineTo(0.453125, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, -0.186020).circle(0.124013)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.203125, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.453125, 0.203125, 0.085938), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.020461, 0.003996), (0.039227, 0.013076)).lineTo(0.257155, 0.135115).threePointArc((0.299069, 0.207031), (0.257155, 0.278947)).lineTo(0.039227, 0.400987).threePointArc((0.020461, 0.410066), (0.000000, 0.414062)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.132812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.367188, 0.125000, 0.085938), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.024279, -0.058615), (0.082895, -0.082895)).lineTo(0.082895, 0.328125).threePointArc((0.024279, 0.303846), (0.000000, 0.245230)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.132812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
