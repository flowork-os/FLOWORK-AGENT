# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239014" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.515625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.706579, 0.000000).threePointArc((0.821077, -0.047427), (0.868503, -0.161924)).lineTo(0.868503, -0.220806).lineTo(1.398438, -0.220806).lineTo(1.398438, 0.942105).lineTo(0.000000, 0.942105).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.338569, 0.206086).circle(0.117763)
loop2=wp_sketch0.moveTo(1.251234, 0.603536).threePointArc((1.339556, 0.691859), (1.251234, 0.780181)).lineTo(0.544655, 0.780181).threePointArc((0.456332, 0.691859), (0.544655, 0.603536)).close()
loop3=wp_sketch0.moveTo(1.133470, 0.147204).circle(0.220806)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.281250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
