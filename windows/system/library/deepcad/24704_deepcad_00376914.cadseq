# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.000000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.914062, 0.000000).lineTo(0.914062, 0.182813).lineTo(0.865954, 0.182813).threePointArc((0.768688, 0.084270), (0.635033, 0.048109)).lineTo(0.269408, 0.048109).threePointArc((0.140564, 0.085569), (0.048109, 0.182813)).lineTo(0.000000, 0.182813).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.390625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
