loop6=wp_sketch3.moveTo(0.043421, 0.000000).circle(0.042516)
loop7=wp_sketch3.moveTo(0.043421, 0.000000).circle(0.035280)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.671875)
