# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, -0.773438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch5.moveTo(0.195312, 0.000000).lineTo(0.195312, 0.004112).lineTo(0.195312, 0.082237).lineTo(0.156250, 0.082237).threePointArc((0.097656, 0.140831), (0.039062, 0.082237)).lineTo(0.000000, 0.082237).lineTo(0.000000, 0.004112).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop6).extrude(0.195312, both=True)
