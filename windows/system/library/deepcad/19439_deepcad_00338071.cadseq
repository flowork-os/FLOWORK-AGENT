# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00338071" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, 0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.695312, 0.000000).lineTo(0.695312, 0.314720).threePointArc((0.347656, 0.662377), (0.000000, 0.314720)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.351316, 0.314720).circle(0.161020)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, -0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.190296, 0.000000).lineTo(0.190296, 0.117105).lineTo(0.505016, 0.117105).lineTo(0.505016, 0.000000).lineTo(0.695312, 0.000000).lineTo(0.695312, 0.234211).lineTo(0.000000, 0.234211).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.320312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.171875, 0.000000, 0.398438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.161842, 0.000000).circle(0.161842)
loop4=wp_sketch2.moveTo(0.161842, 0.000000).circle(0.080921)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.218750)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
