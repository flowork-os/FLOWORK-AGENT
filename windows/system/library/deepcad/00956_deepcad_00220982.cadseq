# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220982" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.593750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 1.187500).lineTo(0.000000, 1.187500).lineTo(0.000000, 0.987500).lineTo(0.000000, 0.075000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.037500, 0.987500).circle(0.025000)
loop2=wp_sketch0.moveTo(0.087500, 0.075000).circle(0.025000)
loop3=wp_sketch0.moveTo(0.662500, 0.075000).circle(0.025000)
loop4=wp_sketch0.moveTo(0.712500, 0.987500).circle(0.025000)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.273438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
