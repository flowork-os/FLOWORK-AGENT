# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00375538" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.210938, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.218750, 0.000000).lineTo(0.218750, 0.193421).lineTo(0.000000, 0.193421).lineTo(0.000000, 0.119737).lineTo(0.000000, 0.073684).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.207237, 0.016118).lineTo(0.207237, 0.177303).lineTo(0.009211, 0.177303).lineTo(0.009211, 0.016118).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.218750, 0.000000).lineTo(0.218750, 0.073684).lineTo(0.218750, 0.117434).lineTo(0.218750, 0.191118).lineTo(0.000000, 0.191118).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.207237, 0.009211).lineTo(0.207237, 0.177303).lineTo(0.011513, 0.177303).lineTo(0.011513, 0.009211).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.039062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.195312, 0.000000).lineTo(0.195312, 0.168586).lineTo(0.000000, 0.168586).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.039062)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.218750, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.195312, 0.000000).lineTo(0.195312, 0.160362).lineTo(0.000000, 0.160362).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.039062)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.500000, 0.000000).lineTo(0.500000, 0.042105).lineTo(0.000000, 0.042105).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(0.039062)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
