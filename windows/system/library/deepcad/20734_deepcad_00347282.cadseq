# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00347282" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, -0.398438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.492188, 0.000000).lineTo(1.492188, 0.801069).lineTo(0.000000, 0.801069).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.460773, 0.047122).lineTo(1.460773, 0.769655).lineTo(0.031414, 0.769655).lineTo(0.031414, 0.047122).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.132812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
