# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00390416" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.418421).lineTo(0.000000, 0.418421).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.235209, 0.014248), (0.284211, 0.244737)).lineTo(0.165789, 0.292105).close()
loop2=wp_sketch0.moveTo(0.347368, 0.165789).threePointArc((0.375000, 0.189922), (0.402632, 0.165789)).lineTo(0.434211, 0.165789).threePointArc((0.375000, 0.220793), (0.315789, 0.165789)).close()
loop3=wp_sketch0.moveTo(0.315789, 0.165789).threePointArc((0.498054, 0.126834), (0.584211, 0.292105)).lineTo(0.465789, 0.244737).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
