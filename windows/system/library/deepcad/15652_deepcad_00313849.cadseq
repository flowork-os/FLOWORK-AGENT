wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000096, -0.000233), (0.000329, -0.000329)).lineTo(0.007566, -0.000329).threePointArc((0.007881, -0.000267), (0.008059, 0.000000)).lineTo(0.008059, 0.015296).threePointArc((0.007881, 0.015563), (0.007566, 0.015625)).lineTo(0.000329, 0.015625).threePointArc((0.000096, 0.015529), (0.000000, 0.015296)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.007566, 0.000000).lineTo(0.007566, 0.015296).lineTo(0.000329, 0.015296).lineTo(0.000329, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
