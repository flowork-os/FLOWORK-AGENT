# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00319790" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, 0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.444737, 0.000000).lineTo(0.444737, -0.583717).lineTo(1.320312, -0.583717).lineTo(1.320312, -0.291859).lineTo(0.736595, -0.291859).lineTo(0.736595, 0.291859).lineTo(0.000000, 0.291859).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.734375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.164062, -0.296875, -0.140625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.296053, 0.000000).lineTo(0.296053, 0.585938).lineTo(0.000000, 0.585938).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.437500)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
