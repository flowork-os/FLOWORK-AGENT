# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00333559" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.546875, 0.132812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.359211, 0.000000).lineTo(0.359211, -0.224507).lineTo(0.609375, -0.224507).lineTo(0.609375, 0.166776).lineTo(0.000000, 0.166776).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.054688, -0.085938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.213816, 0.000000).lineTo(0.213816, 0.390625).lineTo(0.000000, 0.390625).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.320312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.570312, -0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.153947, 0.000000).circle(0.150740)
solid2=wp_sketch2.add(loop2).extrude(0.257812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.789062, 0.000000, 0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.067105, 0.000000).circle(0.067105)
solid3=wp_sketch3.add(loop3).extrude(0.257812)
solid=solid.intersect(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.539062, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.104359, 0.000000).circle(0.104359)
solid4=wp_sketch4.add(loop4).extrude(0.257812)
solid=solid.intersect(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
