wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.387747, -0.643092).threePointArc((0.439762, -0.672138), (0.491776, -0.643092)).lineTo(0.879523, 0.000000).threePointArc((0.893329, 0.088086), (0.841694, 0.160773)).threePointArc((0.625769, 0.199055), (0.444490, 0.075658)).threePointArc((0.258482, 0.200980), (0.037829, 0.160773)).threePointArc((-0.013806, 0.088086), (0.000000, 0.000000)).close()
