wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.640625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.726316).threePointArc((1.472252, 0.793305), (1.405263, 0.821053)).lineTo(1.357895, 0.821053).threePointArc((1.334279, 0.813090), (1.326316, 0.789474)).threePointArc((0.750000, 0.041577), (0.173684, 0.789474)).threePointArc((0.165721, 0.813090), (0.142105, 0.821053)).lineTo(0.094737, 0.821053).threePointArc((0.027748, 0.793305), (0.000000, 0.726316)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438, both=True)
solid=solid0

if __name__ == '__main__':
