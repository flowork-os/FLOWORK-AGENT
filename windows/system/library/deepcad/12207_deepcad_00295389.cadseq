# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00295389" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.663158, 0.000000).circle(0.663158)
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.730263, 0.000000).circle(0.730263)
loop2=wp_sketch1.moveTo(0.730263, 0.684622).circle(0.015214)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.039062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.609375, -0.039062), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((-0.023520, -0.087696), (0.049836, -0.141201)).lineTo(0.714309, -0.141201).threePointArc((0.787664, -0.087696), (0.764145, 0.000000)).threePointArc((0.382072, -0.108262), (0.000000, 0.000000)).close()
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((-0.004153, -0.070600), (0.066447, -0.074753)).lineTo(0.066447, -0.041530).threePointArc((0.053988, -0.029071), (0.041530, -0.041530)).lineTo(0.041530, -0.074753).close()
loop5=wp_sketch2.moveTo(0.041530, -0.074753).threePointArc((0.382072, -0.415296), (0.722615, -0.074753)).lineTo(0.722615, -0.041530).threePointArc((0.710156, -0.029071), (0.697697, -0.041530)).lineTo(0.697697, -0.074753).close()
solid2=wp_sketch2.add(loop3).add(loop4).add(loop5).extrude(0.132812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
