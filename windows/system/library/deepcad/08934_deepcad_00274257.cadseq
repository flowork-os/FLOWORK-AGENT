import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.000000, -0.687500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.017728, -0.042799), (0.060526, -0.060526)).lineTo(0.620395, -0.060526).threePointArc((0.663193, -0.042799), (0.680921, 0.000000)).lineTo(0.680921, 1.376974).threePointArc((0.663193, 1.419772), (0.620395, 1.437500)).lineTo(0.060526, 1.437500).threePointArc((0.017728, 1.419772), (0.000000, 1.376974)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.075658, 0.015132).circle(0.030263)
loop2=wp_sketch0.moveTo(0.075658, 1.361842).circle(0.030263)
loop3=wp_sketch0.moveTo(0.605263, 0.015132).circle(0.030263)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.023438, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
