# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00280144" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.531250, -0.242188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.281250, 0.000000).lineTo(1.281250, 0.674342).lineTo(0.000000, 0.674342).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.391118, 0.323684).circle(0.107895)
loop2=wp_sketch0.moveTo(1.025000, 0.202303).lineTo(1.025000, 0.418092).lineTo(0.795724, 0.418092).lineTo(0.795724, 0.202303).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.164062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
