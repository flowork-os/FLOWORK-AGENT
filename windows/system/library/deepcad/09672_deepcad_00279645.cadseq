# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.562500, 0.367188, -0.171875), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.003865, 0.000000).lineTo(0.003865, 0.057977).lineTo(0.096628, 0.057977).lineTo(0.096628, 0.115954).lineTo(0.367188, 0.115954).lineTo(0.367188, 0.274424).lineTo(0.000000, 0.274424).lineTo(0.000000, 0.000000).close()
