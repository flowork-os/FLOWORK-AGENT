# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.203125, -0.367188, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.270559, 0.000000).lineTo(0.270559, -0.057977).lineTo(0.363322, -0.057977).lineTo(0.363322, -0.115954).lineTo(0.367188, -0.115954).lineTo(0.367188, 0.158470).lineTo(0.000000, 0.158470).lineTo(0.000000, 0.000000).close()
