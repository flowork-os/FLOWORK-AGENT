wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.165789).lineTo(0.615789, 0.165789).lineTo(0.615789, 0.086842).lineTo(0.513158, 0.086842).lineTo(0.513158, 0.165789).lineTo(0.513158, 0.252632).lineTo(0.347368, 0.252632).lineTo(0.347368, 0.165789).lineTo(0.347368, 0.086842).lineTo(0.252632, 0.086842).lineTo(0.252632, 0.165789).lineTo(0.000000, 0.165789).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
