# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00313646" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.289062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.156250, 0.000000).lineTo(1.156250, 0.778947).lineTo(0.000000, 0.778947).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.071053, 0.073026).lineTo(1.071053, 0.705921).lineTo(0.048684, 0.705921).lineTo(0.048684, 0.340789).lineTo(0.133882, 0.340789).lineTo(0.133882, 0.231250).lineTo(0.048684, 0.231250).lineTo(0.048684, 0.073026).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.429688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
