import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.072697, 0.000000).threePointArc((0.145521, 0.108304), (0.265625, 0.159375)).lineTo(0.265625, 0.232072).threePointArc((0.095267, 0.159009), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.095267, -0.159009), (0.265625, -0.232072)).lineTo(0.265625, -0.159375).threePointArc((0.145521, -0.108304), (0.072697, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.148438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.072697, 0.000000).threePointArc((0.062847, 0.066406), (0.072697, 0.132812)).lineTo(0.000000, 0.132812).threePointArc((-0.007364, 0.066406), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.148438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.460938, 0.000000).threePointArc((0.453674, 0.065502), (0.460938, 0.131003)).lineTo(0.000000, 0.131003).lineTo(0.000000, 0.000000).close()
