# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00310255" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.101379, -0.200140), (0.323766, -0.229770)).threePointArc((0.496094, -0.198778), (0.668421, -0.229770)).threePointArc((0.890808, -0.200140), (0.992188, 0.000000)).lineTo(0.992188, 0.710197).lineTo(0.000000, 0.710197).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.240214, 0.000000).circle(0.073109)
loop2=wp_sketch0.moveTo(0.501316, 0.511760).circle(0.073109)
loop3=wp_sketch0.moveTo(0.751974, 0.000000).circle(0.073109)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(-0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
