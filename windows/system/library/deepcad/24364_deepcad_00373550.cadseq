wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.656250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.021678, -0.052335), (0.074013, -0.074013)).lineTo(1.273026, -0.074013).threePointArc((1.317960, -0.049269), (1.332237, 0.000000)).lineTo(1.332237, 1.332237).threePointArc((1.317960, 1.381506), (1.273026, 1.406250)).lineTo(0.074013, 1.406250).threePointArc((0.021678, 1.384572), (0.000000, 1.332237)).lineTo(0.000000, 0.000000).close()
