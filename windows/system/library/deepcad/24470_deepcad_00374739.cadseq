loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.030470, -0.073560), (0.104030, -0.104030)).lineTo(0.794408, -0.104030).threePointArc((0.867968, -0.073560), (0.898438, 0.000000)).lineTo(0.898438, 0.690378).threePointArc((0.867968, 0.763938), (0.794408, 0.794408)).lineTo(0.104030, 0.794408).threePointArc((0.030470, 0.763938), (0.000000, 0.690378)).lineTo(0.000000, 0.000000).close()
