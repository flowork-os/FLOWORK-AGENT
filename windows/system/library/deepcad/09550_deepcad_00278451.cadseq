# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00278451" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.562500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.121053).lineTo(0.000000, 1.121053).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.357895, 0.142105).lineTo(1.357895, 0.978947).lineTo(0.142105, 0.978947).lineTo(0.142105, 0.142105).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(1.218750, 0.000000).lineTo(1.218750, 0.846711).lineTo(0.000000, 0.846711).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.156250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(1.218750, 0.000000).lineTo(1.218750, 0.846711).lineTo(0.000000, 0.846711).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.039062)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
