# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00307161" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, -0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.409375, 0.000000).lineTo(0.409375, 0.614063).lineTo(0.409375, 0.818750).lineTo(0.204688, 1.023438).lineTo(0.000000, 0.818750).lineTo(0.000000, 0.614063).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.193914, 0.614063).circle(0.075411)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
