# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00363274" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, -0.328125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.304688, 0.000000).lineTo(1.304688, 0.535609).lineTo(0.000000, 0.535609).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.563076, 0.439474).circle(0.054934)
loop2=wp_sketch0.moveTo(1.208553, 0.439474).circle(0.054934)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.093750, -0.031250, 0.031250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.437500, 0.000000).lineTo(0.437500, 0.234868).lineTo(0.000000, 0.234868).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.164062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, -0.273438, 0.031250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.234868, 0.000000).lineTo(0.234868, 0.437500).lineTo(0.000000, 0.437500).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.164062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
