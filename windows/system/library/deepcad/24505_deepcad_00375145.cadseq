# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00375145" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, -0.734375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.117599, 0.000000).lineTo(0.117599, 0.446875).lineTo(0.117599, 0.564474).lineTo(0.117599, 1.117188).lineTo(0.000000, 1.117188).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.500000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.390625, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.106579, 0.000000).lineTo(0.106579, 1.125000).lineTo(0.000000, 1.125000).lineTo(0.000000, 0.568421).lineTo(0.000000, 0.461842).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.500000, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, -0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.781250, 0.000000).lineTo(0.781250, 0.115132).lineTo(0.000000, 0.115132).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.085938, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
