import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.063589, -0.153517), (0.217105, -0.217105)).lineTo(0.642270, -0.217105).threePointArc((0.795786, -0.153517), (0.859375, 0.000000)).lineTo(0.859375, 0.434211).threePointArc((0.793913, 0.583204), (0.642270, 0.642270)).lineTo(0.217105, 0.642270).threePointArc((0.065462, 0.583204), (0.000000, 0.434211)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.434211, 0.217105).circle(0.217105)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.640625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
