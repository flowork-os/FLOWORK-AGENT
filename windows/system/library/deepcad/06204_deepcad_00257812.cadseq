import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.445312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.107252, -0.354480), (0.410197, -0.141447)).threePointArc((0.417764, -0.115845), (0.438487, -0.099013)).threePointArc((0.719017, -0.037568), (1.004276, -0.070724)).threePointArc((1.028348, -0.094050), (1.032566, -0.127303)).threePointArc((1.222937, -0.287635), (1.315461, -0.056579)).threePointArc((1.309260, -0.048634), (1.301316, -0.042434)).threePointArc((0.665001, 0.151268), (0.014145, 0.014145)).threePointArc((0.006200, 0.007945), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.183882, -0.141447).circle(0.113158)
loop2=wp_sketch0.moveTo(1.188158, -0.141447).circle(0.070724)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.226562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
