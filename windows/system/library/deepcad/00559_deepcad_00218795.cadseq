# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00218795" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.222656, -0.144854), (0.445312, 0.000000)).lineTo(0.445312, 0.126562).lineTo(0.356250, 0.126562).lineTo(0.356250, 0.304688).threePointArc((0.154508, 0.334712), (0.000000, 0.201563)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, 0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.356908, 0.000000).lineTo(0.356908, 0.063322).lineTo(0.472039, 0.063322).lineTo(0.472039, 0.546875).lineTo(0.356908, 0.546875).lineTo(0.356908, 0.259046).threePointArc((0.267681, 0.169819), (0.178454, 0.259046)).lineTo(0.178454, 0.546875).lineTo(0.000000, 0.546875).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.101562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
