# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00361122" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.682895, 0.000000).circle(0.682895)
loop1=wp_sketch0.moveTo(0.312993, -0.213405).circle(0.085362)
loop2=wp_sketch0.moveTo(0.682895, 0.000000).circle(0.156497)
loop3=wp_sketch0.moveTo(0.682895, 0.426809).circle(0.085362)
loop4=wp_sketch0.moveTo(1.038569, -0.213405).circle(0.085362)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.585938, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.757895)
loop6=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.678947)
solid1=wp_sketch1.add(loop5).add(loop6).extrude(0.601562, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
