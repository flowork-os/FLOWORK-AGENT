# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00327669" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.099095, 0.000000).threePointArc((1.289062, 0.189967), (1.099095, 0.379934)).lineTo(0.000000, 0.379934).threePointArc((-0.189967, 0.189967), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.189967).circle(0.094984)
loop2=wp_sketch0.moveTo(1.099095, 0.189967).circle(0.094984)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.109375, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.222286, 0.000000).lineTo(0.222286, 0.285197).threePointArc((0.111143, 0.396340), (0.000000, 0.285197)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.113240, 0.285197).circle(0.050329)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.257812, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
