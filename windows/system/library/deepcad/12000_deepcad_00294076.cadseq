# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00294076" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.030428, 0.000000).circle(0.030428)
loop1=wp_sketch0.moveTo(0.066941, -0.060855).lineTo(0.066941, -0.450329).lineTo(0.480757, -0.450329).lineTo(0.480757, -0.060855).lineTo(0.517270, -0.060855).threePointArc((0.578125, 0.000000), (0.517270, 0.060855)).lineTo(0.480757, 0.060855).lineTo(0.480757, 0.377303).lineTo(0.066941, 0.377303).lineTo(0.066941, 0.060855).lineTo(0.030428, 0.060855).threePointArc((0.091283, 0.000000), (0.030428, -0.060855)).close()
loop2=wp_sketch0.moveTo(0.273849, 0.000000).circle(0.097368)
loop3=wp_sketch0.moveTo(0.517270, 0.000000).circle(0.030428)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.098684, 0.000000).circle(0.098684)
solid1=wp_sketch1.add(loop4).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch2.moveTo(0.098684, 0.000000).circle(0.098684)
solid2=wp_sketch2.add(loop5).extrude(-0.195312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
