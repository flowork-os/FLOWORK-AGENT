# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00307929" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.992188, 0.000000).lineTo(0.992188, 0.992188).lineTo(0.741530, 0.992188).lineTo(0.000000, 0.250658).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.125329, 0.125329).circle(0.041776)
loop2=wp_sketch0.moveTo(0.501316, 0.125329).circle(0.041776)
loop3=wp_sketch0.moveTo(0.866859, 0.125329).circle(0.041776)
loop4=wp_sketch0.moveTo(0.866859, 0.501316).circle(0.041776)
loop5=wp_sketch0.moveTo(0.866859, 0.866859).circle(0.041776)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(-0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
