import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.188956, -0.208173), (0.092105, -0.201480)).lineTo(0.546875, -0.201480).lineTo(0.546875, 0.040296).threePointArc((0.430604, 0.190017), (0.259046, 0.109375)).threePointArc((0.150618, 0.004725), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.397204, 0.040296).circle(0.074836)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.382812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
