# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257627" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.523438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.130312, -0.285783), (0.414474, -0.151974)).threePointArc((0.445809, -0.100414), (0.497368, -0.069079)).threePointArc((0.747121, -0.037537), (0.994737, -0.082895)).threePointArc((1.034421, -0.104096), (1.063816, -0.138158)).threePointArc((1.244189, -0.194871), (1.298684, -0.013816)).threePointArc((0.661003, 0.221012), (0.013816, 0.013816)).threePointArc((0.005926, 0.007889), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.207237, -0.082895).circle(0.110526)
loop2=wp_sketch0.moveTo(1.188158, -0.082895).circle(0.069079)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.218750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.523438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.130312, -0.285783), (0.414474, -0.151974)).threePointArc((0.445809, -0.100414), (0.497368, -0.069079)).threePointArc((0.747121, -0.037537), (0.994737, -0.082895)).threePointArc((1.034421, -0.104096), (1.063816, -0.138158)).threePointArc((1.244189, -0.194871), (1.298684, -0.013816)).threePointArc((0.661003, 0.221012), (0.013816, 0.013816)).threePointArc((0.005926, 0.007889), (0.000000, 0.000000)).close()
loop4=wp_sketch1.moveTo(0.207237, -0.082895).circle(0.110526)
loop5=wp_sketch1.moveTo(1.188158, -0.082895).circle(0.069079)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.218750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
