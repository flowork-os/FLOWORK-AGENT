import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.086842, 0.000000).lineTo(0.181579, 0.000000).lineTo(0.181579, 0.481579).lineTo(0.150000, 0.686842).threePointArc((0.090789, 0.746053), (0.031579, 0.686842)).lineTo(0.000000, 0.481579).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.118421, -0.007895), (0.126316, 0.110526)).lineTo(0.126316, 0.339474).threePointArc((0.090789, 0.375000), (0.055263, 0.339474)).lineTo(0.055263, 0.110526).close()
loop2=wp_sketch0.moveTo(0.086842, 0.528947).circle(0.015789)
loop3=wp_sketch0.moveTo(0.086842, 0.607895).circle(0.015789)
loop4=wp_sketch0.moveTo(0.086842, 0.678947).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
