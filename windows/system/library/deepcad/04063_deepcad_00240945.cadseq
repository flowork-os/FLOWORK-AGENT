import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.125000, 0.000000).lineTo(0.125000, 0.118421).threePointArc((0.187500, 0.180921), (0.250000, 0.118421)).lineTo(0.250000, 0.000000).lineTo(0.460526, 0.000000).lineTo(0.460526, 0.210526).lineTo(0.625000, 0.210526).lineTo(0.625000, 0.282895).threePointArc((0.560501, 0.417310), (0.414474, 0.447368)).lineTo(0.000000, 0.335526).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.625000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
