# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00262873" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.414474, 0.000000).lineTo(0.414474, 0.820313).lineTo(0.000000, 0.820313).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.379934, 0.034539).lineTo(0.379934, 0.785773).lineTo(0.034539, 0.785773).lineTo(0.034539, 0.034539).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, -0.406250, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.546875, 0.000000).lineTo(0.546875, 0.207237).lineTo(0.000000, 0.207237).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.406250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, -0.406250, 0.242188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.820313, 0.000000).lineTo(0.820313, 0.025905).lineTo(0.000000, 0.025905).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.132812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
