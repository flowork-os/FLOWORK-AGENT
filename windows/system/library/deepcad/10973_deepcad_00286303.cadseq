loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013874, -0.033495), (0.047368, -0.047368)).lineTo(0.702632, -0.047368).threePointArc((0.736126, -0.033495), (0.750000, 0.000000)).lineTo(0.750000, 0.663158).threePointArc((0.734491, 0.692705), (0.702632, 0.702632)).lineTo(0.047368, 0.702632).threePointArc((0.015509, 0.692705), (0.000000, 0.663158)).lineTo(0.000000, 0.000000).close()
