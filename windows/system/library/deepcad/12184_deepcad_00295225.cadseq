# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00295225" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.045311, -0.071813), (0.016283, -0.130263)).lineTo(0.700164, -0.130263).threePointArc((0.750761, -0.113402), (0.773437, -0.065132)).lineTo(0.773437, 0.276809).threePointArc((0.740501, 0.332582), (0.675740, 0.333799)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.024424, -0.065132).circle(0.008141)
loop2=wp_sketch0.moveTo(0.708306, 0.276809).circle(0.008141)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
