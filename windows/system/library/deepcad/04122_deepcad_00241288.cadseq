import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.229472, -0.221176), (0.000000, -0.442352)).threePointArc((0.109306, -0.460637), (0.201069, -0.522780)).threePointArc((0.522780, -0.660686), (0.844490, -0.522780)).threePointArc((0.936253, -0.460637), (1.045559, -0.442352)).threePointArc((1.275032, -0.221176), (1.045559, 0.000000)).threePointArc((0.936253, 0.018285), (0.844490, 0.080428)).threePointArc((0.522780, 0.218334), (0.201069, 0.080428)).threePointArc((0.109306, 0.018285), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.013405, -0.214474).circle(0.093832)
loop2=wp_sketch0.moveTo(0.522780, -0.214474).circle(0.308306)
loop3=wp_sketch0.moveTo(1.058964, -0.227878).circle(0.093832)
