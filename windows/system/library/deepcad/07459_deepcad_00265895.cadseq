# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00265895" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.678947, -0.078947), (0.757895, 0.600000)).threePointArc((0.734211, 0.576316), (0.757895, 0.552632)).threePointArc((1.310526, 0.000000), (0.757895, -0.552632)).threePointArc((0.734211, -0.576316), (0.757895, -0.600000)).close()
loop2=wp_sketch0.moveTo(0.757895, -0.600000).threePointArc((1.278947, -0.078947), (0.757895, 0.442105)).threePointArc((0.734211, 0.418421), (0.757895, 0.394737)).threePointArc((1.152632, 0.000000), (0.757895, -0.394737)).threePointArc((0.734211, -0.418421), (0.757895, -0.442105)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
