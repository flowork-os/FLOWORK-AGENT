import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.000000, -0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.054770, 0.000000).lineTo(0.054770, -0.073026).lineTo(0.167352, -0.073026).lineTo(0.167352, 0.000000).lineTo(0.222122, 0.000000).lineTo(0.222122, 0.139967).lineTo(0.222122, 0.289062).lineTo(0.112582, 0.289062).lineTo(0.000000, 0.289062).lineTo(0.000000, 0.139967).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.112582, 0.139967).circle(0.054770)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.242188, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.055263, 0.000000).circle(0.055263)
solid1=wp_sketch1.add(loop2).extrude(0.226562)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.242188, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.055263, 0.000000).circle(0.055263)
solid1=wp_sketch1.add(loop2).extrude(-0.226562)
solid_temp=solid_temp.union(solid1)
solid=solid.cut(solid_temp)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.617188, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.055263, 0.000000).circle(0.054112)
solid2=wp_sketch2.add(loop3).extrude(0.226562)
solid_temp=solid2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.617188, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.055263, 0.000000).circle(0.054112)
