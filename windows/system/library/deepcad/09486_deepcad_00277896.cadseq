# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00277896" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.007812, 0.000000, -0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.664062, 0.054688).threePointArc((0.743894, 0.140625), (0.664062, 0.226562)).lineTo(0.000000, 0.281250).threePointArc((-0.151380, 0.140625), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.007812, 0.140625).circle(0.070312)
loop2=wp_sketch0.moveTo(0.656250, 0.140625).circle(0.031250)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
