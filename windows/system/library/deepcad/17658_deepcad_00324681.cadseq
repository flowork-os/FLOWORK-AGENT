# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00324681" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.484375, 0.000000).lineTo(1.484375, 0.562500).lineTo(0.000000, 0.562500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.156250, 0.265625).lineTo(0.218750, 0.265625).lineTo(1.312500, 0.265625).lineTo(1.312500, 0.359375).lineTo(1.203125, 0.359375).lineTo(1.203125, 0.515625).lineTo(1.125000, 0.515625).lineTo(1.125000, 0.359375).lineTo(0.218750, 0.359375).lineTo(0.218750, 0.437500).lineTo(0.109375, 0.437500).lineTo(0.109375, 0.265625).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.132812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
