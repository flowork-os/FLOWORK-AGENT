# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00333486" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.656250, 0.000000).lineTo(0.656250, 0.331579).lineTo(0.179605, 0.504276).lineTo(0.000000, 0.566447).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.656250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.000000, 0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.474671, -0.170395).lineTo(0.474671, -0.499013).lineTo(1.156250, -0.499013).lineTo(1.156250, -0.413816).lineTo(0.815461, -0.292105).lineTo(0.815461, 0.133882).lineTo(0.000000, 0.133882).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.632895, -0.048684).circle(0.073026)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.359375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
