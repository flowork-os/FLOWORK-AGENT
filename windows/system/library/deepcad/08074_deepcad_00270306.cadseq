# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00270306" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.582566, 0.000000).threePointArc((0.595998, 0.005564), (0.601562, 0.018997)).lineTo(0.601562, 0.284951).threePointArc((0.595998, 0.298383), (0.582566, 0.303947)).lineTo(0.000000, 0.303947).threePointArc((-0.151974, 0.151974), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.151974).circle(0.113980)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.148438, 0.000000, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.013258, 0.005492), (0.018750, 0.018750)).lineTo(0.018750, 0.021875).threePointArc((0.012611, 0.033571), (0.000000, 0.037500)).threePointArc((-0.110938, 0.148438), (0.000000, 0.259375)).threePointArc((0.012611, 0.263304), (0.018750, 0.275000)).lineTo(0.018750, 0.278125).threePointArc((0.013258, 0.291383), (0.000000, 0.296875)).threePointArc((-0.148438, 0.148438), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.710938, 0.015625, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.019243, -0.019243), (0.038487, 0.000000)).lineTo(0.038487, 0.263487).threePointArc((0.019243, 0.282730), (0.000000, 0.263487)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.078125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
