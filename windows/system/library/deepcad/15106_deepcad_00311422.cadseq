import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.250000, 0.070312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.020714, -0.050009), (0.070724, -0.070724)).lineTo(0.247533, -0.070724).lineTo(0.247533, -0.028289).lineTo(0.070724, -0.028289).threePointArc((0.050720, -0.020004), (0.042434, 0.000000)).lineTo(0.042434, 0.335938).lineTo(0.000000, 0.335938).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.320312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.178701, 0.000000).threePointArc((0.231094, 0.021702), (0.252796, 0.074095)).lineTo(0.252796, 0.414062).lineTo(0.209211, 0.414062).lineTo(0.209211, 0.074095).threePointArc((0.200274, 0.052522), (0.178701, 0.043586)).lineTo(0.000000, 0.043586).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.320312)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
