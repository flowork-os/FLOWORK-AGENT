# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00289526" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.250000).lineTo(0.000000, 0.250000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.226316, 0.026316).lineTo(0.226316, 0.226316).lineTo(0.026316, 0.226316).lineTo(0.026316, 0.026316).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.289062, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.250000).lineTo(0.000000, 0.250000).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.226316, 0.026316).lineTo(0.226316, 0.226316).lineTo(0.026316, 0.226316).lineTo(0.026316, 0.026316).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.250000).lineTo(0.000000, 0.250000).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.226316, 0.026316).lineTo(0.226316, 0.226316).lineTo(0.026316, 0.226316).lineTo(0.026316, 0.026316).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.046875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
