# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00223210" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, -0.359375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.703947, 0.193586).threePointArc((0.829389, 0.356373), (0.703947, 0.519161)).lineTo(0.000000, 0.712747).threePointArc((-0.462473, 0.356373), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.096793, 0.351974).circle(0.281579)
loop2=wp_sketch0.moveTo(0.659951, 0.351974).circle(0.087993)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.086842, 0.000000).circle(0.085033)
solid1=wp_sketch1.add(loop3).extrude(0.117188, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
