# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00330055" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.360937, 0.037993).lineTo(0.481250, 0.601562).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.227961, 0.075987).circle(0.025329)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.320312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.531250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.243750, -0.525987).lineTo(0.609375, -0.487500).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.397697, -0.455428).circle(0.019243)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.361184, 0.035526).lineTo(0.118421, 0.562500).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.165789, 0.065132).circle(0.023684)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.179688)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
