# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00317525" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, 0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.132812, 0.000000).lineTo(1.132812, 0.274260).lineTo(0.000000, 0.274260).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.214638, 0.059622).lineTo(0.214638, 0.250411).lineTo(0.119243, 0.250411).lineTo(0.119243, 0.059622).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.375000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
