loop0=wp_sketch0.moveTo(0.071053, 0.000000).lineTo(0.071053, 0.110526).lineTo(0.655263, 0.110526).lineTo(0.655263, 0.000000).lineTo(0.734211, 0.000000).lineTo(0.734211, 0.221053).lineTo(0.694737, 0.221053).lineTo(0.694737, 0.442105).threePointArc((0.382895, 0.753947), (0.071053, 0.442105)).lineTo(0.071053, 0.221053).lineTo(0.000000, 0.221053).lineTo(0.000000, 0.000000).close()
