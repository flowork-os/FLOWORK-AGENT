import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.250000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.157895, 0.000000).lineTo(0.355263, 0.000000).threePointArc((0.396662, -0.019533), (0.410526, -0.063158)).threePointArc((0.694403, -0.195242), (0.576316, 0.094737)).lineTo(0.000000, 0.094737).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.576316, -0.078947).circle(0.110526)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.187500)
solid=solid0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.250000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.157895, 0.000000).lineTo(0.355263, 0.000000).threePointArc((0.396662, -0.019533), (0.410526, -0.063158)).threePointArc((0.694403, -0.195242), (0.576316, 0.094737)).lineTo(0.000000, 0.094737).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.576316, -0.078947).circle(0.110526)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.148438)
solid=solid.union(solid0)
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.164062, 0.000000, 0.250000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.320312, -0.215789).threePointArc((0.262274, -0.148259), (0.246135, -0.060691)).threePointArc((0.230704, -0.017851), (0.188816, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.031250, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
