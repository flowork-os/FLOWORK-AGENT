{
  "$schema": "https://floworkos.com/schemas/agent.v2.json",
  "id": "quality-control",
  "agent_id": "agent-quality-control-01",
  "name": "Quality Control",
  "role": "Quality Control & Release Gatekeeper",
  "icon": "🧪",
  "department": "qa",
  "description": "Specialist in end-to-end automated testing, empirical Exit Code 0 verification, GUI visual inspection, regression prevention, and production release certification. Strictly verifies deliverables without mutating source code.",
  "owner": "Awenk Audico",
  "allowed_tools": [
    "run_command",
    "view_file",
    "write_to_file",
    "screenshot",
    "team_dispatch",
    "read_url_content"
  ],
  "default_tools": [
    "run_command",
    "view_file",
    "write_to_file",
    "screenshot",
    "team_dispatch"
  ],
  "locked_tools": [
    "replace_file_content",
    "edit_file",
    "file_ops",
    "app_publish"
  ],
  "guardian": {
    "dispatch": {
      "allow": [
        "leader",
        "backend-engineer",
        "frontend-engineer",
        "security-auditor",
        "mr.flow"
      ],
      "deny": []
    },
    "tools": {
      "allow": [
        "run_command",
        "view_file",
        "write_to_file",
        "screenshot",
        "team_dispatch",
        "read_url_content"
      ],
      "deny": [
        "replace_file_content",
        "edit_file",
        "file_ops",
        "app_publish"
      ]
    },
    "filesystem": {
      "allowed_extensions": [
        ".md"
      ],
      "prohibited_extensions": [
        ".rs",
        ".js",
        ".ts",
        ".html",
        ".css",
        ".py",
        ".go",
        ".c",
        ".cpp",
        ".sql",
        ".sh",
        ".bash",
        ".bin",
        ".exe",
        ".so",
        ".lock",
        ".env",
        ".pem",
        ".key"
      ]
    }
  },
  "pinned_model": {
    "model_id": "gemini-3.8-flash-high",
    "fallback_model_id": "gemini-3.8-flash-high",
    "temperature": 0.2,
    "enforce_lock": false
  },
  "pinned_account": {
    "account_id": "combo",
    "pool_strategy": "combo",
    "required_tier": "free",
    "isolated_profile": false
  },
  "harness": {
    "output_token_budget": 250,
    "max_summary_chars": 1000,
    "format_contract": "markdown_table_status",
    "compression_mode": "head_tail_preservation"
  }
}
