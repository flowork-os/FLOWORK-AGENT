  "connections": [
    {
      "id": "conn-psy-1",
      "from": "node-psy-ingress",
      "fromPort": "out-1",
      "to": "node-psy-intake",
      "guardianEnabled": true
    },
    {
      "id": "conn-psy-2",
      "from": "node-psy-intake",
      "fromPort": "out-1",
      "to": "node-psy-cbt",
      "guardianEnabled": true
    },
    {
      "id": "conn-psy-3",
      "from": "node-psy-intake",
      "fromPort": "out-2",
      "to": "node-psy-crisis",
      "guardianEnabled": true
    }
  ]
