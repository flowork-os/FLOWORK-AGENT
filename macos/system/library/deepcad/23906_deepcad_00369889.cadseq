# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00369889" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.438158, 0.000000).circle(0.438158)
solid0=wp_sketch0.add(loop0).extrude(0.289062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, -0.289062, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.260526, 0.000000).threePointArc((0.283687, 0.086730), (0.347368, 0.150000)).lineTo(0.217105, 0.375000).threePointArc((0.057901, 0.216825), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.460938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.085938, -0.289062, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.130263, -0.224342).threePointArc((0.287347, -0.066829), (0.343750, 0.148355)).lineTo(0.086842, 0.148355).threePointArc((0.063460, 0.062448), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.460938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
