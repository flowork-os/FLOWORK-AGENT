import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, -0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.310526, -0.278947).lineTo(0.310526, 0.500000).lineTo(0.000000, 0.221053).threePointArc((-0.048993, 0.110526), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.100000, 0.110526).circle(0.057895)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.390625, -0.390625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
