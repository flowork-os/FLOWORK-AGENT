loop8=wp_sketch2.moveTo(0.707237, 0.707237).circle(0.032895)
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).add(loop7).add(loop8).extrude(0.046875)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.390625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop9=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.172122, -0.264570), (0.344243, 0.000000)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop9).extrude(0.046875)
solid=solid.union(solid3)

