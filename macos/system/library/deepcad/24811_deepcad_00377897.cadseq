loop4=wp_sketch2.moveTo(0.205592, 0.000000).lineTo(0.205592, 0.074013).threePointArc((0.390625, 0.259046), (0.575658, 0.074013)).lineTo(0.575658, 0.000000).lineTo(0.781250, 0.000000).lineTo(0.781250, 0.781250).lineTo(0.559211, 0.781250).threePointArc((0.390625, 0.522115), (0.222039, 0.781250)).lineTo(0.000000, 0.781250).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.074013, 0.074013).circle(0.032895)
loop6=wp_sketch2.moveTo(0.074013, 0.707237).circle(0.032895)
