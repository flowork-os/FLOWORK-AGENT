# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00381125" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.200000, 0.000000).lineTo(1.200000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.042105, 0.078947).lineTo(1.042105, 0.678947).lineTo(0.157895, 0.678947).lineTo(0.157895, 0.078947).close()
loop2=wp_sketch0.moveTo(0.442105, 1.073684).lineTo(0.442105, 1.373684).lineTo(0.221053, 1.373684).lineTo(0.221053, 1.073684).close()
loop3=wp_sketch0.moveTo(0.978947, 1.073684).lineTo(0.978947, 1.373684).lineTo(0.757895, 1.373684).lineTo(0.757895, 1.073684).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
