# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00228045" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.179688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.142105, 0.000000).lineTo(0.142105, 0.221053).lineTo(0.315789, 0.221053).lineTo(0.315789, 0.284211).lineTo(1.184211, 0.284211).lineTo(1.184211, 0.221053).lineTo(1.357895, 0.221053).lineTo(1.357895, 0.000000).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.363158).lineTo(0.000000, 0.363158).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.710938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.429688, -0.101562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.859375, 0.000000).lineTo(0.859375, 0.144737).lineTo(0.859375, 0.208059).lineTo(0.000000, 0.208059).lineTo(0.000000, 0.144737).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.787007, 0.036184).lineTo(0.787007, 0.171875).lineTo(0.072368, 0.171875).lineTo(0.072368, 0.036184).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.710938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
