import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.203125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.854030, 0.000000).lineTo(1.019737, -0.458882).lineTo(1.083470, -0.458882).lineTo(1.083470, 0.000000).lineTo(1.210938, 0.000000).lineTo(1.210938, 0.063734).lineTo(0.000000, 0.063734).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.019737, -0.267681).lineTo(1.019737, 0.000000).lineTo(0.917763, 0.000000).close()
loop2=wp_sketch0.moveTo(1.172697, 0.038240).circle(0.012747)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.007812, -0.507812, -0.250000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.066776, 0.000000).lineTo(0.228947, 0.453125).lineTo(0.162171, 0.453125).lineTo(0.066776, 0.190789).lineTo(0.066776, 0.453125).lineTo(0.000000, 0.453125).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.007812, -0.640625, 0.203125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.127796, 0.000000).lineTo(0.194737, 0.000000).lineTo(0.286020, 0.000000).lineTo(0.359046, 0.000000).lineTo(0.578125, 0.000000).lineTo(0.578125, 0.066941).lineTo(0.000000, 0.066941).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.547697, 0.030428).circle(0.006086)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.007812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.007812, -0.093750, 0.234375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.007895, 0.000000).circle(0.007730)
solid3=wp_sketch3.add(loop6).extrude(-0.031250)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
