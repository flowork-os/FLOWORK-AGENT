# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257724" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.024771, -0.056439), (0.083224, -0.075987)).lineTo(0.343750, -0.054276).lineTo(0.343750, 0.195395).lineTo(0.264145, 0.242434).lineTo(0.000000, 0.144737).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.105921, -0.138158).lineTo(0.105921, -0.262500).lineTo(0.317763, -0.262500).lineTo(0.317763, -0.087500).lineTo(0.437500, -0.032237).lineTo(0.317763, 0.119737).lineTo(0.124342, 0.119737).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.093750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
