# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00258648" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, 0.000000, 0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.305757, -0.752632).threePointArc((0.813472, -0.904764), (1.117188, -0.470395)).lineTo(1.117188, -0.199918).lineTo(0.682072, -0.011760).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.632812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, 0.000000, 0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.305757, -0.752632).threePointArc((0.813472, -0.904764), (1.117188, -0.470395)).lineTo(1.117188, -0.199918).lineTo(0.682072, -0.011760).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.632812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
