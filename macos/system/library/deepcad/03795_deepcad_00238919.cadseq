import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, 0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.268914, 0.000000).lineTo(0.268914, -0.152385).lineTo(0.690214, -0.152385).lineTo(0.690214, -0.107566).lineTo(0.851562, -0.107566).lineTo(0.851562, 0.286842).lineTo(0.851562, 0.412336).lineTo(0.000000, 0.412336).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.107566, 0.286842).circle(0.053783)
loop2=wp_sketch0.moveTo(0.286842, 0.286842).circle(0.053783)
loop3=wp_sketch0.moveTo(0.439227, 0.286842).circle(0.053783)
loop4=wp_sketch0.moveTo(0.582648, 0.286842).circle(0.053783)
loop5=wp_sketch0.moveTo(0.726069, 0.286842).circle(0.053783)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch1.moveTo(0.146793, 0.000000).lineTo(0.332730, 0.000000).lineTo(0.508882, 0.000000).lineTo(0.929687, 0.000000).lineTo(0.929687, 0.822039).lineTo(0.508882, 0.822039).lineTo(0.000000, 0.822039).lineTo(0.000000, 0.469737).lineTo(0.000000, 0.293586).lineTo(0.000000, 0.107648).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch1.moveTo(0.146793, 0.107648).circle(0.088076)
loop8=wp_sketch1.moveTo(0.332730, 0.293586).circle(0.088076)
loop9=wp_sketch1.moveTo(0.508882, 0.469737).circle(0.088076)
solid1=wp_sketch1.add(loop6).add(loop7).add(loop8).add(loop9).extrude(0.187500)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
