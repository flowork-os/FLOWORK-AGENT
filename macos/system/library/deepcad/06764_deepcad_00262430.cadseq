# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00262430" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001590, -0.003838), (0.005428, -0.005428)).lineTo(0.080510, -0.005428).threePointArc((0.084348, -0.003838), (0.085938, 0.000000)).lineTo(0.085938, 0.075082).threePointArc((0.084348, 0.078920), (0.080510, 0.080510)).lineTo(0.005428, 0.080510).threePointArc((0.001590, 0.078920), (0.000000, 0.075082)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.005428, -0.002248), (0.010855, 0.000000)).lineTo(0.075082, 0.000000).threePointArc((0.078920, 0.001590), (0.080510, 0.005428)).lineTo(0.080510, 0.069655).threePointArc((0.078920, 0.073493), (0.075082, 0.075082)).lineTo(0.010855, 0.075082).threePointArc((0.007017, 0.073493), (0.005428, 0.069655)).lineTo(0.005428, 0.005428).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, 0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.085938, -0.085938).lineTo(0.085938, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.046875)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, 0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.085938, -0.085938).lineTo(0.085938, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.046875)
solid_temp=solid_temp.union(solid1)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
