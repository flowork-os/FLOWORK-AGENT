import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.207948, -0.387611), (0.579934, -0.622368)).threePointArc((0.908619, -0.504375), (0.891118, -0.155592)).threePointArc((0.877596, -0.042745), (0.975987, 0.014145)).threePointArc((1.078005, 0.034744), (1.159868, 0.099013)).threePointArc((1.287894, 0.318186), (1.343750, 0.565789)).threePointArc((1.180377, 0.818505), (0.891118, 0.735526)).threePointArc((0.640619, 0.525301), (0.325329, 0.438487)).threePointArc((0.058970, 0.296178), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.339474, 0.084868).circle(0.141447)
loop2=wp_sketch0.moveTo(0.664803, -0.339474).circle(0.141447)
loop3=wp_sketch0.moveTo(1.089145, 0.579934).circle(0.141447)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.359375)
solid=solid0

