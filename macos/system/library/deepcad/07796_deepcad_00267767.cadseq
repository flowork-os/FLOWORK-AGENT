loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000723, -0.001745), (0.002467, -0.002467)).lineTo(0.036595, -0.002467).threePointArc((0.038340, -0.001745), (0.039062, 0.000000)).lineTo(0.039062, 0.033717).threePointArc((0.038425, 0.035667), (0.036595, 0.036595)).lineTo(0.002467, 0.036595).threePointArc((0.000637, 0.035667), (0.000000, 0.033717)).lineTo(0.000000, 0.000000).close()
