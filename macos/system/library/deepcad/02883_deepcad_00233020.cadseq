# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.003758, -0.009071), (0.012829, -0.012829)).lineTo(0.051316, -0.012829).threePointArc((0.060387, -0.009071), (0.064145, 0.000000)).lineTo(0.064145, 0.080921).threePointArc((0.060387, 0.089992), (0.051316, 0.093750)).lineTo(0.012829, 0.093750).threePointArc((0.003758, 0.089992), (0.000000, 0.080921)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.005188, -0.005617), (0.012829, -0.005921)).lineTo(0.051316, -0.005921).threePointArc((0.055503, -0.004187), (0.057237, 0.000000)).lineTo(0.057237, 0.080921).threePointArc((0.055707, 0.085601), (0.051316, 0.087829)).lineTo(0.012829, 0.087829).threePointArc((0.007944, 0.085806), (0.005921, 0.080921)).lineTo(0.005921, 0.000000).close()
