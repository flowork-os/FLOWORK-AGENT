import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.718750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.031579, 0.000000).circle(0.031579)
loop1=wp_sketch0.moveTo(0.031579, 0.000000).circle(0.017763)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.718750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.030263, -0.030263), (0.060526, 0.000000)).lineTo(0.060526, 0.151316).lineTo(0.060526, 0.181579).lineTo(0.060526, 0.317763).lineTo(0.060526, 0.718750).threePointArc((0.030263, 0.688856), (0.000000, 0.718750)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.030263, 0.181579).circle(0.015132)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.031579, 0.000000).circle(0.031579)
loop5=wp_sketch2.moveTo(0.031579, 0.000000).circle(0.017763)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.062500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.000000, -0.570312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.296875, 0.000000).lineTo(0.296875, 0.121875).lineTo(0.000000, 0.168750).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop6).extrude(0.062500)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
