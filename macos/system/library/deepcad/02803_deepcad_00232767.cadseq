# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232767" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.000000, -0.562500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.108553, -0.189967).lineTo(0.452303, -0.189967).lineTo(0.560855, 0.000000).lineTo(0.560855, 0.859375).lineTo(0.000000, 0.859375).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.239720, -0.149260), (0.388980, 0.090461)).lineTo(0.388980, 0.560855).threePointArc((0.280428, 0.452303), (0.171875, 0.560855)).lineTo(0.171875, 0.090461).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.281250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.000000, 0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.562500, 0.000000).lineTo(0.562500, 0.076974).lineTo(0.373026, 0.450000).lineTo(0.189474, 0.450000).lineTo(0.000000, 0.076974).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.284211, 0.165789).circle(0.094737)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.187500)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
