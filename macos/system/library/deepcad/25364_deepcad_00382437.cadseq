# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382437" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.675000, 0.000000).circle(0.675000)
loop1=wp_sketch0.moveTo(0.253125, 0.000000).circle(0.182813)
loop2=wp_sketch0.moveTo(0.675000, -0.421875).circle(0.168750)
loop3=wp_sketch0.moveTo(0.675000, 0.379688).circle(0.168750)
loop4=wp_sketch0.moveTo(0.675000, 0.000000).circle(0.168750)
loop5=wp_sketch0.moveTo(1.068750, 0.000000).circle(0.154688)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.523438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.757895)
loop7=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.663158)
solid1=wp_sketch1.add(loop6).add(loop7).extrude(0.523438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
