# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00240058" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, -0.257812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.521053).lineTo(0.639474, 0.521053).threePointArc((0.375000, 0.344337), (0.110526, 0.521053)).lineTo(0.000000, 0.521053).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.562500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.000000, 0.257812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.261719, -0.174875), (0.523438, 0.000000)).lineTo(0.429770, 0.000000).threePointArc((0.261719, -0.124635), (0.093668, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.187500)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.000000, 0.257812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.261719, -0.174875), (0.523438, 0.000000)).lineTo(0.429770, 0.000000).threePointArc((0.261719, -0.124635), (0.093668, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.750000)
solid_temp=solid_temp.union(solid1)
solid=solid.union(solid_temp)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.203125, -0.281250, 0.257812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.059211, 0.000000).circle(0.059211)
solid2=wp_sketch2.add(loop2).extrude(-0.750000)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, -0.281250, 0.257812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.059211, 0.000000).circle(0.059211)
solid3=wp_sketch3.add(loop3).extrude(-0.750000)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
