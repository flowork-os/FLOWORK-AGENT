# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00357021" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.054688, 0.000000, -0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.534293, 0.096053).threePointArc((0.312500, 0.235332), (0.432237, 0.468257)).lineTo(0.018010, 0.570312).threePointArc((0.240113, 0.277858), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.257812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.359375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.197368, 0.000000).circle(0.193257)
loop2=wp_sketch1.moveTo(0.197368, 0.000000).circle(0.148026)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.257812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.296053, 0.000000).circle(0.296053)
loop4=wp_sketch2.moveTo(0.154194, -0.049342).threePointArc((0.292969, -0.147078), (0.431743, -0.049342)).lineTo(0.487253, -0.049342).lineTo(0.487253, 0.049342).lineTo(0.431743, 0.049342).threePointArc((0.292969, 0.147078), (0.154194, 0.049342)).lineTo(0.098684, 0.049342).lineTo(0.098684, -0.049342).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.257812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
