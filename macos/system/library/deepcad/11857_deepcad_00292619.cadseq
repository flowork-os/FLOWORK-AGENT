# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00292619" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.287500, -0.348026).lineTo(1.150000, -0.348026).lineTo(1.437500, 0.000000).lineTo(1.437500, 0.378289).lineTo(0.000000, 0.378289).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.151316, 0.181579).circle(0.105921)
loop2=wp_sketch0.moveTo(1.225658, 0.181579).circle(0.105921)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.486431, 0.000000).lineTo(0.486431, 0.507812).lineTo(0.000000, 0.507812).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.210938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.267270, 0.000000).lineTo(0.267270, 0.507812).lineTo(0.000000, 0.507812).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.390625)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.539062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.476562, 0.000000).lineTo(0.476562, 0.060197).lineTo(0.265872, 0.060197).lineTo(0.265872, 0.155510).lineTo(0.000000, 0.155510).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.507812)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.539062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch4.moveTo(0.484375, 0.000000).lineTo(0.484375, 0.061184).lineTo(0.270230, 0.061184).lineTo(0.270230, 0.137664).lineTo(0.000000, 0.137664).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(0.218750)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
