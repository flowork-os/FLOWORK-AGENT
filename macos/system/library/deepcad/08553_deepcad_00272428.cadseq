# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272428" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.726562, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.274332, -0.381840), (0.703618, -0.573602)).lineTo(0.703618, -0.504770).lineTo(0.726562, -0.504770).lineTo(0.726562, 0.000000).lineTo(0.726562, 0.313569).threePointArc((0.563551, 0.477287), (0.336513, 0.520066)).threePointArc((0.039361, 0.343436), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.507812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.021711, 0.000000).lineTo(0.021711, -0.065132).threePointArc((0.452217, 0.127228), (0.727303, 0.510197)).threePointArc((0.688187, 0.854127), (0.390789, 1.031250)).threePointArc((0.163420, 0.988709), (0.000000, 0.825000)).lineTo(0.000000, 0.510197).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
