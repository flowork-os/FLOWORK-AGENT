import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.218750, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.531250, 0.000000).lineTo(0.531250, 0.027961).threePointArc((0.526336, 0.039823), (0.514474, 0.044737)).lineTo(0.072697, 0.044737).lineTo(0.000000, 0.044737).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.179688, 0.000000).lineTo(0.160773, 0.045395).lineTo(0.052961, 0.045395).threePointArc((0.047771, 0.047771), (0.045395, 0.052961)).threePointArc((-0.035116, 0.076034), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.000000, 0.045395).circle(0.026480)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.156250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.018421, -0.043750).lineTo(0.054687, -0.043750).lineTo(0.054687, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.109375)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.218750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.076480, 0.000000).threePointArc((0.071076, 0.002579), (0.069079, 0.008224)).lineTo(0.069079, 0.062500).threePointArc((0.064502, 0.073549), (0.053454, 0.078125)).lineTo(0.029605, 0.078125).threePointArc((0.022075, 0.036306), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop4).extrude(-0.039062)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.156250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.018421, -0.043750).lineTo(0.054687, -0.043750).lineTo(0.054687, 0.000000).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(-0.039062)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
