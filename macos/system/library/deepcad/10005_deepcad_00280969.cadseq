import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.070312, 0.000000, 0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.222870, -0.274492), (0.017763, -0.562500)).lineTo(0.491447, -0.479605).threePointArc((0.285663, -0.273779), (0.515132, -0.094737)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.257812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.359375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.197368, 0.000000).circle(0.193257)
loop2=wp_sketch1.moveTo(0.197368, 0.000000).circle(0.164474)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.257812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.296053, 0.000000).circle(0.296053)
loop4=wp_sketch2.moveTo(0.135691, -0.049342).threePointArc((0.292969, -0.164498), (0.450247, -0.049342)).lineTo(0.487253, -0.049342).lineTo(0.487253, 0.049342).lineTo(0.450247, 0.049342).threePointArc((0.292969, 0.164498), (0.135691, 0.049342)).lineTo(0.098684, 0.049342).lineTo(0.098684, -0.049342).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.257812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.296053, 0.000000).circle(0.296053)
loop6=wp_sketch3.moveTo(0.135691, -0.049342).threePointArc((0.292969, -0.164498), (0.450247, -0.049342)).lineTo(0.487253, -0.049342).lineTo(0.487253, 0.049342).lineTo(0.450247, 0.049342).threePointArc((0.292969, 0.164498), (0.135691, 0.049342)).lineTo(0.098684, 0.049342).lineTo(0.098684, -0.049342).close()
solid3=wp_sketch3.add(loop5).add(loop6).extrude(0.523438)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
