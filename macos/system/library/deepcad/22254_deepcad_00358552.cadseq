# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.343750, 0.750000, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.343421, 0.000000).circle(0.336266)
loop6=wp_sketch3.moveTo(0.343421, 0.000000).circle(0.250411)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(-0.312500)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.250000, 0.750000, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop7=wp_sketch4.moveTo(0.252632, 0.000000).circle(0.252632)
