loop0=wp_sketch0.moveTo(0.323684, 0.007895).lineTo(0.315789, 0.039474).lineTo(0.434211, 0.047368).lineTo(0.434211, 0.039474).lineTo(0.750000, 0.047368).lineTo(0.742105, 0.552632).lineTo(0.410526, 0.568421).lineTo(0.418421, 0.615789).lineTo(0.000000, 0.647368).lineTo(0.000000, 0.536842).lineTo(0.663158, 0.481579).lineTo(0.671053, 0.134211).lineTo(0.000000, 0.118421).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.437500)
