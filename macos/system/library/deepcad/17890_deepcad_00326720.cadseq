# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00326720" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.046875, 0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.045913, -0.141469), (0.074013, -0.229441)).lineTo(0.451480, -0.229441).threePointArc((0.694901, 0.102398), (0.303454, 0.229441)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.046875, 0.226562, 0.031250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.045913, -0.141469), (0.074013, -0.229441)).lineTo(0.451480, -0.229441).threePointArc((0.694901, 0.102398), (0.303454, 0.229441)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.032539, -0.122965), (0.074013, -0.192434)).lineTo(0.451480, -0.192434).threePointArc((0.656223, 0.095859), (0.318257, 0.199836)).lineTo(0.022204, -0.022204).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.093750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
