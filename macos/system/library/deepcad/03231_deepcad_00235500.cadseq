# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00235500" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.000000, -0.664062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.092516, -0.092516).lineTo(0.154194, 0.627056).threePointArc((0.154667, 0.652755), (0.154194, 0.678454)).lineTo(0.154194, 0.956003).lineTo(0.061678, 0.976563).lineTo(0.061678, 0.678454).threePointArc((0.054645, 0.627245), (0.051398, 0.575658)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.041118, 0.061678).circle(0.020559)
loop2=wp_sketch0.moveTo(0.102796, 0.657895).circle(0.030839)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.054688, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, 0.320312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.096875, -0.017188).lineTo(0.096875, 0.096875).threePointArc((0.048438, 0.147750), (0.000000, 0.096875)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.048438, 0.100000).circle(0.018750)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.023438, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
