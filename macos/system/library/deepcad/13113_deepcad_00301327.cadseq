wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.323684, 0.000000).threePointArc((0.345417, 0.023684), (0.323684, 0.047368)).lineTo(0.086842, 0.071053).threePointArc((0.053686, 0.085265), (0.039474, 0.118421)).lineTo(0.039474, 0.639474).threePointArc((0.050502, 0.677953), (0.086842, 0.694737)).lineTo(0.323684, 0.702632).threePointArc((0.347368, 0.726316), (0.323684, 0.750000)).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.625000, both=True)
solid=solid0

