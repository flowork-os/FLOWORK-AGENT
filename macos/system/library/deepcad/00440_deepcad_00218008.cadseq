wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.032072, 0.000000).lineTo(0.032072, -0.256579).lineTo(0.149671, -0.256579).lineTo(0.149671, -0.310033).lineTo(0.459704, -0.310033).lineTo(0.459704, -0.256579).lineTo(0.865954, -0.256579).lineTo(0.865954, 0.106908).lineTo(1.015625, 0.106908).lineTo(1.015625, 0.748355).lineTo(0.032072, 0.748355).lineTo(0.032072, 0.491776).lineTo(0.000000, 0.491776).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
