import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009249, -0.022330), (0.031579, -0.031579)).lineTo(1.468421, -0.031579).threePointArc((1.490751, -0.022330), (1.500000, 0.000000)).lineTo(1.500000, 0.821053).threePointArc((1.490751, 0.843382), (1.468421, 0.852632)).lineTo(0.031579, 0.852632).threePointArc((0.009249, 0.843382), (0.000000, 0.821053)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.063158, -0.015789).circle(0.015789)
loop2=wp_sketch0.moveTo(0.157895, -0.015789).circle(0.015789)
loop3=wp_sketch0.moveTo(1.342105, -0.015789).circle(0.015789)
loop4=wp_sketch0.moveTo(1.436842, -0.015789).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
