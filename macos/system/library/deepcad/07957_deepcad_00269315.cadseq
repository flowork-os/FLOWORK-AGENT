wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.089803, 0.000000).lineTo(0.089803, 0.192434).lineTo(0.744079, 0.372039).threePointArc((0.769737, 0.369671), (0.795395, 0.372039)).threePointArc((1.032619, 0.249180), (1.128947, 0.000000)).lineTo(1.218750, 0.000000).threePointArc((1.093005, 0.318138), (0.782566, 0.461842)).threePointArc((0.756908, 0.463893), (0.731250, 0.461842)).lineTo(0.000000, 0.269408).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.051316, 0.179605).circle(0.012829)
loop2=wp_sketch0.moveTo(1.051974, 0.295066).circle(0.012829)
