# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00310143" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, -0.250000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.193421, 0.034786), (0.386842, 0.000000)).threePointArc((0.750268, 0.252632), (0.386842, 0.505263)).threePointArc((0.193421, 0.470478), (0.000000, 0.505263)).threePointArc((-0.363426, 0.252632), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.094737, 0.252632).circle(0.086842)
loop2=wp_sketch0.moveTo(0.481579, 0.252632).circle(0.086842)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
