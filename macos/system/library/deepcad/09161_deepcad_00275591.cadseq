# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00275591" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.960938, 0.000000).threePointArc((0.910300, 0.262993), (0.960938, 0.525987)).lineTo(0.000000, 0.748520).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.179688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.960938, 0.252878).lineTo(0.000000, 0.252878).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.179688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.254605).lineTo(0.000000, 1.007812).threePointArc((-0.090624, 0.503906), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.179688)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
