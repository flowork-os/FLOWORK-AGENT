# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00295722" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, -0.648438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.421875, 0.000000).lineTo(1.421875, 1.287171).lineTo(0.000000, 1.287171).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.314309, 0.643586).circle(0.044901)
loop2=wp_sketch0.moveTo(0.718421, 0.643586).circle(0.179605)
loop3=wp_sketch0.moveTo(1.107566, 0.643586).circle(0.044901)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
