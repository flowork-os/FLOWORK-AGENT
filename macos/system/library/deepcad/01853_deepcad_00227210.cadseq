# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, -0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch4.moveTo(0.515789, 0.000000).threePointArc((0.819664, 0.500000), (0.515789, 1.000000)).lineTo(0.000000, 1.000000).threePointArc((-0.303874, 0.500000), (0.000000, 0.000000)).close()
loop9=wp_sketch4.moveTo(-0.052632, 0.505263).circle(0.042105)
loop10=wp_sketch4.moveTo(0.252632, 0.505263).circle(0.126316)
loop11=wp_sketch4.moveTo(0.252632, 0.263158).circle(0.042105)
loop12=wp_sketch4.moveTo(0.252632, 0.736842).circle(0.042105)
loop13=wp_sketch4.moveTo(0.568421, 0.505263).circle(0.042105)
solid4=wp_sketch4.add(loop8).add(loop9).add(loop10).add(loop11).add(loop12).add(loop13).extrude(0.078125)
