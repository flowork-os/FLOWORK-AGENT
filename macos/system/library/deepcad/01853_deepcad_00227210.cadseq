loop3=wp_sketch2.moveTo(0.400000, 0.105263).circle(0.042105)
loop4=wp_sketch2.moveTo(0.400000, 0.905263).circle(0.042105)
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).extrude(0.078125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.494737, 0.000000).threePointArc((0.190863, 0.500000), (0.494737, 1.000000)).lineTo(0.000000, 1.000000).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch3.moveTo(0.094737, 0.105263).circle(0.042105)
loop7=wp_sketch3.moveTo(0.094737, 0.905263).circle(0.042105)
solid3=wp_sketch3.add(loop5).add(loop6).add(loop7).extrude(0.078125)
