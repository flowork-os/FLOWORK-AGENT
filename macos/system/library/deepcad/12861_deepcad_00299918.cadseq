import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.568421, 0.000000).lineTo(0.568421, 0.102632).lineTo(0.434211, 0.102632).lineTo(0.434211, 0.647368).lineTo(0.568421, 0.647368).lineTo(0.568421, 0.750000).lineTo(0.331579, 0.750000).lineTo(0.331579, 0.063158).lineTo(0.000000, 0.063158).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.335938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
