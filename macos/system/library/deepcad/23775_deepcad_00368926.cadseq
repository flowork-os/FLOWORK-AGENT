# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00368926" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.094737, 0.000000).circle(0.094737)
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, -0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.156250, 0.000000).lineTo(1.156250, 0.973684).lineTo(0.000000, 0.973684).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.194737, 0.486842).circle(0.048684)
loop3=wp_sketch1.moveTo(0.584211, 0.486842).circle(0.097368)
loop4=wp_sketch1.moveTo(0.961513, 0.486842).circle(0.048684)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.031250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
