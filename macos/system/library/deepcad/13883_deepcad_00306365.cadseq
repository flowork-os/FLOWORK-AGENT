# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.126316).lineTo(0.655263, 0.126316).lineTo(0.655263, 0.094737).lineTo(0.078947, 0.094737).lineTo(0.078947, 0.252632).lineTo(0.047368, 0.252632).lineTo(0.000000, 0.205263).lineTo(0.000000, 0.000000).close()
