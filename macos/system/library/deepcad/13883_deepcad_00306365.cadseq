# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.750000, -0.187500, 0.070312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.062500, 0.000000).lineTo(0.062500, 0.020395).lineTo(0.000000, 0.020395).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.671875)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.750000, -0.234375, 0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.046053, 0.000000).lineTo(0.108553, 0.000000).lineTo(0.156250, 0.000000).lineTo(0.156250, 0.032895).lineTo(0.108553, 0.032895).lineTo(0.046053, 0.032895).lineTo(0.000000, 0.032895).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.671875)
