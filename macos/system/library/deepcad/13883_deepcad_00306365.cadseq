# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.656250, 0.000000, 0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.093421, 0.000000).lineTo(0.093421, 0.125000).lineTo(0.000000, 0.125000).lineTo(0.000000, 0.000000).close()
