# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.615789, 0.000000).threePointArc((0.743439, 0.119424), (0.884211, 0.015789)).lineTo(1.500000, 0.015789).threePointArc((0.742391, 0.730779), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.718750)
solid=solid0
# workplane for sketch 1
