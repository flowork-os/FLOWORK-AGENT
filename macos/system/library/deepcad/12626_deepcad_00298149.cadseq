# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((-0.000478, -0.025987), (0.000000, -0.051974)).lineTo(0.617188, -0.051974).threePointArc((0.619586, -0.025987), (0.617188, 0.000000)).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.539062)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
