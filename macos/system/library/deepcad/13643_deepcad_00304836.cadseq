# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00304836" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.328125, -0.406250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.215872, 0.000000).lineTo(0.215872, 0.250411).threePointArc((0.194285, 0.271998), (0.215872, 0.293586)).lineTo(0.215872, 0.414474).lineTo(0.215872, 0.820313).lineTo(0.000000, 0.820313).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.539062, -0.406250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.215872, 0.000000).lineTo(0.215872, 0.820313).lineTo(0.000000, 0.820313).lineTo(0.000000, 0.414474).lineTo(0.000000, 0.293586).threePointArc((0.021587, 0.271998), (0.000000, 0.250411)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.539062, -0.406250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.859375, 0.000000).lineTo(0.859375, 0.814145).lineTo(0.000000, 0.814145).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.109375)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
