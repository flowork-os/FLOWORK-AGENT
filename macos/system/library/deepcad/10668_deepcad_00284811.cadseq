# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284811" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.398438, 0.000000).lineTo(1.398438, 0.309128).lineTo(0.000000, 0.309128).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.073602, 0.132484).lineTo(0.073602, 0.206086).lineTo(0.073602, 0.132484).close()
loop2=wp_sketch0.moveTo(1.324836, 0.132484).lineTo(1.324836, 0.206086).lineTo(1.324836, 0.132484).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
