# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220037" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.160362, 0.000000).threePointArc((1.328125, 0.167763), (1.160362, 0.335526)).lineTo(0.000000, 0.335526).threePointArc((-0.167763, 0.167763), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.167763).circle(0.083882)
loop2=wp_sketch0.moveTo(1.160362, 0.167763).circle(0.083882)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.093750, 0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.554688, 0.000000).lineTo(0.554688, 0.181003).lineTo(0.000000, 0.181003).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.218750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
