import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.240789, 0.080921).threePointArc((1.278375, 0.121382), (1.240789, 0.161842)).lineTo(0.000000, 0.256250).threePointArc((-0.137924, 0.128125), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.013487, 0.121382).circle(0.067434)
loop2=wp_sketch0.moveTo(0.229276, 0.080921).threePointArc((0.269737, 0.121382), (0.229276, 0.161842)).lineTo(0.175329, 0.161842).threePointArc((0.134868, 0.121382), (0.175329, 0.080921)).close()
loop3=wp_sketch0.moveTo(0.175329, 0.080921).threePointArc((0.273086, 0.023262), (0.377632, 0.067434)).lineTo(0.741776, 0.094408).threePointArc((0.773098, 0.128125), (0.741776, 0.161842)).lineTo(0.377632, 0.188816).threePointArc((0.343824, 0.172025), (0.337171, 0.134868)).threePointArc((0.335675, 0.121382), (0.337171, 0.107895)).close()
loop4=wp_sketch0.moveTo(1.240789, 0.121382).circle(0.013487)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.015625, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
