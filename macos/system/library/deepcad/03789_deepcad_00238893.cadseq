wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.132812, 0.000000).lineTo(1.132812, 0.333882).lineTo(0.906250, 0.572368).lineTo(0.679688, 0.572368).lineTo(0.679688, 0.393503).lineTo(0.846628, 0.393503).lineTo(0.846628, 0.166941).lineTo(0.286184, 0.166941).lineTo(0.286184, 0.393503).lineTo(0.453125, 0.393503).lineTo(0.453125, 0.572368).lineTo(0.226562, 0.572368).lineTo(0.000000, 0.333882).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.281250)
solid=solid0

if __name__ == '__main__':
    import sys
