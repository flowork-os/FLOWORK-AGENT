# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00370478" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.437500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.011754, -0.028377), (0.040132, -0.040132)).lineTo(0.436431, -0.040132).threePointArc((0.464808, -0.028377), (0.476562, 0.000000)).lineTo(0.476562, 0.321053).lineTo(0.476562, 0.401316).threePointArc((0.463769, 0.427185), (0.436431, 0.436431)).lineTo(0.040132, 0.436431).threePointArc((0.012793, 0.427185), (0.000000, 0.401316)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.436431, 0.000000).lineTo(0.436431, 0.401316).lineTo(0.040132, 0.401316).lineTo(0.040132, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.476562, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.273438, 0.000000).lineTo(0.273438, 0.077714).lineTo(0.000000, 0.077714).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
