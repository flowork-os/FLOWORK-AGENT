# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00296126" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, -0.492188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.984375, 0.000000).lineTo(0.984375, 0.984375).lineTo(0.000000, 0.984375).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.062171, 0.062171).circle(0.031086)
loop2=wp_sketch0.moveTo(0.062171, 0.922204).circle(0.031086)
loop3=wp_sketch0.moveTo(0.497368, 0.497368).circle(0.186513)
loop4=wp_sketch0.moveTo(0.922204, 0.062171).circle(0.031086)
loop5=wp_sketch0.moveTo(0.922204, 0.922204).circle(0.031086)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, -0.070312, -0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch1.moveTo(0.984375, 0.000000).lineTo(0.984375, 0.072533).lineTo(0.000000, 0.072533).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop6).extrude(0.679688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
