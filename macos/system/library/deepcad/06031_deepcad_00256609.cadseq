loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004625, -0.011165), (0.015789, -0.015789)).lineTo(1.484211, -0.015789).threePointArc((1.495375, -0.011165), (1.500000, 0.000000)).lineTo(1.500000, 0.600000).threePointArc((1.495375, 0.611165), (1.484211, 0.615789)).lineTo(0.015789, 0.615789).threePointArc((0.004625, 0.611165), (0.000000, 0.600000)).lineTo(0.000000, 0.000000).close()
