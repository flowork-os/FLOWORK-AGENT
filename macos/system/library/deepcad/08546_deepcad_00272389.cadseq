# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272389" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.251562, 0.000000).lineTo(0.251562, 1.039062).lineTo(0.000000, 1.039062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.054688, 0.054688).circle(0.032812)
loop2=wp_sketch0.moveTo(0.054688, 0.612500).circle(0.032812)
loop3=wp_sketch0.moveTo(0.164062, 0.645312).circle(0.010937)
loop4=wp_sketch0.moveTo(0.175000, 0.076562).circle(0.010937)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(-0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
