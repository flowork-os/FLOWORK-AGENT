# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00251311" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.632812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.034685, -0.083736), (0.118421, -0.118421)).lineTo(0.876316, -0.118421).threePointArc((0.960052, -0.083736), (0.994737, 0.000000)).lineTo(0.994737, 0.627632).threePointArc((0.497368, 1.125000), (0.000000, 0.627632)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.497368, 0.627632).circle(0.378947)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
