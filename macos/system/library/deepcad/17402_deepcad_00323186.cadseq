# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00323186" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, -0.546875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.156250, 0.000000).threePointArc((0.949700, 0.085556), (0.864145, 0.292105)).lineTo(0.864145, 1.010197).threePointArc((0.578125, 0.724178), (0.292105, 1.010197)).lineTo(0.292105, 0.292105).threePointArc((0.206550, 0.085556), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.289062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.000000, 0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.292105, 0.000000).circle(0.292105)
loop2=wp_sketch1.moveTo(0.292105, 0.000000).circle(0.146053)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.578125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, -0.695312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(1.156250, 0.000000).lineTo(1.156250, 0.146053).lineTo(0.000000, 0.146053).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.718750)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
