# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00249265" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, 0.726562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.194285, -1.499430), (0.388569, 0.000000)).lineTo(0.326398, -0.233141).lineTo(0.062171, -0.233141).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.202056, -0.730510).circle(0.279770)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
