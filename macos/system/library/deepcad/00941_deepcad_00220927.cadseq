# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220927" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.146711, 0.000000).threePointArc((1.305592, 0.158882), (1.146711, 0.317763)).lineTo(0.000000, 0.317763).threePointArc((-0.181919, 0.158882), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.027632, 0.165789).circle(0.082895)
loop2=wp_sketch0.moveTo(1.146711, 0.165789).circle(0.069079)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.070312, 0.273438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.773437, 0.000000).lineTo(0.773437, 0.130263).lineTo(0.000000, 0.130263).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.273438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.398438, -0.062500, 0.539062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.066406, -0.066406), (0.132812, 0.000000)).lineTo(0.100658, 0.000000).threePointArc((0.066406, -0.034252), (0.032155, 0.000000)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(-0.773438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
