loop0=wp_sketch0.moveTo(0.337171, 0.000000).threePointArc((0.364201, 0.020851), (0.345395, 0.049342)).lineTo(0.082237, 0.090461).threePointArc((0.052507, 0.107490), (0.041118, 0.139803)).lineTo(0.041118, 0.394737).lineTo(0.041118, 0.641447).threePointArc((0.052507, 0.673760), (0.082237, 0.690789)).lineTo(0.345395, 0.731908).threePointArc((0.364201, 0.760399), (0.337171, 0.781250)).lineTo(0.000000, 0.781250).lineTo(0.000000, 0.394737).lineTo(0.000000, 0.000000).close()
