# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.189967, 0.000000).threePointArc((0.305304, 0.212632), (0.420641, 0.000000)).lineTo(0.936266, 0.000000).threePointArc((1.058388, 0.225140), (1.180510, 0.000000)).lineTo(1.289062, 0.000000).threePointArc((1.279274, 0.125977), (1.234786, 0.244243)).threePointArc((0.748012, 0.402225), (0.244243, 0.312089)).lineTo(0.040707, 0.230674).threePointArc((-0.019325, 0.122339), (0.000000, 0.000000)).close()
