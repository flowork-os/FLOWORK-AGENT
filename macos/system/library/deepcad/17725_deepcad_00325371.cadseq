wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.157895, 0.584211).threePointArc((0.244281, 0.576771), (0.236842, 0.663158)).lineTo(0.110526, 0.789474).threePointArc((0.031579, 0.789474), (0.031579, 0.710526)).close()
loop2=wp_sketch0.moveTo(0.236842, 0.963158).threePointArc((0.323229, 0.955719), (0.315789, 1.042105)).lineTo(0.189474, 1.168421).threePointArc((0.118421, 1.176316), (0.110526, 1.105263)).close()
loop3=wp_sketch0.moveTo(1.121053, 1.121053).lineTo(1.121053, 1.263158).lineTo(0.868421, 1.263158).lineTo(0.868421, 1.121053).close()
