# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00216097" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, -0.460938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.882812, 0.000000).lineTo(0.882812, 0.455345).lineTo(0.752714, 0.455345).lineTo(0.752714, 0.130099).lineTo(0.130099, 0.130099).lineTo(0.130099, 0.455345).lineTo(0.000000, 0.455345).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.656250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
