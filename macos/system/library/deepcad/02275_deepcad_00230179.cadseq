# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.000144, -0.059645), (0.051316, -0.089803)).lineTo(0.098355, -0.089803).lineTo(0.143257, -0.089803).threePointArc((0.194716, -0.059645), (0.194572, 0.000000)).lineTo(0.149671, 0.079112).threePointArc((0.097286, 0.109214), (0.044901, 0.079112)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
