# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00275879" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, -0.359375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.467105, 0.000000).lineTo(0.467105, 0.724013).lineTo(0.233553, 1.109375).lineTo(0.000000, 0.724013).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.281250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.234375, -0.210938, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.071916, -0.071916), (0.143832, 0.000000)).lineTo(0.143832, 0.257812).threePointArc((0.071916, 0.185896), (0.000000, 0.257812)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-1.000000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, -0.359375), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch2.moveTo(0.232895, -0.131003).lineTo(0.460938, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.250000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, -0.273438, -0.359375), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch3.moveTo(0.000000, -0.275905).lineTo(0.005016, -0.275905).lineTo(0.005016, 0.000000).lineTo(0.471546, 0.000000).lineTo(0.471546, -0.275905).lineTo(0.476562, -0.270888).lineTo(0.476562, 0.005016).lineTo(0.235773, 0.140461).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.250000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
