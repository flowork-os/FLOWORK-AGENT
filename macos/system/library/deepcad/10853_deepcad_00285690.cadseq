wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.012067, -0.029133), (0.041201, -0.041201)).lineTo(0.645477, -0.041201).lineTo(0.645477, -0.013734).lineTo(0.041201, -0.013734).threePointArc((0.031490, -0.009711), (0.027467, 0.000000)).lineTo(0.027467, 1.304688).lineTo(0.000000, 1.304688).lineTo(0.000000, 0.000000).close()
