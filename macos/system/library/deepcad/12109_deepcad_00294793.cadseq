import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.617188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.041622, -0.100484), (0.142105, -0.142105)).lineTo(1.357895, -0.142105).threePointArc((1.458378, -0.100484), (1.500000, 0.000000)).lineTo(1.500000, 1.231579).threePointArc((1.455108, 1.324168), (1.357895, 1.357895)).lineTo(0.142105, 1.357895).threePointArc((0.044892, 1.324168), (0.000000, 1.231579)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.414062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.617188, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.041622, -0.100484), (0.142105, -0.142105)).lineTo(1.357895, -0.142105).threePointArc((1.458378, -0.100484), (1.500000, 0.000000)).lineTo(1.500000, 0.300000).lineTo(0.000000, 0.300000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.148438)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.281250, 0.320312, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch2.moveTo(0.468750, 0.000000).lineTo(0.468750, 0.463816).lineTo(0.241776, 0.463816).threePointArc((0.070815, 0.393001), (0.000000, 0.222039)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.054688)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.343750, 0.093750, 0.054688), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch3.moveTo(0.181579, 0.000000).circle(0.181579)
solid3=wp_sketch3.add(loop3).extrude(0.054688)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
