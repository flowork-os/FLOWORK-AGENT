# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232899" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.714638, 0.000000).lineTo(0.714638, 0.217105).lineTo(0.859375, 0.217105).lineTo(0.859375, 0.569901).lineTo(0.217105, 0.569901).lineTo(0.217105, 0.434211).lineTo(0.000000, 0.434211).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.108553, 0.180921).circle(0.072368)
loop2=wp_sketch0.moveTo(0.597039, 0.099507).circle(0.054276)
loop3=wp_sketch0.moveTo(0.696546, 0.452303).circle(0.090461)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.179688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, -0.640625, 0.179688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.317763, -0.105921).lineTo(0.718750, 0.037829).lineTo(0.718750, 0.537171).lineTo(0.499342, 0.537171).lineTo(0.499342, 0.393421).lineTo(0.287500, 0.393421).lineTo(0.287500, 0.537171).lineTo(0.000000, 0.537171).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop4).extrude(0.179688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
