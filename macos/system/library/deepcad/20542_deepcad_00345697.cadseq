# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00345697" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.234375, 0.000000).threePointArc((0.742188, 0.283571), (1.250000, 0.000000)).lineTo(1.484375, 0.000000).lineTo(1.484375, 1.171875).lineTo(1.187500, 1.453125).lineTo(0.921875, 1.453125).lineTo(0.921875, 0.750000).threePointArc((0.742188, 0.570312), (0.562500, 0.750000)).lineTo(0.562500, 1.453125).lineTo(0.296875, 1.453125).lineTo(0.000000, 1.171875).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.296875, 0.750000).circle(0.187500)
loop2=wp_sketch0.moveTo(1.187500, 0.750000).circle(0.187500)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.189474, 0.000000).circle(0.185526)
loop4=wp_sketch1.moveTo(0.189474, 0.000000).circle(0.094737)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(-0.562500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.250000, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.189474, 0.000000).circle(0.185526)
loop6=wp_sketch2.moveTo(0.189474, 0.000000).circle(0.094737)
solid2=wp_sketch2.add(loop5).add(loop6).extrude(-0.562500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
