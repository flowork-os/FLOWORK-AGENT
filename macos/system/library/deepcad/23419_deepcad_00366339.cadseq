# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00366339" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.359375, 0.000000).lineTo(1.359375, 0.329112).lineTo(0.600987, 0.329112).lineTo(0.600987, 0.600987).lineTo(0.000000, 0.600987).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.228947, 0.329112).circle(0.186020)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.601562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.359375, -0.148438, 0.335938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.305517, -0.090787), (0.003207, -0.169984)).threePointArc((-0.021917, -0.085436), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(-0.601562)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.359375, -0.148438, 0.335938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((-0.021973, -0.086438), (0.003618, -0.171875)).threePointArc((0.025591, -0.085437), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(-0.601562)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.359375, -0.148438, 0.335938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.025313, -0.085071), (0.003289, -0.171053)).threePointArc((0.310697, -0.079583), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop4).extrude(-0.601562)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
