wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.248026, -0.145395).lineTo(0.248026, -0.042763).lineTo(0.504605, -0.042763).lineTo(0.504605, -0.145395).lineTo(0.684211, -0.042763).lineTo(0.752632, 0.000000).threePointArc((0.815617, 0.111184), (0.752632, 0.222368)).lineTo(0.504605, 0.367763).lineTo(0.504605, 0.265132).lineTo(0.248026, 0.265132).lineTo(0.248026, 0.367763).lineTo(0.000000, 0.222368).threePointArc((-0.062985, 0.111184), (0.000000, 0.000000)).close()
