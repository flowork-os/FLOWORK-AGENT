loop3=wp_sketch3.moveTo(0.011102, -0.045148).lineTo(0.037007, 0.061431).lineTo(0.000000, 0.070312).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.031250)
