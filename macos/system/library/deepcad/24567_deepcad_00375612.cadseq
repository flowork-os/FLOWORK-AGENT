# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.028372, -0.117188).lineTo(0.056743, 0.000000).lineTo(0.045641, 0.044408).lineTo(0.011102, 0.044408).lineTo(0.000000, 0.000000).close()
