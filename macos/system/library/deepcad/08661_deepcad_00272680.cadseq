# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272680" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.226562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.457319, 0.000000).threePointArc((0.504072, 0.019366), (0.523438, 0.066118)).lineTo(0.523438, 0.385691).threePointArc((0.504072, 0.432444), (0.457319, 0.451809)).lineTo(0.000000, 0.451809).threePointArc((-0.225905, 0.225905), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.225905).circle(0.159786)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.453125, 0.226562, 0.132812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.118421, 0.000000).circle(0.118421)
loop3=wp_sketch1.moveTo(0.118421, 0.000000).circle(0.049342)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.523438, 0.226562, 0.132812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.047368, 0.000000).circle(0.047368)
solid2=wp_sketch2.add(loop4).extrude(-0.093750)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
