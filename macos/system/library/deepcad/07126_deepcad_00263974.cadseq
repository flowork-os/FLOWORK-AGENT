loop0=wp_sketch0.moveTo(1.460938, 0.000000).lineTo(1.460938, 0.430592).lineTo(0.753536, 0.430592).lineTo(0.707401, 0.476727).lineTo(0.476727, 0.476727).lineTo(0.476727, 0.353701).lineTo(0.599753, 0.353701).lineTo(0.599753, 0.230674).lineTo(0.123026, 0.230674).lineTo(0.123026, 0.353701).lineTo(0.230674, 0.353701).lineTo(0.230674, 0.476727).lineTo(0.000000, 0.476727).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.710938)
