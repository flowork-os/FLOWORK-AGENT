# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00336287" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.252632, 0.000000).circle(0.252632)
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, -0.750000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.017559, -0.042392), (0.059951, -0.059951)).lineTo(0.135444, -0.059951).threePointArc((0.177836, -0.042392), (0.195395, 0.000000)).lineTo(0.195395, 0.150987).threePointArc((0.177836, 0.193378), (0.135444, 0.210938)).lineTo(0.059951, 0.210938).threePointArc((0.017559, 0.193378), (0.000000, 0.150987)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.898438)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, -0.750000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.017559, -0.042392), (0.059951, -0.059951)).lineTo(0.135444, -0.059951).threePointArc((0.177836, -0.042392), (0.195395, 0.000000)).lineTo(0.195395, 0.150987).threePointArc((0.177836, 0.193378), (0.135444, 0.210938)).lineTo(0.059951, 0.210938).threePointArc((0.017559, 0.193378), (0.000000, 0.150987)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.156250)
solid_temp=solid_temp.union(solid1)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
