import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.531250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.748355, 0.000000).threePointArc((0.860294, -0.046367), (0.906661, -0.158306)).lineTo(0.906661, -0.215872).lineTo(1.367188, -0.215872).lineTo(1.367188, 0.590049).lineTo(1.367188, 0.921053).lineTo(1.108141, 0.921053).lineTo(0.000000, 0.921053).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.331003, 0.201480).circle(0.115132)
loop2=wp_sketch0.moveTo(1.223273, 0.590049).threePointArc((1.309622, 0.676398), (1.223273, 0.762747)).lineTo(0.532484, 0.762747).threePointArc((0.446135, 0.676398), (0.532484, 0.590049)).close()
loop3=wp_sketch0.moveTo(1.108141, 0.143914).circle(0.215872)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.273438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
