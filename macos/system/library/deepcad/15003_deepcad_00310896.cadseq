# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00310896" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.991447, 0.000000).lineTo(0.991447, 1.070312).lineTo(0.653454, 1.070312).lineTo(0.653454, 0.675987).lineTo(0.270395, 0.675987).lineTo(0.270395, 0.946382).lineTo(0.000000, 0.946382).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.664062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
