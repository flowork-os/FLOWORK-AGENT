wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, -0.375000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.055263, 0.000000).circle(0.055263)
