wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.118421, 0.000000).circle(0.118421)
