# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.320312, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
