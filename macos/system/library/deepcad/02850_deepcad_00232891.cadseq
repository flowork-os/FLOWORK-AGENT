import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.710938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.147204, 0.000000).lineTo(1.147204, 0.395148).lineTo(0.866776, 0.560855).lineTo(0.866776, 0.726562).lineTo(1.147204, 0.879523).lineTo(1.147204, 1.210938).lineTo(0.854030, 1.210938).lineTo(0.599095, 1.083470).lineTo(0.165707, 1.083470).lineTo(0.000000, 0.560855).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.164062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
