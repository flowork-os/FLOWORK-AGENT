# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00270236" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, 0.000000, 0.351562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.027961, -0.754934).lineTo(0.699013, -1.090461).lineTo(1.328125, -0.699013).lineTo(1.300164, 0.055921).lineTo(0.629112, 0.405428).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.671053, -0.349507).circle(0.433388)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.695312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
