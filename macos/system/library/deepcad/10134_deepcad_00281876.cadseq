# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00281876" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.050000, 0.000000).lineTo(0.050000, 0.150000).lineTo(0.050000, 0.296875).lineTo(0.000000, 0.296875).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.398438, 0.000000).lineTo(1.398438, 0.147204).lineTo(0.000000, 0.147204).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.073602, 0.073602).circle(0.014720)
loop3=wp_sketch1.moveTo(1.354276, 0.044161).lineTo(1.354276, 0.103043).lineTo(0.147204, 0.103043).lineTo(0.147204, 0.044161).close()
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.703125, 0.000000, -0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.050000, 0.000000).lineTo(0.050000, 0.296875).lineTo(0.000000, 0.296875).lineTo(0.000000, 0.150000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.031250)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, -0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(1.398438, 0.000000).lineTo(1.398438, 0.147204).lineTo(0.000000, 0.147204).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch3.moveTo(0.176645, 0.073602).circle(0.014720)
loop7=wp_sketch3.moveTo(0.706579, 0.073602).circle(0.014720)
loop8=wp_sketch3.moveTo(1.221793, 0.073602).circle(0.014720)
solid3=wp_sketch3.add(loop5).add(loop6).add(loop7).add(loop8).extrude(0.031250)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
