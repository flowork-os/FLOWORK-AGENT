# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00330615" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.521053).lineTo(0.355263, 0.521053).lineTo(0.000000, 0.307895).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.165789, 0.134211).circle(0.063158)
loop2=wp_sketch0.moveTo(0.521053, 0.118421).circle(0.063158)
loop3=wp_sketch0.moveTo(0.521053, 0.347368).circle(0.063158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.234375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.101562, -0.234375, 0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.067105, 0.000000).circle(0.065707)
solid1=wp_sketch1.add(loop4).extrude(-0.078125)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.062500, -0.234375, 0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.102632, 0.000000).circle(0.102632)
loop6=wp_sketch2.moveTo(0.102632, 0.000000).circle(0.064145)
solid2=wp_sketch2.add(loop5).add(loop6).extrude(-0.078125)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
