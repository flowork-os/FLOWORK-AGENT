import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.037500, 0.000000).lineTo(0.037500, 0.445312).lineTo(0.000000, 0.445312).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.025781, -0.002344), (0.028125, 0.023438)).lineTo(0.028125, 0.089063).threePointArc((0.018750, 0.098437), (0.009375, 0.089063)).lineTo(0.009375, 0.023438).close()
loop2=wp_sketch0.moveTo(0.009375, 0.023438).threePointArc((0.089063, 0.084375), (0.028125, 0.164062)).lineTo(0.028125, 0.229687).threePointArc((0.018750, 0.239062), (0.009375, 0.229687)).lineTo(0.009375, 0.164062).close()
loop3=wp_sketch0.moveTo(0.018750, 0.421875).circle(0.009375)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.050658, 0.000000).lineTo(0.050658, 0.687500).lineTo(0.000000, 0.687500).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(0.021711, 0.014474).circle(0.007237)
loop6=wp_sketch1.moveTo(0.021711, 0.130263).circle(0.007237)
loop7=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.199013, 0.162829), (0.036184, 0.361842)).lineTo(0.036184, 0.426974).threePointArc((0.025329, 0.437829), (0.014474, 0.426974)).lineTo(0.014474, 0.361842).close()
loop8=wp_sketch1.moveTo(0.014474, 0.361842).threePointArc((0.137500, 0.463158), (0.036184, 0.586184)).lineTo(0.036184, 0.651316).threePointArc((0.025329, 0.662171), (0.014474, 0.651316)).lineTo(0.014474, 0.586184).close()
solid1=wp_sketch1.add(loop4).add(loop5).add(loop6).add(loop7).add(loop8).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
