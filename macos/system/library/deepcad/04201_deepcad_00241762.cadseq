# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00241762" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.011734, 0.000329), (0.023438, 0.001234)).threePointArc((0.011707, 0.000833), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.507812, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.011704, -0.000904), (0.023438, -0.001234)).threePointArc((0.011730, -0.000401), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.138579, -0.026297), (0.242763, -0.121382)).threePointArc((0.525987, -0.222721), (0.809211, -0.121382)).threePointArc((0.913395, -0.026297), (1.051974, 0.000000)).threePointArc((1.277254, 0.222533), (1.051974, 0.445066)).threePointArc((0.913395, 0.471363), (0.809211, 0.566447)).threePointArc((0.525987, 0.667786), (0.242763, 0.566447)).threePointArc((0.138579, 0.471363), (0.000000, 0.445066)).threePointArc((-0.225281, 0.222533), (0.000000, 0.000000)).close()
loop3=wp_sketch2.moveTo(0.000000, 0.215789).circle(0.094408)
loop4=wp_sketch2.moveTo(0.525987, 0.215789).circle(0.310197)
loop5=wp_sketch2.moveTo(1.065461, 0.215789).circle(0.094408)
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.046875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
