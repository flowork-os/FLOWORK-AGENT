import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, -0.554688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.248684, 0.000000).lineTo(1.125000, 0.000000).lineTo(1.125000, 0.378947).lineTo(0.627632, 0.757895).lineTo(0.248684, 0.757895).lineTo(0.248684, 0.497368).lineTo(0.000000, 0.497368).lineTo(0.000000, 0.106579).lineTo(0.000000, 0.082895).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.250000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
