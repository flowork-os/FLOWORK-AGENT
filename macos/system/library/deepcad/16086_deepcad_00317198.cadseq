# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.lineTo(0.000000, -0.197368).lineTo(0.007895, -0.197368).lineTo(0.007895, 0.284211).lineTo(0.000000, 0.284211).lineTo(0.000000, 0.078947).threePointArc((-0.714074, 0.039474), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.lineTo(0.000000, -0.197368).lineTo(0.007895, -0.197368).lineTo(0.007895, 0.284211).lineTo(0.000000, 0.284211).lineTo(0.000000, 0.078947).threePointArc((-0.714074, 0.039474), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(-0.148438)
