# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257772" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.132812, 0.000000).lineTo(0.132812, 0.048931).lineTo(0.104852, 0.096464).lineTo(0.000000, 0.096464).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.023766, 0.060115).circle(0.012582)
loop2=wp_sketch0.moveTo(0.072697, 0.036349).circle(0.023766)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.617188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
