loop0=wp_sketch0.moveTo(0.394737, 0.000000).threePointArc((0.480024, 0.024343), (0.568421, 0.031579)).lineTo(0.757895, 0.031579).lineTo(0.931579, 0.031579).threePointArc((1.019976, 0.024343), (1.105263, 0.000000)).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.189474).lineTo(1.105263, 0.189474).threePointArc((1.019976, 0.165131), (0.931579, 0.157895)).lineTo(0.757895, 0.157895).lineTo(0.568421, 0.157895).threePointArc((0.480024, 0.165131), (0.394737, 0.189474)).lineTo(0.000000, 0.189474).lineTo(0.000000, 0.000000).close()
