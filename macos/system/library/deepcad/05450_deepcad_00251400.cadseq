# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00251400" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.664062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.178618, -0.148849).lineTo(0.029770, -0.669819).lineTo(0.357237, -1.414062).lineTo(0.759128, -1.324753).lineTo(0.580510, -1.175905).lineTo(0.729359, -0.669819).lineTo(0.416776, 0.089309).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.387007, -0.937747).circle(0.133964)
loop2=wp_sketch0.moveTo(0.387007, -0.387007).circle(0.133964)
loop3=wp_sketch0.moveTo(0.387007, -0.669819).circle(0.059539)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.039062, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
