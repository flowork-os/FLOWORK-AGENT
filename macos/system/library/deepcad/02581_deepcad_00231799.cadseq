wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.600000, 0.000000).threePointArc((0.723052, 0.240316), (0.457895, 0.189474)).lineTo(0.600000, 0.189474).lineTo(0.600000, 0.150000).lineTo(0.000000, 0.150000).lineTo(0.000000, 0.189474).lineTo(0.142105, 0.189474).threePointArc((-0.120068, 0.238077), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750)
