wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.664062, -0.328125, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch3.moveTo(0.027632, 0.000000).circle(0.027632)
solid3=wp_sketch3.add(loop3).extrude(0.046875)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.328125, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch4.moveTo(0.027632, 0.000000).circle(0.027632)
solid4=wp_sketch4.add(loop4).extrude(0.046875)
solid=solid.union(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.375000, 0.703125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch5.moveTo(0.040789, -0.484375).lineTo(0.224342, -0.463980).lineTo(0.061184, 0.000000).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop5).extrude(0.710938, both=True)
solid=solid.union(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
