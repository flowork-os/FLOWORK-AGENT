# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00313048" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.452961, 0.000000).lineTo(0.452961, 0.531250).lineTo(0.000000, 0.531250).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.100658, 0.452961).circle(0.072697)
loop2=wp_sketch0.moveTo(0.106250, 0.100658).circle(0.078289)
loop3=wp_sketch0.moveTo(0.335526, 0.452961).circle(0.072697)
loop4=wp_sketch0.moveTo(0.346711, 0.089474).circle(0.078289)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.367188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.000000, 0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.075000, 0.000000).circle(0.073438)
loop6=wp_sketch1.moveTo(0.075000, 0.000000).circle(0.037500)
solid1=wp_sketch1.add(loop5).add(loop6).extrude(0.171875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.000000, 0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch2.moveTo(0.075000, 0.000000).circle(0.075000)
loop8=wp_sketch2.moveTo(0.075000, 0.000000).circle(0.037500)
solid2=wp_sketch2.add(loop7).add(loop8).extrude(0.171875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
