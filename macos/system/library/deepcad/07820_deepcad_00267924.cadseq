# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.025725, -0.062104), (0.087829, -0.087829)).lineTo(1.390625, -0.087829).lineTo(1.390625, 0.263487).lineTo(0.087829, 0.263487).threePointArc((0.025725, 0.237762), (0.000000, 0.175658)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0
# workplane for sketch 1
