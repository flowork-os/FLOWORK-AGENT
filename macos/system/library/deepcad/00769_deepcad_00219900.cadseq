# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00219900" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.593750, 0.226562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.594079, -0.311184).lineTo(0.650658, -0.608224).lineTo(0.806250, -0.381908).lineTo(1.343750, -0.721382).lineTo(0.961842, -0.311184).lineTo(1.174013, -0.099013).lineTo(0.749671, -0.070724).lineTo(0.537500, 0.325329).lineTo(0.509211, -0.056579).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.218750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.429688, 0.171875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.458882, -0.214145).lineTo(0.509868, -0.458882).lineTo(0.622039, -0.285526).lineTo(0.968750, -0.499671).lineTo(0.744408, -0.265132).lineTo(0.938158, -0.061184).lineTo(0.560855, -0.040789).lineTo(0.397697, 0.275329).lineTo(0.356908, -0.040789).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.492188)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
