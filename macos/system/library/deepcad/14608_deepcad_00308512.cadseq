loop5=wp_sketch3.moveTo(0.015789, 0.000000).circle(0.015461)
loop6=wp_sketch3.moveTo(0.015789, 0.000000).circle(0.005263)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(0.054688)
