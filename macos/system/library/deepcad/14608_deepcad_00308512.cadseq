# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.054688, 0.054688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop9=wp_sketch5.moveTo(0.300493, 0.000000).lineTo(0.300493, 0.453125).lineTo(0.000000, 0.453125).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop9).extrude(-0.031250)
