wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.398438, 0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch4.moveTo(0.015789, 0.000000).circle(0.015461)
loop8=wp_sketch4.moveTo(0.015789, 0.000000).circle(0.005263)
