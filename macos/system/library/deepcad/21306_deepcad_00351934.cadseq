# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00351934" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.578125, 0.000000).lineTo(0.578125, 0.377303).lineTo(0.000000, 0.377303).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.529441, 0.048684).lineTo(0.529441, 0.292105).lineTo(0.048684, 0.292105).lineTo(0.048684, 0.048684).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.484375, 0.000000).lineTo(0.484375, 0.244737).lineTo(0.000000, 0.244737).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.554688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
