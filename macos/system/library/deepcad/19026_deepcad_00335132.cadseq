# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00335132" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.244043, -0.381360), (0.663158, -0.552632)).lineTo(0.663158, -0.110526).threePointArc((0.655505, -0.102389), (0.647368, -0.094737)).lineTo(0.189474, -0.094737).close()
loop2=wp_sketch0.moveTo(0.647368, 0.094737).threePointArc((0.655505, 0.102389), (0.663158, 0.110526)).lineTo(0.663158, 0.552632).threePointArc((0.353786, 0.398715), (0.189474, 0.094737)).close()
loop3=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.047368)
loop4=wp_sketch0.moveTo(0.189474, 0.094737).threePointArc((0.719988, -0.177574), (1.310526, -0.094737)).lineTo(0.852632, -0.094737).threePointArc((0.844495, -0.102389), (0.836842, -0.110526)).lineTo(0.836842, -0.552632).close()
loop5=wp_sketch0.moveTo(0.836842, -0.552632).threePointArc((0.854670, -0.229190), (0.852632, 0.094737)).lineTo(1.310526, 0.094737).threePointArc((1.146214, 0.398715), (0.836842, 0.552632)).lineTo(0.836842, 0.110526).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.046875, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch1.moveTo(0.047368, 0.000000).circle(0.047368)
solid1=wp_sketch1.add(loop6).extrude(0.046875, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
