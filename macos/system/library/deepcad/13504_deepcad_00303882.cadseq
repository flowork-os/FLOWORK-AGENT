# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.125000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.439967, 0.079194).lineTo(0.835938, 0.079194).lineTo(0.835938, 0.255181).lineTo(0.624753, 0.255181).lineTo(0.624753, 0.439967).lineTo(0.835938, 0.439967).lineTo(0.835938, 0.624753).lineTo(0.439967, 0.624753).lineTo(0.000000, 0.624753).lineTo(0.000000, 0.439967).lineTo(0.255181, 0.439967).lineTo(0.255181, 0.228783).lineTo(0.000000, 0.184786).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
