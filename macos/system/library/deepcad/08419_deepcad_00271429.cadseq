wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.087496, -0.219406), (0.323684, -0.222533)).lineTo(0.910362, 0.161842).threePointArc((0.940707, 0.303454), (0.799095, 0.333799)).lineTo(0.424836, 0.101151).threePointArc((0.351014, 0.098151), (0.313569, 0.161842)).lineTo(0.313569, 0.495641).threePointArc((0.216528, 0.602019), (0.101151, 0.515872)).lineTo(0.000000, 0.000000).close()
