# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00311196" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.359375, 0.000000).lineTo(0.359375, 0.143750).lineTo(0.313980, 0.143750).lineTo(0.238322, 0.257237).threePointArc((0.179688, 0.288578), (0.121053, 0.257237)).lineTo(0.045395, 0.143750).lineTo(0.000000, 0.143750).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.181579, 0.215625).circle(0.037829)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.110526).lineTo(0.086842, 0.110526).lineTo(0.086842, 0.284211).lineTo(0.055263, 0.284211).lineTo(0.000000, 0.228947).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.359375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.109375, 0.085938, 0.046875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.052961, 0.000000).lineTo(0.052961, -0.047286).lineTo(0.090789, -0.047286).lineTo(0.124836, -0.047286).lineTo(0.124836, 0.000000).lineTo(0.179688, 0.000000).lineTo(0.179688, 0.035937).lineTo(0.124836, 0.035937).lineTo(0.124836, 0.060526).lineTo(0.052961, 0.060526).lineTo(0.052961, 0.035937).lineTo(0.000000, 0.035937).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.765625)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
