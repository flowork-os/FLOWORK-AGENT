loop0=wp_sketch0.moveTo(0.360773, 0.000000).threePointArc((0.387944, 0.022603), (0.369572, 0.052796)).lineTo(0.087993, 0.140789).threePointArc((0.057274, 0.159920), (0.043997, 0.193586)).lineTo(0.043997, 0.422368).lineTo(0.043997, 0.642352).threePointArc((0.057274, 0.676017), (0.087993, 0.695148)).lineTo(0.369572, 0.783141).threePointArc((0.387944, 0.813335), (0.360773, 0.835938)).lineTo(0.000000, 0.835938).lineTo(0.000000, 0.422368).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.695312, both=True)
