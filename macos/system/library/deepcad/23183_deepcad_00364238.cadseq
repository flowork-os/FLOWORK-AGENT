wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.086712, -0.209341), (0.296053, -0.296053)).lineTo(0.875822, -0.296053).threePointArc((1.085163, -0.209341), (1.171875, 0.000000)).lineTo(1.171875, 0.579770).threePointArc((1.087718, 0.795278), (0.875822, 0.888158)).lineTo(0.296053, 0.888158).threePointArc((0.084157, 0.795278), (0.000000, 0.579770)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.484375)
solid=solid0

if __name__ == '__main__':
    import sys
