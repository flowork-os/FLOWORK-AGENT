# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00254870" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.110991, -0.267956), (0.378947, -0.378947)).lineTo(1.310526, -0.378947).threePointArc((1.444504, -0.323452), (1.500000, -0.189474)).lineTo(1.500000, 0.931579).threePointArc((1.444504, 1.065557), (1.310526, 1.121053)).lineTo(0.189474, 1.121053).threePointArc((0.055496, 1.065557), (0.000000, 0.931579)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.187500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
