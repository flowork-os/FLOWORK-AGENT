wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop9=wp_sketch5.moveTo(0.355263, 0.000000).circle(0.355263)
