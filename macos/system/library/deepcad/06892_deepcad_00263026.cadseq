wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.075658, -0.075658).lineTo(0.416118, -0.075658).threePointArc((0.446792, -0.085784), (0.463405, -0.113487)).threePointArc((0.489813, -0.199248), (0.539062, -0.274260)).lineTo(0.595806, -0.274260).lineTo(0.898438, 0.085115).lineTo(0.898438, 0.283717).lineTo(0.841694, 0.331003).lineTo(0.595806, 0.331003).threePointArc((0.506569, 0.236845), (0.378289, 0.217516)).lineTo(0.141859, 0.264803).lineTo(0.075658, 0.264803).lineTo(0.000000, 0.189145).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.141859, 0.075658).circle(0.075658)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.460938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, -0.460938, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.074013, -0.074013).lineTo(0.351562, -0.074013).lineTo(0.351562, 0.222039).lineTo(0.144326, 0.259046).lineTo(0.074013, 0.259046).lineTo(0.000000, 0.185033).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.144326, 0.074013).circle(0.074013)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.195312)
solid=solid.cut(solid1)

