# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236749" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.687500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.311184, -0.687500).lineTo(0.463158, -0.687500).threePointArc((0.468275, -0.685380), (0.470395, -0.680263)).lineTo(0.470395, -0.615132).lineTo(0.151974, 0.057895).threePointArc((0.148355, 0.058944), (0.144737, 0.057895)).lineTo(0.007237, 0.057895).threePointArc((0.002120, 0.055775), (0.000000, 0.050658)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.687500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.311184, -0.687500).lineTo(0.463158, -0.687500).threePointArc((0.468275, -0.685380), (0.470395, -0.680263)).lineTo(0.470395, -0.615132).lineTo(0.151974, 0.057895).threePointArc((0.148355, 0.058944), (0.144737, 0.057895)).lineTo(0.007237, 0.057895).threePointArc((0.002120, 0.055775), (0.000000, 0.050658)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.007812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
