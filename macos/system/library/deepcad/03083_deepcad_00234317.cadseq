loop3=wp_sketch3.moveTo(0.189474, 0.000000).lineTo(0.189474, -0.015789).lineTo(1.310526, -0.015789).lineTo(1.310526, 0.000000).lineTo(1.500000, 0.000000).lineTo(1.500000, 1.389474).lineTo(0.000000, 1.389474).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.094737, 0.078947).circle(0.031579)
