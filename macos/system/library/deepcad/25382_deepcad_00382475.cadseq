# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382475" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.046875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.327632, 0.000000).circle(0.327632)
loop1=wp_sketch0.moveTo(0.122862, 0.000000).circle(0.088734)
loop2=wp_sketch0.moveTo(0.327632, 0.000000).circle(0.109211)
loop3=wp_sketch0.moveTo(0.327632, -0.204770).circle(0.088734)
loop4=wp_sketch0.moveTo(0.327632, 0.204770).circle(0.088734)
loop5=wp_sketch0.moveTo(0.525576, 0.000000).circle(0.088734)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch1.moveTo(0.382895, 0.000000).circle(0.382895)
loop7=wp_sketch1.moveTo(0.382895, 0.000000).circle(0.327056)
solid1=wp_sketch1.add(loop6).add(loop7).extrude(0.164062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop8=wp_sketch2.moveTo(0.071053, 0.000000).circle(0.069572)
solid2=wp_sketch2.add(loop8).extrude(0.164062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
