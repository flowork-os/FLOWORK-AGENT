# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00327031" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.189474, 0.000000).circle(0.185526)
loop1=wp_sketch0.moveTo(0.189474, 0.000000).circle(0.094737)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.094737, 0.000000).circle(0.092763)
solid1=wp_sketch1.add(loop2).extrude(0.375000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, -0.375000, -0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.126069, -0.047744), (0.252138, 0.000000)).lineTo(0.252138, 0.279770).threePointArc((0.126069, 0.327513), (0.000000, 0.279770)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.124342, 0.141612).circle(0.093257)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.375000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
