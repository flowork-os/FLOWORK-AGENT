# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00303878" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.187500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.117434, 0.000000).lineTo(0.117434, 0.218750).lineTo(0.000000, 0.218750).lineTo(0.000000, 0.145066).lineTo(0.043750, 0.145066).lineTo(0.043750, 0.073684).lineTo(0.000000, 0.073684).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.632812, -0.187500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.123355, 0.069079).lineTo(0.123355, 0.123355).lineTo(0.046875, 0.081414).lineTo(0.046875, 0.175164).lineTo(0.123355, 0.185033).lineTo(0.123355, 0.234375).lineTo(0.000000, 0.217105).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
