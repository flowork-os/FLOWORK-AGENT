wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002746, -0.006629), (0.009375, -0.009375)).lineTo(0.139063, -0.009375).threePointArc((0.145692, -0.006629), (0.148438, 0.000000)).lineTo(0.148438, 0.128125).threePointArc((0.146015, 0.135535), (0.139063, 0.139063)).lineTo(0.009375, 0.139063).threePointArc((0.002422, 0.135535), (0.000000, 0.128125)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004040, -0.003504), (0.009375, -0.003125)).lineTo(0.139063, -0.003125).threePointArc((0.140491, -0.001886), (0.140625, 0.000000)).lineTo(0.140625, 0.128125).threePointArc((0.140491, 0.130011), (0.139063, 0.131250)).lineTo(0.009375, 0.131250).threePointArc((0.007947, 0.130011), (0.007812, 0.128125)).lineTo(0.007812, 0.000000).close()
