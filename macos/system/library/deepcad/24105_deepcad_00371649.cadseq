# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(1.367188, 0.000000).lineTo(1.367188, 0.676398).lineTo(0.000000, 0.676398).lineTo(0.000000, 0.000000).close()
