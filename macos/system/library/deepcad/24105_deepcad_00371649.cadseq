# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.273438, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.282237, 0.000000).lineTo(0.282237, 0.162500).lineTo(0.205263, 0.162500).lineTo(0.205263, 0.243750).lineTo(0.282237, 0.243750).lineTo(0.282237, 0.406250).lineTo(0.000000, 0.406250).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.239474, 0.059868).lineTo(0.239474, 0.119737).lineTo(0.051316, 0.119737).lineTo(0.051316, 0.059868).close()
loop4=wp_sketch2.moveTo(0.235197, 0.295066).lineTo(0.235197, 0.363487).lineTo(0.064145, 0.363487).lineTo(0.064145, 0.295066).close()
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).extrude(0.203125)
