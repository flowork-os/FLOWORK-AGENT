# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.282237, 0.000000).lineTo(0.282237, 0.205263).lineTo(0.282237, 0.406250).lineTo(0.205263, 0.406250).lineTo(0.205263, 0.081250).lineTo(0.000000, 0.081250).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.203125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.282237, 0.000000).lineTo(0.282237, 0.406250).lineTo(0.205263, 0.406250).lineTo(0.205263, 0.081250).lineTo(0.000000, 0.081250).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.203125)
