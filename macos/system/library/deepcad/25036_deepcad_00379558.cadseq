wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, 0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.028904, -0.069780), (0.098684, -0.098684)).threePointArc((0.168464, -0.069780), (0.197368, 0.000000)).lineTo(0.197368, 0.487253).threePointArc((0.168464, 0.557034), (0.098684, 0.585938)).threePointArc((0.028904, 0.557034), (0.000000, 0.487253)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.141859, 0.086349).lineTo(0.172697, 0.135691).lineTo(0.172697, 0.351562).lineTo(0.141859, 0.407072).lineTo(0.024671, 0.407072).lineTo(0.024671, 0.086349).close()
loop2=wp_sketch0.moveTo(0.098684, 0.000000).circle(0.043174)
