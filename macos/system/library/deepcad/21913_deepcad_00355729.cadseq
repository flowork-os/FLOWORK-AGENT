# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.015334, -0.110660), (0.114638, -0.161842)).lineTo(0.640625, -0.161842).lineTo(0.640625, -0.121382).lineTo(0.370888, -0.121382).threePointArc((0.367516, -0.121299), (0.364145, -0.121382)).lineTo(0.256250, -0.121382).lineTo(0.114638, -0.121382).threePointArc((0.049978, -0.086389), (0.040461, -0.013487)).lineTo(0.000000, 0.000000).close()
