wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.296875, -0.484375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.103947, 0.000000).lineTo(0.103947, 0.935526).threePointArc((0.298849, 1.130428), (0.493750, 0.935526)).lineTo(0.493750, 0.000000).lineTo(0.584704, 0.000000).lineTo(0.584704, 0.935526).threePointArc((0.292352, 1.227878), (0.000000, 0.935526)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.390625)
