loop0=wp_sketch0.moveTo(0.384539, 0.000000).lineTo(0.384539, 0.164803).lineTo(0.384539, 1.112418).threePointArc((0.192270, 1.304688), (0.000000, 1.112418)).lineTo(0.000000, 0.164803).lineTo(0.000000, 0.000000).close()
