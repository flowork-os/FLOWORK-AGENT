wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.648438, -0.031250, 0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop9=wp_sketch3.moveTo(0.011842, 0.000000).circle(0.011595)
