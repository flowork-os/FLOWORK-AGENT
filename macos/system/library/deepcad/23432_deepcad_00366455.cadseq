# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00366455" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.578125, 0.000000).lineTo(0.578125, 0.578125).lineTo(0.000000, 0.578125).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.578125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.125000, 0.578125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.343750, 0.000000).lineTo(0.343750, 0.343750).lineTo(0.000000, 0.343750).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.300329, 0.104934).lineTo(0.300329, 0.275000).lineTo(0.130263, 0.275000).lineTo(0.130263, 0.104934).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.171875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.125000, 0.578125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.343750, 0.000000).lineTo(0.343750, 0.343750).lineTo(0.000000, 0.343750).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.300329, 0.104934).lineTo(0.300329, 0.275000).lineTo(0.130263, 0.275000).lineTo(0.130263, 0.104934).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.171875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
