# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00303632" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.695312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.045148, 0.000000).lineTo(1.045148, 1.398438).lineTo(0.000000, 1.398438).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(1.152632, 0.000000).lineTo(1.152632, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(1.105263, 0.047368).lineTo(1.105263, 1.452632).lineTo(0.047368, 1.452632).lineTo(0.047368, 0.047368).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.351562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, -0.632812, 0.171875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.924918, 0.000000).lineTo(0.924918, 1.273438).lineTo(0.000000, 1.273438).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.070312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
