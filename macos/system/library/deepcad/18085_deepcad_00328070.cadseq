import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.460938, -0.750000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.310526, 0.000000).lineTo(0.310526, 0.058224).lineTo(0.611349, 0.048520).lineTo(0.611349, 0.000000).lineTo(0.921875, 0.000000).lineTo(0.921875, 0.795724).lineTo(0.611349, 0.795724).lineTo(0.611349, 0.747204).lineTo(0.310526, 0.747204).lineTo(0.310526, 0.795724).lineTo(0.000000, 0.795724).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
