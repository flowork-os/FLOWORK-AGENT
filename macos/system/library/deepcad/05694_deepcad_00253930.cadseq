# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00253930" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.281250, 0.000000, 0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.018306, -0.044194), (0.062500, -0.062500)).lineTo(0.085938, -0.062500).threePointArc((0.130132, -0.044194), (0.148438, 0.000000)).lineTo(0.148438, 0.025000).threePointArc((0.129808, 0.068413), (0.085938, 0.085938)).lineTo(0.062500, 0.085938).threePointArc((0.018629, 0.068413), (0.000000, 0.025000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.075000, 0.012500).circle(0.037500)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.328125, 0.000000, 0.648438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.054687, 0.000000).threePointArc((0.027344, 0.012322), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.242188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
