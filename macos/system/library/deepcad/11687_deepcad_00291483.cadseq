import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.501645, -0.692270).lineTo(0.953125, 0.000000).lineTo(0.501645, 0.752467).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.501645, -0.581908).lineTo(0.882895, 0.000000).lineTo(0.561842, 0.521711).lineTo(0.561842, 0.401316).lineTo(0.782566, 0.000000).lineTo(0.501645, -0.421382).lineTo(0.190625, 0.000000).lineTo(0.451480, 0.401316).lineTo(0.451480, 0.541776).lineTo(0.080263, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.476562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
