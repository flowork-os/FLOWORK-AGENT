# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00304011" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.742188, 0.000000).lineTo(0.742188, 0.539062).lineTo(0.000000, 0.539062).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.695312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.351562, 0.343750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.126316, 0.000000).circle(0.126316)
solid1=wp_sketch1.add(loop1).extrude(-0.500000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.054688, -0.632812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.664062, 0.000000).lineTo(0.664062, 0.468339).lineTo(0.000000, 0.468339).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.615132, 0.048931).lineTo(0.615132, 0.384457).lineTo(0.062911, 0.384457).lineTo(0.062911, 0.048931).close()
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.250000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
