# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00229212" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.600164, -0.453783).lineTo(1.302796, -0.146382).lineTo(1.390625, 0.600164).lineTo(0.790461, 1.053947).lineTo(0.087829, 0.746546).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.702632, 0.292763).circle(0.424507)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.695312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
