wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop8=wp_sketch4.moveTo(0.232895, 0.000000).circle(0.232895)
