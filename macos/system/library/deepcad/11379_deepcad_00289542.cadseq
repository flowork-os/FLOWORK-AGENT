loop6=wp_sketch3.moveTo(0.427632, 0.000000).threePointArc((0.621711, 0.194079), (0.427632, 0.388158)).lineTo(0.000000, 0.388158).threePointArc((0.105273, 0.194079), (0.000000, 0.000000)).close()
loop7=wp_sketch3.moveTo(0.427632, 0.118421).threePointArc((0.503289, 0.194079), (0.427632, 0.269737)).lineTo(0.217105, 0.269737).threePointArc((0.139567, 0.194079), (0.217105, 0.118421)).close()
