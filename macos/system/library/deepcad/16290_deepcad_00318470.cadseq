# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.000000, -0.718750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009057, -0.021864), (0.030921, -0.030921)).lineTo(0.834868, -0.030921).threePointArc((0.864463, -0.025066), (0.881250, 0.000000)).lineTo(0.881250, 1.437829).threePointArc((0.864463, 1.462895), (0.834868, 1.468750)).lineTo(0.030921, 1.468750).threePointArc((0.009057, 1.459693), (0.000000, 1.437829)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
