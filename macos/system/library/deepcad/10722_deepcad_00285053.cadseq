import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.109375, 0.116776).threePointArc((0.986974, 0.227714), (1.109375, 0.338651)).lineTo(0.000000, 0.443750).threePointArc((0.201096, 0.221875), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.075905, 0.239391), (0.315296, 0.163487)).lineTo(0.759046, 0.163487).threePointArc((0.817434, 0.221875), (0.759046, 0.280263)).lineTo(0.315296, 0.280263).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.225000, 0.000000).circle(0.220312)
loop3=wp_sketch1.moveTo(0.225000, 0.000000).circle(0.168750)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.335938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.476562, 0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.114474, 0.000000).circle(0.112089)
loop5=wp_sketch2.moveTo(0.114474, 0.000000).circle(0.057237)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.281250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
