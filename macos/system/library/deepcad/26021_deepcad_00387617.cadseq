# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387617" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.140625, 0.000000, 0.492188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.005702, -0.007677), (0.011020, -0.015625)).lineTo(0.011020, 0.006250).threePointArc((0.005472, 0.003193), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.296875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, 0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.491776, -0.689246), (0.983553, 0.000000)).threePointArc((0.835414, -0.126778), (0.641447, -0.106908)).lineTo(0.641447, 0.310033).threePointArc((0.499937, 0.391387), (0.352796, 0.320724)).lineTo(0.352796, -0.106908).threePointArc((0.153095, -0.130354), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.491776, -0.299342).circle(0.138980)
loop3=wp_sketch1.moveTo(0.491776, 0.224507).circle(0.074836)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.296875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, -0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.146053, 0.000000).circle(0.146053)
solid2=wp_sketch2.add(loop4).extrude(0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
