# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.226562, 0.578125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.017681, -0.091941).threePointArc((0.167697, -0.141586), (0.293503, -0.045970)).lineTo(0.335938, -0.045970).threePointArc((0.298542, 0.013849), (0.268750, 0.077796)).threePointArc((0.099120, 0.160688), (0.000000, 0.000000)).close()
