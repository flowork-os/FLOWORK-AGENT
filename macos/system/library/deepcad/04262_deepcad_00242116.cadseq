loop1=wp_sketch0.moveTo(0.239638, -0.309211).circle(0.061842)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.578125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
