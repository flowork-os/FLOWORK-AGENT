# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272433" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, 0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.081168, -0.060444).lineTo(0.164062, 0.000000).lineTo(0.132977, 0.096711).lineTo(0.031086, 0.096711).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.375000, 0.000000).lineTo(0.375000, 0.375000).lineTo(0.000000, 0.375000).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.075000, 0.307895).circle(0.047368)
loop3=wp_sketch1.moveTo(0.217105, 0.118421).lineTo(0.300000, 0.177632).lineTo(0.268421, 0.272368).lineTo(0.169737, 0.272368).lineTo(0.138158, 0.177632).close()
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.085938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
