# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00357313" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.054688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.117105, -0.578207).threePointArc((0.263487, -0.698339), (0.409868, -0.578207)).lineTo(0.526974, 0.000000).threePointArc((0.263487, 0.321060), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.263487, 0.051234).circle(0.139063)
loop2=wp_sketch0.moveTo(0.263487, -0.548931).circle(0.073191)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
