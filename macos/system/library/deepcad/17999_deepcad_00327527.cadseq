# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00327527" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.039062, -0.023438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.085938, 0.000000).lineTo(0.085938, 0.043421).lineTo(0.000000, 0.043421).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.080510, 0.005428).lineTo(0.080510, 0.037993).lineTo(0.005428, 0.037993).lineTo(0.005428, 0.005428).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
