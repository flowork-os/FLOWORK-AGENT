# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220213" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, -0.570312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.threePointArc((0.149260, -0.149260), (0.298520, 0.000000)).lineTo(0.298520, 1.126234).threePointArc((0.149260, 1.288899), (0.000000, 1.126234)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.149260, 0.000000).circle(0.054276)
loop2=wp_sketch0.moveTo(0.149260, 1.139803).circle(0.054276)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, -0.421875, 0.187500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.167187, 0.000000).lineTo(0.167187, 0.835938).lineTo(0.000000, 0.835938).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.476562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
