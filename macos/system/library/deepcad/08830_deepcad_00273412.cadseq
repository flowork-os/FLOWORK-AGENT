# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00273412" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.450000, -0.078947).threePointArc((0.753947, 0.225000), (0.450000, 0.528947)).lineTo(0.000000, 0.450000).threePointArc((-0.225000, 0.225000), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.221053).circle(0.142105)
loop2=wp_sketch0.moveTo(0.450000, 0.221053).circle(0.213158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
