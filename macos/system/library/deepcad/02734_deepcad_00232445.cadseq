import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.453125, 0.000000).lineTo(1.453125, 0.734211).lineTo(1.208388, 0.734211).lineTo(1.208388, 0.489474).lineTo(0.933059, 0.489474).lineTo(0.933059, 0.718914).lineTo(0.504770, 0.734211).lineTo(0.504770, 0.489474).lineTo(0.244737, 0.489474).lineTo(0.244737, 0.734211).lineTo(0.000000, 0.734211).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.183553, 0.183553).circle(0.045888)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
