# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.016283, 0.000000).threePointArc((0.024419, -0.018737), (0.043421, -0.026234)).lineTo(0.043421, -0.043421).threePointArc((0.073672, -0.030516), (0.085938, 0.000000)).lineTo(0.069655, 0.000000).threePointArc((0.061971, 0.018550), (0.043421, 0.026234)).lineTo(0.043421, 0.043421).threePointArc((0.012718, 0.030703), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
