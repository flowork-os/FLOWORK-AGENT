# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288681" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.037183, -0.024201), (0.052632, -0.065789)).lineTo(0.078947, -0.585526).threePointArc((0.125000, -0.629372), (0.171053, -0.585526)).lineTo(0.197368, -0.065789).threePointArc((0.212817, -0.024201), (0.250000, 0.000000)).threePointArc((0.125000, 0.307093), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, -0.007812, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.114474, -0.064391).lineTo(0.226562, 0.000000).lineTo(0.226562, 0.131168).lineTo(0.114474, 0.195559).lineTo(0.000000, 0.131168).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.085938)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
