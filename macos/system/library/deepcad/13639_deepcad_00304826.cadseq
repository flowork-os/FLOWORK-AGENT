import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.027632, 0.000000).lineTo(0.027632, -0.027632).lineTo(0.092105, -0.027632).lineTo(0.092105, -0.009211).threePointArc((0.099308, -0.000590), (0.110526, 0.000000)).lineTo(0.865789, -0.064474).lineTo(0.875000, 0.000000).lineTo(0.101316, 0.064474).threePointArc((0.094934, 0.067303), (0.092105, 0.073684)).lineTo(0.092105, 0.092105).lineTo(0.027632, 0.092105).lineTo(0.027632, 0.064474).lineTo(0.000000, 0.064474).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.119737, 0.027632).circle(0.009211)
loop2=wp_sketch0.moveTo(0.810526, -0.027632).circle(0.009211)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
