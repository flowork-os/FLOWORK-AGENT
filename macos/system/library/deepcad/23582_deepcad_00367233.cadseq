# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00367233" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.215789, 0.000000).lineTo(0.215789, 0.640625).lineTo(0.000000, 0.640625).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.640625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.492188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.256250, 0.000000).lineTo(0.256250, 0.640625).lineTo(0.000000, 0.640625).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.640625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(1.031250, 0.000000).lineTo(1.031250, 0.640461).lineTo(0.857566, 0.640461).lineTo(0.857566, 0.217105).lineTo(0.217105, 0.217105).lineTo(0.217105, 0.640461).lineTo(0.000000, 0.640461).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.640625)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.515625, -0.640625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.234375, 0.000000).lineTo(0.234375, 0.296875).lineTo(0.000000, 0.296875).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.640625)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.640625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.234375, 0.000000).lineTo(0.234375, 0.296875).lineTo(0.000000, 0.296875).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.640625)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
