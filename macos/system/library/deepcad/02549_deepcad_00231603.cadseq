# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231603" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.055496, -0.133978), (0.189474, -0.189474)).lineTo(1.500000, -0.189474).lineTo(1.500000, 0.489474).lineTo(0.189474, 0.489474).threePointArc((0.058766, 0.441873), (0.000000, 0.315789)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.189474, 0.000000).circle(0.063158)
loop2=wp_sketch0.moveTo(0.189474, 0.315789).circle(0.063158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.156250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
