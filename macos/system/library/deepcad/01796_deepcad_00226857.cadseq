wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.007946, -0.019521), (0.027467, -0.027467)).lineTo(1.277220, -0.027467).threePointArc((1.296742, -0.019521), (1.304688, 0.000000)).lineTo(1.290954, 0.700411).threePointArc((1.282811, 0.719735), (1.263487, 0.727878)).lineTo(0.041201, 0.727878).threePointArc((0.021877, 0.719735), (0.013734, 0.700411)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
