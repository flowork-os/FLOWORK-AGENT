# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00296049" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.090789, 0.000000).lineTo(0.090789, 0.313980).lineTo(0.268586, 0.313980).lineTo(0.268586, 0.000000).lineTo(0.359375, 0.000000).lineTo(0.359375, 0.147533).lineTo(0.359375, 0.359375).lineTo(0.000000, 0.359375).lineTo(0.000000, 0.147533).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.359375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.257812, -0.078125, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.264803, 0.000000).lineTo(0.000000, 0.359375).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.179688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, 0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.051809, 0.000000).circle(0.051809)
loop3=wp_sketch2.moveTo(0.351562, -0.103618).lineTo(0.351562, 0.103618).lineTo(0.051809, 0.103618).threePointArc((0.155428, 0.000000), (0.051809, -0.103618)).close()
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.085938)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.343750, 0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.299342, 0.000000).threePointArc((0.406250, 0.106908), (0.299342, 0.213816)).lineTo(0.000000, 0.213816).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch3.moveTo(0.299342, 0.106908).circle(0.051316)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.085938)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
