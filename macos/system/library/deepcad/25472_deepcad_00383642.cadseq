# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00383642" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.110526, 0.000000).lineTo(0.110526, 0.875000).lineTo(0.000000, 0.875000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.055263, 0.073684).circle(0.027632)
loop2=wp_sketch0.moveTo(0.055263, 0.718421).circle(0.027632)
loop3=wp_sketch0.moveTo(0.055263, 0.506579).circle(0.027632)
loop4=wp_sketch0.moveTo(0.055263, 0.276316).circle(0.027632)
loop5=wp_sketch0.moveTo(0.055263, 0.828947).circle(0.009211)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.148438, -0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.110526, 0.000000).lineTo(0.110526, 0.875000).lineTo(0.000000, 0.875000).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch1.moveTo(0.046053, 0.681579).circle(0.027632)
loop8=wp_sketch1.moveTo(0.055263, 0.064474).circle(0.027632)
loop9=wp_sketch1.moveTo(0.055263, 0.451316).circle(0.027632)
loop10=wp_sketch1.moveTo(0.055263, 0.248684).circle(0.027632)
loop11=wp_sketch1.moveTo(0.055263, 0.801316).circle(0.009211)
solid1=wp_sketch1.add(loop6).add(loop7).add(loop8).add(loop9).add(loop10).add(loop11).extrude(0.109375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
