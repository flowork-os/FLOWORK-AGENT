wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004962, -0.011979), (0.016941, -0.016941)).lineTo(0.736924, -0.016941).threePointArc((0.748903, -0.011979), (0.753865, 0.000000)).lineTo(0.753865, 0.787747).threePointArc((0.748903, 0.799726), (0.736924, 0.804688)).lineTo(0.016941, 0.804688).threePointArc((0.004962, 0.799726), (0.000000, 0.787747)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
