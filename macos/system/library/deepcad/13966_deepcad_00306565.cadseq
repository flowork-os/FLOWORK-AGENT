# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306565" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.050329, 0.000000).lineTo(0.050329, -0.050329).lineTo(0.796875, -0.050329).lineTo(0.796875, 0.184539).lineTo(0.377467, 0.469737).lineTo(0.000000, 0.469737).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.210938, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.210938, 0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.327138, 0.000000).lineTo(0.327138, -0.092270).lineTo(0.419408, -0.092270).lineTo(0.419408, -0.142599).lineTo(0.327138, -0.142599).lineTo(0.327138, -0.234868).lineTo(0.796875, -0.234868).lineTo(0.796875, 0.000000).lineTo(0.377467, 0.285197).lineTo(0.000000, 0.285197).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.234375)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
