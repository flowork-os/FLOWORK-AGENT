# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00298184" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.207237, 0.000000).lineTo(0.207237, 0.437500).lineTo(0.000000, 0.437500).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.150000, 0.000000).circle(0.150000)
solid1=wp_sketch1.add(loop1).extrude(0.078125, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, 0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.044901, -0.099424).lineTo(0.157155, -0.099424).lineTo(0.202056, 0.000000).threePointArc((0.207485, 0.075841), (0.163569, 0.137911)).lineTo(0.163569, 0.243750).threePointArc((0.101028, 0.306291), (0.038487, 0.243750)).lineTo(0.038487, 0.137911).threePointArc((-0.005429, 0.075841), (0.000000, 0.000000)).close()
loop3=wp_sketch2.moveTo(0.125082, -0.054523).lineTo(0.125082, -0.028865).threePointArc((0.097821, 0.122719), (0.070559, -0.028865)).lineTo(0.070559, -0.054523).close()
loop4=wp_sketch2.moveTo(0.099424, 0.243750).circle(0.022451)
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).extrude(0.109375, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
