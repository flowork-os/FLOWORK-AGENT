# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00333996" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.648438, -0.015625).threePointArc((0.733721, 0.023438), (0.648438, 0.062500)).lineTo(0.000000, 0.046875).threePointArc((-0.061888, 0.023438), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.031250, 0.023438).circle(0.023438)
loop2=wp_sketch0.moveTo(0.687500, 0.023438).circle(0.039062)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.031250, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
