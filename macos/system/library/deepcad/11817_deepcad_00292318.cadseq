# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00292318" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.117188, 0.000000).lineTo(0.117188, 0.117188).lineTo(0.000000, 0.117188).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.108553, 0.008635).lineTo(0.108553, 0.108553).lineTo(0.008635, 0.108553).lineTo(0.008635, 0.008635).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.734375, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.015543, 0.000000).lineTo(0.015543, 0.164062).lineTo(0.000000, 0.164062).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.062500, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.734375, -0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.015543, 0.000000).lineTo(0.015543, 0.164062).lineTo(0.000000, 0.164062).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.062500, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.000000, 0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.007895, 0.000000).circle(0.007895)
solid3=wp_sketch3.add(loop4).extrude(-0.750000, both=True)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.000000, 0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.007895, 0.000000).circle(0.007895)
solid4=wp_sketch4.add(loop5).extrude(-0.750000, both=True)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
