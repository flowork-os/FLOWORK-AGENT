loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000193, -0.000465), (0.000658, -0.000658)).lineTo(0.007155, -0.000658).threePointArc((0.007620, -0.000465), (0.007812, 0.000000)).lineTo(0.007812, 0.006579).threePointArc((0.007603, 0.007003), (0.007155, 0.007155)).lineTo(0.000658, 0.007155).threePointArc((0.000210, 0.007003), (0.000000, 0.006579)).lineTo(0.000000, 0.000000).close()
