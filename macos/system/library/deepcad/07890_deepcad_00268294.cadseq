# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00268294" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.607895, 0.000000).threePointArc((0.750000, 0.142105), (0.607895, 0.284211)).lineTo(0.000000, 0.284211).threePointArc((-0.142105, 0.142105), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.142105).circle(0.110526)
loop2=wp_sketch0.moveTo(0.300000, 0.142105).circle(0.110526)
loop3=wp_sketch0.moveTo(0.607895, 0.142105).circle(0.110526)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.114474, 0.000000).circle(0.114474)
loop5=wp_sketch1.moveTo(0.114474, 0.000000).circle(0.085855)
solid1=wp_sketch1.add(loop4).add(loop5).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.187500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.114474, 0.000000).circle(0.114474)
loop7=wp_sketch2.moveTo(0.114474, 0.000000).circle(0.085855)
solid2=wp_sketch2.add(loop6).add(loop7).extrude(0.078125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.492188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch3.moveTo(0.114474, 0.000000).circle(0.114474)
loop9=wp_sketch3.moveTo(0.114474, 0.000000).circle(0.085855)
solid3=wp_sketch3.add(loop8).add(loop9).extrude(0.078125)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
