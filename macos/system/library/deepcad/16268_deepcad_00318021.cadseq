wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, 0.562500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.097286, -0.069414), (0.194572, 0.000000)).threePointArc((0.203868, 0.055592), (0.194572, 0.111184)).threePointArc((0.097286, 0.180598), (0.000000, 0.111184)).threePointArc((-0.009295, 0.055592), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.087508, -0.055984), (0.168914, 0.008553)).threePointArc((0.176780, 0.055592), (0.168914, 0.102632)).threePointArc((0.097286, 0.153738), (0.025658, 0.102632)).threePointArc((0.017793, 0.055592), (0.025658, 0.008553)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, -0.039062, 0.593750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.050164, 0.000000).lineTo(0.050164, -0.060033).threePointArc((0.066010, -0.042988), (0.076480, -0.022204)).threePointArc((0.077315, -0.020153), (0.078125, -0.018092)).lineTo(0.078125, 0.027961).lineTo(0.000000, 0.027961).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
