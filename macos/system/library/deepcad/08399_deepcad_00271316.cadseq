wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.112952, -0.257816), (0.393750, -0.238322)).lineTo(0.942928, 0.217599).threePointArc((0.968338, 0.381513), (0.808224, 0.424836)).lineTo(0.507730, 0.269408).threePointArc((0.434853, 0.271367), (0.393750, 0.331579)).lineTo(0.352303, 0.569901).threePointArc((0.237501, 0.675348), (0.113980, 0.580263)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.238322, -0.051809).circle(0.082895)
loop2=wp_sketch0.moveTo(0.238322, 0.559539).circle(0.062171)
loop3=wp_sketch0.moveTo(0.860033, 0.310855).circle(0.062171)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.078125)
