# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00250546" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.710938, 0.000000).lineTo(0.710938, 0.546299).lineTo(0.000000, 0.546299).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.359211, 0.276891).circle(0.104770)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.343750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.518092, 0.000000).lineTo(0.518092, 0.546875).lineTo(0.000000, 0.546875).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.259046, 0.276316).circle(0.092105)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.101562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
