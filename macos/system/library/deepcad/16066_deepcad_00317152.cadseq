loop0=wp_sketch0.moveTo(0.085773, 0.000000).lineTo(0.085773, 0.085773).lineTo(0.110280, 0.085773).lineTo(0.110280, 0.000000).lineTo(1.053783, 0.000000).lineTo(1.053783, 0.085773).lineTo(1.078289, 0.085773).lineTo(1.078289, 0.000000).lineTo(1.164062, 0.000000).lineTo(1.164062, 0.661678).threePointArc((1.138940, 0.722328), (1.078289, 0.747451)).lineTo(0.085773, 0.747451).threePointArc((0.025122, 0.722328), (0.000000, 0.661678)).lineTo(0.000000, 0.000000).close()
