wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.796875, 0.000000).lineTo(0.796875, 0.612336).lineTo(0.704605, 0.612336).lineTo(0.704605, 0.134211).threePointArc((0.687407, 0.092691), (0.645888, 0.075493)).lineTo(0.134211, 0.075493).threePointArc((0.092691, 0.092691), (0.075493, 0.134211)).lineTo(0.075493, 0.612336).lineTo(0.000000, 0.612336).lineTo(0.000000, 0.000000).close()
