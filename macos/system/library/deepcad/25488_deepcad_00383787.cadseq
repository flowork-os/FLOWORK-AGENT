# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.218750, 0.000000).lineTo(1.218750, 0.282237).lineTo(0.731250, 0.282237).threePointArc((0.673520, 0.339967), (0.731250, 0.397697)).lineTo(1.218750, 0.397697).lineTo(1.218750, 0.667105).lineTo(0.000000, 0.667105).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.039145, 0.102632).threePointArc((1.076240, 0.141118), (1.039145, 0.179605)).lineTo(1.013487, 0.179605).threePointArc((0.969420, 0.141118), (1.013487, 0.102632)).close()
loop2=wp_sketch0.moveTo(1.039145, 0.487500).threePointArc((1.076240, 0.525987), (1.039145, 0.564474)).lineTo(1.013487, 0.564474).threePointArc((0.969420, 0.525987), (1.013487, 0.487500)).close()
