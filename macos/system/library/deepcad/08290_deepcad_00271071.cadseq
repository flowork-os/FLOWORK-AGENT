# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00271071" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.461020, 0.000000).threePointArc((1.484334, 0.023314), (1.461020, 0.046628)).lineTo(0.000000, 0.046628).threePointArc((-0.023314, 0.023314), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(1.461020, 0.000000).threePointArc((1.476562, 0.015543), (1.461020, 0.031086)).lineTo(0.000000, 0.031086).threePointArc((-0.015543, 0.015543), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.007812, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
