# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00237315" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.937500, 0.000000).lineTo(0.453947, 0.789474).lineTo(0.000000, 0.779605).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.726562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, 0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, -0.782895).lineTo(0.928289, -0.782895).lineTo(1.062500, -0.782895).lineTo(0.480921, 0.078289).lineTo(0.000000, 0.078289).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.171875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.539062, 0.140625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.086842, 0.000000).circle(0.086842)
solid2=wp_sketch2.add(loop2).extrude(-0.937500)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
