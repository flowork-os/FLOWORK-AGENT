import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, 0.000000, -0.710938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.045724, 0.000000).lineTo(1.045724, 0.230674).lineTo(0.353701, 0.230674).lineTo(0.353701, 1.460938).lineTo(0.123026, 1.445559).threePointArc((0.144247, 1.297183), (0.000000, 1.337911)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.320312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
