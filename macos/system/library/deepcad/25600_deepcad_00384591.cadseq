# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, -0.289062, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch1.moveTo(0.480263, -0.276151).threePointArc((0.517250, -0.317691), (0.528289, -0.372204)).lineTo(0.528289, -0.924507).lineTo(0.612336, -0.924507).lineTo(0.612336, -0.372204).threePointArc((0.623375, -0.317691), (0.660362, -0.276151)).lineTo(1.140625, 0.000000).lineTo(1.104605, 0.060033).lineTo(0.624342, -0.216118).threePointArc((0.570312, -0.230714), (0.516283, -0.216118)).lineTo(0.036020, 0.060033).lineTo(0.000000, 0.000000).close()
