import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.142105, -0.442105).lineTo(0.521053, -0.710526).lineTo(0.978947, -0.710526).lineTo(1.357895, -0.442105).lineTo(1.500000, 0.000000).lineTo(1.357895, 0.442105).lineTo(0.978947, 0.710526).lineTo(0.757895, 0.710526).lineTo(0.521053, 0.710526).lineTo(0.142105, 0.442105).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.394737, -0.252632).lineTo(0.615789, -0.410526).lineTo(0.884211, -0.410526).lineTo(1.105263, -0.252632).lineTo(1.184211, 0.000000).lineTo(1.105263, 0.252632).lineTo(0.884211, 0.410526).lineTo(0.757895, 0.410526).lineTo(0.615789, 0.410526).lineTo(0.394737, 0.252632).lineTo(0.315789, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.476562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
