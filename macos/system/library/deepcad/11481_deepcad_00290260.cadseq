# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00290260" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.378947, 0.000000).lineTo(0.378947, 0.560526).threePointArc((0.189474, 0.750000), (0.000000, 0.560526)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.189474, 0.560526).circle(0.094737)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
