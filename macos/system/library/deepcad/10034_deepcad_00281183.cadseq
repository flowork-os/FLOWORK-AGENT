import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.007812, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.019737, -0.546053).lineTo(0.322368, -0.315789).lineTo(0.625000, -0.078947).lineTo(0.098684, 0.078947).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.328125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.316941, -0.209046).lineTo(0.640625, -0.418092).lineTo(0.620395, 0.128125).lineTo(0.512500, 0.195559).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.062500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.042023, -0.120066).lineTo(0.570312, -0.276151).lineTo(0.444243, 0.084046).lineTo(0.318174, 0.450247).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.023438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.445312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.322368, -0.443257).lineTo(0.443257, -0.443257).lineTo(0.765625, 0.000000).lineTo(0.386842, 0.000000).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.023438)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
