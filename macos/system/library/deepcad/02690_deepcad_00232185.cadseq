# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232185" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, -0.562500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.429688, 0.000000).lineTo(1.429688, 0.842763).lineTo(0.000000, 0.842763).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.285938, 0.466530).circle(0.210691)
loop2=wp_sketch0.moveTo(0.918010, 0.617023).circle(0.165543)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.132812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
