# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00338860" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.307895, 0.000000).lineTo(0.307895, 0.592105).threePointArc((0.153947, 0.746053), (0.000000, 0.592105)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.094737, 0.600000).circle(0.023684)
loop2=wp_sketch0.moveTo(0.157895, 0.292105).circle(0.023684)
loop3=wp_sketch0.moveTo(0.213158, 0.600000).circle(0.023684)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.117188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
