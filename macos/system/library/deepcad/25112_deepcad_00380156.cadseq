# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00380156" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.073019, -0.041326), (0.101316, -0.120312)).threePointArc((0.297615, -0.060766), (0.493914, -0.120312)).threePointArc((0.525378, -0.040149), (0.601562, 0.000000)).threePointArc((0.300781, 0.240729), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.301480, -0.376688), (0.602961, 0.000000)).threePointArc((0.526979, -0.037463), (0.493914, -0.115461)).threePointArc((0.298273, -0.056113), (0.102632, -0.115461)).threePointArc((0.072775, -0.038656), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.078125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
