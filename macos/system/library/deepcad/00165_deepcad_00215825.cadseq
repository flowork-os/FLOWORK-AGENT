# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00215825" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.429688, 0.000000).lineTo(1.429688, 1.429688).lineTo(0.000000, 1.429688).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.887911, 0.571875).lineTo(0.887911, 0.933059).lineTo(0.541776, 0.933059).lineTo(0.541776, 0.571875).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.359375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
