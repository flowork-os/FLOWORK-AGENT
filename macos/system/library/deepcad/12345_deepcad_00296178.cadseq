loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.001544, -0.001507), (0.003701, -0.001480)).lineTo(0.066612, -0.001480).threePointArc((0.067659, -0.001047), (0.068092, 0.000000)).lineTo(0.068092, 0.063651).threePointArc((0.067505, 0.064328), (0.066612, 0.064391)).lineTo(0.003701, 0.064391).threePointArc((0.002807, 0.064328), (0.002220, 0.063651)).lineTo(0.002220, 0.000000).close()
