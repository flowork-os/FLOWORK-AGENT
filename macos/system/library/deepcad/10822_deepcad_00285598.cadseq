# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285598" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.394737).lineTo(0.000000, 0.394737).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.260526, 0.134211).lineTo(0.260526, 0.260526).lineTo(0.134211, 0.260526).lineTo(0.134211, 0.134211).close()
loop2=wp_sketch0.moveTo(0.552632, 0.197368).circle(0.063158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, -0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.095559, 0.000000).lineTo(0.095559, 0.648438).lineTo(0.000000, 0.648438).lineTo(0.000000, 0.518750).lineTo(0.047780, 0.518750).lineTo(0.047780, 0.423191).lineTo(0.000000, 0.423191).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.390625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, -0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.095559, 0.000000).lineTo(0.095559, 0.423191).lineTo(0.047780, 0.423191).lineTo(0.047780, 0.518750).lineTo(0.095559, 0.518750).lineTo(0.095559, 0.648438).lineTo(0.000000, 0.648438).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.390625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
