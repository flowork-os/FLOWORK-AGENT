# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00390577" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.484375, 0.000000).lineTo(0.484375, 0.300822).lineTo(0.000000, 0.300822).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.179688, 0.015625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.601562, 0.000000).lineTo(0.601562, 0.417928).lineTo(0.000000, 0.417928).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.544572, 0.063322).lineTo(0.544572, 0.360937).lineTo(0.063322, 0.360937).lineTo(0.063322, 0.063322).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
