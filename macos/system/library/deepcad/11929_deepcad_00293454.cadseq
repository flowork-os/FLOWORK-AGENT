import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, 0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.132812, -0.241304), (0.265625, 0.000000)).threePointArc((0.234724, 0.066922), (0.223684, 0.139803)).lineTo(0.223684, 0.573191).threePointArc((0.132812, 0.664062), (0.041941, 0.573191)).lineTo(0.041941, 0.139803).threePointArc((0.030901, 0.066922), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.132812, -0.083882).circle(0.076891)
loop2=wp_sketch0.moveTo(0.132812, 0.573191).circle(0.055921)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
