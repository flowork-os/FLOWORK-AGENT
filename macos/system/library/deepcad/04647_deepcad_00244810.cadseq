# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00244810" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.000000, -0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.213816, 0.000000).lineTo(0.213816, 0.406250).lineTo(0.000000, 0.406250).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.109375, 0.000000, -0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.640625, 0.000000).lineTo(0.640625, 0.236020).lineTo(0.000000, 0.404605).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.512500, 0.128125).circle(0.053947)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.070312)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
