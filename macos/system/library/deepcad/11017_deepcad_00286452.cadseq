# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00286452" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.157895, 0.000000).circle(0.154605)
loop1=wp_sketch0.moveTo(0.157895, 0.000000).circle(0.118421)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.234375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.117188, 0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.078947, 0.000000).circle(0.078947)
loop3=wp_sketch1.moveTo(0.078947, 0.000000).circle(0.039474)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.195312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.781250, 0.065789).threePointArc((0.695052, 0.143914), (0.781250, 0.222039)).lineTo(0.000000, 0.312500).threePointArc((0.141617, 0.156250), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.534539, 0.106908).threePointArc((0.493421, 0.148026), (0.534539, 0.189145)).lineTo(0.222039, 0.189145).threePointArc((0.180921, 0.148026), (0.222039, 0.106908)).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.156250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
