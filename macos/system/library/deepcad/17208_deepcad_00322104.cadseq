# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.210938, -0.078125, 0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
