# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.148438, -0.078125, 0.218750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.148438, 0.000000).threePointArc((0.074219, 0.074219), (0.000000, 0.000000)).close()
