wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.615789, 0.000000).threePointArc((0.746053, 0.130263), (0.615789, 0.260526)).lineTo(0.000000, 0.260526).threePointArc((-0.130263, 0.130263), (0.000000, 0.000000)).close()
