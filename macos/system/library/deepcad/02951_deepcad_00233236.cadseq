# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.090461, 0.000000).lineTo(0.090461, 0.781250).lineTo(0.000000, 0.781250).lineTo(0.000000, 0.000000).close()
