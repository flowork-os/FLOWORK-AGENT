loop7=wp_sketch1.moveTo(0.016447, 0.748355).circle(0.008224)
loop8=wp_sketch1.moveTo(0.074013, 0.032895).circle(0.008224)
loop9=wp_sketch1.moveTo(0.074013, 0.748355).circle(0.008224)
solid1=wp_sketch1.add(loop5).add(loop6).add(loop7).add(loop8).add(loop9).extrude(0.039062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.335938, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop10=wp_sketch2.moveTo(0.090461, 0.000000).lineTo(0.090461, 0.781250).lineTo(0.000000, 0.781250).lineTo(0.000000, 0.000000).close()
loop11=wp_sketch2.moveTo(0.016447, 0.032895).circle(0.008224)
