# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00321083" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.873355, 0.000000).lineTo(0.873355, 1.382812).lineTo(0.000000, 1.382812).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.786020, 0.756908).lineTo(0.786020, 1.310033).lineTo(0.116447, 1.310033).lineTo(0.116447, 0.756908).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, 0.007812, 0.046875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.617188, 0.000000).lineTo(0.617188, 0.168914).lineTo(0.136431, 0.168914).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-1.000000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.609375, 0.273438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.109375, 0.000000).lineTo(0.109375, 0.072533).lineTo(0.000000, 0.072533).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.109375)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.328125, 0.273438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.109375, 0.000000).lineTo(0.109375, 0.069079).lineTo(0.000000, 0.069079).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(-0.109375)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
