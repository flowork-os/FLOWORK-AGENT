# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00305795" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.710526, 0.000000).lineTo(0.710526, 0.394737).threePointArc((0.355263, 0.750000), (0.000000, 0.394737)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.355263, 0.394737).circle(0.157895)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, -0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.194572, 0.000000).lineTo(0.194572, 0.119737).lineTo(0.516365, 0.119737).lineTo(0.516365, 0.000000).lineTo(0.710938, 0.000000).lineTo(0.710938, 0.172122).lineTo(0.000000, 0.172122).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.320312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.000000, 0.398438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.161842, 0.000000).circle(0.161842)
loop4=wp_sketch2.moveTo(0.161842, 0.000000).circle(0.080921)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.226562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
