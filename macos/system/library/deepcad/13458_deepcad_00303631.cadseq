# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00303631" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, -0.554688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.829112, 0.000000).lineTo(0.829112, 1.109375).lineTo(0.000000, 1.109375).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.794079, 0.046711).lineTo(0.794079, 1.062664).lineTo(0.046711, 1.062664).lineTo(0.046711, 0.046711).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, -0.593750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.918503, 0.000000).lineTo(0.918503, 1.195312).lineTo(0.000000, 1.195312).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.880757, 0.037747).lineTo(0.880757, 1.157566).lineTo(0.037747, 1.157566).lineTo(0.037747, 0.037747).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.609375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.515625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.749013, 0.000000).lineTo(0.749013, 1.031250).lineTo(0.000000, 1.031250).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.054688)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
