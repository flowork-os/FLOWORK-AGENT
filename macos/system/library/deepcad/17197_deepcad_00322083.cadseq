# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322083" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, -0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.203125, 0.000000).lineTo(1.203125, 0.671217).lineTo(0.000000, 0.671217).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.139309, 0.341941).circle(0.088651)
loop2=wp_sketch0.moveTo(1.063816, 0.341941).circle(0.088651)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.300781, -0.300781), (0.601562, 0.000000)).lineTo(0.493914, 0.000000).threePointArc((0.300781, -0.193133), (0.107648, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.585938, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
