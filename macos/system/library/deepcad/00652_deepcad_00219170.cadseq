# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00219170" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.796875, 0.000000).lineTo(0.796875, 0.142599).lineTo(0.000000, 0.142599).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.150987, 0.067105).circle(0.058717)
loop2=wp_sketch0.moveTo(0.402632, 0.067105).circle(0.058717)
loop3=wp_sketch0.moveTo(0.645888, 0.067105).circle(0.058717)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(1.000000, 0.000000).lineTo(1.000000, 0.505263).lineTo(0.000000, 0.505263).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(0.905263, 0.178947).lineTo(0.905263, 0.315789).lineTo(0.105263, 0.315789).lineTo(0.105263, 0.178947).close()
solid1=wp_sketch1.add(loop4).add(loop5).extrude(0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
