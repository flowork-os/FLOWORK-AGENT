# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00377111" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.476562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.652796, 0.000000).lineTo(0.652796, 0.205510).lineTo(1.148438, 0.205510).lineTo(1.148438, 0.761595).lineTo(0.398931, 0.761595).lineTo(0.398931, 0.278043).lineTo(0.000000, 0.278043).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.519819, 0.701151).circle(0.060444)
loop2=wp_sketch0.moveTo(0.664885, 0.592352).circle(0.072533)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.218750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
