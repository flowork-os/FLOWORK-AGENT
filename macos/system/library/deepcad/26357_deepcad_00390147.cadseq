# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00390147" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, 0.437500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.213158, 0.000000).circle(0.213158)
loop1=wp_sketch0.moveTo(0.213158, 0.000000).circle(0.128783)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.203125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, 0.437500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.319737, 0.000000).circle(0.319737)
loop3=wp_sketch1.moveTo(0.319737, 0.000000).circle(0.213158)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.164062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, 0.000000, -0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(1.171875, 0.000000).lineTo(1.171875, 0.814145).threePointArc((0.776607, 0.513323), (0.592105, 0.974507)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.093750)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, 0.000000, -0.492188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(1.171875, 0.000000).lineTo(1.171875, 0.123355).lineTo(0.000000, 0.123355).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.484375)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, -0.343750, -0.367188), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch4.moveTo(0.608141, 0.000000).threePointArc((0.664062, 0.055921), (0.608141, 0.111842)).lineTo(0.000000, 0.111842).threePointArc((-0.055921, 0.055921), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop6).extrude(-0.203125)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
