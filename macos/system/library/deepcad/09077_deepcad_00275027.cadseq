import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.010115, 0.000000).threePointArc((1.035112, -0.008742), (1.052796, -0.028454)).threePointArc((1.316389, -0.084024), (1.195066, 0.156497)).lineTo(0.000000, 0.156497).threePointArc((-0.078248, 0.078248), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.597533, 0.071135).circle(0.042681)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
