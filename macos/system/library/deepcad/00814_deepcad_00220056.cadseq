wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013778, -0.033262), (0.047039, -0.047039)).lineTo(0.296711, -0.047039).threePointArc((0.329972, -0.033262), (0.343750, 0.000000)).lineTo(0.343750, 0.246053).threePointArc((0.330722, 0.281124), (0.296711, 0.296711)).lineTo(0.047039, 0.296711).threePointArc((0.013028, 0.281124), (0.000000, 0.246053)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.019023, -0.020597), (0.047039, -0.021711)).lineTo(0.296711, -0.021711).threePointArc((0.310253, -0.014602), (0.314803, 0.000000)).lineTo(0.314803, 0.246053).threePointArc((0.310253, 0.260655), (0.296711, 0.267763)).lineTo(0.047039, 0.267763).threePointArc((0.033497, 0.260655), (0.028947, 0.246053)).lineTo(0.028947, 0.000000).close()
