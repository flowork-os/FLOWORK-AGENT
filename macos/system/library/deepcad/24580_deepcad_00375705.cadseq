# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.316915, 0.059005), (0.000000, 0.118010)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.155099, 0.060691).circle(0.084293)
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.117188)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.047368, 0.000000).lineTo(0.118421, 0.000000).lineTo(0.157895, 0.000000).lineTo(0.213158, 0.000000).lineTo(0.276316, 0.000000).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.118421).lineTo(0.000000, 0.118421).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(0.117188)
