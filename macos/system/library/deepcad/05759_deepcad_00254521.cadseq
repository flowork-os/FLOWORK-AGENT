wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, 0.000000, -0.578125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.049137, -0.118626), (0.167763, -0.167763)).lineTo(0.377467, -0.167763).threePointArc((0.496094, -0.118626), (0.545230, 0.000000)).lineTo(0.545230, 1.160362).threePointArc((0.496094, 1.278988), (0.377467, 1.328125)).lineTo(0.167763, 1.328125).threePointArc((0.049137, 1.278988), (0.000000, 1.160362)).lineTo(0.000000, 0.000000).close()
