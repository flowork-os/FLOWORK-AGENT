# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.039474, 0.000000).lineTo(0.039474, -0.319737).lineTo(0.375000, -0.319737).lineTo(0.375000, 0.209211).lineTo(0.122368, 0.209211).threePointArc((0.086528, 0.122683), (0.000000, 0.086842)).lineTo(0.000000, 0.000000).close()
