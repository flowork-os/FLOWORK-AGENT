# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00349120" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.382812, -0.195312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.382813, 0.000000).lineTo(0.382813, 0.382813).lineTo(0.000000, 0.197451).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.148438, -0.382812, -0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.453125, 0.000000).lineTo(0.453125, 0.200329).lineTo(0.000000, 0.200329).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.296875)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.148438, -0.382812, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.453125, 0.000000).lineTo(0.453125, 0.190789).lineTo(0.000000, 0.190789).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.296875)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.382812, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -0.427555, 0.903989)))
loop3=wp_sketch3.moveTo(0.150000, 0.000000).lineTo(0.150000, 0.331579).lineTo(0.600000, 0.331579).lineTo(0.600000, 0.000000).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.426316).lineTo(0.000000, 0.426316).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.142105, 0.007895).lineTo(0.142105, 0.339474).lineTo(0.607895, 0.339474).lineTo(0.607895, 0.007895).lineTo(0.742105, 0.007895).lineTo(0.742105, 0.426316).lineTo(0.007895, 0.426316).lineTo(0.007895, 0.007895).close()
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.039062)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
