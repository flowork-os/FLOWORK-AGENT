# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.015625, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.003289, 0.000000).lineTo(0.003289, -0.009868).lineTo(0.019737, -0.009868).lineTo(0.035773, -0.009868).lineTo(0.035773, 0.000000).lineTo(0.039062, 0.000000).lineTo(0.039062, 0.003289).lineTo(0.032484, 0.003289).lineTo(0.032484, -0.006579).lineTo(0.019737, -0.006579).lineTo(0.006579, -0.006579).lineTo(0.006579, 0.003289).lineTo(0.000000, 0.003289).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
