# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297781" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.390625, 0.000000).lineTo(1.390625, 0.204934).lineTo(0.000000, 0.204934).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.102467, 0.102467).circle(0.073191)
loop2=wp_sketch0.moveTo(0.702632, 0.190296).circle(0.014638)
loop3=wp_sketch0.moveTo(1.288158, 0.102467).circle(0.073191)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
