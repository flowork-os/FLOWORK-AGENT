import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, -0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.006166, -0.014886), (0.021053, -0.021053)).lineTo(0.478947, -0.021053).threePointArc((0.493834, -0.014886), (0.500000, 0.000000)).lineTo(0.500000, 0.457895).threePointArc((0.493834, 0.472781), (0.478947, 0.478947)).lineTo(0.021053, 0.478947).threePointArc((0.006166, 0.472781), (0.000000, 0.457895)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.008346, -0.009623), (0.021053, -0.010526)).lineTo(0.242105, -0.010526).lineTo(0.252632, -0.010526).lineTo(0.478947, -0.010526).threePointArc((0.486391, -0.007443), (0.489474, 0.000000)).lineTo(0.489474, 0.457895).threePointArc((0.486391, 0.465338), (0.478947, 0.468421)).lineTo(0.252632, 0.468421).lineTo(0.242105, 0.468421).lineTo(0.021053, 0.468421).threePointArc((0.013609, 0.465338), (0.010526, 0.457895)).lineTo(0.010526, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, -0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.lineTo(0.010033, 0.476562).lineTo(0.000000, 0.476562).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
