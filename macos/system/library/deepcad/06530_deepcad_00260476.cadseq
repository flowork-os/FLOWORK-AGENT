# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00260476" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.125000, 0.000000).lineTo(1.125000, 0.568421).lineTo(0.000000, 0.568421).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.142105, 0.378947).circle(0.094737)
loop2=wp_sketch0.moveTo(0.580263, 0.307895).lineTo(0.580263, 0.378947).lineTo(0.580263, 0.450000).lineTo(0.450000, 0.450000).lineTo(0.450000, 0.378947).lineTo(0.450000, 0.307895).close()
loop3=wp_sketch0.moveTo(0.888158, 0.213158).lineTo(0.793421, 0.378947).lineTo(0.698684, 0.213158).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.140625, 0.000000).lineTo(0.140625, 0.071053).lineTo(0.071053, 0.071053).lineTo(0.000000, 0.071053).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop4).extrude(0.382812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.071053, 0.000000).lineTo(0.140625, 0.000000).lineTo(0.140625, 0.071053).lineTo(0.000000, 0.071053).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop5).extrude(0.382812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.094737, 0.000000).circle(0.092763)
solid3=wp_sketch3.add(loop6).extrude(0.382812)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
