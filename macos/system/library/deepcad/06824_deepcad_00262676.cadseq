# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00262676" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.363158).lineTo(0.000000, 0.363158).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.173684, 0.181579).circle(0.023684)
loop2=wp_sketch0.moveTo(0.307895, 0.181579).circle(0.023684)
loop3=wp_sketch0.moveTo(0.442105, 0.181579).circle(0.023684)
loop4=wp_sketch0.moveTo(0.576316, 0.181579).circle(0.023684)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
