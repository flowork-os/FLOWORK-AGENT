loop0=wp_sketch0.moveTo(0.551645, -0.367763).lineTo(0.551645, -1.117434).lineTo(0.792105, -1.117434).lineTo(0.792105, -0.367763).lineTo(1.343750, 0.000000).lineTo(1.343750, 0.268750).lineTo(1.230592, 0.268750).lineTo(1.230592, 0.000000).lineTo(0.792105, -0.297039).lineTo(0.551645, -0.297039).lineTo(0.113158, 0.000000).lineTo(0.113158, 0.268750).lineTo(0.000000, 0.268750).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
