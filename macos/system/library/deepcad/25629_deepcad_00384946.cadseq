loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.016841, 0.082031), (0.000000, 0.164062)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.750000)
