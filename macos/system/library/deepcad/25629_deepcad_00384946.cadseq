# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, -0.054688, 0.750000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.188784, -0.120008), (0.375000, 0.003947)).lineTo(0.375000, 0.165789).threePointArc((0.345643, 0.214258), (0.303947, 0.252632)).lineTo(0.067105, 0.252632).threePointArc((0.028191, 0.217715), (0.000000, 0.173684)).lineTo(0.000000, 0.000000).close()
