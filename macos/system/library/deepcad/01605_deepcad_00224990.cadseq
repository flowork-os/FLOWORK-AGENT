# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00224990" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.546875, -0.161184).threePointArc((0.320598, 0.143914), (0.546875, 0.449013)).lineTo(0.000000, 0.287829).threePointArc((-0.106734, 0.143914), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.040296, 0.143914).circle(0.086349)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.327632, 0.000000).circle(0.327632)
loop3=wp_sketch1.moveTo(0.327632, 0.000000).circle(0.273026)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.156250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
