# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232743" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.000000, -0.601562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.088158, -0.154276).lineTo(0.330592, -0.154276).lineTo(0.451809, -0.022039).lineTo(0.451809, 0.749342).lineTo(0.330592, 1.046875).lineTo(0.121217, 1.046875).lineTo(0.000000, 0.749342).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.220395, 0.826480).circle(0.077138)
loop2=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.187336, -0.110197), (0.297533, 0.077138)).lineTo(0.297533, 0.451809).threePointArc((0.225905, 0.380181), (0.154276, 0.451809)).lineTo(0.154276, 0.077138).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.226562, 0.085938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.073684, 0.000000).lineTo(0.073684, 0.500000).lineTo(0.000000, 0.500000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.375000, both=True)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
