# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00228874" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.507812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.476562, 0.000000).lineTo(1.476562, 0.994737).lineTo(0.000000, 0.994737).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.652796, 0.015543).lineTo(0.652796, 0.481826).lineTo(0.015543, 0.481826).lineTo(0.015543, 0.015543).close()
loop2=wp_sketch0.moveTo(0.652796, 0.497368).lineTo(0.652796, 0.979194).lineTo(0.015543, 0.979194).lineTo(0.015543, 0.497368).close()
loop3=wp_sketch0.moveTo(1.461020, 0.015543).lineTo(1.461020, 0.481826).lineTo(0.668339, 0.481826).lineTo(0.668339, 0.015543).close()
loop4=wp_sketch0.moveTo(1.461020, 0.497368).lineTo(1.461020, 0.979194).lineTo(0.668339, 0.979194).lineTo(0.668339, 0.497368).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.507812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(1.484375, 0.000000).lineTo(1.484375, 0.984375).lineTo(0.000000, 0.984375).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch1.moveTo(0.656250, 0.015625).lineTo(0.656250, 0.484375).lineTo(0.015625, 0.484375).lineTo(0.015625, 0.015625).close()
solid1=wp_sketch1.add(loop5).add(loop6).extrude(-0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, -0.484375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch2.moveTo(0.632812, 0.000000).lineTo(0.632812, 0.472944).lineTo(0.000000, 0.472944).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop7).extrude(-0.015625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
