import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.051727).threePointArc((-0.066698, 0.212751), (0.094326, 0.146053)).lineTo(0.146053, 0.146053).threePointArc((0.113837, 0.235402), (0.033470, 0.286020)).lineTo(0.000000, 0.289062).threePointArc((-0.144531, 0.144531), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.032566, 0.004441).threePointArc((0.110489, 0.053574), (0.140625, 0.140625)).lineTo(0.090296, 0.140625).threePointArc((0.063849, 0.076776), (0.000000, 0.050329)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.132812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.037007, 0.000000).threePointArc((0.046762, 0.023551), (0.070312, 0.033306)).lineTo(0.070312, 0.070312).threePointArc((0.020594, 0.049718), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.070312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
