import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.656250, -0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.473764, -0.639554), (1.070312, -0.112664)).threePointArc((0.940679, 0.144009), (0.653454, 0.157730)).threePointArc((0.490090, 0.117873), (0.326727, 0.157730)).threePointArc((0.123666, 0.161095), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.440491, -0.613196), (1.059046, -0.180263)).threePointArc((1.033990, -0.050988), (0.912582, 0.000000)).threePointArc((0.805551, 0.003942), (0.698520, 0.000000)).lineTo(0.405592, 0.022533).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
