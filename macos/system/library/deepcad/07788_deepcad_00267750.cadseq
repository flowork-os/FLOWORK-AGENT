wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001301, -0.003140), (0.004441, -0.004441)).lineTo(0.065872, -0.004441).threePointArc((0.069012, -0.003140), (0.070312, 0.000000)).lineTo(0.070312, 0.061431).threePointArc((0.069012, 0.064571), (0.065872, 0.065872)).lineTo(0.004441, 0.065872).threePointArc((0.001301, 0.064571), (0.000000, 0.061431)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002067, -0.001290), (0.004441, -0.000740)).lineTo(0.065872, -0.000740).threePointArc((0.066395, -0.000523), (0.066612, 0.000000)).lineTo(0.066612, 0.061431).threePointArc((0.066395, 0.061954), (0.065872, 0.062171)).lineTo(0.004441, 0.062171).threePointArc((0.003917, 0.061954), (0.003701, 0.061431)).lineTo(0.003701, 0.000000).close()
