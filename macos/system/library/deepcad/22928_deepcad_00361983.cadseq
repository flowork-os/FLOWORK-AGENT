# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00361983" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.000000, 0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.076863, -1.221081), (0.269408, -0.012829)).threePointArc((0.141869, 0.144054), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.128289, 0.012829).circle(0.076974)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.145395, 0.000000).lineTo(0.352303, 0.000000).lineTo(0.492105, 0.000000).lineTo(0.525658, 0.000000).lineTo(0.531250, 0.195724).lineTo(0.000000, 0.195724).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.093750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, -0.171875, -0.476562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.200658, 0.000000).lineTo(0.200658, 0.476562).lineTo(0.000000, 0.476562).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.093750)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
