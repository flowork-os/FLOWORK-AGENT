# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00276865" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.453125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.009211, 0.000000).circle(0.009211)
loop1=wp_sketch0.moveTo(0.101316, -0.023684).threePointArc((0.125000, 0.000000), (0.101316, 0.023684)).lineTo(0.071053, 0.023684).lineTo(0.071053, 0.015789).lineTo(0.040789, 0.015789).lineTo(0.040789, 0.023684).lineTo(0.009211, 0.023684).threePointArc((0.032895, 0.000000), (0.009211, -0.023684)).close()
loop2=wp_sketch0.moveTo(0.101316, 0.000000).circle(0.009211)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.390625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
