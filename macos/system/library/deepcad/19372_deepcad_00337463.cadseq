# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00337463" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.055510, -0.024671).threePointArc((0.201707, -0.579813), (0.388569, -0.037007)).lineTo(0.431743, -0.006168).lineTo(0.370066, 0.043174).lineTo(0.407072, 0.092516).threePointArc((0.212593, 0.292740), (0.024671, 0.086349)).lineTo(0.055510, 0.030839).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, -0.445312, 0.093750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.134211, 0.000000).circle(0.134211)
solid1=wp_sketch1.add(loop1).extrude(0.093750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
