# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284927" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.213158, 0.000000).circle(0.213158)
loop1=wp_sketch0.moveTo(0.213158, 0.000000).circle(0.159868)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.320312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.046875, 0.110197).threePointArc((0.931370, 0.214885), (1.046875, 0.319572)).lineTo(0.000000, 0.418750).threePointArc((0.189766, 0.209375), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.716283, 0.154276).threePointArc((0.771382, 0.209375), (0.716283, 0.264474)).lineTo(0.297533, 0.264474).threePointArc((0.242434, 0.209375), (0.297533, 0.154276)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.210938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.539062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.106579, 0.000000).circle(0.104359)
loop5=wp_sketch2.moveTo(0.106579, 0.000000).circle(0.053289)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.265625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
