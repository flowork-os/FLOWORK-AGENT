import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, -0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.032999, -0.079666), (0.112664, -0.112664)).lineTo(0.968914, -0.112664).threePointArc((1.042947, -0.077332), (1.070312, 0.000000)).lineTo(1.070312, 0.428125).lineTo(0.000000, 0.428125).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.218750, 0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.055263, 0.000000).circle(0.054112)
solid1=wp_sketch1.add(loop1).extrude(-0.109375)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.375000, -0.218750, 0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.055263, 0.000000).circle(0.054112)
solid2=wp_sketch2.add(loop2).extrude(-0.109375)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.375000, 0.031250, 0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.055263, 0.000000).circle(0.054112)
solid3=wp_sketch3.add(loop3).extrude(-0.109375)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.164062, 0.187500, 0.109375), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.640625, 0.000000).lineTo(0.640625, 0.424836).threePointArc((0.428207, 0.212418), (0.215789, 0.424836)).lineTo(0.215789, 0.215789).threePointArc((0.152586, 0.063203), (0.000000, 0.000000)).close()
loop5=wp_sketch4.moveTo(0.424836, 0.424836).circle(0.107895)
solid4=wp_sketch4.add(loop4).add(loop5).extrude(-0.210938)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
