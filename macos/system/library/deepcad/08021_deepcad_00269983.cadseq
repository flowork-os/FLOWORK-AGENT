# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00269983" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.218750, 0.000000).lineTo(0.218750, 0.218750).lineTo(0.000000, 0.218750).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.578125, 0.000000).lineTo(0.578125, 0.328618).lineTo(0.000000, 0.328618).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.395559, 0.054770).lineTo(0.395559, 0.273849).lineTo(0.182566, 0.273849).lineTo(0.182566, 0.054770).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.632812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.142105, -0.173684).lineTo(1.357895, -0.173684).lineTo(1.500000, 0.000000).lineTo(1.436842, 0.331579).threePointArc((1.357895, 0.396369), (1.278947, 0.331579)).threePointArc((1.041559, 0.196193), (0.773684, 0.142105)).lineTo(0.773684, 0.126316).lineTo(0.726316, 0.126316).lineTo(0.726316, 0.142105).threePointArc((0.458441, 0.196193), (0.221053, 0.331579)).threePointArc((0.142105, 0.396369), (0.063158, 0.331579)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.632812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, -0.273438, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch3.moveTo(0.484375, 0.000000).lineTo(0.484375, 0.086678).lineTo(0.000000, 0.086678).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(-0.281250)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
