# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00260366" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, -0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.762007, 0.000000).threePointArc((0.881892, 0.107312), (0.780592, 0.232319)).lineTo(0.000000, 0.232319).threePointArc((-0.116160, 0.116160), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.074342, 0.120806).circle(0.065049)
loop2=wp_sketch0.moveTo(0.734128, 0.120806).circle(0.065049)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
