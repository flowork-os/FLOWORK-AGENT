wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.710526, 0.000000).lineTo(0.710526, 0.023684).lineTo(0.750000, 0.055263).lineTo(0.750000, 0.402632).lineTo(0.710526, 0.426316).lineTo(0.710526, 0.552632).lineTo(0.686842, 0.568421).lineTo(0.000000, 0.568421).lineTo(0.000000, 0.000000).close()
