# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00312307" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.437829, 0.000000).threePointArc((1.468750, 0.030921), (1.437829, 0.061842)).lineTo(0.000000, 0.061842).threePointArc((-0.030921, 0.030921), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.030921).circle(0.015461)
loop2=wp_sketch0.moveTo(1.437829, 0.030921).circle(0.015461)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
