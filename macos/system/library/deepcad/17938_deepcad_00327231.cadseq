# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.507812, -0.398438, 0.296875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.107319, -0.107319), (0.214638, 0.000000)).lineTo(0.214638, 0.453125).lineTo(0.000000, 0.453125).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(-0.039062)
