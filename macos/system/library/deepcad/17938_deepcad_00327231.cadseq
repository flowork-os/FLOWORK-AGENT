# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, -0.539062, 0.351562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.008388, 0.008388).threePointArc((0.169860, -0.161472), (0.339720, 0.000000)).lineTo(0.339720, 0.398438).lineTo(0.000000, 0.398438).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.039062)
