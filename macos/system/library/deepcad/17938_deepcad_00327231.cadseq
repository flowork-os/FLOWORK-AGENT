loop2=wp_sketch1.moveTo(0.987336, 0.022697).lineTo(0.987336, 0.419901).lineTo(0.964638, 0.419901).lineTo(0.964638, 0.544737).lineTo(0.964638, 0.658224).lineTo(0.987336, 0.658224).lineTo(0.987336, 1.055428).lineTo(0.022697, 1.055428).lineTo(0.022697, 0.658224).lineTo(0.045395, 0.658224).lineTo(0.045395, 0.544737).lineTo(0.045395, 0.419901).lineTo(0.022697, 0.419901).lineTo(0.022697, 0.022697).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.750000)
