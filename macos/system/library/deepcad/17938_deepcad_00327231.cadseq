wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, -0.507812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.958799, 0.000000).lineTo(0.958799, 0.398602).lineTo(0.937253, 0.398602).lineTo(0.937253, 0.517105).lineTo(0.937253, 0.624836).lineTo(0.958799, 0.624836).lineTo(0.958799, 1.023438).lineTo(0.000000, 1.023438).lineTo(0.000000, 0.624836).lineTo(0.010773, 0.624836).lineTo(0.010773, 0.517105).lineTo(0.010773, 0.398602).lineTo(0.000000, 0.398602).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
