# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.079510, -0.040335), (0.051809, 0.044408)).lineTo(0.088816, 0.481086).threePointArc((0.103618, 0.614565), (0.118421, 0.481086)).lineTo(0.155428, 0.044408).threePointArc((0.131428, -0.049269), (0.214638, 0.000000)).lineTo(0.177632, 0.451480).threePointArc((0.107319, 0.711760), (0.037007, 0.451480)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.734375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
