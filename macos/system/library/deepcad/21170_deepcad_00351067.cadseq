# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00351067" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.678947, 0.000000).circle(0.678947)
loop1=wp_sketch0.moveTo(0.070724, 0.000000).circle(0.014145)
loop2=wp_sketch0.moveTo(0.678947, -0.537500).circle(0.014145)
loop3=wp_sketch0.moveTo(0.678947, 0.537500).circle(0.014145)
loop4=wp_sketch0.moveTo(1.273026, 0.000000).circle(0.014145)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.460938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.426316, -0.205263).threePointArc((0.750000, -0.277949), (1.073684, -0.205263)).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.457895).lineTo(1.500000, 0.915789).lineTo(1.073684, 1.136842).threePointArc((0.750000, 1.209528), (0.426316, 1.136842)).lineTo(0.000000, 0.931579).lineTo(0.000000, 0.457895).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.023438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
