# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00374191" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, -0.304688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.817434, 0.000000).threePointArc((1.093750, 0.276316), (0.817434, 0.552632)).lineTo(0.000000, 0.552632).threePointArc((-0.276316, 0.276316), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.011513, 0.276316).circle(0.080592)
loop2=wp_sketch0.moveTo(0.402961, 0.276316).circle(0.080592)
loop3=wp_sketch0.moveTo(0.805921, 0.276316).circle(0.080592)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
