# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00374190" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, -0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.046053, 0.000000).threePointArc((1.242188, 0.196135), (1.046053, 0.392270)).lineTo(0.000000, 0.392270).threePointArc((-0.196135, 0.196135), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.013076, 0.196135).circle(0.065378)
loop2=wp_sketch0.moveTo(1.046053, 0.196135).circle(0.065378)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
