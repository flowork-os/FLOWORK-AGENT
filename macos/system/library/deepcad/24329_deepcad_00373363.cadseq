import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, 0.000000, -0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.025822, 0.000000).threePointArc((1.258964, 0.233141), (1.025822, 0.466283)).lineTo(0.000000, 0.466283).threePointArc((-0.233141, 0.233141), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(1.025822, 0.053289).threePointArc((1.212336, 0.239803), (1.025822, 0.426316)).lineTo(0.000000, 0.426316).threePointArc((-0.186513, 0.239803), (0.000000, 0.053289)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.187500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
