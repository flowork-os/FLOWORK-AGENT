# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00344344" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.106579, 0.000000).circle(0.106579)
loop1=wp_sketch0.moveTo(0.106579, 0.000000).circle(0.099918)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.066406, 0.025149), (0.132812, 0.000000)).lineTo(0.132812, 0.079687).threePointArc((0.066406, 0.093321), (0.000000, 0.079687)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.046875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.039062, 0.000000).lineTo(0.039062, 0.030428).lineTo(0.000000, 0.030428).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.109375)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.046875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.039062, 0.000000).lineTo(0.039062, 0.030428).lineTo(0.000000, 0.030428).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.109375)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.101562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.037418, 0.000000).lineTo(0.037418, 0.101562).lineTo(0.000000, 0.101562).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(-0.109375)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.101562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch5.moveTo(0.037418, 0.000000).lineTo(0.037418, 0.101562).lineTo(0.000000, 0.101562).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop6).extrude(0.109375)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
