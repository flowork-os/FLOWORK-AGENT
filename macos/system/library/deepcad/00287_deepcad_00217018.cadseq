# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00217018" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.035855, -0.250987).lineTo(0.815707, -0.250987).lineTo(0.851562, 0.000000).lineTo(0.681250, 0.600576).lineTo(0.430263, 0.600576).lineTo(0.170313, 0.600576).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.098602, -0.089638).circle(0.062747)
loop2=wp_sketch0.moveTo(0.430263, 0.412336).circle(0.089638)
loop3=wp_sketch0.moveTo(0.752961, -0.089638).circle(0.062747)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.067105, 0.000000).circle(0.065707)
solid1=wp_sketch1.add(loop4).extrude(0.257812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.067105, 0.000000).circle(0.065707)
solid2=wp_sketch2.add(loop5).extrude(0.257812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
