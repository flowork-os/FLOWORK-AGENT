import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.678947).lineTo(0.000000, 0.678947).lineTo(0.000000, 0.300000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.710526, 0.063158).lineTo(0.710526, 0.300000).lineTo(0.063158, 0.300000).lineTo(0.063158, 0.063158).close()
loop2=wp_sketch0.moveTo(0.710526, 0.378947).lineTo(0.710526, 0.615789).lineTo(0.063158, 0.615789).lineTo(0.063158, 0.378947).close()
loop3=wp_sketch0.moveTo(1.436842, 0.063158).lineTo(1.436842, 0.300000).lineTo(0.789474, 0.300000).lineTo(0.789474, 0.063158).close()
loop4=wp_sketch0.moveTo(1.436842, 0.378947).lineTo(1.436842, 0.615789).lineTo(0.789474, 0.615789).lineTo(0.789474, 0.378947).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.007812, 0.031250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.023438, 0.000000).lineTo(0.023438, 0.023438).lineTo(0.000000, 0.023438).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.710938, -0.007812, 0.031250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.023438, 0.000000).lineTo(0.023438, 0.023438).lineTo(0.000000, 0.023438).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(0.007812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, -0.007812, 0.031250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch3.moveTo(0.023438, 0.000000).lineTo(0.023438, 0.023438).lineTo(0.000000, 0.023438).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop7).extrude(0.007812)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
