import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, -0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.448437, -0.083493), (0.896875, 0.000000)).lineTo(0.896875, 0.951562).threePointArc((0.448437, 1.035055), (0.000000, 0.951562)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.098437, 0.295312).lineTo(0.098437, 0.667187).lineTo(0.054688, 0.667187).lineTo(0.054688, 0.295312).close()
loop2=wp_sketch0.moveTo(0.842187, 0.295312).lineTo(0.842187, 0.667187).lineTo(0.809375, 0.667187).lineTo(0.809375, 0.295312).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
