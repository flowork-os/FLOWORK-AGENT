# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00255094" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.734211, 0.000000).threePointArc((0.745375, 0.004625), (0.750000, 0.015789)).lineTo(0.750000, 0.063158).threePointArc((0.745375, 0.074323), (0.734211, 0.078947)).lineTo(0.000000, 0.078947).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.055263, 0.039474).circle(0.015789)
loop2=wp_sketch0.moveTo(0.710526, 0.039474).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.023438, -0.726562, 0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.035526, 0.000000).circle(0.035526)
loop4=wp_sketch1.moveTo(0.035526, 0.000000).circle(0.014063)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.054688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.023438, -0.593750, 0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.011842, 0.000000).circle(0.011595)
solid2=wp_sketch2.add(loop5).extrude(-0.054688)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
