# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00323189" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, 0.585938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.098026, -0.171546).threePointArc((0.456594, -0.332108), (0.416612, -0.722944)).lineTo(0.661678, -1.164062).lineTo(0.992516, -1.164062).lineTo(0.992516, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.335938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.585938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.164062, 0.000000).lineTo(0.906743, 0.441118).threePointArc((0.372145, 0.504911), (0.600411, 0.992516)).lineTo(0.502385, 1.164062).lineTo(0.000000, 1.164062).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.664062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
