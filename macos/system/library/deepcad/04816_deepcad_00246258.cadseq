# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00246258" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.366118, 0.000000).lineTo(0.366118, 0.828125).lineTo(0.000000, 0.828125).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.244079, 0.575329).lineTo(0.244079, 0.740954).lineTo(0.122039, 0.740954).lineTo(0.122039, 0.575329).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.539062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.367188, 0.000000).lineTo(0.367188, 0.050247).lineTo(0.000000, 0.050247).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.038651, 0.023191).circle(0.019326)
loop4=wp_sketch1.moveTo(0.328536, 0.023191).circle(0.019326)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.468750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch2.moveTo(0.367188, 0.000000).lineTo(0.367188, 0.050247).lineTo(0.000000, 0.050247).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch2.moveTo(0.038651, 0.023191).circle(0.019326)
loop7=wp_sketch2.moveTo(0.328536, 0.023191).circle(0.019326)
solid2=wp_sketch2.add(loop5).add(loop6).add(loop7).extrude(0.007812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
