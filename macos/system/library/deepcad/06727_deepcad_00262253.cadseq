# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00262253" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.757895).lineTo(0.000000, 0.757895).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.078947, 0.663158).threePointArc((0.056618, 0.717067), (0.110526, 0.694737)).lineTo(1.389474, 0.694737).threePointArc((1.443382, 0.717067), (1.421053, 0.663158)).lineTo(1.421053, 0.078947).threePointArc((1.424323, 0.032933), (1.389474, 0.063158)).lineTo(0.110526, 0.063158).threePointArc((0.075677, 0.032933), (0.078947, 0.078947)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.187500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
