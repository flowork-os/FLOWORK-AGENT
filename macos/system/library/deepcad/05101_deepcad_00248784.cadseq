import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.071053, 0.000000).lineTo(0.071053, -0.260526).lineTo(0.489474, -0.260526).lineTo(0.489474, -0.331579).lineTo(0.750000, -0.331579).lineTo(0.750000, -0.086842).lineTo(0.205263, 0.063158).lineTo(0.000000, 0.063158).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.623684, -0.205263).circle(0.055263)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.070312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.414062, 0.000000).lineTo(0.414062, 0.069737).lineTo(0.000000, 0.069737).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.070312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.070724, 0.000000).lineTo(0.070724, 0.070724).lineTo(0.070724, 0.335938).lineTo(0.000000, 0.335938).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.070312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.218750, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.222780, 0.000000).lineTo(0.222780, 0.335938).lineTo(0.109622, 0.335938).lineTo(0.000000, 0.144984).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.070312)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.070312, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.414062, 0.217928).lineTo(0.000000, 0.217928).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(0.070312)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
