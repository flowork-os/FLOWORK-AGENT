# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, -0.617188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((1.149510, 0.388761), (0.431743, 1.367188)).lineTo(0.431743, 0.863487).threePointArc((0.431655, 0.849095), (0.431743, 0.834704)).lineTo(0.431743, 0.618832).lineTo(0.331003, 0.474918).threePointArc((0.284213, 0.407372), (0.230263, 0.345395)).lineTo(0.000000, 0.000000).close()
