# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.328125, 0.000000, -0.039062), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.327632, 0.000000).circle(0.327632)
