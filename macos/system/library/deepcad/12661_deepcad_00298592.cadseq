loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.070312, -0.070312), (0.140625, 0.000000)).lineTo(0.140625, 0.096217).threePointArc((0.070312, 0.091031), (0.000000, 0.096217)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.071053, 0.000000).circle(0.047368)
