wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.117188, 0.000000, 0.476562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.329744, -0.279208), (0.312500, -0.710938)).threePointArc((0.320312, -0.712894), (0.328125, -0.710938)).lineTo(0.359375, -0.742188).lineTo(0.632812, -0.437500).lineTo(0.351562, -0.187500).threePointArc((0.291098, -0.138877), (0.234375, -0.085938)).threePointArc((0.122487, -0.028515), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.304688)
solid=solid0
# workplane for sketch 1
