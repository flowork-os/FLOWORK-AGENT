import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, -0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.397697, 0.000000).threePointArc((0.194572, 0.203125), (0.397697, 0.406250)).lineTo(0.000000, 0.406250).threePointArc((-0.203125, 0.203125), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.205263).circle(0.059868)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.004276, 0.000000).threePointArc((0.204924, 0.203125), (0.004276, 0.406250)).lineTo(0.000000, 0.406250).threePointArc((-0.203125, 0.203125), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.000000, 0.205263).circle(0.119737)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.234375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.552632, 0.007895).threePointArc((0.750000, 0.205263), (0.552632, 0.402632)).lineTo(0.000000, 0.402632).threePointArc((0.198860, 0.201316), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.552632, 0.110526).threePointArc((0.647368, 0.205263), (0.552632, 0.300000)).lineTo(0.371053, 0.300000).threePointArc((0.276316, 0.205263), (0.371053, 0.110526)).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.117188)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.122368, 0.000000).circle(0.119819)
loop7=wp_sketch3.moveTo(0.122368, 0.000000).circle(0.081579)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.203125)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
