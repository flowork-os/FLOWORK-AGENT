# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00315591" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.070312, 0.000000).lineTo(0.687253, 0.664720).threePointArc((0.535156, 0.752119), (0.383059, 0.664720)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.540789, 0.574589).circle(0.078865)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.359375, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
