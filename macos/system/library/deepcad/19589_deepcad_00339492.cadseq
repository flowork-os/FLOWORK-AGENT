# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00339492" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.578125, -0.101562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.148438, 0.000000).lineTo(1.148438, 0.205510).lineTo(1.148438, 0.846217).lineTo(1.051727, 0.846217).lineTo(1.051727, 0.205510).lineTo(0.145066, 0.205510).lineTo(0.145066, 0.519819).lineTo(0.000000, 0.519819).lineTo(0.000000, 0.205510).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.375000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.546875, 0.453125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.064145, 0.000000).lineTo(0.064145, 0.203125).lineTo(0.000000, 0.203125).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.038487, 0.025658).lineTo(0.038487, 0.177467).lineTo(0.025658, 0.177467).lineTo(0.025658, 0.025658).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.250000, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.203125, -0.484375, 0.476562), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.398438, 0.000000).lineTo(0.398438, 0.150987).lineTo(0.000000, 0.150987).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.046875)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
