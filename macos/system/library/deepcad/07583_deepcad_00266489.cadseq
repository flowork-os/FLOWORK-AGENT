import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.071382, 0.000000).lineTo(0.071382, -0.132566).lineTo(0.412993, -0.132566).lineTo(0.412993, 0.000000).lineTo(0.484375, 0.000000).lineTo(0.484375, 0.219243).lineTo(0.000000, 0.219243).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.025493, 0.025493).circle(0.005099)
loop2=wp_sketch0.moveTo(0.025493, 0.193750).circle(0.005099)
loop3=wp_sketch0.moveTo(0.117270, 0.045888).lineTo(0.117270, -0.086678).lineTo(0.367105, -0.086678).lineTo(0.367105, 0.045888).lineTo(0.438487, 0.045888).lineTo(0.438487, 0.168257).lineTo(0.045888, 0.168257).lineTo(0.045888, 0.045888).close()
loop4=wp_sketch0.moveTo(0.458882, 0.025493).circle(0.005099)
loop5=wp_sketch0.moveTo(0.458882, 0.193750).circle(0.005099)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch1.moveTo(0.071382, 0.000000).lineTo(0.071382, -0.132566).lineTo(0.412993, -0.132566).lineTo(0.412993, 0.000000).lineTo(0.484375, 0.000000).lineTo(0.484375, 0.219243).lineTo(0.000000, 0.219243).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch1.moveTo(0.025493, 0.025493).circle(0.005099)
loop8=wp_sketch1.moveTo(0.025493, 0.193750).circle(0.005099)
loop9=wp_sketch1.moveTo(0.117270, 0.045888).lineTo(0.117270, -0.086678).lineTo(0.367105, -0.086678).lineTo(0.367105, 0.045888).lineTo(0.438487, 0.045888).lineTo(0.438487, 0.168257).lineTo(0.045888, 0.168257).lineTo(0.045888, 0.045888).close()
loop10=wp_sketch1.moveTo(0.458882, 0.025493).circle(0.005099)
loop11=wp_sketch1.moveTo(0.458882, 0.193750).circle(0.005099)
solid1=wp_sketch1.add(loop6).add(loop7).add(loop8).add(loop9).add(loop10).add(loop11).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
