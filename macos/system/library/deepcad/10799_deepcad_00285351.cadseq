# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285351" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.390625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.023684, 0.000000).circle(0.023684)
loop1=wp_sketch0.moveTo(0.023684, 0.000000).circle(0.017763)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.390625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.011842, 0.000000).circle(0.011595)
loop3=wp_sketch1.moveTo(0.011842, 0.000000).circle(0.005921)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.109375, 0.011513).threePointArc((0.097307, 0.022451), (0.109375, 0.033388)).lineTo(0.000000, 0.043750).threePointArc((0.019826, 0.021875), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.074836, 0.016118).threePointArc((0.069079, 0.021875), (0.074836, 0.027632)).lineTo(0.031086, 0.027632).threePointArc((0.025329, 0.021875), (0.031086, 0.016118)).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.031250)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.109375, 0.011513).threePointArc((0.097307, 0.022451), (0.109375, 0.033388)).lineTo(0.000000, 0.043750).threePointArc((0.019826, 0.021875), (0.000000, 0.000000)).close()
loop7=wp_sketch3.moveTo(0.074836, 0.016118).threePointArc((0.069079, 0.021875), (0.074836, 0.027632)).lineTo(0.031086, 0.027632).threePointArc((0.025329, 0.021875), (0.031086, 0.016118)).close()
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.007812)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
