# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00315533" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.071053, 0.000000).circle(0.071053)
solid0=wp_sketch0.add(loop0).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.351562, -0.523438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.352632, 0.000000).lineTo(0.352632, 1.046875).lineTo(0.000000, 1.046875).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.198355, 0.947697).circle(0.066118)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.117188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.352632, 0.000000).lineTo(0.352632, 1.046875).lineTo(0.000000, 1.046875).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.165296, 0.958717).circle(0.066118)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.117188)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
