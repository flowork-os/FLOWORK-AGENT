# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00328074" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, 0.695312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.343750, 0.000000).lineTo(0.343750, 0.054276).lineTo(0.000000, 0.054276).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, 0.000000, -0.695312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.702632, 0.000000).lineTo(0.702632, 1.390625).lineTo(0.526974, 1.390625).lineTo(0.175658, 1.390625).lineTo(0.000000, 1.390625).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.351316, 0.278125).circle(0.219572)
loop3=wp_sketch1.moveTo(0.497697, 0.600164).lineTo(0.497697, 1.273520).lineTo(0.204934, 1.273520).lineTo(0.204934, 0.600164).close()
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.054688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
