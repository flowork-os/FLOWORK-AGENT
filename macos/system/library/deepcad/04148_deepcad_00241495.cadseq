# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00241495" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.409539, -0.409539).lineTo(0.887336, -0.409539).lineTo(1.296875, 0.000000).lineTo(1.296875, 0.341283).lineTo(0.000000, 0.341283).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.204770, 0.163816).circle(0.095559)
loop2=wp_sketch0.moveTo(1.092105, 0.163816).circle(0.095559)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.000000, 0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.000000, -0.406332).lineTo(0.476562, -0.406332).lineTo(0.476562, -0.135444).lineTo(0.155510, -0.135444).lineTo(0.155510, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.507812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.000000, 0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.155510, 0.000000).lineTo(0.155510, 0.105345).lineTo(0.476562, 0.105345).lineTo(0.476562, 0.205674).lineTo(0.000000, 0.205674).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.343750)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
