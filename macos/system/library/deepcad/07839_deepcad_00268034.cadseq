# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00268034" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.300000, 0.000000).lineTo(0.300000, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.213158, 0.197368).lineTo(0.213158, 0.576316).lineTo(0.078947, 0.576316).lineTo(0.078947, 0.197368).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.023438, 0.078125, 0.062500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.625000).lineTo(0.000000, 0.625000).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.190789, 0.125000).lineTo(0.190789, 0.500000).lineTo(0.052632, 0.500000).lineTo(0.052632, 0.125000).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.039062)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.296875, 0.000000).lineTo(0.296875, 0.062500).lineTo(0.000000, 0.062500).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.250000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
