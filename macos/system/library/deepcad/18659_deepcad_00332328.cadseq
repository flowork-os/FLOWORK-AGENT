import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, -0.695312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.017342, -0.041868), (0.059211, -0.059211)).lineTo(0.133224, -0.059211).threePointArc((0.167691, -0.038802), (0.177632, 0.000000)).lineTo(0.177632, 1.347039).threePointArc((0.167691, 1.385842), (0.133224, 1.406250)).lineTo(0.059211, 1.406250).threePointArc((0.017342, 1.388908), (0.000000, 1.347039)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.088816, 0.000000).circle(0.044408)
loop2=wp_sketch0.moveTo(0.088816, 0.680921).circle(0.044408)
loop3=wp_sketch0.moveTo(0.088816, 1.347039).circle(0.044408)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.234375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, -0.234375, 0.273438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.131307, 0.164062), (0.000000, 0.328125)).lineTo(0.000000, 0.162336).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop4).extrude(-0.460938)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, -0.234375, -0.640625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.131307, 0.164062), (0.000000, 0.328125)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop5).extrude(-0.460938)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
