# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.000000, 0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.296875, 0.000000).lineTo(1.296875, 0.109211).lineTo(1.214967, 0.109211).threePointArc((1.126234, 0.020477), (1.037500, 0.109211)).lineTo(0.259375, 0.109211).threePointArc((0.170641, 0.020477), (0.081908, 0.109211)).lineTo(0.000000, 0.109211).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.265625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
