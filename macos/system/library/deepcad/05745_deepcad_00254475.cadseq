# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00254475" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.000000, -0.312500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.031505, -0.076060), (0.107566, -0.107566)).lineTo(0.618503, -0.107566).lineTo(0.618503, 0.851562).lineTo(0.107566, 0.851562).threePointArc((0.031505, 0.820057), (0.000000, 0.743997)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.107566, 0.000000).circle(0.035855)
loop2=wp_sketch0.moveTo(0.107566, 0.743997).circle(0.035855)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
