wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.703125, -0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch4.moveTo(0.046875, 0.000000).lineTo(0.046875, 0.742188).lineTo(0.000000, 0.742188).lineTo(0.000000, 0.695312).lineTo(0.000000, 0.046875).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop7).extrude(0.046875)
