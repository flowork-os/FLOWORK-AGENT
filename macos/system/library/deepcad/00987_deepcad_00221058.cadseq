# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, -0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(1.414062, 0.000000).lineTo(1.414062, 0.044655).lineTo(0.000000, 0.044655).lineTo(0.000000, 0.000000).close()
