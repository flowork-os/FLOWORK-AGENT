# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00374465" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.126316).lineTo(0.000000, 0.126316).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.273438, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.201316, 0.000000).threePointArc((0.313699, 0.187500), (0.201316, 0.375000)).lineTo(0.000000, 0.375000).threePointArc((-0.112383, 0.187500), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.039062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.210938, 0.000000, 0.125000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.328125, 0.000000).threePointArc((0.164062, 0.062132), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(-0.125000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.210938, -0.375000, 0.125000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.164062, -0.062132), (0.328125, 0.000000)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.125000)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.250000, -0.187500, 0.125000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.126316, 0.000000).circle(0.126316)
solid4=wp_sketch4.add(loop4).extrude(-0.312500)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.273438, -0.375000, -0.039062), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop5=wp_sketch5.moveTo(0.203125, 0.000000).threePointArc((0.101562, 0.025440), (0.000000, 0.000000)).close()
solid5=wp_sketch5.add(loop5).extrude(-0.039062)
solid=solid.union(solid5)
# workplane for sketch 6
wp_sketch6 = cq.Workplane(cq.Plane(cq.Vector(0.273438, 0.000000, -0.039062), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop6=wp_sketch6.moveTo(0.000000, 0.000000).threePointArc((0.101562, -0.025440), (0.203125, 0.000000)).lineTo(0.000000, 0.000000).close()
solid6=wp_sketch6.add(loop6).extrude(-0.039062)
solid=solid.union(solid6)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
