# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288531" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.757895, 0.236842).lineTo(1.200000, 0.489474).lineTo(1.200000, 1.010526).lineTo(0.757895, 1.263158).lineTo(0.300000, 1.010526).lineTo(0.300000, 0.489474).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.453125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, -0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.453947, -0.255345).lineTo(0.898438, 0.000000).lineTo(0.898438, 0.520148).lineTo(0.453947, 0.775493).lineTo(0.000000, 0.520148).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.453947, 0.255345).circle(0.236431)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.148438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
