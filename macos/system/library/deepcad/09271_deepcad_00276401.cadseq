# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00276401" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.157895, 0.000000).lineTo(0.157895, 0.312500).lineTo(0.000000, 0.312500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.078947, 0.055921).circle(0.016447)
loop2=wp_sketch0.moveTo(0.078947, 0.246711).circle(0.016447)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.328125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.155428, 0.000000).lineTo(0.155428, 0.421875).lineTo(0.000000, 0.421875).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.079934, 0.097697).circle(0.017763)
loop5=wp_sketch1.moveTo(0.079934, 0.364145).circle(0.017763)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.140625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
