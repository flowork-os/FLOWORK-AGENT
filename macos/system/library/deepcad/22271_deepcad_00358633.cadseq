# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00358633" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.348684, 0.000000).lineTo(0.348684, -0.263158).lineTo(0.625000, -0.263158).lineTo(0.625000, 0.618421).lineTo(0.348684, 0.618421).lineTo(0.348684, 0.355263).lineTo(0.000000, 0.355263).lineTo(0.000000, 0.190789).lineTo(0.210526, 0.190789).threePointArc((0.405176, 0.177632), (0.210526, 0.164474)).lineTo(0.000000, 0.164474).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, -0.078125, 0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.067105, 0.000000).circle(0.065707)
solid1=wp_sketch1.add(loop1).extrude(-0.078125)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, -0.078125, 0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.067105, 0.000000).circle(0.065707)
solid2=wp_sketch2.add(loop2).extrude(-0.078125)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
