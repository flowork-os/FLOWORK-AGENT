loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001879, -0.004536), (0.006414, -0.006414)).lineTo(0.032072, -0.006414).threePointArc((0.036608, -0.004536), (0.038487, 0.000000)).lineTo(0.038487, 0.602961).threePointArc((0.036608, 0.607496), (0.032072, 0.609375)).lineTo(0.006414, 0.609375).threePointArc((0.001879, 0.607496), (0.000000, 0.602961)).lineTo(0.000000, 0.000000).close()
