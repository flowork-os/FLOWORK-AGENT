# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00263246" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.000000, -0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.093750, 0.000000).lineTo(1.093750, 0.345395).threePointArc((0.947211, 0.406093), (0.886513, 0.552632)).lineTo(0.000000, 0.552632).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.552632, 0.276316).circle(0.115132)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
