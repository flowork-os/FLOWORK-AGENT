# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00238921" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).lineTo(1.500000, 0.000000).threePointArc((0.750000, 0.750000), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.663158, 0.078947).lineTo(0.252632, 0.457895).threePointArc((0.135303, 0.282394), (0.078947, 0.078947)).close()
loop2=wp_sketch0.moveTo(0.726316, 0.078947).lineTo(0.726316, 0.678947).threePointArc((0.488225, 0.623966), (0.284211, 0.489474)).close()
loop3=wp_sketch0.moveTo(1.184211, 0.521053).threePointArc((0.984751, 0.636986), (0.757895, 0.678947)).lineTo(0.757895, 0.078947).close()
loop4=wp_sketch0.moveTo(1.421053, 0.078947).threePointArc((1.355336, 0.302668), (1.215789, 0.489474)).lineTo(0.821053, 0.078947).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
