import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.632812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004625, -0.011165), (0.015789, -0.015789)).lineTo(1.484211, -0.015789).threePointArc((1.495375, -0.011165), (1.500000, 0.000000)).lineTo(1.500000, 1.263158).threePointArc((1.495375, 1.274323), (1.484211, 1.278947)).lineTo(0.015789, 1.278947).threePointArc((0.004625, 1.274323), (0.000000, 1.263158)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.109375, -0.039062), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.244243, -0.463770), (0.488487, 0.000000)).threePointArc((0.462546, 0.072159), (0.473684, 0.148026)).threePointArc((0.484492, 0.290231), (0.414474, 0.414474)).threePointArc((0.374657, 0.479224), (0.370066, 0.555099)).threePointArc((0.244243, 0.704633), (0.118421, 0.555099)).threePointArc((0.113829, 0.479224), (0.074013, 0.414474)).threePointArc((0.003995, 0.290231), (0.014803, 0.148026)).threePointArc((0.025941, 0.072159), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.398438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
