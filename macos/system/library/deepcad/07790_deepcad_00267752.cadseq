loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001204, -0.002908), (0.004112, -0.004112)).lineTo(0.074013, -0.004112).threePointArc((0.076921, -0.002908), (0.078125, 0.000000)).lineTo(0.078125, 0.070724).threePointArc((0.076750, 0.073220), (0.074013, 0.074013)).lineTo(0.004112, 0.074013).threePointArc((0.001375, 0.073220), (0.000000, 0.070724)).lineTo(0.000000, 0.000000).close()
