loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001084, -0.002617), (0.003701, -0.003701)).lineTo(0.035362, -0.003701).threePointArc((0.037979, -0.002617), (0.039062, 0.000000)).lineTo(0.039062, 0.031661).threePointArc((0.037979, 0.034278), (0.035362, 0.035362)).lineTo(0.003701, 0.035362).threePointArc((0.001084, 0.034278), (0.000000, 0.031661)).lineTo(0.000000, 0.000000).close()
