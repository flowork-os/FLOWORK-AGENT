# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00339921" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.429688, 0.000000).lineTo(0.429688, 0.429688).lineTo(0.000000, 0.429688).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.388980, 0.045230).lineTo(0.388980, 0.388980).lineTo(0.045230, 0.388980).lineTo(0.045230, 0.045230).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, -0.429688, -0.375000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.219079, -0.374260).lineTo(0.648109, -0.374260).lineTo(0.867188, 0.000000).lineTo(0.648109, 0.374260).lineTo(0.219079, 0.374260).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.237336, -0.328618).lineTo(0.629852, -0.328618).lineTo(0.821546, 0.000000).lineTo(0.629852, 0.328618).lineTo(0.237336, 0.328618).lineTo(0.045641, 0.000000).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.046875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
