# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288901" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.063158).threePointArc((-0.061842, 0.125000), (0.000000, 0.186842)).lineTo(0.000000, 0.250000).threePointArc((-0.125000, 0.125000), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.995395, 0.000000).threePointArc((0.872368, 0.123026), (0.995395, 0.246053)).lineTo(0.000000, 0.246053).lineTo(0.000000, 0.190132).threePointArc((-0.061513, 0.128618), (0.000000, 0.067105)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.167763, 0.067105).lineTo(0.827632, 0.067105).threePointArc((0.891452, 0.128618), (0.827632, 0.190132)).lineTo(0.167763, 0.190132).threePointArc((0.109913, 0.128618), (0.167763, 0.067105)).close()
loop3=wp_sketch1.moveTo(0.995395, 0.123026).circle(0.067105)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.085938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
