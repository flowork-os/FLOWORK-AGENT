# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00260012" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, 0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.103618, -0.241776).lineTo(0.200329, -0.490461).lineTo(0.331579, -0.435197).lineTo(0.455921, -0.490461).lineTo(0.552632, -0.241776).lineTo(0.656250, 0.000000).lineTo(0.331579, 0.138158).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.331579, -0.290132).circle(0.020724)
loop2=wp_sketch0.moveTo(0.331579, -0.006908).circle(0.020724)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
