import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.181976, -0.174531), (0.347368, 0.015789)).lineTo(0.284211, 0.639474).threePointArc((0.177632, 0.746053), (0.071053, 0.639474)).lineTo(0.000000, 0.039474).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.173684, 0.000000).circle(0.102632)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
