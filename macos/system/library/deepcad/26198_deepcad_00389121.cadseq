wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.148438, -0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.010983, -0.026517), (0.037500, -0.037500)).lineTo(0.259375, -0.037500).threePointArc((0.285892, -0.026517), (0.296875, 0.000000)).lineTo(0.296875, 0.221875).threePointArc((0.285892, 0.248392), (0.259375, 0.259375)).lineTo(0.037500, 0.259375).threePointArc((0.010983, 0.248392), (0.000000, 0.221875)).lineTo(0.000000, 0.000000).close()
