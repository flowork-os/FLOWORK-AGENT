# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00312716" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.505263).lineTo(0.000000, 0.505263).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.136842, 0.126316).lineTo(1.136842, 0.378947).lineTo(0.363158, 0.378947).lineTo(0.363158, 0.126316).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.500000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.781250, 0.000000).lineTo(0.781250, 0.238487).lineTo(0.000000, 0.238487).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.394737, 0.123355).circle(0.057566)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.500000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.059211, 0.000000).circle(0.059211)
solid2=wp_sketch2.add(loop4).extrude(-0.500000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.781250, 0.000000).lineTo(0.781250, 0.238487).lineTo(0.000000, 0.238487).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch3.moveTo(0.394737, 0.123355).circle(0.057566)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(-0.148438)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch4.moveTo(0.059211, 0.000000).circle(0.059211)
solid4=wp_sketch4.add(loop7).extrude(-0.203125)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
