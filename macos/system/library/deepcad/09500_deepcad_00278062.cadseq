wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, -0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.108290, -0.078633), (0.241776, -0.069079)).threePointArc((0.304441, 0.001189), (0.221053, 0.044901)).threePointArc((0.079256, 0.108799), (0.221053, 0.172697)).threePointArc((0.328157, 0.225317), (0.227961, 0.290132)).threePointArc((0.100910, 0.291350), (0.000000, 0.214145)).threePointArc((-0.144370, 0.107072), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
