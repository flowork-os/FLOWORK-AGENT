# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387618" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.703125, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.004523, -0.085938).threePointArc((0.047393, -0.040593), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.562500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.090789, 0.000000).circle(0.090789)
loop2=wp_sketch1.moveTo(0.090789, 0.000000).circle(0.068092)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.562500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.142105, 0.000000).threePointArc((0.186811, 0.088816), (0.142105, 0.177632)).lineTo(0.000000, 0.177632).threePointArc((0.088816, 0.088816), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.562500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.164062, 0.000000, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.019506, -0.062911), (0.000000, -0.125822)).lineTo(0.335526, -0.125822).threePointArc((0.398438, -0.062911), (0.335526, 0.000000)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.562500)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.546875, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.164062, 0.000000).lineTo(0.158882, 0.088076).lineTo(0.000000, 0.088076).threePointArc((0.017925, 0.044038), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop5).extrude(0.562500)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
