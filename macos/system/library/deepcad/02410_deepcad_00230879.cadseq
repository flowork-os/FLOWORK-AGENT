# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00230879" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.734375, 0.000000).lineTo(0.734375, 0.371053).lineTo(0.000000, 0.371053).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.015625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.734375, 0.000000).lineTo(0.734375, 0.371053).lineTo(0.000000, 0.371053).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.718914, 0.015461).lineTo(0.718914, 0.347862).lineTo(0.015461, 0.347862).lineTo(0.015461, 0.015461).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.460938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.710938, 0.203125, 0.476562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.018750, 0.000000).lineTo(0.018750, 0.093750).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.273438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.203125, 0.476562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.018750, 0.000000).lineTo(0.018750, 0.093750).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.273438)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
