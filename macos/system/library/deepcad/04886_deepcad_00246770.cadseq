import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.382812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.059314, -0.216287), (0.209539, -0.382813)).threePointArc((0.241108, -0.363492), (0.274013, -0.346546)).threePointArc((0.203668, -0.131896), (0.044326, 0.028207)).threePointArc((0.022596, 0.013423), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, -0.382812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.022596, -0.013423), (0.044326, -0.028207)).threePointArc((0.203668, 0.131896), (0.274013, 0.346546)).threePointArc((0.241108, 0.363492), (0.209539, 0.382813)).threePointArc((0.059314, 0.216287), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.023438, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.219844, -0.047344), (0.437500, 0.009211)).threePointArc((0.438348, 0.036842), (0.437500, 0.064474)).threePointArc((0.219844, 0.121029), (0.000000, 0.073684)).threePointArc((-0.001357, 0.036842), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.750000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.029938, -0.018890), (0.061184, -0.035526)).threePointArc((0.062493, 0.000000), (0.061184, 0.035526)).threePointArc((0.029938, 0.018890), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(0.750000)
