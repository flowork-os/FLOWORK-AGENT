# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00301058" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.097697, 0.000000).circle(0.097697)
loop1=wp_sketch0.moveTo(0.657237, -0.186513).threePointArc((0.843750, 0.000000), (0.657237, 0.186513)).lineTo(0.097697, 0.186513).threePointArc((0.284211, 0.000000), (0.097697, -0.186513)).close()
loop2=wp_sketch0.moveTo(0.657237, 0.000000).circle(0.097697)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.468750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.094737, 0.000000).circle(0.094737)
solid1=wp_sketch1.add(loop3).extrude(0.281250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.094737, 0.000000).circle(0.094737)
solid2=wp_sketch2.add(loop4).extrude(-0.187500, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
