# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00360141" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.347368).lineTo(0.000000, 0.347368).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.047368, 0.181579).circle(0.023684)
loop2=wp_sketch0.moveTo(0.268421, 0.102632).circle(0.023684)
loop3=wp_sketch0.moveTo(0.568421, 0.157895).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.339474).lineTo(0.000000, 0.339474).lineTo(0.000000, 0.331579).lineTo(0.000000, 0.039474).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(0.039474, 0.181579).circle(0.015789)
loop6=wp_sketch1.moveTo(0.268421, 0.181579).circle(0.015789)
solid1=wp_sketch1.add(loop4).add(loop5).add(loop6).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch2.moveTo(0.000000, 0.289062).threePointArc((-0.111373, 0.144531), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop7).extrude(0.023438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
