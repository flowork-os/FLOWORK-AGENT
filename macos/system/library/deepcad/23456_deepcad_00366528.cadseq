# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00366528" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, 0.726562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.015378, 0.000000).circle(0.015378)
loop1=wp_sketch0.moveTo(0.118832, -0.013980).threePointArc((0.132812, 0.000000), (0.118832, 0.013980)).lineTo(0.015378, 0.025164).threePointArc((0.040543, 0.000000), (0.015378, -0.025164)).close()
loop2=wp_sketch0.moveTo(0.054523, 0.000000).circle(0.002796)
loop3=wp_sketch0.moveTo(0.074095, 0.000000).circle(0.002796)
loop4=wp_sketch0.moveTo(0.095066, 0.000000).circle(0.002796)
loop5=wp_sketch0.moveTo(0.114638, 0.000000).circle(0.002796)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
