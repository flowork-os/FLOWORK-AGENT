# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00389609" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.271875, -0.410197).threePointArc((0.313025, -0.305510), (0.395888, -0.381579)).lineTo(0.453125, 0.000000).lineTo(0.453125, 0.376809).lineTo(0.000000, 0.376809).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.071053, 0.000000).circle(0.071053)
loop2=wp_sketch1.moveTo(0.096217, -0.026645).lineTo(0.096217, 0.026645).lineTo(0.044408, 0.026645).lineTo(0.044408, -0.026645).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch2.moveTo(0.071053, 0.000000).circle(0.071053)
loop4=wp_sketch2.moveTo(0.096217, -0.026645).lineTo(0.096217, 0.026645).lineTo(0.044408, 0.026645).lineTo(0.044408, -0.026645).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.046875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
