# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00248703" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.015789, 0.000000).lineTo(0.015789, 0.592105).threePointArc((0.022152, 0.625739), (0.039474, 0.655263)).lineTo(0.110526, 0.742105).lineTo(0.094737, 0.750000).lineTo(0.023684, 0.663158).threePointArc((0.005678, 0.629686), (0.000000, 0.592105)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.015625, 0.671875, 0.054688), cq.Vector(0.634393, 0.773010, -0.000000), cq.Vector(0.773010, -0.634393, 0.000000)))
loop1=wp_sketch1.moveTo(0.043421, 0.000000).circle(0.043421)
solid1=wp_sketch1.add(loop1).extrude(-0.023438)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
