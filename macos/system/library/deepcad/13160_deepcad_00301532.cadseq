# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00301532" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.047368, 0.000000).lineTo(0.047368, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.039474, 0.007895), (0.031579, 0.047368)).lineTo(0.031579, 0.284211).threePointArc((0.023684, 0.292105), (0.015789, 0.284211)).lineTo(0.015789, 0.047368).close()
loop2=wp_sketch0.moveTo(0.015789, 0.047368).threePointArc((0.232895, 0.248684), (0.031579, 0.465789)).lineTo(0.031579, 0.702632).threePointArc((0.023684, 0.710526), (0.015789, 0.702632)).lineTo(0.015789, 0.465789).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
