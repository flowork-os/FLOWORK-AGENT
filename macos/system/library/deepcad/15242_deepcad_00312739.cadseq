# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00312739" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.187500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.378947, 0.000000).lineTo(0.378947, 0.094737).lineTo(0.931579, 0.094737).lineTo(1.500000, 0.094737).lineTo(1.500000, 0.378947).lineTo(0.000000, 0.378947).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.142105, 0.189474).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.375000, -0.187500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.562500, 0.000000).lineTo(0.562500, 0.094737).lineTo(0.000000, 0.094737).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.093750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.187500, -0.187500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.562500, 0.000000).lineTo(0.562500, 0.094737).lineTo(0.000000, 0.094737).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.078125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
