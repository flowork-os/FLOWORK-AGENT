# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00356582" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.601562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.552632, 0.000000).lineTo(0.552632, 0.600000).lineTo(0.947368, 0.600000).lineTo(0.947368, 0.000000).lineTo(1.500000, 0.000000).lineTo(1.500000, 1.200000).lineTo(0.000000, 1.200000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.410526, 0.300000).lineTo(0.410526, 0.600000).lineTo(0.142105, 0.600000).lineTo(0.142105, 0.300000).close()
loop2=wp_sketch0.moveTo(1.357895, 0.300000).lineTo(1.357895, 0.600000).lineTo(1.089474, 0.600000).lineTo(1.089474, 0.300000).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
