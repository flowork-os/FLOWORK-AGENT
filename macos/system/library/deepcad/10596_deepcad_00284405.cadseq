wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, 0.000000, -0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.006359, -0.015352), (0.021711, -0.021711)).lineTo(0.493914, -0.021711).threePointArc((0.509266, -0.015352), (0.515625, 0.000000)).lineTo(0.515625, 0.472204).threePointArc((0.509266, 0.487556), (0.493914, 0.493914)).lineTo(0.021711, 0.493914).threePointArc((0.006359, 0.487556), (0.000000, 0.472204)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.008607, -0.009924), (0.021711, -0.010855)).lineTo(0.493914, -0.010855).threePointArc((0.501590, -0.007676), (0.504770, 0.000000)).lineTo(0.504770, 0.472204).threePointArc((0.501590, 0.479880), (0.493914, 0.483059)).lineTo(0.021711, 0.483059).threePointArc((0.014035, 0.479880), (0.010855, 0.472204)).lineTo(0.010855, 0.000000).close()
