# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00233949" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.013816, 0.000000).lineTo(0.013816, 0.093750).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.010855, 0.047368).lineTo(0.010855, 0.057237).lineTo(0.004934, 0.057237).lineTo(0.004934, 0.047368).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.016776, 0.000000).lineTo(0.016776, 0.093750).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.031579, 0.000000).lineTo(0.031579, 0.093750).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.031250)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.031579, 0.000000).lineTo(0.031579, 0.093750).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch3.moveTo(0.025658, 0.047368).lineTo(0.025658, 0.057237).lineTo(0.019737, 0.057237).lineTo(0.019737, 0.047368).close()
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.031250)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
