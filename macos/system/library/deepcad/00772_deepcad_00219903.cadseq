# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00219903" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.232490, -0.271433), (0.492187, -0.025905)).lineTo(0.492187, 0.150247).lineTo(0.341941, 0.150247).lineTo(0.341941, 0.352303).lineTo(0.000000, 0.352303).lineTo(0.000000, 0.150247).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, -0.007812, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.343750, 0.000000).lineTo(0.343750, 0.112171).lineTo(0.000000, 0.112171).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.648438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.171875, -0.007812, 0.351562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.113240, 0.000000).lineTo(0.113240, 0.398438).lineTo(0.000000, 0.398438).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.148438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, -0.007812, 0.539062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.075000, 0.000000).circle(0.075000)
solid3=wp_sketch3.add(loop3).extrude(-0.265625)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, -0.007812, 0.546875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.074733, 0.067075), (0.145395, -0.004276)).lineTo(0.143257, 0.203125).lineTo(0.000000, 0.203125).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(-0.265625)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
