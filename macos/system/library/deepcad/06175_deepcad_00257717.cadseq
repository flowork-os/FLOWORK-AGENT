# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257717" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, -0.703125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.017845, 0.000000).circle(0.017845)
loop1=wp_sketch0.moveTo(0.196299, -0.043339).threePointArc((0.240913, 0.001275), (0.196299, 0.045888)).lineTo(0.137664, 0.045888).lineTo(0.137664, 0.030592).lineTo(0.079030, 0.030592).lineTo(0.079030, 0.045888).lineTo(0.017845, 0.045888).threePointArc((0.062459, 0.001275), (0.017845, -0.043339)).close()
loop2=wp_sketch0.moveTo(0.196299, 0.000000).circle(0.017845)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
