wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.162089, 0.000000).threePointArc((0.315073, 0.255239), (0.570312, 0.408224)).lineTo(0.570312, 0.570312).lineTo(0.000000, 0.570312).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.186003, 0.057536), (0.192105, 0.252138)).threePointArc((0.250879, 0.319434), (0.318174, 0.378207)).threePointArc((0.325881, 0.395357), (0.312171, 0.408224)).lineTo(0.180099, 0.408224).threePointArc((0.167364, 0.402949), (0.162089, 0.390214)).lineTo(0.162089, 0.258141).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
