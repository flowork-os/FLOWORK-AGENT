# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00234584" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.000000, -0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.519737, 0.000000).lineTo(0.519737, 0.948520).threePointArc((0.259868, 1.231728), (0.000000, 0.948520)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.259868, 0.974507).circle(0.116941)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.250000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
