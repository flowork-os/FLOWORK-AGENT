# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322291" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.351562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.710938, 0.000000).lineTo(0.359211, 0.396628).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.351562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, -0.351562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.710938, 0.000000).lineTo(0.710938, 0.710938).lineTo(0.000000, 0.710938).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.359211, 0.359211).circle(0.134704)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.351562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
