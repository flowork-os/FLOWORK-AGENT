# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00364446" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.414062, -0.351562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.359211, 0.000000).lineTo(0.609375, 0.000000).lineTo(0.609375, 0.352796).lineTo(0.609375, 0.609375).lineTo(0.000000, 0.609375).lineTo(0.000000, 0.513158).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.203125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.148438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.153701, -0.358635).lineTo(0.548931, -0.402549).lineTo(0.695312, -0.212253).lineTo(0.336678, -0.212253).lineTo(0.336678, 0.307401).lineTo(0.234211, 0.314720).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.296875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
