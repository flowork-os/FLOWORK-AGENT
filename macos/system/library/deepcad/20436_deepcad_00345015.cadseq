# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00345015" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).circle(0.750000)
loop1=wp_sketch0.moveTo(0.265625, -0.281250).circle(0.078125)
loop2=wp_sketch0.moveTo(0.750000, 0.000000).circle(0.203125)
loop3=wp_sketch0.moveTo(0.750000, 0.562500).circle(0.078125)
loop4=wp_sketch0.moveTo(1.234375, -0.281250).circle(0.078125)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.179688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
