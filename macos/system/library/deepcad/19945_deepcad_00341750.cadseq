import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, -0.601562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.026447, -0.063849), (0.090296, -0.090296)).lineTo(1.339391, -0.090296).threePointArc((1.403240, -0.063849), (1.429688, 0.000000)).lineTo(1.429688, 1.249095).threePointArc((1.403240, 1.312944), (1.339391, 1.339391)).lineTo(0.090296, 1.339391).threePointArc((0.026447, 1.312944), (0.000000, 1.249095)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.180592, 0.060197).circle(0.060197)
loop2=wp_sketch0.moveTo(0.180592, 1.128701).circle(0.060197)
loop3=wp_sketch0.moveTo(1.249095, 0.060197).circle(0.060197)
