# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.046246, -0.111648), (0.157895, -0.157895)).lineTo(1.389474, -0.157895).threePointArc((1.470898, -0.117628), (1.500000, -0.031579)).lineTo(1.500000, 1.278947).threePointArc((1.476877, 1.334772), (1.421053, 1.357895)).lineTo(0.031579, 1.357895).threePointArc((0.005979, 1.340751), (0.000000, 1.310526)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
