# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00263183" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.382812, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.386842, 0.000000).circle(0.386842)
loop1=wp_sketch0.moveTo(0.386842, 0.000000).circle(0.314309)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.664062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.414062, -0.203125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.315954, -0.250905).lineTo(0.706250, -0.157977).lineTo(0.882812, 0.204441).lineTo(0.706250, 0.566859).lineTo(0.315954, 0.650493).lineTo(0.000000, 0.399589).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.418174, 0.204441).circle(0.250905)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.250000, -0.312500, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.315789, 0.000000).circle(0.309211)
loop5=wp_sketch2.moveTo(0.315789, 0.000000).circle(0.250000)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.500000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.250000, -0.250000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.252632, 0.000000).circle(0.252632)
loop7=wp_sketch3.moveTo(0.252632, 0.000000).circle(0.210526)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.500000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
