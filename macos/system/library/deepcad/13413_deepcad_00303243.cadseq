import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.500329, 0.000000).threePointArc((0.571999, -0.035443), (0.597615, -0.111184)).lineTo(0.597615, -0.597615).lineTo(0.722697, -0.597615).lineTo(0.722697, -0.111184).threePointArc((0.748313, -0.035443), (0.819984, 0.000000)).lineTo(1.320312, 0.000000).lineTo(1.320312, 0.152878).lineTo(0.000000, 0.152878).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, -0.648438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(1.320312, 0.000000).lineTo(1.320312, 0.152878).lineTo(0.819984, 0.152878).threePointArc((0.751192, 0.181373), (0.722697, 0.250164)).lineTo(0.722697, 0.653207).lineTo(0.597615, 0.653207).lineTo(0.597615, 0.250164).threePointArc((0.569121, 0.181373), (0.500329, 0.152878)).lineTo(0.000000, 0.152878).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.148438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
