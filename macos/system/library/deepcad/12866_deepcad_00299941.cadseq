# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00299941" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.024102, -0.400074), (0.375000, -0.593750)).lineTo(0.375000, -0.200000).lineTo(0.356250, -0.200000).lineTo(0.356250, -0.156250).lineTo(0.375000, -0.156250).lineTo(0.375000, 0.406250).lineTo(0.375000, 0.568750).threePointArc((0.286407, 0.543625), (0.225000, 0.475000)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.351785, 0.189545), (0.379852, 0.588158)).lineTo(0.147039, 1.066036).threePointArc((0.087733, 1.136370), (0.000000, 1.164062)).lineTo(0.000000, 0.992516).lineTo(0.000000, 0.441118).lineTo(0.024507, 0.441118).lineTo(0.024507, 0.392105).lineTo(0.000000, 0.392105).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
