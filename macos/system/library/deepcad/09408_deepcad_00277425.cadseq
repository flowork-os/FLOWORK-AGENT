# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.015625, -0.515625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.016447, 0.000000).lineTo(0.016447, 0.039062).lineTo(0.000000, 0.039062).lineTo(0.000000, 0.000000).close()
