# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.109375, -0.539062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.109375, 0.000000).lineTo(0.109375, 0.018421).lineTo(0.090954, 0.018421).lineTo(0.000000, 0.018421).lineTo(0.000000, 0.000000).close()
