# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.015625, 0.453125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.018503, 0.000000).lineTo(0.018503, 0.070312).lineTo(0.000000, 0.070312).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(-1.000000)
