solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.109375, 0.515625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.090954, 0.000000).lineTo(0.109375, 0.000000).lineTo(0.109375, 0.018421).lineTo(0.000000, 0.018421).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-1.000000)
