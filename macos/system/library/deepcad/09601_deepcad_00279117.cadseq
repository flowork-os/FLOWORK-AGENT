wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.213158, 0.000000).threePointArc((0.275793, -0.009463), (0.331579, -0.039474)).threePointArc((0.381002, -0.067260), (0.434211, -0.086842)).lineTo(0.750000, -0.086842).lineTo(0.750000, 0.039474).lineTo(0.750000, 0.165789).lineTo(0.434211, 0.165789).threePointArc((0.381317, 0.150155), (0.331579, 0.126316)).threePointArc((0.275793, 0.096305), (0.213158, 0.086842)).lineTo(0.000000, 0.086842).lineTo(0.000000, 0.039474).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
