wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.204688, 0.000000).lineTo(0.204688, -0.086184).lineTo(0.226234, -0.107730).lineTo(0.797204, -0.107730).lineTo(0.818750, -0.086184).lineTo(0.818750, 0.000000).lineTo(1.023438, 0.000000).lineTo(1.023438, 0.387829).threePointArc((0.985573, 0.479241), (0.894161, 0.517105)).lineTo(0.484786, 0.517105).lineTo(0.118503, 0.517105).lineTo(0.000000, 0.452467).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.150822, 0.150822).circle(0.075411)
loop2=wp_sketch0.moveTo(0.484786, 0.355510).circle(0.129276)
loop3=wp_sketch0.moveTo(0.926480, 0.075411).circle(0.021546)
