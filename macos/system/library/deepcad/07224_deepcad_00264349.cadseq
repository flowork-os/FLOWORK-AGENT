wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.193421, 0.000000).lineTo(0.193421, 0.064474).lineTo(0.340789, 0.064474).lineTo(0.340789, 0.000000).lineTo(0.534211, 0.000000).lineTo(0.534211, 0.128947).lineTo(0.313158, 0.128947).lineTo(0.313158, 0.451316).threePointArc((0.267105, 0.891208), (0.221053, 0.451316)).lineTo(0.221053, 0.128947).lineTo(0.000000, 0.128947).lineTo(0.000000, 0.000000).close()
