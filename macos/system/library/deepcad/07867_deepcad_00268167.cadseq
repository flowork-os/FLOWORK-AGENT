# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00268167" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, -0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.102138, 0.000000).lineTo(0.102138, 0.329112).threePointArc((0.249671, 0.476645), (0.397204, 0.329112)).lineTo(0.397204, 0.000000).lineTo(0.510691, 0.000000).lineTo(0.510691, 0.896546).threePointArc((0.457508, 1.024942), (0.329112, 1.078125)).lineTo(0.181579, 1.078125).threePointArc((0.053183, 1.024942), (0.000000, 0.896546)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.056743, 0.090789).circle(0.022697)
loop2=wp_sketch0.moveTo(0.249671, 0.896546).circle(0.102138)
loop3=wp_sketch0.moveTo(0.453947, 0.090789).circle(0.022697)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.062500, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
