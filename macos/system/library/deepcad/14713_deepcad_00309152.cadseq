# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.000000, 0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.167763, 0.000000).lineTo(0.315789, 0.000000).lineTo(0.473684, 0.000000).lineTo(0.523026, 0.000000).lineTo(0.769737, 0.000000).lineTo(0.937500, 0.000000).lineTo(0.621711, 0.256579).lineTo(0.315789, 0.256579).lineTo(0.000000, 0.000000).close()
