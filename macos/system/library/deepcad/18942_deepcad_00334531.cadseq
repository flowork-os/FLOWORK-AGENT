# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00334531" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.225000, -0.248684).lineTo(0.378947, -0.248684).lineTo(0.414474, -0.248684).threePointArc((0.675000, -0.098979), (0.935526, -0.248684)).lineTo(1.125000, -0.248684).lineTo(1.125000, 0.651316).lineTo(0.971053, 0.651316).lineTo(0.675000, 0.201316).lineTo(0.378947, 0.651316).lineTo(0.225000, 0.651316).lineTo(0.000000, 0.402632).threePointArc((0.531583, 0.201316), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.303947, 0.000000).circle(0.297615)
solid1=wp_sketch1.add(loop1).extrude(0.375000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
