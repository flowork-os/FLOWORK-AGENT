loop3=wp_sketch3.moveTo(0.050987, 0.000000).lineTo(0.050987, 0.387500).lineTo(0.050987, 0.540461).lineTo(0.489474, 0.540461).lineTo(0.917763, 0.540461).lineTo(0.917763, 0.387500).lineTo(0.917763, 0.000000).lineTo(0.968750, 0.000000).lineTo(0.968750, 0.642434).lineTo(0.000000, 0.642434).lineTo(0.000000, 0.000000).close()
