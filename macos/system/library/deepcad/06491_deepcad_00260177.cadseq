wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.675000, 0.000000).circle(0.675000)
loop1=wp_sketch0.moveTo(0.365625, -0.506250).lineTo(0.365625, -0.492188).lineTo(0.365625, 0.492188).lineTo(0.365625, 0.506250).lineTo(0.337500, 0.506250).lineTo(0.337500, 0.492188).lineTo(0.337500, 0.000000).lineTo(0.337500, -0.492188).lineTo(0.337500, -0.506250).close()
loop2=wp_sketch0.moveTo(0.675000, -0.576562).lineTo(0.787500, -0.576562).lineTo(0.787500, -0.548438).lineTo(0.675000, -0.548438).lineTo(0.548438, -0.548438).lineTo(0.548438, -0.576562).close()
loop3=wp_sketch0.moveTo(0.675000, 0.000000).circle(0.042188)
