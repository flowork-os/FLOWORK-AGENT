solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.531250, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop5=wp_sketch1.moveTo(0.032072, 0.000000).lineTo(0.032072, 1.015625).lineTo(0.000000, 1.015625).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(-0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.226562, 0.531250, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop6=wp_sketch2.moveTo(0.032072, 0.000000).lineTo(0.032072, 1.015625).lineTo(0.000000, 1.015625).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(-0.007812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, -0.531250, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop7=wp_sketch3.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.026316).lineTo(0.000000, 0.026316).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop7).extrude(-0.007812)
solid=solid.union(solid3)

