# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, 0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.080766, -0.451443), (0.010280, -0.904605)).threePointArc((0.031355, -0.955487), (0.082237, -0.976563)).threePointArc((0.333645, -0.949735), (0.585938, -0.966283)).threePointArc((0.630655, -0.942200), (0.647615, -0.894326)).threePointArc((0.575666, -0.447163), (0.647615, 0.000000)).lineTo(0.000000, 0.000000).close()
