# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00237592" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.648438, 0.000000).lineTo(0.648438, 0.218421).lineTo(0.000000, 0.218421).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.109211, 0.109211).circle(0.027303)
loop2=wp_sketch0.moveTo(0.327632, 0.109211).circle(0.027303)
loop3=wp_sketch0.moveTo(0.539227, 0.109211).circle(0.027303)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.221053, 0.000000).lineTo(0.221053, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(0.110526, 0.150000).circle(0.023684)
loop6=wp_sketch1.moveTo(0.110526, 0.371053).circle(0.023684)
loop7=wp_sketch1.moveTo(0.110526, 0.584211).circle(0.023684)
solid1=wp_sketch1.add(loop4).add(loop5).add(loop6).add(loop7).extrude(-0.046875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
