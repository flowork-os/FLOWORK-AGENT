# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.445312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.227714, 0.000000).lineTo(0.227714, 0.304688).lineTo(0.000000, 0.304688).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.531250)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.093750, 0.445312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.227714, 0.000000).lineTo(0.227714, 0.304688).lineTo(0.000000, 0.304688).lineTo(0.000000, 0.000000).close()
