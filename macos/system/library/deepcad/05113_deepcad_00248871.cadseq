loop1=wp_sketch1.moveTo(0.343750, 0.000000).lineTo(0.343750, 0.303947).lineTo(0.000000, 0.303947).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.375000)
