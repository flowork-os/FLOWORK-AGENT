import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.585938, 0.000000).lineTo(0.585938, 0.333059).lineTo(0.000000, 0.333059).threePointArc((-0.166530, 0.166530), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.166530).circle(0.086349)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.335938, 0.000000).lineTo(0.335938, 0.084868).lineTo(0.000000, 0.084868).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.085938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.000000, 0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.335938, 0.000000).lineTo(0.335938, 0.169737).threePointArc((0.167969, 0.337706), (0.000000, 0.169737)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.169737, 0.169737).circle(0.084868)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.085938)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.335938, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.335938, 0.000000).lineTo(0.335938, 0.084868).lineTo(0.000000, 0.084868).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(-0.085938)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.335938, 0.085938), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.335938, 0.000000).lineTo(0.335938, 0.169737).threePointArc((0.167969, 0.337706), (0.000000, 0.169737)).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch4.moveTo(0.169737, 0.169737).circle(0.084868)
solid4=wp_sketch4.add(loop6).add(loop7).extrude(-0.085938)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
