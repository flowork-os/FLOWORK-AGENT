# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00218333" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.109375, 0.000000).lineTo(0.109375, 0.067928).lineTo(0.081743, 0.095559).lineTo(0.027632, 0.095559).lineTo(0.000000, 0.067928).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.093750, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.107072, 0.000000).lineTo(0.107072, 0.038240).lineTo(0.084128, 0.068832).lineTo(0.084128, 0.634786).lineTo(0.107072, 0.657730).lineTo(0.107072, 0.726562).lineTo(0.000000, 0.726562).lineTo(0.000000, 0.657730).lineTo(0.030592, 0.634786).lineTo(0.030592, 0.068832).lineTo(0.000000, 0.038240).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.023438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
