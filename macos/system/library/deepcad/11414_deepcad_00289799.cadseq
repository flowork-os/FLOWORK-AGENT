wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.079687, 0.000000).lineTo(0.079687, 0.373273).lineTo(0.176151, 0.373273).lineTo(0.276809, 0.373273).lineTo(0.276809, 0.000000).lineTo(0.356497, 0.000000).lineTo(0.356497, 0.163569).lineTo(0.356497, 0.398438).lineTo(0.176151, 0.398438).lineTo(0.000000, 0.398438).lineTo(0.000000, 0.163569).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.398438)
solid=solid0

if __name__ == '__main__':
    import sys
