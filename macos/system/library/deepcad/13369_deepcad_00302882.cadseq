import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.453125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.378947, 0.000000).threePointArc((0.750000, 0.247929), (1.121053, 0.000000)).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.852632).threePointArc((0.750000, 0.746079), (0.000000, 0.852632)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.453125)
solid=solid0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.453125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.378947, 0.000000).threePointArc((0.750000, 0.247929), (1.121053, 0.000000)).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.852632).threePointArc((0.750000, 0.746079), (0.000000, 0.852632)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.453125)
solid=solid.union(solid0)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
