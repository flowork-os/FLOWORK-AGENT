# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00273044" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, -0.382812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.207401, 0.000000).lineTo(0.207401, 0.103701).lineTo(0.207401, 0.654112).lineTo(0.207401, 0.757812).lineTo(0.000000, 0.757812).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.127632, 0.103701).lineTo(0.127632, 0.159539).lineTo(0.079770, 0.159539).lineTo(0.079770, 0.103701).close()
loop2=wp_sketch0.moveTo(0.127632, 0.598273).lineTo(0.127632, 0.654112).lineTo(0.079770, 0.654112).lineTo(0.079770, 0.598273).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.101562, 0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.648438, 0.000000).lineTo(0.648438, 0.102385).lineTo(0.000000, 0.102385).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.140625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.101562, -0.382812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.648438, 0.000000).lineTo(0.648438, 0.102385).lineTo(0.000000, 0.102385).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.140625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
