# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00369029" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, -0.421875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.209704, 0.000000).lineTo(0.209704, 0.826480).threePointArc((0.134745, 0.991858), (0.111020, 1.171875)).threePointArc((0.028809, 1.007760), (0.000000, 0.826480)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.046875, -0.429688, 0.039062), cq.Vector(-0.999699, 0.024541, -0.000000), cq.Vector(0.024541, 0.999699, 0.000000)))
loop1=wp_sketch1.moveTo(0.027632, 0.000000).circle(0.027632)
solid1=wp_sketch1.add(loop1).extrude(-0.203125)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
