import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, -0.625000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.130263, 0.000000).lineTo(0.130263, 0.622368).lineTo(0.535526, 0.622368).lineTo(0.535526, 0.000000).lineTo(0.665789, 0.000000).lineTo(0.665789, 1.375000).lineTo(0.535526, 1.375000).lineTo(0.535526, 0.752632).lineTo(0.130263, 0.752632).lineTo(0.130263, 1.375000).lineTo(0.000000, 1.375000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
