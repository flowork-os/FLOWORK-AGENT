# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00314948" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.035526, 0.000000).circle(0.034786)
loop1=wp_sketch0.moveTo(0.035526, 0.000000).circle(0.024424)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.414062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.047368, 0.000000).circle(0.047368)
loop3=wp_sketch1.moveTo(0.047368, 0.000000).circle(0.029605)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.320312, 0.117188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.063158, 0.000000).circle(0.063158)
loop5=wp_sketch2.moveTo(0.063158, 0.000000).circle(0.053947)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.328125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.156250, -0.070312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.153783, 0.000000).lineTo(0.153783, 0.171875).lineTo(0.000000, 0.171875).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch3.moveTo(0.123026, 0.030757).lineTo(0.123026, 0.128454).lineTo(0.043421, 0.128454).lineTo(0.043421, 0.030757).close()
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.179688)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
