# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00259947" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, -0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.265625, 0.000000).lineTo(1.265625, 0.732730).lineTo(0.000000, 0.732730).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.186513, 0.546217).circle(0.039967)
loop2=wp_sketch0.moveTo(0.346382, 0.186513).circle(0.039967)
loop3=wp_sketch0.moveTo(0.346382, 0.546217).circle(0.039967)
loop4=wp_sketch0.moveTo(1.079112, 0.253125).circle(0.039967)
loop5=wp_sketch0.moveTo(1.079112, 0.479605).circle(0.039967)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
