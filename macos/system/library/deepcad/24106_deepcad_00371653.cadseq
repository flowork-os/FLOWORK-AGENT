import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.236431, -0.421464).lineTo(0.729852, -0.431743).lineTo(0.976563, -0.010280).lineTo(0.740132, 0.421464).lineTo(0.246711, 0.421464).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.493421, 0.000000).circle(0.308388)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.236431, -0.421464).lineTo(0.729852, -0.431743).lineTo(0.976563, -0.010280).lineTo(0.740132, 0.421464).lineTo(0.246711, 0.421464).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.493421, 0.000000).circle(0.308388)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.750000)
solid=solid.union(solid0)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
