# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.lineTo(1.332072, 0.000000).lineTo(1.347039, 0.000000).threePointArc((1.426382, 0.082319), (1.347039, 0.164638)).lineTo(1.332072, 0.164638).lineTo(0.000000, 0.164638).threePointArc((-0.079343, 0.082319), (0.000000, 0.000000)).close()
