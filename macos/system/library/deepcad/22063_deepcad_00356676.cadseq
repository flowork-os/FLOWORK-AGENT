# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00356676" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.000000, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.476562, 0.000000).lineTo(0.476562, 0.160526).lineTo(0.165543, 0.160526).lineTo(0.165543, 0.411349).lineTo(0.005016, 0.411349).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.312500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.202714, 0.000000).lineTo(0.118832, -0.496299).lineTo(0.433388, -0.496299).lineTo(0.433388, -0.069901).lineTo(0.664062, -0.069901).lineTo(0.664062, 0.195724).lineTo(0.000000, 0.195724).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.312500)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
