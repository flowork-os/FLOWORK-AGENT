# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00335143" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.687500, 0.000000).lineTo(0.687500, 0.361842).lineTo(0.000000, 0.361842).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.101316, 0.108553).circle(0.007237)
loop2=wp_sketch0.moveTo(0.101316, 0.267763).circle(0.007237)
loop3=wp_sketch0.moveTo(0.542763, 0.253289).circle(0.094079)
loop4=wp_sketch0.moveTo(0.586184, 0.101316).circle(0.007237)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.164062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
