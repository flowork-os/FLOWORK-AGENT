# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00250557" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.023849, 0.000000).threePointArc((1.171875, 0.148026), (1.023849, 0.296053)).lineTo(1.023849, 0.308388).lineTo(0.000000, 0.308388).threePointArc((-0.154194, 0.154194), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.148026).circle(0.074013)
loop2=wp_sketch0.moveTo(1.023849, 0.148026).circle(0.074013)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.359375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.156250, 0.158179), (0.312500, 0.000000)).lineTo(0.312500, 0.003289).lineTo(0.000000, 0.003289).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.078125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
