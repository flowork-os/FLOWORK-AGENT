# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00299039" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.226562, 0.000000).lineTo(1.226562, 0.271135).lineTo(0.000000, 0.271135).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.206579, 0.142023).circle(0.090378)
loop2=wp_sketch0.moveTo(0.477714, 0.142023).circle(0.064556)
loop3=wp_sketch0.moveTo(0.748849, 0.142023).circle(0.051645)
loop4=wp_sketch0.moveTo(0.955428, 0.142023).circle(0.038734)
loop5=wp_sketch0.moveTo(1.084539, 0.142023).circle(0.012911)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
