import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, -0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.054688, 0.000000).lineTo(1.054688, 0.077714).lineTo(1.054688, 0.155428).lineTo(1.054688, 0.233141).lineTo(0.000000, 0.233141).lineTo(0.000000, 0.155428).lineTo(0.000000, 0.077714).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.122122, 0.122122).circle(0.066612)
loop2=wp_sketch0.moveTo(0.532895, 0.122122).circle(0.011102)
loop3=wp_sketch0.moveTo(0.932566, 0.122122).circle(0.066612)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.031250, 0.117188), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.011513, 0.000000).lineTo(0.011513, 0.031250).lineTo(0.000000, 0.031250).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop4).extrude(-0.031250)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.445312, -0.031250, 0.117188), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch2.moveTo(0.011513, 0.000000).lineTo(0.011513, 0.031250).lineTo(0.000000, 0.031250).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop5).extrude(-0.031250)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.218750, 0.000000, -0.117188), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop6=wp_sketch3.moveTo(0.011513, 0.000000).lineTo(0.011513, 0.031250).lineTo(0.000000, 0.031250).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop6).extrude(-0.031250)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
