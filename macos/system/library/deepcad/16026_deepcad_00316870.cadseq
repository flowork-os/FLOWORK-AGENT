# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00316870" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, -0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.031743, 0.000000).lineTo(1.031743, 1.195312).lineTo(0.880757, 1.195312).lineTo(0.792681, 1.195312).lineTo(0.226480, 1.195312).lineTo(0.150987, 1.195312).lineTo(0.000000, 1.195312).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.993997, 0.037747).lineTo(0.993997, 1.157566).lineTo(0.037747, 1.157566).lineTo(0.037747, 0.037747).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.289062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.000000, -0.570312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.959211, 0.000000).lineTo(0.959211, 1.125000).lineTo(0.000000, 1.125000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.039062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.585938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.068092, 0.000000).threePointArc((0.355592, 0.108879), (0.643092, 0.000000)).lineTo(0.718750, 0.000000).threePointArc((0.359375, 0.161946), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.289062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
