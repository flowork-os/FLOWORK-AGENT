# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231934" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.074776, -0.262832), (0.276316, -0.447368)).threePointArc((0.434484, -0.381853), (0.500000, -0.223684)).lineTo(0.500000, 0.000000).lineTo(1.250000, 0.000000).threePointArc((0.625000, -0.625000), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.281250, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
