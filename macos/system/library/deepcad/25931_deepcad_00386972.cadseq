# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00386972" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.544737, 0.000000).lineTo(0.750000, 0.205263).lineTo(0.750000, 0.497368).lineTo(0.457895, 0.497368).lineTo(0.457895, 0.323684).lineTo(0.426316, 0.292105).lineTo(0.000000, 0.292105).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.007812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.544737, 0.000000).lineTo(0.750000, 0.205263).lineTo(0.750000, 0.497368).lineTo(0.734211, 0.497368).lineTo(0.734211, 0.213158).lineTo(0.536842, 0.015789).lineTo(0.000000, 0.015789).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.195312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.281250, 0.007812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.429276, 0.000000).lineTo(0.468750, 0.039474).lineTo(0.468750, 0.217105).lineTo(0.453947, 0.217105).lineTo(0.453947, 0.044408).lineTo(0.424342, 0.014803).lineTo(0.000000, 0.014803).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.195312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
