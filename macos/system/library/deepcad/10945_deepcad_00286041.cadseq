# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00286041" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.150000, 0.000000).circle(0.150000)
loop1=wp_sketch0.moveTo(0.131250, 0.118750).threePointArc((0.044888, 0.058398), (0.040625, -0.046875)).close()
loop2=wp_sketch0.moveTo(0.040625, -0.046875).threePointArc((0.138886, -0.109755), (0.246875, -0.065625)).lineTo(0.053125, -0.068750).close()
loop3=wp_sketch0.moveTo(0.225000, -0.037500).lineTo(0.150000, 0.090625).lineTo(0.078125, -0.040625).close()
loop4=wp_sketch0.moveTo(0.262500, -0.037500).threePointArc((0.251990, 0.062444), (0.168750, 0.118750)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.671875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.007812, 0.000000, 0.117188), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.023438, 0.000000).lineTo(0.023438, 0.023438).lineTo(0.000000, 0.023438).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, -0.671875, 0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch2.moveTo(0.023438, 0.000000).lineTo(0.023438, 0.023438).lineTo(0.000000, 0.023438).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(0.078125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
