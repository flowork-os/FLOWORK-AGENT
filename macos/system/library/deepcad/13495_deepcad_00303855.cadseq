loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.021009, -0.029835), (0.028125, -0.065625)).lineTo(0.600000, -0.065625).lineTo(0.890625, 0.262500).lineTo(0.356250, 0.271875).threePointArc((0.300000, 0.250966), (0.243750, 0.271875)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.101562)
