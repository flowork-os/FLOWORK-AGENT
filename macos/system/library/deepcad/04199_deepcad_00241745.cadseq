# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00241745" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.799178, 0.000000).threePointArc((0.887459, 0.088281), (0.799178, 0.176562)).lineTo(0.000000, 0.176562).threePointArc((-0.091593, 0.088281), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.083635).circle(0.055757)
loop2=wp_sketch0.moveTo(0.799178, 0.083635).circle(0.055757)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
