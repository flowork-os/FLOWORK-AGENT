# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00237387" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.468750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.407977, 0.000000).lineTo(0.407977, 0.945312).lineTo(0.000000, 0.945312).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.129359, 0.129359).circle(0.069655)
loop2=wp_sketch0.moveTo(0.129359, 0.806003).circle(0.069655)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.343750, -0.468750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.407977, 0.000000).lineTo(0.407977, 0.945312).lineTo(0.000000, 0.945312).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.248766, 0.129359).circle(0.069655)
loop5=wp_sketch1.moveTo(0.248766, 0.806003).circle(0.069655)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.156250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.468750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.690789, 0.000000).lineTo(0.690789, 0.937500).lineTo(0.000000, 0.937500).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(-0.054688)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
