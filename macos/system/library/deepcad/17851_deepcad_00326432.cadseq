# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00326432" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.656250, -0.523438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.044408, -0.103618).lineTo(1.228618, -0.103618).lineTo(1.406250, -0.103618).lineTo(1.154605, 0.000000).lineTo(1.021382, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.382812, -0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.003618, 0.085938).threePointArc((-0.007563, 0.043363), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.656250, 0.406250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(1.050000, -0.165789).lineTo(1.036184, -0.359211).threePointArc((1.226204, -0.400658), (1.036184, -0.442105)).lineTo(1.022368, -0.925658).lineTo(1.160526, -0.925658).lineTo(1.312500, -0.041447).lineTo(0.041447, 0.179605).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.250000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.382812, -0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.195281, 0.032721), (0.004112, 0.084293)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.250000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
