wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.112952, -0.257816), (0.393750, -0.238322)).lineTo(0.942928, 0.217599).threePointArc((0.959622, 0.389529), (0.787500, 0.404112)).lineTo(0.549178, 0.196875).threePointArc((0.466940, 0.184077), (0.414474, 0.248684)).lineTo(0.352303, 0.580263).threePointArc((0.233141, 0.678056), (0.113980, 0.580263)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.238322, -0.051809).circle(0.082895)
loop2=wp_sketch0.moveTo(0.238322, 0.559539).circle(0.062171)
loop3=wp_sketch0.moveTo(0.860033, 0.310855).circle(0.062171)
