wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.027778, -0.112198), (0.068503, -0.176151)).lineTo(0.303372, -0.176151).threePointArc((0.365651, -0.150355), (0.391447, -0.088076)).lineTo(0.391447, -0.009786).threePointArc((0.400886, 0.022786), (0.430592, 0.039145)).lineTo(0.831826, 0.039145).threePointArc((0.929687, 0.137007), (0.831826, 0.234868)).lineTo(0.362089, 0.234868).threePointArc((0.284447, 0.223138), (0.215296, 0.185937)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.068503, -0.078289).circle(0.039145)
loop2=wp_sketch0.moveTo(0.293586, -0.078289).circle(0.039145)
loop3=wp_sketch0.moveTo(0.831826, 0.137007).circle(0.039145)
