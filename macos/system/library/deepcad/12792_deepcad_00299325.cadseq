# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00299325" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, -0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.239803).threePointArc((-0.076604, 0.316406), (0.000000, 0.393010)).lineTo(0.000000, 0.632812).threePointArc((-0.316406, 0.316406), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.106579, 0.206497).circle(0.033306)
loop2=wp_sketch0.moveTo(-0.106579, 0.426316).circle(0.033306)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, -0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.867188, 0.000000).lineTo(0.867188, 0.200822).threePointArc((0.748520, 0.319490), (0.867188, 0.438158)).lineTo(0.867188, 0.629852).lineTo(0.000000, 0.629852).lineTo(0.000000, 0.392516).threePointArc((0.073026, 0.319490), (0.000000, 0.246464)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.109539, 0.209951).circle(0.027385)
loop5=wp_sketch1.moveTo(0.109539, 0.429030).circle(0.027385)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.437500, -0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.316406, 0.316406), (0.000000, 0.632812)).lineTo(0.000000, 0.432977).threePointArc((0.116571, 0.316406), (0.000000, 0.199836)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(0.078125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
