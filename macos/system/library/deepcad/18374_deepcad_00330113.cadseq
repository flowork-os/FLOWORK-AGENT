# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00330113" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.164062, 0.000000, 0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.487253, 0.000000).lineTo(0.487253, 0.148026).lineTo(0.585938, 0.148026).lineTo(0.585938, 0.388569).lineTo(0.148026, 0.388569).lineTo(0.148026, 0.296053).lineTo(0.000000, 0.296053).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.061678, 0.061678).circle(0.049342)
loop2=wp_sketch0.moveTo(0.437911, 0.049342).circle(0.037007)
loop3=wp_sketch0.moveTo(0.493421, 0.320724).circle(0.061678)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.187500, 0.000000, -0.359375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.217599, -0.077714).lineTo(0.492187, 0.020724).lineTo(0.492187, 0.362664).lineTo(0.341941, 0.362664).lineTo(0.341941, 0.269408).lineTo(0.196875, 0.269408).lineTo(0.196875, 0.367845).lineTo(0.000000, 0.367845).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop4).extrude(0.125000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
