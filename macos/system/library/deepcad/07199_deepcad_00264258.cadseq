solid1=wp_sketch1.add(loop1).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.687500, 0.000000).lineTo(0.687500, 0.028947).lineTo(0.658553, 0.028947).lineTo(0.028947, 0.028947).lineTo(0.000000, 0.028947).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.007812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.028618, 0.000000).lineTo(0.028618, 0.226562).lineTo(0.000000, 0.219408).lineTo(0.000000, 0.000000).close()
