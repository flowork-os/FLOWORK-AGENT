import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.001645, 0.000000).lineTo(0.001645, 0.003947).threePointArc((0.002251, 0.005740), (0.003947, 0.006579)).lineTo(0.031250, 0.006579).lineTo(0.031250, 0.008224).lineTo(0.002303, 0.008224).threePointArc((0.000606, 0.007385), (0.000000, 0.005592)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.757812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.028618, 0.000000).threePointArc((0.030363, -0.000723), (0.031086, -0.002467)).lineTo(0.031086, -0.008882).threePointArc((0.031808, -0.010626), (0.033553, -0.011349)).lineTo(0.046875, -0.011349).lineTo(0.046875, -0.009868).lineTo(0.035033, -0.009868).threePointArc((0.033186, -0.008899), (0.032566, -0.006908)).lineTo(0.032566, -0.000987).threePointArc((0.031843, 0.000758), (0.030099, 0.001480)).lineTo(0.000000, 0.001480).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.757812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
