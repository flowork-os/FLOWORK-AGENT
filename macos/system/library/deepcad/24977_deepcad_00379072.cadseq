import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.656250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.027748, -0.066989), (0.094737, -0.094737)).lineTo(1.405263, -0.094737).threePointArc((1.472252, -0.066989), (1.500000, 0.000000)).lineTo(1.500000, 1.310526).threePointArc((1.472252, 1.377515), (1.405263, 1.405263)).lineTo(0.094737, 1.405263).threePointArc((0.027748, 1.377515), (0.000000, 1.310526)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
