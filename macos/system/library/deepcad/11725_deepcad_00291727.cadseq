wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.025000, -0.096053).threePointArc((0.028971, -0.101410), (0.035526, -0.102632)).threePointArc((0.061249, -0.100762), (0.086842, -0.103947)).threePointArc((0.094055, -0.102984), (0.098684, -0.097368)).lineTo(0.125000, -0.001316).threePointArc((0.123591, 0.006297), (0.117105, 0.010526)).threePointArc((0.061915, 0.017313), (0.006579, 0.011842)).threePointArc((0.000751, 0.007331), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
