import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.421875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013874, -0.033495), (0.047368, -0.047368)).lineTo(1.452632, -0.047368).threePointArc((1.486126, -0.033495), (1.500000, 0.000000)).lineTo(1.500000, 0.852632).threePointArc((1.486126, 0.886126), (1.452632, 0.900000)).lineTo(0.047368, 0.900000).threePointArc((0.013874, 0.886126), (0.000000, 0.852632)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
