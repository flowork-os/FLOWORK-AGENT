# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00317694" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.359375, -0.289062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.781250, 0.024671).lineTo(0.740132, 0.353618).lineTo(0.000000, 0.287829).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.421875, 0.617188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.312418, 0.000000).lineTo(0.624836, -0.053865).lineTo(0.775658, -0.129276).lineTo(0.851069, -0.280099).lineTo(0.861842, -0.474013).lineTo(0.775658, -0.549424).lineTo(0.807977, -0.549424).lineTo(0.969572, -0.474013).lineTo(1.023438, -0.280099).lineTo(0.937253, -0.086184).lineTo(0.775658, 0.000000).lineTo(0.549424, 0.075411).lineTo(0.010773, 0.129276).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.171875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
