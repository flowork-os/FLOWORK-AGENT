# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00280469" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.560526, 0.000000).lineTo(0.560526, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.284211, 0.284211).circle(0.094737)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.562500, 0.375000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.562500, 0.000000).lineTo(0.562500, 0.189474).lineTo(0.000000, 0.189474).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.187500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.562500, 0.000000).lineTo(0.562500, 0.189474).lineTo(0.000000, 0.189474).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.562500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
