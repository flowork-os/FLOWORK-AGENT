# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00282008" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.429688, 0.000000).lineTo(1.429688, 0.752467).lineTo(0.000000, 0.752467).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.481579, 0.255839).lineTo(0.481579, 0.496628).lineTo(0.240789, 0.496628).lineTo(0.240789, 0.255839).close()
loop2=wp_sketch0.moveTo(1.053454, 0.376234).circle(0.120395)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.187500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
