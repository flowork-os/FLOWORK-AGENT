# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00320431" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.142105, 0.000000).threePointArc((0.284211, 0.142105), (0.426316, 0.000000)).lineTo(1.073684, 0.000000).threePointArc((1.215789, 0.142105), (1.357895, 0.000000)).lineTo(1.500000, 0.000000).threePointArc((1.416757, 0.200967), (1.215789, 0.284211)).lineTo(0.284211, 0.284211).threePointArc((0.083243, 0.200967), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.140625, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.083243, -0.200967), (0.284211, -0.284211)).lineTo(1.215789, -0.284211).threePointArc((1.416757, -0.200967), (1.500000, 0.000000)).lineTo(1.357895, 0.000000).threePointArc((1.215789, -0.142105), (1.073684, 0.000000)).lineTo(0.426316, 0.000000).threePointArc((0.284211, -0.142105), (0.142105, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.140625, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.609375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.142105, 0.000000).lineTo(0.142105, 0.189474).threePointArc((0.277346, 0.360134), (0.426316, 0.201316)).lineTo(0.426316, 0.000000).lineTo(0.562500, 0.000000).lineTo(0.562500, 0.467763).lineTo(0.000000, 0.467763).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.187500, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
