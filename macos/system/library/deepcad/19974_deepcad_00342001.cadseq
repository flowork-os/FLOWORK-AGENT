# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00342001" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.015625, 0.000000, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.499342, 0.325658).lineTo(0.499342, 0.687500).lineTo(0.000000, 0.361842).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.470395, 0.340132).lineTo(0.470395, 0.636842).lineTo(0.028947, 0.347368).lineTo(0.028947, 0.050658).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.046875, -0.023438, 0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.444079, 0.289885).lineTo(0.444079, 0.585938).lineTo(0.000000, 0.296053).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.023438)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.023438, -0.023438, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.487993, 0.318257).lineTo(0.487993, 0.671875).lineTo(0.000000, 0.353618).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.466776, 0.332401).lineTo(0.466776, 0.629441).lineTo(0.021217, 0.339474).lineTo(0.021217, 0.042434).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.023438)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
