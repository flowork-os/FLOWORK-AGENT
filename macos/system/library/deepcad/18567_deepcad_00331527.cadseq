loop8=wp_sketch5.moveTo(0.000000, 0.000000).threePointArc((0.002467, -0.000015), (0.004934, 0.000000)).lineTo(0.004934, 0.156250).lineTo(0.000000, 0.156250).lineTo(0.000000, 0.000000).close()
