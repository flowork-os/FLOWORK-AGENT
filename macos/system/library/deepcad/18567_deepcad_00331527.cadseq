loop6=wp_sketch3.moveTo(0.004605, 0.000000).lineTo(0.004605, 0.054687).threePointArc((0.002303, 0.054702), (0.000000, 0.054687)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop6).extrude(-0.273438)
