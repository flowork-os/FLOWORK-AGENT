# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.281250, 0.000000).lineTo(0.695312, 0.718750).lineTo(0.648438, 0.742188).lineTo(0.257812, 0.062500).threePointArc((0.259690, 0.034294), (0.234375, 0.046875)).lineTo(0.000000, 0.046875).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
