import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.244737, 0.000000).circle(0.244737)
loop1=wp_sketch0.moveTo(0.244737, 0.000000).circle(0.142763)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.390625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.146053, 0.000000).circle(0.143010)
loop3=wp_sketch1.moveTo(0.146053, 0.000000).circle(0.097368)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.289062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.140625, 0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.098478, -0.195641), (0.000000, -0.391283)).lineTo(0.429770, -0.391283).threePointArc((0.611046, -0.186253), (0.410526, 0.000000)).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((-0.036943, -0.235356), (0.198849, -0.269408)).lineTo(0.410526, -0.269408).threePointArc((0.485204, -0.195641), (0.410526, -0.121875)).lineTo(0.198849, -0.121875).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.148438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.127467, -0.078125).threePointArc((-0.094266, -0.172517), (0.008224, -0.390625)).lineTo(0.242599, -0.390625).threePointArc((0.144747, -0.198388), (0.238487, -0.004112)).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch3.moveTo(-0.004112, -0.193257).circle(0.074013)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.148438)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
