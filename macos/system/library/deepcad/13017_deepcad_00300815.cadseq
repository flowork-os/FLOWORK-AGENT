wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.001480, -0.002549).threePointArc((0.001911, -0.002871), (0.002385, -0.003125)).lineTo(0.005345, -0.003125).threePointArc((0.005860, -0.002874), (0.006332, -0.002549)).lineTo(0.007812, 0.000000).threePointArc((0.007852, 0.000535), (0.007812, 0.001069)).lineTo(0.006332, 0.003618).threePointArc((0.005860, 0.003943), (0.005345, 0.004194)).lineTo(0.002385, 0.004194).threePointArc((0.001911, 0.003940), (0.001480, 0.003618)).lineTo(0.000000, 0.001069).threePointArc((-0.000039, 0.000535), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.003865, 0.000576).circle(0.001480)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
