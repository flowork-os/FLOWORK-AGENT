# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00276026" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, -0.726562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.419655, 0.528454).lineTo(0.419655, 0.139885).lineTo(0.917023, 0.730510).lineTo(0.419655, 1.181250).lineTo(0.419655, 0.839309).lineTo(0.000000, 1.476562).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.257812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
