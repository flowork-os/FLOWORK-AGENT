# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00340909" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.095433, -0.178634), (0.284375, -0.251562)).lineTo(0.743750, -0.251562).threePointArc((1.039062, 0.043750), (0.743750, 0.339062)).lineTo(0.284375, 0.339062).threePointArc((0.095433, 0.266134), (0.000000, 0.087500)).threePointArc((0.036356, 0.043750), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.284375, 0.043750).circle(0.185937)
loop2=wp_sketch0.moveTo(0.743750, 0.043750).circle(0.185937)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
