# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00349050" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.039062, -0.742188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.513158, -0.013158).lineTo(0.513158, 0.500000).lineTo(0.302632, 1.250000).lineTo(0.210526, 1.250000).lineTo(0.000000, 0.513158).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.381579, 0.039474).lineTo(0.381579, 0.328947).lineTo(0.118421, 0.342105).lineTo(0.118421, 0.039474).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
