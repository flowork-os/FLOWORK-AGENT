wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, -0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.440789, 0.000000).lineTo(0.440789, -0.022039).lineTo(0.606086, -0.022039).lineTo(0.606086, 0.000000).lineTo(1.046875, 0.000000).lineTo(1.046875, 1.002796).lineTo(0.606086, 1.002796).lineTo(0.606086, 1.024836).lineTo(0.440789, 1.024836).lineTo(0.440789, 1.002796).lineTo(0.000000, 1.002796).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
