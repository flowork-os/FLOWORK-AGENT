loop2=wp_sketch0.moveTo(0.082895, 0.000000).threePointArc((0.428828, -0.824642), (0.967105, -0.110526)).lineTo(0.939474, -0.124342).threePointArc((0.649342, -0.629247), (0.359211, -0.124342)).lineTo(0.331579, -0.110526).close()
loop3=wp_sketch0.moveTo(0.649342, -0.290132).circle(0.290132)
loop4=wp_sketch0.moveTo(0.331579, -0.110526).threePointArc((0.103618, -0.697697), (0.690789, -0.925658)).lineTo(0.690789, -0.787500).threePointArc((0.656250, -0.752961), (0.621711, -0.787500)).lineTo(0.621711, -0.925658).close()
loop5=wp_sketch0.moveTo(0.621711, -0.925658).threePointArc((1.291776, -0.739145), (1.105263, -0.069079)).lineTo(1.215789, 0.000000).threePointArc((1.229605, 0.041447), (1.188158, 0.055263)).lineTo(1.063816, -0.013816).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, 0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.557237, -0.007237).threePointArc((0.603336, -0.072885), (0.636842, 0.000000)).lineTo(0.607895, -0.014474).threePointArc((0.318421, -0.518233), (0.028947, -0.014474)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop6).extrude(0.250000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
