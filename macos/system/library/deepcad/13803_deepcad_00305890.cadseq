# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.289062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.580263, -1.008553).threePointArc((0.649342, -1.048247), (0.718421, -1.008553)).lineTo(1.298684, 0.000000).threePointArc((1.299870, 0.082018), (1.229605, 0.124342)).lineTo(0.069079, 0.124342).threePointArc((-0.001186, 0.082018), (0.000000, 0.000000)).close()
