# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00349042" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.093750, -0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.656250, 0.000000).lineTo(0.656250, 0.117434).threePointArc((0.644703, 0.138403), (0.621711, 0.145066)).lineTo(0.034539, 0.145066).threePointArc((0.011547, 0.138403), (0.000000, 0.117434)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.034539, 0.117434).circle(0.013816)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.093750, -0.421875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.010116, -0.024423), (0.034539, -0.034539)).lineTo(0.621711, -0.034539).threePointArc((0.646134, -0.024423), (0.656250, 0.000000)).lineTo(0.656250, 0.117434).lineTo(0.000000, 0.117434).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.034539, 0.000000).circle(0.013816)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.023438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
