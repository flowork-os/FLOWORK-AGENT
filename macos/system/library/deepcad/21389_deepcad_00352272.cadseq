# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00352272" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.073273, -0.319737).lineTo(0.393010, -0.419655).lineTo(0.632812, -0.193174).lineTo(0.559539, 0.133224).lineTo(0.239803, 0.226480).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.289062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
