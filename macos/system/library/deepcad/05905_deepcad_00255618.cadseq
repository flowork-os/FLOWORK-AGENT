import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.556332, 0.000000).threePointArc((0.786777, -0.301084), (0.900247, 0.060691)).lineTo(0.869901, 0.060691).lineTo(0.869901, 0.000000).threePointArc((0.748520, -0.241144), (0.627138, 0.000000)).lineTo(0.627138, 0.060691).lineTo(0.000000, 0.060691).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.156250, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
