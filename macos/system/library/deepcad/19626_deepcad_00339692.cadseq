# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00339692" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.000000, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.197368, 0.000000).lineTo(0.197368, 0.625000).lineTo(0.000000, 0.625000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.367188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.323684, 0.000000).lineTo(0.323684, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.260526, 0.063158).lineTo(0.260526, 0.686842).lineTo(0.063158, 0.686842).lineTo(0.063158, 0.063158).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.367188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.000000, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.197368, 0.000000).lineTo(0.197368, 0.625000).lineTo(0.000000, 0.625000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.007812)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
