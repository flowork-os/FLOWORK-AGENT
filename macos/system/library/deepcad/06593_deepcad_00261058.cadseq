import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, -0.625000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.036804, -0.088854), (0.125658, -0.125658)).lineTo(1.366530, -0.125658).threePointArc((1.455383, -0.088854), (1.492188, 0.000000)).lineTo(1.492188, 1.256579).threePointArc((1.455383, 1.345432), (1.366530, 1.382237)).lineTo(0.125658, 1.382237).threePointArc((0.036804, 1.345432), (0.000000, 1.256579)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.148429, 0.002926), (0.251316, 0.109951)).lineTo(1.240872, 0.109951).threePointArc((1.329725, 0.146755), (1.366530, 0.235609)).lineTo(1.366530, 1.005263).threePointArc((1.329725, 1.094117), (1.240872, 1.130921)).lineTo(0.251316, 1.130921).threePointArc((0.162462, 1.094117), (0.125658, 1.005263)).lineTo(0.125658, 0.235609).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.171875, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, -0.398438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.109868, 0.206003).threePointArc((0.048472, 0.038356), (0.123602, -0.123602)).lineTo(1.181086, -0.123602).threePointArc((1.268485, -0.087400), (1.304688, 0.000000)).lineTo(1.304688, 0.810280).threePointArc((1.268485, 0.897679), (1.181086, 0.933882)).lineTo(0.123602, 0.933882).threePointArc((0.036202, 0.897679), (0.000000, 0.810280)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.296875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
