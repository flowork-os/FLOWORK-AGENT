loop0=wp_sketch0.moveTo(0.221053, 0.000000).threePointArc((0.353708, 0.029008), (0.489474, 0.031579)).lineTo(0.757895, 0.031579).lineTo(1.010526, 0.031579).threePointArc((1.146292, 0.029008), (1.278947, 0.000000)).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.173684).lineTo(1.278947, 0.173684).threePointArc((1.146292, 0.144676), (1.010526, 0.142105)).lineTo(0.757895, 0.142105).lineTo(0.489474, 0.142105).threePointArc((0.353708, 0.144676), (0.221053, 0.173684)).lineTo(0.000000, 0.173684).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250, both=True)
