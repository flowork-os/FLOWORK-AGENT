wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.656250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.474671, 0.000000).lineTo(0.474671, -0.654276).lineTo(0.141118, -0.654276).threePointArc((0.609375, -1.122533), (1.077632, -0.654276)).lineTo(0.744079, -0.654276).lineTo(0.744079, 0.000000).lineTo(1.218750, 0.000000).lineTo(1.218750, 0.089803).lineTo(0.744079, 0.089803).lineTo(0.615789, 0.089803).lineTo(0.474671, 0.089803).lineTo(0.000000, 0.089803).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
