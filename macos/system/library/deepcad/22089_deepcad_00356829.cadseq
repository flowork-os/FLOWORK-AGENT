# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00356829" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.359211, 0.000000).lineTo(0.359211, 0.082895).lineTo(1.312500, 0.082895).lineTo(1.312500, 0.676974).lineTo(0.221053, 0.676974).lineTo(0.221053, 0.124342).lineTo(0.000000, 0.124342).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.428289, 0.276316).circle(0.138158)
loop2=wp_sketch0.moveTo(1.050000, 0.455921).circle(0.151974)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.367188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.125000, 0.312500, 0.171875), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.106579, 0.000000).circle(0.104359)
solid1=wp_sketch1.add(loop3).extrude(-0.125000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, -0.375000, 0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.028947, -0.250000).lineTo(0.231579, -0.100000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(-0.757812)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
