# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387186" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.092763, 0.000000).circle(0.094737)
loop1=wp_sketch0.moveTo(0.092763, 0.000000).circle(0.029605)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.367188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.086842, 0.000000).circle(0.086842)
loop3=wp_sketch1.moveTo(0.086842, 0.000000).circle(0.028947)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.070312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(1.109375, 0.011678).threePointArc((1.027632, 0.093421), (1.109375, 0.175164)).lineTo(0.000000, 0.186842).threePointArc((0.092282, 0.093421), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop4).extrude(0.070312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
