# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00241204" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, -0.593750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.219243, -0.154409), (0.438487, 0.000000)).lineTo(0.438487, 1.188158).threePointArc((0.219243, 1.346627), (0.000000, 1.188158)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.226316, 0.084868).circle(0.127303)
loop2=wp_sketch0.moveTo(0.226316, 1.117434).circle(0.113158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, -0.265625, 0.171875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.209951, 0.000000).lineTo(0.209951, 0.539062).lineTo(0.000000, 0.539062).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.257812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
