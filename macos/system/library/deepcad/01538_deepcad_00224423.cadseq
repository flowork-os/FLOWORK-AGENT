# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00224423" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.164062, 0.000000).lineTo(1.164062, 0.747451).lineTo(0.649424, 1.004770).lineTo(0.465625, 1.004770).threePointArc((0.199745, 0.935947), (0.000000, 0.747451)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.306332, 0.661678).circle(0.196053)
loop2=wp_sketch0.moveTo(0.906743, 0.208306).circle(0.147039)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.281250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
