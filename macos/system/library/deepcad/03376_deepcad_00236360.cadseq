# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236360" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.260526, 0.000000).circle(0.260526)
loop1=wp_sketch0.moveTo(0.314803, -0.059704).lineTo(0.314803, 0.059704).lineTo(0.200822, 0.059704).lineTo(0.200822, -0.059704).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.343750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, -0.460938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.117188, 0.000000).lineTo(0.117188, 0.117188).lineTo(0.000000, 0.117188).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.171875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
