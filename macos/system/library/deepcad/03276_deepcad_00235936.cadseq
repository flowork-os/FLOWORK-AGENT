# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00235936" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.threePointArc((0.200666, 0.211023), (0.479276, 0.295724)).lineTo(0.489474, -0.244737).threePointArc((0.499671, -0.303506), (0.509868, -0.244737)).lineTo(0.499671, 0.295724).threePointArc((0.764065, 0.230577), (0.968750, 0.050987)).threePointArc((0.470139, 0.295976), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.499671, -0.275329).circle(0.020395)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.750000, 0.015625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.001891, -0.179688).threePointArc((0.009457, -0.179734), (0.017023, -0.179688)).lineTo(0.015132, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.570312, 0.015625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.lineTo(0.006332, -0.544572).threePointArc((0.015831, -0.599313), (0.025329, -0.544572)).lineTo(0.012664, 0.000000).threePointArc((0.006332, 0.000039), (0.000000, 0.000000)).close()
loop4=wp_sketch2.moveTo(0.012664, -0.569901).circle(0.018997)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.015625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
