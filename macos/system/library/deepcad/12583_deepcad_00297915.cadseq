# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297915" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.118421, 0.000000).lineTo(0.118421, -0.173684).lineTo(0.118421, -0.292105).lineTo(0.457895, -0.292105).lineTo(0.457895, -0.347368).lineTo(0.118421, -0.347368).lineTo(0.118421, -0.402632).lineTo(0.592105, -0.402632).lineTo(0.750000, -0.402632).lineTo(0.750000, -0.173684).lineTo(0.292105, 0.055263).lineTo(0.000000, 0.055263).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.623684, -0.228947).circle(0.055263)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.115461, 0.000000).lineTo(0.115461, 0.059868).lineTo(0.115461, 0.115461).lineTo(0.115461, 0.230921).lineTo(0.115461, 0.406250).lineTo(0.000000, 0.406250).lineTo(0.000000, 0.230921).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.406250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
