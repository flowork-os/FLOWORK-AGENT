import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, -0.492188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.233224, 0.000000).lineTo(1.273438, 0.053618).lineTo(1.273438, 0.697039).lineTo(1.219819, 0.737253).lineTo(1.219819, 0.991941).lineTo(0.000000, 0.991941).lineTo(0.000000, 0.817681).lineTo(0.000000, 0.589803).lineTo(0.000000, 0.227878).lineTo(0.000000, 0.067023).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.254688, 0.053618).circle(0.026809)
loop2=wp_sketch0.moveTo(0.281497, 0.938322).circle(0.026809)
loop3=wp_sketch0.moveTo(1.219819, 0.147451).circle(0.026809)
loop4=wp_sketch0.moveTo(1.219819, 0.656826).circle(0.026809)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.281250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.112829, 0.000000).lineTo(0.112829, 0.218750).lineTo(0.000000, 0.218750).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.281250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.429688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.032813, 0.000000).lineTo(0.032813, 0.164062).lineTo(0.000000, 0.164062).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(0.281250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
