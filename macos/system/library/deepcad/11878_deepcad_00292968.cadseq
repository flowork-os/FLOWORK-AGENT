wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.085938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.005674, 0.000000).lineTo(0.005674, 0.088898).threePointArc((0.030442, 0.146800), (0.088898, 0.170230)).lineTo(0.179688, 0.170230).lineTo(0.179688, 0.175905).lineTo(0.088898, 0.175905).threePointArc((0.026429, 0.150813), (0.000000, 0.088898)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
