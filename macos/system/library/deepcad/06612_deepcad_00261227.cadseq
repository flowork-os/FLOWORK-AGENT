# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00261227" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.315789, 0.000000).circle(0.315789)
loop1=wp_sketch0.moveTo(0.401316, -0.217105).threePointArc((0.312500, 0.215512), (0.223684, -0.217105)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.281250, -0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.055921, 0.000000).threePointArc((0.146999, 0.038739), (0.181743, 0.131414)).threePointArc((0.147598, 0.225488), (0.055921, 0.265625)).lineTo(0.000000, 0.265625).threePointArc((0.028969, 0.132812), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.375000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.034040, -0.092957), (0.124836, -0.132401)).lineTo(0.179688, -0.132401).threePointArc((0.150808, 0.000000), (0.179688, 0.132401)).lineTo(0.124836, 0.132401).threePointArc((0.034040, 0.092957), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.375000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
