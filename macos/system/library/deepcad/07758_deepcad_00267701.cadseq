wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002023, -0.004885), (0.006908, -0.006908)).lineTo(0.102467, -0.006908).threePointArc((0.107352, -0.004885), (0.109375, 0.000000)).lineTo(0.109375, 0.094408).threePointArc((0.107590, 0.099868), (0.102467, 0.102467)).lineTo(0.006908, 0.102467).threePointArc((0.001785, 0.099868), (0.000000, 0.094408)).lineTo(0.000000, 0.000000).close()
