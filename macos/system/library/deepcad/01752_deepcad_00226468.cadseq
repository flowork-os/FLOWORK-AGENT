import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.460938, 0.000000).lineTo(0.460938, 0.067928).lineTo(0.000000, 0.067928).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, -0.054688, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.070312, 0.000000).lineTo(0.070312, 0.023684).lineTo(0.034786, 0.023684).lineTo(0.034786, 0.070312).lineTo(0.000000, 0.070312).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.695312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.164062, -0.054688, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.070312, 0.000000).lineTo(0.070312, 0.070312).lineTo(0.035526, 0.070312).lineTo(0.035526, 0.023684).lineTo(0.000000, 0.023684).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.695312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.117188, 0.000000, -0.023438), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.234375, 0.000000).lineTo(0.234375, 0.046875).lineTo(0.000000, 0.046875).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.031250)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.101562, -0.031250, -0.007812), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.210938, 0.000000).lineTo(0.210938, 0.024424).lineTo(0.000000, 0.024424).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.031250)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
