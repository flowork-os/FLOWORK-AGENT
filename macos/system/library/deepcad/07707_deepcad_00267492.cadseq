# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267492" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.734211, 0.000000).circle(0.734211)
loop1=wp_sketch0.moveTo(0.734211, 0.000000).circle(0.581250)
loop2=wp_sketch0.moveTo(0.780099, 0.611842).lineTo(0.780099, 0.688322).lineTo(0.627138, 0.688322).lineTo(0.627138, 0.611842).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.289062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, 0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.156250, 0.000000).lineTo(0.156250, 0.088816).lineTo(0.000000, 0.088816).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.585938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
