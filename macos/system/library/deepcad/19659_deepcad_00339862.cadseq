# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, 0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.022930, -0.055359), (0.078289, -0.078289)).lineTo(0.195724, -0.078289).lineTo(0.733964, -0.078289).lineTo(0.851398, -0.078289).threePointArc((0.906757, -0.055359), (0.929687, 0.000000)).lineTo(0.929687, 0.293586).lineTo(0.000000, 0.293586).lineTo(0.000000, 0.000000).close()
