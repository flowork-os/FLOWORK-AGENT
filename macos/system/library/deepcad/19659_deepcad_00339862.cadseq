loop2=wp_sketch0.moveTo(0.078289, 0.000000).circle(0.039145)
loop3=wp_sketch0.moveTo(0.851398, 0.176151).circle(0.058717)
loop4=wp_sketch0.moveTo(0.851398, 0.000000).circle(0.039145)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.046875)
