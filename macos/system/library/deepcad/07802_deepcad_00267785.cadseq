# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267785" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.102632, 0.000000).circle(0.102632)
loop1=wp_sketch0.moveTo(0.085526, 0.074836).threePointArc((0.035931, 0.037979), (0.029934, -0.023520)).close()
loop2=wp_sketch0.moveTo(0.029934, -0.023520).threePointArc((0.092647, -0.068606), (0.164638, -0.040625)).lineTo(0.038487, -0.040625).close()
loop3=wp_sketch0.moveTo(0.147533, -0.021382).lineTo(0.102632, 0.059868).lineTo(0.055592, -0.021382).close()
loop4=wp_sketch0.moveTo(0.109046, 0.074836).lineTo(0.109046, 0.087664).lineTo(0.094079, 0.087664).lineTo(0.094079, 0.074836).close()
loop5=wp_sketch0.moveTo(0.173191, -0.023520).threePointArc((0.167194, 0.037979), (0.117599, 0.074836)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch1.moveTo(0.015625, 0.000000).lineTo(0.015625, 0.014638).lineTo(0.000000, 0.014638).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop6).extrude(0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
