# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00386962" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, 0.359375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.197368, 0.000000).circle(0.197368)
loop1=wp_sketch0.moveTo(0.197368, 0.000000).circle(0.098684)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.781250, 0.000000).lineTo(0.781250, 0.386513).threePointArc((0.390625, 0.777138), (0.000000, 0.386513)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.394737, 0.386513).circle(0.197368)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.117188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, -0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.197368, 0.000000).lineTo(0.197368, 0.148026).lineTo(0.583882, 0.148026).lineTo(0.583882, 0.000000).lineTo(0.781250, 0.000000).lineTo(0.781250, 0.296053).lineTo(0.000000, 0.296053).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.390625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
