wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.047368, 0.000000).threePointArc((0.050329, 0.002961), (0.047368, 0.005921)).lineTo(0.005921, 0.005921).lineTo(0.005921, 0.087829).lineTo(0.047368, 0.087829).threePointArc((0.050329, 0.090789), (0.047368, 0.093750)).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
