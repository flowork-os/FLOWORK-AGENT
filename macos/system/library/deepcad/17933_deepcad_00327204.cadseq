# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00327204" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.226562, -0.265625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.503133, 0.470202), (0.038487, 0.044901)).lineTo(0.397697, -0.487500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(-0.230921, 0.262993).circle(0.301480)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
