# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00303683" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.523438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.836842).lineTo(0.000000, 0.836842).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.189474, 0.521053).circle(0.078947)
loop2=wp_sketch0.moveTo(0.568421, 0.521053).circle(0.078947)
loop3=wp_sketch0.moveTo(0.757895, 0.694737).circle(0.047368)
loop4=wp_sketch0.moveTo(0.931579, 0.521053).circle(0.078947)
loop5=wp_sketch0.moveTo(1.310526, 0.521053).circle(0.078947)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.750000, -0.085938, -0.523438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch1.moveTo(0.085938, 0.000000).lineTo(0.085938, 0.064227).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop6).extrude(-1.000000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.750000, 0.000000, -0.460938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop7=wp_sketch2.moveTo(0.585938, 0.437911).lineTo(0.450247, 0.437911).lineTo(0.000000, 0.104852).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop7).extrude(-1.000000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
