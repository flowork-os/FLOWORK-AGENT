loop0=wp_sketch0.moveTo(0.005263, 0.000000).threePointArc((0.007059, 0.000836), (0.007895, 0.002632)).lineTo(0.018421, 0.057895).threePointArc((0.023916, 0.067353), (0.034211, 0.071053)).lineTo(0.215789, 0.071053).threePointArc((0.226084, 0.067353), (0.231579, 0.057895)).lineTo(0.242105, 0.002632).threePointArc((0.242941, 0.000836), (0.244737, 0.000000)).lineTo(0.250000, 0.000000).lineTo(0.250000, 0.089474).lineTo(0.000000, 0.089474).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0

