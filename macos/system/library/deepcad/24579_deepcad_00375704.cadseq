import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.050000, 0.000000).lineTo(0.050000, 0.148438).lineTo(0.000000, 0.148438).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.037747, 0.000000).lineTo(0.037747, 0.070312).lineTo(0.000000, 0.070312).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.070312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.324645, 0.060444), (0.000000, 0.120888)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.158882, 0.062171).circle(0.086349)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.070312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.047368, 0.000000).lineTo(0.118421, 0.000000).lineTo(0.157895, 0.000000).lineTo(0.205263, 0.000000).lineTo(0.276316, 0.000000).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.118421).lineTo(0.000000, 0.118421).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.070312)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.032566, -0.070312).lineTo(0.065872, 0.000000).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(0.070312)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
