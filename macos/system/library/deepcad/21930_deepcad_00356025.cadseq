# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00356025" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.484375, 0.000000, -0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.038980, -0.077961).threePointArc((-1.125580, 0.298849), (0.038980, 0.675658)).lineTo(0.000000, 0.597697).lineTo(0.000000, 0.493750).lineTo(0.038980, 0.402796).lineTo(0.194901, 0.402796).lineTo(0.246875, 0.493750).threePointArc((-1.188161, 0.298849), (0.246875, 0.103947)).lineTo(0.194901, 0.194901).lineTo(0.038980, 0.194901).lineTo(0.000000, 0.103947).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.090954, 0.090954).circle(0.064967)
loop2=wp_sketch0.moveTo(0.090954, 0.506743).circle(0.064967)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.054688, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
