import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, 0.000000, 0.531250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.050658, 0.000000).circle(0.050658)
loop1=wp_sketch0.moveTo(0.215296, -0.177303).threePointArc((0.269027, -0.199559), (0.291283, -0.253289)).lineTo(0.291283, -1.025822).threePointArc((0.481407, -1.207688), (0.658553, -1.013158)).lineTo(0.658553, -0.253289).threePointArc((0.680809, -0.199559), (0.734539, -0.177303)).lineTo(0.899178, -0.177303).threePointArc((1.076480, 0.000000), (0.899178, 0.177303)).lineTo(0.050658, 0.177303).threePointArc((0.227961, 0.000000), (0.050658, -0.177303)).close()
loop2=wp_sketch0.moveTo(0.468586, 0.000000).circle(0.050658)
loop3=wp_sketch0.moveTo(0.468586, -1.013158).circle(0.037993)
loop4=wp_sketch0.moveTo(0.468586, -0.658553).circle(0.037993)
loop5=wp_sketch0.moveTo(0.899178, 0.000000).circle(0.050658)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
