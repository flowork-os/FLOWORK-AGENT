# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00371311" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.394737, 1.278947).circle(0.063158)
loop2=wp_sketch0.moveTo(0.836842, 0.394737).circle(0.063158)
loop3=wp_sketch0.moveTo(1.373684, 0.884211).lineTo(1.373684, 1.278947).lineTo(0.836842, 1.278947).lineTo(0.836842, 0.884211).close()
loop4=wp_sketch0.moveTo(1.294737, 0.205263).lineTo(1.294737, 0.600000).lineTo(0.994737, 0.600000).lineTo(0.994737, 0.205263).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
