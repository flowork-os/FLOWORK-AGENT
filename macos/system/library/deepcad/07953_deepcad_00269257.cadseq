# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00269257" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.063158, -0.063158).lineTo(1.436842, -0.063158).lineTo(1.500000, 0.000000).lineTo(1.342105, 0.000000).threePointArc((1.302632, 0.039474), (1.263158, 0.000000)).lineTo(0.757895, 0.000000).lineTo(0.236842, 0.000000).threePointArc((0.197368, -0.039474), (0.157895, 0.000000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.294737, 0.000000).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.039474, 0.000000).circle(0.039474)
loop3=wp_sketch1.moveTo(0.039474, 0.000000).circle(0.017270)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.039062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.016398, -0.006792), (0.023191, -0.023191)).lineTo(0.556579, -0.023191).lineTo(1.078372, -0.023191).threePointArc((1.085164, -0.006792), (1.101562, 0.000000)).lineTo(1.101562, 0.023191).lineTo(0.000000, 0.023191).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.039062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
