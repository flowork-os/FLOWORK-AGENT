loop3=wp_sketch3.moveTo(1.015954, 0.000000).threePointArc((1.109081, 0.321135), (1.015954, 0.642270)).lineTo(0.000000, 0.642270).threePointArc((-0.093127, 0.321135), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(-0.078125)
