# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00234760" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, -0.531250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.089474, 0.000000).lineTo(0.973026, 0.000000).lineTo(1.062500, 0.000000).lineTo(1.062500, 1.062500).lineTo(0.603947, 1.062500).lineTo(0.603947, 0.536842).lineTo(0.458553, 0.536842).lineTo(0.458553, 1.062500).lineTo(0.000000, 1.062500).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.882812, 0.000000).lineTo(0.882812, 0.223026).lineTo(0.000000, 0.223026).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.132812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
