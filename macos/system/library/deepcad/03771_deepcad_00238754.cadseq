# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00238754" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.695312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.389474).lineTo(0.000000, 1.389474).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.157895, 0.047368).lineTo(0.157895, 0.110526).lineTo(0.047368, 0.110526).lineTo(0.047368, 0.047368).close()
loop2=wp_sketch0.moveTo(0.157895, 1.294737).lineTo(0.157895, 1.342105).lineTo(0.047368, 1.342105).lineTo(0.047368, 1.294737).close()
loop3=wp_sketch0.moveTo(1.452632, 0.047368).lineTo(1.452632, 0.110526).lineTo(1.342105, 0.110526).lineTo(1.342105, 0.047368).close()
loop4=wp_sketch0.moveTo(1.452632, 1.294737).lineTo(1.452632, 1.342105).lineTo(1.342105, 1.342105).lineTo(1.342105, 1.294737).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
