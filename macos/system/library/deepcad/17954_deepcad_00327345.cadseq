import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.734375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004143, -0.010002), (0.014145, -0.014145)).lineTo(1.329605, -0.014145).threePointArc((1.339607, -0.010002), (1.343750, 0.000000)).lineTo(1.343750, 1.103289).threePointArc((1.339607, 1.113291), (1.329605, 1.117434)).lineTo(0.014145, 1.117434).threePointArc((0.004143, 1.113291), (0.000000, 1.103289)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
