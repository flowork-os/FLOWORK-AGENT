# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239415" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.303947, 0.000000).circle(0.303947)
loop1=wp_sketch0.moveTo(0.303947, 0.000000).circle(0.291283)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.292105, 0.000000).circle(0.292105)
solid1=wp_sketch1.add(loop2).extrude(-0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.304688, -0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.079112, 0.000000).lineTo(0.101562, 0.000000).lineTo(0.101562, 0.032072).lineTo(0.000000, 0.032072).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.039062, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.375000, -0.523438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.021793, 0.000000).lineTo(0.021793, 0.414062).lineTo(0.000000, 0.414062).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.039062, both=True)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.304688, -0.554688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.101562, 0.000000).lineTo(0.101562, 0.033141).lineTo(0.078043, 0.033141).lineTo(0.000000, 0.033141).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(0.039062, both=True)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
