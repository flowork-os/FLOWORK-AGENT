# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220915" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.386842, 0.000000).circle(0.386842)
loop1=wp_sketch0.moveTo(0.386842, 0.000000).circle(0.290132)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.460938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.382812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.000000, 0.000000).threePointArc((0.762231, 0.087992), (0.631579, 0.305263)).lineTo(0.242105, 0.305263).lineTo(0.242105, 0.452632).lineTo(0.621053, 0.452632).threePointArc((0.752935, 0.679635), (1.000000, 0.768421)).lineTo(0.000000, 0.768421).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.156250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
