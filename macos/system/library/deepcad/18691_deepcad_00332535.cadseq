# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00332535" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.150000, 0.000000).circle(0.150000)
loop1=wp_sketch0.moveTo(0.150000, 0.000000).circle(0.087500)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, -0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.485197, -0.029112).threePointArc((0.564950, -0.048134), (0.630757, -0.097039)).lineTo(0.786020, -0.281414).threePointArc((0.886608, -0.299755), (0.921875, -0.203783)).lineTo(0.786020, 0.155263).threePointArc((0.566369, -0.016524), (0.640461, 0.252303)).lineTo(0.000000, 0.213487).threePointArc((-0.100387, 0.106743), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.009704, 0.106743).circle(0.058224)
loop4=wp_sketch1.moveTo(0.844243, -0.232895).circle(0.048520)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).extrude(0.101562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch2.moveTo(0.150000, 0.000000).circle(0.150000)
loop6=wp_sketch2.moveTo(0.150000, 0.000000).circle(0.087500)
solid2=wp_sketch2.add(loop5).add(loop6).extrude(0.273438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
