import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, 0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.957895, 0.000000).threePointArc((0.987668, 0.012332), (1.000000, 0.042105)).lineTo(1.000000, 0.273684).threePointArc((0.959920, 0.370446), (0.863158, 0.410526)).lineTo(0.726316, 0.410526).threePointArc((0.694363, 0.392931), (0.684211, 0.357895)).lineTo(0.684211, 0.189474).lineTo(0.494737, 0.189474).threePointArc((0.459701, 0.199626), (0.442105, 0.231579)).lineTo(0.442105, 0.410526).threePointArc((0.402025, 0.507288), (0.305263, 0.547368)).lineTo(0.042105, 0.547368).threePointArc((0.012332, 0.535036), (0.000000, 0.505263)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, -0.484375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.586678, 0.000000).threePointArc((0.652446, 0.027242), (0.679688, 0.093010)).lineTo(0.679688, 0.543750).lineTo(0.000000, 0.271875).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.200329, 0.178865).circle(0.135937)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.226562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
