# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.257812, 0.000000, 0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch5.moveTo(0.343750, 0.000000).threePointArc((0.247563, 0.034972), (0.195395, 0.123026)).lineTo(0.039803, 0.123026).threePointArc((0.026341, 0.059430), (0.000000, 0.000000)).close()
