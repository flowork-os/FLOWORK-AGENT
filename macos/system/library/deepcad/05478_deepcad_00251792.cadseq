loop3=wp_sketch3.moveTo(0.156250, 0.000000).threePointArc((0.153253, 0.030428), (0.156250, 0.060855)).lineTo(0.000000, 0.060855).threePointArc((0.001495, 0.030428), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(0.117188, both=True)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.257812, 0.000000, 0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.026341, -0.059430), (0.039803, -0.123026)).lineTo(0.195395, -0.123026).threePointArc((0.247563, -0.034972), (0.343750, 0.000000)).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.031250, both=True)
