wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.142105, 0.000000).lineTo(0.142105, 0.142105).threePointArc((0.169853, 0.209094), (0.236842, 0.236842)).lineTo(0.513158, 0.236842).threePointArc((0.580147, 0.209094), (0.607895, 0.142105)).lineTo(0.607895, 0.000000).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.142105).threePointArc((0.680631, 0.309578), (0.513158, 0.378947)).lineTo(0.236842, 0.378947).threePointArc((0.069369, 0.309578), (0.000000, 0.142105)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
