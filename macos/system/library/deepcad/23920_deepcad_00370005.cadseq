wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009249, -0.022330), (0.031579, -0.031579)).lineTo(0.631579, -0.031579).threePointArc((0.715315, 0.003106), (0.750000, 0.086842)).lineTo(0.750000, 0.142105).threePointArc((0.715315, 0.225842), (0.631579, 0.260526)).lineTo(0.031579, 0.260526).threePointArc((0.009249, 0.251277), (0.000000, 0.228947)).lineTo(0.000000, 0.000000).close()
