# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00352546" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.000000, 0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.718750, 0.000000).lineTo(0.718750, 0.506908).lineTo(0.000000, 0.506908).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.105921, 0.400987).circle(0.030263)
loop2=wp_sketch0.moveTo(0.219408, 0.400987).circle(0.030263)
loop3=wp_sketch0.moveTo(0.476645, 0.348026).lineTo(0.476645, 0.446382).lineTo(0.378289, 0.446382).lineTo(0.378289, 0.348026).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
