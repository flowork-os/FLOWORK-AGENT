# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285051" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.025905, 0.002878).threePointArc((0.135745, 0.136719), (0.025905, 0.270559)).lineTo(0.000000, 0.273438).threePointArc((-0.136719, 0.136719), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.138158).circle(0.103618)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.210938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, -0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.664062, 0.069901).threePointArc((0.597656, 0.136308), (0.664062, 0.202714)).lineTo(0.000000, 0.272615).threePointArc((0.111865, 0.136308), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.454359, 0.097862).threePointArc((0.419408, 0.132812), (0.454359, 0.167763)).lineTo(0.181743, 0.167763).threePointArc((0.146793, 0.132812), (0.181743, 0.097862)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.140625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.007812, 0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.071053, 0.000000).circle(0.071053)
loop5=wp_sketch2.moveTo(0.071053, 0.000000).circle(0.035526)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.171875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
