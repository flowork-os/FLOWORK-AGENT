wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.039474, 0.000000).threePointArc((0.134211, 0.094737), (0.228947, 0.000000)).lineTo(0.386842, 0.000000).threePointArc((0.481579, 0.094737), (0.576316, 0.000000)).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.134211).lineTo(0.000000, 0.134211).lineTo(0.000000, 0.000000).close()
