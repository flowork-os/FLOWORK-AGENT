import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002329, -0.002358), (0.004687, -0.004687)).lineTo(0.440625, -0.004687).threePointArc((0.442983, -0.002358), (0.445312, 0.000000)).lineTo(0.445312, 0.435937).threePointArc((0.442983, 0.438296), (0.440625, 0.440625)).lineTo(0.004687, 0.440625).threePointArc((0.002329, 0.438296), (0.000000, 0.435937)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.435937, 0.126562).lineTo(0.435937, 0.267187).lineTo(0.009375, 0.267187).lineTo(0.009375, 0.126562).close()
loop2=wp_sketch0.moveTo(0.435937, 0.290625).lineTo(0.435937, 0.431250).lineTo(0.009375, 0.431250).lineTo(0.009375, 0.290625).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
