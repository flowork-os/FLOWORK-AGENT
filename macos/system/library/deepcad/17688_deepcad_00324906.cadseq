loop0=wp_sketch0.moveTo(0.054687, 0.000000).lineTo(0.054687, 0.002878).threePointArc((0.053844, 0.004914), (0.051809, 0.005757)).lineTo(0.010937, 0.005757).threePointArc((0.007274, 0.007274), (0.005757, 0.010937)).lineTo(0.005757, 0.029934).threePointArc((0.004914, 0.031969), (0.002878, 0.032812)).lineTo(0.000000, 0.032812).lineTo(0.000000, 0.005757).lineTo(0.000000, 0.000000).close()
