import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.565028, -0.315008), (0.544737, 0.331579)).threePointArc((0.330544, 0.070216), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.378947, 0.000000).circle(0.078947)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
