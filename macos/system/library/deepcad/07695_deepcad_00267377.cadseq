solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).extrude(0.039062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch2.moveTo(0.150740, -0.247368).threePointArc((0.280614, -0.135982), (0.367188, 0.011595)).threePointArc((0.182066, 0.054187), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop5).extrude(0.039062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.169838, 0.007108), (0.328125, 0.069079)).lineTo(0.179605, 0.317763).threePointArc((0.047926, 0.182551), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop6).extrude(0.039062)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch4.moveTo(0.757895, 0.000000).circle(0.757895)
loop8=wp_sketch4.moveTo(0.442105, 0.521053).circle(0.078947)
loop9=wp_sketch4.moveTo(0.757895, 0.000000).circle(0.378947)
solid4=wp_sketch4.add(loop7).add(loop8).add(loop9).extrude(0.039062)
