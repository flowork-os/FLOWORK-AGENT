import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.218750, -0.023438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.214145, 0.000000).lineTo(0.214145, -0.377303).lineTo(0.775000, -0.377303).lineTo(0.968750, -0.183553).lineTo(0.948355, -0.163158).lineTo(0.764803, -0.346711).lineTo(0.244737, -0.346711).lineTo(0.244737, 0.244737).lineTo(0.214145, 0.244737).lineTo(0.214145, 0.020395).lineTo(0.000000, 0.020395).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
