# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00227442" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.157895, 0.157895).circle(0.063158)
loop2=wp_sketch0.moveTo(0.157895, 1.357895).circle(0.063158)
loop3=wp_sketch0.moveTo(1.357895, 0.157895).circle(0.063158)
loop4=wp_sketch0.moveTo(1.357895, 1.357895).circle(0.063158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.109375, 0.062500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.226562, 0.000000).lineTo(0.226562, 0.217023).lineTo(0.000000, 0.217023).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, -0.289062, 0.062500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.625000, 0.000000).lineTo(0.625000, 0.210526).lineTo(0.625000, 0.375000).lineTo(0.625000, 0.585526).lineTo(0.000000, 0.585526).lineTo(0.000000, 0.375000).lineTo(0.000000, 0.210526).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch2.moveTo(0.585526, 0.039474).lineTo(0.585526, 0.539474).lineTo(0.039474, 0.539474).lineTo(0.039474, 0.039474).close()
solid2=wp_sketch2.add(loop6).add(loop7).extrude(0.250000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, -0.085938, 0.062500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch3.moveTo(0.101891, 0.000000).lineTo(0.101891, 0.164062).lineTo(0.000000, 0.164062).threePointArc((-0.082031, 0.082031), (0.000000, 0.000000)).close()
loop9=wp_sketch3.moveTo(0.000000, 0.082895).circle(0.031086)
solid3=wp_sketch3.add(loop8).add(loop9).extrude(0.250000)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.312500, -0.085938, 0.062500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop10=wp_sketch4.moveTo(0.104605, 0.000000).threePointArc((0.187500, 0.082895), (0.104605, 0.165789)).lineTo(0.000000, 0.165789).lineTo(0.000000, 0.000000).close()
loop11=wp_sketch4.moveTo(0.104605, 0.082895).circle(0.031579)
solid4=wp_sketch4.add(loop10).add(loop11).extrude(0.250000)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
