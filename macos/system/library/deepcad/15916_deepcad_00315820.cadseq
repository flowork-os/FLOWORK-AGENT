wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.312500, -0.148438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.625000, 0.000000).lineTo(0.625000, 0.230263).threePointArc((0.608222, 0.264190), (0.572368, 0.276316)).lineTo(0.572368, 0.072368).lineTo(0.526316, 0.072368).lineTo(0.526316, 0.256579).threePointArc((0.518030, 0.256455), (0.513158, 0.263158)).lineTo(0.032895, 0.085526).threePointArc((0.009153, 0.067711), (0.000000, 0.039474)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
