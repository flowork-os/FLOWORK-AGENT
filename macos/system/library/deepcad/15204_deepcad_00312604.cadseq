import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.041447, -0.562500).threePointArc((0.060874, -0.497596), (0.118421, -0.461842)).threePointArc((0.136184, -0.442243), (0.153947, -0.461842)).threePointArc((0.208534, -0.498717), (0.225000, -0.562500)).lineTo(0.266447, 0.000000).threePointArc((0.133224, -0.067059), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.136184, -0.367105).circle(0.017763)
loop2=wp_sketch0.moveTo(0.136184, -0.278289).circle(0.017763)
loop3=wp_sketch0.moveTo(0.136184, -0.183553).circle(0.017763)
loop4=wp_sketch0.moveTo(0.136184, -0.088816).circle(0.017763)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.562500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.018750, -0.190372), (0.037500, 0.000000)).threePointArc((0.018750, -0.016994), (0.000000, 0.000000)).close()
loop6=wp_sketch1.moveTo(0.019737, -0.092763).circle(0.019737)
solid1=wp_sketch1.add(loop5).add(loop6).extrude(0.093750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
