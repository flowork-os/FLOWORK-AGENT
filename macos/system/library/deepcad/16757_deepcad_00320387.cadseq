# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00320387" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.189474, 1.057895).lineTo(0.347368, 0.963158).lineTo(0.505263, 1.057895).lineTo(0.505263, 1.247368).lineTo(0.347368, 1.326316).lineTo(0.189474, 1.231579).close()
loop2=wp_sketch0.moveTo(1.200000, 1.294737).circle(0.110526)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.601562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
