# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236990" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.205263, 0.000000).lineTo(0.205263, 0.647368).threePointArc((0.102632, 0.750000), (0.000000, 0.647368)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.102632, 0.647368).circle(0.071053)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, 0.476562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.051563, 0.000000).lineTo(0.051563, -0.090625).lineTo(0.096875, -0.090625).lineTo(0.096875, 0.000000).lineTo(0.148438, 0.000000).lineTo(0.148438, 0.034375).lineTo(0.096875, 0.034375).lineTo(0.096875, 0.081250).lineTo(0.051563, 0.081250).lineTo(0.051563, 0.034375).lineTo(0.000000, 0.034375).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.023438)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
