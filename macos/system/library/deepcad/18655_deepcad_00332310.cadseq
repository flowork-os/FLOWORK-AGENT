# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.382812, 0.507812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.038651, -0.085033).lineTo(0.007730, -0.197122).lineTo(0.065707, -0.143010).lineTo(0.166201, -0.220312).lineTo(0.286020, -0.220312).lineTo(0.367188, -0.143010).lineTo(0.258964, -0.143010).lineTo(0.363322, -0.038651).lineTo(0.324671, -0.003865).lineTo(0.286020, 0.030921).lineTo(0.224178, 0.030921).lineTo(0.119819, -0.011595).lineTo(0.065707, -0.065707).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
