wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000578, -0.001396), (0.001974, -0.001974)).lineTo(0.044901, -0.001974).threePointArc((0.046297, -0.001396), (0.046875, 0.000000)).lineTo(0.046875, 0.042928).threePointArc((0.046297, 0.044323), (0.044901, 0.044901)).lineTo(0.001974, 0.044901).threePointArc((0.000578, 0.044323), (0.000000, 0.042928)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002323, -0.000673), (0.004441, 0.000493)).lineTo(0.042434, 0.000493).threePointArc((0.043830, 0.001071), (0.044408, 0.002467)).lineTo(0.044408, 0.040954).threePointArc((0.043728, 0.042103), (0.042434, 0.042434)).lineTo(0.004441, 0.042434).threePointArc((0.003147, 0.042103), (0.002467, 0.040954)).lineTo(0.002467, 0.002467).close()
