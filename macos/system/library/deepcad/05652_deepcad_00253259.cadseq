wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.000000, 0.640625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.423191, 0.000000).threePointArc((0.471455, -0.019992), (0.491447, -0.068257)).lineTo(0.491447, -0.600658).lineTo(0.819079, -1.174013).lineTo(1.296875, -0.709868).lineTo(0.491447, 0.109211).lineTo(0.000000, 0.109211).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
