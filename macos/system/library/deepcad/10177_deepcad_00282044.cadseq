wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001590, -0.003838), (0.005428, -0.005428)).lineTo(0.080510, -0.005428).threePointArc((0.084348, -0.003838), (0.085938, 0.000000)).lineTo(0.085938, 0.075082).threePointArc((0.084348, 0.078920), (0.080510, 0.080510)).lineTo(0.005428, 0.080510).threePointArc((0.001590, 0.078920), (0.000000, 0.075082)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.007347, -0.001453), (0.013569, 0.002714)).lineTo(0.072368, 0.002714).threePointArc((0.076206, 0.004304), (0.077796, 0.008141)).lineTo(0.077796, 0.066941).threePointArc((0.076206, 0.070779), (0.072368, 0.072368)).lineTo(0.013569, 0.072368).threePointArc((0.009731, 0.070779), (0.008141, 0.066941)).lineTo(0.008141, 0.008141).close()
