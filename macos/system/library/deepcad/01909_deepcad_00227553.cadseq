# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00227553" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.085938, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.573191, 0.174753).threePointArc((0.666507, 0.300576), (0.573191, 0.426398)).lineTo(0.000000, 0.594161).threePointArc((0.220330, 0.297081), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.531250, 0.300576).circle(0.076891)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.234375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.311842, 0.000000).circle(0.311842)
loop3=wp_sketch1.moveTo(0.311842, 0.000000).circle(0.181908)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.460938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
