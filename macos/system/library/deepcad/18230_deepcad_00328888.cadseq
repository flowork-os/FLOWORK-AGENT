# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00328888" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.000000, -0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.092105, 0.000000).threePointArc((1.295138, 0.211765), (1.078454, 0.409539)).lineTo(0.000000, 0.409539).threePointArc((-0.207298, 0.204770), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(1.092105, 0.040954).threePointArc((1.264854, 0.211595), (1.092105, 0.382237)).lineTo(0.000000, 0.382237).threePointArc((0.170641, 0.211595), (0.000000, 0.040954)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
