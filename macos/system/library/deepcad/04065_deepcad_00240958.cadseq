# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00240958" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.753947, 0.000000).circle(0.753947)
loop1=wp_sketch0.moveTo(0.753947, 0.000000).circle(0.706826)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.296875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.165789, 0.000000).circle(0.165789)
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.184466, -0.184551), (0.269408, 0.062171)).lineTo(0.165789, 0.062171).lineTo(0.058717, 0.062171).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.296875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.088076, 0.093257).threePointArc((0.053605, 0.028908), (0.020724, -0.036266)).lineTo(0.492187, 0.238322).threePointArc((0.480712, 0.255819), (0.471464, 0.274589)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.296875)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.020148, -0.001238), (0.040296, 0.000000)).lineTo(0.040296, 0.546875).threePointArc((0.020148, 0.547122), (0.000000, 0.546875)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.296875)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.132812, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch4.moveTo(0.471464, -0.274589).threePointArc((0.481603, -0.256328), (0.492187, -0.238322)).lineTo(0.020724, 0.036266).threePointArc((0.011476, 0.017497), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop6).extrude(0.296875)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
