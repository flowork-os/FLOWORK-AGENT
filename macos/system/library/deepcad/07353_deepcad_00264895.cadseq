wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.018499, -0.044659), (0.063158, -0.063158)).lineTo(1.436842, -0.063158).threePointArc((1.481501, -0.044659), (1.500000, 0.000000)).lineTo(1.500000, 0.268421).threePointArc((1.478231, 0.305186), (1.436842, 0.315789)).lineTo(0.063158, 0.315789).threePointArc((0.021769, 0.305186), (0.000000, 0.268421)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.189474, 0.126316).circle(0.031579)
loop2=wp_sketch0.moveTo(0.568421, 0.126316).circle(0.031579)
loop3=wp_sketch0.moveTo(0.931579, 0.126316).circle(0.031579)
loop4=wp_sketch0.moveTo(1.310526, 0.126316).circle(0.031579)
