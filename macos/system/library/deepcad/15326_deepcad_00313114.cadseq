# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00313114" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.205263, 0.000000).lineTo(0.205263, 0.544737).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.094737, 0.102632).lineTo(0.094737, 0.165789).lineTo(0.039474, 0.165789).lineTo(0.039474, 0.102632).close()
loop2=wp_sketch0.moveTo(0.094737, 0.307895).lineTo(0.094737, 0.371053).lineTo(0.039474, 0.371053).lineTo(0.039474, 0.307895).close()
loop3=wp_sketch0.moveTo(0.094737, 0.513158).lineTo(0.094737, 0.576316).lineTo(0.039474, 0.576316).lineTo(0.039474, 0.513158).close()
loop4=wp_sketch0.moveTo(0.150000, 0.197368).circle(0.015789)
loop5=wp_sketch0.moveTo(0.150000, 0.465789).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.007812, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
