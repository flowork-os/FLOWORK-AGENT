loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.003131, -0.007560), (0.010691, -0.010691)).lineTo(0.091941, -0.010691).threePointArc((0.098966, -0.007338), (0.101562, 0.000000)).lineTo(0.101562, 0.081250).threePointArc((0.098966, 0.088588), (0.091941, 0.091941)).lineTo(0.010691, 0.091941).threePointArc((0.003131, 0.088810), (0.000000, 0.081250)).lineTo(0.000000, 0.000000).close()
