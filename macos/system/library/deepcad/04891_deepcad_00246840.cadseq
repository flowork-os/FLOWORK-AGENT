# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00246840" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.240378, 0.000000).lineTo(0.240378, 0.289062).lineTo(0.000000, 0.289062).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.250000, 0.000000, 0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.187089, 0.000000).lineTo(0.187089, 0.273438).lineTo(0.000000, 0.273438).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.125000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.484375, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.051809, 0.000000).lineTo(0.051809, 0.070312).lineTo(0.000000, 0.070312).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.125000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.000000, -0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.710938, 0.000000).lineTo(0.710938, 0.149671).lineTo(0.000000, 0.149671).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.125000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
