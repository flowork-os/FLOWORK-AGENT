import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001156, -0.002791), (0.003947, -0.003947)).lineTo(0.055263, -0.003947).threePointArc((0.058054, -0.002791), (0.059211, 0.000000)).lineTo(0.059211, 0.343421).lineTo(0.071053, 0.363158).threePointArc((0.071333, 0.365132), (0.071053, 0.367105)).lineTo(0.071053, 0.371053).threePointArc((0.069896, 0.373844), (0.067105, 0.375000)).lineTo(0.003947, 0.375000).threePointArc((0.001156, 0.373844), (0.000000, 0.371053)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
