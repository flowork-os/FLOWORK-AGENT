import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.476562, 0.000000).lineTo(0.476562, 0.115378).lineTo(0.446464, 0.115378).threePointArc((0.396299, 0.065214), (0.346135, 0.115378)).lineTo(0.290954, 0.115378).threePointArc((0.240789, 0.065214), (0.190625, 0.115378)).lineTo(0.130428, 0.115378).threePointArc((0.080263, 0.065214), (0.030099, 0.115378)).lineTo(0.000000, 0.115378).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.242188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.118421).lineTo(0.663158, 0.118421).threePointArc((0.615789, 0.071053), (0.568421, 0.118421)).lineTo(0.505263, 0.118421).threePointArc((0.453947, 0.067105), (0.402632, 0.118421)).lineTo(0.347368, 0.118421).threePointArc((0.296053, 0.067105), (0.244737, 0.118421)).lineTo(0.181579, 0.118421).threePointArc((0.134211, 0.071053), (0.086842, 0.118421)).lineTo(0.000000, 0.118421).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.671875, -0.382812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.502549, 0.000000).lineTo(0.502549, 0.757812).lineTo(0.000000, 0.757812).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.023438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
