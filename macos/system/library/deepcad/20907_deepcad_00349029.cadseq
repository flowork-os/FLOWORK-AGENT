wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, -0.578125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.020233, -0.048846), (0.069079, -0.069079)).lineTo(1.243421, -0.069079).threePointArc((1.292267, -0.048846), (1.312500, 0.000000)).lineTo(1.312500, 1.160526).threePointArc((1.295129, 1.216280), (1.243421, 1.243421)).lineTo(0.069079, 1.243421).threePointArc((0.017371, 1.216280), (0.000000, 1.160526)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.243421, 0.000000).lineTo(1.243421, 1.160526).lineTo(0.069079, 1.160526).lineTo(0.069079, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.773438)
solid=solid0

