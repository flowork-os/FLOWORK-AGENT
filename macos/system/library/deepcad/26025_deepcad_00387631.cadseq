loop7=wp_sketch3.moveTo(0.078947, 0.000000).threePointArc((0.098684, 0.133055), (0.118421, 0.000000)).lineTo(0.489474, 0.000000).threePointArc((0.548684, 0.129271), (0.607895, 0.000000)).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.252632).lineTo(0.000000, 0.252632).lineTo(0.000000, 0.000000).close()
