# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00262338" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.351562, 0.000000).lineTo(1.351562, 0.398355).lineTo(0.938980, 0.625987).lineTo(0.369901, 0.625987).lineTo(0.000000, 0.398355).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.664803, -0.169737).lineTo(1.343750, 0.000000).lineTo(1.343750, 0.212171).lineTo(0.000000, 0.212171).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.195312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.382812, 0.203125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.183553, 0.000000).lineTo(0.177632, 0.187500).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.500000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
