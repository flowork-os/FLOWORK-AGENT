import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.098684, 0.000000).threePointArc((1.298166, 0.192270), (1.098684, 0.384539)).lineTo(0.013734, 0.384539).threePointArc((-0.190181, 0.199307), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(1.098684, 0.013734).threePointArc((1.291042, 0.199137), (1.098684, 0.384539)).lineTo(0.013734, 0.384539).threePointArc((-0.183143, 0.206174), (0.000000, 0.013734)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
