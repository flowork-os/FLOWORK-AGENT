# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00228030" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.148026, -0.252878).lineTo(0.437911, -0.252878).lineTo(0.585938, 0.000000).lineTo(0.437911, 0.252878).lineTo(0.148026, 0.252878).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.160362, -0.234375).lineTo(0.425576, -0.234375).lineTo(0.561266, 0.000000).lineTo(0.425576, 0.234375).lineTo(0.160362, 0.234375).lineTo(0.024671, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
