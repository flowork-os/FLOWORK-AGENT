# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00366735" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, -0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.101562, 0.000000).lineTo(1.101562, 0.533388).lineTo(0.000000, 0.533388).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.417434, 0.324671).circle(0.150740)
loop2=wp_sketch0.moveTo(0.730510, 0.139145).lineTo(0.939227, 0.150740).lineTo(0.985609, 0.359457).lineTo(0.811678, 0.463816).lineTo(0.649342, 0.324671).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
