wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.000000, -0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.246957, -0.176204), (0.493914, 0.000000)).threePointArc((0.517510, 0.141118), (0.493914, 0.282237)).threePointArc((0.246957, 0.458441), (0.000000, 0.282237)).threePointArc((-0.023595, 0.141118), (0.000000, 0.000000)).close()
