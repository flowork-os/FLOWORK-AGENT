# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00281848" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.450000).lineTo(0.000000, 0.450000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.157895, 0.228947).circle(0.078947)
loop2=wp_sketch0.moveTo(0.615789, 0.150000).lineTo(0.615789, 0.300000).lineTo(0.465789, 0.300000).lineTo(0.465789, 0.150000).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.450000).lineTo(0.000000, 0.450000).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.157895, 0.228947).circle(0.078947)
loop5=wp_sketch1.moveTo(0.615789, 0.150000).lineTo(0.615789, 0.300000).lineTo(0.465789, 0.300000).lineTo(0.465789, 0.150000).close()
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.109375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
