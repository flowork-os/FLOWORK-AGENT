import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, -0.194490).lineTo(0.169737, -0.289967).lineTo(0.335938, -0.194490).lineTo(0.335938, 0.000000).lineTo(0.166201, 0.095477).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.063651, -0.155592).lineTo(0.169737, -0.215707).lineTo(0.272286, -0.155592).lineTo(0.272286, -0.038898).lineTo(0.166201, 0.021217).lineTo(0.063651, -0.038898).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.093750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
