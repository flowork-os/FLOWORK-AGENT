# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.041429, -0.100018), (0.141447, -0.141447)).lineTo(1.202303, -0.141447).threePointArc((1.302321, -0.100018), (1.343750, 0.000000)).lineTo(1.343750, 0.410197).threePointArc((1.299392, 0.503143), (1.202303, 0.537500)).lineTo(0.141447, 0.537500).threePointArc((0.044358, 0.503143), (0.000000, 0.410197)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
