# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00325748" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.054688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.059622, -0.059622).lineTo(0.114474, -0.004770).lineTo(0.166941, -0.059622).lineTo(0.226562, 0.000000).lineTo(0.171711, 0.054852).lineTo(0.226562, 0.107319).lineTo(0.166941, 0.166941).lineTo(0.114474, 0.114474).lineTo(0.059622, 0.166941).lineTo(0.000000, 0.107319).lineTo(0.054852, 0.054852).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.500000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.114474, 0.000000).circle(0.112089)
loop2=wp_sketch1.moveTo(0.114474, 0.000000).circle(0.028618)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.039062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.027632, 0.000000).circle(0.027632)
solid2=wp_sketch2.add(loop3).extrude(0.039062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
