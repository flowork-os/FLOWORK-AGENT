# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00248751" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.734375, 0.000000).lineTo(0.734375, 0.123684).lineTo(0.123684, 0.123684).lineTo(0.123684, 0.587500).lineTo(0.000000, 0.587500).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.515625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, 0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.125082, 0.000000).lineTo(0.125082, -0.458635).lineTo(0.736595, -0.458635).lineTo(0.736595, -0.583717).lineTo(1.320312, -0.583717).lineTo(1.320312, -0.152878).lineTo(0.361349, 0.111184).lineTo(0.000000, 0.111184).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(1.097944, -0.361349).circle(0.097286)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.125000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
