import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.671875, 0.000000).lineTo(0.671875, 0.042434).lineTo(0.530428, 0.183882).lineTo(0.000000, 0.183882).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.078125, -0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.530428, 0.000000).lineTo(0.671875, 0.141447).lineTo(0.671875, 0.183882).lineTo(0.000000, 0.183882).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.140625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.078125, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.671875, 0.000000).lineTo(0.671875, 0.113158).lineTo(0.000000, 0.113158).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.140625)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.119737, 0.000000).circle(0.119737)
loop4=wp_sketch3.moveTo(0.406250, -0.239474).lineTo(0.406250, -0.055592).lineTo(0.406250, 0.055592).lineTo(0.406250, 0.239474).lineTo(0.119737, 0.239474).threePointArc((0.359211, 0.000000), (0.119737, -0.239474)).close()
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.484375)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.078125, -0.257812, 0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.530428, 0.000000).lineTo(0.671875, 0.000000).lineTo(0.000000, 0.339474).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(-0.296875, both=True)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
