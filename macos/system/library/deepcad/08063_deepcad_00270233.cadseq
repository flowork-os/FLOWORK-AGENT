import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.035362, 0.000000).lineTo(0.035362, 0.198026).threePointArc((0.051933, 0.238034), (0.091941, 0.254605)).lineTo(0.579934, 0.254605).threePointArc((0.619942, 0.238034), (0.636513, 0.198026)).lineTo(0.636513, 0.000000).lineTo(0.671875, 0.000000).lineTo(0.671875, 0.289967).lineTo(0.000000, 0.289967).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.265625, 0.289062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.053289, -0.053289), (0.106579, 0.000000)).lineTo(0.106579, 0.134211).threePointArc((0.053289, 0.187500), (0.000000, 0.134211)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.117188)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, -0.406250, 0.289062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.053289, -0.053289), (0.106579, 0.000000)).lineTo(0.106579, 0.134211).threePointArc((0.053289, 0.187500), (0.000000, 0.134211)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.117188)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
