# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, 0.000000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.024342, 0.000000).lineTo(0.024342, 0.535526).lineTo(0.066941, 0.535526).lineTo(0.000000, 0.578125).lineTo(0.000000, 0.535526).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.101562, both=True)
