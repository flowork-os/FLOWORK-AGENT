# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00254180" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.059211, 0.000000).circle(0.059211)
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.011513, -0.017270).lineTo(0.143914, 0.057566).threePointArc((0.150044, 0.059698), (0.155428, 0.063322)).lineTo(0.385691, 0.063322).threePointArc((0.391074, 0.059698), (0.397204, 0.057566)).lineTo(0.535362, -0.023026).lineTo(0.546875, 0.000000).lineTo(0.408717, 0.080592).threePointArc((0.397577, 0.084962), (0.385691, 0.086349)).lineTo(0.161184, 0.086349).threePointArc((0.149298, 0.084962), (0.138158, 0.080592)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.390625, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
