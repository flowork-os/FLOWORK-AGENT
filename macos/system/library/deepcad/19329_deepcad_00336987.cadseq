wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.312500, -0.273438, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch4.moveTo(0.102632, 0.000000).circle(0.100493)
solid4=wp_sketch4.add(loop4).extrude(0.101562)
