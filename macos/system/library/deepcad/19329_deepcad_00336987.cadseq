wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, 0.273438, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch3.moveTo(0.102632, 0.000000).circle(0.100493)
solid3=wp_sketch3.add(loop3).extrude(0.101562)
