# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00218354" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.750000, -0.750000), (1.500000, 0.000000)).lineTo(1.342105, 0.000000).threePointArc((1.240560, 0.034910), (1.184211, 0.126316)).threePointArc((0.534862, 0.599811), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.694737, -0.094737).circle(0.189474)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
