wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.351562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.935444, 0.000000).lineTo(1.367188, -0.057566).lineTo(1.367188, 0.244655).lineTo(0.805921, 0.244655).lineTo(0.705181, 0.244655).lineTo(0.705181, 0.489309).lineTo(0.575658, 0.791530).lineTo(0.575658, 0.978618).lineTo(0.244655, 0.978618).lineTo(0.244655, 0.762747).lineTo(0.000000, 0.575658).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0

if __name__ == '__main__':
