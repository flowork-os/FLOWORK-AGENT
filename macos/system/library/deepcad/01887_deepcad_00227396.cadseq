# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00227396" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.264803, -0.264803).lineTo(0.633635, -0.264803).lineTo(0.898438, 0.000000).lineTo(0.898438, 0.368832).lineTo(0.633635, 0.633635).lineTo(0.264803, 0.633635).lineTo(0.000000, 0.368832).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.133553, -0.133553).lineTo(0.319572, -0.133553).lineTo(0.453125, 0.000000).lineTo(0.453125, 0.186020).lineTo(0.319572, 0.319572).lineTo(0.133553, 0.319572).lineTo(0.000000, 0.186020).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.281250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, -0.750000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.133553, -0.133553).lineTo(0.319572, -0.133553).lineTo(0.453125, 0.000000).lineTo(0.453125, 0.186020).lineTo(0.319572, 0.319572).lineTo(0.133553, 0.319572).lineTo(0.000000, 0.186020).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.281250)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
