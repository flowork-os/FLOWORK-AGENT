# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00286582" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.036266, 0.004030).threePointArc((0.190042, 0.191406), (0.036266, 0.378783)).lineTo(0.000000, 0.382813).threePointArc((-0.191406, 0.191406), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.193421).circle(0.145066)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.382812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.929687, 0.097862).threePointArc((0.836719, 0.190831), (0.929687, 0.283799)).lineTo(0.000000, 0.381661).threePointArc((0.156611, 0.190831), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.636102, 0.137007).threePointArc((0.587171, 0.185937), (0.636102, 0.234868)).lineTo(0.254441, 0.234868).threePointArc((0.205510, 0.185937), (0.254441, 0.137007)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.195312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.554688, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.098684, 0.000000).circle(0.096628)
loop5=wp_sketch2.moveTo(0.098684, 0.000000).circle(0.049342)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.242188)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
