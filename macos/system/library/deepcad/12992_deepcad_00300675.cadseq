# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00300675" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.118421, 0.000000).lineTo(0.118421, 0.134211).lineTo(0.236842, 0.268421).lineTo(0.236842, 0.686842).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.663158).lineTo(0.118421, 0.663158).lineTo(0.118421, 0.300000).lineTo(0.000000, 0.300000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.181579, 0.300000).circle(0.007895)
loop2=wp_sketch0.moveTo(0.181579, 0.663158).circle(0.007895)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.007812, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.093750, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.197368, 0.000000).lineTo(0.197368, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
