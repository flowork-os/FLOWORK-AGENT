# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00294147" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.732730, 0.000000).lineTo(0.732730, 1.054688).lineTo(0.000000, 1.054688).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.532895, 0.843750).circle(0.088816)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.437500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.304688, 0.218750), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.153947, 0.000000).circle(0.153947)
loop3=wp_sketch1.moveTo(0.153947, 0.000000).circle(0.089803)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.617188)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.304688, 0.218750), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.090789, 0.000000).circle(0.088898)
solid2=wp_sketch2.add(loop4).extrude(-1.000000)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
