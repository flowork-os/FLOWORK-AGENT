wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.164062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.033717, 0.003372).threePointArc((0.159199, 0.160156), (0.033717, 0.316941)).lineTo(0.000000, 0.320312).threePointArc((-0.160156, 0.160156), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.067434, 0.128125).threePointArc((-0.000000, 0.086573), (0.067434, 0.128125)).lineTo(0.128125, 0.128125).lineTo(0.128125, 0.192188).lineTo(0.067434, 0.192188).threePointArc((0.000000, 0.233739), (-0.067434, 0.192188)).lineTo(-0.101151, 0.192188).lineTo(-0.101151, 0.128125).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.320312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.562500, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.094737, 0.000000).circle(0.092763)
loop3=wp_sketch1.moveTo(0.094737, 0.000000).circle(0.047368)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.320312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.031250, 0.156250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(-0.189967, 0.240625).threePointArc((0.128007, 0.038026), (0.000000, -0.316612)).lineTo(0.601562, -0.246957).threePointArc((0.526210, -0.155140), (0.601562, -0.063322)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.320312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
