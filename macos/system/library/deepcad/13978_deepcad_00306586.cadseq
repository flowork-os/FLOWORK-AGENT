import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.331579).threePointArc((0.655263, 0.426316), (0.560526, 0.331579)).lineTo(0.560526, 0.134211).threePointArc((0.546652, 0.100716), (0.513158, 0.086842)).lineTo(0.236842, 0.086842).threePointArc((0.203348, 0.100716), (0.189474, 0.134211)).lineTo(0.189474, 0.331579).threePointArc((0.130796, 0.413832), (0.031579, 0.394737)).threePointArc((0.008901, 0.366602), (0.000000, 0.331579)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.094737, 0.331579).circle(0.047368)
loop2=wp_sketch0.moveTo(0.655263, 0.331579).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.187500)
