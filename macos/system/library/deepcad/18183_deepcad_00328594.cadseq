import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.036997, -0.089319), (0.126316, -0.126316)).lineTo(1.373684, -0.126316).threePointArc((1.463003, -0.089319), (1.500000, 0.000000)).lineTo(1.500000, 0.757895).threePointArc((1.459733, 0.839319), (1.373684, 0.868421)).lineTo(0.126316, 0.868421).threePointArc((0.040267, 0.839319), (0.000000, 0.757895)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
