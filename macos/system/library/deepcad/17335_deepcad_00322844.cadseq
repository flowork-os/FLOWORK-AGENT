# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322844" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.078947).lineTo(0.000000, 0.078947).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.351562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.315789).lineTo(1.500000, 0.631579).lineTo(0.000000, 0.631579).lineTo(0.000000, 0.315789).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.378947, 0.315789).circle(0.063158)
loop3=wp_sketch1.moveTo(1.121053, 0.315789).circle(0.063158)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.078125)
solid=solid.union(solid1)
