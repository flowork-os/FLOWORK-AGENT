wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.078947).lineTo(0.000000, 0.078947).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.703125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.320312, 0.273438, 0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.117188, 0.000000).threePointArc((0.058594, 0.058594), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop5).extrude(-0.625000)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.320312, 0.273438, 0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.058594, -0.058594), (0.117188, 0.000000)).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(-0.625000)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, 0.273438, 0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch5.moveTo(0.117188, 0.000000).threePointArc((0.058594, 0.058594), (0.000000, 0.000000)).close()
solid5=wp_sketch5.add(loop7).extrude(-0.625000)
