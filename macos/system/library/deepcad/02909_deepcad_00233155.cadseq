import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, -0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.021100, -0.050940), (0.072039, -0.072039)).lineTo(0.528289, -0.072039).threePointArc((0.585232, -0.053426), (0.612336, 0.000000)).lineTo(0.612336, 1.068586).threePointArc((0.585232, 1.122012), (0.528289, 1.140625)).lineTo(0.072039, 1.140625).threePointArc((0.021871, 1.118754), (0.000000, 1.068586)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.564309, 0.144079).lineTo(0.564309, 1.020559).lineTo(0.060033, 1.020559).lineTo(0.060033, 0.144079).close()
loop2=wp_sketch0.moveTo(0.180099, 1.068586).circle(0.012007)
loop3=wp_sketch0.moveTo(0.312171, 0.060033).circle(0.060033)
loop4=wp_sketch0.moveTo(0.312171, 1.080592).circle(0.024013)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
