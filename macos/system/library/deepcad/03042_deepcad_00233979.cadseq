import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.108240, -0.108439), (0.081908, -0.259375)).threePointArc((0.128086, -0.568721), (0.436842, -0.518750)).threePointArc((0.573355, -0.447922), (0.709868, -0.518750)).threePointArc((1.018624, -0.568721), (1.064803, -0.259375)).threePointArc((1.038470, -0.108439), (1.146711, 0.000000)).threePointArc((1.285752, 0.273869), (1.010197, 0.409539)).threePointArc((0.858490, 0.434785), (0.791776, 0.573355)).threePointArc((0.573355, 0.794473), (0.354934, 0.573355)).threePointArc((0.288220, 0.434785), (0.136513, 0.409539)).threePointArc((-0.139042, 0.273869), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.573355, 0.040954).circle(0.109211)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.343750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, 0.000000, 0.343750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.489474, 0.000000).circle(0.479276)
loop3=wp_sketch1.moveTo(0.356908, -0.214145).lineTo(0.611842, -0.214145).lineTo(0.734211, 0.000000).lineTo(0.611842, 0.214145).lineTo(0.356908, 0.214145).lineTo(0.234539, 0.000000).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.343750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
