# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00308426" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.293503, 0.000000).threePointArc((0.125535, 0.167969), (0.293503, 0.335938)).lineTo(0.000000, 0.335938).threePointArc((-0.167969, 0.167969), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.169737).circle(0.095477)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.289062, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.291118, 0.000000).threePointArc((0.458512, 0.167393), (0.291118, 0.334786)).lineTo(0.000000, 0.334786).threePointArc((0.167393, 0.167393), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.291118, 0.169819).circle(0.092188)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.125000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
