# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00224261" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.539062, 0.000000, 0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.060855, -0.287458), (0.121711, 0.000000)).lineTo(0.121711, 0.060855).lineTo(0.000000, 0.060855).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.060855, -0.136924).circle(0.091283)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.179688, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.295970, 0.000000).threePointArc((0.356168, 0.060197), (0.416365, 0.000000)).lineTo(0.446464, 0.000000).lineTo(0.476562, 0.000000).threePointArc((0.446733, 0.090296), (0.476562, 0.180592)).lineTo(0.416365, 0.180592).threePointArc((0.356168, 0.120395), (0.295970, 0.180592)).lineTo(0.000000, 0.180592).threePointArc((-0.090296, 0.090296), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.120395, 0.040132).threePointArc((0.168051, 0.087788), (0.120395, 0.135444)).lineTo(0.000000, 0.135444).threePointArc((-0.047656, 0.087788), (0.000000, 0.040132)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.062500, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.570312, 0.093750, 0.195312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.031579, 0.000000).circle(0.031579)
solid2=wp_sketch2.add(loop4).extrude(-0.117188)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.570312, -0.093750, 0.195312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.031579, 0.000000).circle(0.031579)
solid3=wp_sketch3.add(loop5).extrude(-0.117188)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
