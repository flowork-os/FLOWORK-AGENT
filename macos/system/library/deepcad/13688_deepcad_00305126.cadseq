# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00305126" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.703125, 0.000000).lineTo(0.703125, 0.742188).lineTo(0.000000, 0.742188).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.156250, 0.132812).circle(0.031250)
loop2=wp_sketch0.moveTo(0.156250, 0.609375).circle(0.031250)
loop3=wp_sketch0.moveTo(0.578125, 0.132812).circle(0.031250)
loop4=wp_sketch0.moveTo(0.578125, 0.609375).circle(0.031250)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.031250, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
