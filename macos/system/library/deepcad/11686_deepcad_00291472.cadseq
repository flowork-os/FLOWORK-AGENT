# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00291472" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.000000, 0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.027337, 0.000959), (0.054687, 0.000576)).threePointArc((0.027314, 0.003150), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.570312, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.006581, 0.019152), (0.010280, 0.039062)).threePointArc((0.005499, 0.019437), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, 0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.031088, -0.005170), (0.062500, -0.002632)).threePointArc((0.031298, -0.000165), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.023438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.150000, 0.000000).circle(0.146875)
solid3=wp_sketch3.add(loop3).extrude(0.023438)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, 0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((-0.089916, 0.127316), (0.010280, 0.246711)).threePointArc((-0.434221, -0.738300), (0.627056, -0.534539)).threePointArc((0.496959, -0.610215), (0.390625, -0.503701)).threePointArc((-0.297476, -0.634013), (0.000000, 0.000000)).close()
loop5=wp_sketch4.moveTo(-0.503701, -0.359786).circle(0.061678)
loop6=wp_sketch4.moveTo(0.236431, -0.812089).circle(0.061678)
solid4=wp_sketch4.add(loop4).add(loop5).add(loop6).extrude(0.023438)
solid=solid.union(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch5.moveTo(0.012747, 0.000000).lineTo(0.012747, 0.015625).lineTo(0.022615, 0.015625).lineTo(0.022615, 0.039062).lineTo(0.000000, 0.039062).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop7).extrude(-0.015625, both=True)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
