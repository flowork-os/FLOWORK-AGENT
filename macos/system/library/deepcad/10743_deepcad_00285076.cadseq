# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285076" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.507812, 0.000000, -0.468750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.010454, -0.025237), (0.035691, -0.035691)).lineTo(0.206497, -0.035691).threePointArc((0.231734, -0.025237), (0.242188, 0.000000)).lineTo(0.242188, 0.137664).lineTo(0.000000, 0.137664).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.122368, 0.050987).circle(0.043339)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.343750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.507812, 0.000000, -0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.242188, 0.000000).threePointArc((0.121094, 0.121094), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.343750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
