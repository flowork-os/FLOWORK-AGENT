# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00215951" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, 0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.496299, 0.000000).threePointArc((0.664062, 0.167763), (0.496299, 0.335526)).lineTo(0.000000, 0.335526).threePointArc((-0.167763, 0.167763), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.106579, 0.000000).circle(0.106579)
solid1=wp_sketch1.add(loop1).extrude(0.164062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, -0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.419408, 0.000000).lineTo(0.496299, 0.000000).threePointArc((0.664062, 0.167763), (0.496299, 0.335526)).lineTo(0.000000, 0.335526).threePointArc((-0.167763, 0.167763), (0.000000, 0.000000)).close()
loop3=wp_sketch2.moveTo(0.496299, 0.027961).threePointArc((0.632607, 0.164268), (0.496299, 0.300576)).lineTo(0.000000, 0.300576).threePointArc((-0.136308, 0.164268), (0.000000, 0.027961)).close()
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.164062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.496299, 0.000000).threePointArc((0.664062, 0.167763), (0.496299, 0.335526)).lineTo(0.000000, 0.335526).threePointArc((-0.167763, 0.167763), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop4).extrude(0.164062)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
