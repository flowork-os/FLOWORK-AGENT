# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239322" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, -0.601562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.149383, -0.149383), (0.298766, 0.000000)).lineTo(0.298766, 1.195066).threePointArc((0.149383, 1.344449), (0.000000, 1.195066)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.156497, 0.000000).circle(0.028454)
loop2=wp_sketch0.moveTo(0.156497, 0.924753).circle(0.028454)
loop3=wp_sketch0.moveTo(0.156497, 1.195066).circle(0.028454)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
