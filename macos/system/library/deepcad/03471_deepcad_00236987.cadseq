# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236987" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.484375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.133964, 0.000000).circle(0.133964)
loop1=wp_sketch0.moveTo(1.414062, -0.193503).lineTo(1.414062, 0.193503).lineTo(0.133964, 0.193503).threePointArc((0.327467, 0.000000), (0.133964, -0.193503)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.093750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
