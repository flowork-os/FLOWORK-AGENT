# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00325702" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.210938, -0.156250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.399671, -0.546217).threePointArc((0.557195, -0.587030), (0.626151, -0.439638)).lineTo(0.459622, 0.219819).threePointArc((0.097549, 0.386457), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.412993, -0.539556).threePointArc((0.554427, -0.572629), (0.612829, -0.439638)).lineTo(0.446299, 0.213158).threePointArc((0.105565, 0.370425), (0.013322, 0.006661)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
