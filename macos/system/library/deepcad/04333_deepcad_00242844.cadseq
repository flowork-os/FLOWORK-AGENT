import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, 0.000000, -0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.250000, 0.000000).lineTo(1.250000, 0.157895).lineTo(0.973684, 0.157895).lineTo(0.973684, 0.447368).lineTo(0.815789, 0.447368).lineTo(0.815789, 0.263158).lineTo(0.434211, 0.263158).lineTo(0.434211, 0.447368).lineTo(0.276316, 0.447368).lineTo(0.276316, 0.157895).lineTo(0.000000, 0.157895).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
