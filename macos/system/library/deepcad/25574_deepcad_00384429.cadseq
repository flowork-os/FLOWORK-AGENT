# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00384429" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.067105, 0.000000).circle(0.067105)
loop1=wp_sketch0.moveTo(0.067105, 0.000000).circle(0.058717)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.123684, 0.000000).lineTo(0.123684, 0.069572).lineTo(0.146875, 0.092763).lineTo(0.726645, 0.541118).lineTo(0.734375, 0.548849).threePointArc((0.696469, 0.570276), (0.680263, 0.610691)).lineTo(0.672533, 0.602961).lineTo(0.100493, 0.154605).lineTo(0.054112, 0.123684).lineTo(0.000000, 0.123684).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.031250, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.015625, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.007730, -0.007730).lineTo(0.587500, -0.456086).lineTo(0.610691, -0.479276).lineTo(0.610691, -0.548849).lineTo(0.734375, -0.548849).lineTo(0.734375, -0.425164).lineTo(0.680263, -0.425164).lineTo(0.633882, -0.394243).lineTo(0.061842, 0.054112).lineTo(0.054112, 0.061842).threePointArc((0.037906, 0.021427), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.031250, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
