# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00363360" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.205263, 0.000000).circle(0.205263)
loop1=wp_sketch0.moveTo(0.205263, 0.000000).circle(0.051316)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.632812, -0.113240).threePointArc((0.466749, 0.086595), (0.632812, 0.286431)).lineTo(0.000000, 0.173191).threePointArc((0.086595, 0.086595), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.070312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.086842, 0.000000).circle(0.086842)
loop4=wp_sketch2.moveTo(0.086842, 0.000000).circle(0.027138)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.070312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop5=wp_sketch3.moveTo(0.102632, 0.000000).circle(0.102632)
loop6=wp_sketch3.moveTo(0.102632, 0.000000).circle(0.068421)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(-0.007812)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
