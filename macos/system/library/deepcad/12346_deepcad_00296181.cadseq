wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001156, -0.002791), (0.003947, -0.003947)).lineTo(0.042928, -0.003947).threePointArc((0.045719, -0.002791), (0.046875, 0.000000)).lineTo(0.046875, 0.038980).threePointArc((0.045719, 0.041771), (0.042928, 0.042928)).lineTo(0.003947, 0.042928).threePointArc((0.001156, 0.041771), (0.000000, 0.038980)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.044408, -0.001480).lineTo(0.044408, 0.040461).lineTo(0.002467, 0.040461).lineTo(0.002467, -0.001480).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.750000)
solid=solid0

