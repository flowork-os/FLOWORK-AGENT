import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.234375, 0.070312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.020955, -0.050591), (0.071546, -0.071546)).lineTo(0.234375, -0.071546).lineTo(0.234375, -0.066612).lineTo(0.071546, -0.066612).threePointArc((0.024444, -0.047102), (0.004934, 0.000000)).lineTo(0.004934, 0.037007).lineTo(0.000000, 0.037007).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.125000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.004605, 0.000000).lineTo(0.004605, 0.109375).lineTo(0.000000, 0.109375).lineTo(0.000000, 0.004605).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.070312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.020811, -0.050242), (0.071053, -0.071053)).lineTo(0.125000, -0.071053).lineTo(0.125000, -0.067105).lineTo(0.071053, -0.067105).threePointArc((0.023602, -0.047451), (0.003947, 0.000000)).lineTo(0.003947, 0.035526).lineTo(0.000000, 0.035526).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.750000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.004441, 0.000000).lineTo(0.004441, 0.046628).threePointArc((0.001201, 0.058279), (0.000000, 0.070312)).lineTo(0.000000, 0.004441).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.750000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
