# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00344951" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.164638, -0.303947).threePointArc((0.475617, -0.454065), (0.443257, -0.797862)).lineTo(0.658553, -1.203125).lineTo(0.962500, -1.203125).lineTo(0.962500, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.656250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(1.203125, 0.000000).lineTo(0.975164, 0.405263).threePointArc((0.486925, 0.460925), (0.709211, 0.899178)).lineTo(0.544572, 1.203125).lineTo(0.000000, 1.203125).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.656250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.601562, 0.656250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.164638, -0.303947).threePointArc((0.475617, -0.454065), (0.443257, -0.797862)).lineTo(0.658553, -1.203125).lineTo(0.962500, -1.203125).lineTo(0.962500, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.296875)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
