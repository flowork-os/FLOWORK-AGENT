# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00350269" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.734375, 0.000000).lineTo(0.734375, 0.023191).lineTo(0.618421, 0.023191).lineTo(0.618421, 0.255099).lineTo(0.108224, 0.255099).lineTo(0.108224, 0.023191).lineTo(0.000000, 0.023191).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.587500, 0.023191).lineTo(0.587500, 0.231908).lineTo(0.131414, 0.231908).lineTo(0.131414, 0.023191).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.015789, 0.000000).circle(0.015461)
solid1=wp_sketch1.add(loop2).extrude(0.164062, both=True)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.015789, 0.000000).circle(0.015461)
solid2=wp_sketch2.add(loop3).extrude(0.164062, both=True)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, -0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.065789, 0.000000).lineTo(0.065789, 0.195312).lineTo(0.000000, 0.195312).lineTo(0.000000, 0.180921).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.023438)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
