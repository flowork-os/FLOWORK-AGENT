# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.114474, 0.000000).circle(0.114474)
solid0=wp_sketch0.add(loop0).extrude(0.765625)
solid=solid0
# workplane for sketch 1
