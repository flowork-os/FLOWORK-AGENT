# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00356236" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.150000, 0.000000).circle(0.150000)
loop1=wp_sketch0.moveTo(0.090625, -0.100000).lineTo(0.206250, -0.100000).lineTo(0.262500, 0.000000).lineTo(0.206250, 0.100000).lineTo(0.090625, 0.100000).lineTo(0.034375, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.546875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.102632, 0.000000).circle(0.102632)
loop3=wp_sketch1.moveTo(0.074836, -0.038487).lineTo(0.128289, -0.038487).lineTo(0.145395, 0.014967).lineTo(0.102632, 0.047039).lineTo(0.057730, 0.014967).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.101562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.132812, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.124342, 0.032237).threePointArc((0.076355, 0.008336), (0.023026, 0.013816)).lineTo(0.419079, 0.013816).threePointArc((0.427226, 0.007083), (0.437500, 0.004605)).threePointArc((0.417722, 0.064474), (0.437500, 0.124342)).threePointArc((0.427081, 0.117003), (0.414474, 0.115132)).lineTo(0.023026, 0.115132).threePointArc((0.009510, 0.118701), (0.000000, 0.128947)).threePointArc((0.014478, 0.064474), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.363816, 0.041447).threePointArc((0.389145, 0.066776), (0.363816, 0.092105)).lineTo(0.064474, 0.092105).threePointArc((0.039145, 0.066776), (0.064474, 0.041447)).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.101562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
