# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00366119" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.150000, 0.000000).lineTo(0.300000, -0.162500).lineTo(0.300000, -0.450000).lineTo(0.887500, -0.450000).lineTo(0.887500, -0.162500).lineTo(1.037500, 0.000000).lineTo(1.187500, 0.000000).lineTo(1.187500, 0.300000).lineTo(0.000000, 0.300000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.125000, 0.150000).circle(0.037500)
loop2=wp_sketch0.moveTo(0.600000, -0.112500).circle(0.037500)
loop3=wp_sketch0.moveTo(1.075000, 0.150000).circle(0.037500)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.150000, 0.000000).lineTo(0.300000, -0.162500).lineTo(0.300000, -0.450000).lineTo(0.887500, -0.450000).lineTo(0.887500, -0.162500).lineTo(1.037500, 0.000000).lineTo(1.187500, 0.000000).lineTo(1.187500, 0.300000).lineTo(0.000000, 0.300000).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(0.125000, 0.150000).circle(0.037500)
loop6=wp_sketch1.moveTo(0.600000, -0.112500).circle(0.037500)
loop7=wp_sketch1.moveTo(1.075000, 0.150000).circle(0.037500)
solid1=wp_sketch1.add(loop4).add(loop5).add(loop6).add(loop7).extrude(0.093750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
