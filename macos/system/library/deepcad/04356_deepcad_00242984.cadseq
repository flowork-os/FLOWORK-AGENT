# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00242984" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.817763, 0.000000).lineTo(0.817763, 0.882812).lineTo(0.000000, 0.882812).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.418174, 0.436760).circle(0.111513)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.593750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.507812, 0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.067285, -0.043233), (0.084293, -0.121382)).lineTo(0.246135, -0.121382).lineTo(0.246135, 0.320312).lineTo(0.000000, 0.320312).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.265625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.257812, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.241612, 0.000000).lineTo(0.241612, 0.353125).threePointArc((0.120127, 0.455345), (0.241612, 0.557566)).lineTo(0.241612, 0.882812).lineTo(0.000000, 0.882812).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.265625)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.507812, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.244079, 0.000000).lineTo(0.244079, 0.437500).lineTo(0.082895, 0.437500).threePointArc((0.054578, 0.382922), (0.000000, 0.354605)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.265625)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
