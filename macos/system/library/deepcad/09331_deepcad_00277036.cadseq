# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00277036" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.335526, 0.000000).circle(0.335526)
loop1=wp_sketch0.moveTo(0.153783, -0.111842).circle(0.034951)
loop2=wp_sketch0.moveTo(0.209704, 0.146793).circle(0.034951)
loop3=wp_sketch0.moveTo(0.440378, -0.132812).circle(0.034951)
loop4=wp_sketch0.moveTo(0.475329, 0.125822).circle(0.034951)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
