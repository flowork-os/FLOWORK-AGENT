# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00290449" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.257812, 0.000000).lineTo(0.257812, 0.233388).lineTo(0.252385, 0.233388).lineTo(0.252385, 0.236102).lineTo(0.257812, 0.236102).lineTo(0.257812, 0.257812).lineTo(0.000000, 0.257812).lineTo(0.000000, 0.236102).lineTo(0.005428, 0.236102).lineTo(0.005428, 0.233388).lineTo(0.000000, 0.233388).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.132977, 0.233388).lineTo(0.132977, 0.236102).lineTo(0.124836, 0.236102).lineTo(0.124836, 0.233388).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.244243, 0.000000).lineTo(0.257812, 0.000000).lineTo(0.257812, 0.233388).lineTo(0.252385, 0.233388).lineTo(0.252385, 0.236102).lineTo(0.257812, 0.236102).lineTo(0.257812, 0.257812).lineTo(0.000000, 0.257812).lineTo(0.000000, 0.236102).lineTo(0.005428, 0.236102).lineTo(0.005428, 0.233388).lineTo(0.000000, 0.233388).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.132977, 0.233388).lineTo(0.132977, 0.236102).lineTo(0.124836, 0.236102).lineTo(0.124836, 0.233388).close()
loop4=wp_sketch1.moveTo(0.252385, 0.122122).circle(0.002714)
loop5=wp_sketch1.moveTo(0.252385, 0.135691).circle(0.002714)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
