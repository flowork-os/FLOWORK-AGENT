# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00308580" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.273438, 0.000000).lineTo(1.273438, 1.125987).lineTo(0.000000, 1.125987).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.522780, 0.241283).lineTo(0.522780, 0.898109).lineTo(0.227878, 0.898109).lineTo(0.227878, 0.241283).close()
loop2=wp_sketch0.moveTo(0.898109, 0.603207).lineTo(0.898109, 0.764062).lineTo(0.737253, 0.764062).lineTo(0.737253, 0.603207).close()
loop3=wp_sketch0.moveTo(1.058964, 0.201069).lineTo(1.058964, 0.335115).lineTo(0.817681, 0.335115).lineTo(0.817681, 0.201069).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.492188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
