# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00217157" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.307895).lineTo(0.465789, 0.307895).lineTo(0.378947, 0.394737).lineTo(0.000000, 0.394737).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.398438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.554688, 0.000000, 0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.134293, 0.000000).threePointArc((0.179688, 0.045395), (0.134293, 0.090789)).lineTo(0.000000, 0.090789).threePointArc((-0.045395, 0.045395), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(-0.328125)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.554688, 0.000000, 0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.134293, 0.000000).threePointArc((0.179688, 0.045395), (0.134293, 0.090789)).lineTo(0.000000, 0.090789).threePointArc((-0.045395, 0.045395), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(-0.328125)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
