# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00281530" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.015625, 0.000000, -0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.602961, 0.061842).threePointArc((0.729074, 0.200987), (0.602961, 0.340132)).lineTo(0.000000, 0.401974).threePointArc((-0.221755, 0.200987), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.023191, 0.200987).circle(0.100493)
loop2=wp_sketch0.moveTo(0.595230, 0.200987).circle(0.054112)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
