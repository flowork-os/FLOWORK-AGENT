# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00300608" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.101562, 0.000000).lineTo(1.101562, 0.208717).lineTo(0.000000, 0.208717).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.162336, 0.115954).circle(0.069572)
loop2=wp_sketch0.moveTo(0.556579, 0.139145).circle(0.011595)
loop3=wp_sketch0.moveTo(0.950822, 0.115954).circle(0.069572)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
