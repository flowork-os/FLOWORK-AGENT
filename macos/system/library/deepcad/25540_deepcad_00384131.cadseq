import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.500000, -0.703125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013440, -0.032448), (0.045888, -0.045888)).lineTo(0.948355, -0.045888).threePointArc((0.988451, -0.035616), (1.009539, 0.000000)).lineTo(1.009539, 1.453125).lineTo(0.000000, 1.453125).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.107072, 0.045888).circle(0.045888)
loop2=wp_sketch0.moveTo(0.107072, 0.856579).circle(0.045888)
loop3=wp_sketch0.moveTo(0.902467, 0.045888).circle(0.045888)
loop4=wp_sketch0.moveTo(0.902467, 0.856579).circle(0.045888)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
