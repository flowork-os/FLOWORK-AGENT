# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00321788" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.492188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.445312, 0.000000).lineTo(1.445312, 0.973684).lineTo(0.000000, 0.973684).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.821546, 0.395559).lineTo(0.821546, 0.106497).lineTo(1.323602, 0.106497).lineTo(1.323602, 0.836760).lineTo(0.821546, 0.836760).lineTo(0.821546, 0.578125).lineTo(0.623766, 0.578125).lineTo(0.623766, 0.395559).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.093750, -0.382812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.510197, 0.000000).lineTo(0.510197, 0.734375).lineTo(0.000000, 0.734375).lineTo(0.000000, 0.471546).lineTo(0.000000, 0.301480).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.187500, 0.000000).lineTo(0.187500, 0.175658).lineTo(0.000000, 0.175658).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.750000, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.093750, -0.382812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.510197, 0.000000).lineTo(0.510197, 0.734375).lineTo(0.000000, 0.734375).lineTo(0.000000, 0.471546).lineTo(0.000000, 0.301480).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.062500)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
