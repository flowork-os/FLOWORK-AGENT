# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297980" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.240789, 0.000000).circle(0.240789)
loop1=wp_sketch0.moveTo(0.240789, 0.000000).circle(0.195641)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.177632, 0.000000).circle(0.177632)
loop3=wp_sketch1.moveTo(0.140625, 0.022204).lineTo(0.140625, -0.144326).lineTo(0.210938, -0.144326).lineTo(0.210938, 0.022204).lineTo(0.255345, 0.022204).lineTo(0.177632, 0.133224).lineTo(0.096217, 0.022204).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.201316, 0.000000).circle(0.201316)
loop5=wp_sketch2.moveTo(0.201316, 0.000000).circle(0.176151)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.664062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.044901, 0.000000).lineTo(0.044901, -0.164062).lineTo(0.115707, -0.164062).lineTo(0.115707, 0.000000).lineTo(0.160609, 0.000000).lineTo(0.079441, 0.107072).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop6).extrude(0.718750)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
