loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.005492, -0.013258), (0.018750, -0.018750)).lineTo(0.350000, -0.018750).threePointArc((0.363258, -0.013258), (0.368750, 0.000000)).lineTo(0.368750, 0.575000).threePointArc((0.363258, 0.588258), (0.350000, 0.593750)).lineTo(0.018750, 0.593750).threePointArc((0.005492, 0.588258), (0.000000, 0.575000)).lineTo(0.000000, 0.287500).lineTo(0.000000, 0.000000).close()
