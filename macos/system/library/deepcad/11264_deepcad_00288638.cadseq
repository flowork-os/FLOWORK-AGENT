# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288638" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.046875, 0.000000).lineTo(0.046875, 0.046875).lineTo(0.000000, 0.046875).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.042928, 0.003947).lineTo(0.042928, 0.042928).lineTo(0.003947, 0.042928).lineTo(0.003947, 0.003947).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, -0.023438, 0.734375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.003947, 0.000000).circle(0.003947)
solid1=wp_sketch1.add(loop2).extrude(-0.046875)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, -0.023438, 0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.003947, 0.000000).circle(0.003947)
solid2=wp_sketch2.add(loop3).extrude(-0.046875)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.023438, -0.007812, 0.734375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.003947, 0.000000).circle(0.003947)
solid3=wp_sketch3.add(loop4).extrude(-0.046875)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.023438, -0.007812, 0.015625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.003947, 0.000000).circle(0.003947)
solid4=wp_sketch4.add(loop5).extrude(-0.046875)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
