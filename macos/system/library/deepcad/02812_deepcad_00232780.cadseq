# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232780" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.781250, 0.000000).lineTo(0.781250, 0.485197).lineTo(0.476974, 0.485197).threePointArc((0.209394, 0.424139), (0.000000, 0.246711)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.394737, 0.246711).circle(0.082237)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.585938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.196875, 0.113980).lineTo(0.196875, 0.378207).lineTo(0.000000, 0.492187).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.585938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
