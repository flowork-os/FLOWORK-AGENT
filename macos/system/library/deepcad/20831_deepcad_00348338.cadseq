# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.000000, 0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.094984, 0.000000).lineTo(0.094984, -0.080592).lineTo(0.094984, -0.273438).lineTo(0.215872, -0.273438).lineTo(0.215872, -0.146793).lineTo(0.164062, -0.146793).lineTo(0.164062, 0.094984).lineTo(0.000000, 0.094984).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
