# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00289990" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.284211, 0.000000).circle(0.284211)
loop1=wp_sketch0.moveTo(0.284211, 0.000000).circle(0.165789)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.453125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.205099, 0.000000).threePointArc((0.181117, 0.113281), (0.205099, 0.226562)).lineTo(0.000000, 0.226562).threePointArc((-0.113281, 0.113281), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.000000, 0.114474).circle(0.085855)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.171875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.257812, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.378207, 0.000000).threePointArc((0.489597, 0.111390), (0.378207, 0.222780)).lineTo(0.000000, 0.222780).threePointArc((0.023581, 0.111390), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.378207, 0.025905).threePointArc((0.463692, 0.111390), (0.378207, 0.196875)).lineTo(0.134704, 0.196875).threePointArc((0.049219, 0.111390), (0.134704, 0.025905)).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.171875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
