wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, 0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.032523, -0.095634), (0.123684, -0.139145)).lineTo(0.401974, -0.162336).threePointArc((0.474553, -0.112291), (0.440625, -0.030921)).lineTo(0.278289, 0.054112).threePointArc((0.257020, 0.073430), (0.247368, 0.100493)).lineTo(0.185526, 0.680263).threePointArc((0.127549, 0.732166), (0.069572, 0.680263)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.131414, -0.015461).circle(0.085033)
loop2=wp_sketch0.moveTo(0.131414, 0.680263).circle(0.023191)
loop3=wp_sketch0.moveTo(0.401974, -0.092763).circle(0.030921)
