# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00385906" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.110526, 0.000000).circle(0.110526)
loop1=wp_sketch0.moveTo(0.110526, 0.000000).circle(0.069079)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.218750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.093750, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.476562, 0.000000).threePointArc((0.459824, 0.055181), (0.476562, 0.110362)).lineTo(0.000000, 0.110362).threePointArc((0.014907, 0.055181), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.218750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.554688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.098684, 0.000000).circle(0.098684)
loop4=wp_sketch2.moveTo(0.098684, 0.000000).circle(0.067845)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.218750)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
