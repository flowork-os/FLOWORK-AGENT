# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00290489" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.062500, 0.000000).lineTo(1.062500, 0.201316).lineTo(0.447368, 0.201316).lineTo(0.447368, 0.514474).lineTo(1.062500, 0.514474).lineTo(1.062500, 0.827632).lineTo(0.000000, 0.827632).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.201316, 0.492105).circle(0.134211)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.367188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
