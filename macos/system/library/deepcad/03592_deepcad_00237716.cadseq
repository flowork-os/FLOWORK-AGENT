# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00237716" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, -0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.027961, 0.000000).lineTo(0.027961, 0.204112).lineTo(0.240461, 0.204112).lineTo(0.240461, 0.000000).lineTo(0.265625, 0.000000).lineTo(0.265625, 0.232072).lineTo(0.000000, 0.232072).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.250000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.132812, -0.171875, -0.132812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.351562, 0.000000).threePointArc((0.175781, 0.175781), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(-0.289062)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.238322, 0.000000).lineTo(0.238322, 0.492187).lineTo(0.000000, 0.492187).lineTo(0.000000, 0.419655).threePointArc((0.173561, 0.246094), (0.000000, 0.072533)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.023438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.507812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.238322, 0.000000).lineTo(0.238322, 0.072533).threePointArc((0.064762, 0.246094), (0.238322, 0.419655)).lineTo(0.238322, 0.492187).lineTo(0.000000, 0.492187).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.023438)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.265625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.212418, 0.000000).lineTo(0.212418, 0.492187).lineTo(0.000000, 0.492187).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.023438)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
