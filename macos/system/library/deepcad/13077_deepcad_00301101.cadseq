# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00301101" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.059622, 0.000000).circle(0.059622)
loop1=wp_sketch0.moveTo(1.013569, -0.119243).threePointArc((1.132812, 0.000000), (1.013569, 0.119243)).lineTo(0.059622, 0.119243).threePointArc((0.178865, 0.000000), (0.059622, -0.119243)).close()
loop2=wp_sketch0.moveTo(1.013569, 0.000000).circle(0.059622)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.117188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
