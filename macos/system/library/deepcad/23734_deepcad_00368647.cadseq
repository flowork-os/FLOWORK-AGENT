wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, -0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004625, -0.011165), (0.015789, -0.015789)).lineTo(0.359211, -0.015789).threePointArc((0.370375, -0.011165), (0.375000, 0.000000)).lineTo(0.375000, 0.343421).threePointArc((0.370375, 0.354586), (0.359211, 0.359211)).lineTo(0.015789, 0.359211).threePointArc((0.004625, 0.354586), (0.000000, 0.343421)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.018581, -0.005384), (0.035526, 0.003947)).lineTo(0.339474, 0.003947).threePointArc((0.350639, 0.008572), (0.355263, 0.019737)).lineTo(0.355263, 0.327632).threePointArc((0.349821, 0.336823), (0.339474, 0.339474)).lineTo(0.035526, 0.339474).threePointArc((0.025179, 0.336823), (0.019737, 0.327632)).lineTo(0.019737, 0.019737).close()
