import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.296875, -0.304688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.294202, -0.294202), (0.588405, 0.000000)).lineTo(0.588405, 0.754934).threePointArc((0.294202, 1.049137), (0.000000, 0.754934)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.523438)
solid=solid0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.296875, -0.304688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.294202, -0.294202), (0.588405, 0.000000)).lineTo(0.588405, 0.754934).threePointArc((0.294202, 1.049137), (0.000000, 0.754934)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.523438)
solid=solid.union(solid0)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
