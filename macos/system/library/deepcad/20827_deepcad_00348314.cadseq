# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00348314" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, -0.484375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.492188, 0.000000).lineTo(1.492188, 0.989556).lineTo(0.000000, 0.989556).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.172780, 0.769655).threePointArc((0.128353, 0.876910), (0.235609, 0.832484)).lineTo(1.240872, 0.832484).threePointArc((1.348127, 0.876910), (1.303701, 0.769655)).lineTo(1.303701, 0.204194).threePointArc((1.348127, 0.096938), (1.240872, 0.141365)).lineTo(0.235609, 0.141365).threePointArc((0.128353, 0.096938), (0.172780, 0.204194)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.130263, 0.153947).threePointArc((0.138883, 0.032653), (0.059211, -0.059211)).lineTo(1.065789, -0.059211).threePointArc((1.083132, -0.017342), (1.125000, 0.000000)).lineTo(1.125000, 0.568421).threePointArc((1.083132, 0.585763), (1.065789, 0.627632)).lineTo(0.059211, 0.627632).threePointArc((0.041868, 0.585763), (0.000000, 0.568421)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.568421, 0.284211).circle(0.236842)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.125000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
