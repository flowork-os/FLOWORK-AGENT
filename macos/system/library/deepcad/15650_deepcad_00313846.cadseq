wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000096, -0.000233), (0.000329, -0.000329)).lineTo(0.003783, -0.000329).threePointArc((0.003974, -0.000216), (0.004030, 0.000000)).lineTo(0.004030, 0.007484).threePointArc((0.003974, 0.007699), (0.003783, 0.007812)).lineTo(0.000329, 0.007812).threePointArc((0.000096, 0.007716), (0.000000, 0.007484)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.003783, 0.000000).lineTo(0.003783, 0.007484).lineTo(0.000329, 0.007484).lineTo(0.000329, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

