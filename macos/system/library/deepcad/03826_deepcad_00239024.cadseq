# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239024" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.074836, 0.000000).threePointArc((0.710938, 0.636102), (1.347039, 0.000000)).lineTo(1.421875, 0.000000).threePointArc((0.710938, 0.710938), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(1.273438, 0.000000).threePointArc((1.274466, 0.033512), (1.273438, 0.067023)).lineTo(0.656826, 0.067023).lineTo(1.058964, 0.482566).threePointArc((1.045477, 0.489104), (1.032155, 0.495970)).lineTo(0.656826, 0.120641).lineTo(0.656826, 0.630016).threePointArc((0.636719, 0.630263), (0.616612, 0.630016)).lineTo(0.616612, 0.120641).lineTo(0.241283, 0.495970).threePointArc((0.227961, 0.489104), (0.214474, 0.482566)).lineTo(0.616612, 0.067023).lineTo(0.000000, 0.067023).threePointArc((-0.001028, 0.033512), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.062500)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
