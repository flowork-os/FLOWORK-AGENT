# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00247149" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.445312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.238816, -0.953406), (0.477632, 0.000000)).threePointArc((0.238816, 0.306014), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.186110, 0.047946), (0.378125, 0.039803)).threePointArc((0.233840, 0.207069), (0.089556, 0.039803)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
