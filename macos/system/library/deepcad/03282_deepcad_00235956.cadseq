# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00235956" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.023438, 0.000000, 0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.164333, -0.068069), (0.232401, -0.232401)).lineTo(0.232401, -1.226562).lineTo(0.723026, -1.226562).lineTo(0.723026, 0.232401).lineTo(0.000000, 0.232401).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.335938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.479276, 0.000000).lineTo(0.479276, 0.989474).threePointArc((0.543999, 1.161188), (0.711184, 1.236842)).lineTo(0.711184, 1.468750).lineTo(0.000000, 1.468750).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.335938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
