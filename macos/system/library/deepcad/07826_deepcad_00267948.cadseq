# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267948" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.556579, 0.000000).circle(0.556579)
loop1=wp_sketch0.moveTo(0.556579, -0.057977).lineTo(0.858059, -0.057977).lineTo(0.858059, 0.000000).lineTo(0.858059, 0.057977).lineTo(0.556579, 0.057977).lineTo(0.243503, 0.057977).lineTo(0.243503, 0.000000).lineTo(0.243503, -0.057977).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
