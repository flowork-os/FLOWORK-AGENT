# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00340653" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, -0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.460938, 0.000000).lineTo(1.460938, 0.599753).lineTo(0.000000, 0.599753).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.107648, 0.307566).circle(0.015378)
loop2=wp_sketch0.moveTo(1.353289, 0.307566).circle(0.015378)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
