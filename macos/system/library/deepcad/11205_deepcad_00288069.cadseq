loop0=wp_sketch0.moveTo(0.025329, 0.000000).threePointArc((0.042516, 0.017188), (0.059704, 0.000000)).lineTo(0.085938, 0.000000).lineTo(0.085938, 0.025329).threePointArc((0.068750, 0.042516), (0.085938, 0.059704)).lineTo(0.085938, 0.085938).lineTo(0.059704, 0.085938).threePointArc((0.042516, 0.068750), (0.025329, 0.085938)).lineTo(0.000000, 0.085938).lineTo(0.000000, 0.059704).threePointArc((0.017188, 0.042516), (0.000000, 0.025329)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
