# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00377942" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.656250, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.092763, -0.092763), (0.000000, -0.185526)).lineTo(0.734375, -0.185526).lineTo(0.734375, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.090789, 0.000000).circle(0.090789)
loop2=wp_sketch1.moveTo(0.090789, 0.000000).circle(0.045395)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.039062, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.742188, 0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.073426, -0.137865), (0.172697, -0.017270)).lineTo(0.198602, 0.051809).lineTo(0.820313, 0.051809).lineTo(0.820313, 0.155428).lineTo(0.077714, 0.155428).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.077714, -0.043174).circle(0.043174)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.015625, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.703125, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.047368, 0.000000).circle(0.046382)
solid3=wp_sketch3.add(loop5).extrude(0.039062, both=True)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.094737, 0.000000).circle(0.094737)
solid4=wp_sketch4.add(loop6).extrude(0.015625, both=True)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
