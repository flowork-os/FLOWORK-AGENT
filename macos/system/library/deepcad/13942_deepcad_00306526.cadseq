import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.046135, 0.000000).lineTo(0.046135, -0.046135).lineTo(0.310362, -0.046135).lineTo(0.310362, 0.046135).lineTo(0.398438, 0.046135).lineTo(0.398438, 0.088076).lineTo(0.310362, 0.088076).lineTo(0.310362, 0.176151).lineTo(0.000000, 0.176151).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.218750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
