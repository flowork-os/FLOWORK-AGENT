solid2=wp_sketch2.add(loop2).extrude(0.500000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.468750, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.011716, -0.000391), (0.023438, -0.000493)).lineTo(0.023438, 0.010115).lineTo(0.000000, 0.010115).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.500000)
