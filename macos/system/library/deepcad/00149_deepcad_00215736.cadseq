import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.015954, 0.000000).lineTo(0.015954, -0.055839).lineTo(0.015954, -0.143586).lineTo(0.757812, -0.143586).lineTo(0.757812, -0.063816).lineTo(0.111678, -0.063816).lineTo(0.111678, 0.000000).lineTo(0.127632, 0.000000).lineTo(0.063816, 0.031908).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
