wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.476562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.421875, 0.000000).lineTo(1.421875, 0.374178).lineTo(0.359211, 0.374178).threePointArc((0.501398, 0.516365), (0.359211, 0.658553)).lineTo(0.523849, 0.658553).lineTo(0.523849, 0.853125).lineTo(0.359211, 0.853125).threePointArc((0.100494, 0.672985), (0.000000, 0.374178)).lineTo(0.000000, 0.000000).close()
