# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00336570" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.051316, 0.000000).circle(0.051316)
loop1=wp_sketch0.moveTo(0.051316, 0.000000).circle(0.025658)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.921875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.960938, -0.054688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.217599, 0.000000).threePointArc((0.228221, 0.025644), (0.253865, 0.036266)).lineTo(0.761595, 0.036266).threePointArc((0.787240, 0.025644), (0.797862, 0.000000)).lineTo(0.882484, -0.072533).lineTo(1.148438, -0.120888).lineTo(1.063816, 0.229687).lineTo(0.048355, 0.181332).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.101562, both=True)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
