# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00308252" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.288158, 0.000000).circle(0.288158)
loop1=wp_sketch0.moveTo(0.156086, -0.132072).circle(0.024013)
loop2=wp_sketch0.moveTo(0.156086, 0.132072).circle(0.024013)
loop3=wp_sketch0.moveTo(0.288158, 0.000000).circle(0.144079)
loop4=wp_sketch0.moveTo(0.420230, -0.132072).circle(0.024013)
loop5=wp_sketch0.moveTo(0.420230, 0.132072).circle(0.024013)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.601562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch1.moveTo(0.146053, 0.000000).circle(0.146053)
loop7=wp_sketch1.moveTo(0.146053, 0.000000).circle(0.097368)
solid1=wp_sketch1.add(loop6).add(loop7).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop8=wp_sketch2.moveTo(0.094737, 0.000000).circle(0.094737)
solid2=wp_sketch2.add(loop8).extrude(0.750000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop9=wp_sketch3.moveTo(0.094737, 0.000000).circle(0.094737)
solid3=wp_sketch3.add(loop9).extrude(0.695312)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop10=wp_sketch4.moveTo(0.094737, 0.000000).circle(0.094737)
solid4=wp_sketch4.add(loop10).extrude(0.695312)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
