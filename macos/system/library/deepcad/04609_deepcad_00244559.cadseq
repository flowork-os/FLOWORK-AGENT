wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.103007, -0.011703), (0.192434, -0.064145)).threePointArc((0.468257, -0.168601), (0.744079, -0.064145)).threePointArc((0.833506, -0.011703), (0.936513, 0.000000)).threePointArc((1.215954, 0.250164), (0.936513, 0.500329)).threePointArc((0.834864, 0.505618), (0.744079, 0.551645)).threePointArc((0.468257, 0.656101), (0.192434, 0.551645)).threePointArc((0.101649, 0.505618), (0.000000, 0.500329)).threePointArc((-0.279441, 0.250164), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.025658, 0.243750).circle(0.076974)
loop2=wp_sketch0.moveTo(0.474671, 0.243750).circle(0.295066)
