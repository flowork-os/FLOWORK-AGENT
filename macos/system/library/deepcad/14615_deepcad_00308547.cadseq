# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00308547" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.087007, -0.179688).threePointArc((0.073184, -0.075472), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.118421, -0.473684).lineTo(0.750000, -0.473684).lineTo(0.655263, -0.268421).threePointArc((0.516326, -0.404381), (0.339474, -0.323684)).threePointArc((0.132441, -0.303512), (0.315789, -0.205263)).threePointArc((0.408808, -0.085396), (0.560526, -0.086842)).lineTo(0.521053, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.140625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.029381, -0.058665), (0.021217, -0.123766)).threePointArc((0.197986, -0.203438), (0.335938, -0.067187)).lineTo(0.247533, 0.116694).threePointArc((0.094844, 0.119697), (0.000000, 0.000000)).close()
loop3=wp_sketch2.moveTo(0.166201, -0.035362).circle(0.113158)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.140625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
