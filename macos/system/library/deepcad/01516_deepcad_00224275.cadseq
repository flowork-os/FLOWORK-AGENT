# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00224275" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.248684, 0.000000).circle(0.248684)
loop1=wp_sketch0.moveTo(0.248684, 0.000000).circle(0.186513)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.460938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.242188, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.296875, 0.000000).threePointArc((0.285324, 0.050000), (0.296875, 0.100000)).lineTo(0.000000, 0.100000).threePointArc((0.005235, 0.050000), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.460938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.523438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.114474, 0.000000).circle(0.114474)
loop4=wp_sketch2.moveTo(0.114474, 0.000000).circle(0.073931)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.335938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
