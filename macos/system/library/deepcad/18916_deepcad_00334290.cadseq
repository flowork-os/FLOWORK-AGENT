# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00334290" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, -0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.604194, -0.489474).threePointArc((0.693739, -0.496611), (0.726562, -0.412993)).lineTo(0.489474, 0.328865).threePointArc((0.023025, 0.494422), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.007648, 0.122368).circle(0.022944)
loop2=wp_sketch0.moveTo(0.198849, 0.474178).circle(0.022944)
loop3=wp_sketch0.moveTo(0.397697, 0.122368).circle(0.022944)
loop4=wp_sketch0.moveTo(0.650082, -0.435938).circle(0.045888)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
