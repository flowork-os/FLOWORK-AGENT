import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.226562, -0.460938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.232895, 0.000000).lineTo(0.232895, 0.460938).lineTo(0.000000, 0.460938).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.343750, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.460938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.029112, 0.000000).lineTo(0.029112, 0.431826).lineTo(0.460938, 0.431826).lineTo(0.460938, 0.460938).lineTo(0.000000, 0.460938).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.171875, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.226562, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.632812, 0.000000).lineTo(0.632812, 0.146546).lineTo(0.000000, 0.146546).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.171875, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.226562, 0.148438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.632812, 0.000000).lineTo(0.632812, 0.286431).threePointArc((0.316406, 0.602837), (0.000000, 0.286431)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.319737, 0.286431).circle(0.233141)
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.171875)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.226562, 0.148438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.632812, 0.000000).lineTo(0.632812, 0.286431).threePointArc((0.316406, 0.602837), (0.000000, 0.286431)).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch4.moveTo(0.319737, 0.286431).circle(0.233141)
solid4=wp_sketch4.add(loop5).add(loop6).extrude(0.031250)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.226562, 0.148438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop7=wp_sketch5.moveTo(0.632812, 0.000000).lineTo(0.632812, 0.286431).threePointArc((0.316406, 0.602837), (0.000000, 0.286431)).lineTo(0.000000, 0.000000).close()
loop8=wp_sketch5.moveTo(0.319737, 0.286431).circle(0.233141)
solid5=wp_sketch5.add(loop7).add(loop8).extrude(-0.171875)
solid=solid.union(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
