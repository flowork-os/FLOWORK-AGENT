# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, 0.000000, 0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.008306, 0.000000).lineTo(0.772451, 0.000000).threePointArc((0.763545, 0.080718), (0.789062, 0.157812)).lineTo(0.008306, 0.157812).lineTo(0.008306, 0.016612).threePointArc((0.004408, 0.008178), (0.000000, 0.000000)).close()
