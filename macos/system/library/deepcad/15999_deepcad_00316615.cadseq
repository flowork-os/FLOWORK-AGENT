wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.421875, 0.000000, 0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.182812, -0.051316).lineTo(0.253372, -0.070559).threePointArc((-0.067772, 0.118195), (0.304688, 0.112253)).lineTo(0.051316, 0.182812).lineTo(0.044901, 0.160362).lineTo(0.000000, 0.000000).close()
