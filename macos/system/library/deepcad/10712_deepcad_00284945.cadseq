# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284945" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.703125, 0.074013).threePointArc((0.624584, 0.144326), (0.703125, 0.214638)).lineTo(0.000000, 0.296053).threePointArc((0.132518, 0.148026), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.156807, -0.046891), (0.199836, 0.111020)).lineTo(0.481086, 0.111020).threePointArc((0.519012, 0.148026), (0.481086, 0.185033)).lineTo(0.199836, 0.185033).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.071053, 0.000000).circle(0.071053)
loop3=wp_sketch1.moveTo(0.071053, 0.000000).circle(0.035526)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.179688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.150000, 0.000000).circle(0.150000)
loop5=wp_sketch2.moveTo(0.150000, 0.000000).circle(0.106250)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.210938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
