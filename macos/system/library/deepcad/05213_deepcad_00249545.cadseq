# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00249545" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, -0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.651316, 0.000000).lineTo(1.317434, 0.000000).threePointArc((1.413651, 0.096217), (1.317434, 0.192434)).lineTo(0.651316, 0.192434).lineTo(0.000000, 0.192434).threePointArc((-0.096217, 0.096217), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.088816).circle(0.044408)
loop2=wp_sketch0.moveTo(0.651316, 0.088816).circle(0.029605)
loop3=wp_sketch0.moveTo(1.317434, 0.088816).circle(0.044408)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.132812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
