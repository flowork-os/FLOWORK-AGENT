# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00253808" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, -0.617188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.040525, -0.093498), (0.136184, -0.128618)).lineTo(0.718750, -0.098355).lineTo(0.718750, 0.325329).lineTo(0.370724, 0.522039).lineTo(0.000000, 0.385855).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.203536, -0.203536).lineTo(0.203536, -0.366365).lineTo(0.561760, -0.366365).lineTo(0.561760, -0.073273).lineTo(0.773437, 0.000000).lineTo(0.602467, 0.203536).lineTo(0.203536, 0.203536).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.164062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
