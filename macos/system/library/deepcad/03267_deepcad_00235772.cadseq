wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, 0.554688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013209, -0.309844), (0.308306, -0.214474)).threePointArc((0.334723, -0.173868), (0.375329, -0.147451)).threePointArc((0.693347, -0.090118), (1.005345, -0.174260)).threePointArc((1.028010, -0.205214), (1.058964, -0.227878)).threePointArc((1.237061, -0.261660), (1.233224, -0.080428)).threePointArc((0.631841, 0.193303), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.120641, -0.147451).circle(0.093832)
loop2=wp_sketch0.moveTo(1.152796, -0.174260).circle(0.053618)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.195312)
