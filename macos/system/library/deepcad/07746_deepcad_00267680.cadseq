import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.039062, -0.004523).threePointArc((0.019656, -0.001182), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.019656, 0.001182), (0.039062, 0.004523)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.000000, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.617188, 0.071464).threePointArc((0.497447, 0.178660), (0.617188, 0.285855)).lineTo(0.000000, 0.357319).threePointArc((0.142989, 0.178660), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.078125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.539062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.106579, 0.000000).circle(0.104359)
loop4=wp_sketch3.moveTo(0.106579, 0.000000).circle(0.064391)
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.078125)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.041612, 0.003783).threePointArc((0.182396, 0.179688), (0.041612, 0.355592)).lineTo(0.000000, 0.359375).threePointArc((-0.179688, 0.179688), (0.000000, 0.000000)).close()
loop6=wp_sketch4.moveTo(0.000000, 0.181579).circle(0.109704)
solid4=wp_sketch4.add(loop5).add(loop6).extrude(0.078125)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
