# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272604" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.625000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.386842, 0.221053).lineTo(0.505263, 0.347368).lineTo(0.418421, 0.497368).lineTo(0.252632, 0.465789).lineTo(0.228947, 0.292105).close()
loop2=wp_sketch0.moveTo(0.718421, 0.615789).lineTo(0.528947, 0.742105).lineTo(0.513158, 0.513158).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.625000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.386842, 0.221053).lineTo(0.505263, 0.347368).lineTo(0.418421, 0.497368).lineTo(0.252632, 0.465789).lineTo(0.228947, 0.292105).close()
loop5=wp_sketch1.moveTo(0.718421, 0.615789).lineTo(0.528947, 0.742105).lineTo(0.513158, 0.513158).close()
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.375000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
