import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.094737, -0.094737).lineTo(0.410526, 0.205263).lineTo(0.600000, 0.015789).lineTo(0.757895, 0.015789).lineTo(0.900000, 0.015789).lineTo(1.089474, 0.205263).lineTo(1.405263, -0.094737).lineTo(1.500000, 0.000000).lineTo(1.042105, 0.457895).lineTo(0.757895, 0.457895).lineTo(0.457895, 0.457895).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.852632, 0.205263).lineTo(0.852632, 0.315789).lineTo(0.647368, 0.315789).lineTo(0.647368, 0.205263).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.578125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
