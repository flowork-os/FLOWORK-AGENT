import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.710938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013513, -0.032622), (0.046135, -0.046135)).lineTo(0.169161, -0.046135).threePointArc((0.201783, -0.032622), (0.215296, 0.000000)).lineTo(0.215296, 1.460938).lineTo(0.000000, 1.460938).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
