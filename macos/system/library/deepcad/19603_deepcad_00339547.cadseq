# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00339547" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.000000, 0.632812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.304688, 0.000000).lineTo(0.304688, 0.118668).lineTo(0.000000, 0.118668).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.080181, 0.019243).circle(0.006414)
loop2=wp_sketch0.moveTo(0.080181, 0.102632).circle(0.006414)
loop3=wp_sketch0.moveTo(0.224507, 0.019243).circle(0.006414)
loop4=wp_sketch0.moveTo(0.224507, 0.102632).circle(0.006414)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.000000, -0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.304688, 0.000000).lineTo(0.304688, 0.118668).lineTo(0.000000, 0.118668).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch1.moveTo(0.080181, 0.019243).circle(0.006414)
loop7=wp_sketch1.moveTo(0.080181, 0.102632).circle(0.006414)
loop8=wp_sketch1.moveTo(0.224507, 0.019243).circle(0.006414)
loop9=wp_sketch1.moveTo(0.224507, 0.102632).circle(0.006414)
solid1=wp_sketch1.add(loop5).add(loop6).add(loop7).add(loop8).add(loop9).extrude(0.117188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
