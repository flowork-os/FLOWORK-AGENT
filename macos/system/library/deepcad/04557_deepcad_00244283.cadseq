# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00244283" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, -0.015789).lineTo(0.157895, -0.015789).lineTo(0.157895, -0.189474).lineTo(1.342105, -0.189474).lineTo(1.342105, -0.015789).lineTo(1.500000, -0.015789).lineTo(1.500000, 0.000000).lineTo(1.247368, 0.252632).lineTo(0.252632, 0.252632).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.484211, 0.000000).lineTo(1.247368, 0.236842).lineTo(0.252632, 0.236842).lineTo(0.015789, 0.000000).close()
loop2=wp_sketch0.moveTo(1.326316, -0.173684).lineTo(1.326316, -0.015789).lineTo(0.173684, -0.015789).lineTo(0.173684, -0.173684).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
