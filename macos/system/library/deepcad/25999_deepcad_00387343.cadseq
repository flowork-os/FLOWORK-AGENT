# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387343" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, 0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.062500, 0.000000).threePointArc((0.031250, 0.005225), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.406250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.259211, 0.000000).threePointArc((1.359375, 0.100164), (1.259211, 0.200329)).lineTo(0.071546, 0.200329).lineTo(0.000000, 0.200329).threePointArc((-0.071467, 0.100164), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.028618, 0.100164).circle(0.042928)
loop3=wp_sketch1.moveTo(1.259211, 0.100164).circle(0.042928)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.406250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
