# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00249362" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.065625, 0.000000).lineTo(0.065625, 0.164062).lineTo(0.000000, 0.164062).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.132812, 0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.065625, 0.000000).lineTo(0.065625, 0.164062).lineTo(0.000000, 0.164062).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.078125, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.636349, 0.000000).lineTo(0.636349, -0.324178).lineTo(1.140625, -0.324178).lineTo(1.140625, 0.000000).lineTo(0.816447, 0.000000).lineTo(0.816447, 0.132072).lineTo(0.588322, 0.132072).lineTo(0.516283, 0.132072).lineTo(0.264145, 0.132072).lineTo(0.192105, 0.132072).lineTo(0.000000, 0.132072).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.912500, -0.168092).circle(0.048026)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.078125, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
