loop2=wp_sketch1.moveTo(0.663158, 0.000000).circle(0.207237)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.049753, 0.000000).threePointArc((0.337698, 0.539317), (0.945312, 0.606990)).lineTo(0.945312, 0.656743).threePointArc((0.302285, 0.573602), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(-0.062500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((1.115621, -0.579917), (0.947368, 0.666118)).lineTo(0.947368, 0.606908).threePointArc((1.072087, -0.553818), (0.044408, 0.000000)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(-0.062500)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((1.192501, -0.617923), (0.994737, 0.710526)).lineTo(0.994737, 0.663158).threePointArc((1.160136, -0.581397), (0.047368, 0.000000)).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(0.406250)
solid=solid.union(solid4)

