import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((1.192501, -0.617923), (0.994737, 0.710526)).lineTo(0.994737, 0.663158).threePointArc((1.160136, -0.581397), (0.047368, 0.000000)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.062500)
solid=solid0
# workplane for sketch 1
