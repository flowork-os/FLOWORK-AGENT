# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.070312, 0.023438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch4.moveTo(0.093750, 0.000000).lineTo(0.093750, 0.082895).lineTo(0.000000, 0.082895).lineTo(0.000000, 0.000000).close()
