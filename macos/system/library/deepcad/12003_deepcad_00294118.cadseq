wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.718421, 0.000000).lineTo(0.718421, 0.031579).lineTo(0.750000, 0.071053).lineTo(0.750000, 0.457895).lineTo(0.718421, 0.473684).lineTo(0.718421, 0.600000).lineTo(0.694737, 0.631579).lineTo(0.000000, 0.631579).lineTo(0.000000, 0.000000).close()
