loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013874, -0.033495), (0.047368, -0.047368)).lineTo(1.452632, -0.047368).threePointArc((1.486126, -0.033495), (1.500000, 0.000000)).lineTo(1.500000, 0.963158).threePointArc((1.486126, 0.996652), (1.452632, 1.010526)).lineTo(0.047368, 1.010526).threePointArc((0.013874, 0.996652), (0.000000, 0.963158)).lineTo(0.000000, 0.000000).close()
