# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00228543" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.406990, 0.000000).lineTo(0.406990, 0.789062).lineTo(0.000000, 0.789062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.373766, 0.033224).lineTo(0.373766, 0.755839).lineTo(0.033224, 0.755839).lineTo(0.033224, 0.033224).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
