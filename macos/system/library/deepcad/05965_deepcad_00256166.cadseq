# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00256166" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, -0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.648438, 0.409539).lineTo(0.252549, 0.409539).lineTo(0.000000, 0.409539).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.138405, 0.000000).lineTo(0.398438, 0.000000).lineTo(0.398438, 0.138405).lineTo(0.000000, 0.138405).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.398602, 0.000000).lineTo(1.023438, 0.000000).lineTo(1.023438, 0.140049).lineTo(0.000000, 0.140049).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.750000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, -0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.139474, 0.000000).lineTo(0.139474, 0.414062).lineTo(0.000000, 0.414062).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.632812)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
