import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.139145, -0.139145).lineTo(0.139145, 0.000000).lineTo(0.000000, 0.140625).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.098684, -0.096628).lineTo(0.195312, 0.000000).lineTo(0.098684, 0.098684).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.015625, 0.000000, -0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.139145, 0.139145).lineTo(0.139145, 0.281250).lineTo(0.000000, 0.139145).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.078125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.250000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.505263).lineTo(0.000000, 0.505263).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.726316, 0.078947).lineTo(0.726316, 0.221053).lineTo(0.584211, 0.363158).lineTo(0.584211, 0.221053).close()
loop5=wp_sketch3.moveTo(0.757895, 0.252632).lineTo(0.852632, 0.347368).lineTo(0.757895, 0.457895).lineTo(0.647368, 0.347368).close()
loop6=wp_sketch3.moveTo(0.915789, 0.221053).lineTo(0.915789, 0.363158).lineTo(0.773684, 0.221053).lineTo(0.773684, 0.078947).close()
solid3=wp_sketch3.add(loop3).add(loop4).add(loop5).add(loop6).extrude(0.031250)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
