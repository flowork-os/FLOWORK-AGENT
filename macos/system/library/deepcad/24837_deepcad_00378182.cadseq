# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00378182" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.600000, 0.000000).circle(0.600000)
solid0=wp_sketch0.add(loop0).extrude(-0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, -0.296875, -0.039062), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.101562, 0.000000).lineTo(0.101562, 0.101562).lineTo(0.000000, 0.101562).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.710938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.289062, -0.296875, -0.039062), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch2.moveTo(0.101562, 0.000000).lineTo(0.101562, 0.101562).lineTo(0.000000, 0.101562).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.710938)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.289062, 0.398438, -0.039062), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch3.moveTo(0.101562, 0.000000).lineTo(0.101562, 0.101562).lineTo(0.000000, 0.101562).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.710938)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.398438, -0.039062), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch4.moveTo(0.101562, 0.000000).lineTo(0.101562, 0.101562).lineTo(0.000000, 0.101562).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.710938)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
