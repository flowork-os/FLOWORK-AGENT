# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00321488" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.276316, 0.000000).lineTo(0.276316, 0.102632).lineTo(0.442105, 0.102632).lineTo(0.442105, 0.071053).lineTo(0.615789, 0.071053).lineTo(0.615789, 0.000000).lineTo(0.615789, -0.173684).lineTo(0.750000, -0.173684).lineTo(0.750000, 0.339474).lineTo(0.000000, 0.339474).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.507812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.171875, 0.000000, 0.507812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.102632, 0.000000).lineTo(0.102632, 0.102632).lineTo(0.272368, 0.102632).lineTo(0.272368, 0.067105).lineTo(0.375000, 0.067105).lineTo(0.375000, 0.339474).lineTo(0.000000, 0.339474).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.171875)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
