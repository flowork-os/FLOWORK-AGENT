import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.248684, -0.450740).lineTo(0.730510, -0.621711).lineTo(1.212336, -0.450740).lineTo(1.476562, 0.000000).lineTo(1.383306, 0.497368).lineTo(0.994737, 0.839309).lineTo(0.481826, 0.839309).lineTo(0.093257, 0.497368).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.257812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
