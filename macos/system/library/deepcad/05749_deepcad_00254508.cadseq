# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00254508" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, 0.632812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.122368, 0.000000).circle(0.122368)
loop1=wp_sketch0.moveTo(0.198849, -0.079030).lineTo(0.198849, 0.068832).lineTo(0.122368, 0.068832).lineTo(0.045888, 0.068832).lineTo(0.045888, 0.000000).lineTo(0.045888, -0.079030).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.632812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.070312, 0.000000).lineTo(0.070312, 0.064391).lineTo(0.000000, 0.064391).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.101562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.554688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.148438, 0.000000).lineTo(0.148438, 0.142187).lineTo(0.073438, 0.142187).lineTo(0.073438, 0.075000).lineTo(0.000000, 0.075000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.101562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
