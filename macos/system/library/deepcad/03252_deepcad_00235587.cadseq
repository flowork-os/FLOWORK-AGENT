# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00235587" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, -0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.492188, 0.000000).lineTo(1.492188, 0.722533).lineTo(0.000000, 0.722533).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.486924, 0.157072).lineTo(0.486924, 0.581168).lineTo(0.109951, 0.361266).close()
loop2=wp_sketch0.moveTo(1.382237, 0.361266).lineTo(1.005263, 0.581168).lineTo(1.005263, 0.157072).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.351562, -0.203536).lineTo(0.351562, 0.203536).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.101562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
