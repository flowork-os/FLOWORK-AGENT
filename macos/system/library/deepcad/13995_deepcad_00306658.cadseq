# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306658" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, -0.593750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.812500, 0.000000).lineTo(0.812500, 1.187500).lineTo(0.250000, 1.187500).lineTo(0.250000, 1.150000).lineTo(0.175000, 1.150000).lineTo(0.175000, 1.187500).lineTo(0.000000, 1.187500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.062500, 0.062500).circle(0.025000)
loop2=wp_sketch0.moveTo(0.062500, 1.125000).circle(0.025000)
loop3=wp_sketch0.moveTo(0.762500, 0.062500).circle(0.025000)
loop4=wp_sketch0.moveTo(0.762500, 1.125000).circle(0.025000)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.562500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.070312, 0.000000).lineTo(0.070312, 0.031086).lineTo(0.000000, 0.031086).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.023438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
