# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00373263" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, 0.000000, -0.398438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.007812, 0.000000).lineTo(1.007812, 0.339474).lineTo(0.509211, 0.668339).lineTo(0.000000, 0.668339).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.509211, 0.339474).circle(0.169737)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.335938, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
