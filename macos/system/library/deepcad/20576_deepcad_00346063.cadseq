import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013364, -0.121860), (0.054523, -0.237336)).lineTo(0.067352, -0.243750).lineTo(0.150740, -0.243750).lineTo(0.237336, -0.243750).lineTo(0.250164, -0.237336).threePointArc((0.292802, -0.122200), (0.304688, 0.000000)).lineTo(0.291859, 0.016036).threePointArc((0.147533, 0.032042), (0.003207, 0.016036)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.020154, -0.119404), (0.067352, -0.230921)).lineTo(0.150740, -0.230921).lineTo(0.237336, -0.230921).threePointArc((0.277954, -0.118785), (0.288651, 0.000000)).threePointArc((0.152522, 0.016720), (0.016036, 0.003207)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.014391, 0.002878).threePointArc((0.020887, -0.116052), (0.054688, -0.230263)).lineTo(0.135280, -0.230263).lineTo(0.218750, -0.230263).threePointArc((0.260825, -0.120114), (0.273438, -0.002878)).threePointArc((0.136878, 0.013723), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
