# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00311050" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.036997, -0.089319), (0.126316, -0.126316)).lineTo(0.623684, -0.126316).threePointArc((0.745364, -0.031922), (0.686842, 0.110526)).lineTo(0.189474, 0.410526).threePointArc((0.062529, 0.410477), (0.000000, 0.300000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.126316, 0.000000).circle(0.039474)
loop2=wp_sketch0.moveTo(0.126316, 0.300000).circle(0.039474)
loop3=wp_sketch0.moveTo(0.623684, 0.000000).circle(0.039474)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
