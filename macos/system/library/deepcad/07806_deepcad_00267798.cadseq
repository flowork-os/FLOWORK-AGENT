wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.081414, -0.486922), (0.162829, 0.000000)).threePointArc((0.129272, 0.083603), (0.130263, 0.173684)).threePointArc((0.121935, 0.251376), (0.097697, 0.325658)).threePointArc((0.068227, 0.418813), (0.081414, 0.515625)).threePointArc((0.035911, 0.417114), (0.048849, 0.309375)).threePointArc((0.059169, 0.233388), (0.048849, 0.157401)).threePointArc((0.013243, 0.082171), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
