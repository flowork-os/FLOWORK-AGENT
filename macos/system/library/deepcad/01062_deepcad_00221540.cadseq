# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00221540" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.085938, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.643092, -0.097862).threePointArc((0.664417, 0.062524), (0.650082, 0.223684)).lineTo(0.006990, 0.153783).threePointArc((0.032615, 0.075568), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.580181, -0.013980).circle(0.055921)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.094572, -0.015132).threePointArc((-0.105811, 0.066466), (0.098355, 0.138076)).lineTo(0.003783, 0.128618).threePointArc((-0.054274, 0.065961), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.097697, -0.014803).threePointArc((0.128609, 0.062351), (0.100658, 0.140625)).lineTo(0.002961, 0.130263).threePointArc((0.076056, 0.063437), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.078125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
