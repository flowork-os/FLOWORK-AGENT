# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00355135" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.406250, -0.742188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.156250, 0.000000).lineTo(1.156250, 0.511184).lineTo(0.000000, 0.511184).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.943475, -0.473903), (0.243421, 0.316447)).threePointArc((0.206908, 0.409402), (0.170395, 0.316447)).close()
loop2=wp_sketch0.moveTo(0.170395, 0.316447).threePointArc((0.395559, -0.852987), (0.620724, 0.316447)).threePointArc((0.578125, 0.424894), (0.535526, 0.316447)).close()
loop3=wp_sketch0.moveTo(0.535526, 0.316447).threePointArc((0.760691, -0.852987), (0.985855, 0.316447)).threePointArc((0.949342, 0.409402), (0.912829, 0.316447)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.500000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.179688, -0.296875, -0.226562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.137007, 0.000000).lineTo(0.137007, 0.929687).lineTo(0.000000, 0.929687).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop4).extrude(-0.109375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
