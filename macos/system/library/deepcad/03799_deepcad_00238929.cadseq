# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00238929" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.484375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.867188, -0.009128).lineTo(0.118668, 0.273849).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.182566, 0.118668).circle(0.118668)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.335526, 0.000000).circle(0.335526)
loop3=wp_sketch1.moveTo(0.566201, -0.230674).lineTo(0.566201, 0.230674).lineTo(0.097862, 0.230674).lineTo(0.097862, -0.230674).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.164062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.468750, 0.000000).lineTo(0.468750, 0.468750).lineTo(0.000000, 0.468750).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.236842, 0.231908).circle(0.231908)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.164062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
