# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267126" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.843750, 0.000000).threePointArc((0.421875, 0.421875), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.408553, 0.044408).lineTo(0.168750, 0.284211).threePointArc((0.084255, 0.175885), (0.044408, 0.044408)).close()
loop2=wp_sketch0.moveTo(0.408553, 0.062171).lineTo(0.408553, 0.381908).threePointArc((0.285667, 0.356805), (0.177632, 0.293092)).close()
loop3=wp_sketch0.moveTo(0.799342, 0.044408).threePointArc((0.759495, 0.175885), (0.675000, 0.284211)).lineTo(0.435197, 0.044408).close()
loop4=wp_sketch0.moveTo(0.666118, 0.293092).threePointArc((0.558083, 0.356805), (0.435197, 0.381908)).lineTo(0.435197, 0.062171).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
