# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00283498" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, -0.429688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.111760, 0.471875).threePointArc((0.112141, 0.484293), (0.111760, 0.496711)).threePointArc((0.142581, 0.770964), (0.235938, 1.030674)).threePointArc((0.186266, 1.167270), (0.049671, 1.117599)).threePointArc((-0.093463, 0.564057), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.136595, 1.080345).circle(0.049671)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, -0.429688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.027462, -0.061237), (0.057895, -0.121053)).threePointArc((0.148304, -0.179142), (0.242105, -0.231579)).threePointArc((0.291047, -0.165525), (0.278947, -0.084211)).threePointArc((0.159520, 0.197324), (0.115789, 0.500000)).threePointArc((0.110203, 0.489635), (0.105263, 0.478947)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.184211, -0.136842).circle(0.052632)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.054688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, -0.546875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.018497, -0.034278), (0.037829, -0.068092)).threePointArc((0.101315, -0.115441), (0.179688, -0.104030)).threePointArc((0.088247, -0.054772), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop4).extrude(0.054688)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
