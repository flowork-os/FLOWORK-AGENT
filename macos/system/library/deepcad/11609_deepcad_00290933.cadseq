# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00290933" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.578125, -0.484375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.252878, 0.212418).threePointArc((0.155109, 0.480469), (0.252878, 0.748520)).lineTo(0.000000, 0.960938).threePointArc((-0.175247, 0.480469), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.010115, 0.273109).circle(0.040461)
loop2=wp_sketch0.moveTo(-0.010115, 0.687829).circle(0.040461)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
