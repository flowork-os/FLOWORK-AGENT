# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00286705" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, -0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.773437, 0.081414).threePointArc((0.688102, 0.158758), (0.773437, 0.236102)).lineTo(0.000000, 0.309375).threePointArc((0.140201, 0.154687), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.529194, 0.113980).threePointArc((0.569901, 0.154687), (0.529194, 0.195395)).lineTo(0.219819, 0.195395).threePointArc((0.179112, 0.154687), (0.219819, 0.113980)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.157895, 0.000000).circle(0.157895)
loop3=wp_sketch1.moveTo(0.157895, 0.000000).circle(0.118421)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.234375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.593750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.078947, 0.000000).circle(0.077303)
loop5=wp_sketch2.moveTo(0.078947, 0.000000).circle(0.039474)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.234375)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
