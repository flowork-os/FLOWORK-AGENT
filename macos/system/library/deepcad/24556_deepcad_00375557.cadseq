# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, -0.695312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.077961, -0.051974).lineTo(0.077961, 0.077961).lineTo(0.168914, 0.000000).lineTo(0.324836, 0.116941).lineTo(0.324836, 0.285855).lineTo(0.324836, 0.909539).lineTo(0.337829, 0.909539).lineTo(0.337829, 1.104441).lineTo(0.181908, 1.234375).lineTo(0.012993, 1.104441).lineTo(0.012993, 0.909539).lineTo(0.012993, 0.285855).lineTo(0.012993, 0.116941).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.312500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
