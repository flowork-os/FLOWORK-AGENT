wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.257812, -0.054688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.002714, -0.002714).lineTo(0.043421, 0.043421).lineTo(0.073273, 0.043421).lineTo(0.073273, 0.051563).lineTo(0.257812, 0.051563).lineTo(0.257812, 0.054276).lineTo(0.070559, 0.054276).lineTo(0.070559, 0.046135).lineTo(0.040707, 0.046135).lineTo(0.000000, 0.000000).close()
