solid2=wp_sketch2.add(loop2).extrude(0.304688)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.236842, 0.000000).circle(0.236842)
loop4=wp_sketch3.moveTo(0.236842, 0.000000).circle(0.064145)
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.343750)
