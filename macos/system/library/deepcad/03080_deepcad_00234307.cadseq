# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00234307" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.734375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.726316).threePointArc((0.750000, 1.476316), (0.000000, 0.726316)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.157895, 0.142105).circle(0.063158)
loop2=wp_sketch0.moveTo(0.757895, 0.726316).circle(0.031579)
loop3=wp_sketch0.moveTo(1.342105, 0.142105).circle(0.063158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.015789).lineTo(0.000000, 0.015789).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop4).extrude(0.632812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.640625, -0.320312, -0.734375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch2.moveTo(0.031579, 0.000000).circle(0.030921)
solid2=wp_sketch2.add(loop5).extrude(-0.398438)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, -0.320312, -0.734375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.031579, 0.000000).circle(0.030921)
solid3=wp_sketch3.add(loop6).extrude(-0.398438)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
