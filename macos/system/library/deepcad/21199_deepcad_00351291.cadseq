# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00351291" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.185526, 0.000000).circle(0.185526)
loop1=wp_sketch0.moveTo(0.112089, -0.123684).lineTo(0.255099, -0.123684).lineTo(0.324671, 0.000000).lineTo(0.255099, 0.123684).lineTo(0.112089, 0.123684).lineTo(0.042516, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.507812, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.122368, 0.000000).circle(0.122368)
loop3=wp_sketch1.moveTo(0.056086, -0.091776).lineTo(0.186102, -0.091776).lineTo(0.226891, 0.035691).lineTo(0.122368, 0.112171).lineTo(0.015296, 0.035691).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.125000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.034046, 0.079441).threePointArc((0.052461, 0.057047), (0.056743, 0.028372)).lineTo(0.493668, 0.017023).threePointArc((0.518113, 0.013171), (0.539062, 0.000000)).threePointArc((0.507903, 0.082278), (0.539062, 0.164556)).threePointArc((0.518841, 0.148256), (0.493668, 0.141859)).lineTo(0.051069, 0.153207).threePointArc((0.021796, 0.160663), (0.000000, 0.181579)).threePointArc((0.024526, 0.090789), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.425576, 0.051069).threePointArc((0.456785, 0.082278), (0.425576, 0.113487)).lineTo(0.107813, 0.119161).threePointArc((0.076604, 0.087952), (0.107813, 0.056743)).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.125000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
