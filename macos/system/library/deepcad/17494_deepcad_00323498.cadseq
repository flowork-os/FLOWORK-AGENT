# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00323498" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.118421, 0.000000).lineTo(0.118421, -0.276316).lineTo(0.750000, -0.276316).lineTo(0.750000, 0.221053).lineTo(0.000000, 0.221053).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.126316, 0.007895).lineTo(0.126316, -0.268421).lineTo(0.742105, -0.268421).lineTo(0.742105, 0.205263).lineTo(0.007895, 0.205263).lineTo(0.007895, 0.007895).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
