wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.108635, -0.018173), (0.199836, -0.079934)).threePointArc((0.519572, -0.216994), (0.839309, -0.079934)).threePointArc((0.930766, -0.018814), (1.039145, 0.000000)).threePointArc((1.264426, 0.219819), (1.039145, 0.439638)).threePointArc((0.930766, 0.458453), (0.839309, 0.519572)).threePointArc((0.519572, 0.656632), (0.199836, 0.519572)).threePointArc((0.108635, 0.457811), (0.000000, 0.439638)).threePointArc((-0.228065, 0.219819), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.013322, 0.226480).circle(0.093257)
