# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.171875, -0.750000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop7=wp_sketch5.moveTo(0.015789, 0.000000).circle(0.015461)
