loop4=wp_sketch2.moveTo(0.671875, 0.000000).lineTo(0.671875, 0.162664).lineTo(0.000000, 0.162664).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(-0.187500)
