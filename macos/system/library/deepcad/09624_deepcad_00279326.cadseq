import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, -0.593750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.437500, 0.000000).lineTo(1.437500, 1.119737).lineTo(0.000000, 1.119737).lineTo(0.000000, 0.000000).close()
