solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, -0.593750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
