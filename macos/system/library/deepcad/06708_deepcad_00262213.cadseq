# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00262213" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.703125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.390625, 0.000000).lineTo(1.390625, 1.390625).lineTo(0.000000, 1.390625).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.673355, 0.058553).lineTo(0.673355, 0.673355).lineTo(0.058553, 0.673355).lineTo(0.058553, 0.058553).close()
loop2=wp_sketch0.moveTo(0.673355, 0.717270).lineTo(0.673355, 1.332072).lineTo(0.058553, 1.332072).lineTo(0.058553, 0.717270).close()
loop3=wp_sketch0.moveTo(1.332072, 0.058553).lineTo(1.332072, 0.673355).lineTo(0.717270, 0.673355).lineTo(0.717270, 0.058553).close()
loop4=wp_sketch0.moveTo(1.332072, 0.717270).lineTo(1.332072, 1.332072).lineTo(0.717270, 1.332072).lineTo(0.717270, 0.717270).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.281250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
