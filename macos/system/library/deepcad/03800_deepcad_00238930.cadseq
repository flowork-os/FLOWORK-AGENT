import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.576234, 0.000000).threePointArc((0.594144, 0.007419), (0.601562, 0.025329)).lineTo(0.601562, 0.164638).threePointArc((0.577452, 0.222847), (0.519243, 0.246957)).lineTo(0.436924, 0.246957).threePointArc((0.419014, 0.239539), (0.411595, 0.221628)).lineTo(0.411595, 0.164638).lineTo(0.246957, 0.164638).threePointArc((0.229047, 0.172057), (0.221628, 0.189967)).lineTo(0.221628, 0.246957).threePointArc((0.197518, 0.305166), (0.139309, 0.329276)).lineTo(0.025329, 0.329276).threePointArc((0.007419, 0.321858), (0.000000, 0.303947)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.122039, 0.000000).lineTo(0.357401, 0.000000).threePointArc((0.397467, 0.016596), (0.414062, 0.056661)).lineTo(0.414062, 0.339967).lineTo(0.000000, 0.165625).lineTo(0.000000, 0.108964).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.122039, 0.108964).circle(0.082812)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.140625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
