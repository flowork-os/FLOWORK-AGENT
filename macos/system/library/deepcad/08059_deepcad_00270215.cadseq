# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00270215" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.054688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.119737, 0.000000).lineTo(1.302138, 0.000000).lineTo(1.421875, 0.000000).lineTo(1.421875, 0.119737).lineTo(0.000000, 0.119737).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.059868, 0.059868).circle(0.014967)
loop2=wp_sketch0.moveTo(0.434046, 0.059868).circle(0.014967)
loop3=wp_sketch0.moveTo(0.987829, 0.059868).circle(0.014967)
loop4=wp_sketch0.moveTo(1.362007, 0.059868).circle(0.014967)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
