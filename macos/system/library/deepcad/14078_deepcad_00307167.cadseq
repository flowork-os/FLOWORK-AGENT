import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.236267, -0.416787), (0.678947, -0.600000)).lineTo(0.678947, -0.126316).threePointArc((0.644300, -0.106723), (0.615789, -0.078947)).lineTo(0.157895, -0.078947).close()
loop2=wp_sketch0.moveTo(0.615789, 0.078947).threePointArc((0.644300, 0.106723), (0.678947, 0.126316)).lineTo(0.678947, 0.600000).threePointArc((0.328794, 0.429101), (0.157895, 0.078947)).close()
loop3=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.031579)
loop4=wp_sketch0.moveTo(0.157895, 0.078947).threePointArc((0.722840, -0.203698), (1.342105, -0.078947)).lineTo(0.884211, -0.078947).threePointArc((0.855700, -0.106723), (0.821053, -0.126316)).lineTo(0.821053, -0.600000).close()
loop5=wp_sketch0.moveTo(0.821053, -0.600000).threePointArc((0.808645, -0.256435), (0.884211, 0.078947)).lineTo(1.342105, 0.078947).threePointArc((1.171206, 0.429101), (0.821053, 0.600000)).lineTo(0.821053, 0.126316).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.046875, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
