# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00255726" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.710938, 0.000000).lineTo(0.710938, 0.359211).lineTo(0.546299, 0.359211).threePointArc((0.355469, 0.168380), (0.164638, 0.359211)).lineTo(0.000000, 0.359211).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.089803, 0.089803).circle(0.044901)
loop2=wp_sketch0.moveTo(0.621135, 0.089803).circle(0.044901)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.359375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.203125, 0.359375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.218750, 0.000000).threePointArc((0.178040, 0.062607), (0.163487, 0.135855)).lineTo(0.000000, 0.135855).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.085938)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, -0.023438, 0.359375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.359375, 0.000000).lineTo(0.359375, 0.359375).lineTo(0.196711, 0.359375).threePointArc((0.139095, 0.220280), (0.000000, 0.162664)).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.268586, 0.090789).circle(0.045395)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(-0.085938)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
