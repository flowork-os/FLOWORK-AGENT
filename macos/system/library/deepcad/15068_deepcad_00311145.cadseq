import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, -0.445312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.015461, 0.000000).lineTo(1.015461, 0.290132).lineTo(0.749507, 0.290132).lineTo(0.749507, 0.930839).lineTo(1.015461, 0.930839).lineTo(1.015461, 1.148438).lineTo(0.000000, 1.148438).lineTo(0.000000, 0.930839).lineTo(0.278043, 0.930839).lineTo(0.278043, 0.290132).lineTo(0.000000, 0.290132).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
