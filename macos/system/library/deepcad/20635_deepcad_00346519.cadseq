wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.133978, -0.055496), (0.189474, -0.189474)).lineTo(0.568421, -0.189474).threePointArc((0.750000, -0.007895), (0.931579, -0.189474)).lineTo(1.310526, -0.189474).threePointArc((1.366022, -0.055496), (1.500000, 0.000000)).lineTo(1.500000, 0.189474).lineTo(1.500000, 0.378947).threePointArc((1.366022, 0.434443), (1.310526, 0.568421)).lineTo(0.931579, 0.568421).threePointArc((0.750000, 0.386842), (0.568421, 0.568421)).lineTo(0.189474, 0.568421).threePointArc((0.133978, 0.434443), (0.000000, 0.378947)).lineTo(0.000000, 0.189474).lineTo(0.000000, 0.000000).close()
