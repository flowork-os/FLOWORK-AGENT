# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00266903" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.648438, 0.531250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.242188, 0.000000).lineTo(0.221793, 0.137664).threePointArc((0.121094, 0.019468), (0.020395, 0.137664)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.632812, 0.648438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.098684, 0.000000).circle(0.096628)
loop2=wp_sketch1.moveTo(0.063734, -0.057566).lineTo(0.131579, -0.057566).lineTo(0.164474, 0.000000).lineTo(0.131579, 0.059622).lineTo(0.063734, 0.059622).lineTo(0.030839, 0.000000).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.601562, 0.648438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.035526, -0.060691).lineTo(0.105099, -0.060691).lineTo(0.140625, 0.000000).lineTo(0.105099, 0.060691).lineTo(0.035526, 0.060691).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.069572, 0.000000).circle(0.035526)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.039062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
