# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00360058" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.098684, 0.000000).circle(0.098684)
loop1=wp_sketch0.moveTo(0.098684, 0.000000).circle(0.047286)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.000000, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.017007, -0.029663), (0.023026, -0.063322)).lineTo(0.518092, -0.063322).threePointArc((0.524965, -0.028243), (0.546875, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.195312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.546875, 0.000000).threePointArc((0.524965, 0.028243), (0.518092, 0.063322)).lineTo(0.023026, 0.063322).threePointArc((0.017007, 0.029663), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.195312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.593750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.078947, 0.000000).circle(0.078947)
loop5=wp_sketch3.moveTo(0.078947, 0.000000).circle(0.047697)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.195312)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
