# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00264645" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.109375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.640625, 0.000000).lineTo(0.640625, 0.445066).lineTo(0.000000, 0.445066).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.112500, 0.000000).lineTo(0.112500, 0.445312).lineTo(0.000000, 0.445312).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.065625, 0.089063).circle(0.014062)
loop3=wp_sketch1.moveTo(0.065625, 0.356250).circle(0.014062)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.112500, 0.000000).lineTo(0.112500, 0.445312).lineTo(0.000000, 0.445312).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.065625, 0.089063).circle(0.014062)
loop6=wp_sketch2.moveTo(0.065625, 0.356250).circle(0.014062)
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).extrude(-0.046875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
