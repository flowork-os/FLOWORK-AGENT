# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00342770" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.968750, 0.000000).lineTo(0.968750, 0.336513).lineTo(0.000000, 0.336513).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.050987, 0.050987).circle(0.010197)
loop2=wp_sketch0.moveTo(0.050987, 0.285526).circle(0.010197)
loop3=wp_sketch0.moveTo(0.571053, 0.050987).lineTo(0.571053, 0.244737).lineTo(0.091776, 0.244737).lineTo(0.091776, 0.050987).close()
loop4=wp_sketch0.moveTo(0.734211, 0.050987).circle(0.010197)
loop5=wp_sketch0.moveTo(0.734211, 0.285526).circle(0.010197)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
