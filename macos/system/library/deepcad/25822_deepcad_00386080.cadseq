# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00386080" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.445312, 0.000000).lineTo(1.445312, 0.425987).lineTo(0.988898, 0.425987).threePointArc((0.878783, 0.294355), (0.730263, 0.380345)).threePointArc((0.699458, 0.415215), (0.654194, 0.425987)).lineTo(0.000000, 0.425987).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.152138, 0.136924).circle(0.045641)
loop2=wp_sketch0.moveTo(0.380345, 0.289062).circle(0.060855)
loop3=wp_sketch0.moveTo(1.064967, 0.289062).circle(0.060855)
loop4=wp_sketch0.moveTo(1.293174, 0.136924).circle(0.045641)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.234375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.473684).lineTo(0.000000, 0.473684).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.046875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
