# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00271469" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.476562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.568092, -0.271135).lineTo(1.123273, 0.000000).lineTo(1.123273, 0.800493).threePointArc((0.561637, 1.222398), (0.000000, 0.800493)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.601562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.328125, 0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.804688, 0.000000).lineTo(0.804688, 0.372697).lineTo(0.000000, 0.372697).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-1.000000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.476562, 0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.804688, 0.000000).lineTo(0.804688, 0.372697).lineTo(0.000000, 0.372697).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-1.000000)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
