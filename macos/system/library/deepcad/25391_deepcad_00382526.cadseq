# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382526" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.000000, -0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.688651, 0.000000).lineTo(0.688651, 1.065461).lineTo(0.545724, 1.234375).lineTo(0.103947, 1.234375).lineTo(0.000000, 1.065461).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.311842, 0.883553).circle(0.220888)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.625000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
