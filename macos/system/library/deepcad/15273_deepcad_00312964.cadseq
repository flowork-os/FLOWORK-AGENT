import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.000000, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.095888, -0.331250).threePointArc((0.414062, -0.570264), (0.732237, -0.331250)).lineTo(0.828125, 0.000000).threePointArc((0.791708, 0.074428), (0.714803, 0.043586)).threePointArc((0.409704, -0.152249), (0.104605, 0.043586)).threePointArc((0.032058, 0.070379), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.273438, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
