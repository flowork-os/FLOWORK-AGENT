import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, -0.710938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.035526, -0.035526), (0.071053, 0.000000)).lineTo(0.071053, 0.710526).threePointArc((0.035526, 0.746053), (0.000000, 0.710526)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.027632, -0.011842), (0.039474, 0.015789)).lineTo(0.039474, 0.252632).threePointArc((0.035526, 0.256579), (0.031579, 0.252632)).lineTo(0.031579, 0.015789).close()
loop2=wp_sketch0.moveTo(0.031579, 0.015789).threePointArc((0.240789, 0.217105), (0.039474, 0.426316)).lineTo(0.039474, 0.663158).threePointArc((0.035526, 0.667105), (0.031579, 0.663158)).lineTo(0.031579, 0.426316).close()
loop3=wp_sketch0.moveTo(0.039474, 0.710526).circle(0.007895)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
