# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00222069" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.289062, 0.000000, 0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.152632, -0.124013).threePointArc((0.460217, 0.021464), (0.152632, 0.166941)).lineTo(0.000000, 0.042928).threePointArc((-0.010152, 0.021464), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.289062, -0.031250, 0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.150000, -0.121875).threePointArc((0.447327, 0.018750), (0.150000, 0.159375)).lineTo(0.000000, 0.037500).threePointArc((-0.008868, 0.018750), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(-0.125000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.289062, -0.031250, 0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.150411, -0.121299).threePointArc((0.463300, 0.026686), (0.150411, 0.174671)).lineTo(0.000000, 0.053372).threePointArc((-0.012621, 0.026686), (0.000000, 0.000000)).close()
loop3=wp_sketch2.moveTo(0.155263, -0.116447).threePointArc((0.457893, 0.026686), (0.155263, 0.169819)).lineTo(0.004852, 0.048520).threePointArc((-0.005475, 0.026686), (0.004852, 0.004852)).close()
solid2=wp_sketch2.add(loop2).add(loop3).extrude(-0.031250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
