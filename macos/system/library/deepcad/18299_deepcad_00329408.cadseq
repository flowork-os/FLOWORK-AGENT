import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, -0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.179688, 0.000000).lineTo(0.179688, 0.018914).threePointArc((0.089002, 0.034652), (0.020806, 0.096464)).lineTo(0.000000, 0.096464).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.234375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.157155, 0.000000).lineTo(0.157155, -0.076974).threePointArc((0.211293, 0.232474), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.234375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.067155, -0.060485), (0.156250, -0.075658)).lineTo(0.156250, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.234375)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.148438, 0.234375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.067105, 0.000000).circle(0.065707)
solid3=wp_sketch3.add(loop3).extrude(-0.367188)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.000000, -0.648438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.166776, 0.000000).lineTo(0.166776, 0.102632).threePointArc((0.298427, 0.253372), (0.166776, 0.404112)).lineTo(0.166776, 0.609375).threePointArc((0.213406, -0.082755), (0.000000, 0.577303)).lineTo(0.000000, 0.288651).threePointArc((-0.003912, 0.253372), (0.000000, 0.218092)).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.656250)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
