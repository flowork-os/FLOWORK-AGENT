# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.452632, 0.000000).threePointArc((1.486126, 0.013874), (1.500000, 0.047368)).lineTo(1.500000, 0.947368).threePointArc((1.486126, 0.980863), (1.452632, 0.994737)).lineTo(0.000000, 0.994737).lineTo(0.000000, 0.600000).lineTo(0.094737, 0.600000).threePointArc((0.197368, 0.497368), (0.094737, 0.394737)).lineTo(0.000000, 0.394737).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.600000, 0.505263).circle(0.031579)
loop2=wp_sketch0.moveTo(1.026316, 0.505263).circle(0.126316)
loop3=wp_sketch0.moveTo(1.389474, 0.157895).circle(0.031579)
loop4=wp_sketch0.moveTo(1.389474, 0.836842).circle(0.031579)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
