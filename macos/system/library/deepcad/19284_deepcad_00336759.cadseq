# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00336759" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.726562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.616776, 0.000000).lineTo(0.616776, 1.171875).lineTo(0.000000, 1.171875).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.101562, -0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.039474, 0.000000).circle(0.039474)
solid1=wp_sketch1.add(loop1).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, -0.101562, 0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.398438, 0.000000).lineTo(0.398438, 0.314556).lineTo(0.000000, 0.314556).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.201316, 0.062911).lineTo(0.331332, 0.062911).lineTo(0.331332, 0.159375).lineTo(0.331332, 0.255839).lineTo(0.201316, 0.255839).lineTo(0.067105, 0.255839).lineTo(0.067105, 0.159375).lineTo(0.067105, 0.062911).close()
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.023438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
