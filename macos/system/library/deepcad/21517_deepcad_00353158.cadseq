# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00353158" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.851562, 0.000000).lineTo(0.851562, 0.430263).lineTo(0.000000, 0.430263).threePointArc((-0.215132, 0.215132), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.340625).threePointArc((-0.125493, 0.215132), (0.000000, 0.089638)).close()
loop2=wp_sketch0.moveTo(0.761924, 0.071711).lineTo(0.761924, 0.349589).lineTo(0.089638, 0.349589).lineTo(0.089638, 0.071711).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.265625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
