# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00385266" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.284211, -0.015789), (0.300000, 0.268421)).threePointArc((0.382462, 0.375433), (0.489474, 0.457895)).threePointArc((0.513158, 0.544737), (0.426316, 0.568421)).threePointArc((0.292551, 0.465344), (0.189474, 0.331579)).close()
loop2=wp_sketch0.moveTo(0.189474, 0.331579).threePointArc((0.410262, -0.194721), (0.757895, -0.647368)).threePointArc((0.821053, -0.584211), (0.757895, -0.521053)).threePointArc((0.619592, -0.506864), (0.489474, -0.457895)).threePointArc((0.402632, -0.481579), (0.426316, -0.568421)).close()
loop3=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.189474)
loop4=wp_sketch0.moveTo(0.426316, -0.568421).threePointArc((0.815806, -0.228972), (1.278947, 0.000000)).threePointArc((1.342105, -0.063158), (1.405263, 0.000000)).threePointArc((1.379376, 0.171927), (1.310526, 0.331579)).threePointArc((1.223684, 0.355263), (1.200000, 0.268421)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.363158, 0.000000).circle(0.363158)
loop6=wp_sketch1.moveTo(0.363158, 0.000000).circle(0.189145)
solid1=wp_sketch1.add(loop5).add(loop6).extrude(0.390625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
