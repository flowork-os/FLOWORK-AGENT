# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00255020" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.315789, 0.000000).lineTo(0.315789, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.265625, 0.015625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.020395, 0.000000).lineTo(0.229441, 0.000000).lineTo(0.249836, 0.000000).lineTo(0.249836, 0.244737).lineTo(0.249836, 0.484375).lineTo(0.000000, 0.484375).lineTo(0.000000, 0.244737).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.229441, 0.025493).lineTo(0.229441, 0.458882).lineTo(0.020395, 0.458882).lineTo(0.020395, 0.025493).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, -0.750000, 0.015625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.245888, 0.000000).lineTo(0.245888, 1.015625).lineTo(0.224507, 1.015625).lineTo(0.224507, 0.021382).lineTo(0.021382, 0.021382).lineTo(0.021382, 1.015625).lineTo(0.000000, 1.015625).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.109375)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, -0.265625, 0.125000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.064145, -0.032072).lineTo(1.015625, -0.032072).lineTo(1.015625, 0.000000).lineTo(0.994243, 0.000000).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(-0.289062)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
