wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, 0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.260526, 0.119408).lineTo(0.434211, -0.005428).lineTo(0.363651, 0.168257).lineTo(0.515625, 0.233388).lineTo(0.336513, 0.249671).lineTo(0.303947, 0.325658).lineTo(0.238816, 0.255099).lineTo(0.059704, 0.271382).lineTo(0.173684, 0.184539).lineTo(0.000000, 0.000000).close()
