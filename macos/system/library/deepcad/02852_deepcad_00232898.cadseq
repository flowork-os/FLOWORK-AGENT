# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232898" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.740625, 0.000000).lineTo(0.740625, 0.225000).lineTo(0.890625, 0.225000).lineTo(0.890625, 0.590625).lineTo(0.225000, 0.590625).lineTo(0.225000, 0.450000).lineTo(0.000000, 0.450000).lineTo(0.000000, 0.159375).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.159375, 0.159375).circle(0.075000)
loop2=wp_sketch0.moveTo(0.675000, 0.075000).circle(0.056250)
loop3=wp_sketch0.moveTo(0.750000, 0.478125).circle(0.093750)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, -0.617188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.328125, -0.109375).lineTo(0.742188, 0.039062).lineTo(0.742188, 0.554688).lineTo(0.515625, 0.554688).lineTo(0.515625, 0.406250).lineTo(0.296875, 0.406250).lineTo(0.296875, 0.554688).lineTo(0.000000, 0.554688).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop4).extrude(0.187500)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
