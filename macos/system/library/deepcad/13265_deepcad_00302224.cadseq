# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00302224" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.405263, 0.094737).lineTo(1.405263, 1.405263).lineTo(0.094737, 1.405263).lineTo(0.094737, 0.094737).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, -0.656250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.304688, 0.000000).lineTo(1.304688, 1.304688).lineTo(0.000000, 1.304688).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.672944, 0.906414).lineTo(0.672944, 0.315872).lineTo(0.769079, 0.315872).lineTo(0.769079, 0.988816).lineTo(0.576809, 0.988816).lineTo(0.535609, 0.906414).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.578125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.141859, 0.000000).lineTo(0.141859, -0.585938).lineTo(0.240543, -0.585938).lineTo(0.240543, 0.086349).lineTo(0.043174, 0.086349).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.507812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
