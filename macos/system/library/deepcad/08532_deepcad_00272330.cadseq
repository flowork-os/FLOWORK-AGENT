import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.528947, 0.000000).lineTo(0.528947, 1.046875).lineTo(0.000000, 1.046875).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.210938, -0.125000, -0.250000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.011842, 0.000000).circle(0.011842)
solid1=wp_sketch1.add(loop1).extrude(-0.054688)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.210938, -0.226562, -0.375000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.226562, 0.000000).lineTo(0.226562, 0.157401).lineTo(0.000000, 0.157401).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.116859, 0.124013).circle(0.009539)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.023438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.210938, -0.304688, -0.750000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.055921, 0.000000).lineTo(0.307566, 0.000000).lineTo(0.307566, 0.374671).lineTo(0.078289, 0.374671).lineTo(0.078289, 0.531250).lineTo(0.055921, 0.531250).lineTo(0.055921, 0.391447).lineTo(0.000000, 0.391447).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.023438)
