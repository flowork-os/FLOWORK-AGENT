# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.210938, -0.289062, -0.750000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.307566, 0.000000).lineTo(0.307566, 0.391447).lineTo(0.251645, 0.391447).lineTo(0.251645, 0.531250).lineTo(0.234868, 0.531250).lineTo(0.234868, 0.514474).lineTo(0.234868, 0.374671).lineTo(0.285197, 0.374671).lineTo(0.285197, 0.016776).lineTo(0.016776, 0.016776).lineTo(0.016776, 0.374671).lineTo(0.000000, 0.374671).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(0.531250)
solid=solid.union(solid4)

