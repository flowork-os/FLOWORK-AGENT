# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257650" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.051316, -0.057730).lineTo(0.051316, -0.115461).lineTo(0.145395, -0.115461).lineTo(0.145395, -0.038487).lineTo(0.203125, -0.019243).lineTo(0.153947, 0.051316).lineTo(0.057730, 0.051316).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.010450, -0.024520), (0.035526, -0.033553)).lineTo(0.187500, 0.001974).lineTo(0.187500, 0.110526).lineTo(0.118421, 0.144079).lineTo(0.000000, 0.100658).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
