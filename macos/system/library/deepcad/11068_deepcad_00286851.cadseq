# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00286851" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.159951, 0.000000).threePointArc((1.013363, 0.146587), (1.159951, 0.293174)).lineTo(0.000000, 0.293174).threePointArc((-0.146587, 0.146587), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.140214).circle(0.050987)
loop2=wp_sketch0.moveTo(0.968750, 0.076480).threePointArc((0.898643, 0.146587), (0.968750, 0.216694)).lineTo(0.191201, 0.216694).threePointArc((0.121094, 0.146587), (0.191201, 0.076480)).close()
loop3=wp_sketch0.moveTo(1.159951, 0.140214).circle(0.050987)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.093750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
