# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00319183" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.442105, 0.000000).circle(0.442105)
loop1=wp_sketch0.moveTo(0.110526, 0.147368).threePointArc((0.126194, -0.174278), (0.396053, -0.350000)).lineTo(0.396053, -0.377632).threePointArc((0.432895, -0.379442), (0.469737, -0.377632)).lineTo(0.469737, -0.350000).threePointArc((0.741847, -0.181237), (0.764474, 0.138158)).lineTo(0.792105, 0.156579).threePointArc((0.772101, 0.187911), (0.755263, 0.221053)).lineTo(0.727632, 0.202632).threePointArc((0.444459, 0.353161), (0.156579, 0.211842)).lineTo(0.128947, 0.230263).threePointArc((0.112110, 0.197121), (0.092105, 0.165789)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.250000, 0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.034539, 0.062171).threePointArc((0.152621, -0.116301), (0.183059, -0.328125)).lineTo(0.265954, -0.328125).lineTo(0.265954, 0.079441).lineTo(0.089803, 0.079441).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.242188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.250000, 0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.128371, -0.143509), (0.183059, -0.328125)).lineTo(0.265954, -0.328125).lineTo(0.265954, 0.079441).lineTo(0.089803, 0.079441).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.351562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
