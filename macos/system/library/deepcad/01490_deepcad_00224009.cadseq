# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00224009" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.039474, 0.000000).lineTo(0.039474, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.015789, 0.110526).circle(0.007895)
loop2=wp_sketch0.moveTo(0.015789, 0.639474).circle(0.007895)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch1.moveTo(0.039062, 0.000000).lineTo(0.039062, 0.039062).lineTo(0.000000, 0.039062).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.078125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
