# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236574" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.007812, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.671875, 0.046875).threePointArc((0.741674, 0.121094), (0.671875, 0.195312)).lineTo(0.000000, 0.242188).threePointArc((-0.128762, 0.121094), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.007812, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.671875, 0.046875).threePointArc((0.741674, 0.121094), (0.671875, 0.195312)).lineTo(0.000000, 0.242188).threePointArc((-0.128762, 0.121094), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.101562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.082895, 0.000000).circle(0.081168)
loop3=wp_sketch2.moveTo(0.082895, 0.000000).circle(0.044901)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(-0.296875)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.648438, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.031579, 0.000000).circle(0.031579)
solid3=wp_sketch3.add(loop4).extrude(-0.375000)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
