# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236120" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.054688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.116201, 0.000000).circle(0.116201)
loop1=wp_sketch0.moveTo(1.007072, -0.219490).threePointArc((1.226562, 0.000000), (1.007072, 0.219490)).lineTo(0.116201, 0.219490).threePointArc((0.335691, 0.000000), (0.116201, -0.219490)).close()
loop2=wp_sketch0.moveTo(1.084539, -0.077467).threePointArc((1.162007, 0.000000), (1.084539, 0.077467)).lineTo(0.787582, 0.077467).threePointArc((0.865049, 0.000000), (0.787582, -0.077467)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.390625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.236842, 0.000000).circle(0.236842)
solid1=wp_sketch1.add(loop3).extrude(0.734375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.165789, 0.000000).circle(0.162336)
solid2=wp_sketch2.add(loop4).extrude(0.890625)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
