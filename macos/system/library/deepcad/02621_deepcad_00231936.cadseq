# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231936" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.057214, -0.272621), (0.174671, -0.426974)).lineTo(0.883059, -0.426974).threePointArc((0.866783, 0.108828), (0.494901, 0.494901)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.174671, -0.184375).circle(0.126151)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.312500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
