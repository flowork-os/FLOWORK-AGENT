# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00372348" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.687500, -0.242188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.018023, -0.047621), (0.060526, -0.075658)).lineTo(0.423684, -0.211842).threePointArc((0.476645, -0.219366), (0.529605, -0.211842)).lineTo(1.301316, -0.015132).threePointArc((1.398039, 0.044667), (1.437500, 0.151316)).lineTo(1.437500, 0.272368).threePointArc((1.410908, 0.336566), (1.346711, 0.363158)).lineTo(0.090789, 0.363158).threePointArc((0.027884, 0.335274), (0.000000, 0.272368)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, 0.000000, -0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.173684, 0.000000).lineTo(0.343750, 0.173684).lineTo(0.343750, 0.343750).lineTo(0.000000, 0.343750).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.992188, both=True)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
