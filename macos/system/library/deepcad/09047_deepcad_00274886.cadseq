# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00274886" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.773437, 0.000000).lineTo(0.773437, 0.431497).lineTo(0.000000, 0.431497).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.749013, 0.024424).lineTo(0.749013, 0.415214).lineTo(0.024424, 0.415214).lineTo(0.024424, 0.024424).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.132812, 0.000000, 0.250000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.046875, 0.000000).lineTo(0.046875, 0.014309).lineTo(0.000000, 0.014309).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.023438)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.664062, 0.023438, 0.234375), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.031250, 0.000000).lineTo(0.031250, 0.025987).lineTo(0.000000, 0.025987).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.023438)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
