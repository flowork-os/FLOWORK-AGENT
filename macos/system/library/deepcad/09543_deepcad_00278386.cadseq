# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, -0.445312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.526891, 0.000000).lineTo(0.526891, 0.600411).lineTo(0.563651, 0.637171).lineTo(1.164062, 0.637171).lineTo(1.164062, 1.164062).lineTo(0.318586, 1.164062).lineTo(0.000000, 0.845477).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.335938)
solid=solid0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, -0.445312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.526891, 0.000000).lineTo(0.526891, 0.600411).lineTo(0.563651, 0.637171).lineTo(1.164062, 0.637171).lineTo(1.164062, 1.164062).lineTo(0.318586, 1.164062).lineTo(0.000000, 0.845477).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.335938)
