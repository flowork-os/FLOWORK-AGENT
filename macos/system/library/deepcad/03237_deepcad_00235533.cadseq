wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.531250, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop6=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.000000, -0.179605), (0.179605, -0.179605)).lineTo(0.710938, 0.359211).lineTo(0.531332, 0.359211).lineTo(0.531332, 0.531332).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch4.moveTo(0.089803, -0.089803).circle(0.037418)
