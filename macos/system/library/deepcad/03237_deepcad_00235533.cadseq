loop4=wp_sketch3.moveTo(0.181579, 0.000000).lineTo(0.181579, -0.181579).lineTo(0.710526, 0.355263).threePointArc((0.714474, 0.532895), (0.536842, 0.536842)).lineTo(0.000000, 0.000000).close()
