import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, 0.531250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.531332, -0.531332).lineTo(0.710938, -0.531332).lineTo(0.710938, -0.359211).lineTo(0.179605, 0.179605).threePointArc((0.000000, 0.179605), (0.000000, 0.000000)).close()
