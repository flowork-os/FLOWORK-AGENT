# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.045837, -0.110660), (0.156497, -0.156497)).lineTo(0.597533, -0.156497).threePointArc((0.708193, -0.110660), (0.754030, 0.000000)).lineTo(0.754030, 1.195066).threePointArc((0.708193, 1.305726), (0.597533, 1.351562)).lineTo(0.156497, 1.351562).threePointArc((0.045837, 1.305726), (0.000000, 1.195066)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.369901, 0.597533).circle(0.128043)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.601562)
solid=solid0

if __name__ == '__main__':
    import sys
