# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00218251" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.104178, 0.029089), (0.164062, 0.119161)).threePointArc((0.073567, 0.071235), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.075236, 0.072772), (0.167763, 0.121711)).threePointArc((-0.079835, 0.286519), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.085938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.210938, 0.000000, 0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.278289, 0.023684).threePointArc((0.123777, 0.192413), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.085938)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.421875, 0.000000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.328125, -0.227961).lineTo(0.328125, 0.000000).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.085938)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
