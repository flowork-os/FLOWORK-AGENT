# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00353614" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.625000, 0.000000).lineTo(0.000000, 0.388158).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.312500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.390625, -0.234375, 0.148438), cq.Vector(0.844854, 0.000000, -0.534998), cq.Vector(0.534998, 0.000000, 0.844854)))
loop1=wp_sketch1.moveTo(0.281250, 0.233882).lineTo(0.000000, 0.233882).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.234375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
