# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236615" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.726316, 0.000000).lineTo(0.726316, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.284211, 0.189474).lineTo(0.442105, 0.189474).lineTo(0.521053, 0.331579).lineTo(0.442105, 0.473684).lineTo(0.284211, 0.473684).lineTo(0.189474, 0.331579).close()
loop2=wp_sketch0.moveTo(0.363158, 1.152632).circle(0.063158)
loop3=wp_sketch0.moveTo(0.363158, 0.757895).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(-0.500000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, -0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.082895, -0.141612).lineTo(0.245230, -0.141612).lineTo(0.328125, 0.000000).lineTo(0.245230, 0.141612).lineTo(0.082895, 0.141612).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(0.165789, 0.000000).circle(0.069079)
solid1=wp_sketch1.add(loop4).add(loop5).extrude(-0.500000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, -0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.082895, -0.141612).lineTo(0.245230, -0.141612).lineTo(0.328125, 0.000000).lineTo(0.245230, 0.141612).lineTo(0.082895, 0.141612).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch2.moveTo(0.165789, 0.000000).circle(0.069079)
solid2=wp_sketch2.add(loop6).add(loop7).extrude(-0.109375)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
