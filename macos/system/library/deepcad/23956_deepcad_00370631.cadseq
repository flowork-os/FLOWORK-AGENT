import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, 0.000000, -0.648438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.234375, 0.000000).lineTo(1.234375, 0.168914).lineTo(0.896546, 0.168914).lineTo(0.896546, 0.454770).threePointArc((0.617188, 0.175411), (0.337829, 0.454770)).lineTo(0.337829, 0.168914).lineTo(0.000000, 0.168914).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.623684, 0.454770).circle(0.155921)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.445312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
