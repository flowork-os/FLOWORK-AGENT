# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00289013" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.570312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004625, -0.011165), (0.015789, -0.015789)).lineTo(1.484211, -0.015789).threePointArc((1.495375, -0.011165), (1.500000, 0.000000)).lineTo(1.500000, 1.136842).threePointArc((1.495375, 1.148007), (1.484211, 1.152632)).lineTo(0.015789, 1.152632).threePointArc((0.004625, 1.148007), (0.000000, 1.136842)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
