# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00354127" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.242188, 0.000000, 0.531250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.225000, 0.000000).circle(0.225000)
loop1=wp_sketch0.moveTo(0.225000, 0.000000).circle(0.126562)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.031579, -0.138158).lineTo(0.375000, 0.177632).lineTo(0.284211, 0.276316).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.055263, -0.063158).lineTo(0.276316, 0.138158).lineTo(0.240789, 0.173684).lineTo(0.043421, -0.007895).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.132812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
