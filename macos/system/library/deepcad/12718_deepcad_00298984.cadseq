# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00298984" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.687500, 0.000000).lineTo(0.687500, 0.687500).lineTo(0.000000, 0.687500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.347368, 0.151974).lineTo(0.506579, 0.246053).lineTo(0.506579, 0.441447).lineTo(0.347368, 0.535526).lineTo(0.180921, 0.441447).lineTo(0.180921, 0.246053).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.148438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
