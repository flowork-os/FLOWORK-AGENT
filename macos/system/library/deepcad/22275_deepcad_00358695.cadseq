import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.201480, 0.000000).lineTo(0.273438, 0.000000).lineTo(0.273438, -0.100740).lineTo(0.302220, -0.143914).lineTo(1.064967, -0.143914).lineTo(1.093750, -0.100740).lineTo(1.093750, 0.000000).lineTo(1.367188, 0.000000).lineTo(1.367188, 0.518092).threePointArc((1.316606, 0.640208), (1.194490, 0.690789)).lineTo(0.647615, 0.690789).lineTo(0.158306, 0.690789).lineTo(0.000000, 0.604441).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.201480, 0.201480).circle(0.100740)
loop2=wp_sketch0.moveTo(0.647615, 0.474918).circle(0.172697)
loop3=wp_sketch0.moveTo(1.237664, 0.100740).circle(0.028783)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.171875)
