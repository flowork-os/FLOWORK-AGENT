# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00254849" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.007442, -0.001576), (0.014885, 0.000000)).lineTo(0.669819, 0.000000).lineTo(1.324753, 0.000000).threePointArc((1.403362, 0.029770), (1.324753, 0.059539)).lineTo(0.669819, 0.059539).lineTo(0.014885, 0.059539).threePointArc((0.007442, 0.061115), (0.000000, 0.059539)).threePointArc((-0.078608, 0.029770), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.029770, 0.029770).circle(0.014885)
loop2=wp_sketch0.moveTo(1.369408, 0.029770).circle(0.014885)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
