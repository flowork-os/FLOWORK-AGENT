wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001156, -0.002791), (0.003947, -0.003947)).lineTo(0.058553, -0.003947).threePointArc((0.061344, -0.002791), (0.062500, 0.000000)).lineTo(0.062500, 0.053947).threePointArc((0.061480, 0.057068), (0.058553, 0.058553)).lineTo(0.003947, 0.058553).threePointArc((0.001020, 0.057068), (0.000000, 0.053947)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001701, -0.001475), (0.003947, -0.001316)).lineTo(0.058553, -0.001316).threePointArc((0.059483, -0.000930), (0.059868, 0.000000)).lineTo(0.059868, 0.053947).threePointArc((0.059483, 0.054878), (0.058553, 0.055263)).lineTo(0.003947, 0.055263).threePointArc((0.003017, 0.054878), (0.002632, 0.053947)).lineTo(0.002632, 0.000000).close()
