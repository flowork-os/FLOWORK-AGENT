# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00278031" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.303947, 0.000000).lineTo(0.303947, 0.687500).lineTo(0.000000, 0.687500).lineTo(0.043421, 0.231579).lineTo(0.094079, 0.159211).lineTo(0.043421, 0.086842).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.086842, 0.622368).circle(0.014474)
loop2=wp_sketch0.moveTo(0.238816, 0.622368).circle(0.014474)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.039062, 0.750000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.257812, 0.000000).lineTo(0.257812, 0.024424).lineTo(0.000000, 0.024424).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.656250)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
