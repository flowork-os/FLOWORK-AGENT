# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00243561" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.272780, -0.272780).lineTo(0.272780, -0.703947).lineTo(0.677549, -0.695148).lineTo(0.677549, -0.272780).lineTo(0.835938, 0.000000).lineTo(0.835938, 0.316776).lineTo(0.677549, 0.475164).lineTo(0.184786, 0.475164).lineTo(0.000000, 0.316776).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.219984, 0.255181).circle(0.140789)
loop2=wp_sketch0.moveTo(0.624753, 0.263980).circle(0.140789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
