# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00341695" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.460938, 0.000000).lineTo(0.460938, 0.092188).lineTo(0.000000, 0.092188).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.169819, 0.029112).lineTo(0.169819, 0.063076).lineTo(0.043668, 0.063076).lineTo(0.043668, 0.029112).close()
loop2=wp_sketch0.moveTo(0.417270, 0.029112).lineTo(0.417270, 0.063076).lineTo(0.286266, 0.063076).lineTo(0.286266, 0.029112).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.734375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
