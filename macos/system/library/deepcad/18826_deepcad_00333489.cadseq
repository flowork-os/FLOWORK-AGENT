# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00333489" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.063322, 0.000000).lineTo(0.063322, -0.037418).lineTo(0.210115, -0.037418).lineTo(0.210115, 0.000000).lineTo(0.273438, 0.000000).lineTo(0.273438, 0.063322).lineTo(0.000000, 0.063322).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.335938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.273438, 0.000000).lineTo(0.273438, 0.187089).lineTo(0.000000, 0.187089).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.138158, 0.074836).circle(0.048931)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.335938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.085938, 0.000000, 0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.051316, 0.000000).circle(0.051316)
solid2=wp_sketch2.add(loop3).extrude(0.335938)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.276316, 0.000000).lineTo(0.276316, -0.189474).lineTo(0.750000, -0.189474).lineTo(0.750000, -0.086842).lineTo(0.465789, 0.078947).lineTo(0.000000, 0.078947).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.234375)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.085938, -0.335938, 0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.051316, 0.000000).circle(0.051316)
solid4=wp_sketch4.add(loop5).extrude(-0.140625)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
