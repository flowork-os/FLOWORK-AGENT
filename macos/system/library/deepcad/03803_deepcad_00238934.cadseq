# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00238934" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.107566, 0.000000).threePointArc((1.141991, 0.014259), (1.156250, 0.048684)).lineTo(1.156250, 0.316447).threePointArc((1.109907, 0.428328), (0.998026, 0.474671)).lineTo(0.839803, 0.474671).threePointArc((0.805378, 0.460412), (0.791118, 0.425987)).lineTo(0.791118, 0.316447).lineTo(0.474671, 0.316447).threePointArc((0.440246, 0.330707), (0.425987, 0.365132)).lineTo(0.425987, 0.474671).threePointArc((0.379644, 0.586552), (0.267763, 0.632895)).lineTo(0.048684, 0.632895).threePointArc((0.014259, 0.618635), (0.000000, 0.584211)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.265625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, -0.632812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.681086, 0.000000).threePointArc((0.757437, 0.031626), (0.789062, 0.107977)).lineTo(0.789062, 0.631250).lineTo(0.000000, 0.315625).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.232566, 0.207648).circle(0.157812)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.265625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
