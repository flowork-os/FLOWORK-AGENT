# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00320241" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, -0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.281250, 0.000000).lineTo(0.281250, 0.281250).lineTo(0.000000, 0.281250).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.266447, 0.014803).lineTo(0.266447, 0.266447).lineTo(0.014803, 0.266447).lineTo(0.014803, 0.014803).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
