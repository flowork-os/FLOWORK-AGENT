import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.122368, 0.000000).circle(0.122368)
loop1=wp_sketch0.moveTo(0.122368, 0.000000).circle(0.061184)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.304688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.060937, 0.000000).lineTo(0.060937, 0.073766).lineTo(0.137911, 0.073766).lineTo(0.137911, 0.000000).lineTo(0.195641, 0.000000).lineTo(0.195641, 0.304688).lineTo(0.128289, 0.304688).lineTo(0.128289, 0.205263).lineTo(0.060937, 0.205263).lineTo(0.060937, 0.304688).lineTo(0.000000, 0.304688).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.304688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.144326, 0.000000).lineTo(0.144326, 0.035280).lineTo(0.032072, 0.035280).lineTo(0.032072, 0.304688).lineTo(0.000000, 0.304688).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.304688)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.134211, 0.000000).circle(0.131414)
loop5=wp_sketch3.moveTo(0.134211, 0.000000).circle(0.067105)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.304688)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
