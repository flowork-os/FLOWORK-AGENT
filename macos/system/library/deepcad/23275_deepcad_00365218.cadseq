# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00365218" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.355263, 0.000000).circle(0.355263)
solid0=wp_sketch0.add(loop0).extrude(0.625000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, 0.000000, -0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.084375, 0.000000).threePointArc((0.590625, -0.370667), (1.096875, 0.000000)).lineTo(1.181250, 0.000000).threePointArc((1.342969, 0.161719), (1.181250, 0.323437)).lineTo(1.096875, 0.323437).threePointArc((0.590625, 0.694105), (0.084375, 0.323437)).lineTo(0.000000, 0.323437).threePointArc((-0.161719, 0.161719), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.000000, 0.154688).circle(0.084375)
loop3=wp_sketch1.moveTo(1.181250, 0.154688).circle(0.084375)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.023438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
