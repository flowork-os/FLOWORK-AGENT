# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00260696" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.481579, 0.000000).lineTo(0.481579, 0.134211).lineTo(0.339474, 0.134211).lineTo(0.339474, 0.615789).lineTo(0.481579, 0.615789).lineTo(0.481579, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.615789).lineTo(0.165789, 0.615789).lineTo(0.165789, 0.134211).lineTo(0.000000, 0.134211).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.101562, -0.054688, 0.687500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.035526, 0.000000).circle(0.034786)
solid1=wp_sketch1.add(loop1).extrude(-0.054688)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
