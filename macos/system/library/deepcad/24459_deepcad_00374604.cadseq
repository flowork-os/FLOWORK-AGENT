import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.055496, -0.133978), (0.189474, -0.189474)).lineTo(1.310526, -0.189474).threePointArc((1.444504, -0.133978), (1.500000, 0.000000)).lineTo(1.500000, 0.378947).threePointArc((1.444504, 0.512925), (1.310526, 0.568421)).lineTo(0.189474, 0.568421).threePointArc((0.055496, 0.512925), (0.000000, 0.378947)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
