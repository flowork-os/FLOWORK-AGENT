import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.062829, -0.455510).lineTo(0.392681, -0.801069).lineTo(0.863898, -0.879605).lineTo(1.272286, -0.659704).lineTo(1.492188, -0.251316).lineTo(1.429359, 0.204194).lineTo(1.099507, 0.549753).lineTo(0.628289, 0.628289).lineTo(0.219901, 0.408388).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.476562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
