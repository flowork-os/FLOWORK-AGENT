wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001831, -0.004419), (0.006250, -0.006250)).lineTo(0.142187, -0.006250).threePointArc((0.146607, -0.004419), (0.148438, 0.000000)).lineTo(0.148438, 0.135938).threePointArc((0.146607, 0.140357), (0.142187, 0.142187)).lineTo(0.006250, 0.142187).threePointArc((0.001831, 0.140357), (0.000000, 0.135938)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.007355, -0.002131), (0.014063, 0.001563)).lineTo(0.134375, 0.001563).threePointArc((0.138794, 0.003393), (0.140625, 0.007812)).lineTo(0.140625, 0.129688).threePointArc((0.138471, 0.133326), (0.134375, 0.134375)).lineTo(0.014063, 0.134375).threePointArc((0.009967, 0.133326), (0.007812, 0.129688)).lineTo(0.007812, 0.007812).close()
