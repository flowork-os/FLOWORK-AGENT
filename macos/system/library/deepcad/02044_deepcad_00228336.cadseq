# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00228336" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.570312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.103618, -0.103618).lineTo(0.242763, -0.065132).lineTo(0.281250, 0.076974).lineTo(0.177632, 0.177632).lineTo(0.038487, 0.142105).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.142105, 0.038487).circle(0.074013)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.328125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
