# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00309142" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.115616, -0.279121), (0.394737, -0.394737)).lineTo(1.105263, -0.394737).threePointArc((1.384384, -0.279121), (1.500000, 0.000000)).lineTo(1.500000, 0.031579).threePointArc((1.384384, 0.310700), (1.105263, 0.426316)).lineTo(0.394737, 0.426316).threePointArc((0.115616, 0.310700), (0.000000, 0.031579)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.789062, -0.054688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.116772, -0.281912), (0.398684, -0.398684)).lineTo(1.179441, -0.398684).threePointArc((1.461353, -0.281912), (1.578125, 0.000000)).lineTo(1.578125, 0.116283).threePointArc((1.461353, 0.398195), (1.179441, 0.514967)).lineTo(0.398684, 0.514967).threePointArc((0.116772, 0.398195), (0.000000, 0.116283)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.187500)
solid=solid.intersect(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
