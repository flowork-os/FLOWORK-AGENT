# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.671875, 0.000000).lineTo(0.431414, 0.254605).lineTo(0.332401, 0.254605).threePointArc((0.180345, 0.102549), (0.028289, 0.254605)).lineTo(0.000000, 0.254605).lineTo(0.000000, 0.000000).close()
