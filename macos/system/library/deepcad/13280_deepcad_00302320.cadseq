# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.299342, 0.000000).lineTo(0.299342, -0.106908).lineTo(1.015625, -0.106908).lineTo(1.015625, 0.106908).lineTo(0.673520, 0.106908).lineTo(0.000000, 0.106908).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.507812)
