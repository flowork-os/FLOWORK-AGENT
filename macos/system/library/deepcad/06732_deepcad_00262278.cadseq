# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.695312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.017824, -0.043031), (0.060855, -0.060855)).lineTo(0.699836, -0.060855).threePointArc((0.735260, -0.039880), (0.745477, 0.000000)).lineTo(0.745477, 1.384457).threePointArc((0.735260, 1.424338), (0.699836, 1.445312)).lineTo(0.060855, 1.445312).threePointArc((0.017824, 1.427488), (0.000000, 1.384457)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
