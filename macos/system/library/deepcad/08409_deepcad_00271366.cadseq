import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.695312, 0.000000, 0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.016821, 0.013718), (0.031250, 0.029934)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.004687, 0.023438).threePointArc((0.002056, 0.011776), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.085938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.140518, -0.258009), (0.428207, -0.198437)).lineTo(0.939967, 0.292434).lineTo(0.971299, 0.313322).threePointArc((0.964888, 0.475889), (0.804194, 0.501316)).lineTo(0.522204, 0.365543).threePointArc((0.452018, 0.363617), (0.407319, 0.417763)).lineTo(0.365543, 0.595313).threePointArc((0.249830, 0.701596), (0.125329, 0.605757)).lineTo(0.000000, 0.020888).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.240214, -0.041776).circle(0.083553)
loop4=wp_sketch2.moveTo(0.240214, 0.584868).circle(0.062664)
loop5=wp_sketch2.moveTo(0.866859, 0.386431).circle(0.062664)
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.085938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
