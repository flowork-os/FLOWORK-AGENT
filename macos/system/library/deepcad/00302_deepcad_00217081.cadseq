# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00217081" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.007895, 0.000000).circle(0.007895)
solid0=wp_sketch0.add(loop0).extrude(-0.718750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.007812, -0.015625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.070312, 0.000000).lineTo(0.070312, 0.035526).lineTo(0.000000, 0.035526).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.011102, 0.017763).circle(0.008882)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.007812, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.679688, -0.015625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.070312, 0.000000).lineTo(0.070312, 0.035526).lineTo(0.000000, 0.035526).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.056250, 0.017763).circle(0.008882)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.007812, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
