# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00383777" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.523438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.268421, 0.000000).lineTo(0.426316, 0.000000).lineTo(1.073684, 0.000000).lineTo(1.231579, 0.000000).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.757895).threePointArc((1.408862, 0.962132), (1.200000, 1.042105)).lineTo(0.300000, 1.042105).threePointArc((0.091138, 0.962132), (0.000000, 0.757895)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.363158, 0.331579).circle(0.236842)
loop2=wp_sketch0.moveTo(1.136842, 0.331579).circle(0.236842)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.000000, -0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.148438, 0.000000).lineTo(0.148438, 0.089063).lineTo(0.000000, 0.089063).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.093750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.328125, 0.000000, -0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.148438, 0.000000).lineTo(0.148438, 0.089063).lineTo(0.000000, 0.089063).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.093750)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
