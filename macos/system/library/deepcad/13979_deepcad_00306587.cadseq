# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306587" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.426316).threePointArc((0.714638, 0.519582), (0.623684, 0.560526)).lineTo(0.126316, 0.560526).threePointArc((0.035362, 0.519582), (0.000000, 0.426316)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.568421, 0.150000).threePointArc((0.647368, 0.228947), (0.568421, 0.307895)).lineTo(0.181579, 0.307895).threePointArc((0.102632, 0.228947), (0.181579, 0.150000)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.132812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
