loop3=wp_sketch3.moveTo(0.968750, 0.000000).lineTo(0.968750, 0.030592).lineTo(0.000000, 0.030592).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.140625)
