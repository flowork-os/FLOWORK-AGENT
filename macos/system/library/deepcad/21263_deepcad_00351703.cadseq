wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.085938), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch4.moveTo(0.146053, 0.000000).circle(0.146053)
