wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.118384, -0.205021), (0.355099, -0.208882)).lineTo(0.939967, 0.261102).threePointArc((0.963283, 0.439565), (0.783306, 0.438651)).lineTo(0.584868, 0.250658).threePointArc((0.442873, 0.202008), (0.355099, 0.323766)).lineTo(0.365543, 0.595313).threePointArc((0.267681, 0.723749), (0.125329, 0.647533)).lineTo(0.000000, 0.000000).close()
