# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00225187" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.062500, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.098684, 0.000000).circle(0.098684)
loop1=wp_sketch0.moveTo(0.098684, 0.000000).circle(0.041118)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.117188, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.133706, -0.051846), (0.076974, -0.183553)).threePointArc((0.293529, -0.134665), (0.515132, -0.148026)).threePointArc((0.437454, -0.025756), (0.562500, 0.047368)).threePointArc((0.276840, 0.076049), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.554688, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.098684, 0.000000).circle(0.098684)
loop4=wp_sketch2.moveTo(0.098684, 0.000000).circle(0.041118)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.078125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.609375, -0.078125, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.043421, 0.000000).circle(0.042516)
solid3=wp_sketch3.add(loop5).extrude(-0.039062)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.578125, -0.078125, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch4.moveTo(0.071053, 0.000000).circle(0.071053)
loop7=wp_sketch4.moveTo(0.071053, 0.000000).circle(0.039967)
solid4=wp_sketch4.add(loop6).add(loop7).extrude(-0.039062)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
