# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.055263, 0.000000).lineTo(0.055263, 0.647368).threePointArc((0.069137, 0.680863), (0.102632, 0.694737)).lineTo(0.181579, 0.694737).lineTo(0.434211, 0.694737).lineTo(0.434211, 0.750000).lineTo(0.055263, 0.750000).lineTo(0.047368, 0.750000).threePointArc((0.013874, 0.736126), (0.000000, 0.702632)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.031579, 0.023684).circle(0.007895)
loop2=wp_sketch0.moveTo(0.031579, 0.150000).circle(0.007895)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
