wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, 0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.264530, -0.214391), (0.000000, -0.428783)).threePointArc((0.072503, -0.435930), (0.129934, -0.480757)).threePointArc((0.480757, -0.654656), (0.831579, -0.480757)).threePointArc((0.895507, -0.434046), (0.974507, -0.428783)).threePointArc((1.239037, -0.214391), (0.974507, 0.000000)).threePointArc((0.895507, 0.005263), (0.831579, 0.051974)).threePointArc((0.480757, 0.225873), (0.129934, 0.051974)).threePointArc((0.072503, 0.007147), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.038980, -0.220888).circle(0.090954)
loop2=wp_sketch0.moveTo(0.480757, -0.220888).circle(0.311842)
