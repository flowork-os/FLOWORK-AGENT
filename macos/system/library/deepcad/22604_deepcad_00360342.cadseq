wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.165789, 0.000000).lineTo(0.165789, -0.047368).lineTo(0.292105, -0.047368).lineTo(0.418421, -0.047368).lineTo(0.418421, 0.000000).lineTo(0.584211, 0.000000).lineTo(0.457895, 0.615789).threePointArc((0.292105, 0.750155), (0.126316, 0.615789)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.292105, 0.584211).circle(0.110526)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0

