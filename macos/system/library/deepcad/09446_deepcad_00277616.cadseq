# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00277616" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.156250, 0.000000).lineTo(0.156250, 0.023026).lineTo(0.000000, 0.023026).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.156250, 0.000000).lineTo(0.156250, 0.156250).lineTo(0.000000, 0.156250).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.021382, 0.021382).circle(0.004934)
loop3=wp_sketch1.moveTo(0.021382, 0.134868).circle(0.004934)
loop4=wp_sketch1.moveTo(0.078947, 0.078947).circle(0.044408)
loop5=wp_sketch1.moveTo(0.134868, 0.021382).circle(0.004934)
loop6=wp_sketch1.moveTo(0.134868, 0.134868).circle(0.004934)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).extrude(0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, -0.015625, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch2.moveTo(0.156250, 0.000000).lineTo(0.156250, 0.023026).lineTo(0.000000, 0.023026).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop7).extrude(0.148438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
