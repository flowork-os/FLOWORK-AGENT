# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.209905, -0.435704), (0.336513, -0.902467)).threePointArc((0.580936, -0.992148), (0.841283, -0.994243)).threePointArc((1.113320, -0.598902), (1.453125, -0.260033)).threePointArc((1.411463, -0.000698), (1.284868, 0.229441)).threePointArc((0.802926, 0.269803), (0.336513, 0.397697)).threePointArc((0.133753, 0.228044), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
