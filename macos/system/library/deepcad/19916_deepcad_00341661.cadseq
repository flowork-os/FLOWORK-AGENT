import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.035526, 0.000000).lineTo(0.035526, 0.022204).lineTo(0.059211, 0.022204).threePointArc((0.101079, 0.123283), (0.000000, 0.081414)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.034046, 0.001480).lineTo(0.034046, 0.023684).lineTo(0.059211, 0.023684).threePointArc((0.100032, 0.122236), (0.001480, 0.081414)).lineTo(0.001480, 0.001480).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
