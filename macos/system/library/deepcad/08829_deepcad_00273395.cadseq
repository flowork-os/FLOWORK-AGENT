# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, 0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.308510, -0.404119), (0.195395, -0.336513)).threePointArc((0.347368, -0.252868), (0.499342, -0.336513)).threePointArc((0.997819, -0.391015), (0.683882, 0.000000)).threePointArc((0.536199, 0.088440), (0.531908, 0.260526)).threePointArc((0.341941, 0.719147), (0.151974, 0.260526)).threePointArc((0.147683, 0.088440), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.075987, -0.260526).circle(0.173684)
loop2=wp_sketch0.moveTo(0.347368, -0.021711).circle(0.173684)
loop3=wp_sketch0.moveTo(0.347368, 0.455921).circle(0.173684)
loop4=wp_sketch0.moveTo(0.759868, -0.260526).circle(0.173684)
