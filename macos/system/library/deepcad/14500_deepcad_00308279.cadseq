# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00308279" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, 0.000000, -0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.920477, 0.000000).lineTo(0.920477, 0.212418).lineTo(0.677714, 0.212418).lineTo(0.677714, 0.809211).lineTo(0.839556, 0.809211).lineTo(0.839556, 0.960938).lineTo(0.010115, 0.960938).lineTo(0.010115, 0.799095).lineTo(0.202303, 0.799095).lineTo(0.202303, 0.182072).lineTo(0.000000, 0.182072).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.578125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
