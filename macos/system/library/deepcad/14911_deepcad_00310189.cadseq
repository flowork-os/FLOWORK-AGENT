# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00310189" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.523438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.055099, 0.000000).lineTo(0.055099, 0.473849).lineTo(0.523438, 0.473849).lineTo(0.523438, 0.523438).lineTo(0.000000, 0.523438).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.054688, 0.000000, -0.054688), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.054687, 0.000000).lineTo(0.054687, 0.054687).lineTo(0.000000, 0.054687).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.687500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.140625, 0.000000, -0.070312), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((-0.002245, -0.016347), (0.007237, -0.029852)).lineTo(0.085938, -0.081414).lineTo(0.085938, 0.015378).lineTo(0.009046, 0.015378).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.019901, -0.010855).circle(0.010855)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(-0.007812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.046875, 0.687500, -0.054688), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch3.moveTo(0.006826, 0.000000).lineTo(0.006826, 0.648438).lineTo(0.000000, 0.648438).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.101562)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
