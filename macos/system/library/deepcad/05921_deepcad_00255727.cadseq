# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00255727" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.625000, 0.000000).lineTo(0.625000, 0.105263).lineTo(0.105263, 0.105263).lineTo(0.105263, 0.500000).lineTo(0.000000, 0.500000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.106579, 0.000000).lineTo(0.106579, -0.390789).lineTo(0.627632, -0.390789).lineTo(0.627632, -0.497368).lineTo(0.935526, -0.497368).lineTo(1.125000, -0.497368).lineTo(1.125000, -0.130263).lineTo(0.307895, 0.094737).lineTo(0.000000, 0.094737).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.935526, -0.307895).circle(0.082895)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.625000, 0.000000).lineTo(0.625000, 0.105263).lineTo(0.105263, 0.105263).lineTo(0.105263, 0.500000).lineTo(0.000000, 0.500000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.437500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
