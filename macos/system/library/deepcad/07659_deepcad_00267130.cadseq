# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267130" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.236842, -0.300000).circle(0.078947)
loop2=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.300000)
loop3=wp_sketch0.moveTo(0.757895, 0.600000).circle(0.078947)
loop4=wp_sketch0.moveTo(1.263158, -0.300000).circle(0.078947)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.303947, 0.000000).circle(0.303947)
loop6=wp_sketch1.moveTo(0.303947, 0.000000).circle(0.189967)
solid1=wp_sketch1.add(loop5).add(loop6).extrude(0.148438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch2.moveTo(0.303947, 0.000000).circle(0.303947)
loop8=wp_sketch2.moveTo(0.303947, 0.000000).circle(0.189967)
solid2=wp_sketch2.add(loop7).add(loop8).extrude(-0.601562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
