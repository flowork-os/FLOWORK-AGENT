# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387197" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).lineTo(0.757895, 0.047368).lineTo(0.757895, 0.935526).lineTo(0.568421, 1.125000).lineTo(0.201316, 1.125000).lineTo(0.000000, 0.935526).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.331579, 0.746053).circle(0.130263)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.476562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
