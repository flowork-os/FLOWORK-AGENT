# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00361102" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.453125, -0.445312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.113240, 0.000000).lineTo(0.113240, 1.195312).threePointArc((0.033167, 1.162145), (0.000000, 1.082072)).lineTo(0.000000, 1.031743).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
