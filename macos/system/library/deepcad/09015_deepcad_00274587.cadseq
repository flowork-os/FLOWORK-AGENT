# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00274587" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.648438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.094984, 0.000000).lineTo(0.094984, 0.094984).lineTo(0.094984, 1.289062).lineTo(0.000000, 1.289062).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.554688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.046875, -0.648438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.703125, 0.000000).lineTo(0.703125, 0.088816).lineTo(0.000000, 0.088816).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.554688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.046875, -0.476562, 0.273438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.059211, 0.000000).circle(0.057977)
solid2=wp_sketch2.add(loop2).extrude(-0.468750)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.046875, -0.015625, 0.273438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.059211, 0.000000).circle(0.059211)
solid3=wp_sketch3.add(loop3).extrude(-0.468750)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.046875, 0.453125, 0.273438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.059211, 0.000000).circle(0.057977)
solid4=wp_sketch4.add(loop4).extrude(-0.468750)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
