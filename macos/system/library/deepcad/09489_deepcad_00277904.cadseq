# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00277904" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.609375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.032072, -0.179605).lineTo(0.032072, -0.609375).lineTo(0.102632, -0.609375).lineTo(0.102632, -0.500329).lineTo(0.230921, -0.500329).lineTo(0.230921, -0.609375).lineTo(0.307895, -0.609375).lineTo(0.307895, 0.141118).lineTo(0.243750, 0.141118).lineTo(0.243750, 0.032072).lineTo(0.064145, 0.032072).lineTo(0.064145, 0.141118).lineTo(0.000000, 0.141118).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
