# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00386587" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.062500, -0.011842).threePointArc((0.031797, -0.003037), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.031797, 0.003037), (0.062500, 0.011842)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.063158, 0.015789).lineTo(0.702632, 0.134211).threePointArc((0.746053, 0.177632), (0.702632, 0.221053)).lineTo(0.063158, 0.339474).lineTo(0.000000, 0.355263).threePointArc((-0.177632, 0.177632), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.046875)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.726562, 0.000000, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.023684, 0.000000).circle(0.023191)
solid3=wp_sketch3.add(loop3).extrude(0.039062)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
