wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.124395, -0.256868), (0.407319, -0.219326)).lineTo(0.960855, 0.250658).threePointArc((0.957222, 0.405342), (0.804194, 0.428207)).lineTo(0.490872, 0.240214).threePointArc((0.398785, 0.237857), (0.365543, 0.323766)).lineTo(0.365543, 0.563980).threePointArc((0.259288, 0.685850), (0.125329, 0.595313)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.240214, -0.041776).circle(0.083553)
loop2=wp_sketch0.moveTo(0.240214, 0.563980).circle(0.062664)
loop3=wp_sketch0.moveTo(0.866859, 0.323766).circle(0.062664)
