import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.225000, -0.379688).lineTo(0.042188, -0.787500).lineTo(0.450000, -0.759375).lineTo(0.675000, -1.110938).lineTo(0.885938, -0.717187).lineTo(1.335938, -0.675000).lineTo(1.096875, -0.337500).lineTo(1.293750, 0.028125).lineTo(0.843750, 0.014063).lineTo(0.590625, 0.379688).lineTo(0.421875, 0.014063).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.437500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
