# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00223579" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.648438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.030181, -0.072862), (0.103043, -0.103043)).lineTo(1.148191, -0.103043).threePointArc((1.221053, -0.072862), (1.251234, 0.000000)).lineTo(1.251234, 1.295395).threePointArc((1.221053, 1.368257), (1.148191, 1.398438)).lineTo(0.103043, 1.398438).threePointArc((0.030181, 1.368257), (0.000000, 1.295395)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, -0.523438, 0.046875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.793421, 0.000000).lineTo(0.793421, 1.046875).lineTo(0.000000, 1.046875).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.749342, 0.055099).lineTo(0.749342, 0.991776).lineTo(0.055099, 0.991776).lineTo(0.055099, 0.055099).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.148438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
