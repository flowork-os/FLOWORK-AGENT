# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00235626" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.226562, 0.000000).lineTo(1.226562, 0.296957).lineTo(0.000000, 0.296957).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.206579, 0.154934).circle(0.038734)
loop2=wp_sketch0.moveTo(1.019984, 0.154934).circle(0.038734)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
