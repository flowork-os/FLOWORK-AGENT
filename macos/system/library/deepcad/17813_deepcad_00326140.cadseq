# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00326140" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.082895, 0.000000).circle(0.082895)
solid0=wp_sketch0.add(loop0).extrude(0.296875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.097551, -0.235508), (0.333059, -0.333059)).lineTo(0.585938, -0.333059).lineTo(0.585938, 0.000000).lineTo(0.462582, 0.000000).threePointArc((0.372273, 0.034853), (0.333059, 0.123355)).lineTo(0.333059, 0.419408).lineTo(0.000000, 0.419408).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.086349, 0.277549).circle(0.043174)
loop3=wp_sketch1.moveTo(0.277549, -0.024671).circle(0.086349)
loop4=wp_sketch1.moveTo(0.444079, -0.234375).circle(0.030839)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
