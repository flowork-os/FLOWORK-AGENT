solid1=wp_sketch1.add(loop1).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.000000, -0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.068421, 0.017105).threePointArc((-0.253212, 0.196711), (0.068421, 0.376316)).lineTo(0.000000, 0.389145).threePointArc((-0.240076, 0.194572), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.046875)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.656250, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.039145, 0.008388).threePointArc((0.083900, 0.063610), (0.039145, 0.118832)).lineTo(0.000000, 0.127220).threePointArc((0.096476, 0.063610), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(0.046875)
