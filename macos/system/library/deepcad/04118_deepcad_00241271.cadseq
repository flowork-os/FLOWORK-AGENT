# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.046875, 0.000000, 0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.032953, -0.016590), (0.068257, -0.027303)).lineTo(0.607484, -0.143339).threePointArc((0.627961, -0.140173), (0.648438, -0.143339)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0
# workplane for sketch 1
