# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00223805" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.078947).lineTo(0.000000, 0.078947).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.375000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, 0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.640625, 0.000000).lineTo(0.640625, 0.424836).lineTo(0.424836, 0.424836).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.039062, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.000000, 0.500000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.477632, 0.000000).circle(0.477632)
loop3=wp_sketch2.moveTo(0.228865, -0.039803).lineTo(0.228865, 0.039803).lineTo(0.009951, 0.039803).lineTo(0.009951, -0.039803).close()
solid2=wp_sketch2.add(loop2).add(loop3).extrude(-0.500000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, -0.039062, 0.500000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.218750, 0.000000).lineTo(0.218750, 0.075987).lineTo(0.000000, 0.075987).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(-0.500000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
