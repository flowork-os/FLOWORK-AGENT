# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00329241" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.296875, 0.000000).lineTo(0.296875, 0.296875).lineTo(0.000000, 0.296875).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.150000, 0.150000).circle(0.050000)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.203125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.300493, 0.000000).threePointArc((0.450740, 0.150247), (0.300493, 0.300493)).lineTo(0.000000, 0.300493).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.081086, 0.081086).circle(0.023849)
loop4=wp_sketch1.moveTo(0.081086, 0.214638).circle(0.023849)
loop5=wp_sketch1.moveTo(0.248026, 0.081086).circle(0.023849)
loop6=wp_sketch1.moveTo(0.248026, 0.214638).circle(0.023849)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).extrude(0.203125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
