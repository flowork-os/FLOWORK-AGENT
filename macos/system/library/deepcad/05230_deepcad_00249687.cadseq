# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00249687" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.671053, 0.000000).threePointArc((0.750000, 0.078947), (0.671053, 0.157895)).lineTo(0.000000, 0.157895).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.671053, 0.078947).circle(0.007895)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.078125, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch1.moveTo(0.003947, 0.000000).circle(0.003947)
solid1=wp_sketch1.add(loop2).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.078125, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch2.moveTo(0.007812, 0.000000).lineTo(0.007812, 0.003947).threePointArc((0.003906, 0.007854), (0.000000, 0.003947)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.023438)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
