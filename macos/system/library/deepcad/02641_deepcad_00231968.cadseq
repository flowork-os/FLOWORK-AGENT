import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.703125, 0.515625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.030527, -0.216707), (0.153783, -0.334704)).lineTo(0.759868, -0.334704).threePointArc((0.840048, -0.295288), (0.859375, -0.208059)).threePointArc((0.493789, 0.160736), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(-0.507812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
