# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00327811" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.177632, 0.000000).circle(0.177632)
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.179688, -0.179688), (0.359375, 0.000000)).lineTo(0.359375, 0.562500).threePointArc((0.179688, 0.742188), (0.000000, 0.562500)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.179688, 0.000000).circle(0.179688)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.140625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.179688, 0.000000, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.179688, -0.179688), (0.359375, 0.000000)).lineTo(0.359375, 0.562500).threePointArc((0.179688, 0.742188), (0.000000, 0.562500)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.179688, 0.000000).circle(0.179688)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.140625)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, -0.750000, 0.554688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.102632, 0.000000).circle(0.100493)
solid3=wp_sketch3.add(loop5).extrude(-1.000000)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.098684, 0.000000).circle(0.098684)
solid4=wp_sketch4.add(loop6).extrude(-1.000000)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
