import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, -0.554688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.304688, 0.000000).lineTo(1.304688, 1.304688).lineTo(0.000000, 1.304688).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.604276, 0.824013).lineTo(0.604276, 1.030016).lineTo(0.370806, 1.030016).lineTo(0.370806, 0.824013).close()
loop2=wp_sketch0.moveTo(0.604276, 0.178536).lineTo(0.604276, 0.329605).lineTo(0.810280, 0.329605).lineTo(0.810280, 0.178536).lineTo(1.043750, 0.178536).lineTo(1.043750, 0.549342).lineTo(0.810280, 0.549342).lineTo(0.810280, 0.686678).lineTo(0.604276, 0.686678).lineTo(0.604276, 0.549342).lineTo(0.384539, 0.549342).lineTo(0.384539, 0.178536).close()
loop3=wp_sketch0.moveTo(1.126151, 0.824013).lineTo(1.126151, 1.030016).lineTo(0.906414, 1.030016).lineTo(0.906414, 0.824013).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.328125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
