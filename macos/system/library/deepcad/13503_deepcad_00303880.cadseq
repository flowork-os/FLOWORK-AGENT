# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00303880" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.312500, 0.015625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.437500, 0.000000).lineTo(0.437500, 0.165789).lineTo(0.000000, 0.165789).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.193421, 0.055263).lineTo(0.193421, 0.110526).lineTo(0.055263, 0.110526).lineTo(0.055263, 0.055263).close()
loop2=wp_sketch0.moveTo(0.382237, 0.055263).lineTo(0.382237, 0.110526).lineTo(0.244079, 0.110526).lineTo(0.244079, 0.055263).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
