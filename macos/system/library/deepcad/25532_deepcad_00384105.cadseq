loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.095076, -0.039382), (0.134457, -0.134457)).lineTo(0.134457, -0.743997).threePointArc((0.242023, -0.851562), (0.349589, -0.743997)).lineTo(0.349589, -0.268914).threePointArc((0.362940, -0.223545), (0.394408, -0.188240)).threePointArc((0.345836, 0.217299), (0.000000, 0.000000)).close()
