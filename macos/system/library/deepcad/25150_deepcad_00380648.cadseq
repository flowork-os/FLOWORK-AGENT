import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.000000, -0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.043934, -0.106066), (0.150000, -0.150000)).lineTo(0.600000, -0.150000).threePointArc((0.706066, -0.106066), (0.750000, 0.000000)).lineTo(0.750000, 0.450000).threePointArc((0.706066, 0.556066), (0.600000, 0.600000)).lineTo(0.150000, 0.600000).threePointArc((0.043934, 0.556066), (0.000000, 0.450000)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
