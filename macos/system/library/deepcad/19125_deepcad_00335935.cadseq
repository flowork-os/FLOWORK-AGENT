# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00335935" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.117188, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.559539, 0.000000).threePointArc((0.630591, 0.316406), (0.559539, 0.632812)).lineTo(0.000000, 0.632812).lineTo(0.000000, 0.526234).threePointArc((0.125766, 0.316406), (0.000000, 0.106579)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.416324, -0.123232), (0.539556, 0.293092)).lineTo(0.539556, 0.339720).threePointArc((0.436308, 0.442969), (0.333059, 0.339720)).lineTo(0.333059, 0.293092).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
