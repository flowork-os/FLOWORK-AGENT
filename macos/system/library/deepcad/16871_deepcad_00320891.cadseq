import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, -0.679688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.177303, 0.000000).lineTo(0.595230, 0.911842).lineTo(1.025822, 0.000000).lineTo(1.203125, 0.000000).lineTo(1.203125, 0.481250).lineTo(0.886513, 0.430592).lineTo(0.975164, 1.025822).lineTo(0.227961, 1.025822).lineTo(0.316612, 0.430592).lineTo(0.000000, 0.481250).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, -0.046875, -0.687500), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.062500, 0.000000).lineTo(0.062500, 0.062500).lineTo(0.000000, 0.062500).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.507812, -0.046875, -0.679688), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch2.moveTo(0.062500, 0.000000).lineTo(0.062500, 0.062500).lineTo(0.000000, 0.062500).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.062500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
