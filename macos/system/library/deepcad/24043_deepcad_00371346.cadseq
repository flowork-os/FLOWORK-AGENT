# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00371346" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, -0.453125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.378289, 0.000000).lineTo(0.378289, 0.898438).lineTo(0.000000, 0.898438).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.523438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, 0.000000, 0.453125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.298109, 0.000000).lineTo(0.678454, 0.000000).lineTo(0.976563, 0.000000).lineTo(0.976563, 0.298109).lineTo(0.000000, 0.298109).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.143914, 0.164474).circle(0.071957)
loop3=wp_sketch1.moveTo(0.842928, 0.164474).circle(0.071957)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.523438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, 0.000000, 0.453125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.298109, 0.000000).lineTo(0.678454, 0.000000).lineTo(0.976563, 0.000000).lineTo(0.976563, 0.298109).lineTo(0.000000, 0.298109).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.143914, 0.164474).circle(0.071957)
loop6=wp_sketch2.moveTo(0.842928, 0.164474).circle(0.071957)
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).extrude(0.523438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
