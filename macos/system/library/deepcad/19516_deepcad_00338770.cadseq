# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00338770" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.041622, -0.100484), (0.142105, -0.142105)).lineTo(1.357895, -0.142105).threePointArc((1.458378, -0.100484), (1.500000, 0.000000)).lineTo(1.500000, 0.347368).lineTo(1.500000, 0.678947).threePointArc((1.458378, 0.779431), (1.357895, 0.821053)).lineTo(0.142105, 0.821053).threePointArc((0.041622, 0.779431), (0.000000, 0.678947)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.568421, 0.347368).circle(0.394737)
loop2=wp_sketch0.moveTo(1.105263, 0.331579).threePointArc((1.288956, 0.339474), (1.105263, 0.347368)).lineTo(1.089474, 0.347368).lineTo(1.089474, 0.331579).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, 0.031250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.394737, 0.000000).circle(0.394737)
solid1=wp_sketch1.add(loop3).extrude(0.085938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, 0.125000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.394737, 0.000000).circle(0.394737)
solid2=wp_sketch2.add(loop4).extrude(-0.085938)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
