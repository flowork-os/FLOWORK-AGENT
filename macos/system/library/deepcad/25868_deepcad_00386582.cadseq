# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00386582" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.647862, -0.058141).threePointArc((0.788167, 0.070600), (0.647862, 0.199342)).lineTo(0.000000, 0.141201).threePointArc((-0.080837, 0.070600), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.656168, -0.024918).threePointArc((0.760265, 0.070600), (0.656168, 0.166118)).lineTo(0.000000, 0.107977).threePointArc((-0.050604, 0.066447), (0.000000, 0.024918)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
