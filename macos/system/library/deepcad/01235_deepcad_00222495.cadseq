# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00222495" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.177632, 0.000000).circle(0.177632)
solid0=wp_sketch0.add(loop0).extrude(-0.367188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.296875, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.071464, 0.000000).lineTo(0.071464, 0.617188).lineTo(0.000000, 0.617188).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.179688)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.296875, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.071464, 0.000000).lineTo(0.071464, 0.617188).lineTo(0.000000, 0.617188).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.179688)
solid_temp=solid_temp.union(solid1)
solid=solid.union(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
