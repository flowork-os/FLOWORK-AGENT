# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00300964" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.276316, 0.000000).lineTo(0.276316, 0.468750).threePointArc((0.138158, 0.330592), (0.000000, 0.468750)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.138158, 0.305921).circle(0.093750)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.328125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.020233, -0.048846), (0.069079, -0.069079)).lineTo(1.174342, -0.069079).threePointArc((1.312500, 0.069079), (1.174342, 0.207237)).lineTo(0.276316, 0.207237).lineTo(0.000000, 0.207237).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.151974, 0.082895).circle(0.096711)
loop4=wp_sketch1.moveTo(0.566447, 0.082895).circle(0.096711)
loop5=wp_sketch1.moveTo(0.967105, 0.069079).circle(0.096711)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.328125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
