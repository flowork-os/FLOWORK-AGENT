# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00339226" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.130263, 0.000000).circle(0.130263)
loop1=wp_sketch0.moveTo(0.130263, 0.000000).circle(0.048849)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.257812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.130263, 0.000000).circle(0.130263)
loop3=wp_sketch1.moveTo(0.130263, 0.000000).circle(0.048849)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.257812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.398438, 0.000000).threePointArc((0.382268, 0.062911), (0.398438, 0.125822)).lineTo(0.000000, 0.125822).threePointArc((0.016169, 0.062911), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop4).extrude(0.257812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
