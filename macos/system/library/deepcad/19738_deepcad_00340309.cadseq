import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.119079, 0.000000).threePointArc((1.305592, 0.186513), (1.119079, 0.373026)).lineTo(0.000000, 0.373026).threePointArc((-0.186513, 0.186513), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.884211, 0.082895).threePointArc((0.987829, 0.186513), (0.884211, 0.290132)).lineTo(0.248684, 0.290132).threePointArc((0.145066, 0.186513), (0.248684, 0.082895)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.148438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
