wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.656250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.026014, -0.062802), (0.088816, -0.088816)).lineTo(0.473684, -0.088816).threePointArc((0.536486, -0.062802), (0.562500, 0.000000)).lineTo(0.562500, 1.317434).threePointArc((0.536486, 1.380236), (0.473684, 1.406250)).lineTo(0.088816, 1.406250).threePointArc((0.026014, 1.380236), (0.000000, 1.317434)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
