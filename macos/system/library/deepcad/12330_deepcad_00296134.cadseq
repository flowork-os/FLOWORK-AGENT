# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.734375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004576, -0.011049), (0.015625, -0.015625)).lineTo(1.328125, -0.015625).threePointArc((1.339174, -0.011049), (1.343750, 0.000000)).lineTo(1.343750, 1.468750).threePointArc((1.339174, 1.479799), (1.328125, 1.484375)).lineTo(0.015625, 1.484375).threePointArc((0.004576, 1.479799), (0.000000, 1.468750)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
