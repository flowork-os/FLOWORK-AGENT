# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382473" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.240378, 0.000000).lineTo(0.240378, 0.617188).lineTo(0.000000, 0.617188).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.281250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.242188, 0.000000).lineTo(0.242188, 0.119819).lineTo(0.000000, 0.119819).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.281250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.265625, 0.000000, -0.523438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.439638, 0.000000).lineTo(0.439638, 0.526234).lineTo(0.373026, 0.632812).lineTo(0.059951, 0.632812).lineTo(0.000000, 0.526234).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.206497, 0.466283).circle(0.073273)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.281250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
