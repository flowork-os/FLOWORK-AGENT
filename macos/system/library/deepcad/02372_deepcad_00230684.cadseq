solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.046246, -0.111648), (0.157895, -0.157895)).lineTo(0.394737, -0.157895).lineTo(1.073684, -0.157895).lineTo(1.357895, -0.157895).threePointArc((1.455108, -0.124168), (1.500000, -0.031579)).lineTo(1.500000, 0.489474).threePointArc((1.453754, 0.601122), (1.342105, 0.647368)).lineTo(0.173684, 0.647368).threePointArc((0.054141, 0.604392), (0.000000, 0.489474)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.042183, -0.054470), (0.110526, -0.063158)).lineTo(1.357895, -0.063158).threePointArc((1.399284, -0.052554), (1.421053, -0.015789)).lineTo(1.421053, 0.489474).threePointArc((1.394659, 0.537403), (1.342105, 0.552632)).lineTo(0.110526, 0.552632).threePointArc((0.088197, 0.543382), (0.078947, 0.521053)).lineTo(0.078947, -0.031579).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.367188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(1.328125, 0.000000).lineTo(1.328125, 0.615132).lineTo(0.000000, 0.615132).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.304688)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
