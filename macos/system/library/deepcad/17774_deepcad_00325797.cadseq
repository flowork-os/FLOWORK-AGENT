# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00325797" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.726316)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.578125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.603947, 0.000000).circle(0.603947)
loop3=wp_sketch1.moveTo(0.603947, 0.000000).circle(0.578783)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.578125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.450000, 0.000000).circle(0.450000)
loop5=wp_sketch2.moveTo(0.450000, 0.000000).circle(0.431250)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.578125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.300000, 0.000000).circle(0.300000)
loop7=wp_sketch3.moveTo(0.300000, 0.000000).circle(0.287500)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.578125)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch4.moveTo(0.150000, 0.000000).circle(0.150000)
loop9=wp_sketch4.moveTo(0.150000, 0.000000).circle(0.143750)
solid4=wp_sketch4.add(loop8).add(loop9).extrude(0.578125)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
