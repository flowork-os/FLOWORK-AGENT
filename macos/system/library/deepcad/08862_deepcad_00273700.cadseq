# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.234375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.064512, -0.042436), (0.082895, -0.117434)).threePointArc((0.232543, -0.128993), (0.331579, -0.241776)).threePointArc((0.427161, -0.130399), (0.573355, -0.117434)).threePointArc((0.591738, -0.042436), (0.656250, 0.000000)).lineTo(0.428289, 0.000000).threePointArc((0.399726, -0.042611), (0.352303, -0.062171)).lineTo(0.352303, -0.020724).lineTo(0.345395, -0.041447).lineTo(0.331579, -0.041447).lineTo(0.310855, -0.041447).lineTo(0.303947, -0.020724).lineTo(0.303947, -0.062171).threePointArc((0.256524, -0.042611), (0.227961, 0.000000)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.093750, 0.117188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.426316, 0.000000).circle(0.426316)
loop2=wp_sketch1.moveTo(0.426316, 0.000000).circle(0.408553)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
