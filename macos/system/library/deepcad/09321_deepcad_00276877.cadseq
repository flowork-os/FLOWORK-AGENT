# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00276877" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.546875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.070312, 0.000000).lineTo(0.070312, 0.025905).lineTo(0.055510, 0.051069).lineTo(0.000000, 0.051069).lineTo(0.000000, 0.031826).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.012582, 0.031826).circle(0.006661)
loop2=wp_sketch0.moveTo(0.038487, 0.019243).circle(0.012582)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.304688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
