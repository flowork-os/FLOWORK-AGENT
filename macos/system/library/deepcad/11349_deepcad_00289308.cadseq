# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00289308" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.000000, -0.523438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.273438, 0.000000).lineTo(1.273438, 1.273438).lineTo(0.000000, 1.273438).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.589803, 0.080428).lineTo(0.683635, 0.080428).lineTo(1.193010, 0.080428).lineTo(1.193010, 1.193010).lineTo(0.683635, 1.193010).lineTo(0.589803, 1.193010).lineTo(0.080428, 1.193010).lineTo(0.080428, 0.080428).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, -0.437500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.092763, 0.000000).lineTo(0.092763, 1.101562).lineTo(0.000000, 1.101562).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.054688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
