# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00251960" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.476562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.476562, 0.000000).lineTo(0.476562, 0.416365).lineTo(0.000000, 0.416365).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.476562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, -0.476562, 0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.189474, 0.000000).circle(0.189474)
loop2=wp_sketch1.moveTo(0.189474, 0.000000).circle(0.094737)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.273438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.398438, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.312500).lineTo(0.000000, 0.312500).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.476562)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.398438, 0.085938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.312500).lineTo(0.000000, 0.312500).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(-0.523438)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.320312, -0.062500, 0.242188), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.189474, 0.000000).circle(0.189474)
loop6=wp_sketch4.moveTo(0.189474, 0.000000).circle(0.094737)
solid4=wp_sketch4.add(loop5).add(loop6).extrude(0.273438)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
