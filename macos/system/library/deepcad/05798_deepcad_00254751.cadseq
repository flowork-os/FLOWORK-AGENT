import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, -0.671875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.023557, -0.056871), (0.080428, -0.080428)).lineTo(1.193010, -0.080428).threePointArc((1.249881, -0.056871), (1.273438, 0.000000)).lineTo(1.273438, 1.112582).threePointArc((1.249881, 1.169453), (1.193010, 1.193010)).lineTo(0.080428, 1.193010).threePointArc((0.023557, 1.169453), (0.000000, 1.112582)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.080428, 0.000000).circle(0.026809)
loop2=wp_sketch0.moveTo(0.080428, 1.112582).circle(0.026809)
loop3=wp_sketch0.moveTo(1.193010, 0.000000).circle(0.026809)
loop4=wp_sketch0.moveTo(1.193010, 1.112582).circle(0.026809)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.265625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
