# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00260596" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.523355, 0.000000).lineTo(0.523355, 0.671875).threePointArc((0.141477, 0.429567), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.150935, -0.405779), (0.519572, -0.632812)).lineTo(0.519572, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.195312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.640625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.605996, 0.652344), (0.000000, 1.304688)).lineTo(0.000000, 0.645477).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.195312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.757895, 0.000000).circle(0.757895)
loop4=wp_sketch3.moveTo(0.663158, 0.000000).lineTo(0.663158, 0.663158).threePointArc((0.145040, 0.015789), (0.663158, -0.631579)).close()
loop5=wp_sketch3.moveTo(0.663158, -0.631579).threePointArc((1.311901, -0.028214), (0.757895, 0.663158)).lineTo(0.757895, 0.000000).lineTo(0.757895, -0.631579).close()
solid3=wp_sketch3.add(loop3).add(loop4).add(loop5).extrude(0.718750)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
