# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00378304" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, -0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.640625, 0.000000).lineTo(0.640625, 0.478783).lineTo(0.000000, 0.478783).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.566447, 0.074178).lineTo(0.566447, 0.411349).lineTo(0.074178, 0.411349).lineTo(0.074178, 0.074178).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.312500, -0.242188, 0.015625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.010197, 0.000000).lineTo(0.010197, 0.484375).lineTo(0.000000, 0.484375).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.281250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, -0.242188, 0.015625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.010197, 0.000000).lineTo(0.010197, 0.484375).lineTo(0.000000, 0.484375).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.281250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
