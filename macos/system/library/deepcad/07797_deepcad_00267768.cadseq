loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001590, -0.003838), (0.005428, -0.005428)).lineTo(0.080510, -0.005428).threePointArc((0.084348, -0.003838), (0.085938, 0.000000)).lineTo(0.085938, 0.074178).threePointArc((0.084535, 0.078468), (0.080510, 0.080510)).lineTo(0.005428, 0.080510).threePointArc((0.001402, 0.078468), (0.000000, 0.074178)).lineTo(0.000000, 0.000000).close()
