# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00282703" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.468750, 0.000000).lineTo(1.468750, 1.468750).lineTo(0.000000, 1.468750).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.070312, -0.312500), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.115789, 0.000000).lineTo(0.115789, 0.500000).lineTo(0.000000, 0.500000).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.036842, 0.115789).circle(0.021053)
loop3=wp_sketch1.moveTo(0.036842, 0.336842).circle(0.021053)
loop4=wp_sketch1.moveTo(0.036842, 0.442105).circle(0.021053)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.070312, 0.023438), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.023684, 0.000000).circle(0.023684)
loop6=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.017249, -0.020270), (0.031086, 0.002467)).lineTo(0.029112, 0.007895).lineTo(0.017763, 0.007895).lineTo(0.015789, 0.002467).close()
solid2=wp_sketch2.add(loop5).add(loop6).extrude(0.007812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.070312, 0.125000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop7=wp_sketch3.moveTo(0.023684, 0.000000).circle(0.023684)
loop8=wp_sketch3.moveTo(0.015789, 0.002467).threePointArc((0.023438, -0.008114), (0.031086, 0.002467)).lineTo(0.029112, 0.007895).lineTo(0.017763, 0.007895).lineTo(0.015789, 0.002467).close()
solid3=wp_sketch3.add(loop7).add(loop8).extrude(0.007812)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.070312, -0.195312), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop9=wp_sketch4.moveTo(0.023684, 0.000000).circle(0.023684)
loop10=wp_sketch4.moveTo(0.015789, 0.002467).threePointArc((0.023438, -0.008114), (0.031086, 0.002467)).lineTo(0.029112, 0.007895).lineTo(0.017763, 0.007895).lineTo(0.015789, 0.002467).close()
solid4=wp_sketch4.add(loop9).add(loop10).extrude(0.007812)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
