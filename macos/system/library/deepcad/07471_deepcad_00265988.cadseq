# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.695312, -0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.087336, -0.145559).lineTo(0.834539, -0.145559).lineTo(0.921875, 0.000000).lineTo(0.834539, 0.000000).lineTo(0.087336, 0.000000).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(-0.695312)
