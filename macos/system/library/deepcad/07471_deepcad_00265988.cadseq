import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.445312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.351562, 0.000000).lineTo(1.351562, 0.682895).lineTo(0.000000, 0.682895).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.695312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.695312, 0.226562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
