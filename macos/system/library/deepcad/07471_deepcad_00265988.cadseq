# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, -0.429688, -0.148438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch5.moveTo(0.150000, 0.000000).circle(0.150000)
solid5=wp_sketch5.add(loop5).extrude(-0.148438)
solid=solid.cut(solid5)

