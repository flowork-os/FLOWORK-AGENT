loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002409, -0.005815), (0.008224, -0.008224)).lineTo(0.070724, -0.008224).threePointArc((0.076128, -0.005645), (0.078125, 0.000000)).lineTo(0.078125, 0.062500).threePointArc((0.076128, 0.068145), (0.070724, 0.070724)).lineTo(0.008224, 0.070724).threePointArc((0.002409, 0.068315), (0.000000, 0.062500)).lineTo(0.000000, 0.000000).close()
