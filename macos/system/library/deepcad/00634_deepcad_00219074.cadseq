# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00219074" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.678947, 0.000000).lineTo(0.678947, 0.086842).lineTo(0.386842, 0.086842).lineTo(0.386842, 0.276316).threePointArc((0.343421, 0.746752), (0.300000, 0.276316)).lineTo(0.300000, 0.086842).lineTo(0.000000, 0.086842).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.339474, 0.513158).circle(0.118421)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.546875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.382812, 0.000000, 0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.295970, 0.000000).lineTo(0.190625, 0.476562).threePointArc((0.156598, 0.292737), (0.000000, 0.190625)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.085938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.295970, 0.000000).lineTo(0.295970, 0.190625).threePointArc((0.139372, 0.292737), (0.105345, 0.476562)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.085938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
