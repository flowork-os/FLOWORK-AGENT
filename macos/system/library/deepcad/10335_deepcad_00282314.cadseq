# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00282314" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.453125, 0.000000).lineTo(0.453125, 0.338651).lineTo(0.338651, 0.453125).lineTo(0.114474, 0.453125).lineTo(0.000000, 0.338651).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.226562, 0.117188, 0.117188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.226562, 0.000000).lineTo(0.226562, 0.226562).lineTo(0.000000, 0.226562).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.453125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.453125, 0.117188, 0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.226562, 0.000000).lineTo(0.226562, 0.226562).lineTo(0.000000, 0.226562).threePointArc((-0.042901, 0.113281), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(-0.226562)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.406250, 0.117188, 0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.173684, 0.000000).circle(0.170066)
solid3=wp_sketch3.add(loop3).extrude(0.117188)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
