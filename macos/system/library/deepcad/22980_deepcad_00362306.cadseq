import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.703125, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.152961, -0.091776).lineTo(0.305921, -0.091776).threePointArc((0.405345, -0.191201), (0.504770, -0.091776)).lineTo(0.887171, -0.091776).lineTo(1.453125, 0.030592).lineTo(1.453125, 0.076480).lineTo(0.000000, 0.076480).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
