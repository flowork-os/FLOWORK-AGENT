# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.033306, 0.000000).lineTo(0.066612, 0.000000).lineTo(0.066612, 0.043174).lineTo(0.061678, 0.046875).lineTo(0.061678, 0.080181).lineTo(0.066612, 0.085115).lineTo(0.066612, 0.117188).lineTo(0.033306, 0.117188).lineTo(0.000000, 0.117188).lineTo(0.000000, 0.085115).lineTo(0.004934, 0.080181).lineTo(0.004934, 0.046875).lineTo(0.000000, 0.043174).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
