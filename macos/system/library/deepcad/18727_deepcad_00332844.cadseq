# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00332844" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.125000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.009211, -0.009211).lineTo(0.101316, -0.009211).lineTo(0.875000, -0.009211).lineTo(0.875000, 0.000000).lineTo(0.828947, 0.000000).lineTo(0.828947, 0.009211).lineTo(0.534211, 0.009211).lineTo(0.534211, 0.000000).lineTo(0.488158, 0.000000).lineTo(0.488158, 0.009211).lineTo(0.128947, 0.009211).lineTo(0.055263, 0.009211).lineTo(0.055263, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.742188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.003947, 0.000000).circle(0.003865)
solid1=wp_sketch1.add(loop1).extrude(-0.023438)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.398438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.003947, 0.000000).circle(0.003865)
solid2=wp_sketch2.add(loop2).extrude(-0.023438)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
