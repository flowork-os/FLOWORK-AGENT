# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306895" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.257812, 0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.398438, 0.000000).lineTo(0.398438, 0.067105).lineTo(0.000000, 0.067105).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.156250, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.593750, 0.000000).lineTo(0.593750, 0.231250).lineTo(0.493750, 0.231250).lineTo(0.493750, 0.162500).lineTo(0.100000, 0.162500).lineTo(0.100000, 0.231250).lineTo(0.000000, 0.231250).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.100000, 0.100000).circle(0.031250)
loop3=wp_sketch1.moveTo(0.493750, 0.100000).circle(0.031250)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.062500)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
