wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.046875, -0.046875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001879, -0.004536), (0.006414, -0.006414)).lineTo(0.095148, -0.006414).threePointArc((0.099684, -0.004536), (0.101562, 0.000000)).lineTo(0.101562, 0.088734).threePointArc((0.099684, 0.093269), (0.095148, 0.095148)).lineTo(0.006414, 0.095148).threePointArc((0.001879, 0.093269), (0.000000, 0.088734)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.006414, -0.002657), (0.012829, 0.000000)).lineTo(0.088734, 0.000000).threePointArc((0.093269, 0.001879), (0.095148, 0.006414)).lineTo(0.095148, 0.082319).threePointArc((0.093269, 0.086855), (0.088734, 0.088734)).lineTo(0.012829, 0.088734).threePointArc((0.008293, 0.086855), (0.006414, 0.082319)).lineTo(0.006414, 0.006414).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.101562, 0.000000).lineTo(0.000000, 0.101562).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.046875)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.101562, 0.000000).lineTo(0.000000, 0.101562).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.046875)
solid_temp=solid_temp.union(solid1)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
