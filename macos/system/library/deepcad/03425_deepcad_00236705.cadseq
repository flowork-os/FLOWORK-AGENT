loop0=wp_sketch0.moveTo(0.480674, 0.000000).threePointArc((0.963872, 0.234279), (1.139885, 0.741612)).threePointArc((0.926896, 1.159677), (0.480674, 1.304688)).threePointArc((0.137454, 1.117012), (0.027467, 0.741612)).threePointArc((0.077881, 0.596600), (0.178536, 0.480674)).lineTo(0.178536, 0.466941).threePointArc((0.203998, 0.402208), (0.151069, 0.357072)).lineTo(0.000000, 0.357072).lineTo(0.000000, 0.000000).close()
