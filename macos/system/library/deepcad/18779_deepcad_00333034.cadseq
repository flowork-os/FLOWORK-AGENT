# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, -0.140625, 0.195312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.804688, 0.000000).lineTo(0.804688, 0.050822).lineTo(0.796217, 0.050822).lineTo(0.796217, 0.237171).lineTo(0.804688, 0.237171).lineTo(0.804688, 0.279523).lineTo(0.000000, 0.279523).lineTo(0.000000, 0.237171).lineTo(0.008470, 0.237171).lineTo(0.008470, 0.050822).lineTo(0.000000, 0.050822).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.046875)
