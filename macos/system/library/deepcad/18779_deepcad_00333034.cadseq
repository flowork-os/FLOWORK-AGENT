import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.898438, 0.000000).lineTo(0.898438, 0.094572).lineTo(0.841694, 0.094572).lineTo(0.841694, 0.283717).lineTo(0.898438, 0.283717).lineTo(0.898438, 0.378289).lineTo(0.000000, 0.378289).lineTo(0.000000, 0.283717).lineTo(0.056743, 0.283717).lineTo(0.056743, 0.094572).lineTo(0.000000, 0.094572).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.093750, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.796875, 0.000000).lineTo(0.796875, 0.184539).lineTo(0.000000, 0.184539).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.148438)
