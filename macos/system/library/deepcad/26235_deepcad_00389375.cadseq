loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.014693, -0.035472), (0.050164, -0.050164)).lineTo(0.902961, -0.050164).threePointArc((0.938432, -0.035472), (0.953125, 0.000000)).lineTo(0.953125, 0.341118).threePointArc((0.940510, 0.381607), (0.902961, 0.401316)).lineTo(0.050164, 0.401316).threePointArc((0.012615, 0.381607), (0.000000, 0.341118)).lineTo(0.000000, 0.000000).close()
