# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00330985" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.036974, 0.123420), (0.157895, 0.078947)).threePointArc((0.328794, 0.429101), (0.678947, 0.600000)).threePointArc((0.750000, 0.675552), (0.821053, 0.600000)).threePointArc((1.171206, 0.429101), (1.342105, 0.078947)).threePointArc((1.426052, 0.000000), (1.342105, -0.078947)).threePointArc((1.171206, -0.429101), (0.821053, -0.600000)).threePointArc((0.750000, -0.675552), (0.678947, -0.600000)).threePointArc((0.328794, -0.429101), (0.157895, -0.078947)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.296875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.125000, -0.062500).threePointArc((0.245445, -0.362555), (0.525000, -0.525000)).threePointArc((0.593750, -0.460344), (0.662500, -0.525000)).threePointArc((1.015306, -0.352806), (1.187500, 0.000000)).threePointArc((1.116966, 0.075000), (1.187500, 0.150000)).threePointArc((1.013156, 0.496556), (0.662500, 0.662500)).threePointArc((0.593750, 0.597844), (0.525000, 0.662500)).threePointArc((0.174344, 0.496556), (0.000000, 0.150000)).threePointArc((0.070534, 0.075000), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(-0.296875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.378947, 0.000000).circle(0.378947)
loop4=wp_sketch2.moveTo(0.378947, 0.000000).circle(0.221053)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.296875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
