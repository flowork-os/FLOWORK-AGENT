# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00328309" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, -0.617188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.968586, 0.000000).lineTo(0.968586, 1.179688).lineTo(0.000000, 1.179688).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.894079, 0.074507).lineTo(0.894079, 1.092763).lineTo(0.074507, 1.105181).lineTo(0.074507, 0.074507).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.148438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
