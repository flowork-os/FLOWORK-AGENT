# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00326416" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.210938, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.210938, 0.000000).lineTo(0.210938, 0.188734).lineTo(0.000000, 0.188734).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.088816, 0.093257).circle(0.046628)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.007812, -0.125000, 0.187500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.039474, 0.000000).circle(0.039474)
loop3=wp_sketch1.moveTo(0.039474, 0.000000).circle(0.034539)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.734375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
