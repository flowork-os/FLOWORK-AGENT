import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.038539, -0.093040), (0.131579, -0.131579)).lineTo(1.131579, -0.131579).threePointArc((1.218040, -0.090315), (1.250000, 0.000000)).lineTo(1.250000, 0.500000).threePointArc((1.218040, 0.590315), (1.131579, 0.631579)).lineTo(0.131579, 0.631579).threePointArc((0.038539, 0.593040), (0.000000, 0.500000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.052164, -0.060146), (0.131579, -0.065789)).lineTo(1.131579, -0.065789).threePointArc((1.171520, -0.043795), (1.184211, 0.000000)).lineTo(1.184211, 0.500000).threePointArc((1.171520, 0.543795), (1.131579, 0.565789)).lineTo(0.131579, 0.565789).threePointArc((0.085059, 0.546520), (0.065789, 0.500000)).lineTo(0.065789, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
