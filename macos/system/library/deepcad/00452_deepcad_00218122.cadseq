# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00218122" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.094737)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.250000, 0.265625, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.051316, 0.000000).circle(0.051316)
solid1=wp_sketch1.add(loop2).extrude(-1.000000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.203125, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.201316, 0.000000).circle(0.201316)
loop4=wp_sketch2.moveTo(0.201316, 0.000000).circle(0.100658)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.250000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.055263, 0.000000).circle(0.055263)
solid3=wp_sketch3.add(loop5).extrude(0.992188)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
