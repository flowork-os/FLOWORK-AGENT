import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.179688, 0.000000).lineTo(1.179688, 0.062089).lineTo(1.142434, 0.062089).threePointArc((1.117599, 0.037253), (1.092763, 0.062089)).lineTo(0.099342, 0.062089).threePointArc((0.062089, 0.024836), (0.024836, 0.062089)).lineTo(0.000000, 0.062089).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
