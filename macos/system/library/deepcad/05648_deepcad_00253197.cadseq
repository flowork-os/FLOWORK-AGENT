# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00253197" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.250000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.505263).lineTo(0.000000, 0.505263).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.126316, 0.142105).lineTo(0.126316, 0.126316).lineTo(0.142105, 0.126316).lineTo(0.142105, 0.142105).lineTo(0.157895, 0.142105).lineTo(0.157895, 0.157895).lineTo(0.142105, 0.157895).lineTo(0.126316, 0.157895).lineTo(0.110526, 0.157895).lineTo(0.110526, 0.142105).close()
loop2=wp_sketch0.moveTo(1.357895, 0.142105).lineTo(1.357895, 0.126316).lineTo(1.373684, 0.126316).lineTo(1.373684, 0.142105).lineTo(1.389474, 0.142105).lineTo(1.389474, 0.157895).lineTo(1.373684, 0.157895).lineTo(1.357895, 0.157895).lineTo(1.342105, 0.157895).lineTo(1.342105, 0.142105).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.312500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
