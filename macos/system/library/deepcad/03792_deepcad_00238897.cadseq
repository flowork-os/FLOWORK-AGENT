# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.492188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.406250, 0.000000).lineTo(1.406250, 0.414474).lineTo(1.125000, 0.710526).lineTo(0.843750, 0.710526).lineTo(0.843750, 0.488487).lineTo(1.050987, 0.488487).lineTo(1.050987, 0.207237).lineTo(0.355263, 0.207237).lineTo(0.355263, 0.488487).lineTo(0.562500, 0.488487).lineTo(0.562500, 0.710526).lineTo(0.281250, 0.710526).lineTo(0.000000, 0.414474).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.351562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
