wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.011562, -0.027912), (0.039474, -0.039474)).lineTo(0.189474, -0.039474).lineTo(0.750000, 0.126316).lineTo(0.750000, 0.394737).threePointArc((0.738438, 0.422649), (0.710526, 0.434211)).lineTo(0.039474, 0.434211).threePointArc((0.011562, 0.422649), (0.000000, 0.394737)).lineTo(0.000000, 0.000000).close()
