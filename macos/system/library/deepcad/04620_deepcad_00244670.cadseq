# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00244670" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.726562, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.429934, 0.000000).lineTo(1.476562, 0.139885).threePointArc((1.388088, 0.276268), (1.227878, 0.248684)).lineTo(0.979194, 0.295312).lineTo(0.699424, 0.295312).lineTo(0.357484, 0.202056).lineTo(0.000000, 0.202056).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.226562, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, -0.023438, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.193257, -0.278289).lineTo(0.193257, -0.734375).lineTo(0.386513, -0.734375).lineTo(0.386513, -0.278289).lineTo(0.448355, 0.000000).lineTo(0.448355, 0.695724).lineTo(0.000000, 0.695724).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.484375)
solid=solid.intersect(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.750000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch2.moveTo(0.195312, 0.000000).lineTo(0.195312, 0.039062).lineTo(0.000000, 0.039062).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.484375)
solid=solid.intersect(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.320312, 0.101562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.078947, -0.044408).lineTo(0.156250, 0.000000).lineTo(0.156250, 0.090461).lineTo(0.078947, 0.134868).lineTo(0.000000, 0.090461).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.078947, 0.044408).circle(0.059211)
solid3=wp_sketch3.add(loop3).add(loop4).extrude(-0.054688)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
