import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, 0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.271546, -0.731086).lineTo(0.992188, -0.731086).lineTo(0.992188, -0.647533).lineTo(0.323766, -0.647533).lineTo(0.073109, 0.031332).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, 0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.327138, -0.868174).lineTo(1.195312, -0.868174).lineTo(1.195312, -0.792681).lineTo(0.377467, -0.792681).lineTo(0.075493, 0.025164).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.226562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, 0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.327138, -0.868174).lineTo(1.195312, -0.868174).lineTo(1.195312, -0.566201).lineTo(0.528454, -0.566201).lineTo(0.276809, 0.100658).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.078125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
