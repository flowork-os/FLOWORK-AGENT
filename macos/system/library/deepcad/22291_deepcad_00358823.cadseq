# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00358823" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.437500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.687500, 0.000000).lineTo(0.687500, 0.441447).lineTo(0.000000, 0.441447).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.398438, -0.437500, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.284951, 0.000000).lineTo(0.284951, -0.284951).lineTo(0.351562, -0.284951).lineTo(0.351562, 0.066612).lineTo(0.000000, 0.066612).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.429688, -0.476562, 0.023438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.289062, 0.000000).lineTo(0.289062, 0.289062).lineTo(0.255592, 0.289062).lineTo(0.255592, 0.033470).lineTo(0.000000, 0.033470).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.023438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.570312, -0.195312, 0.062500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.108964, 0.000000).lineTo(0.108964, 0.195312).lineTo(0.000000, 0.195312).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.102796, 0.006168).lineTo(0.102796, 0.189145).lineTo(0.006168, 0.189145).lineTo(0.006168, 0.006168).close()
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.367188)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
