# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00270219" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.169737, -0.095477).lineTo(0.335938, 0.000000).lineTo(0.335938, 0.194490).lineTo(0.169737, 0.289967).lineTo(0.000000, 0.194490).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, 0.148438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.118421, 0.000000).circle(0.115954)
solid1=wp_sketch1.add(loop1).extrude(0.367188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, -0.101562, 0.515625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.169737, -0.095477).lineTo(0.335938, 0.000000).lineTo(0.335938, 0.194490).lineTo(0.169737, 0.289967).lineTo(0.000000, 0.194490).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.169737, 0.095477).circle(0.116694)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.187500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
