import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.000000, -0.320312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.289062, 0.000000).lineTo(1.289062, 0.325658).lineTo(0.692023, 0.325658).lineTo(0.651316, 0.434211).lineTo(0.434211, 0.434211).lineTo(0.434211, 0.325658).lineTo(0.542763, 0.325658).lineTo(0.542763, 0.217105).lineTo(0.108553, 0.217105).lineTo(0.108553, 0.325658).lineTo(0.217105, 0.325658).lineTo(0.217105, 0.434211).lineTo(0.000000, 0.434211).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.640625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
