import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.305418, -0.055621), (0.473684, 0.205263)).lineTo(0.473684, 0.442105).lineTo(0.426316, 0.442105).lineTo(0.426316, 0.221053).threePointArc((0.374450, 0.127415), (0.268421, 0.142105)).lineTo(0.252632, 0.126316).close()
loop2=wp_sketch0.moveTo(0.600000, 0.078947).lineTo(0.647368, 0.078947).lineTo(0.710526, 0.315789).lineTo(0.773684, 0.078947).lineTo(0.821053, 0.078947).lineTo(0.915789, 0.442105).lineTo(0.868421, 0.442105).lineTo(0.789474, 0.142105).lineTo(0.726316, 0.410526).lineTo(0.694737, 0.410526).lineTo(0.631579, 0.142105).lineTo(0.536842, 0.442105).lineTo(0.505263, 0.442105).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
