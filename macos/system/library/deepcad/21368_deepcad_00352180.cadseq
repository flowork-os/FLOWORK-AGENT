# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00352180" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.406250, 0.000000).lineTo(0.406250, 0.406250).lineTo(0.000000, 0.406250).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.203125, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.203125, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.339638, 0.000000).threePointArc((0.543997, 0.204359), (0.339638, 0.408717)).lineTo(0.000000, 0.408717).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.070312, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
