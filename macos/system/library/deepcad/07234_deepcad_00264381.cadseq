# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00264381" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.694737, 0.000000).circle(0.694737)
loop1=wp_sketch0.moveTo(0.694737, 0.000000).circle(0.115789)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.453125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, -0.453125, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.517105, 0.000000).circle(0.517105)
loop3=wp_sketch1.moveTo(0.517105, 0.000000).circle(0.258553)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.085938)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.515625, 0.000000, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.517105, 0.000000).circle(0.517105)
loop5=wp_sketch2.moveTo(0.517105, 0.000000).circle(0.258553)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(-0.085938)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
