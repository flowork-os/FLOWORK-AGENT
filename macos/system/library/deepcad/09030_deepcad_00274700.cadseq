import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.471053, -0.220806).threePointArc((0.647697, -0.260473), (0.824342, -0.220806)).lineTo(1.295395, 0.000000).threePointArc((1.397932, 0.161924), (1.295395, 0.323849)).lineTo(0.824342, 0.544655).threePointArc((0.647697, 0.584322), (0.471053, 0.544655)).lineTo(0.000000, 0.323849).threePointArc((-0.102537, 0.161924), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.073602, 0.161924).circle(0.088322)
loop2=wp_sketch0.moveTo(1.221793, 0.161924).circle(0.088322)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, 0.125000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.394737, 0.000000).circle(0.394737)
solid1=wp_sketch1.add(loop3).extrude(0.140625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch2.moveTo(0.173684, 0.000000).circle(0.170066)
loop5=wp_sketch2.moveTo(0.173684, 0.000000).circle(0.126645)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(-0.406250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
