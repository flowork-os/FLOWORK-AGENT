# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00353971" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.631579)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.234375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.631579, 0.000000).circle(0.631579)
loop3=wp_sketch1.moveTo(0.631579, 0.000000).circle(0.052632)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.265625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, -0.265625, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((-0.028676, 0.111570), (0.082895, 0.082895)).threePointArc((0.198496, 0.114660), (0.163487, 0.000000)).threePointArc((0.199602, -0.115736), (0.082895, -0.082895)).threePointArc((-0.031717, -0.114612), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.082895, 0.000000).circle(0.050658)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.023438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
