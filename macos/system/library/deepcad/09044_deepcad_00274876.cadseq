# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.212500, 0.000000).threePointArc((0.278496, 0.143148), (0.425000, 0.201316)).lineTo(0.850000, 0.201316).lineTo(0.850000, 0.536842).lineTo(1.062500, 0.939474).lineTo(0.212500, 0.939474).lineTo(0.212500, 0.637500).threePointArc((0.150260, 0.487240), (0.000000, 0.425000)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.109375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
