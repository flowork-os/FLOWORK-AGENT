# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00380877" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.173684).lineTo(0.000000, 0.173684).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.320312, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.193477, -0.060869), (0.316612, -0.222039)).lineTo(0.390625, -0.222039).lineTo(0.390625, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.320312, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.074013, 0.000000).threePointArc((0.197148, 0.161171), (0.390625, 0.222039)).lineTo(0.000000, 0.222039).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.320312, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.000000, 0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.882812, 0.000000).threePointArc((0.441406, 0.167165), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(0.320312, both=True)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
