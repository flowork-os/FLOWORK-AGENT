import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.192239, 0.064003), (0.101562, -0.117188)).lineTo(0.742188, -0.164062).threePointArc((0.597039, -0.007812), (0.742188, 0.148438)).lineTo(0.296875, 0.117188).threePointArc((0.239344, 0.134546), (0.210938, 0.187500)).lineTo(0.195312, 0.445312).threePointArc((0.113281, 0.357007), (0.031250, 0.445312)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.114474, 0.000000).circle(0.112089)
solid1=wp_sketch1.add(loop1).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.000000, 0.445312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.078947, 0.000000).circle(0.077303)
solid2=wp_sketch2.add(loop2).extrude(0.031250)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.157895, 0.000000).circle(0.157895)
solid3=wp_sketch3.add(loop3).extrude(0.031250)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
