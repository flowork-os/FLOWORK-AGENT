# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00238664" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.254605, 0.254605).lineTo(0.227961, 0.281250).lineTo(0.000000, 0.056250).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.026645, -0.026645).lineTo(0.281250, 0.227961).lineTo(0.225000, 0.225000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.156250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, -0.437500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.562500).lineTo(0.267188, 0.815625).lineTo(0.281250, 0.829688).lineTo(0.534375, 1.082812).lineTo(1.082812, 1.082812).threePointArc((1.300781, 1.047656), (1.265625, 0.829688)).lineTo(0.773438, 0.323437).lineTo(0.660938, 0.435938).lineTo(0.646875, 0.421875).lineTo(0.759375, 0.309375).lineTo(0.196875, -0.253125).threePointArc((-0.061702, -0.251115), (0.000000, 0.000000)).close()
loop3=wp_sketch2.moveTo(0.070312, -0.154688).circle(0.042188)
loop4=wp_sketch2.moveTo(1.181250, 0.956250).circle(0.042188)
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).extrude(0.078125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
