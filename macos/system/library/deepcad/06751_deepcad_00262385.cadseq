# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.022256, -0.053731), (0.075987, -0.075987)).lineTo(0.525576, -0.075987).threePointArc((0.579306, -0.053731), (0.601562, 0.000000)).lineTo(0.601562, 0.449589).threePointArc((0.579306, 0.503320), (0.525576, 0.525576)).lineTo(0.075987, 0.525576).threePointArc((0.022256, 0.503320), (0.000000, 0.449589)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
