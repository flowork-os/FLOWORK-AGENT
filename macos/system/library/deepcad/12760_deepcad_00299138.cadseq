import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009247, -0.019865), (0.029112, -0.029112)).lineTo(1.353701, -0.029112).threePointArc((1.373566, -0.019865), (1.382812, 0.000000)).lineTo(1.382812, 0.582237).threePointArc((1.374181, 0.602718), (1.353701, 0.611349)).lineTo(0.029112, 0.611349).threePointArc((0.008631, 0.602718), (0.000000, 0.582237)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, -0.320312, 0.031250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.009247, -0.019865), (0.029112, -0.029112)).lineTo(1.353701, -0.029112).threePointArc((1.373566, -0.019865), (1.382812, 0.000000)).lineTo(1.382812, 0.582237).threePointArc((1.374181, 0.602718), (1.353701, 0.611349)).lineTo(0.029112, 0.611349).threePointArc((0.008631, 0.602718), (0.000000, 0.582237)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(1.295477, 0.029112).lineTo(1.295477, 0.553125).lineTo(0.087336, 0.553125).lineTo(0.087336, 0.029112).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.343750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
