# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00321272" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.431579, 0.000000).lineTo(0.431579, -0.566447).lineTo(1.281250, -0.566447).lineTo(1.281250, -0.283224).lineTo(0.714803, -0.283224).lineTo(0.714803, 0.283224).lineTo(0.000000, 0.283224).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.710938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, -0.281250, -0.320312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.288158, 0.000000).lineTo(0.288158, 0.570312).lineTo(0.000000, 0.570312).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.429688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
