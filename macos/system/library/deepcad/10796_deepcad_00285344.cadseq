# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285344" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.132812, 0.119243).threePointArc((1.007826, 0.232525), (1.132812, 0.345806)).lineTo(0.000000, 0.453125).threePointArc((0.205344, 0.226562), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.775082, 0.166941).threePointArc((0.715461, 0.226562), (0.775082, 0.286184)).lineTo(0.321957, 0.286184).threePointArc((0.262336, 0.226562), (0.321957, 0.166941)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.228947, 0.000000).circle(0.228947)
loop3=wp_sketch1.moveTo(0.228947, 0.000000).circle(0.171711)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.343750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.507812, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.114474, 0.000000).circle(0.112089)
loop5=wp_sketch2.moveTo(0.114474, 0.000000).circle(0.057237)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.281250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
