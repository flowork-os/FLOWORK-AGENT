# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00289310" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, -0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.459951, 0.000000).lineTo(0.459951, 0.929687).lineTo(0.000000, 0.929687).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.477632, 0.000000).lineTo(0.477632, 0.945312).lineTo(0.000000, 0.945312).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.467681, 0.009951).lineTo(0.467681, 0.935362).lineTo(0.009951, 0.935362).lineTo(0.009951, 0.009951).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.477632, 0.000000).lineTo(0.477632, 0.945312).lineTo(0.000000, 0.945312).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.467681, 0.009951).lineTo(0.467681, 0.935362).lineTo(0.009951, 0.935362).lineTo(0.009951, 0.009951).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
