wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.531250, -0.218750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.121584, -0.015915), (0.215789, -0.094408)).threePointArc((0.525987, -0.222896), (0.836184, -0.094408)).threePointArc((0.937133, -0.013959), (1.065461, 0.000000)).threePointArc((1.287993, 0.222533), (1.065461, 0.445066)).threePointArc((0.937133, 0.459025), (0.836184, 0.539474)).threePointArc((0.525987, 0.667962), (0.215789, 0.539474)).threePointArc((0.121584, 0.460981), (0.000000, 0.445066)).threePointArc((-0.222533, 0.222533), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.215789).circle(0.094408)
