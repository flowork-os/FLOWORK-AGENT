# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00346829" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, -0.570312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.806086, 0.403043).lineTo(0.972862, 1.097944).lineTo(0.389145, 1.320312).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.273438, -0.234375, 0.304688), cq.Vector(0.893224, 0.449611, -0.000000), cq.Vector(0.449611, -0.893224, 0.000000)))
loop1=wp_sketch1.moveTo(0.063158, 0.000000).circle(0.061842)
solid1=wp_sketch1.add(loop1).extrude(-1.000000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.382812, -0.296875, 0.421875), cq.Vector(0.242980, 0.970031, -0.000000), cq.Vector(0.970031, -0.242980, 0.000000)))
loop2=wp_sketch2.moveTo(0.132812, -0.055921).lineTo(0.132812, 0.015378).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.296875)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.414062, -0.171875, 0.367188), cq.Vector(0.242980, 0.970031, -0.000000), cq.Vector(0.970031, -0.242980, 0.000000)))
loop3=wp_sketch3.moveTo(0.640625, -0.269737).lineTo(0.559704, 0.134868).lineTo(0.000000, 0.067434).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.296875)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
