import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.265625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.554688, 0.000000).lineTo(0.554688, 0.338651).lineTo(0.000000, 0.338651).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.609375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.554688, 0.000000).lineTo(0.554688, 0.338651).lineTo(0.000000, 0.338651).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, -0.718750, 0.031250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.782566, 0.000000).lineTo(0.782566, 1.429688).lineTo(0.000000, 1.429688).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.662171, 0.978207).lineTo(0.662171, 1.324342).lineTo(0.105345, 1.324342).lineTo(0.105345, 0.978207).close()
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.687500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.265625, 0.031250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.554688, 0.000000).lineTo(0.554688, 0.338651).lineTo(0.000000, 0.338651).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.687500)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
