# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00276109" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.192270, -0.192270).lineTo(0.508141, -0.508141).threePointArc((0.652344, -0.372527), (0.796546, -0.508141)).lineTo(1.112418, -0.192270).lineTo(1.304688, 0.000000).lineTo(1.304688, 0.054934).lineTo(0.000000, 0.054934).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.914062, 0.000000).lineTo(0.914062, 0.558059).lineTo(0.596546, 0.240543).threePointArc((0.457031, 0.092194), (0.317516, 0.240543)).lineTo(0.000000, 0.558059).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.031250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
