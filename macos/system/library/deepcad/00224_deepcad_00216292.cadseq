# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00216292" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.476562, 0.000000).lineTo(1.476562, 0.699424).lineTo(1.352220, 0.699424).threePointArc((1.279505, 0.724684), (1.243421, 0.792681)).threePointArc((0.738281, 1.256190), (0.233141, 0.792681)).threePointArc((0.197058, 0.724684), (0.124342, 0.699424)).lineTo(0.000000, 0.699424).lineTo(0.000000, 0.575082).lineTo(0.373026, 0.575082).threePointArc((1.021552, 0.973757), (0.404112, 0.528454)).lineTo(0.000000, 0.528454).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.218750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.554688, -0.109375, -0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.075000, 0.000000).circle(0.073438)
solid1=wp_sketch1.add(loop1).extrude(-1.000000, both=True)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.179688, -0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.062450, 0.074219), (0.000000, 0.148438)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-1.000000, both=True)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.179688, -0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.146875).threePointArc((-0.087277, 0.073438), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(-1.000000, both=True)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
