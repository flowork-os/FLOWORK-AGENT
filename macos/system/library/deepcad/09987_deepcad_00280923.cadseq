# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00280923" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.097000, -0.088105), (0.212500, -0.150000)).lineTo(1.087500, -0.075000).threePointArc((1.184532, 0.006016), (1.100000, 0.100000)).lineTo(0.212500, 0.100000).threePointArc((0.095022, 0.073859), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.162500, 0.037500).circle(0.025000)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.148438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
