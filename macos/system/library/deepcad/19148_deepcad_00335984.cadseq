# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00335984" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.125000, 0.000000, 0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.124342, 0.000000).lineTo(0.367845, 0.000000).lineTo(0.492187, 0.000000).lineTo(0.492187, 0.108799).lineTo(0.000000, 0.108799).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.257812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.257812, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.242188, 0.000000).lineTo(0.242188, 0.127467).lineTo(0.000000, 0.127467).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.125000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.339474).lineTo(0.623684, 0.339474).lineTo(0.623684, 0.236842).lineTo(0.623684, 0.110526).lineTo(0.497368, 0.110526).lineTo(0.252632, 0.110526).lineTo(0.126316, 0.110526).lineTo(0.126316, 0.236842).lineTo(0.126316, 0.339474).lineTo(0.000000, 0.339474).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.382812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.320312, 0.125000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch3.moveTo(0.055263, 0.000000).circle(0.055263)
solid3=wp_sketch3.add(loop3).extrude(-0.109375)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
