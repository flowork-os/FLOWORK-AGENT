# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00304254" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.036842, 0.000000).lineTo(0.036842, 0.218750).lineTo(0.000000, 0.218750).lineTo(0.018421, 0.110526).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.098026, 0.000000).lineTo(0.098026, 0.061266).lineTo(0.159293, 0.000000).lineTo(0.220559, 0.061266).lineTo(0.588158, 0.000000).lineTo(0.943503, 0.061266).lineTo(1.004770, 0.000000).lineTo(1.066036, 0.061266).lineTo(1.066036, 0.000000).lineTo(1.164062, 0.000000).lineTo(1.164062, 0.220559).lineTo(0.000000, 0.220559).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.159293, 0.049013).lineTo(0.183799, 0.073520).lineTo(0.159293, 0.098026).lineTo(0.134786, 0.073520).close()
loop3=wp_sketch1.moveTo(1.004770, 0.049013).lineTo(1.029276, 0.073520).lineTo(1.004770, 0.098026).lineTo(0.980263, 0.073520).close()
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.710938, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.036842, 0.000000).lineTo(0.018421, 0.110526).lineTo(0.036842, 0.218750).lineTo(0.000000, 0.218750).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.046875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
