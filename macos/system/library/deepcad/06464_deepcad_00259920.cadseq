import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.359375, -0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.025848, 0.038548), (0.069572, 0.054112)).lineTo(0.347862, 0.054112).threePointArc((0.380659, 0.067697), (0.394243, 0.100493)).lineTo(0.394243, 0.115954).threePointArc((0.380659, 0.148751), (0.347862, 0.162336)).lineTo(0.069572, 0.162336).threePointArc((0.025848, 0.177900), (0.000000, 0.216447)).threePointArc((-0.729585, 0.108224), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.340132, 0.108224).circle(0.015461)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
