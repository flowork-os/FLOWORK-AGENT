# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00216219" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009249, -0.022330), (0.031579, -0.031579)).lineTo(1.468421, -0.031579).threePointArc((1.490751, -0.022330), (1.500000, 0.000000)).lineTo(1.500000, 0.394737).threePointArc((1.490751, 0.417067), (1.468421, 0.426316)).lineTo(0.031579, 0.426316).threePointArc((0.009249, 0.417067), (0.000000, 0.394737)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.157895, 0.205263).circle(0.031579)
loop2=wp_sketch0.moveTo(0.568421, 0.205263).circle(0.031579)
loop3=wp_sketch0.moveTo(1.326316, 0.205263).circle(0.094737)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.007812, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
