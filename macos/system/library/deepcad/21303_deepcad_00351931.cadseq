# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00351931" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.421875, 0.000000).lineTo(1.421875, 0.059868).lineTo(1.047697, 0.059868).lineTo(1.047697, 0.044901).lineTo(0.987829, 0.044901).lineTo(0.987829, 0.059868).lineTo(0.733388, 0.059868).lineTo(0.733388, 0.179605).lineTo(0.389145, 0.179605).lineTo(0.389145, 0.059868).lineTo(0.000000, 0.059868).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.445312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.234375, 0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.054687, 0.000000).lineTo(0.054687, 0.018997).lineTo(0.000000, 0.018997).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.695312)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
