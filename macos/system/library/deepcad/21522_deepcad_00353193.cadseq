# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00353193" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.221053, -0.221053).lineTo(0.528947, -0.221053).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.307895).lineTo(0.528947, 0.528947).lineTo(0.221053, 0.528947).lineTo(0.000000, 0.307895).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.300000, -0.031579).lineTo(0.450000, -0.031579).lineTo(0.560526, 0.078947).lineTo(0.560526, 0.236842).lineTo(0.450000, 0.339474).lineTo(0.300000, 0.339474).lineTo(0.189474, 0.236842).lineTo(0.189474, 0.078947).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
