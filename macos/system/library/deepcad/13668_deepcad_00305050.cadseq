# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00305050" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.523438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.106250, -1.078774), (0.212500, 0.000000)).lineTo(0.212500, 0.123026).threePointArc((0.106250, 0.229276), (0.000000, 0.123026)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.111842, 0.123026).circle(0.033553)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
