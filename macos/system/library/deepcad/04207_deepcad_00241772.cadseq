loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.100588, -0.016827), (0.185033, -0.074013)).threePointArc((0.481086, -0.200921), (0.777138, -0.074013)).threePointArc((0.861583, -0.016827), (0.962171, 0.000000)).threePointArc((1.173342, 0.203536), (0.962171, 0.407072)).threePointArc((0.861583, 0.423899), (0.777138, 0.481086)).threePointArc((0.481086, 0.607993), (0.185033, 0.481086)).threePointArc((0.100588, 0.423899), (0.000000, 0.407072)).threePointArc((-0.211171, 0.203536), (0.000000, 0.000000)).close()
