wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.279121, -0.115616), (0.394737, -0.394737)).lineTo(0.500000, 0.000000).lineTo(0.000000, 0.000000).close()
