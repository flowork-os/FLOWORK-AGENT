# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.085938, 0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch4.moveTo(0.105263, -0.389474).threePointArc((0.500000, -0.784211), (0.894737, -0.389474)).lineTo(1.000000, 0.000000).lineTo(1.000000, 0.073684).lineTo(0.505263, 0.073684).lineTo(0.000000, 0.073684).lineTo(0.000000, 0.000000).close()
