loop4=wp_sketch3.moveTo(0.505263, 0.000000).lineTo(1.000000, 0.000000).lineTo(1.000000, 0.210526).threePointArc((0.956837, 0.314732), (0.852632, 0.357895)).threePointArc((0.500000, 0.231721), (0.147368, 0.357895)).threePointArc((0.043163, 0.314732), (0.000000, 0.210526)).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch3.moveTo(0.115789, 0.252632).circle(0.042105)
