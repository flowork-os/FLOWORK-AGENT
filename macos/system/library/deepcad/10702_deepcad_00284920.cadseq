import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.812500, 0.068421).threePointArc((0.722854, 0.149671), (0.812500, 0.230921)).lineTo(0.008553, 0.325000).threePointArc((0.151558, 0.158624), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.555921, 0.111184).threePointArc((0.594408, 0.149671), (0.555921, 0.188158)).lineTo(0.230921, 0.205263).threePointArc((0.188158, 0.162500), (0.230921, 0.119737)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.585938, 0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.082895, 0.000000).circle(0.081168)
loop3=wp_sketch1.moveTo(0.082895, 0.000000).circle(0.041447)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.203125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.165789, 0.000000).circle(0.165789)
loop5=wp_sketch2.moveTo(0.165789, 0.000000).circle(0.124342)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.242188)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
