import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.071053).lineTo(0.663158, 0.071053).lineTo(0.663158, 0.426316).lineTo(0.600000, 0.426316).threePointArc((0.375000, 0.548362), (0.150000, 0.426316)).lineTo(0.086842, 0.426316).lineTo(0.086842, 0.071053).lineTo(0.000000, 0.071053).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.378947, 0.276316).circle(0.205263)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.398438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
