import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.492188, 0.031250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.326891, -0.026151).lineTo(0.470724, -0.026151).lineTo(1.098355, -0.026151).lineTo(1.124507, 0.104605).lineTo(1.242188, 0.274589).lineTo(1.124507, 0.274589).lineTo(0.889145, 0.104605).lineTo(0.470724, 0.091530).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
