# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.056854, -0.200735), (0.205263, -0.347368)).lineTo(0.536842, -0.552632).threePointArc((0.750000, -0.611620), (0.963158, -0.552632)).lineTo(1.294737, -0.347368).threePointArc((1.443146, -0.200735), (1.500000, 0.000000)).lineTo(1.500000, 0.821053).lineTo(0.000000, 0.821053).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.189474, 0.284211).circle(0.078947)
loop2=wp_sketch0.moveTo(0.757895, -0.315789).circle(0.078947)
loop3=wp_sketch0.moveTo(1.263158, 0.284211).circle(0.078947)
