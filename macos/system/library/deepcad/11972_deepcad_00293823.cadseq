# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00293823" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.664062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.081867, -0.081867), (0.163734, 0.000000)).lineTo(0.163734, 1.324753).threePointArc((0.081867, 1.406620), (0.000000, 1.324753)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.089309, 0.000000).circle(0.044655)
loop2=wp_sketch0.moveTo(0.089309, 1.324753).circle(0.044655)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.039062, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
