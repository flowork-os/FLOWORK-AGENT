# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220976" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.651069, 0.000000).threePointArc((0.710938, 0.059868), (0.651069, 0.119737)).lineTo(0.561266, 0.119737).lineTo(0.561266, 0.359211).lineTo(0.089803, 0.359211).lineTo(0.089803, 0.119737).lineTo(0.000000, 0.119737).threePointArc((-0.059868, 0.059868), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.059868).circle(0.014967)
loop2=wp_sketch0.moveTo(0.651069, 0.059868).circle(0.014967)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
