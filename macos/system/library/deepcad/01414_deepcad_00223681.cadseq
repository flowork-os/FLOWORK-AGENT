# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00223681" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.093750, 0.000000).lineTo(1.093750, 0.817434).lineTo(0.000000, 0.817434).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.036184, 0.057566).lineTo(1.036184, 0.759868).lineTo(0.057566, 0.759868).lineTo(0.057566, 0.057566).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, -0.406250, 0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.515625, 0.000000).lineTo(0.515625, 0.265954).lineTo(0.000000, 0.265954).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-1.000000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.546875, -0.109375, 0.515625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.114474, 0.000000).circle(0.114474)
solid2=wp_sketch2.add(loop3).extrude(-1.000000)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
