# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00301515" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.272368, 0.000000).circle(0.272368)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.073766, -0.255345), (0.329112, -0.181579)).lineTo(0.334786, 0.181579).threePointArc((0.269531, 0.116324), (0.204276, 0.181579)).lineTo(0.204276, -0.181579).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
