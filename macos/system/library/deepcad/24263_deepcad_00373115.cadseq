import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.132812, 0.000000, -0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.389638, 0.000000).lineTo(0.389638, 0.719984).lineTo(0.618339, 0.719984).lineTo(0.618339, 0.804688).lineTo(0.033882, 0.804688).lineTo(0.033882, 0.719984).lineTo(0.245641, 0.719984).lineTo(0.245641, 0.084704).lineTo(0.076234, 0.084704).lineTo(0.076234, 0.152467).lineTo(0.000000, 0.152467).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.187500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
