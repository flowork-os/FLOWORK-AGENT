loop6=wp_sketch3.moveTo(0.023438, 0.000000).lineTo(0.023438, 0.003701).lineTo(0.023438, 0.014803).lineTo(0.023438, 0.023438).lineTo(0.000000, 0.023438).lineTo(0.000000, 0.014803).lineTo(0.000000, 0.003701).lineTo(0.000000, 0.000000).close()
