# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239027" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.013936, -0.343329), (0.324836, -0.285855)).threePointArc((0.650833, -0.191846), (0.987500, -0.233882)).threePointArc((1.195301, -0.275260), (1.169408, -0.064967)).threePointArc((0.594340, 0.140974), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.129934, -0.181908).circle(0.116941)
loop2=wp_sketch0.moveTo(1.104441, -0.181908).circle(0.064967)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.218750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
