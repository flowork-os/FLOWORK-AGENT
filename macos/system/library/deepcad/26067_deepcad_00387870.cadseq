# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387870" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.252632, 0.000000).circle(0.252632)
loop1=wp_sketch0.moveTo(0.252632, 0.000000).circle(0.126316)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.252632, 0.000000).lineTo(0.252632, 0.252632).threePointArc((0.075084, 0.323994), (0.000000, 0.500000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, -0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.992188, 0.000000).lineTo(0.992188, 0.125329).lineTo(0.135773, 0.699753).threePointArc((0.234422, 0.424858), (0.000000, 0.250658)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.250000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.250000, -0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(1.242188, 0.000000).lineTo(1.242188, 0.130757).lineTo(0.496875, 0.130757).lineTo(0.496875, 0.496875).threePointArc((0.248438, 0.745313), (0.000000, 0.496875)).lineTo(0.000000, 0.130757).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch3.moveTo(0.248438, 0.496875).circle(0.130757)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.250000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
