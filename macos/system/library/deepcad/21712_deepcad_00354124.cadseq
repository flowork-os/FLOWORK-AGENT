# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00354124" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.398438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.351316, 0.000000).circle(0.351316)
loop1=wp_sketch0.moveTo(0.351316, 0.000000).circle(0.197615)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.203125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.000000, 0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.409293, -0.409293).lineTo(0.617188, -0.292352).lineTo(0.064967, 0.175411).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.409293, -0.279359).lineTo(0.448273, -0.233882).lineTo(0.110444, 0.058470).lineTo(0.077961, 0.012993).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.203125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
