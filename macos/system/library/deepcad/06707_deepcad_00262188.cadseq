# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.055496, -0.133978), (0.189474, -0.189474)).lineTo(1.310526, -0.189474).threePointArc((1.444504, -0.133978), (1.500000, 0.000000)).lineTo(1.500000, 0.568421).threePointArc((1.444504, 0.702399), (1.310526, 0.757895)).lineTo(0.189474, 0.757895).threePointArc((0.055496, 0.702399), (0.000000, 0.568421)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, -0.234375, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
