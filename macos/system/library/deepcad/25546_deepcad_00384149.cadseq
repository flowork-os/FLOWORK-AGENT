wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.343750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009201, -0.022213), (0.031414, -0.031414)).lineTo(1.460773, -0.031414).threePointArc((1.482986, -0.022213), (1.492188, 0.000000)).lineTo(1.492188, 0.675411).threePointArc((1.482986, 0.697625), (1.460773, 0.706826)).lineTo(0.031414, 0.706826).threePointArc((0.009201, 0.697625), (0.000000, 0.675411)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0

