# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00247875" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.710526, 0.000000).threePointArc((0.750000, -0.039474), (0.789474, 0.000000)).lineTo(1.342105, 0.000000).threePointArc((0.750000, 0.592105), (0.157895, 0.000000)).close()
loop2=wp_sketch0.moveTo(0.157895, 0.000000).threePointArc((0.312061, -0.367988), (0.647368, -0.584211)).lineTo(0.647368, -0.110526).threePointArc((0.639474, -0.110284), (0.631579, -0.110526)).lineTo(0.157895, -0.110526).close()
loop3=wp_sketch0.moveTo(0.157895, -0.110526).threePointArc((0.750000, -0.294114), (1.342105, -0.110526)).lineTo(0.868421, -0.110526).threePointArc((0.860526, -0.110284), (0.852632, -0.110526)).lineTo(0.852632, -0.584211).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.210938, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.550000, 0.000000).threePointArc((0.562814, 0.030936), (0.593750, 0.043750)).lineTo(0.593750, 0.593750).threePointArc((0.540356, 0.589783), (0.487500, 0.581250)).lineTo(0.487500, 0.118750).threePointArc((0.481058, 0.112692), (0.475000, 0.106250)).lineTo(0.012500, 0.106250).threePointArc((0.003967, 0.053394), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop4).extrude(0.210938, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.030936, -0.012814), (0.043750, -0.043750)).lineTo(0.593750, -0.043750).threePointArc((0.589783, 0.009644), (0.581250, 0.062500)).lineTo(0.118750, 0.062500).threePointArc((0.112692, 0.068942), (0.106250, 0.075000)).lineTo(0.106250, 0.543750).threePointArc((0.053259, 0.549158), (0.000000, 0.550000)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop5).extrude(0.210938, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
