# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00350412" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.978947, 0.000000).lineTo(0.978947, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.063158, 1.121053).circle(0.047368)
loop2=wp_sketch0.moveTo(0.173684, 0.173684).circle(0.047368)
loop3=wp_sketch0.moveTo(0.821053, 0.173684).circle(0.047368)
loop4=wp_sketch0.moveTo(0.915789, 1.121053).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.687500, 0.039062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.531250, 0.000000).lineTo(0.531250, 0.061513).lineTo(0.000000, 0.061513).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.148438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
