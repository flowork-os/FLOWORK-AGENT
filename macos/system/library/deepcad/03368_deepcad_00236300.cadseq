# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236300" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.671875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.194285, -1.367520), (0.388569, 0.000000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.187089, -0.676398).circle(0.647615)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.757895)
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((2.807586, -3.002566), (0.947368, 0.663158)).lineTo(0.552632, 0.663158).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.007812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
