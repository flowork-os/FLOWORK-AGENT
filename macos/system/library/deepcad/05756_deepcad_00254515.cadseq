# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00254515" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.093750, -0.664062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.lineTo(0.000000, -0.003618).lineTo(0.083224, -0.003618).lineTo(0.083224, -0.083224).lineTo(0.343750, -0.083224).lineTo(0.343750, 0.086842).lineTo(0.000000, 0.086842).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.117188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
