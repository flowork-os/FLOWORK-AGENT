# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00354128" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, -0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.256579, 0.000000).circle(0.256579)
loop1=wp_sketch0.moveTo(0.256579, 0.000000).circle(0.144326)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, -0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.128289, -0.096217).lineTo(0.507812, 0.277961).lineTo(0.427632, 0.368832).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.176398, 0.000000).lineTo(0.422286, 0.240543).lineTo(0.390214, 0.277961).lineTo(0.122944, 0.048109).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.148438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
