# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00359374" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, -0.382812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757812, 0.000000).lineTo(0.757812, 0.757812).lineTo(0.000000, 0.757812).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.733882, 0.023931).lineTo(0.733882, 0.733882).lineTo(0.023931, 0.733882).lineTo(0.023931, 0.023931).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.742188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, -0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.718750, 0.000000).lineTo(0.718750, 0.718750).lineTo(0.000000, 0.718750).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.590132, 0.128618).lineTo(0.590132, 0.590132).lineTo(0.128618, 0.590132).lineTo(0.128618, 0.128618).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.046875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
