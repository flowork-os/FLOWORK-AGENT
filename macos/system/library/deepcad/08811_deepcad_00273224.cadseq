wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.062433, -0.102659), (0.182566, -0.100411)).lineTo(0.803289, 0.255592).threePointArc((0.848931, 0.419901), (0.684622, 0.465543)).lineTo(0.365132, 0.273849).threePointArc((0.280252, 0.273644), (0.237336, 0.346875)).lineTo(0.237336, 0.602467).threePointArc((0.118668, 0.721135), (0.000000, 0.602467)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.118668, 0.000000).circle(0.082155)
