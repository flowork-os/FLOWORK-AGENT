wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, 0.000000, 0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.350000, -0.153125).lineTo(0.798437, -0.240625).lineTo(0.612500, -0.328125).lineTo(0.656250, -0.415625).lineTo(0.120312, -0.273438).lineTo(0.054688, -0.525000).lineTo(0.328125, -0.525000).lineTo(0.021875, -0.645312).lineTo(1.039062, -0.350000).lineTo(0.557812, 0.098437).lineTo(0.284375, 0.196875).lineTo(0.153125, 0.120312).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
