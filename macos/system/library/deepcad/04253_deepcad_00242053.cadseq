import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.437500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.197528, 0.046350), (0.353125, 0.176562)).threePointArc((0.411437, 0.218658), (0.483224, 0.223026)).threePointArc((0.752675, 0.441406), (0.483224, 0.659786)).threePointArc((0.411437, 0.664154), (0.353125, 0.706250)).threePointArc((0.197528, 0.836462), (0.000000, 0.882812)).lineTo(0.000000, 0.752714).threePointArc((0.311308, 0.441406), (0.000000, 0.130099)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.529687, 0.446053).circle(0.092928)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.072636, -0.005147), (0.131250, -0.048355)).threePointArc((0.286075, -0.179991), (0.483553, -0.227961)).lineTo(0.483553, -0.089803).threePointArc((0.176151, 0.217599), (0.483553, 0.525000)).lineTo(0.483553, 0.656250).threePointArc((0.286895, 0.611735), (0.131250, 0.483553)).threePointArc((0.073638, 0.436890), (0.000000, 0.428289)).threePointArc((-0.264226, 0.214145), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(-0.041447, 0.214145).circle(0.089803)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.046875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
