import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.718750, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-1.889661, 0.023191), (0.000000, 0.046382)).threePointArc((0.015461, 0.030921), (0.030921, 0.046382)).threePointArc((-1.858740, 0.023191), (0.030921, 0.000000)).threePointArc((0.015461, -0.015461), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
