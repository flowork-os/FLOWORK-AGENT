# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.046875, 0.000000, 0.093750), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
