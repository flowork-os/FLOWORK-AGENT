# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.031086, 0.000000).lineTo(0.062171, 0.000000).lineTo(0.062171, 0.040296).lineTo(0.057566, 0.043750).lineTo(0.057566, 0.074836).lineTo(0.062171, 0.079441).lineTo(0.062171, 0.109375).lineTo(0.031086, 0.109375).lineTo(0.000000, 0.109375).lineTo(0.000000, 0.079441).lineTo(0.004605, 0.074836).lineTo(0.004605, 0.043750).lineTo(0.000000, 0.040296).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.023438, -0.750000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.011842, 0.000000).circle(0.011842)
