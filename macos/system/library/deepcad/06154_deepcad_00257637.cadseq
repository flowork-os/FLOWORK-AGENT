import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, -0.703125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.091776, 0.000000).threePointArc((0.435938, 0.344161), (0.780099, 0.000000)).lineTo(0.871875, 0.000000).lineTo(0.871875, 1.009539).threePointArc((0.435938, 1.445477), (0.000000, 1.009539)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.295117, 0.315156), (0.718914, 0.397697)).lineTo(0.718914, 0.994243).threePointArc((0.443776, 1.291900), (0.152961, 1.009539)).lineTo(0.152961, 0.397697).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.359375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
