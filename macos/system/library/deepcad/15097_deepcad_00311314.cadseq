import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.453125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.590049, 0.000000).lineTo(0.590049, 0.158306).threePointArc((0.603929, 0.206207), (0.647615, 0.230263)).lineTo(1.136924, 0.230263).threePointArc((1.367188, 0.460526), (1.136924, 0.690789)).lineTo(0.647615, 0.690789).threePointArc((0.606910, 0.707650), (0.590049, 0.748355)).lineTo(0.590049, 0.906661).lineTo(0.000000, 0.906661).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.375000, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.585938, 0.000000).lineTo(0.585938, 0.080181).lineTo(0.000000, 0.080181).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.781250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.453125, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.585938, 0.000000).lineTo(0.585938, 0.080181).lineTo(0.000000, 0.080181).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.781250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
