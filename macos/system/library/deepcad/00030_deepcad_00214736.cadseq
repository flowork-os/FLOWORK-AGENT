# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00214736" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.320312, -0.335938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.018200, -0.094417), (0.114309, -0.091447)).lineTo(0.445806, 0.205757).threePointArc((0.486795, 0.274480), (0.491530, 0.354359)).lineTo(0.400082, 1.017352).threePointArc((0.320406, 1.081513), (0.251480, 1.005921)).threePointArc((0.194050, 0.485883), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.320066, 0.331497).circle(0.114309)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.093750, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
