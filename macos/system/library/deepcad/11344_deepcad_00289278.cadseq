# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00289278" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.252632)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.378947, 0.000000).circle(0.378947)
loop3=wp_sketch1.moveTo(0.378947, 0.000000).circle(0.252632)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.398438)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.378947, 0.000000).circle(0.378947)
loop3=wp_sketch1.moveTo(0.378947, 0.000000).circle(0.252632)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.148438)
solid_temp=solid_temp.union(solid1)
solid=solid.union(solid_temp)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.453947, 0.000000).circle(0.453947)
loop5=wp_sketch2.moveTo(0.453947, 0.000000).circle(0.245888)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.500000)
solid_temp=solid2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.453947, 0.000000).circle(0.453947)
loop5=wp_sketch2.moveTo(0.453947, 0.000000).circle(0.245888)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(-0.398438)
solid_temp=solid_temp.union(solid2)
solid=solid.union(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
