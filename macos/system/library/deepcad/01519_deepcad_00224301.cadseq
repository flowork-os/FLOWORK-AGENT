loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000723, -0.001745), (0.002467, -0.002467)).lineTo(0.036595, -0.002467).threePointArc((0.038340, -0.001745), (0.039062, 0.000000)).lineTo(0.039062, 0.034539).threePointArc((0.038255, 0.036078), (0.036595, 0.036595)).lineTo(0.002467, 0.036595).threePointArc((0.000808, 0.036078), (0.000000, 0.034539)).lineTo(0.000000, 0.000000).close()
