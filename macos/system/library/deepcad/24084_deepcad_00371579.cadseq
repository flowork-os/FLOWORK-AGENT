# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00371579" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.046875, 0.000000, -0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.377467, 0.000000).threePointArc((0.706826, 0.329359), (0.377467, 0.658717)).lineTo(0.000000, 0.658717).threePointArc((-0.329359, 0.329359), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.577303, 0.325658).circle(0.044408)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
