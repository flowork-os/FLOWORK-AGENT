# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00371410" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.500000, 0.000000, -0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.236842, 0.000000).threePointArc((-1.320355, 0.105263), (0.236842, 0.210526)).lineTo(0.000000, 0.210526).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(-0.881579, -0.223684).circle(0.105263)
loop2=wp_sketch0.moveTo(-0.828947, 0.486842).circle(0.105263)
loop3=wp_sketch0.moveTo(-0.500000, 0.105263).circle(0.157895)
loop4=wp_sketch0.moveTo(-0.171053, -0.276316).circle(0.105263)
loop5=wp_sketch0.moveTo(-0.118421, 0.434211).circle(0.105263)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.375000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
