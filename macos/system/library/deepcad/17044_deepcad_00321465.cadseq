# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00321465" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.048355, -0.120888).lineTo(0.072533, -0.120888).lineTo(0.169243, 0.265954).threePointArc((0.342225, 0.577917), (0.676974, 0.701151)).lineTo(0.676974, 0.765625).threePointArc((0.299503, 0.626166), (0.104770, 0.274013)).lineTo(0.040296, 0.016118).lineTo(0.008059, 0.024178).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.242188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.687500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.338161, -0.122341), (0.514309, -0.435855)).lineTo(0.610197, -0.828125).lineTo(0.627632, -0.819408).lineTo(0.679934, -0.706086).lineTo(0.671217, -0.679934).lineTo(0.636349, -0.688651).lineTo(0.575329, -0.427138).threePointArc((0.378391, -0.076131), (0.000000, 0.061020)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.242188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
