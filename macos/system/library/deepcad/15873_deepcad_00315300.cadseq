solid2=wp_sketch2.add(loop2).extrude(0.445312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, -0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.034539).threePointArc((-0.092756, 0.017270), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(0.445312)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, -0.320312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.205674, 0.000000).lineTo(0.205674, 0.043832).threePointArc((0.115127, 0.060691), (0.205674, 0.077549)).lineTo(0.205674, 0.320312).lineTo(0.000000, 0.320312).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch4.moveTo(0.037089, 0.195559).circle(0.030345)
