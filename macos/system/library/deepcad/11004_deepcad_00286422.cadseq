# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00286422" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.738158, 0.000000).circle(0.738158)
loop1=wp_sketch0.moveTo(0.307566, 0.000000).circle(0.138405)
loop2=wp_sketch0.moveTo(0.738158, -0.399836).circle(0.138405)
loop3=wp_sketch0.moveTo(0.738158, 0.384457).circle(0.138405)
loop4=wp_sketch0.moveTo(1.107237, 0.000000).circle(0.138405)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.217105, 0.000000).circle(0.217105)
solid1=wp_sketch1.add(loop5).extrude(0.601562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.157895, 0.000000).circle(0.157895)
loop7=wp_sketch2.moveTo(0.157895, 0.000000).circle(0.105263)
solid2=wp_sketch2.add(loop6).add(loop7).extrude(0.750000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch3.moveTo(0.110526, 0.000000).circle(0.110526)
solid3=wp_sketch3.add(loop8).extrude(0.734375)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
