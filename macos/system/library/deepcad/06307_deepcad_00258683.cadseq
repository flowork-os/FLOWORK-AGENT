# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00258683" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.013816, 0.013816).threePointArc((0.120296, 0.223711), (0.193421, 0.000000)).lineTo(0.207237, -0.013816).threePointArc((0.258529, 0.104420), (0.196875, 0.217599)).lineTo(0.196875, 0.328125).lineTo(0.031086, 0.328125).lineTo(0.031086, 0.221053).threePointArc((-0.035082, 0.117645), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.110526, 0.269408).circle(0.020724)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
