import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.020695, -0.030902), (0.015789, -0.023684)).lineTo(0.378947, -0.102632).lineTo(0.450000, -0.102632).lineTo(0.742105, -0.102632).lineTo(0.750000, -0.102632).lineTo(0.742105, -0.094737).lineTo(0.450000, -0.094737).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, -0.015789).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.445312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
