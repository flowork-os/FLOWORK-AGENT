# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00228872" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.600000)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.611842, 0.000000).circle(0.611842)
loop3=wp_sketch1.moveTo(0.611842, 0.000000).circle(0.114720)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.312500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.000000, 0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.088076, -0.176151).lineTo(0.289391, -0.188734).lineTo(0.398438, -0.020970).lineTo(0.310362, 0.155181).lineTo(0.109046, 0.167763).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.201316, -0.012582).circle(0.109046)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.148438)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
