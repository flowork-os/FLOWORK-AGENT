# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00353953" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.250000, 0.000000, -0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.499342, 0.000000).lineTo(0.499342, 0.687500).lineTo(0.000000, 0.687500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.448684, 0.376316).lineTo(0.448684, 0.586184).lineTo(0.057895, 0.586184).lineTo(0.057895, 0.376316).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
