import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.378947, -0.647368).lineTo(1.121053, -0.647368).lineTo(1.500000, 0.000000).lineTo(1.121053, 0.647368).lineTo(0.378947, 0.647368).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.648438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.164062, 0.648438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.360937, 0.000000).lineTo(0.360937, -0.360937).lineTo(0.678125, -0.360937).lineTo(0.678125, 0.000000).lineTo(1.039062, 0.000000).lineTo(1.039062, 0.328125).lineTo(0.678125, 0.328125).lineTo(0.678125, 0.678125).lineTo(0.360937, 0.678125).lineTo(0.360937, 0.328125).lineTo(0.000000, 0.328125).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.062500)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.023438, 0.585938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.009570, -0.070826), (0.038487, -0.136184)).lineTo(0.130263, -0.281250).lineTo(0.219079, -0.136184).threePointArc((0.247996, -0.070826), (0.257566, 0.000000)).lineTo(0.257566, 0.029605).threePointArc((0.128783, 0.158388), (0.000000, 0.029605)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.132812)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
