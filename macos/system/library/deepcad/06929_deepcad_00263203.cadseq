# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00263203" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.134211, 0.000000).circle(0.134211)
loop1=wp_sketch0.moveTo(0.134211, 0.000000).circle(0.030757)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.031579, 0.000000).circle(0.031579)
solid1=wp_sketch1.add(loop2).extrude(0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.134211, 0.000000).circle(0.134211)
loop4=wp_sketch2.moveTo(0.134211, 0.000000).circle(0.030757)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.664062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, 0.664062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.035526, 0.000000).circle(0.035526)
loop6=wp_sketch3.moveTo(0.035526, 0.000000).circle(0.028125)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(0.085938)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
