# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00247039" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, -0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.234375, 0.000000).lineTo(1.234375, 1.234375).lineTo(0.922533, 1.234375).lineTo(0.922533, 0.766612).lineTo(0.311842, 0.766612).lineTo(0.311842, 1.234375).lineTo(0.000000, 1.234375).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.617188, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
