wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.109375, 0.000000).lineTo(1.109375, 0.443750).lineTo(0.000000, 0.443750).lineTo(0.000000, 0.000000).close()
