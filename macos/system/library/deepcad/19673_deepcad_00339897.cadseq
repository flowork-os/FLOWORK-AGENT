# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.265625, 0.257812, 0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch3.moveTo(0.037747, 0.000000).lineTo(0.398438, 0.146793).lineTo(0.394243, 0.159375).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop7).extrude(0.164062)
solid=solid.union(solid3)

