solid1=wp_sketch1.add(loop5).extrude(0.164062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.218750, 0.046875, 0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.359375, 0.000000).lineTo(0.359375, 0.192928).lineTo(0.037829, 0.192928).lineTo(0.000000, 0.192928).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(0.164062)
