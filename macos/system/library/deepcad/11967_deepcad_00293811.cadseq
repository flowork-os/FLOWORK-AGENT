# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00293811" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.053454, -0.168586).lineTo(0.213816, -0.230263).lineTo(0.365954, -0.143914).lineTo(0.390625, 0.028783).lineTo(0.271382, 0.156250).lineTo(0.098684, 0.143914).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
