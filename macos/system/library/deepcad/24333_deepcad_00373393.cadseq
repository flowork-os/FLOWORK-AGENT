import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.287500, 0.000000).lineTo(0.279934, -0.643092).lineTo(0.431250, -0.643092).lineTo(0.431250, 0.000000).lineTo(0.718750, 0.000000).lineTo(0.718750, 0.158882).lineTo(0.431250, 0.158882).lineTo(0.431250, 0.416118).lineTo(0.287500, 0.416118).lineTo(0.287500, 0.158882).lineTo(0.000000, 0.166447).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.289062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
