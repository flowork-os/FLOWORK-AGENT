# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00289506" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.386842, 0.000000).lineTo(0.386842, -0.102632).lineTo(0.228947, -0.102632).lineTo(0.126316, -0.157895).lineTo(0.750000, -0.157895).lineTo(0.750000, 0.157895).lineTo(0.592105, 0.260526).lineTo(0.386842, 0.260526).lineTo(0.000000, 0.102632).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.544737, 0.055263).circle(0.102632)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
