# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00249243" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.481579, 0.000000).circle(0.471546)
loop1=wp_sketch0.moveTo(0.481579, -0.381250).circle(0.100329)
loop2=wp_sketch0.moveTo(0.481579, 0.381250).circle(0.100329)
loop3=wp_sketch0.moveTo(0.481579, 0.000000).circle(0.040132)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.757895)
loop5=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.473684)
solid1=wp_sketch1.add(loop4).add(loop5).extrude(0.171875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
