# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267466" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.115214, 0.000000).lineTo(1.115214, 1.492188).lineTo(0.000000, 1.492188).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.518339, 0.157072).lineTo(0.518339, 0.612582).lineTo(0.141365, 0.612582).lineTo(0.141365, 0.157072).close()
loop2=wp_sketch0.moveTo(0.518339, 0.785362).lineTo(0.518339, 1.240872).lineTo(0.141365, 1.240872).lineTo(0.141365, 0.785362).close()
loop3=wp_sketch0.moveTo(0.989556, 0.157072).lineTo(0.989556, 0.612582).lineTo(0.612582, 0.612582).lineTo(0.612582, 0.157072).close()
loop4=wp_sketch0.moveTo(0.989556, 0.785362).lineTo(0.989556, 1.240872).lineTo(0.612582, 1.240872).lineTo(0.612582, 0.785362).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(-0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(1.121053, 0.000000).lineTo(1.121053, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.093750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
