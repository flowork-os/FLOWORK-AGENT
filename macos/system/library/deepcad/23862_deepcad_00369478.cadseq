wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.315461, -0.180263).lineTo(0.506990, -0.506990).threePointArc((0.529523, -0.519938), (0.552056, -0.506990)).lineTo(0.732319, -0.180263).lineTo(1.059046, 0.000000).threePointArc((1.072740, 0.022533), (1.059046, 0.045066)).lineTo(0.732319, 0.191530).lineTo(0.552056, 0.518257).threePointArc((0.529523, 0.531205), (0.506990, 0.518257)).lineTo(0.315461, 0.191530).lineTo(0.000000, 0.045066).threePointArc((-0.013694, 0.022533), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0

