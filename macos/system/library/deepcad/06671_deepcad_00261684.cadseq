# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.153119, -0.369661), (0.522780, -0.522780)).lineTo(1.099178, -0.522780).threePointArc((1.222398, -0.471740), (1.273438, -0.348520)).lineTo(1.273438, 0.375329).threePointArc((1.222398, 0.498549), (1.099178, 0.549589)).lineTo(0.174260, 0.549589).threePointArc((0.051040, 0.498549), (0.000000, 0.375329)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.174260, 0.375329).circle(0.053618)
loop2=wp_sketch0.moveTo(0.522780, 0.000000).circle(0.388734)
loop3=wp_sketch0.moveTo(1.099178, 0.375329).circle(0.053618)
loop4=wp_sketch0.moveTo(1.099178, -0.348520).circle(0.053618)
