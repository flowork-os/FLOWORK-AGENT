# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.189474, 0.000000).lineTo(0.189474, 0.094737).lineTo(0.189474, 0.189474).lineTo(0.189474, 0.375000).lineTo(0.000000, 0.375000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.664062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.570312, 0.000000).lineTo(0.570312, 0.096053).lineTo(0.000000, 0.096053).lineTo(0.000000, 0.000000).close()
