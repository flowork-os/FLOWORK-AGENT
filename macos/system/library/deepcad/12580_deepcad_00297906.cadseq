# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.382812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.193668, 0.000000).lineTo(0.193668, -0.284046).lineTo(0.193668, -0.477714).lineTo(0.748849, -0.477714).lineTo(0.748849, -0.568092).lineTo(0.193668, -0.568092).lineTo(0.193668, -0.658470).lineTo(1.226562, -0.658470).lineTo(1.226562, -0.284046).lineTo(0.477714, 0.090378).lineTo(0.000000, 0.090378).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.942516, -0.374424).circle(0.129112)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.186513, 0.000000).lineTo(0.186513, 0.281250).lineTo(0.000000, 0.281250).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.664062)
