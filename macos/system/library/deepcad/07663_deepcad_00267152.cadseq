import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.468750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.063934, -0.398619), (0.327632, -0.300329)).threePointArc((0.363754, -0.240892), (0.423191, -0.204770)).threePointArc((0.682566, -0.167920), (0.941941, -0.204770)).threePointArc((0.991303, -0.237316), (1.023849, -0.286678)).threePointArc((1.248681, -0.322313), (1.228618, -0.095559)).threePointArc((0.628165, 0.130367), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.095559, -0.218421).circle(0.122862)
loop2=wp_sketch0.moveTo(1.146711, -0.218421).circle(0.068257)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.242188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
