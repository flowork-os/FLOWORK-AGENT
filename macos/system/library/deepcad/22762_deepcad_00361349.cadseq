loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.423684, 0.033868), (0.847368, 0.000000)).lineTo(0.786842, 0.332895).lineTo(0.423684, 0.332895).lineTo(0.423684, 0.620395).lineTo(0.741447, 0.620395).lineTo(0.817105, 0.892763).lineTo(0.408553, 0.892763).lineTo(0.408553, 1.165132).lineTo(0.832237, 1.165132).lineTo(0.938158, 1.437500).threePointArc((0.506908, 1.381622), (0.075658, 1.437500)).threePointArc((0.090847, 0.715960), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.304688)
