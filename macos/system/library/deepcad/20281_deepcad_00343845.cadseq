# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00343845" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.026645).threePointArc((0.120091, -0.125050), (0.005921, -0.281250)).lineTo(0.005921, -0.254605).threePointArc((-0.173164, -0.131399), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.071053, -0.153947).lineTo(0.071053, -0.103618).lineTo(-0.145066, -0.103618).lineTo(-0.145066, -0.153947).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.027385).threePointArc((-0.200915, -0.131795), (0.006086, -0.282977)).lineTo(0.006086, -0.255592).threePointArc((-0.173764, -0.132006), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.703125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
