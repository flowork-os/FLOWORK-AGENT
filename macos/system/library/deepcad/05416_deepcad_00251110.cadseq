# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.075987, 0.000000).threePointArc((0.078500, 0.024041), (0.085938, 0.047039)).lineTo(0.016283, 0.077796).threePointArc((0.004069, 0.039750), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.109375)
solid=solid0
# workplane for sketch 1
