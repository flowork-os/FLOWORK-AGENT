loop3=wp_sketch2.moveTo(0.209868, 0.123026).circle(0.050658)
loop4=wp_sketch2.moveTo(0.390789, -0.036184).circle(0.050658)
loop5=wp_sketch2.moveTo(0.455921, 0.282237).circle(0.050658)
