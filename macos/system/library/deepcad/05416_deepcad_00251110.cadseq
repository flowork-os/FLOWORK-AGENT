# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, 0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
