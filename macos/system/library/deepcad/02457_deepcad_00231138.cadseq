# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231138" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.414062, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.321793, 0.000000).threePointArc((0.334223, 0.100781), (0.321793, 0.201563)).lineTo(0.000000, 0.201563).threePointArc((0.053076, 0.100781), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.222780, 0.099013).circle(0.038898)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.320312, 0.000000).threePointArc((0.267929, 0.099465), (0.320312, 0.198931)).lineTo(0.000000, 0.198931).threePointArc((-0.012268, 0.099465), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.101151, 0.097780).circle(0.040461)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.281250, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.138980, 0.000000).threePointArc((0.192468, 0.101562), (0.138980, 0.203125)).lineTo(0.000000, 0.203125).threePointArc((-0.053488, 0.101562), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.006414, 0.085526).threePointArc((0.130177, 0.101562), (0.006414, 0.117599)).lineTo(-0.012829, 0.117599).lineTo(-0.012829, 0.085526).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.164062, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
