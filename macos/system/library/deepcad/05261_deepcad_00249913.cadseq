# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00249913" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.461842, 0.000000).circle(0.452220)
loop1=wp_sketch0.moveTo(0.461842, 0.000000).circle(0.211678)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.414062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.209211, 0.000000).circle(0.209211)
solid1=wp_sketch1.add(loop2).extrude(-0.414062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.209211, 0.000000).circle(0.209211)
solid2=wp_sketch2.add(loop3).extrude(-0.335938)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.242188, 0.414062, -0.140625), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.244737, -0.137664).lineTo(0.484375, 0.000000).lineTo(0.484375, 0.280428).lineTo(0.244737, 0.418092).lineTo(0.000000, 0.280428).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.335938)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.085938, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.082895, 0.000000).circle(0.082895)
solid4=wp_sketch4.add(loop5).extrude(-1.000000, both=True)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
