# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00229912" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.303947, 0.000000).circle(0.303947)
loop1=wp_sketch0.moveTo(0.303947, 0.000000).circle(0.170970)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.645395, -0.233059).threePointArc((0.786245, -0.215638), (0.851562, -0.089638)).lineTo(0.851562, 0.645395).lineTo(0.851562, 0.672286).threePointArc((0.779582, 0.786131), (0.645395, 0.797780)).lineTo(0.000000, 0.564720).threePointArc((0.400921, 0.282360), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.699178, -0.089638).circle(0.071711)
loop4=wp_sketch1.moveTo(0.699178, 0.654359).circle(0.071711)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).extrude(0.132812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch2.moveTo(0.303947, 0.000000).circle(0.303947)
loop6=wp_sketch2.moveTo(0.303947, 0.000000).circle(0.170970)
solid2=wp_sketch2.add(loop5).add(loop6).extrude(0.484375)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
