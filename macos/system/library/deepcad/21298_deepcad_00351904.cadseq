# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00351904" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.734375, 0.000000, 0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.007895, 0.000000).circle(0.007730)
solid0=wp_sketch0.add(loop0).extrude(0.390625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.664062, 0.000000).lineTo(0.742188, 0.000000).threePointArc((0.732177, 0.007812), (0.742188, 0.015625)).lineTo(0.171875, 0.312500).lineTo(0.140625, 0.312500).lineTo(0.101562, 0.351562).lineTo(0.101562, 0.328125).lineTo(0.078125, 0.359375).lineTo(0.000000, 0.398438).lineTo(0.000000, 0.250000).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.046875, 0.031250).circle(0.023438)
loop3=wp_sketch1.moveTo(0.664062, 0.023438).circle(0.023438)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.390625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.000000, 0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.019737, 0.000000).circle(0.019737)
solid2=wp_sketch2.add(loop4).extrude(0.390625)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.640625, 0.000000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.023684, 0.000000).circle(0.023191)
solid3=wp_sketch3.add(loop5).extrude(0.390625)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
