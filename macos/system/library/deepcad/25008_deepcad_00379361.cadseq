# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00379361" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.640625, -0.140625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.390625, 0.000000).lineTo(1.390625, 0.761184).lineTo(0.000000, 0.761184).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.214967, 0.175658).lineTo(1.214967, 0.585526).lineTo(0.175658, 0.585526).lineTo(0.175658, 0.175658).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.250000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
