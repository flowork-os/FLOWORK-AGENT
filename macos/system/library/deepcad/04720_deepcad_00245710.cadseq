import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, 0.343750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.273438, 0.000000).lineTo(0.273438, 0.273438).lineTo(0.000000, 0.273438).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.000000, -0.523438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.136924, -0.228207).lineTo(0.684622, -0.228207).lineTo(0.821546, 0.000000).lineTo(0.821546, 0.730263).lineTo(0.730263, 0.867188).lineTo(0.547697, 0.867188).lineTo(0.273849, 0.867188).lineTo(0.091283, 0.867188).lineTo(0.000000, 0.730263).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.562500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.005921, 0.000000).lineTo(0.005921, 0.040954).lineTo(0.040954, 0.040954).lineTo(0.040954, 0.000000).lineTo(0.046875, 0.000000).lineTo(0.046875, 0.046875).lineTo(0.000000, 0.046875).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.093750)
solid_temp=solid2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.562500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.005921, 0.000000).lineTo(0.005921, 0.040954).lineTo(0.040954, 0.040954).lineTo(0.040954, 0.000000).lineTo(0.046875, 0.000000).lineTo(0.046875, 0.046875).lineTo(0.000000, 0.046875).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.093750)
solid_temp=solid_temp.union(solid2)
solid=solid.union(solid_temp)

