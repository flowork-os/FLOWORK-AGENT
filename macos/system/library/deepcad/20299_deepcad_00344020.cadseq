loop4=wp_sketch1.moveTo(0.126316, 0.031579).threePointArc((0.750000, -0.592105), (1.373684, 0.031579)).lineTo(1.373684, 0.110526).threePointArc((1.350000, 0.134211), (1.326316, 0.110526)).lineTo(1.326316, 0.031579).close()
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).extrude(-0.570312)
solid_temp=solid_temp.union(solid1)
