wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, -0.601562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.037993, -0.037993), (0.075987, 0.000000)).threePointArc((0.053824, 0.022163), (0.075987, 0.044326)).lineTo(0.075987, 0.601562).lineTo(0.000000, 0.601562).lineTo(0.000000, 0.044326).threePointArc((0.022163, 0.022163), (0.000000, 0.000000)).close()
