wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.157895).lineTo(0.000000, 0.157895).lineTo(0.000000, 0.000000).close()
