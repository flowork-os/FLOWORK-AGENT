# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, -0.750000, 0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.476562, 0.000000).lineTo(0.476562, 0.170559).lineTo(0.000000, 0.170559).lineTo(0.000000, 0.000000).close()
