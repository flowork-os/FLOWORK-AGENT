import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, -0.265625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.030757, 0.000000).lineTo(0.123026, 0.000000).lineTo(0.123026, -0.246053).lineTo(1.337911, -0.246053).lineTo(1.337911, 0.000000).lineTo(1.460938, 0.000000).lineTo(1.460938, 0.492105).lineTo(0.000000, 0.492105).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
