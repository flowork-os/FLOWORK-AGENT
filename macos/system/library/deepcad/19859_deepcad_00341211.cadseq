# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.640625, 0.062500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.148438, 0.000000).lineTo(0.148438, 0.032813).threePointArc((0.146094, 0.032827), (0.143750, 0.032813)).lineTo(0.000000, 0.032813).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.062500)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.593750, 0.062500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.148438, 0.000000).lineTo(0.148438, 0.042188).lineTo(0.142187, 0.042188).lineTo(0.000000, 0.042188).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.250000)
