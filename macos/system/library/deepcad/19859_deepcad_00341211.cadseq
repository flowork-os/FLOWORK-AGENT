loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.003909, -0.000387), (0.007812, -0.000822)).lineTo(0.007812, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.062500)
