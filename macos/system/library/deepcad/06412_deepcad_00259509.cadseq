# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.640625, -0.539062, -0.710938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.282895, 0.000000).lineTo(0.282895, 1.343750).lineTo(0.000000, 1.343750).lineTo(0.000000, 1.103289).threePointArc((0.107645, 0.714309), (0.000000, 0.325329)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(-0.539062)
