# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.640625, -0.539062, -0.382812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch5.moveTo(0.000000, 0.000000).threePointArc((0.107019, 0.386719), (0.000000, 0.773437)).lineTo(0.000000, 0.000000).close()
