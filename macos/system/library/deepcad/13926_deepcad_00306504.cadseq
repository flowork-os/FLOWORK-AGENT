# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306504" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.539062, 0.000000).lineTo(0.539062, 0.209951).lineTo(0.436924, 0.209951).lineTo(0.000000, 0.209951).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.335938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.437500, 0.000000, 0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.102138, 0.000000).lineTo(0.102138, -0.209951).lineTo(0.226974, -0.209951).lineTo(0.226974, 0.493668).threePointArc((0.113487, 0.538246), (0.000000, 0.493668)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.113487, 0.374507).circle(0.085115)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.335938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.228947, 0.000000).lineTo(0.228947, 0.213158).lineTo(0.228947, 0.702632).threePointArc((0.114474, 0.747598), (0.000000, 0.702632)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.110526, 0.584211).circle(0.086842)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.335938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
