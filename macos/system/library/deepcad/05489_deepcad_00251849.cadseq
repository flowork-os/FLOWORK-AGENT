# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00251849" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.666118, 0.000000).lineTo(0.666118, 0.838816).threePointArc((0.333059, 1.171875), (0.000000, 0.838816)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.333059, 0.838816).circle(0.172697)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.296875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
