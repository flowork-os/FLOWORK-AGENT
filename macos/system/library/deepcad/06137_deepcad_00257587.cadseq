import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.125000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.289062, 0.000000).lineTo(1.289062, 0.217105).threePointArc((1.213888, 0.382151), (1.044819, 0.447780)).lineTo(0.922697, 0.447780).lineTo(0.922697, 0.312089).lineTo(1.044819, 0.312089).threePointArc((1.094120, 0.270671), (1.058388, 0.217105)).lineTo(1.004112, 0.217105).lineTo(0.000000, 0.217105).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.203125, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, -0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.513158, -0.032072).lineTo(0.609375, 0.468257).lineTo(0.506743, 0.493914).threePointArc((0.436055, 0.460628), (0.416941, 0.384868)).lineTo(0.416941, 0.115461).lineTo(0.179605, 0.115461).lineTo(0.179605, 0.384868).threePointArc((0.160491, 0.460628), (0.089803, 0.493914)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.835938, both=True)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.059211, 0.000000).circle(0.059211)
solid2=wp_sketch2.add(loop2).extrude(-1.000000, both=True)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.515625, -0.125000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch3.moveTo(0.196135, 0.000000).lineTo(0.196135, 1.242188).lineTo(0.000000, 1.242188).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.187500)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
