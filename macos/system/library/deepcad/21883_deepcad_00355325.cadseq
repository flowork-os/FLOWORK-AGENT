# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00355325" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.320312, 0.000000).lineTo(0.320312, 0.320312).lineTo(0.000000, 0.320312).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.161842, 0.161842).circle(0.053947)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.210938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.320312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.266859, 0.000000).threePointArc((0.427426, 0.160567), (0.266859, 0.321135)).lineTo(0.000000, 0.321135).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.140214, 0.076891).circle(0.027138)
loop4=wp_sketch1.moveTo(0.140214, 0.248766).circle(0.027138)
loop5=wp_sketch1.moveTo(0.266859, 0.076891).circle(0.027138)
loop6=wp_sketch1.moveTo(0.266859, 0.248766).circle(0.027138)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).extrude(0.210938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
