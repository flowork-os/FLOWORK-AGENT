# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00255975" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.126398, -0.034868).lineTo(0.235362, -0.034868).lineTo(0.361760, 0.000000).threePointArc((0.414819, 0.069737), (0.361760, 0.139474)).lineTo(0.235362, 0.174342).lineTo(0.126398, 0.174342).lineTo(0.000000, 0.139474).threePointArc((-0.053059, 0.069737), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.017434, 0.069737).circle(0.030510)
loop2=wp_sketch0.moveTo(0.344326, 0.069737).circle(0.030510)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, -0.039062), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch1.moveTo(0.098684, 0.000000).circle(0.096628)
solid1=wp_sketch1.add(loop3).extrude(0.140625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
