# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288918" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.484375, 0.000000).lineTo(1.484375, 0.500000).lineTo(1.343750, 0.500000).threePointArc((1.200952, 0.283423), (0.984375, 0.140625)).lineTo(0.984375, 0.046875).lineTo(0.500000, 0.046875).lineTo(0.500000, 0.140625).threePointArc((0.283423, 0.283423), (0.140625, 0.500000)).lineTo(0.000000, 0.500000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
