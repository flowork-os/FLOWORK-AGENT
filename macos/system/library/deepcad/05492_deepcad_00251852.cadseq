# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00251852" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, -0.382812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.727385, 0.000000).lineTo(0.727385, 0.739309).threePointArc((0.363692, 1.140582), (0.000000, 0.739309)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.357730, 0.775082).circle(0.166941)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.390625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
