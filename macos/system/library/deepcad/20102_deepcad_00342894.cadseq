# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00342894" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.056250, 0.000000).lineTo(0.056250, -0.075000).lineTo(0.165625, -0.075000).lineTo(0.165625, 0.000000).lineTo(0.221875, 0.000000).lineTo(0.221875, 0.296875).lineTo(0.000000, 0.296875).lineTo(0.000000, 0.150000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.112500, 0.150000).circle(0.056250)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.617188, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.055263, 0.000000).circle(0.054112)
solid1=wp_sketch1.add(loop2).extrude(-0.765625)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.242188, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.055263, 0.000000).circle(0.055263)
solid2=wp_sketch2.add(loop3).extrude(-0.617188)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
