# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, 0.398438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.266597, -0.471464), (0.522286, 0.006003)).lineTo(0.402220, 0.258141).lineTo(0.336184, 0.210115).lineTo(0.450247, -0.042023).threePointArc((0.253237, -0.374145), (0.078043, -0.030016)).lineTo(0.180099, 0.222122).lineTo(0.096053, 0.258141).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.036020, 0.000000).circle(0.024013)
loop2=wp_sketch0.moveTo(0.102056, 0.132072).circle(0.024013)
loop3=wp_sketch0.moveTo(0.426234, 0.132072).circle(0.024013)
loop4=wp_sketch0.moveTo(0.474260, 0.000000).circle(0.024013)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.085938)
