# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232166" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.515132, 0.000000).lineTo(0.515132, 0.094737).lineTo(0.278289, 0.094737).lineTo(0.278289, 0.420395).threePointArc((0.074501, 0.546721), (0.053289, 0.307895)).lineTo(0.053289, 0.047368).lineTo(0.000000, 0.047368).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.136184, 0.420395).circle(0.065132)
loop2=wp_sketch0.moveTo(0.165789, 0.094737).circle(0.035526)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.234375, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
