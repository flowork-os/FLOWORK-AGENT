import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-1.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.006579, 0.000000).lineTo(1.992188, 0.000000).lineTo(1.992188, 0.167763).lineTo(1.153372, 0.167763).threePointArc((0.996094, 0.010485), (0.838816, 0.167763)).lineTo(0.000000, 0.167763).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.210938, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-1.000000, 0.000000, 0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.838816, 0.000000).threePointArc((0.996094, 0.157278), (1.153372, 0.000000)).lineTo(1.992188, 0.000000).lineTo(1.992188, 0.083882).lineTo(1.258224, 0.083882).threePointArc((0.996094, 0.275809), (0.733964, 0.083882)).lineTo(0.000000, 0.083882).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.234375, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(1.209293, 0.000000).threePointArc((1.351562, 0.142270), (1.209293, 0.284539)).lineTo(0.000000, 0.284539).threePointArc((-0.142270, 0.142270), (0.000000, 0.000000)).close()
loop3=wp_sketch2.moveTo(0.000000, 0.142270).circle(0.056908)
loop4=wp_sketch2.moveTo(1.209293, 0.142270).circle(0.056908)
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).extrude(0.671875)
solid=solid.intersect(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, 0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.167969, -0.167969), (0.335938, 0.000000)).lineTo(0.286431, 0.000000).threePointArc((0.167969, -0.118462), (0.049507, 0.000000)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.195312, both=True)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, 0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.049507, 0.000000).threePointArc((0.167969, 0.118462), (0.286431, 0.000000)).lineTo(0.335938, 0.000000).threePointArc((0.167969, 0.167969), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop6).extrude(0.195312, both=True)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
