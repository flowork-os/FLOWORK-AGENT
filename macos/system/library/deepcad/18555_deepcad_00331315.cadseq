# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.070312, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch2.moveTo(0.021875, 0.010938).threePointArc((0.007665, 0.074219), (0.021875, 0.137500)).lineTo(0.000000, 0.148438).threePointArc((-0.016666, 0.074219), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop4).extrude(0.750000)
