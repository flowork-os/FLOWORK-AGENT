# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.070312, -0.750000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop5=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.330694, 0.074260), (0.000000, 0.148520)).lineTo(0.021217, 0.137911).threePointArc((0.304669, 0.074260), (0.021217, 0.010609)).lineTo(0.000000, 0.000000).close()
