wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, -0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000289, -0.000698), (0.000987, -0.000987)).lineTo(0.030263, -0.000987).threePointArc((0.030961, -0.000698), (0.031250, 0.000000)).lineTo(0.031250, 0.011184).threePointArc((0.030961, 0.011882), (0.030263, 0.012171)).lineTo(0.000987, 0.012171).threePointArc((0.000289, 0.011882), (0.000000, 0.011184)).lineTo(0.000000, 0.000000).close()
