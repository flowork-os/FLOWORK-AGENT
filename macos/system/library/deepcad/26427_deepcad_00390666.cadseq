# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00390666" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.484375, -0.417825), (0.968750, 0.000000)).threePointArc((0.934989, 0.071382), (0.968750, 0.142763)).threePointArc((0.484375, 0.560588), (0.000000, 0.142763)).threePointArc((0.033761, 0.071382), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.489474, 0.071382).circle(0.183553)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.643421, 0.000000).circle(0.643421)
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.009573, 0.203561), (0.160855, 0.067023)).threePointArc((0.636719, 0.477506), (1.112582, 0.067023)).threePointArc((1.254291, -0.000000), (1.112582, -0.067023)).threePointArc((0.636719, -0.477506), (0.160855, -0.067023)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.273438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.757895, 0.000000).circle(0.757895)
loop5=wp_sketch2.moveTo(0.757895, 0.000000).circle(0.631579)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.601562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
