wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.015543, 0.000000).lineTo(0.015543, 0.202056).threePointArc((0.023314, 0.198837), (0.031086, 0.202056)).lineTo(1.445477, 0.202056).threePointArc((1.453248, 0.198837), (1.461020, 0.202056)).lineTo(1.461020, 0.000000).lineTo(1.476562, 0.000000).lineTo(1.476562, 0.217599).lineTo(0.000000, 0.217599).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0

if __name__ == '__main__':
    import sys
