import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, 0.000000, -0.320312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.210938, 0.000000).lineTo(1.210938, 0.522615).lineTo(0.866776, 0.522615).lineTo(0.866776, 0.866776).lineTo(0.344161, 0.866776).lineTo(0.344161, 0.522615).lineTo(0.000000, 0.522615).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.515625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
