import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.165789, 0.000000).lineTo(0.165789, 0.157895).lineTo(0.686842, 0.157895).lineTo(0.686842, 0.071053).lineTo(0.750000, 0.071053).lineTo(0.750000, 0.307895).lineTo(0.663158, 0.307895).lineTo(0.663158, 0.528947).lineTo(0.142105, 0.528947).lineTo(0.142105, 0.339474).lineTo(0.000000, 0.339474).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.296875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
