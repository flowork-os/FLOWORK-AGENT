# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00221849" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, 0.000000, -0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.031250, 0.000000).lineTo(1.031250, 0.966118).lineTo(0.000000, 0.966118).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.320312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.225000, 0.000000).circle(0.225000)
loop2=wp_sketch1.moveTo(0.225000, 0.000000).circle(0.178125)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.225000, 0.000000).circle(0.225000)
loop4=wp_sketch2.moveTo(0.225000, 0.000000).circle(0.178125)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.007812)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
