import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, -0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.988898, 0.000000).lineTo(1.445312, -0.060855).lineTo(1.445312, 0.258635).lineTo(0.745477, 0.258635).lineTo(0.745477, 0.517270).lineTo(0.608553, 0.836760).lineTo(0.608553, 1.034539).lineTo(0.258635, 1.034539).lineTo(0.258635, 0.806332).lineTo(0.000000, 0.608553).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.164062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
