# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00289006" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.276316, 0.000000).circle(0.276316)
loop1=wp_sketch0.moveTo(0.276316, 0.000000).circle(0.155428)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.445312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.468750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.243997, -0.572862).threePointArc((0.493298, -0.194755), (0.742599, -0.572862)).lineTo(0.986595, 0.000000).threePointArc((0.972973, 0.191414), (0.806250, 0.286431)).lineTo(0.190954, 0.286431).threePointArc((0.018927, 0.194249), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.190954, 0.084868).circle(0.063651)
loop4=wp_sketch1.moveTo(0.806250, 0.084868).circle(0.063651)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).extrude(0.117188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.242188, 0.117188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.034539, 0.000000).lineTo(0.034539, 0.253289).lineTo(0.000000, 0.273438).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop5).extrude(0.031250, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.273438, 0.117188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.445312, 0.000000).lineTo(0.000000, 0.257812).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop6).extrude(0.031250, both=True)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
