# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00356238" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, -0.351562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.394243, -0.394243).lineTo(1.101562, -0.394243).lineTo(1.101562, 0.301480).lineTo(0.278289, 0.301480).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.324671, 0.011595).circle(0.115954)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.234375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
