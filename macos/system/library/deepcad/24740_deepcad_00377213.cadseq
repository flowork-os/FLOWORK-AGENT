import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.753865, 0.000000).threePointArc((0.804688, 0.050822), (0.753865, 0.101645)).lineTo(0.000000, 0.101645).lineTo(0.753865, 0.101645).threePointArc((0.800452, 0.055058), (0.753865, 0.008470)).lineTo(0.000000, 0.008470).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
