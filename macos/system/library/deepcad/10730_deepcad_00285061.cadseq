# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285061" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, -0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.037007, 0.004112).threePointArc((0.193921, 0.195312), (0.037007, 0.386513)).lineTo(0.000000, 0.390625).threePointArc((-0.195312, 0.195312), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.197368).circle(0.148026)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.296875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.554688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.098684, 0.000000).circle(0.096628)
loop3=wp_sketch1.moveTo(0.098684, 0.000000).circle(0.049342)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.242188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.000000, 0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.155160, -0.189062), (0.000000, -0.378125)).lineTo(0.935362, -0.288569).threePointArc((0.835822, -0.183837), (0.945312, -0.089556)).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.646793, -0.238816).threePointArc((0.696546, -0.189062), (0.646793, -0.139309)).lineTo(0.258717, -0.139309).threePointArc((0.208964, -0.189062), (0.258717, -0.238816)).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.195312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
