# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00269305" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, -0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.381908, 0.000000).lineTo(0.381908, 0.421875).lineTo(0.000000, 0.421875).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.075493, 0.075493).circle(0.039967)
loop2=wp_sketch0.moveTo(0.075493, 0.266447).circle(0.039967)
loop3=wp_sketch0.moveTo(0.306414, 0.075493).circle(0.039967)
loop4=wp_sketch0.moveTo(0.306414, 0.266447).circle(0.039967)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, -0.078125, 0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.382813, 0.000000).lineTo(0.382813, 0.076563).lineTo(0.000000, 0.076563).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.671875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
