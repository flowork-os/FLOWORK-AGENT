# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239402" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.004248, 0.051454), (0.006003, 0.102056)).threePointArc((-0.589555, 0.085884), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.008115, 0.050459), (0.007484, 0.101562)).threePointArc((-0.003473, 0.051313), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.148438, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.363245, 0.024442), (0.007566, 0.102138)).threePointArc((0.008181, 0.050743), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.062500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
