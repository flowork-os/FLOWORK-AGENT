# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.453125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.036804, -0.088854), (0.125658, -0.125658)).lineTo(1.366530, -0.125658).threePointArc((1.455383, -0.088854), (1.492188, 0.000000)).lineTo(1.492188, 0.863898).threePointArc((1.455383, 0.952752), (1.366530, 0.989556)).lineTo(0.125658, 0.989556).threePointArc((0.036804, 0.952752), (0.000000, 0.863898)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.251316, 0.078536).circle(0.015707)
loop2=wp_sketch0.moveTo(0.251316, 0.801069).circle(0.015707)
loop3=wp_sketch0.moveTo(0.753947, 0.439803).circle(0.015707)
loop4=wp_sketch0.moveTo(1.240872, 0.078536).circle(0.015707)
loop5=wp_sketch0.moveTo(1.240872, 0.801069).circle(0.015707)
