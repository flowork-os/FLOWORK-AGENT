# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00342876" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.124846, -0.157967), (0.282812, -0.282812)).lineTo(0.327467, -0.282812).lineTo(0.461431, -0.133964).threePointArc((1.205868, 0.923055), (0.148849, 0.178618)).lineTo(0.000000, 0.029770).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.253043, -0.223273).lineTo(0.387007, -0.074424).lineTo(0.208388, 0.104194).lineTo(0.074424, -0.044655).close()
loop2=wp_sketch0.moveTo(0.744243, 0.461431).circle(0.640049)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, -0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.178701, -0.178701).lineTo(0.320312, -0.037089).lineTo(0.141612, 0.141612).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.161842, -0.016859).circle(0.057319)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.164062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.184445, -0.409305), (0.593750, -0.593750)).threePointArc((0.198801, -0.394949), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop5).extrude(0.164062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
