import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.458882, 0.000000).threePointArc((0.512354, -0.025230), (0.530263, -0.081579)).threePointArc((0.896937, -0.252187), (0.744408, 0.122368)).lineTo(0.448684, 0.122368).lineTo(0.448684, 0.163158).lineTo(0.000000, 0.163158).lineTo(0.000000, 0.122368).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.744408, -0.101974).circle(0.142763)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.492188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
