# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00254241" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.742188, 0.000000, 0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.008224, 0.000000).lineTo(0.008224, 0.039062).lineTo(0.000000, 0.039062).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.734375, 0.000000, 0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.008224, 0.000000).lineTo(0.008224, 0.039062).lineTo(0.000000, 0.039062).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, -0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(1.484375, 0.000000).lineTo(1.484375, 0.656250).lineTo(1.468750, 0.656250).lineTo(1.468750, 0.687500).lineTo(1.484375, 0.687500).lineTo(1.484375, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.375000, 0.375000).circle(0.125000)
loop4=wp_sketch2.moveTo(1.109375, 0.375000).circle(0.125000)
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).extrude(0.250000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
