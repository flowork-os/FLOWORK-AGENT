# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00310662" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.164062, 0.000000, 0.718750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.062500, 0.000000).lineTo(0.062500, 0.033553).lineTo(0.000000, 0.033553).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.393421, 0.000000).lineTo(0.393421, 0.718750).lineTo(0.226974, 0.718750).lineTo(0.166447, 0.718750).lineTo(0.000000, 0.718750).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.196711, 0.083224).circle(0.030263)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.023438, 0.718750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.164062, 0.000000).lineTo(0.164062, 0.018997).lineTo(0.000000, 0.018997).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.023438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.062500, 0.718750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.396299, 0.000000).lineTo(0.396299, 0.476562).lineTo(0.000000, 0.476562).lineTo(0.000000, 0.060197).lineTo(0.170559, 0.060197).lineTo(0.225740, 0.060197).lineTo(0.225740, 0.040132).lineTo(0.170559, 0.040132).lineTo(0.000000, 0.040132).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch3.moveTo(0.230757, 0.416365).lineTo(0.230757, 0.436431).lineTo(0.170559, 0.436431).lineTo(0.170559, 0.416365).close()
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.023438)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
