# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.040789, 0.000000).threePointArc((0.056525, 0.063059), (0.036842, 0.125000)).lineTo(0.000000, 0.125000).lineTo(0.000000, 0.000000).close()
