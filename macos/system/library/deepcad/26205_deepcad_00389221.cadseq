wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.038487, 0.000000).lineTo(0.164638, 0.000000).lineTo(0.203125, 0.000000).threePointArc((0.101562, 0.055090), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438)
solid=solid0
# workplane for sketch 1
