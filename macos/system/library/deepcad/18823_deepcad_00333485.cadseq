# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00333485" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.468750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.283224, 0.000000).lineTo(0.283224, 0.165789).lineTo(0.000000, 0.328125).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.234375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.250000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.276316, 0.000000).lineTo(0.276316, -0.251645).lineTo(0.468750, -0.251645).lineTo(0.468750, 0.074013).lineTo(0.000000, 0.074013).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.234375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.063322, 0.000000).lineTo(0.063322, -0.037418).lineTo(0.210115, -0.037418).lineTo(0.210115, 0.000000).lineTo(0.273438, 0.000000).lineTo(0.273438, 0.247533).lineTo(0.000000, 0.247533).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.138158, 0.138158).circle(0.048931)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.335938)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.085938, 0.000000, 0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.051316, 0.000000).circle(0.051316)
solid3=wp_sketch3.add(loop4).extrude(0.335938)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
