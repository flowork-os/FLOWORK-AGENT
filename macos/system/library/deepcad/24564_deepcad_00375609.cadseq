loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000674, -0.001628), (0.002303, -0.002303)).lineTo(0.026480, -0.002303).threePointArc((0.027821, -0.001509), (0.028207, 0.000000)).lineTo(0.028207, 0.052385).threePointArc((0.027821, 0.053894), (0.026480, 0.054687)).lineTo(0.002303, 0.054687).threePointArc((0.000674, 0.054013), (0.000000, 0.052385)).lineTo(0.000000, 0.000000).close()
