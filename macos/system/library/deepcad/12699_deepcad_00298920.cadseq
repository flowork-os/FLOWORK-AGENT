loop0=wp_sketch0.moveTo(0.640625, 0.000000).lineTo(0.323684, 0.552961).lineTo(0.283224, 0.532730).threePointArc((0.279852, 0.522615), (0.269737, 0.525987)).lineTo(0.229276, 0.505757).lineTo(0.000000, 0.101151).lineTo(0.000000, 0.060691).threePointArc((0.010115, 0.050576), (0.000000, 0.040461)).lineTo(0.000000, 0.000000).close()
