loop2=wp_sketch2.moveTo(0.649342, 0.000000).lineTo(0.649342, 0.041447).threePointArc((0.659704, 0.051809), (0.649342, 0.062171)).lineTo(0.649342, 0.103618).lineTo(0.414474, 0.511184).lineTo(0.373026, 0.531908).threePointArc((0.362664, 0.528454), (0.359211, 0.538816)).lineTo(0.324671, 0.559539).lineTo(0.000000, 0.000000).close()
