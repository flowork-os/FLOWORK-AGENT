# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00250213" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.742105)
loop1=wp_sketch0.moveTo(0.505263, -0.442105).lineTo(1.057895, -0.442105).lineTo(1.105263, -0.410526).lineTo(0.915789, -0.221053).lineTo(0.521053, -0.221053).lineTo(0.521053, 0.157895).lineTo(0.363158, 0.315789).lineTo(0.300000, 0.252632).lineTo(0.300000, -0.252632).close()
loop2=wp_sketch0.moveTo(0.584211, 0.221053).lineTo(0.978947, 0.221053).lineTo(0.978947, -0.157895).lineTo(1.168421, -0.347368).lineTo(1.200000, -0.315789).lineTo(1.200000, 0.252632).lineTo(0.994737, 0.442105).lineTo(0.505263, 0.442105).lineTo(0.426316, 0.378947).close()
loop3=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.142105)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
