# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00319257" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.216979, -0.383021), (0.600000, -0.600000)).lineTo(0.600000, -0.157895).lineTo(0.142105, -0.157895).close()
loop2=wp_sketch0.moveTo(0.600000, 0.157895).lineTo(0.600000, 0.600000).threePointArc((0.309879, 0.442306), (0.142105, 0.157895)).close()
loop3=wp_sketch0.moveTo(0.852632, -0.094737).lineTo(0.852632, 0.094737).lineTo(0.647368, 0.094737).lineTo(0.647368, -0.094737).close()
loop4=wp_sketch0.moveTo(0.647368, -0.094737).threePointArc((0.993893, -0.224630), (1.357895, -0.157895)).lineTo(0.900000, -0.157895).lineTo(0.900000, -0.600000).close()
loop5=wp_sketch0.moveTo(1.357895, 0.157895).threePointArc((1.190121, 0.442306), (0.900000, 0.600000)).lineTo(0.900000, 0.157895).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.250000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
