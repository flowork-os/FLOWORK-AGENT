# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00245588" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.250000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.085115, 0.000000).lineTo(0.085115, -0.312089).lineTo(0.501234, -0.312089).lineTo(0.501234, -0.397204).lineTo(0.898438, -0.397204).lineTo(0.898438, -0.104030).lineTo(0.245888, 0.075658).lineTo(0.000000, 0.075658).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.747122, -0.245888).circle(0.066201)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
