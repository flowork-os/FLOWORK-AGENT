wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.168997, -0.202796).lineTo(0.360526, -0.202796).threePointArc((0.619655, -0.053894), (0.878783, -0.202796)).lineTo(1.070312, -0.202796).lineTo(1.070312, 0.698520).lineTo(0.923849, 0.698520).lineTo(0.619655, 0.247862).lineTo(0.315461, 0.698520).lineTo(0.168997, 0.698520).lineTo(0.000000, 0.495724).threePointArc((-0.130536, 0.247862), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.375000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
