# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00295076" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.718750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.436842).lineTo(0.000000, 1.436842).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.757895, 0.710526).circle(0.189474)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.640625, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch1.moveTo(0.000000, 1.281250).threePointArc((-0.394742, 0.640625), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.328125, 0.640625, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.394742, 0.640625), (0.000000, 1.281250)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.015625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
