# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00217705" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.562500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.125000, 0.000000).lineTo(1.125000, 1.125000).lineTo(0.000000, 1.125000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.307895, 0.450000).lineTo(0.307895, 0.828947).lineTo(0.225000, 0.828947).lineTo(0.225000, 0.450000).close()
loop2=wp_sketch0.moveTo(0.746053, 0.130263).lineTo(0.746053, 0.213158).lineTo(0.378947, 0.213158).lineTo(0.378947, 0.130263).close()
loop3=wp_sketch0.moveTo(0.923684, 0.450000).lineTo(0.923684, 0.828947).lineTo(0.840789, 0.828947).lineTo(0.840789, 0.450000).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.562500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(1.125000, 0.000000).lineTo(1.125000, 1.125000).lineTo(0.000000, 1.125000).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(0.307895, 0.450000).lineTo(0.307895, 0.828947).lineTo(0.225000, 0.828947).lineTo(0.225000, 0.450000).close()
loop6=wp_sketch1.moveTo(0.746053, 0.130263).lineTo(0.746053, 0.213158).lineTo(0.378947, 0.213158).lineTo(0.378947, 0.130263).close()
loop7=wp_sketch1.moveTo(0.923684, 0.450000).lineTo(0.923684, 0.828947).lineTo(0.840789, 0.828947).lineTo(0.840789, 0.450000).close()
solid1=wp_sketch1.add(loop4).add(loop5).add(loop6).add(loop7).extrude(-0.750000)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
