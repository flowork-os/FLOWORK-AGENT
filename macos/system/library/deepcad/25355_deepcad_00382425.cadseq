import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.022401, -0.054080), (0.076480, -0.076480)).lineTo(1.134457, -0.076480).threePointArc((1.188537, -0.054080), (1.210938, 0.000000)).lineTo(1.210938, 0.025493).threePointArc((1.188537, 0.079573), (1.134457, 0.101974)).lineTo(0.076480, 0.101974).threePointArc((0.022401, 0.079573), (0.000000, 0.025493)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.076480, 0.012747).circle(0.038240)
loop2=wp_sketch0.moveTo(1.134457, 0.012747).circle(0.038240)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.164062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
