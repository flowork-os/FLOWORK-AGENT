# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00291211" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.507812, 0.000000).lineTo(0.507812, 0.288651).lineTo(0.000000, 0.288651).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.021382, 0.021382).circle(0.010691)
loop2=wp_sketch0.moveTo(0.021382, 0.267270).circle(0.010691)
loop3=wp_sketch0.moveTo(0.486431, 0.021382).circle(0.010691)
loop4=wp_sketch0.moveTo(0.486431, 0.267270).circle(0.010691)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.171875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.578125, 0.000000).lineTo(0.578125, 0.170395).lineTo(0.000000, 0.170395).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch1.moveTo(0.030428, 0.085197).circle(0.006086)
loop7=wp_sketch1.moveTo(0.547697, 0.085197).circle(0.006086)
solid1=wp_sketch1.add(loop5).add(loop6).add(loop7).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
