loop3=wp_sketch3.moveTo(0.781250, 0.000000).lineTo(0.781250, 0.024671).lineTo(0.000000, 0.024671).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.250000)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.007812, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.031579, 0.000000).circle(0.031579)
solid4=wp_sketch4.add(loop4).extrude(-0.039062)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.164062, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch5.moveTo(0.031579, 0.000000).circle(0.031579)
solid5=wp_sketch5.add(loop5).extrude(-0.039062)
solid=solid.cut(solid5)
# workplane for sketch 6
wp_sketch6 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, -0.554688, 0.070312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch6.moveTo(0.024671, 0.000000).lineTo(0.024671, 0.781250).lineTo(0.000000, 0.781250).lineTo(0.000000, 0.000000).close()
