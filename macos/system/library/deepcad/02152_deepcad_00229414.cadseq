# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00229414" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.203125, 0.000000).lineTo(0.299342, 0.363487).lineTo(0.513158, 0.117599).lineTo(0.716283, 0.363487).lineTo(0.812500, 0.000000).lineTo(1.015625, 0.000000).lineTo(0.716283, 0.748355).lineTo(0.513158, 0.427632).lineTo(0.299342, 0.748355).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.398438, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.250000, 0.750000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.055263, -0.750000).lineTo(0.363158, -0.750000).lineTo(0.307895, -0.473684).lineTo(0.386842, -0.457895).threePointArc((0.570664, -0.207481), (0.339474, 0.000000)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.276316, -0.339474).threePointArc((0.367105, -0.201316), (0.228947, -0.110526)).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.554688, both=True)
solid=solid.intersect(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
