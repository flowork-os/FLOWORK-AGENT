import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.554688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.281250, 0.000000).lineTo(1.281250, 0.080921).lineTo(1.281250, 0.674342).lineTo(1.281250, 0.755263).lineTo(0.795724, 0.755263).lineTo(0.215789, 0.755263).lineTo(0.000000, 0.755263).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.609375, -0.468750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.139967, 0.000000).lineTo(0.139967, 0.578125).lineTo(0.000000, 0.578125).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.515625, 0.046875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(1.195312, 0.000000).lineTo(1.195312, 0.679441).lineTo(0.000000, 0.679441).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.093750)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.609375, -0.468750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.139967, 0.000000).lineTo(0.139967, 0.578125).lineTo(0.000000, 0.578125).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.171875)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.554688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(1.281250, 0.000000).lineTo(1.281250, 0.080921).lineTo(1.281250, 0.674342).lineTo(1.281250, 0.755263).lineTo(0.795724, 0.755263).lineTo(0.215789, 0.755263).lineTo(0.000000, 0.755263).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.023438)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
