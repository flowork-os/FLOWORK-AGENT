# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00298889" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.101562, -0.101562).lineTo(0.203125, -0.101562).lineTo(0.406250, -0.101562).lineTo(0.406250, 0.507812).lineTo(0.000000, 0.507812).lineTo(0.000000, 0.101562).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.101562, 0.000000).circle(0.042763)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, -0.445312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.177303, 0.000000).lineTo(0.382813, 0.000000).lineTo(0.382813, 0.245806).lineTo(0.177303, 0.245806).lineTo(0.072533, 0.245806).threePointArc((0.168943, 0.102878), (0.000000, 0.068503)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.132812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.000000, 0.132812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.406250, 0.000000).lineTo(0.406250, 0.406250).lineTo(0.000000, 0.406250).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.679688)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
