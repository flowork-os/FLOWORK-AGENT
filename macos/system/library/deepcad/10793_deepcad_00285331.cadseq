# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285331" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.593750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.078947, 0.000000).circle(0.077303)
loop1=wp_sketch0.moveTo(0.078947, 0.000000).circle(0.039474)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.789062, 0.083059).threePointArc((0.702003, 0.161965), (0.789062, 0.240872)).lineTo(0.000000, 0.315625).threePointArc((0.143033, 0.157812), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.539885, 0.116283).threePointArc((0.581414, 0.157812), (0.539885, 0.199342)).lineTo(0.224260, 0.199342).threePointArc((0.182730, 0.157812), (0.224260, 0.116283)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.156250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.161842, 0.000000).circle(0.161842)
loop5=wp_sketch2.moveTo(0.161842, 0.000000).circle(0.121382)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.242188)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
