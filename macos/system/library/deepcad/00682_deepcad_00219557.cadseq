# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00219557" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.000000, 0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.345395, 0.000000).lineTo(0.365132, 0.000000).lineTo(0.355263, -0.019737).lineTo(0.315789, -0.098684).lineTo(0.473684, -0.098684).lineTo(0.621711, -0.098684).lineTo(0.582237, -0.019737).lineTo(0.572368, 0.000000).lineTo(0.592105, 0.000000).lineTo(0.937500, 0.000000).lineTo(0.937500, 0.177632).lineTo(0.000000, 0.177632).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.937500, 0.000000).lineTo(0.937500, 0.187500).lineTo(0.592105, 0.187500).lineTo(0.641447, 0.088816).lineTo(0.473684, 0.088816).lineTo(0.296053, 0.088816).lineTo(0.345395, 0.187500).lineTo(0.000000, 0.187500).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
