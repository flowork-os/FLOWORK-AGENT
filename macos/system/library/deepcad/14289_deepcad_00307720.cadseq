# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00307720" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.000000, -0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.835938, 0.000000).lineTo(0.316776, 0.519161).lineTo(0.000000, 0.519161).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.625000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.531250, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.218750, -0.209539).lineTo(0.218750, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.210938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
