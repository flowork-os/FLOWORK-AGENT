# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00309719" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.150725, -0.363883), (0.213158, -0.213158)).threePointArc((0.224108, -0.147357), (0.284211, -0.118421)).lineTo(0.513158, -0.118421).lineTo(0.750000, -0.118421).lineTo(0.750000, 0.039474).lineTo(0.142105, 0.039474).lineTo(0.142105, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, -0.213158).circle(0.142105)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.242188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.125000, 0.000000, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.390625, 0.271382).lineTo(0.160362, 0.271382).threePointArc((0.100877, 0.242229), (0.090461, 0.176809)).threePointArc((0.066799, 0.077370), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.039062, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
