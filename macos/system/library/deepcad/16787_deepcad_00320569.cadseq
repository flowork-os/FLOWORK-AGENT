# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00320569" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.442105, 0.252632).circle(0.189474)
loop2=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.297205, -0.375245), (0.757895, -0.505263)).threePointArc((1.064301, -0.411571), (1.278947, -0.173684)).lineTo(0.268421, -0.173684).close()
loop3=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.078947)
loop4=wp_sketch0.moveTo(1.057895, 0.236842).circle(0.189474)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(-0.578125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
