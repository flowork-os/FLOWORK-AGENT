# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.101562).threePointArc((-0.022884, 0.050781), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625, both=True)
solid=solid0
# workplane for sketch 1
