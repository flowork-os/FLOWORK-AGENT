solid1=wp_sketch1.add(loop1).extrude(0.015625, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.025338, -0.004472), (0.047368, -0.017763)).lineTo(0.047368, 0.562500).threePointArc((0.025338, 0.549209), (0.000000, 0.544737)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.015625, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, -0.679688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.067105, 0.000000).circle(0.067105)
loop4=wp_sketch3.moveTo(0.067105, 0.000000).circle(0.022368)
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.015625, both=True)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.110864, 0.049959), (0.000000, 0.099918)).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch4.moveTo(0.044408, 0.050576).circle(0.022204)
solid4=wp_sketch4.add(loop5).add(loop6).extrude(0.015625, both=True)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
