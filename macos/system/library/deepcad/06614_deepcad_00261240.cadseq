# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00261240" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.000000, 0.468750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.384211, 0.000000).lineTo(0.384211, -0.576316).lineTo(0.756414, -0.576316).lineTo(0.756414, 0.000000).lineTo(1.140625, 0.000000).lineTo(1.140625, 0.288158).lineTo(0.000000, 0.288158).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.382812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
