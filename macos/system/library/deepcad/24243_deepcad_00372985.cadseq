# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00372985" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.686842, 0.000000).threePointArc((0.752690, 0.055914), (0.702632, 0.126316)).lineTo(0.023684, 0.244737).threePointArc((-0.121517, 0.135274), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.126316).circle(0.063158)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.031250, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.625000, -0.031250, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.063158, 0.000000).circle(0.063158)
solid1=wp_sketch1.add(loop2).extrude(0.125000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.429688, 0.031250, 0.046875), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.011574, -0.118791), (0.116776, -0.175164)).lineTo(0.432072, -0.175164).threePointArc((0.557204, -0.036903), (0.408717, 0.075905)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.432072, -0.110937).threePointArc((0.493380, -0.049630), (0.432072, 0.011678)).lineTo(0.116776, 0.011678).threePointArc((0.055469, -0.049630), (0.116776, -0.110937)).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.031250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
