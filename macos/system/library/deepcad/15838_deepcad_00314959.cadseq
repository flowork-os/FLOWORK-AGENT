# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00314959" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.274424, 0.000000).lineTo(0.274424, 0.135280).lineTo(0.185526, 0.135280).lineTo(0.185526, 0.046382).lineTo(0.092763, 0.046382).lineTo(0.092763, 0.320806).lineTo(0.185526, 0.320806).lineTo(0.185526, 0.231908).lineTo(0.274424, 0.231908).lineTo(0.274424, 0.367188).lineTo(0.000000, 0.367188).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.274424, 0.000000).lineTo(0.274424, 0.367188).lineTo(0.000000, 0.367188).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.185526, 0.046382).lineTo(0.185526, 0.278289).lineTo(0.092763, 0.278289).lineTo(0.092763, 0.046382).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.093750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
