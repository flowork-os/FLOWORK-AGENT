# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00252022" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.584211).lineTo(0.000000, 0.584211).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.150000, 0.031579).circle(0.015789)
loop2=wp_sketch0.moveTo(0.165789, 0.552632).circle(0.015789)
loop3=wp_sketch0.moveTo(0.718421, 0.086842).circle(0.015789)
loop4=wp_sketch0.moveTo(0.718421, 0.386842).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
