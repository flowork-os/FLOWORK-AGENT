# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297249" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.014145, 0.000000).lineTo(0.014145, 0.014145).lineTo(0.657730, 0.014145).lineTo(0.657730, 0.000000).lineTo(0.671875, 0.000000).lineTo(0.671875, 0.311184).lineTo(0.657730, 0.311184).lineTo(0.657730, 0.021217).lineTo(0.014145, 0.021217).lineTo(0.014145, 0.311184).lineTo(0.000000, 0.311184).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.726562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.320312, -0.742188, -0.015625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.015543, 0.000000).lineTo(0.015543, 0.023438).lineTo(0.000000, 0.023438).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.640625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.320312, -0.742188, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.015214, 0.000000).lineTo(0.015214, 0.289062).lineTo(0.000000, 0.289062).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.640625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
