# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00258647" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.000000, 0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.578783, -0.654276).lineTo(1.019161, -0.654276).lineTo(1.195312, -0.390049).lineTo(0.855592, -0.163569).lineTo(0.301974, 0.364885).lineTo(0.163569, 0.364885).lineTo(0.000000, 0.188734).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.000000, 0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.578783, -0.654276).lineTo(1.019161, -0.654276).lineTo(1.195312, -0.390049).lineTo(0.855592, -0.163569).lineTo(0.301974, 0.364885).lineTo(0.163569, 0.364885).lineTo(0.000000, 0.188734).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.046875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
