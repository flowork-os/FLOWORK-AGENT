# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.570312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.030686, -0.074083), (0.104770, -0.104770)).lineTo(1.317105, -0.104770).threePointArc((1.391189, -0.074083), (1.421875, 0.000000)).lineTo(1.421875, 1.212336).threePointArc((1.391189, 1.286419), (1.317105, 1.317105)).lineTo(0.104770, 1.317105).threePointArc((0.030686, 1.286419), (0.000000, 1.212336)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
