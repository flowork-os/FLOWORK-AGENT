import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.000000, -0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.327632, 0.000000).lineTo(0.327632, -0.068257).lineTo(0.969243, -0.068257).lineTo(0.969243, 0.000000).lineTo(1.296875, 0.000000).lineTo(1.296875, 0.395888).lineTo(0.969243, 0.395888).lineTo(0.969243, 0.477796).lineTo(0.327632, 0.477796).lineTo(0.327632, 0.395888).lineTo(0.000000, 0.395888).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.900987, 0.054605).lineTo(0.900987, 0.354934).lineTo(0.395888, 0.354934).lineTo(0.395888, 0.054605).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
