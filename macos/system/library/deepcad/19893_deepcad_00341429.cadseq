import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.055510, 0.000000).lineTo(1.054688, 0.000000).lineTo(1.054688, 0.055510).lineTo(0.732730, 0.055510).lineTo(0.477385, 0.055510).lineTo(0.199836, 0.055510).lineTo(0.055510, 0.055510).lineTo(0.055510, 0.699424).lineTo(0.000000, 0.699424).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.500000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.151974, 0.000000).lineTo(0.151974, 0.130263).lineTo(0.325658, 0.173684).lineTo(0.434211, 0.000000).lineTo(0.683882, 0.000000).threePointArc((1.031250, 0.347368), (0.683882, 0.694737)).lineTo(0.488487, 0.694737).lineTo(0.488487, 0.217105).lineTo(0.184539, 0.694737).lineTo(0.000000, 0.651316).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.260526, 0.293092).lineTo(0.151974, 0.466776).lineTo(0.151974, 0.271382).close()
loop3=wp_sketch1.moveTo(0.151974, 0.271382).threePointArc((0.542763, 0.130263), (0.683882, 0.521053)).lineTo(0.683882, 0.173684).close()
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.375000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.151974, 0.000000).lineTo(0.151974, 0.130263).lineTo(0.325658, 0.173684).lineTo(0.434211, 0.000000).lineTo(0.683882, 0.000000).threePointArc((1.031250, 0.347368), (0.683882, 0.694737)).lineTo(0.488487, 0.694737).lineTo(0.488487, 0.217105).lineTo(0.184539, 0.694737).lineTo(0.000000, 0.651316).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.260526, 0.293092).lineTo(0.151974, 0.466776).lineTo(0.151974, 0.271382).close()
loop6=wp_sketch2.moveTo(0.151974, 0.271382).threePointArc((0.542763, 0.130263), (0.683882, 0.521053)).lineTo(0.683882, 0.173684).close()
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).extrude(0.125000)
solid=solid.cut(solid2)

