wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001156, -0.002791), (0.003947, -0.003947)).lineTo(0.058553, -0.003947).threePointArc((0.061344, -0.002791), (0.062500, 0.000000)).lineTo(0.062500, 0.054605).threePointArc((0.061344, 0.057396), (0.058553, 0.058553)).lineTo(0.003947, 0.058553).threePointArc((0.001156, 0.057396), (0.000000, 0.054605)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.005343, -0.001057), (0.009868, 0.001974)).lineTo(0.052632, 0.001974).threePointArc((0.055423, 0.003130), (0.056579, 0.005921)).lineTo(0.056579, 0.048684).threePointArc((0.055423, 0.051475), (0.052632, 0.052632)).lineTo(0.009868, 0.052632).threePointArc((0.007077, 0.051475), (0.005921, 0.048684)).lineTo(0.005921, 0.005921).close()
