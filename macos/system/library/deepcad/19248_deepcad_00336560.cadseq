# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00336560" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.019120, -0.020582), (0.038240, 0.000000)).lineTo(0.020395, 0.242188).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.020395, -0.002549).circle(0.010197)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.024671, -0.028958), (0.049342, 0.000000)).lineTo(0.024671, 0.156250).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.024671, -0.003289).circle(0.014803)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.007812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
