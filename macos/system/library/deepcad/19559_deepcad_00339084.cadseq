# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00339084" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.921875, 0.048520).threePointArc((0.743508, 0.218339), (0.921875, 0.388158)).lineTo(0.000000, 0.436678).threePointArc((0.207876, 0.218339), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.221053, 0.000000).circle(0.221053)
loop2=wp_sketch1.moveTo(0.221053, 0.000000).circle(0.128947)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.132812, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.218750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.173684, 0.000000).circle(0.170066)
loop4=wp_sketch2.moveTo(0.173684, 0.000000).circle(0.090461)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.078125, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
