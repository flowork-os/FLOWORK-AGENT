# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00354881" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.406250, 0.000000).lineTo(0.406250, 0.406250).lineTo(0.000000, 0.406250).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.205263, 0.205263).circle(0.068421)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.203125, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.203125, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.337829, 0.000000).lineTo(0.337829, 0.102632).threePointArc((0.303618, 0.136842), (0.337829, 0.171053)).lineTo(0.337829, 0.235197).threePointArc((0.303618, 0.269408), (0.337829, 0.303618)).lineTo(0.337829, 0.406250).lineTo(0.000000, 0.406250).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.136842, 0.136842).circle(0.034211)
loop4=wp_sketch1.moveTo(0.136842, 0.269408).circle(0.034211)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).extrude(0.070312, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.546875, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.203125, 0.203125), (0.000000, 0.406250)).lineTo(0.000000, 0.303618).threePointArc((0.034211, 0.269408), (0.000000, 0.235197)).lineTo(0.000000, 0.171053).threePointArc((0.034211, 0.136842), (0.000000, 0.102632)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop5).extrude(0.070312, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
