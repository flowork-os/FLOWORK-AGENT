# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382477" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.041447, 0.000000).lineTo(0.041447, 0.218750).lineTo(0.000000, 0.218750).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.679688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.281250, 0.000000).lineTo(0.281250, 0.219079).lineTo(0.000000, 0.219079).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.679688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, -0.445312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(1.312500, 0.000000).lineTo(1.312500, 0.718421).lineTo(0.000000, 0.718421).lineTo(0.000000, 0.442105).lineTo(0.276316, 0.442105).lineTo(0.276316, 0.221053).lineTo(0.000000, 0.221053).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.428289, 0.511184).lineTo(0.428289, 0.649342).lineTo(0.165789, 0.649342).lineTo(0.165789, 0.511184).close()
loop4=wp_sketch2.moveTo(0.980921, 0.303947).lineTo(0.980921, 0.400658).lineTo(0.552632, 0.400658).lineTo(0.552632, 0.303947).close()
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).extrude(0.679688)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
