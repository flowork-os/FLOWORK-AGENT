wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.073994, -0.178638), (0.252632, -0.252632)).lineTo(1.247368, -0.252632).threePointArc((1.426006, -0.178638), (1.500000, 0.000000)).lineTo(1.500000, 0.694737).threePointArc((1.422736, 0.865480), (1.247368, 0.931579)).lineTo(0.252632, 0.931579).threePointArc((0.077264, 0.865480), (0.000000, 0.694737)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.320312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.429688, 0.320312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.072838, -0.175846), (0.248684, -0.248684)).lineTo(1.125000, -0.248684).lineTo(1.125000, -0.165789).lineTo(0.248684, -0.165789).threePointArc((0.070385, -0.087031), (0.000000, 0.094737)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.070312)
