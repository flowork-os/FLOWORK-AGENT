# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.343750, 0.320312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.072838, 0.175846), (0.248684, 0.248684)).lineTo(1.125000, 0.248684).lineTo(1.125000, 0.343421).lineTo(0.248684, 0.343421).threePointArc((0.072838, 0.270583), (0.000000, 0.094737)).lineTo(0.000000, 0.000000).close()
