import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, -0.289062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.010622, -0.025644), (0.036266, -0.036266)).lineTo(1.112171, -0.036266).threePointArc((1.137815, -0.025644), (1.148438, 0.000000)).lineTo(1.148438, 0.531908).threePointArc((1.135312, 0.551508), (1.112171, 0.556086)).lineTo(0.036266, 0.556086).threePointArc((0.013126, 0.551508), (0.000000, 0.531908)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.060444, 0.036266).circle(0.024178)
loop2=wp_sketch0.moveTo(0.060444, 0.495641).circle(0.024178)
loop3=wp_sketch0.moveTo(0.580263, 0.036266).circle(0.024178)
loop4=wp_sketch0.moveTo(1.087993, 0.495641).circle(0.024178)
loop5=wp_sketch0.moveTo(1.087993, 0.036266).circle(0.024178)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.148438, 0.203125, 0.031250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.027632, 0.000000).circle(0.027632)
solid1=wp_sketch1.add(loop6).extrude(-0.132812)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
