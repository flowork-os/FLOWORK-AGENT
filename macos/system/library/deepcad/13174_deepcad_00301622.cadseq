wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.234375, 0.437500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.098684, -0.118421).threePointArc((0.174987, -0.005945), (0.302632, -0.052632)).lineTo(0.065789, -0.440789).lineTo(0.065789, -0.625000).lineTo(0.513158, -0.625000).lineTo(0.513158, -0.440789).lineTo(0.256579, -0.440789).lineTo(0.513158, 0.000000).threePointArc((0.256579, 0.153788), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.429688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
