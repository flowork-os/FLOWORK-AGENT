wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, 0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.024424, 0.000000).lineTo(0.024424, -0.146546).lineTo(0.024424, -0.195395).lineTo(0.040707, -0.195395).lineTo(0.040707, -0.146546).lineTo(0.732730, -0.146546).lineTo(0.732730, -0.195395).lineTo(0.749013, -0.195395).lineTo(0.749013, -0.146546).lineTo(0.749013, 0.000000).lineTo(0.773437, 0.000000).lineTo(0.773437, 0.048849).lineTo(0.000000, 0.048849).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
