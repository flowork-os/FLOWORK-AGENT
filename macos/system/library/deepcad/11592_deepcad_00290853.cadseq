# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00290853" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.694737, 0.000000).lineTo(0.694737, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.122533, 0.000000).lineTo(0.122533, -0.343092).lineTo(0.281826, -0.343092).lineTo(0.281826, -0.183799).lineTo(0.686184, -0.183799).lineTo(0.686184, 1.164062).lineTo(0.000000, 1.164062).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.134786, 0.012253).lineTo(0.134786, -0.330839).lineTo(0.269572, -0.330839).lineTo(0.269572, -0.171546).lineTo(0.673931, -0.171546).lineTo(0.673931, 1.151809).lineTo(0.012253, 1.151809).lineTo(0.012253, 0.012253).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.281250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, -0.585938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.140625, 0.000000).lineTo(0.140625, 0.011842).lineTo(0.000000, 0.011842).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.281250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
