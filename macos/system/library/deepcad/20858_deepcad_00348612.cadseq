# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00348612" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.703125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.016475, -0.039775), (0.056250, -0.056250)).lineTo(0.956250, -0.056250).threePointArc((0.996025, -0.039775), (1.012500, 0.000000)).lineTo(1.012500, 1.279688).threePointArc((0.996025, 1.319462), (0.956250, 1.335938)).lineTo(0.056250, 1.335938).threePointArc((0.016475, 1.319462), (0.000000, 1.279688)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.210938, 1.012500).lineTo(0.210938, 1.265625).lineTo(0.140625, 1.265625).lineTo(0.140625, 1.012500).close()
loop2=wp_sketch0.moveTo(0.871875, 1.012500).lineTo(0.871875, 1.265625).lineTo(0.787500, 1.265625).lineTo(0.787500, 1.012500).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
