import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.740954, 0.000000).lineTo(0.740954, 0.139803).lineTo(0.153783, 0.139803).lineTo(0.153783, 0.629112).lineTo(0.699013, 0.629112).lineTo(0.699013, 0.768914).lineTo(0.153783, 0.768914).lineTo(0.153783, 1.188322).lineTo(0.740954, 1.188322).lineTo(0.740954, 1.328125).lineTo(0.000000, 1.328125).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.382812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
