# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00310954" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.048109, -0.125082).lineTo(0.134704, -0.125082).lineTo(0.221299, -0.125082).lineTo(0.163569, 0.067352).lineTo(0.894819, 0.096217).lineTo(0.914062, 0.192434).lineTo(0.000000, 0.163569).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.398438, -0.093750, 0.093750), cq.Vector(-0.000000, 1.000000, -0.000000), cq.Vector(0.980785, 0.000000, -0.195090)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.046875, -0.015805), (0.093750, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.328125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.398438, -0.093750, 0.093750), cq.Vector(-0.000000, 1.000000, -0.000000), cq.Vector(0.980785, 0.000000, -0.195090)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.047368, 0.140486), (0.094737, 0.000000)).lineTo(0.094737, 0.106579).lineTo(0.000000, 0.106579).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.328125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
