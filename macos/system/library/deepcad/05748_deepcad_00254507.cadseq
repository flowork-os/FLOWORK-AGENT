import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.679688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, -0.328865).lineTo(0.260033, -0.328865).lineTo(0.260033, -0.397697).lineTo(0.466530, -0.397697).lineTo(0.466530, -0.328865).lineTo(0.726562, -0.328865).lineTo(0.726562, 0.000000).lineTo(0.657730, 0.000000).lineTo(0.657730, 0.068832).lineTo(0.068832, 0.068832).lineTo(0.068832, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.198849, -0.122368).circle(0.107072)
loop2=wp_sketch0.moveTo(0.397697, -0.328865).lineTo(0.397697, -0.260033).lineTo(0.328865, -0.260033).lineTo(0.328865, -0.328865).close()
loop3=wp_sketch0.moveTo(0.520066, -0.130016).circle(0.099424)
