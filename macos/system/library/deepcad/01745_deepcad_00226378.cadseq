# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00226378" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.078125, -0.289062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.558717, 0.141447).threePointArc((0.670439, 0.286431), (0.558717, 0.431414)).lineTo(0.000000, 0.579934).threePointArc((-0.376296, 0.289967), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.077796, 0.289967).circle(0.176809)
loop2=wp_sketch0.moveTo(0.523355, 0.289967).circle(0.077796)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.226562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.303947, 0.000000).circle(0.303947)
loop4=wp_sketch1.moveTo(0.303947, 0.000000).circle(0.177303)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.226562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
