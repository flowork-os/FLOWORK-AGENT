# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00294267" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.546875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.224507, 0.000000).lineTo(0.224507, 0.138158).lineTo(0.414474, 0.138158).lineTo(0.595806, 0.138158).lineTo(0.595806, 0.000000).lineTo(0.820313, 0.000000).lineTo(0.820313, 0.276316).lineTo(0.414474, 0.276316).lineTo(0.000000, 0.276316).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.281250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.414474, 0.000000).lineTo(0.820313, 0.000000).lineTo(0.820313, 0.371299).threePointArc((0.410156, 0.781456), (0.000000, 0.371299)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.414474, 0.371299).circle(0.189967)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.189474, 0.000000).circle(0.185526)
loop4=wp_sketch2.moveTo(0.189474, 0.000000).circle(0.094737)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.257812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
