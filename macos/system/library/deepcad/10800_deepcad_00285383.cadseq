wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.073994, -0.178638), (0.252632, -0.252632)).lineTo(1.247368, -0.252632).threePointArc((1.426006, -0.178638), (1.500000, 0.000000)).lineTo(1.500000, 0.994737).threePointArc((1.426006, 1.173374), (1.247368, 1.247368)).lineTo(0.252632, 1.247368).threePointArc((0.073994, 1.173374), (0.000000, 0.994737)).lineTo(0.000000, 0.000000).close()
