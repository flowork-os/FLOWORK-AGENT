# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, -0.281250, 0.195312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch5.moveTo(0.254605, 0.000000).lineTo(0.254605, 0.562500).lineTo(0.000000, 0.562500).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop5).extrude(0.554688)
solid=solid.union(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
