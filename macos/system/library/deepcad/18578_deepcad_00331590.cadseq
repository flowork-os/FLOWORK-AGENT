# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00331590" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.601562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, -0.453125, 0.601562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.044512, -0.107462), (0.151974, -0.151974)).lineTo(1.051151, -0.151974).threePointArc((1.158613, -0.107462), (1.203125, 0.000000)).lineTo(1.203125, 0.899178).threePointArc((1.158613, 1.006639), (1.051151, 1.051151)).lineTo(0.151974, 1.051151).threePointArc((0.044512, 1.006639), (0.000000, 0.899178)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.259435, -0.018437), (0.455921, 0.151974)).lineTo(0.747204, 0.151974).threePointArc((0.854666, 0.196486), (0.899178, 0.303947)).lineTo(0.899178, 0.607895).threePointArc((0.852043, 0.709024), (0.747204, 0.747204)).lineTo(0.455921, 0.747204).threePointArc((0.351082, 0.709024), (0.303947, 0.607895)).lineTo(0.303947, 0.303947).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.148438)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.601562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.150000, 0.000000).circle(0.150000)
solid2=wp_sketch2.add(loop3).extrude(-0.296875)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
