# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00339876" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.000000, 0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.018750, -0.005921).threePointArc((0.041106, -0.007696), (0.062171, 0.000000)).lineTo(0.092763, 0.019737).threePointArc((0.031007, 0.082128), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.041447, 0.030592).circle(0.025658)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, 0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.045970, -0.017105).threePointArc((0.064679, -0.020470), (0.083388, -0.017105)).lineTo(0.087664, -0.012829).threePointArc((0.056012, 0.076814), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.048109, 0.023520).circle(0.026727)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.000000, -0.055510).lineTo(0.355263, -0.166530).threePointArc((0.382375, -0.086243), (0.444079, -0.144326)).threePointArc((0.569115, -0.102903), (0.699424, -0.122122)).threePointArc((0.754372, -0.043351), (0.788240, -0.133224)).lineTo(1.054688, 0.011102).lineTo(1.054688, 0.077714).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.031250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
