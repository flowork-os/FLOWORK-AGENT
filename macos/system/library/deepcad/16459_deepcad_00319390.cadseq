# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00319390" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.028783, 0.000000).circle(0.028783)
loop1=wp_sketch0.moveTo(0.345395, -0.028783).lineTo(0.676398, -0.028783).lineTo(1.007401, -0.028783).lineTo(1.338405, -0.028783).threePointArc((1.367188, 0.000000), (1.338405, 0.028783)).lineTo(1.007401, 0.028783).lineTo(0.676398, 0.028783).lineTo(0.345395, 0.028783).lineTo(0.028783, 0.028783).threePointArc((0.057566, 0.000000), (0.028783, -0.028783)).close()
loop2=wp_sketch0.moveTo(0.676398, 0.000000).circle(0.028783)
loop3=wp_sketch0.moveTo(1.338405, 0.000000).circle(0.028783)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.028783, 0.000000).circle(0.028783)
loop5=wp_sketch1.moveTo(0.345395, -0.028783).lineTo(0.676398, -0.028783).lineTo(1.007401, -0.028783).lineTo(1.338405, -0.028783).threePointArc((1.367188, 0.000000), (1.338405, 0.028783)).lineTo(1.007401, 0.028783).lineTo(0.676398, 0.028783).lineTo(0.345395, 0.028783).lineTo(0.028783, 0.028783).threePointArc((0.057566, 0.000000), (0.028783, -0.028783)).close()
loop6=wp_sketch1.moveTo(0.676398, 0.000000).circle(0.028783)
loop7=wp_sketch1.moveTo(1.338405, 0.000000).circle(0.028783)
solid1=wp_sketch1.add(loop4).add(loop5).add(loop6).add(loop7).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
