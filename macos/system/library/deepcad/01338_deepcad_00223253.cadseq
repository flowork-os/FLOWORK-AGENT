# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00223253" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.213158, 0.000000).circle(0.213158)
solid0=wp_sketch0.add(loop0).extrude(0.320312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, 0.320312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.067105, 0.000000).circle(0.067105)
solid1=wp_sketch1.add(loop1).extrude(0.367188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.054688, 0.679688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.335938, 0.000000).threePointArc((0.304614, 0.047930), (0.321793, 0.102549)).lineTo(0.000000, 0.102549).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.070312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.031250, -0.054688, 0.679688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.117188, 0.000000).lineTo(0.117188, 0.104852).lineTo(0.014803, 0.104852).threePointArc((0.032197, 0.048925), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(0.070312)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.046875, 0.679688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((-0.016811, -0.054693), (0.014803, -0.102385)).lineTo(0.049342, -0.102385).lineTo(0.085115, -0.102385).threePointArc((0.116729, -0.054693), (0.099918, 0.000000)).lineTo(0.049342, 0.000000).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.070312)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
