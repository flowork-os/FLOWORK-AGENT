# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00364794" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.053264, 0.123920), (0.173684, 0.063158)).threePointArc((0.337668, 0.404438), (0.678947, 0.568421)).threePointArc((0.750000, 0.643973), (0.821053, 0.568421)).threePointArc((1.162332, 0.404438), (1.326316, 0.063158)).threePointArc((1.393473, 0.000000), (1.326316, -0.063158)).threePointArc((1.162332, -0.404438), (0.821053, -0.568421)).threePointArc((0.750000, -0.643973), (0.678947, -0.568421)).threePointArc((0.337668, -0.404438), (0.173684, -0.063158)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.132072, -0.048026).threePointArc((0.238125, -0.341454), (0.504276, -0.504276)).threePointArc((0.570312, -0.442173), (0.636349, -0.504276)).threePointArc((0.976962, -0.340613), (1.140625, 0.000000)).threePointArc((1.078521, 0.066036), (1.140625, 0.132072)).threePointArc((0.976962, 0.472686), (0.636349, 0.636349)).threePointArc((0.570312, 0.574245), (0.504276, 0.636349)).threePointArc((0.163663, 0.472686), (0.000000, 0.132072)).threePointArc((0.062104, 0.066036), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.576316, 0.072039).circle(0.372204)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.007812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
