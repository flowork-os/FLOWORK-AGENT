import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.000000, -0.562500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.007587, -0.018317), (0.025905, -0.025905)).lineTo(0.457648, -0.025905).threePointArc((0.475965, -0.018317), (0.483553, 0.000000)).lineTo(0.483553, 0.794408).threePointArc((0.475965, 0.812725), (0.457648, 0.820313)).lineTo(0.025905, 0.820313).threePointArc((0.007587, 0.812725), (0.000000, 0.794408)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.593750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.008238, -0.019887), (0.028125, -0.028125)).lineTo(0.525000, -0.028125).threePointArc((0.544887, -0.019887), (0.553125, 0.000000)).lineTo(0.553125, 0.862500).threePointArc((0.544887, 0.882387), (0.525000, 0.890625)).lineTo(0.028125, 0.890625).threePointArc((0.008238, 0.882387), (0.000000, 0.862500)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.030067, -0.006962), (0.056250, 0.009375)).lineTo(0.487500, 0.009375).threePointArc((0.507387, 0.017613), (0.515625, 0.037500)).lineTo(0.515625, 0.834375).threePointArc((0.505446, 0.849575), (0.487500, 0.853125)).lineTo(0.056250, 0.853125).threePointArc((0.042992, 0.847633), (0.037500, 0.834375)).lineTo(0.037500, 0.037500).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.171875)
solid=solid.union(solid1)

