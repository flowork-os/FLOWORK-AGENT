wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.066118, 0.000000).threePointArc((0.308553, 0.242434), (0.550987, 0.000000)).lineTo(0.606086, 0.000000).lineTo(0.606086, 0.738322).threePointArc((0.303043, 1.041365), (0.000000, 0.738322)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.205319, 0.230775), (0.506908, 0.297533)).lineTo(0.506908, 0.738322).threePointArc((0.303043, 0.942187), (0.099178, 0.738322)).lineTo(0.099178, 0.297533).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
