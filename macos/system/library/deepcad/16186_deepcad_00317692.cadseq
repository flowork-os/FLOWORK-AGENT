import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.648438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.406250, 0.029605).lineTo(1.406250, 1.273026).lineTo(0.976974, 1.273026).lineTo(0.976974, 0.473684).lineTo(0.414474, 0.473684).lineTo(0.414474, 0.902961).lineTo(0.000000, 0.902961).lineTo(0.000000, 0.444079).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.414062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
