wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.280263, 0.000000).threePointArc((0.554688, 0.274424), (0.829112, 0.000000)).lineTo(1.109375, 0.000000).lineTo(1.109375, 0.046711).lineTo(0.887500, 0.046711).threePointArc((0.554688, 0.333797), (0.221875, 0.046711)).lineTo(0.000000, 0.046711).lineTo(0.000000, 0.000000).close()
