# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239453" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.828125, 0.000000).lineTo(0.828125, 0.775822).lineTo(0.000000, 0.775822).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.801974, 0.026151).lineTo(0.801974, 0.749671).lineTo(0.026151, 0.749671).lineTo(0.026151, 0.026151).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.296875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.781250, 0.000000).lineTo(0.781250, 0.723684).lineTo(0.000000, 0.723684).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.828125, 0.000000).lineTo(0.828125, 0.775822).lineTo(0.000000, 0.775822).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.801974, 0.026151).lineTo(0.801974, 0.749671).lineTo(0.026151, 0.749671).lineTo(0.026151, 0.026151).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.023438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, -0.648438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.340461, 0.000000).lineTo(0.340461, 0.351562).lineTo(0.000000, 0.351562).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.132812)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
