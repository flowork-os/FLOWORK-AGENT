# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00295085" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.000000, 0.000000).lineTo(1.000000, 1.000000).lineTo(0.000000, 1.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.109375, 0.250000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.138264, -0.251209), (0.389474, -0.389474)).lineTo(0.610526, -0.389474).threePointArc((0.861736, -0.251209), (1.000000, 0.000000)).lineTo(1.000000, 0.221053).threePointArc((0.861736, 0.472262), (0.610526, 0.610526)).lineTo(0.389474, 0.610526).threePointArc((0.138264, 0.472262), (0.000000, 0.221053)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.505263, 0.115789).circle(0.473684)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.500000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.000000, 0.250000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.481579, 0.000000).circle(0.481579)
solid2=wp_sketch2.add(loop3).extrude(-0.101562)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.250000, 0.101562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.500000, 0.000000).lineTo(0.500000, 0.052632).lineTo(0.000000, 0.052632).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(-1.000000)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
