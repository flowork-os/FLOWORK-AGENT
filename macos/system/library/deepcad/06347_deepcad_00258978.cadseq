import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).threePointArc((1.487663, 0.206572), (1.452632, 0.410526)).threePointArc((1.414242, 0.494703), (1.342105, 0.552632)).threePointArc((0.750000, 0.677981), (0.157895, 0.552632)).threePointArc((0.085758, 0.494703), (0.047368, 0.410526)).threePointArc((0.012337, 0.206572), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.164062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
