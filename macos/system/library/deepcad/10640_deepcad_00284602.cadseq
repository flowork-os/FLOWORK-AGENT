# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284602" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, 0.742188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, -0.031250).threePointArc((0.660025, -1.933201), (0.046875, -0.015625)).lineTo(0.046875, 0.015625).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.218750, -0.734375).circle(0.078125)
loop2=wp_sketch0.moveTo(0.218750, -0.953125).circle(0.046875)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
