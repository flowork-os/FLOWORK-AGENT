# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00280739" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013513, -0.032622), (0.046135, -0.046135)).lineTo(1.261020, -0.046135).threePointArc((1.468627, 0.161472), (1.261020, 0.369079)).lineTo(0.046135, 0.369079).threePointArc((0.013513, 0.355566), (0.000000, 0.322944)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.014967, 0.061513).threePointArc((1.114926, 0.161472), (1.014967, 0.261431)).lineTo(0.307566, 0.261431).threePointArc((0.207607, 0.161472), (0.307566, 0.061513)).close()
loop2=wp_sketch0.moveTo(1.261020, 0.169161).circle(0.092270)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.453125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.090789, 0.000000).circle(0.088898)
solid1=wp_sketch1.add(loop3).extrude(0.125000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.453125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.090789, 0.000000).circle(0.088898)
solid2=wp_sketch2.add(loop4).extrude(0.203125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
