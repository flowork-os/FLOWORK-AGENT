# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00261787" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.296053, -0.513158).lineTo(0.710526, -0.513158).lineTo(0.769737, -0.384868).lineTo(0.937500, 0.009868).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.539062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.226562, 0.002385).lineTo(0.226562, 0.138322).lineTo(0.057237, 0.135937).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.539062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
