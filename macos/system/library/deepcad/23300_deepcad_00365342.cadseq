import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.257812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.063158).lineTo(1.373684, 0.063158).lineTo(1.373684, 0.252632).threePointArc((1.318421, 0.307895), (1.263158, 0.252632)).lineTo(1.263158, 0.063158).lineTo(0.236842, 0.063158).lineTo(0.236842, 0.252632).threePointArc((0.181579, 0.307895), (0.126316, 0.252632)).lineTo(0.126316, 0.063158).lineTo(0.000000, 0.063158).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.173684, 0.252632).circle(0.031579)
loop2=wp_sketch0.moveTo(1.326316, 0.252632).circle(0.031579)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.062500, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
