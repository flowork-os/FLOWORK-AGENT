import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.562500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.332237, 0.000000).threePointArc((0.394531, -0.039985), (0.456826, 0.000000)).lineTo(0.789062, 0.000000).lineTo(0.789062, 0.058141).lineTo(0.456826, 0.058141).threePointArc((0.394531, 0.098127), (0.332237, 0.058141)).lineTo(0.000000, 0.058141).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.398684, 0.033224).circle(0.049836)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
