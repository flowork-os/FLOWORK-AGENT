import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.398438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.027748, -0.066989), (0.094737, -0.094737)).lineTo(1.405263, -0.094737).threePointArc((1.472252, -0.066989), (1.500000, 0.000000)).lineTo(1.500000, 0.789474).threePointArc((1.472252, 0.856463), (1.405263, 0.884211)).lineTo(0.094737, 0.884211).threePointArc((0.027748, 0.856463), (0.000000, 0.789474)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.094737, 0.000000).circle(0.047368)
loop2=wp_sketch0.moveTo(0.094737, 0.789474).circle(0.047368)
loop3=wp_sketch0.moveTo(1.405263, 0.000000).circle(0.047368)
loop4=wp_sketch0.moveTo(1.405263, 0.789474).circle(0.047368)
