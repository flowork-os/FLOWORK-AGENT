# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00310786" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.085526, 0.000000).lineTo(0.085526, 0.059868).lineTo(0.320724, 0.059868).lineTo(0.320724, 0.000000).lineTo(0.406250, 0.000000).lineTo(0.406250, 0.145395).lineTo(0.320724, 0.145395).lineTo(0.320724, 0.205263).lineTo(0.085526, 0.205263).lineTo(0.085526, 0.145395).lineTo(0.000000, 0.145395).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, -0.593750, 0.187500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.059211, 0.000000).circle(0.059211)
solid1=wp_sketch1.add(loop1).extrude(-0.234375)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, -0.156250, 0.187500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.059211, 0.000000).circle(0.059211)
solid2=wp_sketch2.add(loop2).extrude(-0.234375)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
