loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.023482, 0.042289), (0.044326, 0.085938)).threePointArc((0.018993, 0.044604), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(0.453125)
