# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.026046, -0.043720), (0.045395, -0.090789)).threePointArc((0.688487, -0.455097), (1.331579, -0.090789)).threePointArc((1.350928, -0.043720), (1.376974, 0.000000)).threePointArc((0.688487, 1.044207), (0.000000, 0.000000)).close()
loop5=wp_sketch4.moveTo(0.680921, 0.302632).circle(0.529605)
