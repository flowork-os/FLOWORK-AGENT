# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00328826" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.617188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.554688, 0.000000).lineTo(0.554688, 0.326974).lineTo(0.000000, 0.326974).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.543010, 0.011678).lineTo(0.543010, 0.315296).lineTo(0.023355, 0.315296).lineTo(0.023355, 0.011678).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.523438, 0.000000).lineTo(0.523438, 0.033059).lineTo(0.000000, 0.033059).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.304688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.484375, 0.070312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.011842, 0.000000).circle(0.011595)
solid2=wp_sketch2.add(loop3).extrude(-0.109375)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.437500, 0.070312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.011842, 0.000000).circle(0.011595)
solid3=wp_sketch3.add(loop4).extrude(-0.109375)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
