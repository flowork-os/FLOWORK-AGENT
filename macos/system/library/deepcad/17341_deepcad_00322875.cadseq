# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322875" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, -0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.670312, 0.000000).lineTo(0.670312, 0.646793).lineTo(0.329276, 1.117188).lineTo(0.000000, 0.646793).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.176398, 0.223438).circle(0.070559)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.578125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
