# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00336188" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.296875, 0.000000).lineTo(1.296875, 0.286678).lineTo(0.000000, 0.286678).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.228618, 0.068257).lineTo(1.228618, 0.218421).lineTo(0.068257, 0.218421).lineTo(0.068257, 0.068257).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.718750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
