import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.068257, -0.286678).lineTo(1.296875, -0.286678).lineTo(1.296875, 0.327632).lineTo(1.146711, 0.600658).lineTo(0.887336, 0.600658).lineTo(0.778125, 0.477796).lineTo(0.464145, 0.477796).lineTo(0.423191, 0.327632).lineTo(0.054605, 0.191118).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
