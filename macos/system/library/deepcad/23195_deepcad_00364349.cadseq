# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00364349" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).lineTo(0.757895, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.268421, 0.947368).lineTo(0.268421, 0.331579).lineTo(0.110526, 0.315789).lineTo(0.110526, 0.205263).lineTo(0.600000, 0.205263).lineTo(0.600000, 0.315789).lineTo(0.442105, 0.331579).lineTo(0.442105, 1.121053).lineTo(0.110526, 1.057895).lineTo(0.110526, 0.947368).close()
loop2=wp_sketch0.moveTo(0.378947, 1.389474).circle(0.063158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.157895, 0.000000).lineTo(0.157895, -0.623684).lineTo(0.000000, -0.639474).lineTo(0.000000, -0.750000).lineTo(0.497368, -0.750000).lineTo(0.497368, -0.639474).lineTo(0.339474, -0.623684).lineTo(0.339474, 0.165789).lineTo(0.000000, 0.102632).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.157895, 0.000000).lineTo(0.157895, -0.623684).lineTo(0.000000, -0.639474).lineTo(0.000000, -0.750000).lineTo(0.497368, -0.750000).lineTo(0.497368, -0.639474).lineTo(0.339474, -0.623684).lineTo(0.339474, 0.165789).lineTo(0.000000, 0.102632).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.046875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
