# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231437" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.015625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.734375, 0.000000).lineTo(0.734375, 0.742188).lineTo(0.000000, 0.742188).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.703125, 0.046875).lineTo(0.703125, 0.695312).lineTo(0.031250, 0.695312).lineTo(0.031250, 0.046875).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.031250, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.703125, 0.000000).lineTo(0.703125, 0.673520).lineTo(0.000000, 0.673520).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.688322, 0.014803).lineTo(0.688322, 0.658717).lineTo(0.014803, 0.658717).lineTo(0.014803, 0.014803).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.046875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
