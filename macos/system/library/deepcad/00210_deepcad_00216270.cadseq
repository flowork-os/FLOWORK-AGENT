# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00216270" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.281250, 0.000000).lineTo(0.281250, 0.044408).lineTo(0.000000, 0.044408).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.100658, 0.023684).circle(0.005921)
loop2=wp_sketch0.moveTo(0.139145, 0.023684).circle(0.005921)
loop3=wp_sketch0.moveTo(0.180592, 0.023684).circle(0.005921)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
