# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220726" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.219079, -0.219079), (0.438158, 0.000000)).lineTo(0.438158, 0.937171).threePointArc((0.219079, 1.156250), (0.000000, 0.937171)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.219079, 0.000000).circle(0.097368)
loop2=wp_sketch0.moveTo(0.219079, 0.937171).circle(0.097368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.281250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.218750, 0.000000, -0.414062), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.218750, -0.218750), (0.437500, 0.000000)).threePointArc((0.218750, 0.216082), (0.000000, 0.000000)).close()
loop4=wp_sketch1.moveTo(0.221053, 0.000000).circle(0.092105)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.468750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
