# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00275588" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.570312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.140489, -0.267725), (0.112253, -0.568750)).lineTo(0.366694, -0.568750).lineTo(0.710938, -0.568750).lineTo(0.710938, 0.179605).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.617188, -0.305345).lineTo(0.617188, 0.045477).lineTo(0.266365, 0.045477).lineTo(0.019490, 0.045477).threePointArc((0.010303, 0.022499), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.132812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, -0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.710938, -0.179605).lineTo(0.097286, 0.127220).threePointArc((0.053335, 0.060022), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.132812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.382812, -0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.153503, 0.554688), (0.000000, 1.109375)).lineTo(0.000000, 0.362007).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.132812)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
