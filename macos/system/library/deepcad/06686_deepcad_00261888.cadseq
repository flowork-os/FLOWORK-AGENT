# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00261888" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.754852, -0.112664).threePointArc((1.075946, 0.208429), (0.754852, 0.529523)).lineTo(0.011266, 0.360526).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.642188, 0.090132).circle(0.022533)
loop2=wp_sketch0.moveTo(0.642188, 0.315461).circle(0.022533)
loop3=wp_sketch0.moveTo(0.754852, 0.202796).circle(0.090132)
loop4=wp_sketch0.moveTo(0.867516, 0.090132).circle(0.022533)
loop5=wp_sketch0.moveTo(0.867516, 0.315461).circle(0.022533)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
