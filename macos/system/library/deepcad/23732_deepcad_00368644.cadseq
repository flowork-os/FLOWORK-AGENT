import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000385, -0.000930), (0.001316, -0.001316)).lineTo(0.029934, -0.001316).threePointArc((0.030865, -0.000930), (0.031250, 0.000000)).lineTo(0.031250, 0.028618).threePointArc((0.030865, 0.029549), (0.029934, 0.029934)).lineTo(0.001316, 0.029934).threePointArc((0.000385, 0.029549), (0.000000, 0.028618)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001548, -0.000449), (0.002961, 0.000329)).lineTo(0.028289, 0.000329).threePointArc((0.029220, 0.000714), (0.029605, 0.001645)).lineTo(0.029605, 0.027303).threePointArc((0.029152, 0.028069), (0.028289, 0.028289)).lineTo(0.002961, 0.028289).threePointArc((0.002098, 0.028069), (0.001645, 0.027303)).lineTo(0.001645, 0.001645).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
