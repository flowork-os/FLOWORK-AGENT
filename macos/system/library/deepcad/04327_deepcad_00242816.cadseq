# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, 0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.176151, -0.058717).lineTo(0.176151, -0.244655).lineTo(0.176151, -0.753536).lineTo(0.176151, -0.929687).lineTo(0.616530, -0.929687).lineTo(0.616530, -0.753536).lineTo(0.616530, -0.176151).lineTo(0.616530, 0.000000).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.401234, -0.499095).circle(0.088076)
