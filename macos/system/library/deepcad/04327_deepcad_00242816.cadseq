import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.523438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.322944, 0.000000).lineTo(0.322944, 0.176151).lineTo(0.322944, 0.685033).lineTo(0.322944, 0.929687).lineTo(0.000000, 0.929687).lineTo(0.000000, 0.636102).lineTo(0.234868, 0.636102).lineTo(0.234868, 0.352303).lineTo(0.000000, 0.293586).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.179688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.367188, -0.523438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.322944, 0.000000).lineTo(0.322944, 0.352303).lineTo(0.088076, 0.352303).lineTo(0.088076, 0.577385).lineTo(0.322944, 0.577385).lineTo(0.322944, 0.929687).lineTo(0.000000, 0.929687).lineTo(0.000000, 0.753536).lineTo(0.000000, 0.176151).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.179688)
