# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00324744" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.875000, 0.000000).lineTo(0.875000, 0.746053).lineTo(0.000000, 0.746053).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.036842, 0.101316).circle(0.027632)
loop2=wp_sketch0.moveTo(0.442105, 0.561842).circle(0.027632)
loop3=wp_sketch0.moveTo(0.838158, 0.101316).circle(0.027632)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(-0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
