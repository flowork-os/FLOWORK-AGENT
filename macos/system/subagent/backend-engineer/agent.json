{
  "$schema": "https://floworkos.com/schemas/agent.v2.json",
  "id": "backend-engineer",
  "agent_id": "agent-backend-engineer-01",
  "name": "Backend Engineer",
  "role": "Backend & Systems Specialist",
  "icon": "⚙️",
  "department": "engineering",
  "description": "Specialist in core backend logic, REST/IPC APIs, database schemas, server algorithms, and multi-OS system portability. Strictly isolated to logic files only.",
  "owner": "Awenk Audico",
  "allowed_tools": [
    "run_command",
    "view_file",
    "write_to_file",
    "replace_file_content",
    "team_dispatch",
    "manage_task",
    "read_url_content"
  ],
  "default_tools": [
    "run_command",
    "view_file",
    "write_to_file",
    "replace_file_content",
    "team_dispatch",
    "manage_task"
  ],
  "locked_tools": [
    "render_visual",
    "generate_image",
    "screenshot",
    "app_publish"
  ],
  "guardian": {
    "dispatch": {
      "allow": [
        "frontend-engineer",
        "security-auditor",
        "quality-control",
        "leader",
        "mr.flow"
      ],
      "deny": []
    },
    "tools": {
      "allow": [
        "run_command",
        "view_file",
        "write_to_file",
        "replace_file_content",
        "team_dispatch",
        "manage_task",
        "read_url_content"
      ],
      "deny": [
        "render_visual",
        "generate_image",
        "screenshot",
        "app_publish"
      ]
    },
    "filesystem": {
      "allowed_extensions": [
        ".rs",
        ".go",
        ".py",
        ".ts",
        ".js",
        ".sql",
        ".json",
        ".toml",
        ".yaml",
        ".yml",
        ".proto",
        ".md"
      ],
      "prohibited_extensions": [
        ".html",
        ".css",
        ".vue",
        ".svelte",
        ".jsx",
        ".tsx",
        ".lock",
        ".env",
        ".pem",
        ".key",
        ".bin",
        ".exe",
        ".so"
      ]
    }
  },
  "pinned_model": {
    "model_id": "gemini-3.8-flash-high",
    "fallback_model_id": "gemini-3.8-flash-high",
    "temperature": 0.2,
    "enforce_lock": false
  },
  "pinned_account": {
    "account_id": "combo",
    "pool_strategy": "combo",
    "required_tier": "free",
    "isolated_profile": false
  },
  "harness": {
    "output_token_budget": 800,
    "max_summary_chars": 3200,
    "format_contract": "diff_and_terminal_proof",
    "compression_mode": "diff_preserving_head_tail"
  }
}
