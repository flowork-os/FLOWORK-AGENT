{
  "name": "yt_media_forge",
  "category": "media",
  "description": "Sovereign video and audio synthesizer engine. Generates zero-cost high quality neural voiceovers using Edge-TTS, creates automated kinetic subtitles (.ass/.srt), stitches media scenes with Ken Burns pan/zoom effects, and renders 1080p horizontal or vertical 9:16 Shorts via native FFmpeg subprocess.",
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "description": "Action to perform: 'synthesize_audio', 'render_video', 'render_short', 'status'",
        "enum": [
          "synthesize_audio",
          "render_video",
          "render_short",
          "status"
        ]
      },
      "script_text": {
        "type": "string",
        "description": "Text script for voiceover synthesis"
      },
      "voice": {
        "type": "string",
        "description": "Edge-TTS voice name, e.g. 'id-ID-GadisNeural', 'id-ID-ArdiNeural', 'en-US-ChristopherNeural', 'en-US-JennyNeural'. Default: 'id-ID-GadisNeural'"
      },
      "scenes": {
        "type": "array",
        "description": "List of scene image paths or color descriptions with durations",
        "items": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string",
              "description": "Absolute or relative path to image"
            },
            "duration": {
              "type": "number",
              "description": "Duration in seconds"
            }
          }
        }
      },
      "audio_path": {
        "type": "string",
        "description": "Path to audio voiceover file for video rendering"
      },
      "output_path": {
        "type": "string",
        "description": "Destination path for rendered video (MP4)"
      },
      "title": {
        "type": "string",
        "description": "Title overlay on the video"
      }
    },
    "required": [
      "action"
    ]
  },
  "command": "python3 engine.py",
  "version": "1.0.0",
  "author": "Flowork OS Sovereign Media Team",
  "keywords": [
    "youtube",
    "video_render",
    "ffmpeg",
    "edge_tts",
    "audio_synthesis",
    "shorts",
    "automation"
  ]
}