[Desktop Entry]
Version=1.0
Type=Application
Name=Install Flowork Agent (Portable)
GenericName=AI Agent Installer
Comment=Install Flowork OS Sovereign AI Agent into this folder
Exec=bash -c 'DIR="$(pwd)"; echo "=========================================================="; echo "  ⚡ FLOWORK OS — PORTABLE AGENT INSTALLER (LINUX) ⚡"; echo "=========================================================="; echo "[Portable Mode] Installing in: $DIR"; curl -fsSL https://raw.githubusercontent.com/flowork-os/FLOWORK-AGENT/main/linux/install.sh | bash -s -- "$DIR"; echo ""; read -p "Installation complete. Press Enter to exit..." dummy'
Icon=system-software-install
Terminal=true
Categories=Utility;Development;
StartupNotify=true
