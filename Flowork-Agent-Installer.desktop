[Desktop Entry]
Version=1.0
Type=Application
Name=Flowork Agent Installer
Comment=Install Flowork Sovereign Multi-OS Agent
Exec=bash -c 'DIR="$(cd "$(dirname "$1")" 2>/dev/null && pwd)"; if [ -f "$DIR/install.sh" ]; then exec "$DIR/install.sh" "$DIR"; else curl -fsSL https://raw.githubusercontent.com/flowork-os/FLOWORK-AGENT/main/install.sh | bash; fi' _ %k
Icon=flowork
Terminal=true
Categories=Development;
StartupNotify=true
