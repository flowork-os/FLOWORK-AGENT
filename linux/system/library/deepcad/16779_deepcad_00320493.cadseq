# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00320493" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.093750, -0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.011842, 0.000000).lineTo(0.011842, 0.001974).lineTo(0.001974, 0.001974).lineTo(0.001974, 0.025658).lineTo(0.185526, 0.025658).lineTo(0.185526, 0.001974).lineTo(0.175658, 0.001974).lineTo(0.175658, 0.000000).lineTo(0.187500, 0.000000).lineTo(0.187500, 0.027632).lineTo(0.000000, 0.027632).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, -0.093750, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.093750, 0.000000).lineTo(0.093750, 0.028618).lineTo(0.078947, 0.028618).threePointArc((0.081061, 0.027050), (0.079934, 0.024671)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.234375)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
