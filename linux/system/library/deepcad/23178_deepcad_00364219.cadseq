# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00364219" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.402632, 0.000000).lineTo(0.402632, 0.205263).lineTo(0.631579, 0.205263).lineTo(0.631579, 0.000000).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.402632).lineTo(0.118421, 0.402632).lineTo(0.118421, 0.473684).lineTo(0.000000, 0.473684).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.394737, 0.007895).lineTo(0.394737, 0.394737).lineTo(0.118421, 0.394737).lineTo(0.118421, 0.465789).lineTo(0.007895, 0.465789).lineTo(0.007895, 0.007895).close()
loop2=wp_sketch0.moveTo(0.631579, 0.205263).lineTo(0.631579, 0.394737).lineTo(0.402632, 0.394737).lineTo(0.402632, 0.205263).close()
loop3=wp_sketch0.moveTo(0.742105, 0.007895).lineTo(0.742105, 0.394737).lineTo(0.631579, 0.394737).lineTo(0.631579, 0.007895).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.117188, 0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.171875, 0.000000).lineTo(0.171875, 0.171875).lineTo(0.000000, 0.171875).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(0.166447, 0.005428).lineTo(0.166447, 0.166447).lineTo(0.005428, 0.166447).lineTo(0.005428, 0.005428).close()
solid1=wp_sketch1.add(loop4).add(loop5).extrude(0.054688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
