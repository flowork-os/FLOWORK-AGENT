# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00277479" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.031250, 0.000000).lineTo(1.031250, 0.640461).lineTo(0.000000, 0.640461).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.987829, 0.043421).lineTo(0.987829, 0.597039).lineTo(0.043421, 0.597039).lineTo(0.043421, 0.043421).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.945312, 0.000000).lineTo(0.945312, 0.547286).lineTo(0.000000, 0.547286).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.915461, 0.029852).lineTo(0.915461, 0.507484).lineTo(0.029852, 0.507484).lineTo(0.029852, 0.029852).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.007812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
