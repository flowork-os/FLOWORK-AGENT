# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00361162" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.359375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.325658, 0.000000).lineTo(0.325658, 0.375000).lineTo(0.325658, 0.468750).lineTo(0.236842, 0.468750).lineTo(0.000000, 0.468750).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.236842, 0.375000).circle(0.039474)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, -0.101562, 0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.039474, 0.000000).circle(0.038651)
solid1=wp_sketch1.add(loop2).extrude(-0.500000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.101562, 0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.071053, 0.000000).circle(0.071053)
loop4=wp_sketch2.moveTo(0.071053, 0.000000).circle(0.041447)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.273438)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
