loop2=wp_sketch2.moveTo(0.292105, 0.000000).lineTo(0.292105, 0.121711).lineTo(1.046711, 0.121711).lineTo(1.046711, 0.000000).lineTo(1.156250, 0.000000).lineTo(1.156250, 0.231250).lineTo(0.925000, 0.231250).lineTo(0.231250, 0.231250).lineTo(0.000000, 0.231250).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.750000)
