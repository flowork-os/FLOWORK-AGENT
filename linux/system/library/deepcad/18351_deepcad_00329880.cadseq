import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.569819, 0.000000).lineTo(0.569819, 0.152878).lineTo(1.209128, 0.152878).threePointArc((1.268818, 0.100513), (1.236924, 0.027796)).lineTo(1.320312, 0.083388).lineTo(1.320312, 0.319655).lineTo(0.403043, 0.319655).lineTo(0.403043, 0.166776).lineTo(0.000000, 0.166776).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.289062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
