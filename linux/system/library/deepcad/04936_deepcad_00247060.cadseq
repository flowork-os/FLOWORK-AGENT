import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.229688, 0.000000).lineTo(0.382813, 0.000000).lineTo(0.382813, 0.245806).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.079030, 0.000000).lineTo(0.079030, 0.242188).lineTo(0.000000, 0.242188).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.164062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.164062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.242188, 0.000000).lineTo(0.122368, 0.206497).lineTo(0.000000, 0.206497).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.078125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.078289, 0.000000).lineTo(0.078289, 0.437500).lineTo(0.000000, 0.437500).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.078125)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.142105, 0.000000).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.434211).lineTo(0.600000, 0.434211).lineTo(0.000000, 0.276316).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch4.moveTo(0.142105, 0.142105).circle(0.055263)
solid4=wp_sketch4.add(loop4).add(loop5).extrude(0.078125)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
