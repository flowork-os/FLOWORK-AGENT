wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.402344, -0.402344), (0.804688, 0.000000)).lineTo(0.804688, 0.474342).lineTo(0.796217, 0.474342).lineTo(0.796217, 0.000000).threePointArc((0.402344, -0.393873), (0.008470, 0.000000)).lineTo(0.008470, 0.474342).lineTo(0.000000, 0.474342).lineTo(0.000000, 0.000000).close()
