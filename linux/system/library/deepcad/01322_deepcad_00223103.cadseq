# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00223103" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.218750, 0.000000).lineTo(1.218750, 0.564474).lineTo(0.000000, 0.564474).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.007812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.375000, 0.000000).circle(0.375000)
solid1=wp_sketch1.add(loop1).extrude(0.500000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.125000, 0.000000, 0.500000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.256579, 0.000000).circle(0.256579)
solid2=wp_sketch2.add(loop2).extrude(-0.500000)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.007812, -0.031250, 0.125000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.492187, 0.000000).lineTo(0.492187, 0.056990).lineTo(0.000000, 0.056990).threePointArc((-0.001050, 0.028495), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(0.375000)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, -0.031250, 0.125000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.500000, 0.000000).threePointArc((0.501066, 0.028947), (0.500000, 0.057895)).lineTo(0.000000, 0.057895).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.375000)
solid=solid.union(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.125000, -0.031250, 0.500000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch5.moveTo(0.367188, 0.000000).lineTo(0.367188, 0.057977).lineTo(0.000000, 0.057977).threePointArc((-0.001602, 0.028988), (0.000000, 0.000000)).close()
solid5=wp_sketch5.add(loop5).extrude(-0.500000)
solid=solid.cut(solid5)
# workplane for sketch 6
wp_sketch6 = cq.Workplane(cq.Plane(cq.Vector(0.125000, -0.031250, 0.500000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch6.moveTo(0.374178, 0.000000).lineTo(0.374178, 0.058799).lineTo(0.000000, 0.058799).threePointArc((0.531837, 0.029400), (0.000000, 0.000000)).close()
solid6=wp_sketch6.add(loop6).extrude(-0.500000)
solid=solid.cut(solid6)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
