# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00356253" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.464803, -0.400247).lineTo(1.226562, -0.335691).lineTo(1.226562, 0.426069).lineTo(0.335691, 0.426069).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.348602, 0.038734).circle(0.129112)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.257812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
