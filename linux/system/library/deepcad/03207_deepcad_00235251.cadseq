# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00235251" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.257812, 0.031250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.018997, -0.024424).threePointArc((0.028938, -0.030933), (0.040707, -0.032566)).lineTo(0.257812, -0.032566).lineTo(0.257812, -0.013569).lineTo(0.040707, -0.013569).threePointArc((0.036332, -0.013126), (0.032566, -0.010855)).lineTo(0.013569, 0.010855).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.562500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.108553, 0.000000).lineTo(0.108553, 0.217105).lineTo(0.099507, 0.217105).lineTo(0.099507, 0.262336).lineTo(0.687500, 0.262336).lineTo(0.687500, 0.217105).lineTo(0.678454, 0.217105).lineTo(0.678454, 0.000000).lineTo(0.859375, 0.000000).lineTo(0.859375, 0.470395).lineTo(0.000000, 0.470395).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
