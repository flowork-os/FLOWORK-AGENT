import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.382812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.259211, 0.000000).threePointArc((1.379800, 0.318421), (1.259211, 0.636842)).lineTo(0.000000, 0.636842).threePointArc((-0.120589, 0.318421), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(1.186842, 0.188158).lineTo(1.186842, 0.578947).lineTo(0.057895, 0.578947).lineTo(0.057895, 0.188158).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
