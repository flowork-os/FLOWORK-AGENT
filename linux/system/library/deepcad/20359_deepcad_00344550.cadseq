import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, -0.343750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.022882, -0.055243), (0.078125, -0.078125)).lineTo(1.406250, -0.078125).threePointArc((1.461493, -0.055243), (1.484375, 0.000000)).lineTo(1.484375, 0.656250).threePointArc((1.461493, 0.711493), (1.406250, 0.734375)).lineTo(0.078125, 0.734375).threePointArc((0.022882, 0.711493), (0.000000, 0.656250)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.289062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
