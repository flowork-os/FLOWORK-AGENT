# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00307464" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.523438, 0.000000).lineTo(0.523438, 0.170806).lineTo(0.352632, 0.170806).lineTo(0.352632, 0.341612).lineTo(0.170806, 0.341612).lineTo(0.170806, 0.457319).lineTo(0.000000, 0.457319).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.507812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.523438, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.168750, 0.000000).lineTo(0.168750, 0.281250).lineTo(0.000000, 0.281250).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.226562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
