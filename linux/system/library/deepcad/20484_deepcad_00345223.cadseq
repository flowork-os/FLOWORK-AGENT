# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00345223" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, -0.515625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.429688, 0.000000).lineTo(0.722368, 1.023355).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.054688, -0.656250, -0.437500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(0.817585, 0.000000, 0.575808)))
loop1=wp_sketch1.moveTo(1.312500, 0.000000).lineTo(1.312500, 1.063816).lineTo(0.000000, 1.063816).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.187500)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, -0.656250, -0.437500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(0.817585, 0.000000, 0.575808)))
loop2=wp_sketch2.moveTo(1.312500, 0.000000).lineTo(1.312500, 1.063816).lineTo(0.000000, 1.063816).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.187500)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
