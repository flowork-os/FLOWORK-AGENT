# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00315341" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.105592, 0.000000).lineTo(0.105592, 0.730345).lineTo(0.316776, 0.730345).lineTo(0.316776, 0.835938).lineTo(0.000000, 0.835938).lineTo(0.000000, 0.730345).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.052796, 0.783141).circle(0.017599)
loop2=wp_sketch0.moveTo(0.263980, 0.783141).circle(0.017599)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.030921, 0.000000).lineTo(0.030921, 0.734375).lineTo(0.000000, 0.734375).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.101562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
