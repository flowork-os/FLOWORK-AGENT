# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257289" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.585938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.584211).lineTo(0.000000, 0.584211).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.236842, 0.315789).circle(0.023684)
loop2=wp_sketch0.moveTo(0.378947, 0.315789).circle(0.071053)
loop3=wp_sketch0.moveTo(0.378947, 0.197368).circle(0.023684)
loop4=wp_sketch0.moveTo(0.378947, 0.434211).circle(0.023684)
loop5=wp_sketch0.moveTo(0.513158, 0.315789).circle(0.023684)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.593750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.085938, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.094079, 0.000000).lineTo(0.094079, 0.203125).lineTo(0.000000, 0.203125).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop6).extrude(0.593750)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.539062, -0.515625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch2.moveTo(0.140625, 0.000000).lineTo(0.140625, 0.118421).lineTo(0.000000, 0.118421).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop7).extrude(0.593750)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
