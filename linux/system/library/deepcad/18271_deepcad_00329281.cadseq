# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00329281" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.343750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.320312, 0.000000).lineTo(1.320312, 0.208470).lineTo(0.889474, 0.208470).lineTo(0.889474, 0.444737).lineTo(0.430839, 0.444737).lineTo(0.430839, 0.667105).lineTo(0.000000, 0.667105).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.398438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
