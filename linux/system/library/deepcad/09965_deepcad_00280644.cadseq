import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.442105, 0.000000).threePointArc((0.515445, 0.050690), (0.600000, 0.078947)).lineTo(0.757895, 0.078947).lineTo(0.900000, 0.078947).threePointArc((0.976661, 0.049568), (1.042105, 0.000000)).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.221053).lineTo(1.042105, 0.221053).threePointArc((0.975539, 0.179379), (0.900000, 0.157895)).lineTo(0.757895, 0.157895).lineTo(0.600000, 0.157895).threePointArc((0.516566, 0.178258), (0.442105, 0.221053)).lineTo(0.000000, 0.221053).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
