# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306575" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.515625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.234128, 0.000000).lineTo(0.234128, 0.211678).threePointArc((0.141118, 0.304688), (0.048109, 0.211678)).threePointArc((0.035792, 0.103171), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.141118, 0.211678).circle(0.048109)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.234128, 0.000000).threePointArc((0.199940, 0.103349), (0.189227, 0.211678)).threePointArc((0.094613, 0.306291), (0.000000, 0.211678)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.093010, 0.211678).circle(0.048109)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.117188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.118421).lineTo(0.513158, 0.118421).lineTo(0.236842, 0.118421).lineTo(0.000000, 0.118421).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.335938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
