# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00249683" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.746299, 0.000000).threePointArc((0.940337, 0.194038), (0.746299, 0.388076)).lineTo(0.000000, 0.388076).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.746299, 0.199013).circle(0.019901)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
