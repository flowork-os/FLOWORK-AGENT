wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.492188, 0.000000).lineTo(1.492188, 0.125658).lineTo(1.178043, 0.125658).lineTo(1.178043, 0.376974).lineTo(1.052385, 0.376974).lineTo(0.801069, 0.251316).lineTo(0.801069, 0.125658).lineTo(0.691118, 0.125658).lineTo(0.691118, 0.251316).lineTo(0.439803, 0.376974).lineTo(0.314145, 0.376974).lineTo(0.314145, 0.125658).lineTo(0.000000, 0.125658).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.742188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
