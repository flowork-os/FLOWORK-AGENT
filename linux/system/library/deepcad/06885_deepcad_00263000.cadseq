import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, -0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.013651, -0.006826).lineTo(0.348109, 0.580181).lineTo(0.354934, 0.593832).lineTo(0.382237, 0.634786).lineTo(0.375411, 0.648438).lineTo(0.000000, 0.000000).close()
