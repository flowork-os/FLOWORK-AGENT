solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.632812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.341283, -0.593832).lineTo(0.348109, -0.600658).lineTo(0.375411, -0.648438).lineTo(0.389063, -0.641612).lineTo(0.013651, 0.006826).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.007895).lineTo(0.063158, 0.007895).lineTo(0.007895, 0.007895).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.750000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.054687, 0.000000).lineTo(0.027632, 0.047204).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.750000)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.011842, 0.000000).circle(0.011842)
solid4=wp_sketch4.add(loop4).extrude(-0.750000)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
