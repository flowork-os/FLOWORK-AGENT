# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00223687" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, -0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.625000, 0.000000).threePointArc((0.517099, 0.243421), (0.625000, 0.486842)).lineTo(0.000000, 0.486842).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.296875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.093750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.331579, 0.000000).circle(0.331579)
loop2=wp_sketch1.moveTo(0.331579, 0.000000).circle(0.255592)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.296875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.164062, 0.000000, 0.296875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.256579, 0.000000).circle(0.256579)
solid2=wp_sketch2.add(loop3).extrude(-0.242188)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, -0.242188, 0.296875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.625000, 0.000000).threePointArc((0.554029, 0.092508), (0.519737, 0.203947)).lineTo(0.098684, 0.203947).lineTo(0.098684, 0.276316).lineTo(0.519737, 0.276316).threePointArc((0.553437, 0.391044), (0.625000, 0.486842)).lineTo(0.000000, 0.486842).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(-0.242188)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
