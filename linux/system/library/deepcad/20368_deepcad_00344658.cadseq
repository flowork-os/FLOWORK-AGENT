# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00344658" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.195312, 0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.082895, 0.000000).circle(0.082895)
solid0=wp_sketch0.add(loop0).extrude(0.500000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.242188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.244737).lineTo(0.000000, 0.244737).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.686842, 0.071053).lineTo(0.686842, 0.173684).lineTo(0.086842, 0.173684).lineTo(0.086842, 0.071053).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.500000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.195312, 0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.082895, 0.000000).circle(0.082895)
solid2=wp_sketch2.add(loop3).extrude(0.351562)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.242188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.244737).lineTo(0.000000, 0.244737).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch3.moveTo(0.686842, 0.071053).lineTo(0.686842, 0.173684).lineTo(0.086842, 0.173684).lineTo(0.086842, 0.071053).close()
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.351562)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
