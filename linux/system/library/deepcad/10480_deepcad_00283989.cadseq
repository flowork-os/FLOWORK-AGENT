import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, -0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.658717, 0.000000).threePointArc((0.690118, 0.013007), (0.703125, 0.044408)).lineTo(0.703125, 0.606908).threePointArc((0.691651, 0.642010), (0.658717, 0.658717)).lineTo(0.000000, 0.658717).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.377467, 0.325658).circle(0.162829)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, -0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.013874, -0.033495), (0.047368, -0.047368)).lineTo(0.702632, -0.047368).threePointArc((0.736126, -0.033495), (0.750000, 0.000000)).lineTo(0.750000, 0.655263).threePointArc((0.736126, 0.688758), (0.702632, 0.702632)).lineTo(0.047368, 0.702632).threePointArc((0.013874, 0.688758), (0.000000, 0.655263)).lineTo(0.655263, 0.655263).threePointArc((0.688758, 0.641389), (0.702632, 0.607895)).lineTo(0.702632, 0.047368).threePointArc((0.688758, 0.013874), (0.655263, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.165789, 0.000000).circle(0.165789)
