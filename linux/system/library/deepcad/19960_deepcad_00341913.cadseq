# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00341913" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.042105, 0.000000).lineTo(1.042105, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.026316, 0.015789).lineTo(1.026316, 0.584211).lineTo(1.026316, 0.600000).lineTo(1.026316, 0.900000).lineTo(1.026316, 1.484211).lineTo(0.015789, 1.484211).lineTo(0.015789, 0.900000).lineTo(0.015789, 0.600000).lineTo(0.015789, 0.584211).lineTo(0.015789, 0.015789).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, -0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.012829, 0.000000).lineTo(0.012829, 0.333553).lineTo(0.596546, 0.333553).lineTo(0.596546, 0.000000).lineTo(0.609375, 0.000000).lineTo(0.609375, 0.346382).lineTo(0.000000, 0.346382).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.273438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(1.007812, 0.000000).lineTo(1.007812, 0.010609).lineTo(0.774424, 0.010609).lineTo(0.763816, 0.010609).lineTo(0.180345, 0.010609).lineTo(0.169737, 0.010609).lineTo(0.000000, 0.010609).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.273438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
