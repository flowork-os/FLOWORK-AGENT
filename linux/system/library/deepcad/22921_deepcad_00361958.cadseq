# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00361958" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, 0.000000, -0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, -0.279030).lineTo(0.712007, -0.279030).lineTo(0.914062, -0.076974).lineTo(0.914062, 0.211678).lineTo(0.846711, 0.279030).lineTo(0.914062, 0.356003).lineTo(0.914062, 0.644655).lineTo(0.712007, 0.846711).lineTo(0.000000, 0.846711).lineTo(0.000000, 0.567681).lineTo(0.076974, 0.567681).lineTo(0.076974, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.384868, 0.000000).lineTo(0.586924, 0.000000).lineTo(0.615789, 0.028865).lineTo(0.615789, 0.105839).lineTo(0.577303, 0.144326).lineTo(0.384868, 0.144326).close()
loop2=wp_sketch0.moveTo(0.586924, 0.423355).lineTo(0.615789, 0.452220).lineTo(0.615789, 0.519572).lineTo(0.577303, 0.567681).lineTo(0.384868, 0.567681).lineTo(0.384868, 0.423355).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.515625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.742105)
solid1=wp_sketch1.add(loop3).extrude(0.257812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
