# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00242625" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.189474).lineTo(0.000000, 0.189474).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.436842, 0.078947).lineTo(1.436842, 0.110526).lineTo(0.063158, 0.110526).lineTo(0.063158, 0.078947).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
