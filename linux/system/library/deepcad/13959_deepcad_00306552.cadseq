# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306552" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.450000).threePointArc((0.655263, 0.544737), (0.560526, 0.450000)).lineTo(0.560526, 0.189474).threePointArc((0.539715, 0.139232), (0.489474, 0.118421)).lineTo(0.260526, 0.118421).threePointArc((0.210285, 0.139232), (0.189474, 0.189474)).lineTo(0.189474, 0.450000).threePointArc((0.094737, 0.544737), (0.000000, 0.450000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.094737, 0.450000).circle(0.047368)
loop2=wp_sketch0.moveTo(0.655263, 0.450000).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.085938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.051172, -0.021196), (0.072368, -0.072368)).lineTo(0.072368, -0.164474).threePointArc((0.110003, -0.216623), (0.171053, -0.236842)).lineTo(0.453947, -0.236842).threePointArc((0.514997, -0.216623), (0.552632, -0.164474)).lineTo(0.552632, -0.072368).threePointArc((0.573828, -0.021196), (0.625000, 0.000000)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.453947, -0.164474).threePointArc((0.500000, -0.118421), (0.453947, -0.072368)).lineTo(0.171053, -0.072368).threePointArc((0.125000, -0.118421), (0.171053, -0.164474)).close()
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.117188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
