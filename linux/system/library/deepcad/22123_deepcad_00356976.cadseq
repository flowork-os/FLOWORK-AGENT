# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.359375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.197368, 0.000000).circle(0.193257)
loop4=wp_sketch2.moveTo(0.197368, 0.000000).circle(0.148026)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.257812)
