# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.059868, 0.000000).threePointArc((0.051057, 0.050781), (0.059868, 0.101562)).lineTo(0.000000, 0.101562).lineTo(0.000000, 0.000000).close()
