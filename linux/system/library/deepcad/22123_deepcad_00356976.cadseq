wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.098684, 0.018503).threePointArc((0.289476, 0.292969), (0.098684, 0.567434)).lineTo(0.000000, 0.585938).threePointArc((-0.292969, 0.292969), (0.000000, 0.000000)).close()
