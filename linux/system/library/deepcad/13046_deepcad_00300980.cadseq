# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00300980" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.647368)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.647368, 0.000000).circle(0.647368)
loop3=wp_sketch1.moveTo(0.930592, -0.445066).lineTo(0.701316, 0.000000).lineTo(0.930592, 0.445066).lineTo(0.350658, 0.445066).lineTo(0.579934, 0.000000).lineTo(0.350658, -0.445066).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.132812, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, -0.437500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.566859, 0.000000).lineTo(0.353125, 0.446053).lineTo(0.566859, 0.882812).lineTo(0.000000, 0.882812).lineTo(0.213734, 0.446053).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.164062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
