# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00292248" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.476562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.010333, -0.024946), (0.035280, -0.035280)).lineTo(1.046628, -0.035280).threePointArc((1.071575, -0.024946), (1.081908, 0.000000)).lineTo(1.081908, 0.023520).lineTo(1.081908, 1.081908).threePointArc((1.071575, 1.106854), (1.046628, 1.117188)).lineTo(0.035280, 1.117188).threePointArc((0.010333, 1.106854), (0.000000, 1.081908)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.094079, 0.023520).circle(0.023520)
loop2=wp_sketch0.moveTo(0.188158, 1.034868).circle(0.023520)
loop3=wp_sketch0.moveTo(0.929030, 0.023520).circle(0.023520)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
