solid2=wp_sketch2.add(loop2).extrude(-0.367188)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, -0.679688, 0.593750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(1.414062, 0.000000).lineTo(1.414062, 1.265214).lineTo(1.384293, 1.265214).lineTo(1.384293, 0.029770).lineTo(0.000000, 0.029770).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.593750)
