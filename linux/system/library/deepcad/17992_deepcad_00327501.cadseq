import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, -0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.054688, 0.000000).lineTo(1.054688, 0.455181).lineTo(0.632812, 0.455181).lineTo(0.632812, 0.366365).lineTo(0.632812, 0.355263).lineTo(0.421875, 0.355263).lineTo(0.421875, 0.366365).lineTo(0.421875, 0.455181).lineTo(0.000000, 0.455181).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.399671, 0.366365).circle(0.011102)
loop2=wp_sketch0.moveTo(0.655016, 0.366365).circle(0.011102)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, 0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.421875, 0.000000).lineTo(0.421875, 0.088816).lineTo(0.421875, 0.099918).lineTo(0.632812, 0.099918).lineTo(0.632812, 0.088816).lineTo(0.632812, 0.000000).lineTo(1.054688, 0.000000).threePointArc((0.527344, 0.527344), (0.000000, 0.000000)).close()
loop4=wp_sketch1.moveTo(0.399671, 0.088816).circle(0.011102)
loop5=wp_sketch1.moveTo(0.655016, 0.088816).circle(0.011102)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.007812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
