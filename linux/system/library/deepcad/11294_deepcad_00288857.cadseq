# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288857" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.663158, 0.000000).threePointArc((0.750000, 0.086842), (0.663158, 0.173684)).lineTo(0.000000, 0.173684).threePointArc((-0.086842, 0.086842), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.086842).circle(0.055263)
loop2=wp_sketch0.moveTo(0.331579, 0.086842).circle(0.055263)
loop3=wp_sketch0.moveTo(0.663158, 0.086842).circle(0.055263)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
