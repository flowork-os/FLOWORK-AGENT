wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.049836, 0.000000).threePointArc((0.236719, 0.186883), (0.423602, 0.000000)).lineTo(0.473438, 0.000000).lineTo(0.473438, 0.390378).lineTo(0.473438, 0.548191).threePointArc((0.236719, 0.784910), (0.000000, 0.548191)).lineTo(0.000000, 0.000000).close()
