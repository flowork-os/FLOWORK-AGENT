import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.054688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.003454, -0.003454).lineTo(0.046053, 0.046053).lineTo(0.046053, 0.052961).lineTo(0.046053, 0.059868).lineTo(0.003454, 0.109375).lineTo(0.000000, 0.105921).lineTo(0.003454, 0.108224).lineTo(0.044901, 0.059868).lineTo(0.044901, 0.052961).lineTo(0.044901, 0.047204).lineTo(0.003454, -0.002303).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
