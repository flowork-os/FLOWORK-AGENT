# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00343349" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.546875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.104359, 0.000000).lineTo(0.104359, 0.313076).lineTo(0.104359, 0.788487).lineTo(0.104359, 1.101562).lineTo(0.000000, 1.101562).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.585938, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.000000, -0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.296875, 0.000000).lineTo(1.296875, 0.464145).lineTo(1.201316, 0.464145).lineTo(0.996546, 0.464145).lineTo(0.000000, 0.464145).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.234375, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.351562, 0.000000, 0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.199013, 0.000000).lineTo(0.199013, 0.429688).lineTo(0.000000, 0.429688).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.101562, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
