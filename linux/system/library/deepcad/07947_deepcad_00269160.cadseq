# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00269160" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.078125, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.078947, 0.000000).circle(0.078947)
loop1=wp_sketch0.moveTo(0.078947, 0.000000).circle(0.074013)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.117188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.094984, 0.000000).lineTo(0.094984, 0.257812).lineTo(0.000000, 0.257812).lineTo(0.000000, 0.119408).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.789062)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.084375, 0.000000).lineTo(0.084375, 0.140625).lineTo(0.000000, 0.140625).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.789062)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.164062, 0.000000).lineTo(0.164062, 0.074260).lineTo(0.000000, 0.074260).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.156250)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.093750, 0.000000).lineTo(0.093750, 0.052303).lineTo(0.000000, 0.052303).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(0.125000)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
