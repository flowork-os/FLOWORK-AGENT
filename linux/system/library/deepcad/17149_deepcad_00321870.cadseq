import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.968750, 0.000000).lineTo(0.968750, 0.112171).lineTo(0.000000, 0.112171).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.030592, 0.061184).circle(0.020395)
loop2=wp_sketch0.moveTo(0.326316, 0.101974).circle(0.010197)
loop3=wp_sketch0.moveTo(0.326316, 0.020395).circle(0.010197)
loop4=wp_sketch0.moveTo(0.550658, 0.020395).circle(0.010197)
loop5=wp_sketch0.moveTo(0.550658, 0.101974).circle(0.010197)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.062500, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
