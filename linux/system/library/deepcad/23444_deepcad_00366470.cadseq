import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.394737).lineTo(1.342105, 0.552632).lineTo(0.915789, 0.552632).threePointArc((0.742105, 0.471785), (0.568421, 0.552632)).lineTo(0.300000, 0.552632).lineTo(0.142105, 0.394737).lineTo(0.142105, 0.236842).lineTo(0.000000, 0.157895).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.078947, 0.110526).circle(0.015789)
loop2=wp_sketch0.moveTo(0.536842, 0.489474).circle(0.015789)
loop3=wp_sketch0.moveTo(0.947368, 0.489474).circle(0.015789)
loop4=wp_sketch0.moveTo(1.421053, 0.110526).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.007812, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
