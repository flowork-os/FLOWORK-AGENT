# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00328696" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.381250, 0.000000).lineTo(0.381250, 0.118750).lineTo(0.000000, 0.118750).threePointArc((0.602844, 0.059375), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.382813, 0.000000).lineTo(0.382813, 0.120888).lineTo(0.000000, 0.120888).threePointArc((-0.005953, 0.060444), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.294161, 0.060444).circle(0.028207)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.032237, -0.039474).lineTo(0.062500, -0.039474).threePointArc((0.057498, -0.006432), (0.056579, 0.026974)).threePointArc((0.026626, 0.016976), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.062500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
