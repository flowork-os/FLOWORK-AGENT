# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.726562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009105, -0.021981), (0.031086, -0.031086)).lineTo(1.041365, -0.031086).threePointArc((1.063346, -0.021981), (1.072451, 0.000000)).lineTo(1.072451, 1.445477).threePointArc((1.063346, 1.467458), (1.041365, 1.476562)).lineTo(0.031086, 1.476562).threePointArc((0.009105, 1.467458), (0.000000, 1.445477)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
