# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00248472" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, -0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.158798, -0.421558), (0.521793, -0.688322)).threePointArc((0.890338, -0.423205), (1.054688, 0.000000)).threePointArc((0.780124, -0.197459), (0.532895, 0.033306)).threePointArc((0.527344, 0.038154), (0.521793, 0.033306)).threePointArc((0.274563, -0.197459), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, -0.171875, 0.132812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.176778, -0.343686), (0.497368, -0.559539)).threePointArc((0.812778, -0.342354), (0.984375, 0.000000)).threePointArc((0.719436, -0.107660), (0.497368, 0.072533)).threePointArc((0.270120, -0.110723), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(-0.078125)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
