# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00255564" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.600000).lineTo(0.000000, 0.600000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.126316, 0.000000).circle(0.126316)
loop2=wp_sketch1.moveTo(0.126316, 0.000000).circle(0.102632)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.328125, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.122368, 0.000000).circle(0.122368)
loop4=wp_sketch2.moveTo(0.122368, 0.000000).circle(0.099424)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.250000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.023438, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.126316, 0.000000).circle(0.126316)
loop6=wp_sketch3.moveTo(0.126316, 0.000000).circle(0.102632)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(0.250000)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch4.moveTo(0.122368, 0.000000).circle(0.122368)
loop8=wp_sketch4.moveTo(0.122368, 0.000000).circle(0.099424)
solid4=wp_sketch4.add(loop7).add(loop8).extrude(0.250000)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
