# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220914" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, -0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.000000, 0.000000).threePointArc((0.855118, 0.157895), (1.000000, 0.315789)).lineTo(0.000000, 0.315789).threePointArc((0.157895, 0.157895), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.715789, 0.063158).lineTo(0.715789, 0.252632).lineTo(0.252632, 0.252632).lineTo(0.252632, 0.063158).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.406250, -0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.026974, 0.000000).threePointArc((0.013487, 0.313809), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.013487, 0.158470).circle(0.091036)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.164062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.157895, 0.000000).circle(0.154605)
loop5=wp_sketch2.moveTo(0.157895, 0.000000).circle(0.092105)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.164062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.468750, 0.000000).lineTo(0.468750, 0.187500).lineTo(0.000000, 0.187500).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop6).extrude(0.500000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
