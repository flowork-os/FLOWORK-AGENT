# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00299308" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.476562, 0.000000).lineTo(1.476562, 0.341941).lineTo(0.000000, 0.341941).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.450740, 0.015543).lineTo(0.450740, 0.046628).lineTo(0.233141, 0.046628).lineTo(0.233141, 0.015543).close()
loop2=wp_sketch0.moveTo(0.450740, 0.295312).lineTo(0.450740, 0.310855).lineTo(0.233141, 0.310855).lineTo(0.233141, 0.295312).close()
loop3=wp_sketch0.moveTo(1.243421, 0.015543).lineTo(1.243421, 0.046628).lineTo(1.025822, 0.046628).lineTo(1.025822, 0.015543).close()
loop4=wp_sketch0.moveTo(1.243421, 0.295312).lineTo(1.243421, 0.310855).lineTo(1.025822, 0.310855).lineTo(1.025822, 0.295312).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, 0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.067105, 0.000000).circle(0.067105)
solid1=wp_sketch1.add(loop5).extrude(0.257812)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
