# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.298438, -0.219901).lineTo(1.492188, -0.219901).lineTo(1.492188, 0.188487).lineTo(0.911020, 0.911020).lineTo(0.000000, 0.911020).lineTo(0.000000, 0.000000).close()
