# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.585938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.289062, 0.000000).lineTo(0.000000, 0.212993).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.375000)
