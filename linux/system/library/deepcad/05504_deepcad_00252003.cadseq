# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00252003" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, -0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.167188, 0.000000).threePointArc((1.332107, 0.499219), (1.167188, 0.998437)).lineTo(0.000000, 0.998437).threePointArc((-0.164920, 0.499219), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.084375, 0.253125).circle(0.028125)
loop2=wp_sketch0.moveTo(0.084375, 0.745313).circle(0.028125)
loop3=wp_sketch0.moveTo(0.590625, 0.506250).circle(0.421875)
loop4=wp_sketch0.moveTo(1.082812, 0.253125).circle(0.028125)
loop5=wp_sketch0.moveTo(1.082812, 0.745313).circle(0.028125)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(-0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.422368, 0.000000).circle(0.422368)
solid1=wp_sketch1.add(loop6).extrude(-0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
