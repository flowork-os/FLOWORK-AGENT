# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387506" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.126234, 0.000000).threePointArc((1.281505, 0.142475), (1.126234, 0.284951)).lineTo(0.000000, 0.284951).threePointArc((-0.153372, 0.142475), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.013569, 0.149260).circle(0.040707)
loop2=wp_sketch0.moveTo(1.139803, 0.149260).circle(0.040707)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
