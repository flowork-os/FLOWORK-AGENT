import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.710938, -0.750000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.421053, 0.000000).lineTo(1.421053, 0.363158).threePointArc((1.326672, 0.750000), (1.421053, 1.136842)).lineTo(1.421053, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.200000, 0.173684).threePointArc((1.302632, 0.276316), (1.200000, 0.378947)).lineTo(1.105263, 0.378947).threePointArc((1.002632, 0.276316), (1.105263, 0.173684)).close()
loop2=wp_sketch0.moveTo(1.200000, 1.121053).threePointArc((1.302632, 1.223684), (1.200000, 1.326316)).lineTo(1.105263, 1.326316).threePointArc((1.002632, 1.223684), (1.105263, 1.121053)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.109375)
solid=solid0

