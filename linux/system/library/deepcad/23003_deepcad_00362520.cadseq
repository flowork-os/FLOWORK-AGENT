import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.055263, -0.039474).lineTo(0.726316, -0.039474).threePointArc((0.751581, 0.014267), (0.734211, 0.071053)).lineTo(0.331579, 0.071053).lineTo(0.189474, 0.094737).lineTo(0.000000, 0.031579).lineTo(0.000000, 0.015789).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.663158, 0.015789).circle(0.023684)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
