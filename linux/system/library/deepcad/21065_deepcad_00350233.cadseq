wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.000000, -0.109375), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.081332, -0.152162), (0.162664, 0.000000)).threePointArc((0.081332, -0.027980), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(-0.164062)
solid_temp=solid_temp.union(solid1)
solid=solid.union(solid_temp)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.000000, -0.109375), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.082031, -0.028221), (0.164062, 0.000000)).threePointArc((0.082031, 0.043847), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(-0.257812)
solid_temp=solid2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.078125, 0.000000, -0.109375), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.082031, -0.028221), (0.164062, 0.000000)).threePointArc((0.082031, 0.043847), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(-0.164062)
solid_temp=solid_temp.union(solid2)
solid=solid.union(solid_temp)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.062500, 0.164062, -0.156250), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.067105, 0.000000).circle(0.067105)
solid3=wp_sketch3.add(loop3).extrude(0.585938)
