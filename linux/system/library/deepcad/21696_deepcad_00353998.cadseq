# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00353998" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.663158, 0.000000).circle(0.663158)
loop1=wp_sketch0.moveTo(0.566447, -0.359211).lineTo(0.566447, -0.138158).lineTo(0.511184, -0.096711).lineTo(0.290132, -0.096711).close()
loop2=wp_sketch0.moveTo(0.511184, 0.096711).lineTo(0.566447, 0.138158).lineTo(0.566447, 0.359211).lineTo(0.290132, 0.096711).close()
loop3=wp_sketch0.moveTo(0.663158, 0.000000).circle(0.096711)
loop4=wp_sketch0.moveTo(1.022368, -0.096711).lineTo(0.801316, -0.096711).lineTo(0.746053, -0.138158).lineTo(0.746053, -0.359211).close()
loop5=wp_sketch0.moveTo(0.801316, 0.096711).lineTo(1.022368, 0.096711).lineTo(0.746053, 0.359211).lineTo(0.746053, 0.138158).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
