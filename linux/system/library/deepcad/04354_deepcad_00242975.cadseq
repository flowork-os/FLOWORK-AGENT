# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00242975" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.063158, -0.457895).threePointArc((0.355263, -0.750000), (0.647368, -0.457895)).lineTo(0.710526, 0.000000).threePointArc((0.355263, 0.355263), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.355263, 0.000000).circle(0.276316)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.390625, 0.000000).lineTo(0.390625, 0.037007).lineTo(0.000000, 0.037007).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.570312)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.648438, 0.140625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.043421, 0.000000).circle(0.043421)
solid2=wp_sketch2.add(loop3).extrude(-0.492188)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
