# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00291066" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.213487, 0.000000).threePointArc((0.126972, 0.171875), (0.213487, 0.343750)).lineTo(0.000000, 0.343750).threePointArc((-0.171875, 0.171875), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.173684).circle(0.065132)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.125000, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.453947, 0.000000).threePointArc((0.625000, 0.171053), (0.453947, 0.342105)).lineTo(0.000000, 0.342105).threePointArc((0.086101, 0.171053), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.453947, 0.105263).threePointArc((0.519737, 0.171053), (0.453947, 0.236842)).lineTo(0.263158, 0.236842).threePointArc((0.197368, 0.171053), (0.263158, 0.105263)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.125000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.217105, 0.000000).circle(0.217105)
loop5=wp_sketch2.moveTo(0.217105, 0.000000).circle(0.126645)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.343750)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.130263, 0.000000).circle(0.127549)
loop7=wp_sketch3.moveTo(0.130263, 0.000000).circle(0.086842)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.257812)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
