# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00360456" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.710938, -0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.414062, 0.000000).lineTo(1.414062, 0.074424).lineTo(0.491201, 0.074424).lineTo(0.416776, 0.074424).lineTo(0.000000, 0.074424).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.710938, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.335938, 0.742188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.051809, -0.703125).lineTo(0.125822, -0.703125).lineTo(0.074013, 0.007401).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.421875, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
