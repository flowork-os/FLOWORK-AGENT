import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.041622, -0.100484), (0.142105, -0.142105)).lineTo(1.357895, -0.142105).threePointArc((1.458378, -0.100484), (1.500000, 0.000000)).lineTo(1.500000, 0.821053).threePointArc((1.455108, 0.913641), (1.357895, 0.947368)).lineTo(0.142105, 0.947368).threePointArc((0.044892, 0.913641), (0.000000, 0.821053)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.132812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
