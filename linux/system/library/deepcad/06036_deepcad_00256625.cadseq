wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.045837, -0.110660), (0.156497, -0.156497)).lineTo(1.195066, -0.156497).threePointArc((1.305726, -0.110660), (1.351562, 0.000000)).lineTo(1.351562, 0.298766).threePointArc((1.305726, 0.409426), (1.195066, 0.455263)).lineTo(0.156497, 0.455263).threePointArc((0.045837, 0.409426), (0.000000, 0.298766)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.296875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.046246, -0.111648), (0.157895, -0.157895)).lineTo(1.357895, -0.157895).threePointArc((1.461648, -0.108378), (1.500000, 0.000000)).lineTo(1.500000, 0.442105).threePointArc((1.461648, 0.550484), (1.357895, 0.600000)).lineTo(0.157895, 0.600000).threePointArc((0.046246, 0.553754), (0.000000, 0.442105)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.094176, -0.085255), (0.221053, -0.078947)).lineTo(1.278947, -0.078947).threePointArc((1.382701, -0.029431), (1.421053, 0.078947)).lineTo(1.421053, 0.378947).threePointArc((1.379431, 0.479431), (1.278947, 0.521053)).lineTo(0.221053, 0.521053).threePointArc((0.120569, 0.479431), (0.078947, 0.378947)).lineTo(0.078947, 0.078947).close()
