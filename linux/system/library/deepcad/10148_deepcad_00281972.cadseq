import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.000000, 0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.554688, 0.000000).lineTo(0.554688, 0.554688).lineTo(0.367845, 0.554688).lineTo(0.367845, 0.280263).lineTo(0.186842, 0.280263).lineTo(0.186842, 0.461266).lineTo(0.186842, 0.554688).lineTo(0.000000, 0.554688).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.554688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
