# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272071" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.554688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.138158, 0.000000).circle(0.138158)
loop1=wp_sketch0.moveTo(0.138158, 0.000000).circle(0.086349)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.726562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.008141, -0.019655), (0.027796, -0.027796)).lineTo(0.166776, -0.027796).threePointArc((0.186431, -0.019655), (0.194572, 0.000000)).lineTo(0.194572, 0.138980).lineTo(0.806086, 0.138980).lineTo(0.806086, 0.000000).threePointArc((0.814227, -0.019655), (0.833882, -0.027796)).lineTo(0.972862, -0.027796).threePointArc((0.992517, -0.019655), (1.000658, 0.000000)).lineTo(1.000658, 0.138980).lineTo(0.625411, 1.320312).threePointArc((0.500329, 1.149478), (0.375247, 1.320312)).lineTo(0.000000, 0.138980).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.023438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
