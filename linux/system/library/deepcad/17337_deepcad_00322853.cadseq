import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.236842).lineTo(1.500000, 0.473684).lineTo(0.000000, 0.473684).lineTo(0.000000, 0.236842).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.165789, 0.055263), (0.110526, 0.221053)).lineTo(0.110526, 0.268421).threePointArc((0.102632, 0.276316), (0.094737, 0.268421)).lineTo(0.094737, 0.236842).lineTo(0.094737, 0.221053).close()
loop2=wp_sketch0.moveTo(0.094737, 0.221053).threePointArc((0.750000, -0.434211), (1.405263, 0.221053)).lineTo(1.405263, 0.236842).lineTo(1.405263, 0.268421).threePointArc((1.397368, 0.276316), (1.389474, 0.268421)).lineTo(1.389474, 0.221053).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
