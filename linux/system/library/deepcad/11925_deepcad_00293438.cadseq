# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00293438" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.536842).lineTo(0.000000, 0.536842).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.378947, 0.189474).circle(0.102632)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.007812, 0.000000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.726562, 0.000000).lineTo(0.726562, 0.061184).lineTo(0.000000, 0.061184).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.375000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.054688, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.016118).threePointArc((-0.038569, 0.054687), (0.000000, 0.093257)).lineTo(0.000000, 0.109375).threePointArc((-0.054687, 0.054687), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(-0.750000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.054688, 0.015625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.039062, 0.039062), (0.000000, 0.078125)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(-1.000000)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
