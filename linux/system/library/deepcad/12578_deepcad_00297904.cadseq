# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297904" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, 0.000000, -0.429688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.217105, 0.000000).lineTo(0.217105, 0.108553).lineTo(0.217105, 0.217105).lineTo(0.217105, 0.429688).lineTo(0.000000, 0.429688).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, 0.000000, -0.320312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.640625, 0.000000).lineTo(0.640625, 0.107895).lineTo(0.000000, 0.107895).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, 0.000000, 0.320312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.219572, 0.000000).lineTo(0.219572, -0.322039).lineTo(0.219572, -0.541612).lineTo(0.849013, -0.541612).lineTo(0.849013, -0.644079).lineTo(0.219572, -0.644079).lineTo(0.219572, -0.746546).lineTo(1.390625, -0.746546).lineTo(1.390625, -0.322039).lineTo(0.541612, 0.102467).lineTo(0.000000, 0.102467).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(1.068586, -0.468421).circle(0.102467)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.210938)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.212418, 0.000000).lineTo(0.212418, 0.320312).lineTo(0.000000, 0.320312).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.750000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
