import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, -0.625000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, -0.129276).lineTo(1.023438, -0.129276).lineTo(1.023438, 0.000000).threePointArc((0.840613, 0.075728), (0.764885, 0.258553)).lineTo(0.764885, 0.904934).lineTo(0.258553, 0.904934).lineTo(0.258553, 0.258553).threePointArc((0.182824, 0.075728), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.257812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
