# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00299523" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.370477, 0.000000).lineTo(0.370477, 0.664062).lineTo(0.000000, 0.664062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.251645, 0.076891).lineTo(0.251645, 0.216694).lineTo(0.118832, 0.216694).lineTo(0.118832, 0.076891).close()
loop2=wp_sketch0.moveTo(0.251645, 0.447368).lineTo(0.251645, 0.587171).lineTo(0.118832, 0.587171).lineTo(0.118832, 0.447368).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.265625, 0.187500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.067105, 0.000000).circle(0.067105)
solid1=wp_sketch1.add(loop3).extrude(-0.750000)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
