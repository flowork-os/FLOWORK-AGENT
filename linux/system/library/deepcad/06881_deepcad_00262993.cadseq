solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.609375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.070312, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.093750, 0.000000).lineTo(0.093750, 0.093750).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.087829, 0.005921).lineTo(0.087829, 0.087829).lineTo(0.005921, 0.087829).lineTo(0.005921, 0.005921).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.750000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.093750, 0.000000).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop6).extrude(-0.093750)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch4.moveTo(0.093750, 0.000000).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop7).extrude(-0.093750)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch5.moveTo(0.070312, 0.000000).lineTo(0.070312, 0.011842).lineTo(0.000000, 0.011842).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop8).extrude(0.375000)
