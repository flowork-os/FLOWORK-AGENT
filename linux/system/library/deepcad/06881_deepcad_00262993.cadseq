# workplane for sketch 6
wp_sketch6 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.109375, 0.351562), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop9=wp_sketch6.moveTo(0.011842, 0.000000).circle(0.011842)
solid6=wp_sketch6.add(loop9).extrude(-0.046875)
solid=solid.cut(solid6)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
