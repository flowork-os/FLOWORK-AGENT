# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00262993" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.093750, 0.000000).lineTo(0.093750, 0.093750).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.087829, 0.005921).lineTo(0.087829, 0.087829).lineTo(0.005921, 0.087829).lineTo(0.005921, 0.005921).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.421875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.093750, 0.000000).lineTo(0.093750, 0.093750).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
