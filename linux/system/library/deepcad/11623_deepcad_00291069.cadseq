# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00291069" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.244737, 0.000000).circle(0.244737)
loop1=wp_sketch0.moveTo(0.244737, 0.000000).circle(0.142763)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.390625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.146053, 0.000000).circle(0.143010)
loop3=wp_sketch1.moveTo(0.146053, 0.000000).circle(0.097368)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.195312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.250822, -0.004112).threePointArc((0.147897, 0.192206), (0.246711, 0.390625)).lineTo(0.004112, 0.390625).threePointArc((-0.190874, 0.197343), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.004112, 0.193257).circle(0.074013)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.148438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.148438, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.411595, 0.000000).threePointArc((0.604729, 0.193133), (0.411595, 0.386266)).lineTo(0.000000, 0.386266).threePointArc((0.097215, 0.193133), (0.000000, 0.000000)).close()
loop7=wp_sketch3.moveTo(0.405263, 0.120312).threePointArc((0.478084, 0.193133), (0.405263, 0.265954)).lineTo(0.202632, 0.265954).threePointArc((0.129811, 0.193133), (0.202632, 0.120312)).close()
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.148438)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
