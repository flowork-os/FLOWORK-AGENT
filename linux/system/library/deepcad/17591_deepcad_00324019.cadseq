# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00324019" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.367188, 0.000000).lineTo(0.367188, 0.228043).lineTo(0.000000, 0.228043).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.088898, 0.054112).circle(0.011595)
loop2=wp_sketch0.moveTo(0.088898, 0.123684).circle(0.011595)
loop3=wp_sketch0.moveTo(0.162336, 0.054112).circle(0.011595)
loop4=wp_sketch0.moveTo(0.162336, 0.123684).circle(0.011595)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, 0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.367188, 0.000000).lineTo(0.367188, 0.228043).lineTo(0.000000, 0.228043).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch1.moveTo(0.170066, 0.123684).circle(0.019326)
loop7=wp_sketch1.moveTo(0.170066, 0.054112).circle(0.011595)
loop8=wp_sketch1.moveTo(0.224178, 0.054112).circle(0.011595)
loop9=wp_sketch1.moveTo(0.278289, 0.123684).circle(0.019326)
loop10=wp_sketch1.moveTo(0.278289, 0.054112).circle(0.011595)
solid1=wp_sketch1.add(loop5).add(loop6).add(loop7).add(loop8).add(loop9).add(loop10).extrude(0.007812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
