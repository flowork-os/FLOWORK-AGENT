import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.126316).lineTo(0.560526, 0.126316).lineTo(0.560526, 0.639474).lineTo(0.378947, 0.639474).lineTo(0.378947, 0.513158).threePointArc((0.375000, 0.352360), (0.371053, 0.513158)).lineTo(0.371053, 0.639474).lineTo(0.189474, 0.639474).lineTo(0.189474, 0.126316).lineTo(0.000000, 0.126316).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, -0.125000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.043421, 0.000000).circle(0.042516)
solid1=wp_sketch1.add(loop1).extrude(-0.312500)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, -0.125000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch2.moveTo(0.043421, 0.000000).circle(0.042516)
solid2=wp_sketch2.add(loop2).extrude(-0.312500)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
