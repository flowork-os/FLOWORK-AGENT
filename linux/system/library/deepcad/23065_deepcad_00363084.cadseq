# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00363084" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.357237, -0.610280).lineTo(1.056826, -0.610280).lineTo(1.414062, 0.000000).lineTo(1.056826, 0.610280).lineTo(0.357237, 0.610280).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.437500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.351562, -0.609375, 0.203125), cq.Vector(0.492898, 0.870087, -0.000000), cq.Vector(0.870087, -0.492898, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.175781, -0.169426), (0.351562, 0.000000)).threePointArc((0.351699, 0.007401), (0.351562, 0.014803)).threePointArc((0.175781, 0.184229), (0.000000, 0.014803)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.257812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
