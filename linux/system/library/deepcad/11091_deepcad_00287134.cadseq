# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00287134" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.046875, 0.099178).threePointArc((0.925291, 0.209375), (1.046875, 0.319572)).lineTo(0.000000, 0.418750).threePointArc((0.169690, 0.209375), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.716283, 0.154276).threePointArc((0.771382, 0.209375), (0.716283, 0.264474)).lineTo(0.275493, 0.264474).threePointArc((0.220395, 0.209375), (0.275493, 0.154276)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.218750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.113076, 0.063322).threePointArc((-0.184699, -0.129568), (0.004523, -0.429688)).lineTo(0.045230, -0.425164).threePointArc((0.217949, -0.216677), (0.049753, -0.004523)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.004523, -0.212582).circle(0.162829)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.320312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.437500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.110526, 0.000000).circle(0.108224)
loop5=wp_sketch2.moveTo(0.110526, 0.000000).circle(0.055263)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.265625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
