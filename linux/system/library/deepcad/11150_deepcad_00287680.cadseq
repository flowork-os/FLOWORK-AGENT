# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00287680" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, -0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.928289, 0.212500).threePointArc((1.060209, 0.326100), (0.961842, 0.469737)).lineTo(0.067105, 0.659868).threePointArc((-0.422915, 0.376355), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.078289, 0.335526).circle(0.290789)
loop2=wp_sketch0.moveTo(0.503289, 0.335526).circle(0.145395)
loop3=wp_sketch0.moveTo(0.928289, 0.335526).circle(0.078289)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.289062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
