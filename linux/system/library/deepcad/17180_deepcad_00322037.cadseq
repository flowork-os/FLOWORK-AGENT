# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.093750, -0.093750), (0.187500, 0.000000)).lineTo(0.124342, 0.000000).threePointArc((0.093750, -0.030592), (0.063158, 0.000000)).lineTo(0.000000, 0.000000).close()
