import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.087829, 0.000000).lineTo(0.468421, 0.102467).lineTo(0.556250, 0.000000).lineTo(0.658717, 0.000000).lineTo(0.658717, 1.390625).lineTo(0.000000, 1.390625).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.570888, 0.878289).lineTo(0.175658, 1.112500).lineTo(0.117105, 0.892928).close()
loop2=wp_sketch0.moveTo(0.541612, 0.570888).lineTo(0.541612, 0.819737).lineTo(0.117105, 0.790461).close()
loop3=wp_sketch0.moveTo(0.512336, 0.395230).lineTo(0.131743, 0.702632).lineTo(0.131743, 0.380592).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
