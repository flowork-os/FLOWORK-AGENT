wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.359375, 0.000000).lineTo(1.359375, 0.658224).lineTo(1.187664, 0.658224).lineTo(1.058882, 0.744079).lineTo(0.829934, 0.815625).lineTo(0.572368, 0.815625).lineTo(0.000000, 0.729770).lineTo(0.000000, 0.000000).close()
