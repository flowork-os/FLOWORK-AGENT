solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.656250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, -0.085938, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch1.moveTo(0.246957, -0.037993).lineTo(0.474918, -0.037993).lineTo(0.601562, 0.006332).lineTo(0.601562, 0.253289).lineTo(0.000000, 0.253289).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.296875)
