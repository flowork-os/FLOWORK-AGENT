# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch2.moveTo(0.601562, 0.000000).lineTo(0.601562, 0.088651).lineTo(0.474918, 0.050658).lineTo(0.246957, 0.050658).lineTo(0.000000, 0.082319).lineTo(0.000000, 0.000000).close()
