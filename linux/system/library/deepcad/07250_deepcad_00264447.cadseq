wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.125000, 0.000000, 0.468750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch5.moveTo(0.070230, -0.476562).lineTo(0.446464, -0.180592).lineTo(0.000000, 0.000000).close()
