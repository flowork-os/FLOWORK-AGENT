import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.027748, -0.066989), (0.094737, -0.094737)).lineTo(1.405263, -0.094737).threePointArc((1.472252, -0.066989), (1.500000, 0.000000)).lineTo(1.500000, 0.568421).threePointArc((1.472252, 0.635410), (1.405263, 0.663158)).lineTo(0.094737, 0.663158).threePointArc((0.027748, 0.635410), (0.000000, 0.568421)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, -0.281250, 0.187500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.013007, -0.031401), (0.044408, -0.044408)).lineTo(1.361842, -0.044408).threePointArc((1.393243, -0.031401), (1.406250, 0.000000)).lineTo(1.406250, 0.562500).threePointArc((1.393243, 0.593901), (1.361842, 0.606908)).lineTo(0.044408, 0.606908).threePointArc((0.013007, 0.593901), (0.000000, 0.562500)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.093750)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
