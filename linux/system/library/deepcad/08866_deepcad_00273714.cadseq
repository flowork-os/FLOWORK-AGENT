import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, -0.710938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009008, -0.021748), (0.030757, -0.030757)).lineTo(1.276398, -0.030757).threePointArc((1.298146, -0.021748), (1.307155, 0.000000)).lineTo(1.307155, 1.430181).threePointArc((1.298146, 1.451929), (1.276398, 1.460938)).lineTo(0.030757, 1.460938).threePointArc((0.009008, 1.451929), (0.000000, 1.430181)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.369079, 1.091859).circle(0.076891)
loop2=wp_sketch0.moveTo(0.938076, 1.091859).circle(0.076891)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.109375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
