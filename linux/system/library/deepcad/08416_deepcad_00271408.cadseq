wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.111854, -0.259631), (0.393750, -0.238322)).lineTo(0.942928, 0.217599).threePointArc((0.965901, 0.377837), (0.808224, 0.414474)).lineTo(0.476645, 0.227961).threePointArc((0.393634, 0.228502), (0.352303, 0.300493)).lineTo(0.352303, 0.549178).threePointArc((0.233141, 0.668339), (0.113980, 0.549178)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.238322, -0.051809).circle(0.082895)
loop2=wp_sketch0.moveTo(0.238322, 0.549178).circle(0.062171)
loop3=wp_sketch0.moveTo(0.860033, 0.310855).circle(0.062171)
