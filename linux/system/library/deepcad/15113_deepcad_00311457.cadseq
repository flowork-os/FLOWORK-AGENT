# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00311457" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001229, -0.141875), (0.124424, -0.212253)).lineTo(0.548931, -0.212253).threePointArc((0.672126, -0.141875), (0.673355, 0.000000)).lineTo(0.461102, 0.373273).threePointArc((0.336678, 0.445790), (0.212253, 0.373273)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.124424, -0.073191).circle(0.065872)
loop2=wp_sketch0.moveTo(0.336678, 0.307401).circle(0.065872)
loop3=wp_sketch0.moveTo(0.548931, -0.073191).circle(0.065872)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.234375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, -0.429688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.710938, 0.000000).lineTo(0.710938, 0.568750).lineTo(0.000000, 0.568750).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop4).extrude(0.179688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
