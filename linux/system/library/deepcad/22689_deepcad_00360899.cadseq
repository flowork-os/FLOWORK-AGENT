import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.445312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.100658, 0.000000).lineTo(0.100658, 0.339720).lineTo(0.515872, 0.339720).lineTo(0.515872, 0.000000).lineTo(0.616530, 0.000000).lineTo(0.616530, 0.440378).lineTo(0.616530, 1.195312).lineTo(0.515872, 1.195312).lineTo(0.515872, 0.440378).lineTo(0.100658, 0.440378).lineTo(0.100658, 1.195312).lineTo(0.000000, 1.195312).lineTo(0.000000, 0.440378).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.679688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
