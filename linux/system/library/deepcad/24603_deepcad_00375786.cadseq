# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.250000, 0.125000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.101562, 0.000000).threePointArc((0.033049, 0.026382), (0.000000, 0.091941)).lineTo(0.000000, 0.000000).close()
