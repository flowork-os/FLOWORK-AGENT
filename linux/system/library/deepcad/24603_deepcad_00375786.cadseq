wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.126316).lineTo(0.252632, 0.126316).lineTo(0.252632, 0.378947).lineTo(0.000000, 0.378947).lineTo(0.000000, 0.000000).close()
