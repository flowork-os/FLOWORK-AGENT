wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.975987, 0.000000).lineTo(0.975987, 0.042434).lineTo(1.007812, 0.074260).lineTo(1.007812, 0.562253).lineTo(0.975987, 0.583470).lineTo(0.975987, 0.753207).lineTo(0.954770, 0.785033).lineTo(0.000000, 0.785033).lineTo(0.000000, 0.000000).close()
