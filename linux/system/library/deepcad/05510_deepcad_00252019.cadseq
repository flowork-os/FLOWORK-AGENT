wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.023438, 0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop8=wp_sketch4.moveTo(0.171875, 0.000000).lineTo(0.171875, 0.133882).lineTo(0.000000, 0.133882).lineTo(0.000000, 0.000000).close()
