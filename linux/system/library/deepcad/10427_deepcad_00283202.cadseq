# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00283202" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, -0.742188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.234375, 0.000000).lineTo(0.234375, 0.017270).lineTo(0.214638, 0.037007).lineTo(0.194901, 0.037007).lineTo(0.000000, 0.037007).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.671875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.028947, -0.028947).lineTo(0.217105, -0.028947).lineTo(0.217105, 1.230263).lineTo(0.173684, 1.288158).lineTo(0.173684, 1.346053).threePointArc((0.165206, 1.366522), (0.144737, 1.375000)).lineTo(0.115789, 1.375000).lineTo(0.072368, 1.375000).threePointArc((0.051900, 1.366522), (0.043421, 1.346053)).lineTo(0.043421, 1.288158).lineTo(0.000000, 1.230263).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.007812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
