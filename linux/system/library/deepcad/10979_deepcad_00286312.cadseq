loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.019390, -0.046811), (0.066201, -0.066201)).lineTo(0.728207, -0.066201).threePointArc((0.775018, -0.046811), (0.794408, 0.000000)).lineTo(0.794408, 1.191612).threePointArc((0.775018, 1.238423), (0.728207, 1.257812)).lineTo(0.066201, 1.257812).threePointArc((0.019390, 1.238423), (0.000000, 1.191612)).lineTo(0.000000, 0.000000).close()
