# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00384627" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, -0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.460938, 0.000000).lineTo(0.460938, 0.460938).lineTo(0.000000, 0.460938).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.378454, 0.232895).lineTo(0.378454, 0.354194).lineTo(0.087336, 0.354194).lineTo(0.087336, 0.232895).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.289062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.226562, 0.000000, 0.257812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.264474, 0.000000).circle(0.258964)
solid1=wp_sketch1.add(loop2).extrude(0.148438, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
