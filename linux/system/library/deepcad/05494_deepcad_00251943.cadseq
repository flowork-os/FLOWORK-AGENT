# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.359375, -0.070312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.008864, -0.021399), (0.030263, -0.030263)).lineTo(0.688487, -0.030263).threePointArc((0.709886, -0.021399), (0.718750, 0.000000)).lineTo(0.718750, 0.143750).threePointArc((0.709886, 0.165149), (0.688487, 0.174013)).lineTo(0.030263, 0.174013).threePointArc((0.008864, 0.165149), (0.000000, 0.143750)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
