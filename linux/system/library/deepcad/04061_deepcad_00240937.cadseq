# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.102973, -0.020474), (0.188816, -0.080921)).threePointArc((0.525987, -0.230379), (0.863158, -0.080921)).threePointArc((0.955744, -0.019047), (1.065461, 0.000000)).threePointArc((1.287993, 0.222533), (1.065461, 0.445066)).threePointArc((0.955744, 0.464112), (0.863158, 0.525987)).threePointArc((0.525987, 0.675444), (0.188816, 0.525987)).threePointArc((0.102973, 0.465540), (0.000000, 0.445066)).threePointArc((-0.222533, 0.222533), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.215789).circle(0.094408)
loop2=wp_sketch0.moveTo(0.525987, 0.215789).circle(0.323684)
