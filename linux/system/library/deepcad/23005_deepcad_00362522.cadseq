# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00362522" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.150000, 0.000000).circle(0.150000)
loop1=wp_sketch0.moveTo(0.150000, 0.000000).circle(0.050000)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, -0.601562).threePointArc((0.044512, -0.494101), (0.151974, -0.449589)).lineTo(0.151974, -0.151974).threePointArc((0.044512, -0.107462), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.101562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.106066, -0.043934), (0.150000, -0.150000)).lineTo(0.150000, 0.445312).threePointArc((0.106066, 0.339246), (0.000000, 0.295312)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.101562)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.153947, 0.000000).circle(0.150740)
loop5=wp_sketch3.moveTo(0.153947, 0.000000).circle(0.051316)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.101562)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
