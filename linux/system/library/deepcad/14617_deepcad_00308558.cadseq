loop4=wp_sketch3.moveTo(0.021053, -0.094737).lineTo(0.452632, 0.000000).lineTo(0.505263, 0.000000).lineTo(0.547368, 0.000000).lineTo(0.978947, -0.094737).lineTo(1.000000, 0.000000).lineTo(0.957895, 0.021053).lineTo(0.652632, 0.105263).lineTo(0.347368, 0.105263).lineTo(0.042105, 0.021053).lineTo(0.000000, 0.000000).close()
