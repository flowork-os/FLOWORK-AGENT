loop3=wp_sketch2.moveTo(0.010526, -0.052632).lineTo(0.452632, 0.000000).lineTo(0.505263, 0.000000).lineTo(0.547368, 0.000000).lineTo(0.989474, -0.052632).lineTo(1.000000, 0.000000).lineTo(1.000000, 0.052632).lineTo(0.884211, 0.084211).lineTo(0.694737, 0.105263).lineTo(0.294737, 0.105263).lineTo(0.115789, 0.084211).lineTo(0.000000, 0.052632).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.250000)
solid_temp=solid_temp.union(solid2)
solid=solid.union(solid_temp)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.021053, -0.094737).lineTo(0.452632, 0.000000).lineTo(0.505263, 0.000000).lineTo(0.547368, 0.000000).lineTo(0.978947, -0.094737).lineTo(1.000000, 0.000000).lineTo(0.957895, 0.021053).lineTo(0.652632, 0.105263).lineTo(0.347368, 0.105263).lineTo(0.042105, 0.021053).lineTo(0.000000, 0.000000).close()
