# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00255661" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.562500, 0.000000).lineTo(0.562500, 0.467763).lineTo(0.000000, 0.467763).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.562500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.187500, 0.000000).lineTo(0.187500, 0.093750).lineTo(0.113487, 0.093750).lineTo(0.113487, 0.375000).lineTo(0.187500, 0.375000).lineTo(0.187500, 0.468750).lineTo(0.000000, 0.468750).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.468750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.000000, -0.468750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.351562, -0.092516).threePointArc((0.210405, 0.090666), (0.351562, 0.273849)).lineTo(0.000000, 0.181332).threePointArc((-0.069866, 0.090666), (0.000000, 0.000000)).close()
loop3=wp_sketch2.moveTo(0.022204, 0.092516).circle(0.048109)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.140625)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, -0.382812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.189474, 0.000000).circle(0.189474)
loop5=wp_sketch3.moveTo(0.189474, 0.000000).circle(0.110526)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.281250)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
