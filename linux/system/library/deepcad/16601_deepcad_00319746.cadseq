wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.373026, -0.373026), (0.746053, 0.000000)).lineTo(0.746053, 0.071053).lineTo(0.746053, 0.675000).lineTo(0.746053, 0.746053).threePointArc((0.373026, 1.119079), (0.000000, 0.746053)).lineTo(0.000000, 0.675000).lineTo(0.000000, 0.071053).lineTo(0.000000, 0.000000).close()
