# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, -0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000096, -0.000233), (0.000329, -0.000329)).lineTo(0.015296, -0.000329).threePointArc((0.015529, -0.000233), (0.015625, 0.000000)).lineTo(0.015625, 0.014803).threePointArc((0.015563, 0.015117), (0.015296, 0.015296)).lineTo(0.000329, 0.015296).threePointArc((0.000062, 0.015117), (0.000000, 0.014803)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.014803, 0.000329).lineTo(0.014803, 0.014474).lineTo(0.000822, 0.014474).lineTo(0.000822, 0.000329).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
