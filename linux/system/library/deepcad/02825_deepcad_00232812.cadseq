# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.027459, -0.066291), (0.093750, -0.093750)).lineTo(0.796875, -0.093750).threePointArc((0.863166, -0.066291), (0.890625, 0.000000)).lineTo(0.890625, 0.543750).threePointArc((0.863166, 0.610041), (0.796875, 0.637500)).lineTo(0.093750, 0.637500).threePointArc((0.027459, 0.610041), (0.000000, 0.543750)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
