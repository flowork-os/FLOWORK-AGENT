loop0=wp_sketch0.moveTo(0.371053, 0.000000).lineTo(0.371053, 0.015789).lineTo(0.750000, 0.671053).lineTo(0.750000, 0.710526).lineTo(0.560526, 0.710526).threePointArc((0.190983, 0.435191), (0.000000, 0.015789)).lineTo(0.000000, 0.000000).close()
