loop2=wp_sketch0.moveTo(0.063158, 0.078947).threePointArc((0.200416, 0.183308), (0.213158, 0.355263)).lineTo(0.426316, 0.228947).threePointArc((0.443769, 0.226241), (0.457895, 0.236842)).lineTo(0.576316, 0.450000).threePointArc((0.576229, 0.467047), (0.560526, 0.473684)).lineTo(0.221053, 0.394737).threePointArc((0.216445, 0.391449), (0.213158, 0.386842)).close()
loop3=wp_sketch0.moveTo(0.213158, 0.386842).threePointArc((0.281550, 0.378434), (0.307895, 0.442105)).lineTo(0.615789, 0.521053).threePointArc((0.620547, 0.524190), (0.623684, 0.528947)).lineTo(0.686842, 0.639474).lineTo(0.521053, 0.639474).threePointArc((0.399953, 0.565730), (0.292105, 0.473684)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.015625, both=True)
