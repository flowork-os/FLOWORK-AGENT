# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272031" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.039062, 0.000000).lineTo(1.039062, 0.295312).lineTo(0.000000, 0.295312).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.021875, 0.273438).circle(0.010937)
loop2=wp_sketch0.moveTo(0.032812, 0.262500).circle(0.010937)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, 0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.003947, 0.000000).circle(0.003865)
solid1=wp_sketch1.add(loop3).extrude(-0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.003947, 0.000000).circle(0.003865)
solid2=wp_sketch2.add(loop4).extrude(-0.062500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
