# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00224356" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.473684, 0.000000).lineTo(0.473684, 0.134211).lineTo(0.560526, 0.134211).lineTo(0.560526, 0.750000).lineTo(0.347368, 0.750000).lineTo(0.347368, 0.394737).threePointArc((0.276316, 0.323684), (0.205263, 0.394737)).lineTo(0.205263, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.278326, -0.280780), (0.562500, -0.005921)).lineTo(0.562500, 0.319737).lineTo(0.473684, 0.319737).lineTo(0.473684, 0.402632).lineTo(0.000000, 0.402632).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.062500)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
