# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00325672" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.484211, 0.000000).lineTo(1.484211, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.357895, 0.126316).lineTo(1.357895, 1.373684).lineTo(0.126316, 1.373684).lineTo(0.126316, 0.126316).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, -0.554688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.097697, 0.000000).lineTo(1.097697, 1.109375).lineTo(0.000000, 1.109375).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.617188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(1.229112, 0.000000).lineTo(1.229112, 1.242188).lineTo(0.000000, 1.242188).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(1.163734, 0.065378).lineTo(1.163734, 1.176809).lineTo(0.065378, 1.176809).lineTo(0.065378, 0.065378).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.062500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.617188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(1.229112, 0.000000).lineTo(1.229112, 1.242188).lineTo(0.000000, 1.242188).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch3.moveTo(1.163734, 0.065378).lineTo(1.163734, 1.176809).lineTo(0.065378, 1.176809).lineTo(0.065378, 0.065378).close()
solid3=wp_sketch3.add(loop5).add(loop6).extrude(0.101562)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
