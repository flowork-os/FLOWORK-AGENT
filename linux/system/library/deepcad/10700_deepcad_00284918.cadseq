# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284918" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, -0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.209211, 0.000000).circle(0.204852)
loop1=wp_sketch0.moveTo(0.209211, 0.000000).circle(0.156908)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.312500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.023438, 0.107730).threePointArc((0.910519, 0.210074), (1.023438, 0.312418)).lineTo(0.000000, 0.409375).threePointArc((0.185518, 0.204688), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.721793, 0.161595).threePointArc((0.770271, 0.210074), (0.721793, 0.258553)).lineTo(0.312418, 0.258553).threePointArc((0.263939, 0.210074), (0.312418, 0.161595)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.210938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.539062, -0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.106579, 0.000000).circle(0.104359)
loop5=wp_sketch2.moveTo(0.106579, 0.000000).circle(0.053289)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.257812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
