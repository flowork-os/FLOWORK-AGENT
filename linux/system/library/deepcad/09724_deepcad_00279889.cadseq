# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00279889" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.071053, 0.000000).circle(0.071053)
loop1=wp_sketch0.moveTo(0.071053, 0.000000).circle(0.062171)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.017681, 0.000000).lineTo(0.035362, 0.000000).lineTo(0.035362, 0.039062).lineTo(0.017681, 0.039062).lineTo(0.000000, 0.039062).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.101562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.046875, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.035691, -0.020724).lineTo(0.045477, -0.004605).lineTo(0.054687, 0.012089).lineTo(0.018997, 0.032812).lineTo(0.009211, 0.016118).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.101562)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.009211, -0.016118).lineTo(0.018997, -0.032812).lineTo(0.054687, -0.012089).lineTo(0.045477, 0.004605).lineTo(0.035691, 0.020724).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.101562)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
