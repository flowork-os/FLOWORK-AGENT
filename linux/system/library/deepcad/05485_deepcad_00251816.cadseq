import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, 0.000000, -0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.096087, -0.143403), (0.234868, -0.246053)).threePointArc((0.321909, -0.132332), (0.458553, -0.089474)).lineTo(0.626316, -0.089474).threePointArc((0.800301, -0.017407), (0.872368, 0.156579)).lineTo(0.872368, 0.413816).threePointArc((0.924087, 0.583095), (1.062500, 0.693421)).lineTo(1.062500, 0.905921).threePointArc((1.046121, 0.945463), (1.006579, 0.961842)).lineTo(0.648684, 0.961842).threePointArc((0.502891, 0.873482), (0.335526, 0.905921)).threePointArc((0.143168, 0.615874), (0.123026, 0.268421)).threePointArc((0.107685, 0.113049), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.458553, 0.212500).circle(0.145395)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.062500, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.059211, 0.000000).circle(0.059211)
solid1=wp_sketch1.add(loop2).extrude(-0.750000, both=True)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
