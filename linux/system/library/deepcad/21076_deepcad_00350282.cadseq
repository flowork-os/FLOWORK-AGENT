wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013007, -0.031401), (0.044408, -0.044408)).lineTo(0.103618, -0.044408).threePointArc((0.135020, -0.031401), (0.148026, 0.000000)).lineTo(0.148026, 0.658717).threePointArc((0.135020, 0.690118), (0.103618, 0.703125)).lineTo(0.044408, 0.703125).threePointArc((0.013007, 0.690118), (0.000000, 0.658717)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
