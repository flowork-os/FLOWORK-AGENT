# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.375000, 0.125000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.373602, 0.000000).lineTo(0.373602, 0.271711).threePointArc((0.186801, 0.458512), (0.000000, 0.271711)).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.189227, 0.271711).circle(0.092188)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(-0.125000)
