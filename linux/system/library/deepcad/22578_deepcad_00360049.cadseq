# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.375000, 0.125000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.373602, 0.000000).lineTo(0.373602, 0.271711).threePointArc((0.186801, 0.458512), (0.000000, 0.271711)).lineTo(0.000000, 0.000000).close()
