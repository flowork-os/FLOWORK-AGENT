# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239985" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, -0.632812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.262007, 0.000000).lineTo(0.262007, 1.382812).lineTo(0.000000, 1.382812).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.257812, 0.000000).lineTo(0.257812, 0.122122).lineTo(0.000000, 0.122122).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.130263, 0.059704).circle(0.035280)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.187500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.125000, 0.000000, -0.750000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.257812, 0.000000).lineTo(0.257812, 0.122122).lineTo(0.000000, 0.122122).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.130263, 0.059704).circle(0.035280)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.281250)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, -0.187500, -0.671875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.063158, 0.000000).circle(0.063158)
loop6=wp_sketch3.moveTo(0.063158, -0.014474).circle(0.035526)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(-0.148438)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
