import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, -0.695312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.060855, -0.060855).lineTo(1.125822, -0.060855).lineTo(1.186678, 0.000000).lineTo(1.186678, 1.369243).threePointArc((1.164398, 1.423032), (1.110609, 1.445312)).lineTo(0.319490, 1.445312).threePointArc((0.265701, 1.423032), (0.243421, 1.369243)).lineTo(0.243421, 1.201891).threePointArc((0.213534, 1.144952), (0.152138, 1.125822)).lineTo(0.076069, 1.125822).threePointArc((0.022280, 1.103542), (0.000000, 1.049753)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.243421, 0.106497).circle(0.045641)
loop2=wp_sketch0.moveTo(0.593339, 0.547697).circle(0.152138)
loop3=wp_sketch0.moveTo(0.943257, 0.106497).circle(0.045641)
