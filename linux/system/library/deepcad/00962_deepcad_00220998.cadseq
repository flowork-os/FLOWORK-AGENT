import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.105921, -0.139967).lineTo(0.208059, -0.087007).lineTo(0.359375, -0.192928).lineTo(0.283717, -0.030263).lineTo(0.340461, 0.068092).lineTo(0.208059, 0.143750).lineTo(0.083224, 0.340461).lineTo(0.034046, 0.151316).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.132812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
