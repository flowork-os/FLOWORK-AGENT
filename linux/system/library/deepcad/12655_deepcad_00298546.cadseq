# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00298546" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.268421, -0.094737).threePointArc((0.363158, 0.000000), (0.268421, 0.094737)).lineTo(0.173684, 0.094737).threePointArc((0.078947, 0.000000), (0.173684, -0.094737)).close()
loop2=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.300000)
loop3=wp_sketch0.moveTo(0.173684, -0.094737).threePointArc((0.268421, -0.663158), (0.836842, -0.568421)).lineTo(0.836842, -0.473684).threePointArc((0.750000, -0.386842), (0.663158, -0.473684)).lineTo(0.663158, -0.568421).close()
loop4=wp_sketch0.moveTo(0.663158, -0.568421).threePointArc((1.271053, -0.134211), (0.836842, 0.473684)).lineTo(0.836842, 0.568421).threePointArc((0.750000, 0.655263), (0.663158, 0.568421)).lineTo(0.663158, 0.473684).close()
loop5=wp_sketch0.moveTo(1.326316, -0.094737).threePointArc((1.421053, 0.000000), (1.326316, 0.094737)).lineTo(1.231579, 0.094737).threePointArc((1.136842, 0.000000), (1.231579, -0.094737)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.117188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
