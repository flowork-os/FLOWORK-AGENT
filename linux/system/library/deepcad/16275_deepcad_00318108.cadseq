# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00318108" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, 0.000000, -0.476562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.555181, 0.000000).lineTo(0.555181, 0.942516).threePointArc((0.277590, 1.220107), (0.000000, 0.942516)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.284046, 0.942516).circle(0.129112)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.250000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
