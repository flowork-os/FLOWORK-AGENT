loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((-0.207985, -0.114474), (0.000000, -0.228947)).lineTo(0.000000, -0.242105).lineTo(0.060526, -0.242105).lineTo(0.060526, 0.013158).lineTo(0.000000, 0.013158).lineTo(0.000000, 0.000000).close()
