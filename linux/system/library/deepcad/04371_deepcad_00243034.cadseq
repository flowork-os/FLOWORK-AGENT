# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00243034" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.101562, 0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.327632, 0.000000).circle(0.320806)
loop1=wp_sketch0.moveTo(0.327632, 0.000000).circle(0.238898)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.320312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.687500, 0.000000).threePointArc((0.590665, 0.096386), (0.542763, 0.224342)).lineTo(0.173684, 0.224342).lineTo(0.173684, 0.318421).lineTo(0.542763, 0.318421).threePointArc((0.590665, 0.446377), (0.687500, 0.542763)).lineTo(0.000000, 0.542763).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.375000, 0.000000).threePointArc((0.371651, 0.045395), (0.375000, 0.090789)).lineTo(0.000000, 0.090789).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.265625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
