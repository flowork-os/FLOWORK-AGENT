# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00375653" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.375000, 0.000000).lineTo(0.375000, 0.178125).threePointArc((0.278906, 0.274219), (0.375000, 0.370312)).lineTo(0.375000, 0.445312).threePointArc((0.254705, 0.393543), (0.206250, 0.271875)).lineTo(0.206250, 0.103125).lineTo(0.000000, 0.103125).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.375000, 0.000000).lineTo(0.375000, 0.103125).lineTo(0.173437, 0.103125).lineTo(0.173437, 0.271875).threePointArc((0.122639, 0.394514), (0.000000, 0.445312)).lineTo(0.000000, 0.370312).threePointArc((0.096094, 0.274219), (0.000000, 0.178125)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.273438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.039062, -0.132812, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.063158, 0.000000).circle(0.063158)
solid2=wp_sketch2.add(loop2).extrude(-0.046875)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
