solid2=wp_sketch2.add(loop2).extrude(-0.531250)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, -0.085938, 0.312500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.063158, 0.000000).circle(0.063158)
solid3=wp_sketch3.add(loop3).extrude(0.015625)
