loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.084250, -0.126961), (0.122615, -0.274424)).threePointArc((0.137318, -0.320240), (0.169326, -0.356168)).lineTo(0.204359, -0.309457).threePointArc((0.236472, -0.210208), (0.268586, -0.309457)).lineTo(0.297780, -0.356168).threePointArc((0.329787, -0.320240), (0.344490, -0.274424)).threePointArc((0.382855, -0.126961), (0.467105, 0.000000)).threePointArc((0.233553, 0.535735), (0.000000, 0.000000)).close()
