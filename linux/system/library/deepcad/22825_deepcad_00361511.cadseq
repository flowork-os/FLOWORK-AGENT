wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.601562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.046246, -0.111648), (0.157895, -0.157895)).lineTo(1.357895, -0.157895).threePointArc((1.461648, -0.108378), (1.500000, 0.000000)).lineTo(1.500000, 1.200000).threePointArc((1.461648, 1.308378), (1.357895, 1.357895)).lineTo(0.157895, 1.357895).threePointArc((0.046246, 1.311648), (0.000000, 1.200000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.062597, -0.072175), (0.157895, -0.078947)).lineTo(1.357895, -0.078947).threePointArc((1.405824, -0.052554), (1.421053, 0.000000)).lineTo(1.421053, 1.200000).threePointArc((1.405824, 1.252554), (1.357895, 1.278947)).lineTo(0.157895, 1.278947).threePointArc((0.102071, 1.255824), (0.078947, 1.200000)).lineTo(0.078947, 0.000000).close()
