# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284915" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.201316, 0.000000).circle(0.201316)
loop1=wp_sketch0.moveTo(0.201316, 0.000000).circle(0.150987)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.296875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.183618, -0.192179), (0.010362, -0.393750)).lineTo(0.984375, -0.279770).threePointArc((0.875766, -0.181332), (0.984375, -0.082895)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.673520, -0.227961).threePointArc((0.626891, -0.181332), (0.673520, -0.134704)).lineTo(0.279770, -0.134704).threePointArc((0.233141, -0.181332), (0.279770, -0.227961)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.195312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.343750, 0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.098684, 0.000000).circle(0.098684)
loop5=wp_sketch2.moveTo(0.098684, 0.000000).circle(0.049342)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.250000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
