wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.382812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.749507, -0.856579).lineTo(1.453125, -0.015296).lineTo(1.208388, 0.229441).lineTo(0.244737, 0.260033).lineTo(0.000000, 0.000000).close()
