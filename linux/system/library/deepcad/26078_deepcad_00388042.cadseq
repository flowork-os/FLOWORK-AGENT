loop2=wp_sketch0.moveTo(0.933059, -0.045888).lineTo(1.208388, -0.045888).lineTo(1.223684, 0.030592).lineTo(1.300164, -0.030592).lineTo(1.177796, -0.183553).lineTo(0.642434, -0.030592).lineTo(0.627138, -0.045888).threePointArc((0.530368, 0.030592), (0.627138, 0.107072)).lineTo(0.627138, 0.091776).close()
