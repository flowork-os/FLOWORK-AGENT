import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.593750, -0.085938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.016572, -0.040007), (0.056579, -0.056579)).lineTo(1.188158, -0.056579).threePointArc((1.336678, 0.091941), (1.188158, 0.240461)).lineTo(0.056579, 0.240461).threePointArc((0.016572, 0.223889), (0.000000, 0.183882)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.188158, 0.084868).circle(0.056579)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
