solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.323684, 0.000000).circle(0.323684)
