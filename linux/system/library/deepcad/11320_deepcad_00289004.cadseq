loop6=wp_sketch5.moveTo(0.000000, 0.000000).threePointArc((0.026645, -0.001145), (0.053289, 0.000000)).lineTo(0.053289, 0.632812).threePointArc((0.026645, 0.633958), (0.000000, 0.632812)).lineTo(0.000000, 0.000000).close()
