# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.320312, 0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.027632, -0.001188), (0.055263, 0.000000)).lineTo(0.055263, 0.268421).lineTo(0.027632, 0.375000).lineTo(0.000000, 0.268421).lineTo(0.000000, 0.000000).close()
