loop0=wp_sketch0.moveTo(0.008224, 0.000000).threePointArc((0.010280, -0.000462), (0.012336, 0.000000)).lineTo(0.333059, 0.386513).threePointArc((0.335115, 0.386051), (0.337171, 0.386513)).lineTo(0.382401, 0.386513).lineTo(0.382401, 0.390625).lineTo(0.337171, 0.390625).threePointArc((0.335115, 0.391087), (0.333059, 0.390625)).lineTo(0.008224, 0.004112).lineTo(0.000000, 0.004112).lineTo(0.000000, 0.000000).close()
