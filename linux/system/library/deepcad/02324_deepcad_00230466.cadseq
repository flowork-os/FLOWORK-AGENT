# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00230466" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.244737).lineTo(0.726316, 0.244737).lineTo(0.000000, 0.007895).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.195312, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.007812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.718750, 0.234539).lineTo(0.559868, 0.234539).lineTo(0.000000, 0.052961).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.070312, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.562500, 0.183553).lineTo(0.432237, 0.183553).lineTo(0.000000, 0.041447).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.117188, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.195312, 0.000000).lineTo(0.195312, 0.008224).threePointArc((0.097581, 0.005910), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(-0.750000)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.195312, 0.000000).threePointArc((0.097732, 0.005910), (0.000000, 0.008224)).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(-0.750000)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch5.moveTo(0.000000, 0.000000).threePointArc((0.097732, -0.002314), (0.195312, -0.008224)).lineTo(0.195312, 0.000000).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop5).extrude(-0.750000)
solid=solid.cut(solid5)
# workplane for sketch 6
wp_sketch6 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, 0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch6.moveTo(0.000000, 0.000000).threePointArc((0.097581, 0.005910), (0.195312, 0.008224)).lineTo(0.000000, 0.008224).lineTo(0.000000, 0.000000).close()
solid6=wp_sketch6.add(loop6).extrude(-0.750000)
