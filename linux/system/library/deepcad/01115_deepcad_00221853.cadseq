import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.threePointArc((0.256579, -0.256579), (0.513158, 0.000000)).lineTo(0.513158, 0.497368).threePointArc((0.256579, 0.753947), (0.000000, 0.497368)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.260526, -0.094737).circle(0.094737)
loop2=wp_sketch0.moveTo(0.260526, 0.600000).circle(0.086842)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.578125)
solid=solid0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.threePointArc((0.256579, -0.256579), (0.513158, 0.000000)).lineTo(0.513158, 0.497368).threePointArc((0.256579, 0.753947), (0.000000, 0.497368)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.260526, -0.094737).circle(0.094737)
loop2=wp_sketch0.moveTo(0.260526, 0.600000).circle(0.086842)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.578125)
solid=solid.union(solid0)
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.414062, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.843750, 0.000000).lineTo(0.843750, 0.754934).lineTo(0.000000, 0.754934).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.289062)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.414062, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.843750, 0.000000).lineTo(0.843750, 0.754934).lineTo(0.000000, 0.754934).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.289062)
solid_temp=solid_temp.union(solid1)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
