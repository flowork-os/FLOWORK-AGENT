solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.343750, 0.023438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.018499, -0.044659), (0.063158, -0.063158)).lineTo(1.436842, -0.063158).threePointArc((1.481501, -0.044659), (1.500000, 0.000000)).lineTo(1.500000, 0.678947).threePointArc((1.484772, 0.731501), (1.436842, 0.757895)).lineTo(0.063158, 0.757895).threePointArc((0.015228, 0.731501), (0.000000, 0.678947)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.021769, -0.036765), (0.063158, -0.047368)).lineTo(1.436842, -0.047368).threePointArc((1.470337, -0.033495), (1.484211, 0.000000)).lineTo(1.484211, 0.678947).threePointArc((1.470337, 0.712442), (1.436842, 0.726316)).lineTo(0.063158, 0.726316).threePointArc((0.029663, 0.712442), (0.015789, 0.678947)).lineTo(0.015789, 0.000000).close()
