# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00375626" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, -0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.467681, 0.000000).threePointArc((0.562212, 0.280363), (0.656743, 0.000000)).lineTo(0.796053, 0.000000).lineTo(0.796053, 0.945312).lineTo(0.000000, 0.945312).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.238816, 0.427878).circle(0.199013)
loop2=wp_sketch0.moveTo(0.338322, 0.766201).circle(0.109457)
loop3=wp_sketch0.moveTo(0.587089, 0.517434).circle(0.109457)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.312500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
