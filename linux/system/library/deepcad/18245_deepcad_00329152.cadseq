wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.000000, -0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.893339, 0.000000).threePointArc((1.181838, 0.415321), (0.692023, 0.541036)).lineTo(0.692023, 0.629112).lineTo(0.654276, 0.629112).lineTo(0.654276, 0.541036).lineTo(0.239062, 0.541036).lineTo(0.239062, 0.629112).lineTo(0.201316, 0.629112).lineTo(0.201316, 0.541036).threePointArc((-0.288499, 0.415321), (0.000000, 0.000000)).close()
