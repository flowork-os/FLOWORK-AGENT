solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.164062, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.445312, -0.265625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.276809, 0.000000).lineTo(0.276809, 0.050329).lineTo(0.616530, 0.050329).lineTo(0.616530, 0.000000).lineTo(0.893339, 0.000000).threePointArc((1.166575, 0.436702), (0.654276, 0.490707)).lineTo(0.641694, 0.541036).lineTo(0.616530, 0.541036).lineTo(0.616530, 0.490707).lineTo(0.276809, 0.490707).lineTo(0.276809, 0.541036).lineTo(0.251645, 0.541036).lineTo(0.239062, 0.490707).threePointArc((-0.273236, 0.436702), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.201316, 0.050329).lineTo(0.251645, 0.088076).lineTo(0.641694, 0.088076).lineTo(0.679441, 0.050329).lineTo(0.893339, 0.050329).threePointArc((1.111769, 0.423787), (0.679441, 0.440378)).lineTo(0.213898, 0.440378).threePointArc((-0.218430, 0.423787), (0.000000, 0.050329)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.164062, both=True)
