# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00237234" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.078947, 0.000000).lineTo(0.134211, 0.197368).lineTo(0.371053, 0.197368).lineTo(0.426316, 0.000000).lineTo(0.497368, 0.000000).lineTo(0.300000, 0.710526).threePointArc((0.252632, 0.746566), (0.205263, 0.710526)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.347368, 0.276316).lineTo(0.276316, 0.521053).lineTo(0.221053, 0.521053).lineTo(0.150000, 0.276316).close()
loop2=wp_sketch0.moveTo(0.252632, 0.702632).circle(0.007895)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.171875, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch1.moveTo(0.046875, 0.000000).lineTo(0.046875, 0.023684).lineTo(0.000000, 0.023684).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch2.moveTo(0.046875, 0.000000).lineTo(0.046875, 0.023684).lineTo(0.000000, 0.023684).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.023438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
