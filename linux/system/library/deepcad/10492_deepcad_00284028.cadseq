solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.221465, -0.226399), (0.091283, -0.176480)).lineTo(0.334704, -0.298191).threePointArc((0.575367, -0.122633), (0.292105, -0.030428)).lineTo(0.310362, 0.000000).threePointArc((0.156190, 0.245708), (0.012171, -0.006086)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.314287, -0.049077), (-0.006086, -0.127796)).lineTo(0.066941, -0.164309).threePointArc((-0.203129, -0.216144), (-0.012171, -0.018257)).lineTo(0.152138, -0.103454).lineTo(0.225164, 0.042599).threePointArc((0.114938, 0.128090), (0.182566, 0.006086)).lineTo(0.146053, -0.066941).threePointArc((0.091175, 0.193524), (0.286020, 0.012171)).lineTo(0.219079, -0.133882).lineTo(0.377303, -0.212993).threePointArc((0.462794, -0.102767), (0.340789, -0.170395)).lineTo(0.267763, -0.133882).threePointArc((0.537833, -0.082046), (0.346875, -0.279934)).lineTo(-0.042599, -0.085197).close()
loop3=wp_sketch1.moveTo(-0.073026, -0.152138).circle(0.048684)
loop4=wp_sketch1.moveTo(0.158224, 0.079112).circle(0.048684)
loop5=wp_sketch1.moveTo(0.407730, -0.152138).circle(0.048684)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(-0.093750)
