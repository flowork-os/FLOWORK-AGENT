# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00305156" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.011842, 0.000000).lineTo(0.023438, 0.000000).lineTo(0.023438, 0.023438).lineTo(0.000000, 0.023438).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.021464, 0.001974).lineTo(0.021464, 0.021464).lineTo(0.001974, 0.021464).lineTo(0.001974, 0.001974).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.011595, 0.000000).lineTo(0.023438, 0.000000).lineTo(0.023438, 0.023438).lineTo(0.011595, 0.023438).lineTo(0.000000, 0.023438).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.021464, 0.001974).lineTo(0.021464, 0.021464).lineTo(0.001974, 0.021464).lineTo(0.001974, 0.001974).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.023438, 0.000000).lineTo(0.023438, 0.023438).lineTo(0.011842, 0.023438).lineTo(0.000000, 0.023438).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.021464, 0.001974).lineTo(0.021464, 0.021464).lineTo(0.001974, 0.021464).lineTo(0.001974, 0.001974).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
