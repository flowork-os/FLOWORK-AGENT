# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00326437" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.625000, 0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.450493, 0.000000).lineTo(0.450493, 0.515625).lineTo(0.000000, 0.515625).lineTo(0.000000, 0.379934).lineTo(0.000000, 0.135691).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, 0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(1.031250, 0.000000).lineTo(1.031250, 0.238816).lineTo(0.000000, 0.238816).threePointArc((-0.327376, 0.119408), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(-0.141118, 0.119408).circle(0.119408)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.171875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
