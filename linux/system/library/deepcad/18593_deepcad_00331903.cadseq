# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00331903" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, 0.000000, -0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.742188, 0.000000).lineTo(0.742188, 0.601562).lineTo(0.000000, 0.601562).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.351562, 0.031250).lineTo(0.351562, 0.570312).lineTo(0.031250, 0.570312).lineTo(0.031250, 0.031250).close()
loop2=wp_sketch0.moveTo(0.710938, 0.031250).lineTo(0.710938, 0.570312).lineTo(0.390625, 0.570312).lineTo(0.390625, 0.031250).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.000000, -0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.323438, 0.000000).lineTo(0.323438, 0.539062).lineTo(0.000000, 0.539062).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.015625, 0.000000, -0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.323438, 0.000000).lineTo(0.323438, 0.539062).lineTo(0.000000, 0.539062).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.031250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
