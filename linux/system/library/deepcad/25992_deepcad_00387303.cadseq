# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387303" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.000000, 0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.398026, -0.928525), (0.796053, 0.000000)).lineTo(0.467681, 0.338322).threePointArc((0.398026, 0.368181), (0.328372, 0.338322)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.398026, -0.378125).circle(0.358224)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
