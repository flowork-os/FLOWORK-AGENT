loop4=wp_sketch2.moveTo(1.476562, 0.000000).lineTo(1.476562, 0.217599).lineTo(0.000000, 0.217599).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.414062)
