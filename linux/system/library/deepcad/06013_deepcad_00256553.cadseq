# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, -0.382812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(1.476562, 0.000000).lineTo(1.476562, 0.202056).lineTo(0.000000, 0.202056).lineTo(0.000000, 0.000000).close()
