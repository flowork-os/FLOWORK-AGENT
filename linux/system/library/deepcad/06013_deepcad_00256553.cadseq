wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, -0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.476562, 0.000000).lineTo(1.476562, 0.792681).lineTo(0.000000, 0.792681).lineTo(0.000000, 0.000000).close()
