wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.045888, 0.000000).lineTo(0.091776, 0.000000).lineTo(0.130016, 0.000000).lineTo(0.175905, 0.000000).lineTo(0.221793, 0.000000).lineTo(0.726562, 0.000000).lineTo(0.726562, 0.114720).lineTo(0.000000, 0.114720).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
