# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00352172" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.426316, 0.000000).lineTo(0.663158, -0.228947).lineTo(0.750000, -0.142105).lineTo(0.560526, 0.047368).lineTo(0.513158, 0.007895).lineTo(0.457895, 0.063158).lineTo(0.000000, 0.063158).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.257812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
