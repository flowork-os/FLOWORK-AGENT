# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00226654" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, -0.632812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.529605, 0.000000).lineTo(1.286184, 0.378289).threePointArc((1.432696, 0.612829), (1.286184, 0.847368)).lineTo(0.529605, 1.210526).lineTo(0.000000, 1.210526).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.272368, 0.968421).circle(0.136184)
loop2=wp_sketch0.moveTo(0.272368, 0.287500).circle(0.136184)
loop3=wp_sketch0.moveTo(1.210526, 0.544737).threePointArc((1.293750, 0.627961), (1.210526, 0.711184)).lineTo(0.741447, 0.711184).threePointArc((0.824671, 0.627961), (0.741447, 0.544737)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.257812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
