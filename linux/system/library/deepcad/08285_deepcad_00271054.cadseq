import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.507812, 0.000000).lineTo(0.507812, 0.053454).lineTo(0.507812, 0.069490).lineTo(0.507812, 0.122944).lineTo(0.000000, 0.122944).lineTo(0.000000, 0.069490).lineTo(0.000000, 0.053454).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.122944, 0.053454).lineTo(0.122944, 0.069490).lineTo(0.016036, 0.069490).lineTo(0.016036, 0.053454).close()
loop2=wp_sketch0.moveTo(0.229852, 0.053454).lineTo(0.229852, 0.069490).lineTo(0.176398, 0.069490).lineTo(0.176398, 0.053454).close()
loop3=wp_sketch0.moveTo(0.331414, 0.053454).lineTo(0.331414, 0.069490).lineTo(0.277961, 0.069490).lineTo(0.277961, 0.053454).close()
loop4=wp_sketch0.moveTo(0.491776, 0.053454).lineTo(0.491776, 0.069490).lineTo(0.384868, 0.069490).lineTo(0.384868, 0.053454).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, 0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.507812, 0.000000).lineTo(0.507812, 0.053454).lineTo(0.507812, 0.069490).lineTo(0.507812, 0.122944).lineTo(0.000000, 0.122944).lineTo(0.000000, 0.069490).lineTo(0.000000, 0.053454).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch1.moveTo(0.459704, 0.053454).lineTo(0.459704, 0.069490).lineTo(0.048109, 0.069490).lineTo(0.048109, 0.053454).close()
solid1=wp_sketch1.add(loop5).add(loop6).extrude(0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.242188, -0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch2.moveTo(0.507812, 0.000000).lineTo(0.507812, 0.122944).lineTo(0.000000, 0.122944).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop7).extrude(0.015625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
