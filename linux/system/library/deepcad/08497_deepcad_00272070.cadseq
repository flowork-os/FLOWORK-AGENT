# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272070" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.142105, 0.000000).circle(0.142105)
loop1=wp_sketch0.moveTo(0.142105, 0.000000).circle(0.088816)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.718750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.008430, -0.020353), (0.028783, -0.028783)).lineTo(0.172697, -0.028783).threePointArc((0.193050, -0.020353), (0.201480, 0.000000)).lineTo(0.201480, 0.115132).lineTo(0.834704, 0.115132).lineTo(0.834704, 0.000000).threePointArc((0.843134, -0.020353), (0.863487, -0.028783)).lineTo(1.021793, -0.028783).threePointArc((1.042145, -0.020353), (1.050576, 0.000000)).lineTo(1.050576, 0.115132).lineTo(0.662007, 1.367188).threePointArc((0.525288, 1.182844), (0.388569, 1.367188)).lineTo(0.000000, 0.115132).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.518092, 0.259046).lineTo(0.834704, 0.259046).lineTo(0.518092, 1.151316).lineTo(0.201480, 0.259046).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.023438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
