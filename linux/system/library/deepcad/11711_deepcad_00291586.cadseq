# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00291586" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.300000).threePointArc((-0.055824, 0.434772), (0.078947, 0.378947)).lineTo(0.600000, 0.378947).threePointArc((0.734772, 0.434772), (0.678947, 0.300000)).lineTo(0.678947, 0.000000).threePointArc((0.734772, -0.134772), (0.600000, -0.078947)).lineTo(0.078947, -0.078947).threePointArc((-0.055824, -0.134772), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.375000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
