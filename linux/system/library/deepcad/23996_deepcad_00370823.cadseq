import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.478947, 0.000000).lineTo(0.478947, -0.134704).lineTo(0.883059, -0.134704).lineTo(0.883059, 0.000000).lineTo(1.257237, 0.000000).lineTo(1.421875, 0.284375).lineTo(0.912993, 0.284375).lineTo(0.912993, 0.404112).lineTo(0.508882, 0.404112).lineTo(0.508882, 0.284375).lineTo(0.209539, 0.284375).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.187500, 0.085938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.478947, 0.000000).lineTo(0.478947, -0.134704).lineTo(0.883059, -0.134704).lineTo(0.883059, 0.000000).lineTo(1.257237, 0.000000).lineTo(1.421875, 0.284375).lineTo(0.912993, 0.284375).lineTo(0.912993, 0.404112).lineTo(0.508882, 0.404112).lineTo(0.508882, 0.284375).lineTo(0.209539, 0.284375).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.538816, 0.059868).lineTo(0.538816, -0.074836).lineTo(0.838158, -0.074836).lineTo(0.838158, 0.059868).lineTo(1.227303, 0.059868).lineTo(1.332072, 0.224507).lineTo(0.853125, 0.224507).lineTo(0.853125, 0.359211).lineTo(0.553783, 0.359211).lineTo(0.553783, 0.224507).lineTo(0.224507, 0.224507).lineTo(0.104770, 0.059868).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.031250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
