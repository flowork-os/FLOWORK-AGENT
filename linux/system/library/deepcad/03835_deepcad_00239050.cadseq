# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239050" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.351562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.539062, 0.000000).lineTo(0.539062, 0.198602).lineTo(0.425576, 0.391530).lineTo(0.000000, 0.391530).lineTo(0.000000, 0.243997).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.096464, 0.243997).circle(0.051069)
loop2=wp_sketch0.moveTo(0.295066, 0.147533).circle(0.096464)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.242188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.051316, 0.000000).circle(0.051316)
solid1=wp_sketch1.add(loop3).extrude(0.242188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
