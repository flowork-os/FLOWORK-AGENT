loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.007371, -0.017794), (0.025164, -0.025164)).lineTo(0.184539, -0.025164).threePointArc((0.204430, -0.018663), (0.213898, 0.000000)).lineTo(0.213898, 0.373273).threePointArc((0.204430, 0.391936), (0.184539, 0.398438)).lineTo(0.025164, 0.398438).threePointArc((0.007371, 0.391067), (0.000000, 0.373273)).lineTo(0.000000, 0.000000).close()
