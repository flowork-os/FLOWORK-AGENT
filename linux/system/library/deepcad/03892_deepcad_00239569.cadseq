import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.046875, -0.046875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.578783, 0.000000).lineTo(0.578783, 0.729770).lineTo(0.578783, 0.763322).lineTo(0.452961, 0.763322).lineTo(0.402632, 0.796875).lineTo(0.067105, 0.796875).lineTo(0.058717, 0.780099).lineTo(0.000000, 0.780099).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.536842, 0.050329).lineTo(0.536842, 0.729770).lineTo(0.411020, 0.729770).lineTo(0.402632, 0.746546).lineTo(0.092270, 0.746546).lineTo(0.075493, 0.729770).lineTo(0.050329, 0.729770).lineTo(0.050329, 0.050329).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.234375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.046875, -0.046875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.578783, 0.000000).lineTo(0.578783, 0.729770).lineTo(0.578783, 0.763322).lineTo(0.452961, 0.763322).lineTo(0.402632, 0.796875).lineTo(0.067105, 0.796875).lineTo(0.058717, 0.780099).lineTo(0.000000, 0.780099).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.536842, 0.050329).lineTo(0.536842, 0.729770).lineTo(0.411020, 0.729770).lineTo(0.402632, 0.746546).lineTo(0.092270, 0.746546).lineTo(0.075493, 0.729770).lineTo(0.050329, 0.729770).lineTo(0.050329, 0.050329).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.234375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
