wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.453125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.087868, -0.212132), (0.300000, -0.300000)).lineTo(1.200000, -0.300000).threePointArc((1.412132, -0.212132), (1.500000, 0.000000)).lineTo(1.500000, 0.900000).threePointArc((1.412132, 1.112132), (1.200000, 1.200000)).lineTo(0.805263, 1.200000).threePointArc((0.753184, 1.185738), (0.710526, 1.152632)).lineTo(0.426316, 0.884211).threePointArc((0.371053, 0.861320), (0.315789, 0.884211)).lineTo(0.126316, 1.073684).threePointArc((0.047333, 1.092201), (0.000000, 1.026316)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.375000)
solid=solid0

