# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382451" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.521053, 0.000000).lineTo(0.521053, 0.623684).lineTo(0.363158, 0.750000).lineTo(0.157895, 0.750000).lineTo(0.000000, 0.623684).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.276316, 0.505263).circle(0.086842)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.281250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
