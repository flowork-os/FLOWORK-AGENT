loop8=wp_sketch3.moveTo(0.600658, 0.086842).circle(0.028947)
loop9=wp_sketch3.moveTo(0.600658, 0.600658).circle(0.028947)
solid3=wp_sketch3.add(loop4).add(loop5).add(loop6).add(loop7).add(loop8).add(loop9).extrude(-0.328125)
