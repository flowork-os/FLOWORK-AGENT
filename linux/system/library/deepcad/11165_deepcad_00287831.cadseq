loop3=wp_sketch2.moveTo(0.731908, 0.049342).lineTo(0.731908, 0.731908).lineTo(0.049342, 0.731908).lineTo(0.049342, 0.049342).close()
solid2=wp_sketch2.add(loop2).add(loop3).extrude(-0.328125)
