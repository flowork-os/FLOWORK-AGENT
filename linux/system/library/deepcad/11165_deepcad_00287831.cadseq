# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.343750, -0.343750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.687500, 0.000000).lineTo(0.687500, 0.687500).lineTo(0.000000, 0.687500).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch3.moveTo(0.086842, 0.086842).circle(0.028947)
loop6=wp_sketch3.moveTo(0.086842, 0.600658).circle(0.028947)
