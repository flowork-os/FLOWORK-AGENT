# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, -0.476562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.195395, 0.000000).lineTo(0.195395, 0.773437).lineTo(0.162829, 0.773437).lineTo(0.000000, 0.000000).close()
