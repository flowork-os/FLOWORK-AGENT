# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00282226" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.276316, 0.000000).lineTo(0.276316, 0.546875).lineTo(0.000000, 0.546875).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.273438, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.273438, -0.273438, 0.406250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.132812, 0.132812).lineTo(0.000000, 0.132812).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.273438)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.273438, 0.132812, 0.546875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.132812, -0.132812).lineTo(0.132812, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.273438)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.273438, -0.132812, 0.132812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.273438, 0.000000).lineTo(0.273438, 0.273438).lineTo(0.000000, 0.273438).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.273438)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.343750, 0.000000, 0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.205263, 0.000000).circle(0.205263)
solid4=wp_sketch4.add(loop4).extrude(-0.273438, both=True)
solid=solid.union(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.406250, -0.273438, 0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch5.moveTo(0.138158, 0.000000).circle(0.138158)
solid5=wp_sketch5.add(loop5).extrude(-0.546875)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
