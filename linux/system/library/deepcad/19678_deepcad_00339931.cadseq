# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00339931" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.086842, 0.000000).circle(0.086842)
loop1=wp_sketch0.moveTo(0.086842, 0.000000).circle(0.050658)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.210938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.476562, 0.000000).threePointArc((0.461786, 0.047656), (0.476562, 0.095312)).lineTo(0.000000, 0.095312).threePointArc((0.011318, 0.047656), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.210938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.106579, 0.000000).circle(0.106579)
loop4=wp_sketch2.moveTo(0.106579, 0.000000).circle(0.051069)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.210938)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.299178, 0.000000).lineTo(0.527961, 0.079194).lineTo(0.835938, 0.079194).lineTo(0.835938, 0.167187).lineTo(0.510362, 0.167187).lineTo(0.281579, 0.079194).lineTo(0.000000, 0.079194).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch3.moveTo(0.290378, 0.035197).lineTo(0.519161, 0.114391).lineTo(0.800740, 0.114391).lineTo(0.800740, 0.131990).lineTo(0.519161, 0.131990).lineTo(0.290378, 0.052796).lineTo(0.035197, 0.052796).lineTo(0.035197, 0.035197).close()
solid3=wp_sketch3.add(loop5).add(loop6).extrude(0.109375, both=True)
solid=solid.intersect(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
