# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00290181" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.189474, 0.000000).lineTo(0.189474, 0.118421).lineTo(0.189474, 0.450000).lineTo(0.189474, 0.562500).lineTo(0.000000, 0.562500).lineTo(0.000000, 0.349342).lineTo(0.153947, 0.349342).lineTo(0.153947, 0.165789).lineTo(0.000000, 0.165789).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.189474, 0.000000).lineTo(0.189474, 0.165789).lineTo(0.035526, 0.165789).lineTo(0.035526, 0.349342).lineTo(0.189474, 0.349342).lineTo(0.189474, 0.562500).lineTo(0.000000, 0.562500).lineTo(0.000000, 0.450000).lineTo(0.000000, 0.118421).lineTo(0.000000, 0.106579).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.117188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
