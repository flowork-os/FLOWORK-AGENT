# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00281984" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.117188, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.636102, 0.000000).lineTo(0.636102, 0.664062).lineTo(0.000000, 0.664062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.321546, 0.349507).circle(0.111842)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.636102, 0.000000).lineTo(0.636102, 0.664062).lineTo(0.000000, 0.664062).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.426398, 0.237664).lineTo(0.426398, 0.454359).lineTo(0.209704, 0.454359).lineTo(0.209704, 0.237664).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.164062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
