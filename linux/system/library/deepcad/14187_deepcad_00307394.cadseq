import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.234375, 0.000000).lineTo(1.234375, 0.350822).lineTo(0.000000, 0.350822).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.688651, 0.038980).lineTo(0.688651, 0.077961).lineTo(0.649671, 0.077961).lineTo(0.649671, 0.038980).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.148438, -0.625000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.476562, 0.000000).lineTo(0.476562, 0.346135).lineTo(0.000000, 0.346135).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.326069, 0.165543).lineTo(0.326069, 0.205674).lineTo(0.110362, 0.205674).lineTo(0.110362, 0.165543).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, 0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(1.234375, 0.000000).lineTo(1.234375, 0.480757).lineTo(0.000000, 0.480757).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.046875)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.445312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.437500, 0.000000).lineTo(0.437500, 0.023026).lineTo(0.326974, 0.023026).lineTo(0.326974, 0.059868).lineTo(0.110526, 0.059868).lineTo(0.110526, 0.023026).lineTo(0.000000, 0.023026).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.046875)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
