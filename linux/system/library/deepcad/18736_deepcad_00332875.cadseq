import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.058717, 0.000000).lineTo(0.058717, -0.019572).lineTo(0.870970, -0.019572).lineTo(0.870970, 0.000000).lineTo(0.929687, 0.000000).lineTo(0.929687, 0.861184).lineTo(0.870970, 0.861184).lineTo(0.870970, 0.890543).lineTo(0.058717, 0.890543).lineTo(0.058717, 0.861184).lineTo(0.000000, 0.861184).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
