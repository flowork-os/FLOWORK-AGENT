wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.051601, -0.053536), (0.000000, -0.107072)).lineTo(0.703618, -0.107072).lineTo(1.407237, -0.107072).threePointArc((1.458837, -0.053536), (1.407237, 0.000000)).lineTo(0.703618, 0.045888).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, -0.045888).circle(0.030592)
