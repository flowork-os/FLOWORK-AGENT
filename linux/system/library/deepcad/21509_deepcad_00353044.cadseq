# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00353044" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.179530, -0.260376), (0.091365, -0.423602)).lineTo(0.656168, -0.265789).threePointArc((0.782581, -0.048156), (0.573109, 0.091365)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.041530, -0.207648).circle(0.033224)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.179530, -0.260376), (0.091365, -0.423602)).lineTo(0.656168, -0.265789).threePointArc((0.782581, -0.048156), (0.573109, 0.091365)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.041530, -0.207648).circle(0.033224)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.070312)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
