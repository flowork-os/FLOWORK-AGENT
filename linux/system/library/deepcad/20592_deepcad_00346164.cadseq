solid0=wp_sketch0.add(loop0).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, -0.140625, 0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.082895, 0.000000).circle(0.082895)
