wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, -0.140625, -0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch5.moveTo(0.118421, 0.000000).lineTo(0.118421, 0.468750).lineTo(0.000000, 0.468750).lineTo(0.000000, 0.000000).close()
