# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00314177" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.171053, 0.000000).lineTo(0.171053, 0.406250).lineTo(0.000000, 0.406250).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.081250, 0.205263).circle(0.034211)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.578125, 0.000000).threePointArc((0.374260, 0.203865), (0.578125, 0.407730)).lineTo(0.000000, 0.407730).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.085938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.205263, 0.000000).circle(0.205263)
solid2=wp_sketch2.add(loop3).extrude(0.085938)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.143631, -0.059494), (0.203125, -0.203125)).lineTo(0.203125, 0.000000).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.085938)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.203125, 0.000000).lineTo(0.203125, 0.203125).threePointArc((0.143631, 0.059494), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop5).extrude(0.085938)
solid=solid.union(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.203125, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch5.moveTo(0.171053, 0.000000).lineTo(0.171053, 0.406250).lineTo(0.000000, 0.406250).lineTo(0.000000, 0.205263).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch5.moveTo(0.094079, 0.205263).circle(0.034211)
solid5=wp_sketch5.add(loop6).add(loop7).extrude(0.085938)
solid=solid.union(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
