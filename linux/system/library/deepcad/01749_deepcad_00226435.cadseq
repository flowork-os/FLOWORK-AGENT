# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00226435" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.570312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.148438, 0.000000).lineTo(1.148438, 0.096711).threePointArc((1.117608, 0.159051), (1.051727, 0.181332)).lineTo(0.096711, 0.181332).threePointArc((0.030830, 0.159051), (0.000000, 0.096711)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.096711, 0.096711).circle(0.048355)
loop2=wp_sketch0.moveTo(1.051727, 0.096711).circle(0.048355)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.320312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, -0.531250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.028326, -0.068385), (0.096711, -0.096711)).lineTo(1.051727, -0.096711).threePointArc((1.120112, -0.068385), (1.148438, 0.000000)).lineTo(1.148438, 0.096711).lineTo(0.000000, 0.096711).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.096711, 0.000000).circle(0.048355)
loop5=wp_sketch1.moveTo(1.051727, 0.000000).circle(0.048355)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.320312)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
