import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.539062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.335938, 0.000000).lineTo(1.335938, 0.675000).lineTo(1.153125, 0.970313).lineTo(0.871875, 0.970313).lineTo(0.787500, 0.815625).lineTo(0.435938, 0.787500).lineTo(0.351562, 0.632812).lineTo(0.070312, 0.492188).lineTo(0.000000, 0.281250).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.179688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
