# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297886" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.320230, 0.000000).threePointArc((0.302765, 0.149202), (0.334786, 0.295970)).threePointArc((0.273990, 0.448287), (0.116447, 0.402714)).threePointArc((0.029617, 0.209629), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.601562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.421875, 0.000000, 0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.029725, -0.145927), (0.010362, -0.293586)).lineTo(0.328125, -0.293586).threePointArc((0.297869, -0.084915), (0.210691, 0.107072)).threePointArc((0.056823, 0.149016), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.601562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.632812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.631579).lineTo(1.184211, 0.631579).threePointArc((0.750000, 0.309546), (0.315789, 0.631579)).lineTo(0.000000, 0.631579).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.601562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
