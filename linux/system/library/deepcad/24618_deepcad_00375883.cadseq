import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.632812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.008430, -0.020353), (0.028783, -0.028783)).lineTo(1.338405, -0.028783).threePointArc((1.358757, -0.020353), (1.367188, 0.000000)).lineTo(1.367188, 0.791530).threePointArc((1.358757, 0.811882), (1.338405, 0.820312)).lineTo(0.028783, 0.820312).threePointArc((0.008430, 0.811882), (0.000000, 0.791530)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
