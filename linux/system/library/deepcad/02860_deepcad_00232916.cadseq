import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, -0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.452467, -0.150822).lineTo(1.023438, 0.053865).lineTo(1.023438, 0.764885).lineTo(0.711020, 0.764885).lineTo(0.711020, 0.560197).lineTo(0.409375, 0.560197).lineTo(0.409375, 0.764885).lineTo(0.000000, 0.764885).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
