# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00332139" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.304688, 0.000000).lineTo(1.304688, 0.137336).lineTo(0.412007, 0.741612).threePointArc((0.138304, 0.758679), (0.000000, 0.521875)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.260937, 0.535609).circle(0.137336)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.257812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.257812, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(1.304688, 0.000000).lineTo(1.304688, 0.137336).lineTo(0.521875, 0.137336).lineTo(0.521875, 0.508141).lineTo(0.521875, 0.549342).threePointArc((0.247371, 0.793363), (0.000000, 0.521875)).lineTo(0.000000, 0.137336).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.260937, 0.535609).circle(0.137336)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.257812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
