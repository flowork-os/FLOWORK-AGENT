# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00321673" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.164062, 0.031250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.019737, -0.033717).lineTo(0.058388, -0.033717).lineTo(0.078125, 0.000000).lineTo(0.058388, 0.033717).lineTo(0.019737, 0.033717).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.117188, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.019572, -0.065707).lineTo(0.085280, -0.081086).lineTo(0.132812, -0.032155).lineTo(0.113240, 0.033553).lineTo(0.047533, 0.048931).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.039145, -0.044737).lineTo(0.078289, -0.054523).lineTo(0.104852, -0.025164).lineTo(0.093668, 0.012582).lineTo(0.054523, 0.022368).lineTo(0.027961, -0.006990).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.019572, -0.065707).lineTo(0.085280, -0.081086).lineTo(0.132812, -0.032155).lineTo(0.113240, 0.033553).lineTo(0.047533, 0.048931).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.039145, -0.044737).lineTo(0.078289, -0.054523).lineTo(0.104852, -0.025164).lineTo(0.093668, 0.012582).lineTo(0.054523, 0.022368).lineTo(0.027961, -0.006990).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.156250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
