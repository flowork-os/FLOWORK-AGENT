import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.258717, 0.000000).lineTo(0.258717, 0.159211).lineTo(0.477632, 0.159211).lineTo(0.686595, 0.159211).lineTo(0.686595, 0.000000).lineTo(0.945312, 0.000000).lineTo(0.945312, 0.318421).lineTo(0.477632, 0.318421).lineTo(0.000000, 0.318421).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.429688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.258717, 0.000000).lineTo(0.258717, 0.159211).lineTo(0.477632, 0.159211).lineTo(0.686595, 0.159211).lineTo(0.686595, 0.000000).lineTo(0.945312, 0.000000).lineTo(0.945312, 0.318421).lineTo(0.477632, 0.318421).lineTo(0.000000, 0.318421).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.125000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.000000, -0.429688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.477632, 0.000000).lineTo(0.945312, 0.000000).lineTo(0.945312, 0.427878).threePointArc((0.472656, 0.900535), (0.000000, 0.427878)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.477632, 0.427878).circle(0.218914)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.125000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.217105, 0.000000).circle(0.217105)
loop5=wp_sketch3.moveTo(0.217105, 0.000000).circle(0.108553)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.296875)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
