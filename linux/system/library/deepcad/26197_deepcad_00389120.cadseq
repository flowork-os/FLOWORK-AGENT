# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.015625, -0.015625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001156, -0.002791), (0.003947, -0.003947)).lineTo(0.027303, -0.003947).threePointArc((0.030094, -0.002791), (0.031250, 0.000000)).lineTo(0.031250, 0.023355).threePointArc((0.030094, 0.026146), (0.027303, 0.027303)).lineTo(0.003947, 0.027303).threePointArc((0.001156, 0.026146), (0.000000, 0.023355)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001565, -0.001804), (0.003947, -0.001974)).lineTo(0.027303, -0.001974).threePointArc((0.028698, -0.001396), (0.029276, 0.000000)).lineTo(0.029276, 0.023355).threePointArc((0.028698, 0.024751), (0.027303, 0.025329)).lineTo(0.003947, 0.025329).threePointArc((0.002552, 0.024751), (0.001974, 0.023355)).lineTo(0.001974, 0.000000).close()
