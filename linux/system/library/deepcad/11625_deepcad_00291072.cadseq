# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00291072" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.244737, 0.000000).circle(0.244737)
loop1=wp_sketch0.moveTo(0.244737, 0.000000).circle(0.142763)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.390625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.146053, 0.000000).circle(0.143010)
loop3=wp_sketch1.moveTo(0.146053, -0.097368).threePointArc((0.144531, 0.150575), (0.143010, -0.097368)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.289062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.148438, 0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.297615, -0.202632).threePointArc((0.195025, -0.369352), (0.000000, -0.386266)).lineTo(0.398931, -0.386266).lineTo(0.417928, -0.386266).threePointArc((0.603212, -0.190044), (0.411595, 0.000000)).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.405263, -0.265954).threePointArc((0.478983, -0.193133), (0.405263, -0.120312)).lineTo(0.196299, -0.120312).threePointArc((0.122579, -0.193133), (0.196299, -0.265954)).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.148438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.127467, -0.172697).threePointArc((-0.043826, -0.220558), (0.008224, -0.390625)).lineTo(0.242599, -0.390625).threePointArc((0.144287, -0.195312), (0.242599, 0.000000)).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch3.moveTo(0.000000, -0.193257).circle(0.074013)
loop8=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((-0.001791, -0.145970), (0.000000, -0.291941)).lineTo(-0.004112, -0.291941).close()
solid3=wp_sketch3.add(loop6).add(loop7).add(loop8).extrude(0.148438)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
