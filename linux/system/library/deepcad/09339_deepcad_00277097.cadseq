loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.211010, -0.004160), (0.363158, 0.142105)).lineTo(1.136842, 0.142105).threePointArc((1.181501, 0.160604), (1.200000, 0.205263)).lineTo(1.200000, 0.742105).threePointArc((1.181501, 0.786765), (1.136842, 0.805263)).lineTo(0.363158, 0.805263).threePointArc((0.318499, 0.786765), (0.300000, 0.742105)).lineTo(0.300000, 0.205263).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.093750)
solid=solid0

