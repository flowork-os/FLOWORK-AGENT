# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285959" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, -0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.027961, 0.000000).lineTo(0.027961, 0.314556).lineTo(0.188734, 0.447368).lineTo(0.475329, 0.447368).lineTo(0.636102, 0.314556).lineTo(0.636102, 0.000000).lineTo(0.664062, 0.000000).lineTo(0.664062, 0.328536).lineTo(0.482319, 0.475329).lineTo(0.181743, 0.475329).lineTo(0.000000, 0.328536).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.117188, -0.320312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.976563, 0.000000).lineTo(0.976563, 0.575658).lineTo(0.873766, 0.575658).lineTo(0.873766, 0.339227).lineTo(0.729852, 0.185033).lineTo(0.390625, 0.082237).lineTo(0.123355, 0.267270).lineTo(0.123355, 0.575658).lineTo(0.000000, 0.575658).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.468750, both=True)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
