import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, -0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.255592, -0.365132).threePointArc((0.311922, -0.436186), (0.377303, -0.499013)).threePointArc((0.542281, -0.567819), (0.718092, -0.535526)).threePointArc((0.603404, -0.384528), (0.742434, -0.255592)).lineTo(0.925000, -0.255592).lineTo(1.095395, 0.000000).threePointArc((1.088774, 0.375379), (0.730263, 0.486842)).threePointArc((0.547697, 0.456317), (0.365132, 0.486842)).threePointArc((0.006621, 0.375379), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.255592, 0.182566).circle(0.109539)
loop2=wp_sketch0.moveTo(0.839803, 0.182566).circle(0.109539)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.031250)
solid=solid0

