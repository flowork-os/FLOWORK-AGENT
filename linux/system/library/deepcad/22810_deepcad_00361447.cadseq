loop9=wp_sketch2.moveTo(0.118421, 0.000000).circle(0.051809)
solid2=wp_sketch2.add(loop8).add(loop9).extrude(0.203125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.101562, -0.304688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop10=wp_sketch3.moveTo(0.118421, 0.000000).circle(0.115954)
