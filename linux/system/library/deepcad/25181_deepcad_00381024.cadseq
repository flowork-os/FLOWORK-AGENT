# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00381024" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, 0.000000, -0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.100493, -0.170066).lineTo(0.270559, -0.270559).lineTo(0.463816, -0.270559).lineTo(0.633882, -0.170066).lineTo(0.734375, 0.000000).lineTo(0.734375, 0.193257).lineTo(0.633882, 0.371053).lineTo(0.463816, 0.463816).lineTo(0.270559, 0.463816).lineTo(0.100493, 0.371053).lineTo(0.000000, 0.193257).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.371053, 0.100493).circle(0.023191)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
