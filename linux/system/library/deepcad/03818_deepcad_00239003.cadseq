# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239003" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, -0.421875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.647368, 0.000000).threePointArc((0.752271, -0.043452), (0.795724, -0.148355)).lineTo(0.795724, -0.202303).lineTo(1.281250, -0.202303).lineTo(1.281250, 0.863158).lineTo(0.000000, 0.863158).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.310197, 0.188816).circle(0.107895)
loop2=wp_sketch0.moveTo(1.146382, 0.552961).threePointArc((1.227303, 0.633882), (1.146382, 0.714803)).lineTo(0.499013, 0.714803).threePointArc((0.418092, 0.633882), (0.499013, 0.552961)).close()
loop3=wp_sketch0.moveTo(1.038487, 0.134868).circle(0.202303)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.257812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
