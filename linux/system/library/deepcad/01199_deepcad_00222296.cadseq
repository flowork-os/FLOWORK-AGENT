loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.017391, -0.041984), (0.059375, -0.059375)).lineTo(0.237500, -0.059375).threePointArc((0.279484, -0.041984), (0.296875, 0.000000)).lineTo(0.296875, 0.178125).threePointArc((0.279484, 0.220109), (0.237500, 0.237500)).lineTo(0.059375, 0.237500).threePointArc((0.017391, 0.220109), (0.000000, 0.178125)).lineTo(0.000000, 0.000000).close()
