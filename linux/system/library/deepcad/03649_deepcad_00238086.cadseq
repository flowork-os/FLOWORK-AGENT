wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.011842, 0.000000).lineTo(0.023438, 0.000000).lineTo(0.023438, 0.003947).lineTo(0.014063, 0.003947).lineTo(0.014063, 0.006908).threePointArc((0.011719, 0.015584), (0.009375, 0.006908)).lineTo(0.009375, 0.003947).lineTo(0.000000, 0.003947).lineTo(0.000000, 0.000000).close()
