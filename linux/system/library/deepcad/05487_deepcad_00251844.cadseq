wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.539062, 0.484375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.133080, -0.457490), (0.054276, -0.895559)).lineTo(1.099095, -0.895559).threePointArc((1.286131, -0.355403), (1.017681, 0.149260)).lineTo(0.515625, 0.067845).threePointArc((0.395080, -0.025153), (0.257812, 0.040707)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.115456, -0.445881), (0.067845, -0.868421)).lineTo(1.085526, -0.868421).threePointArc((1.261001, -0.365393), (1.017681, 0.108553)).lineTo(0.529194, 0.040707).threePointArc((0.397759, -0.056929), (0.244243, 0.000000)).lineTo(0.013569, -0.027138).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.390625)
