# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.523438, 0.453125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.013158, -0.026316).threePointArc((-0.107430, -0.441000), (0.052632, -0.842105)).lineTo(1.078947, -0.842105).threePointArc((1.250986, -0.331763), (1.000000, 0.144737)).lineTo(0.513158, 0.078947).threePointArc((0.382695, -0.025877), (0.223684, 0.026316)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.054688)
