import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.312500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.032895, 0.000000).lineTo(0.032895, 0.187500).lineTo(0.200658, -0.108553).lineTo(0.230263, -0.092105).lineTo(0.065789, 0.187500).lineTo(0.085526, 0.197368).lineTo(0.246711, -0.082237).lineTo(0.273026, -0.065789).lineTo(0.055921, 0.312500).lineTo(0.000000, 0.312500).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
