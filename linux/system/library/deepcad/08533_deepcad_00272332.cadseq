# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272332" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, -0.300000).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.663158).lineTo(0.757895, 0.947368).lineTo(0.000000, 0.663158).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.300000, -0.015789).lineTo(0.757895, -0.015789).lineTo(1.342105, -0.015789).lineTo(1.342105, 0.678947).lineTo(0.757895, 0.678947).lineTo(0.300000, 0.678947).lineTo(0.157895, 0.521053).lineTo(0.157895, 0.142105).close()
loop2=wp_sketch0.moveTo(0.757895, -0.173684).circle(0.047368)
loop3=wp_sketch0.moveTo(0.757895, 0.836842).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.150000, -0.150000).lineTo(0.593750, -0.150000).lineTo(0.593750, 0.531250).lineTo(0.150000, 0.531250).lineTo(0.000000, 0.381250).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop4).extrude(0.507812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.343750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.600658, 0.000000).lineTo(0.600658, 0.687500).lineTo(0.000000, 0.687500).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop5).extrude(0.507812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
