import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.623684, 0.000000).lineTo(0.623684, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.615789, 0.007895).lineTo(0.615789, 0.118421).lineTo(0.007895, 0.118421).lineTo(0.007895, 0.007895).close()
loop2=wp_sketch0.moveTo(0.615789, 0.126316).lineTo(0.615789, 0.268421).lineTo(0.007895, 0.268421).lineTo(0.007895, 0.126316).close()
loop3=wp_sketch0.moveTo(0.615789, 0.284211).lineTo(0.615789, 0.434211).lineTo(0.007895, 0.434211).lineTo(0.007895, 0.284211).close()
loop4=wp_sketch0.moveTo(0.615789, 0.442105).lineTo(0.615789, 0.576316).lineTo(0.007895, 0.576316).lineTo(0.007895, 0.442105).close()
loop5=wp_sketch0.moveTo(0.615789, 0.584211).lineTo(0.615789, 0.742105).lineTo(0.007895, 0.742105).lineTo(0.007895, 0.584211).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
