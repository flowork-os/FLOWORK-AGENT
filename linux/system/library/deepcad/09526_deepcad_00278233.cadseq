wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.189474, 0.000000).threePointArc((0.313310, 0.036908), (0.442105, 0.047368)).lineTo(0.757895, 0.047368).lineTo(1.057895, 0.047368).threePointArc((1.186690, 0.036908), (1.310526, 0.000000)).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.157895).lineTo(1.310526, 0.157895).threePointArc((1.187517, 0.113092), (1.057895, 0.094737)).lineTo(0.757895, 0.094737).lineTo(0.442105, 0.094737).threePointArc((0.312483, 0.113092), (0.189474, 0.157895)).lineTo(0.000000, 0.157895).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250, both=True)
solid=solid0

