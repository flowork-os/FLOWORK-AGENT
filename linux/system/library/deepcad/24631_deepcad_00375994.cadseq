loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.725218, -0.290021), (0.435197, 0.435197)).threePointArc((0.491138, 0.575082), (0.435197, 0.714967)).threePointArc((0.487528, 0.865787), (0.419655, 1.010280)).threePointArc((0.271998, 1.360657), (0.124342, 1.010280)).threePointArc((0.065293, 0.862623), (0.124342, 0.714967)).threePointArc((0.067403, 0.575082), (0.124342, 0.435197)).close()
