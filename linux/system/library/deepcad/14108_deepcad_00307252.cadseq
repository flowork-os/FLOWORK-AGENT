# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00307252" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, -0.625000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.320312, 0.000000).lineTo(1.320312, 1.070148).lineTo(0.986760, 1.070148).lineTo(0.986760, 0.319655).lineTo(0.291859, 0.319655).lineTo(0.291859, 0.764391).lineTo(0.000000, 0.764391).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.445312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
