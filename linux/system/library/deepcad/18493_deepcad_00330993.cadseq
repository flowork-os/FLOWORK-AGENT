import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.343421, 0.000000).circle(0.343421)
loop1=wp_sketch0.moveTo(0.343421, 0.000000).circle(0.200329)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.546875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.174873, -0.363943), (0.538816, -0.538816)).threePointArc((0.609375, -0.472458), (0.679934, -0.538816)).threePointArc((1.043877, -0.363943), (1.218750, 0.000000)).threePointArc((1.152393, 0.070559), (1.218750, 0.141118)).threePointArc((1.043877, 0.505061), (0.679934, 0.679934)).threePointArc((0.609375, 0.613577), (0.538816, 0.679934)).threePointArc((0.174873, 0.505061), (0.000000, 0.141118)).threePointArc((0.066357, 0.070559), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.615789, 0.064145).circle(0.346382)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.273438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.757895, 0.000000).circle(0.757895)
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.037474, 0.107131), (0.142105, 0.063158)).threePointArc((0.313567, 0.433662), (0.678947, 0.615789)).threePointArc((0.750000, 0.691341), (0.821053, 0.615789)).threePointArc((1.186433, 0.433662), (1.357895, 0.063158)).threePointArc((1.425052, 0.000000), (1.357895, -0.063158)).threePointArc((1.186433, -0.433662), (0.821053, -0.615789)).threePointArc((0.750000, -0.691341), (0.678947, -0.615789)).threePointArc((0.313567, -0.433662), (0.142105, -0.063158)).close()
