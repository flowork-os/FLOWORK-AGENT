# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.695312, 0.546875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.410773, -0.152138).lineTo(0.471628, -0.182566).lineTo(1.338816, -0.517270).lineTo(1.445312, -0.517270).lineTo(0.000000, 0.060855).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.695312)
