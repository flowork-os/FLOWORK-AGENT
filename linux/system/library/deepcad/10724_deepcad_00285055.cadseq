# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285055" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.213158, 0.000000).circle(0.208717)
loop1=wp_sketch0.moveTo(0.213158, 0.000000).circle(0.159868)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.312500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(1.039062, 0.109375).threePointArc((0.924420, 0.213281), (1.039062, 0.317187)).lineTo(0.000000, 0.415625).threePointArc((0.188350, 0.207812), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.710938, 0.153125).threePointArc((0.656250, 0.207812), (0.710938, 0.262500)).lineTo(0.295312, 0.262500).threePointArc((0.240625, 0.207812), (0.295312, 0.153125)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.210938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.406250, 0.000000, 0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.106579, 0.000000).circle(0.104359)
loop5=wp_sketch2.moveTo(0.106579, 0.000000).circle(0.053289)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.265625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
