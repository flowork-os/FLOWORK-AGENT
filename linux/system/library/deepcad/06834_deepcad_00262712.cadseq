wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.289062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.096711, 0.000000).lineTo(0.096711, -0.151974).lineTo(0.594079, -0.151974).lineTo(1.312500, -0.041447).lineTo(1.312500, 0.138158).lineTo(0.884211, 0.138158).threePointArc((0.739145, 0.283224), (0.884211, 0.428289)).lineTo(1.312500, 0.428289).lineTo(1.312500, 0.607895).lineTo(0.594079, 0.718421).lineTo(0.096711, 0.718421).lineTo(0.096711, 0.566447).lineTo(0.000000, 0.566447).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.382812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, -0.437500, 0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
