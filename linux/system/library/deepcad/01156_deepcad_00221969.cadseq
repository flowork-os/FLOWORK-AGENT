# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00221969" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, -0.523438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.227878, -0.227878), (0.455757, 0.000000)).lineTo(0.455757, 0.522780).lineTo(0.455757, 1.045559).threePointArc((0.227878, 1.273438), (0.000000, 1.045559)).lineTo(0.000000, 0.522780).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.227878, 0.000000).circle(0.093832)
loop2=wp_sketch0.moveTo(0.227878, 1.045559).circle(0.093832)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.203125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.233388, 0.000000).lineTo(0.233388, 0.219243).threePointArc((0.116694, 0.335938), (0.000000, 0.219243)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.116694, 0.219243).circle(0.045970)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.328125, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.164062, 0.218750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.164062, -0.187851), (0.328125, 0.000000)).lineTo(0.328125, 0.120888).lineTo(0.162336, 0.120888).lineTo(0.000000, 0.120888).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop5).extrude(-0.242188, both=True)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
