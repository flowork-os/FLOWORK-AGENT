# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00352166" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.426316, 0.000000).lineTo(0.663158, -0.228947).lineTo(0.750000, -0.142105).lineTo(0.560526, 0.047368).lineTo(0.513158, 0.007895).lineTo(0.457895, 0.063158).lineTo(0.000000, 0.063158).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.257812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.562500, -0.257812, -0.140625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(0.707107, 0.000000, 0.707107)))
loop1=wp_sketch1.moveTo(0.125000, 0.000000).threePointArc((0.060553, 0.008081), (0.000000, 0.031579)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.125000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.562500, -0.125000, -0.140625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(0.707107, 0.000000, 0.707107)))
loop2=wp_sketch2.moveTo(0.125000, 0.000000).lineTo(0.125000, 0.031579).threePointArc((0.064447, 0.008081), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(-0.125000)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
