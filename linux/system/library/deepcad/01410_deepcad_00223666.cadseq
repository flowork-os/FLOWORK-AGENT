# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00223666" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.134114, -0.323780), (0.457895, -0.457895)).lineTo(1.042105, -0.457895).threePointArc((1.365886, -0.323780), (1.500000, 0.000000)).lineTo(1.500000, 0.142105).threePointArc((1.365886, 0.465886), (1.042105, 0.600000)).lineTo(0.457895, 0.600000).threePointArc((0.134114, 0.465886), (0.000000, 0.142105)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.109375, -0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.083725, -0.202130), (0.285855, -0.285855)).lineTo(0.948520, -0.285855).threePointArc((1.150650, -0.202130), (1.234375, 0.000000)).lineTo(1.234375, 0.194901).threePointArc((1.150650, 0.397032), (0.948520, 0.480757)).lineTo(0.285855, 0.480757).threePointArc((0.083725, 0.397032), (0.000000, 0.194901)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.210938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
