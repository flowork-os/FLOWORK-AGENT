loop4=wp_sketch3.moveTo(0.523438, 0.000000).threePointArc((0.489947, 0.123972), (0.523438, 0.247944)).lineTo(0.000000, 0.247944).threePointArc((-0.010676, 0.123972), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop4).extrude(-0.125000)
