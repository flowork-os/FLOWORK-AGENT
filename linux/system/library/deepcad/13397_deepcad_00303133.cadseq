# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.125000, -0.054688, 0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.075000, 0.000000).circle(0.075000)
solid3=wp_sketch3.add(loop3).extrude(-0.484375)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.437500, 0.375000, 0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.051316, 0.000000).circle(0.051316)
