import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.126316).lineTo(0.686842, 0.126316).lineTo(0.686842, 0.434211).lineTo(0.497368, 0.434211).lineTo(0.497368, 0.497368).lineTo(0.252632, 0.497368).lineTo(0.252632, 0.434211).lineTo(0.063158, 0.434211).lineTo(0.063158, 0.126316).lineTo(0.000000, 0.126316).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.028289, 0.000000).lineTo(0.028289, -0.311184).lineTo(0.212171, -0.311184).lineTo(0.212171, -0.339474).lineTo(0.459704, -0.339474).lineTo(0.459704, -0.311184).lineTo(0.643586, -0.311184).lineTo(0.643586, 0.000000).lineTo(0.671875, 0.000000).lineTo(0.671875, 0.127303).lineTo(0.000000, 0.127303).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.171875, -0.062500, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.026316).lineTo(0.000000, 0.026316).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.062500)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.250000, -0.062500, 0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.063158).lineTo(0.000000, 0.063158).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.062500)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
