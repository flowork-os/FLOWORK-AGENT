wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, 0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.071382, 0.081579).lineTo(0.183553, 0.219243).lineTo(0.137664, 0.219243).lineTo(0.203947, 0.326316).lineTo(0.158059, 0.326316).lineTo(0.188651, 0.392599).lineTo(0.229441, 0.484375).lineTo(0.168257, 0.402796).lineTo(0.056086, 0.260033).lineTo(0.096875, 0.260033).lineTo(0.025493, 0.147862).lineTo(0.071382, 0.147862).lineTo(0.045888, 0.091776).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
