# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00230924" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.663158, 0.000000).lineTo(0.663158, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.086842, 0.663158).circle(0.039474)
loop2=wp_sketch0.moveTo(0.205263, 0.457895).circle(0.039474)
loop3=wp_sketch0.moveTo(0.331579, 0.663158).circle(0.039474)
loop4=wp_sketch0.moveTo(0.457895, 0.457895).circle(0.039474)
loop5=wp_sketch0.moveTo(0.584211, 0.663158).circle(0.039474)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
