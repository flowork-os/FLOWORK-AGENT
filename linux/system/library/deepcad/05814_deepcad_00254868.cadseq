# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00254868" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.202961, 0.000000).threePointArc((1.243582, 0.150370), (1.202961, 0.300740)).lineTo(0.000000, 0.300740).threePointArc((-0.150370, 0.150370), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.601480, 0.143832).circle(0.078454)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.148438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
