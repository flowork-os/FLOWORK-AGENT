wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, 0.000000, 0.523438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.469737, 0.000000).circle(0.459951)
