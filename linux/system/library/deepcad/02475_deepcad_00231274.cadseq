import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.221053).lineTo(0.000000, 0.221053).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.252632, 0.110526).circle(0.047368)
loop2=wp_sketch0.moveTo(1.247368, 0.110526).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.125000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.203125, 0.000000).lineTo(0.203125, 0.012829).lineTo(0.000000, 0.012829).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.148438)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.203125, 0.000000).lineTo(0.203125, 0.012829).lineTo(0.000000, 0.012829).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(-0.148438)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.200329, 0.000000).lineTo(0.200329, 0.226562).lineTo(0.000000, 0.226562).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(-0.148438)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.750000, -0.226562, -0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.200329, 0.000000).lineTo(0.200329, 0.226562).lineTo(0.000000, 0.226562).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(-0.148438)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
