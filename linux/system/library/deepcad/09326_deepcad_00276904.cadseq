import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.032237, 0.000000).threePointArc((0.173273, 0.141036), (0.314309, 0.000000)).lineTo(0.354605, 0.000000).lineTo(0.354605, 0.588322).threePointArc((0.177303, 0.765625), (0.000000, 0.588322)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.123019, 0.128834), (0.298191, 0.161184)).lineTo(0.298191, 0.588322).threePointArc((0.177303, 0.709211), (0.056414, 0.588322)).lineTo(0.056414, 0.161184).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
