# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00320409" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.375000, 0.000000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.130263, -0.181579).lineTo(0.311842, -0.047368).lineTo(0.375000, -0.003947).threePointArc((-0.028185, -0.161565), (0.240789, 0.177632)).lineTo(0.181579, 0.130263).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.179688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.221053, 0.000000).circle(0.221053)
loop2=wp_sketch1.moveTo(0.142763, -0.101316).lineTo(0.234868, -0.128947).lineTo(0.322368, -0.078289).lineTo(0.345395, 0.018421).lineTo(0.294737, 0.101316).lineTo(0.202632, 0.128947).lineTo(0.115132, 0.078289).lineTo(0.092105, -0.018421).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.179688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, -0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.703125, 0.000000).threePointArc((0.659114, 0.133224), (0.703125, 0.266447)).lineTo(0.000000, 0.266447).threePointArc((0.044011, 0.133224), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.179688)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
