import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.218421, 0.000000).lineTo(0.218421, 0.156990).lineTo(0.648438, 0.054605).lineTo(0.648438, 0.122862).lineTo(0.218421, 0.218421).lineTo(0.648438, 0.313980).lineTo(0.156990, 0.313980).lineTo(0.156990, 0.040954).lineTo(0.040954, 0.040954).lineTo(0.040954, 0.156990).lineTo(0.000000, 0.156990).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.281250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
