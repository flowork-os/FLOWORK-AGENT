loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.148438, 0.148438), (0.000000, 0.296875)).lineTo(0.000000, 0.196875).threePointArc((0.048438, 0.148438), (0.000000, 0.100000)).lineTo(0.000000, 0.000000).close()
