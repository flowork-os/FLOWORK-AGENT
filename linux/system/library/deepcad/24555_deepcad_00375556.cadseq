# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00375556" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.515625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.515625, 0.000000).lineTo(0.515625, 0.483059).lineTo(0.515625, 0.515625).lineTo(0.000000, 0.515625).lineTo(0.000000, 0.483059).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.695312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.060691, 0.000000).lineTo(0.060691, 0.033717).lineTo(0.579934, 0.033717).lineTo(0.579934, 0.000000).lineTo(0.640625, 0.000000).lineTo(0.323684, 0.384375).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.695312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, -0.695312, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.060691, 0.000000).lineTo(0.579934, 0.000000).lineTo(0.640625, 0.000000).lineTo(0.323684, 0.384375).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.054688)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.179688, -0.695312, -0.515625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.157401, 0.000000).lineTo(0.157401, 0.226562).lineTo(0.000000, 0.226562).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.007812)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
