import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.107965, -0.018061), (0.198602, -0.079441)).threePointArc((0.522985, -0.220855), (0.847368, -0.079441)).threePointArc((0.936859, -0.012078), (1.045970, 0.013240)).threePointArc((1.257812, 0.225082), (1.045970, 0.436924)).threePointArc((0.938261, 0.455623), (0.847368, 0.516365)).threePointArc((0.525871, 0.664399), (0.198602, 0.529605)).threePointArc((0.109409, 0.461605), (0.000000, 0.436924)).threePointArc((-0.226657, 0.218462), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.013240, 0.225082).circle(0.092681)
loop2=wp_sketch0.moveTo(0.516365, 0.225082).circle(0.304523)
loop3=wp_sketch0.moveTo(1.045970, 0.225082).circle(0.092681)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
