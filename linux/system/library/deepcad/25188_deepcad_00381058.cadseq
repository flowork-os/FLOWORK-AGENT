# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00381058" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.750000).threePointArc((0.705341, 0.731501), (0.686842, 0.686842)).lineTo(0.686842, 0.126316).threePointArc((0.668344, 0.081656), (0.623684, 0.063158)).lineTo(0.063158, 0.063158).threePointArc((0.018499, 0.044659), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.437500, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
