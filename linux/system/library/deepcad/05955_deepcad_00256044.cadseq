# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00256044" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, 0.585938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.164474, -0.164474).lineTo(0.164474, -0.328947).lineTo(0.453947, -0.328947).lineTo(0.453947, -0.098684).lineTo(0.625000, -0.032895).lineTo(0.453947, 0.164474).lineTo(0.164474, 0.164474).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.093750, -0.468750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.043009, -0.083493), (0.135691, -0.098684)).lineTo(0.585938, 0.030839).lineTo(0.585938, 0.370066).lineTo(0.419408, 0.468750).lineTo(0.000000, 0.314556).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.132812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
