# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297504" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.726562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.515625, 0.000000).lineTo(0.515625, 0.187500).lineTo(1.218750, 0.187500).lineTo(1.484375, 0.453125).lineTo(1.484375, 0.906250).lineTo(1.093750, 0.906250).lineTo(1.093750, 1.156250).lineTo(0.328125, 1.156250).lineTo(0.406250, 0.781250).lineTo(0.265625, 0.781250).lineTo(0.265625, 0.578125).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.281250, 0.203125).circle(0.062500)
loop2=wp_sketch0.moveTo(0.750000, 0.859375).circle(0.093750)
loop3=wp_sketch0.moveTo(0.968750, 0.390625).circle(0.125000)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.164062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
