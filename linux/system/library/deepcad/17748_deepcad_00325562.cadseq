import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.382812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.536595, 0.000000).lineTo(0.536595, 0.155016).lineTo(0.775082, 0.155016).lineTo(0.775082, 0.572368).lineTo(1.085115, 0.572368).lineTo(1.085115, 1.132812).lineTo(0.155016, 1.132812).lineTo(0.155016, 0.906250).lineTo(0.000000, 0.906250).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
