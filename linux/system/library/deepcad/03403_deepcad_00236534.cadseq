solid2=wp_sketch2.add(loop2).extrude(0.445312)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.132812, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch3.moveTo(0.395888, 0.000000).lineTo(0.395888, 0.009539).lineTo(0.395888, 0.453125).lineTo(0.000000, 0.453125).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.140625)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, -0.320312, 0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.195641, 0.000000).lineTo(0.000000, 0.304688).lineTo(0.000000, 0.000000).close()
