# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00289734" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.303947, 0.000000).circle(0.303947)
loop1=wp_sketch0.moveTo(0.303947, 0.000000).circle(0.177303)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.484375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.191201, 0.000000).threePointArc((0.166602, 0.119819), (0.191201, 0.239638)).lineTo(0.002549, 0.239638).threePointArc((-0.135918, 0.121279), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.040789, 0.119819).circle(0.091776)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.179688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.273438, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.366201, 0.000000).threePointArc((0.477579, 0.113904), (0.381250, 0.240789)).lineTo(0.000000, 0.240789).threePointArc((0.024717, 0.120395), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.092990, -0.063666), (0.155510, 0.030099)).lineTo(0.346135, 0.030099).threePointArc((0.447165, 0.115061), (0.356168, 0.210691)).lineTo(0.150493, 0.210691).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.179688)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
