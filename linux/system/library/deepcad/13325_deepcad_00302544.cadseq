loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.082031, 0.082031), (0.000000, 0.164062)).lineTo(0.000000, 0.122615).threePointArc((0.040584, 0.082031), (0.000000, 0.041447)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.085938)
