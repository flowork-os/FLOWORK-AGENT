wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.664062, 0.000000).lineTo(0.664062, 0.041941).threePointArc((0.622122, 0.083882), (0.664062, 0.125822)).lineTo(0.664062, 0.167763).lineTo(0.000000, 0.167763).lineTo(0.000000, 0.125822).threePointArc((0.041941, 0.083882), (0.000000, 0.041941)).lineTo(0.000000, 0.000000).close()
