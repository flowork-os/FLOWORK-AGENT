# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.722533, 0.031414).threePointArc((0.746094, 0.026577), (0.769655, 0.031414)).lineTo(1.492188, 0.000000).threePointArc((1.496529, 0.078536), (1.492188, 0.157072)).lineTo(0.769655, 0.141365).threePointArc((0.746094, 0.146202), (0.722533, 0.141365)).lineTo(0.000000, 0.157072).threePointArc((-0.004341, 0.078536), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.738240, 0.078536).circle(0.015707)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
