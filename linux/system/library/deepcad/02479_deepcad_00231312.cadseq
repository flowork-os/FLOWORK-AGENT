# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231312" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.836184, 0.000000).lineTo(0.836184, 0.968750).lineTo(0.000000, 0.968750).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.030592, 0.040789).circle(0.010197)
loop2=wp_sketch0.moveTo(0.030592, 0.927961).circle(0.010197)
loop3=wp_sketch0.moveTo(0.805592, 0.040789).circle(0.010197)
loop4=wp_sketch0.moveTo(0.805592, 0.927961).circle(0.010197)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.343750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
