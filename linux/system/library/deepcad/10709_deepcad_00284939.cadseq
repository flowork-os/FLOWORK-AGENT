# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284939" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.929687, 0.097862).threePointArc((0.827112, 0.190831), (0.929687, 0.283799)).lineTo(0.000000, 0.371875).threePointArc((0.168524, 0.185937), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.636102, 0.137007).threePointArc((0.685033, 0.185937), (0.636102, 0.234868)).lineTo(0.264227, 0.234868).threePointArc((0.215296, 0.185937), (0.264227, 0.137007)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.189474, 0.000000).circle(0.189474)
loop3=wp_sketch1.moveTo(0.189474, 0.000000).circle(0.142105)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.281250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.562500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.094737, 0.000000).circle(0.092763)
loop5=wp_sketch2.moveTo(0.094737, 0.000000).circle(0.047368)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.234375)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
