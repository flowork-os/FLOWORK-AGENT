# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00299689" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.734375, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.014803, 0.000000).lineTo(0.014803, 0.039062).lineTo(0.000000, 0.039062).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.014803, 0.000000).lineTo(0.014803, 0.039062).lineTo(0.000000, 0.039062).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.835938, 0.000000).lineTo(0.835938, 0.008799).lineTo(0.835938, 0.052796).lineTo(0.835938, 0.061595).lineTo(0.000000, 0.061595).lineTo(0.000000, 0.052796).lineTo(0.000000, 0.008799).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.431168, 0.008799).lineTo(0.431168, 0.052796).lineTo(0.404770, 0.052796).lineTo(0.404770, 0.008799).close()
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.023438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
