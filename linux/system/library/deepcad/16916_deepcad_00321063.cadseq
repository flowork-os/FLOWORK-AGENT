# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00321063" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.476562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.343750, 0.133882).lineTo(0.343750, 0.227961).lineTo(0.000000, 0.090461).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.000000, 0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.687500, 0.000000).lineTo(0.687500, 0.094079).lineTo(0.000000, 0.094079).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.644079, 0.043421).circle(0.021711)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.140625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.070312, 0.476562), cq.Vector(0.932712, 0.024541, 0.359787), cq.Vector(0.359895, 0.000000, -0.932993)))
loop3=wp_sketch2.moveTo(0.071053, 0.000000).circle(0.071053)
solid2=wp_sketch2.add(loop3).extrude(0.226562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
