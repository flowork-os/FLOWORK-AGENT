import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.445312, 0.000000).lineTo(1.445312, 0.730263).lineTo(1.247533, 1.049753).lineTo(0.943257, 1.049753).lineTo(0.851974, 0.882401).lineTo(0.471628, 0.882401).lineTo(0.380345, 0.730263).lineTo(0.167352, 0.578125).lineTo(0.136924, 0.547697).lineTo(0.000000, 0.334704).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.187500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
