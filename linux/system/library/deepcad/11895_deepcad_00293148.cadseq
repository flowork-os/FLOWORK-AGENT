# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00293148" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(1.357895, -0.015789).lineTo(1.357895, 0.015789).lineTo(0.757895, 0.015789).lineTo(0.757895, -0.015789).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.757895)
loop3=wp_sketch1.moveTo(0.900000, -0.394737).lineTo(0.900000, -0.015789).lineTo(1.357895, -0.015789).lineTo(1.357895, 0.015789).lineTo(0.900000, 0.015789).lineTo(0.900000, 0.394737).lineTo(0.600000, 0.394737).lineTo(0.600000, -0.394737).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
