import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.315789, -0.252632).lineTo(0.378947, -0.647368).lineTo(0.757895, -0.505263).lineTo(1.121053, -0.647368).lineTo(1.184211, -0.252632).lineTo(1.500000, 0.000000).lineTo(1.184211, 0.252632).lineTo(1.121053, 0.647368).lineTo(0.757895, 0.505263).lineTo(0.378947, 0.647368).lineTo(0.315789, 0.252632).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.296875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
