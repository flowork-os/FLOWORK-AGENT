# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00323390" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.252632, 0.000000).lineTo(0.252632, 0.086842).lineTo(0.418421, 0.086842).lineTo(0.418421, 0.063158).lineTo(0.631579, 0.063158).lineTo(0.631579, -0.118421).lineTo(0.750000, -0.118421).lineTo(0.750000, 0.300000).lineTo(0.000000, 0.300000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.453125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.148438, 0.000000, 0.453125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.106579, 0.000000).lineTo(0.106579, 0.088816).lineTo(0.270888, 0.088816).lineTo(0.270888, 0.062171).lineTo(0.421875, 0.062171).lineTo(0.421875, 0.301974).lineTo(0.000000, 0.301974).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.148438)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
