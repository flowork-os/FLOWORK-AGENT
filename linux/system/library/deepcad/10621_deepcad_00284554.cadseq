# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284554" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.560526).lineTo(0.000000, 0.560526).threePointArc((-0.280263, 0.280263), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.655263, 0.094737).lineTo(0.655263, 0.465789).lineTo(0.000000, 0.465789).threePointArc((-0.185526, 0.280263), (0.000000, 0.094737)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.562500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
