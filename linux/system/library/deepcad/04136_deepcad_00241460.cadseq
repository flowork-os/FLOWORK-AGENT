# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.110505, -0.019833), (0.202714, -0.083882)).threePointArc((0.349136, -0.186789), (0.524260, -0.223684)).lineTo(0.524260, -0.090872).threePointArc((0.213199, 0.220189), (0.524260, 0.531250)).lineTo(0.524260, 0.664062).threePointArc((0.349136, 0.627168), (0.202714, 0.524260)).threePointArc((0.110505, 0.460211), (0.000000, 0.440378)).threePointArc((-0.228448, 0.220189), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.006990, 0.223684).circle(0.090872)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.179688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.437500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.176932, 0.036309), (0.325247, 0.139391)).threePointArc((0.413699, 0.202492), (0.520395, 0.223026)).threePointArc((0.746966, 0.441406), (0.520395, 0.659786)).threePointArc((0.413699, 0.680321), (0.325247, 0.743421)).threePointArc((0.176932, 0.846503), (0.000000, 0.882812)).lineTo(0.000000, 0.752714).threePointArc((0.311308, 0.441406), (0.000000, 0.130099)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.529687, 0.446053).circle(0.092928)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.179688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
