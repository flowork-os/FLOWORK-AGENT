# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00279232" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.539062, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002708, -0.062231), (0.031086, -0.117681)).threePointArc((0.141333, -0.155768), (0.210938, -0.062171)).lineTo(0.119901, -0.086595).threePointArc((0.086799, -0.039580), (0.091036, 0.017763)).lineTo(0.184293, 0.042188).threePointArc((0.076702, 0.088562), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.632812, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.004527, -0.055431), (0.027138, -0.101151)).lineTo(0.117188, -0.076480).lineTo(0.090049, 0.024671).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.031250, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
