# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00317348" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, -0.718750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.437500, 0.000000).lineTo(1.437500, 1.437500).lineTo(0.000000, 1.437500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.332895, 0.105921).lineTo(0.332895, 0.499342).lineTo(0.075658, 0.499342).lineTo(0.075658, 0.105921).close()
loop2=wp_sketch0.moveTo(0.332895, 0.938158).lineTo(0.332895, 1.331579).lineTo(0.075658, 1.331579).lineTo(0.075658, 0.938158).close()
loop3=wp_sketch0.moveTo(1.361842, 0.105921).lineTo(1.361842, 0.499342).lineTo(1.104605, 0.499342).lineTo(1.104605, 0.105921).close()
loop4=wp_sketch0.moveTo(1.361842, 0.938158).lineTo(1.361842, 1.331579).lineTo(1.104605, 1.331579).lineTo(1.104605, 0.938158).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch1.moveTo(1.468421, 0.031579).lineTo(1.468421, 1.468421).lineTo(0.031579, 1.468421).lineTo(0.031579, 0.031579).close()
solid1=wp_sketch1.add(loop5).add(loop6).extrude(0.031250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
