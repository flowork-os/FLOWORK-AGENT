wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.102748, -0.017820), (0.186513, -0.079934)).threePointArc((0.512911, -0.227019), (0.839309, -0.079934)).threePointArc((0.923074, -0.017820), (1.025822, 0.000000)).threePointArc((1.262454, 0.219819), (1.025822, 0.439638)).threePointArc((0.923074, 0.457458), (0.839309, 0.519572)).threePointArc((0.512911, 0.666657), (0.186513, 0.519572)).threePointArc((0.102748, 0.457458), (0.000000, 0.439638)).threePointArc((-0.236631, 0.219819), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.013322, 0.226480).circle(0.093257)
