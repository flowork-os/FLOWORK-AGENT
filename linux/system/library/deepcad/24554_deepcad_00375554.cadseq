# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00375554" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.812500, 0.000000).lineTo(0.812500, 0.145395).lineTo(0.778289, 0.145395).lineTo(0.778289, 0.034211).lineTo(0.034211, 0.034211).lineTo(0.034211, 0.145395).lineTo(0.000000, 0.145395).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.695312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, -0.085938, 0.343750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.059211, 0.000000).circle(0.057977)
loop2=wp_sketch1.moveTo(0.059211, 0.000000).circle(0.034539)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.023438)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, -0.085938, 0.343750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.059211, 0.000000).circle(0.057977)
loop4=wp_sketch2.moveTo(0.059211, 0.000000).circle(0.034539)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.023438)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
