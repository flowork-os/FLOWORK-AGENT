import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.703125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013440, -0.032448), (0.045888, -0.045888)).lineTo(1.024836, -0.045888).threePointArc((1.057283, -0.032448), (1.070724, 0.000000)).lineTo(1.070724, 1.407237).threePointArc((1.057283, 1.439685), (1.024836, 1.453125)).lineTo(0.045888, 1.453125).threePointArc((0.013440, 1.439685), (0.000000, 1.407237)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.335938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
