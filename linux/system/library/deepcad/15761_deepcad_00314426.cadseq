# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00314426" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.048849, 0.000000).lineTo(0.048849, -0.171875).lineTo(0.153783, -0.171875).lineTo(0.153783, 0.117599).lineTo(0.000000, 0.117599).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.203125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, -0.156250, 0.117188), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.221053, -0.126316).lineTo(0.250000, -0.047368).lineTo(0.234211, -0.047368).lineTo(0.234211, 0.055263).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.359375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, -0.187500, -0.531250), cq.Vector(0.970031, 0.242980, -0.000000), cq.Vector(0.242980, -0.970031, 0.000000)))
loop2=wp_sketch2.moveTo(0.273849, -0.219079).lineTo(0.529441, 0.867188).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.382812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.445312, -0.101562), cq.Vector(-0.180107, 0.978027, -0.104995), cq.Vector(0.832024, 0.208411, 0.514103)))
loop3=wp_sketch3.moveTo(0.155428, 0.000000).lineTo(0.155428, 0.041447).lineTo(0.132977, 0.164062).lineTo(0.000000, 0.164062).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.546875)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
