import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.300082, -0.424507).threePointArc((0.340337, -0.445080), (0.380592, -0.424507)).lineTo(0.687993, 0.000000).threePointArc((0.690501, 0.053599), (0.644079, 0.080510)).lineTo(0.043914, 0.080510).threePointArc((-0.002508, 0.053599), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.300082, -0.373273).threePointArc((0.340337, -0.393846), (0.380592, -0.373273)).lineTo(0.629441, -0.029276).threePointArc((0.631948, 0.024323), (0.585526, 0.051234)).lineTo(0.102467, 0.051234).threePointArc((0.056045, 0.024323), (0.058553, -0.029276)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.243421, -0.340789).threePointArc((0.282977, -0.361005), (0.322533, -0.340789)).lineTo(0.565954, 0.000000).threePointArc((0.571737, 0.050651), (0.529441, 0.079112)).lineTo(0.042599, 0.079112).threePointArc((-0.002741, 0.052501), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.286020, -0.182566).circle(0.060855)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.031250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
