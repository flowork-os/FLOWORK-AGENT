import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.108553).threePointArc((-0.102023, 0.177632), (0.000000, 0.246711)).lineTo(0.000000, 0.355263).threePointArc((-0.113487, 0.468750), (0.000000, 0.582237)).lineTo(0.000000, 0.690789).threePointArc((-0.102023, 0.759868), (0.000000, 0.828947)).lineTo(0.000000, 0.937500).threePointArc((-0.468750, 0.468750), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
