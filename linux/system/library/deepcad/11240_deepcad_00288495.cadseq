import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.050871, -0.122813), (0.173684, -0.173684)).lineTo(1.326316, -0.173684).threePointArc((1.449129, -0.122813), (1.500000, 0.000000)).lineTo(1.500000, 0.078947).threePointArc((1.449129, 0.201761), (1.326316, 0.252632)).lineTo(0.173684, 0.252632).threePointArc((0.050871, 0.201761), (0.000000, 0.078947)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.189474, 0.047368).circle(0.094737)
loop2=wp_sketch0.moveTo(0.757895, 0.047368).circle(0.142105)
loop3=wp_sketch0.moveTo(1.310526, 0.047368).circle(0.094737)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.281250)
solid=solid0

if __name__ == '__main__':
