import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.655263, -0.368586).lineTo(1.296875, 0.000000).lineTo(1.296875, 0.750822).lineTo(0.655263, 1.119408).lineTo(0.000000, 0.750822).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.092105, 0.122862).lineTo(0.655263, 0.887336).lineTo(0.204770, 0.122862).close()
loop2=wp_sketch0.moveTo(0.655263, -0.259375).lineTo(0.737171, -0.204770).lineTo(0.737171, -0.109211).lineTo(0.655263, -0.054605).lineTo(0.559704, -0.109211).lineTo(0.559704, -0.204770).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.203125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
