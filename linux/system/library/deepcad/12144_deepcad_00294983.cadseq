import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.421875, 0.000000).lineTo(0.421875, 0.102138).lineTo(0.142105, 0.102138).lineTo(0.142105, 0.079934).lineTo(0.399671, 0.079934).lineTo(0.399671, 0.022204).lineTo(0.022204, 0.022204).lineTo(0.022204, 0.079934).lineTo(0.097697, 0.079934).lineTo(0.097697, 0.102138).lineTo(0.000000, 0.102138).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
