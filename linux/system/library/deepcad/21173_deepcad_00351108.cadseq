# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00351108" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.164062, 0.000000).lineTo(0.164062, 0.122615).threePointArc((0.151923, 0.151923), (0.122615, 0.164062)).lineTo(0.041447, 0.164062).threePointArc((0.012140, 0.151923), (0.000000, 0.122615)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.082895, 0.082895).circle(0.032813)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, -0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.138980, -0.502210), (0.277961, 0.000000)).threePointArc((0.234472, 0.045705), (0.219161, 0.106908)).lineTo(0.219161, 0.267270).lineTo(0.058799, 0.267270).lineTo(0.058799, 0.106908).threePointArc((0.043489, 0.045705), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.138980, -0.235197).circle(0.251234)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
