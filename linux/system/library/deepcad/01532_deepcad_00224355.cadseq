import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, -0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.709293, 0.000000).lineTo(0.380345, 0.976563).lineTo(0.000000, 0.976563).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, -0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.709293, 0.000000).lineTo(0.380345, 0.976563).lineTo(0.000000, 0.976563).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.380345, 0.000000).lineTo(0.709293, -0.976563).lineTo(0.760691, -0.976563).lineTo(0.411184, 0.051398).lineTo(0.000000, 0.051398).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.250000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.203125, -0.632812, 0.031250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(0.949528, 0.000000, 0.313682)))
loop3=wp_sketch3.moveTo(0.134211, 0.000000).circle(0.134211)
solid3=wp_sketch3.add(loop3).extrude(-1.000000)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.570312, 0.257812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.102632, 0.000000).circle(0.102632)
solid4=wp_sketch4.add(loop4).extrude(0.992188)
solid_temp=solid4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.570312, 0.257812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.102632, 0.000000).circle(0.102632)
solid4=wp_sketch4.add(loop4).extrude(-0.953125)
solid_temp=solid_temp.union(solid4)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
