# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00362940" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.221053, 0.000000).circle(0.221053)
loop1=wp_sketch0.moveTo(0.221053, 0.000000).circle(0.175000)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.489474, 0.000000).circle(0.479276)
loop3=wp_sketch1.moveTo(0.112171, 0.000000).circle(0.040789)
loop4=wp_sketch1.moveTo(0.489474, 0.000000).circle(0.224342)
loop5=wp_sketch1.moveTo(0.489474, -0.377303).circle(0.040789)
loop6=wp_sketch1.moveTo(0.489474, 0.377303).circle(0.040789)
loop7=wp_sketch1.moveTo(0.856579, 0.000000).circle(0.040789)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).add(loop7).extrude(0.085938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
