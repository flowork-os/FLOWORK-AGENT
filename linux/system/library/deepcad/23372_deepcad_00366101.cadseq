import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.030757, 0.000000).lineTo(0.430592, 0.707401).lineTo(0.645888, 0.753536).lineTo(0.738158, 0.399836).lineTo(0.815049, 0.753536).lineTo(1.030345, 0.707401).lineTo(1.430181, 0.000000).lineTo(1.460938, 0.000000).lineTo(0.999589, 1.107237).lineTo(0.815049, 0.984211).lineTo(0.738158, 1.199507).lineTo(0.645888, 0.984211).lineTo(0.461349, 1.107237).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
