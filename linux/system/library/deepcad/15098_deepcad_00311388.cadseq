# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00311388" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.339474, 0.000000).lineTo(0.339474, 0.086842).threePointArc((0.352670, 0.110807), (0.378947, 0.118421)).lineTo(0.631579, 0.118421).threePointArc((0.750000, 0.236842), (0.631579, 0.355263)).lineTo(0.378947, 0.355263).threePointArc((0.351035, 0.366825), (0.339474, 0.394737)).lineTo(0.339474, 0.473684).lineTo(0.000000, 0.473684).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.426316, 0.236842).circle(0.055263)
loop2=wp_sketch0.moveTo(0.631579, 0.236842).circle(0.055263)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.242188, 0.039062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.343750, 0.000000).lineTo(0.343750, 0.043421).lineTo(0.000000, 0.043421).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.367188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.195312, 0.039062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.343750, 0.000000).lineTo(0.343750, 0.043421).lineTo(0.000000, 0.043421).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.367188)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
