# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387188" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, -0.312500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.816447, 0.000000).lineTo(0.794079, 0.794079).lineTo(0.693421, 1.062500).lineTo(0.089474, 1.062500).lineTo(0.000000, 0.805263).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.380263, 0.715789).circle(0.156579)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.375000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
