# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.024857, -0.060011), (0.084868, -0.084868)).lineTo(0.587007, -0.084868).threePointArc((0.647018, -0.060011), (0.671875, 0.000000)).lineTo(0.671875, 0.502138).threePointArc((0.647018, 0.562149), (0.587007, 0.587007)).lineTo(0.084868, 0.587007).threePointArc((0.024857, 0.562149), (0.000000, 0.502138)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
