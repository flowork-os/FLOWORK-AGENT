# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00283656" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.256579, 0.000000).circle(0.256579)
loop1=wp_sketch0.moveTo(0.122944, -0.074836).circle(0.064145)
loop2=wp_sketch0.moveTo(0.256579, 0.149671).circle(0.064145)
loop3=wp_sketch0.moveTo(0.384868, -0.074836).circle(0.064145)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.250000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, -0.250000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch1.moveTo(0.051316, 0.000000).circle(0.051316)
solid1=wp_sketch1.add(loop4).extrude(0.500000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
