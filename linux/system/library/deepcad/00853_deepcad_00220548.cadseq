wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.022425, -0.054138), (0.076562, -0.076562)).lineTo(0.754687, -0.076562).threePointArc((0.887784, -0.053843), (1.006250, 0.010937)).threePointArc((1.030236, 0.039960), (1.039062, 0.076562)).lineTo(1.039062, 0.339062).lineTo(1.039062, 0.601562).threePointArc((1.030236, 0.638165), (1.006250, 0.667187)).threePointArc((0.887784, 0.731968), (0.754687, 0.754687)).lineTo(0.076562, 0.754687).threePointArc((0.020159, 0.726794), (0.000000, 0.667187)).lineTo(0.000000, 0.339062).lineTo(0.000000, 0.000000).close()
