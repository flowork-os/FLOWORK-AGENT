import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.048355, 0.000000).lineTo(0.096711, 0.000000).lineTo(0.145066, 0.000000).lineTo(0.201480, 0.000000).lineTo(0.265954, 0.000000).lineTo(0.765625, 0.000000).lineTo(0.765625, 0.120888).lineTo(0.000000, 0.120888).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.414062, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.332374, 0.061883), (0.000000, 0.123766)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.162664, 0.063651).circle(0.088405)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.050000, 0.000000).lineTo(0.050000, 0.148438).lineTo(0.000000, 0.148438).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.078125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.051809, 0.000000).lineTo(0.051809, 0.078125).lineTo(0.000000, 0.078125).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.078125)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.036184, -0.078125).lineTo(0.073191, 0.000000).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(0.078125)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
