wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.122757, -0.209466), (0.365543, -0.208882)).lineTo(0.929523, 0.261102).threePointArc((0.976521, 0.422985), (0.814638, 0.469984)).lineTo(0.480428, 0.281990).threePointArc((0.405236, 0.280782), (0.365543, 0.344655)).lineTo(0.365543, 0.605757).threePointArc((0.245436, 0.730369), (0.125329, 0.605757)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.240214, 0.000000).circle(0.083553)
loop2=wp_sketch0.moveTo(0.240214, 0.605757).circle(0.062664)
loop3=wp_sketch0.moveTo(0.866859, 0.365543).circle(0.062664)
