loop3=wp_sketch1.moveTo(0.652796, 0.759375).lineTo(0.652796, 0.173191).lineTo(0.759375, 0.173191).lineTo(0.759375, 0.839309).lineTo(0.559539, 0.839309).lineTo(0.506250, 0.759375).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.578125)
