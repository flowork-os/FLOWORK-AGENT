loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.141312, 0.006212), (0.236842, 0.110526)).lineTo(1.263158, 0.110526).threePointArc((1.352477, 0.147523), (1.389474, 0.236842)).lineTo(1.389474, 1.263158).threePointArc((1.352477, 1.352477), (1.263158, 1.389474)).lineTo(0.236842, 1.389474).threePointArc((0.147523, 1.352477), (0.110526, 1.263158)).lineTo(0.110526, 0.236842).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, -0.507812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
