# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00334803" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.126316, 0.126316).circle(0.047368)
loop2=wp_sketch0.moveTo(0.126316, 1.373684).circle(0.047368)
loop3=wp_sketch0.moveTo(1.184211, 0.315789).lineTo(1.184211, 1.184211).lineTo(0.315789, 1.184211).lineTo(0.315789, 0.315789).close()
loop4=wp_sketch0.moveTo(1.373684, 0.126316).circle(0.047368)
loop5=wp_sketch0.moveTo(1.373684, 1.373684).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
