wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.078947, 0.000000).lineTo(0.078947, 0.268421).threePointArc((0.092821, 0.301916), (0.126316, 0.315789)).lineTo(0.623684, 0.315789).threePointArc((0.657179, 0.301916), (0.671053, 0.268421)).lineTo(0.671053, 0.000000).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.339474).lineTo(0.000000, 0.339474).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
