# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00351288" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.225000, 0.000000).circle(0.220312)
loop1=wp_sketch0.moveTo(0.135937, -0.150000).lineTo(0.309375, -0.150000).lineTo(0.393750, 0.000000).lineTo(0.309375, 0.150000).lineTo(0.135937, 0.150000).lineTo(0.051562, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.148438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.077796, 0.000000).threePointArc((0.062643, 0.014954), (0.056579, 0.035362)).lineTo(0.622368, 0.035362).threePointArc((0.649164, 0.029519), (0.671875, 0.014145)).threePointArc((0.625777, 0.105678), (0.650658, 0.205099)).threePointArc((0.628562, 0.188290), (0.601151, 0.183882)).lineTo(0.077796, 0.183882).threePointArc((0.040960, 0.192545), (0.014145, 0.219243)).threePointArc((0.035965, 0.107758), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.544572, 0.070724).threePointArc((0.579934, 0.106086), (0.544572, 0.141447)).lineTo(0.099013, 0.141447).threePointArc((0.063651, 0.106086), (0.099013, 0.070724)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.148438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.289062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.150000, 0.000000).circle(0.150000)
loop5=wp_sketch2.moveTo(0.084375, -0.090625).lineTo(0.212500, -0.090625).lineTo(0.253125, 0.034375).lineTo(0.150000, 0.112500).lineTo(0.043750, 0.034375).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.148438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
