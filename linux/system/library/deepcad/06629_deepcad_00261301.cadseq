# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00261301" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, -0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.416941, 0.000000).lineTo(0.416941, -0.514227).lineTo(0.903372, -0.514227).lineTo(0.903372, 0.000000).lineTo(1.320312, 0.000000).lineTo(1.320312, 0.236266).lineTo(0.667105, 0.236266).lineTo(0.000000, 0.236266).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.492188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
