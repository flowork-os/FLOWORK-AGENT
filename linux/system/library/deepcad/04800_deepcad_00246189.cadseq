# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00246189" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.390625, 0.000000).lineTo(0.390625, 0.742188).lineTo(0.000000, 0.742188).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.015625, 0.000000).lineTo(1.015625, 0.470395).lineTo(0.000000, 0.737664).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.780428, 0.235197).circle(0.096217)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.132812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.390625, 0.000000).lineTo(0.390625, 0.742188).lineTo(0.000000, 0.742188).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.132812)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(1.015625, 0.000000).lineTo(1.015625, 0.470395).lineTo(0.000000, 0.737664).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch3.moveTo(0.780428, 0.235197).circle(0.096217)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(-0.132812)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.132812, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.131579, 0.000000).lineTo(0.131579, 0.625000).lineTo(0.000000, 0.625000).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(0.414062)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
