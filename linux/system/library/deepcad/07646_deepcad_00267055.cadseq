# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267055" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.554688, 0.000000).lineTo(0.554688, 0.245230).lineTo(0.000000, 0.245230).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.122615, 0.122615).circle(0.064227)
loop2=wp_sketch0.moveTo(0.432072, 0.122615).circle(0.064227)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.304688, 0.125000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch1.moveTo(0.421875, -0.037500).lineTo(0.445312, 0.206250).lineTo(0.126562, 0.234375).lineTo(0.126562, 0.000000).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.314062, 0.098437).circle(0.060937)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.171875, 0.109375, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop5=wp_sketch2.moveTo(0.127549, -0.010855).lineTo(0.257812, -0.010855).lineTo(0.257812, 0.225247).lineTo(0.138405, 0.236102).lineTo(0.021711, 0.236102).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch2.moveTo(0.132977, 0.111266).circle(0.062418)
solid2=wp_sketch2.add(loop5).add(loop6).extrude(0.062500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.195312, -0.125000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop7=wp_sketch3.moveTo(0.117188, 0.000000).lineTo(0.001234, 0.009868).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop7).extrude(0.062500)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
