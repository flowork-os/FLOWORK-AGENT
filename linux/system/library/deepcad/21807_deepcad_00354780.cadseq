loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.023123, -0.055824), (0.078947, -0.078947)).lineTo(0.678947, -0.078947).threePointArc((0.730824, -0.054189), (0.750000, 0.000000)).lineTo(0.750000, 0.600000).threePointArc((0.730824, 0.654189), (0.678947, 0.678947)).lineTo(0.078947, 0.678947).threePointArc((0.023123, 0.655824), (0.000000, 0.600000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.031298, -0.036087), (0.078947, -0.039474)).lineTo(0.678947, -0.039474).threePointArc((0.702912, -0.026277), (0.710526, 0.000000)).lineTo(0.710526, 0.600000).threePointArc((0.702912, 0.626277), (0.678947, 0.639474)).lineTo(0.078947, 0.639474).threePointArc((0.051035, 0.627912), (0.039474, 0.600000)).lineTo(0.039474, 0.000000).close()
