import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.507812, -0.398438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.150658, 0.000000).lineTo(1.242188, 0.405345).lineTo(0.536102, 0.405345).lineTo(0.483799, 0.143832).lineTo(0.104605, 0.222286).lineTo(0.143832, 0.405345).lineTo(0.091530, 0.405345).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.507812, -0.398438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.150658, 0.000000).lineTo(1.242188, 0.405345).lineTo(0.536102, 0.405345).lineTo(0.483799, 0.143832).lineTo(0.104605, 0.222286).lineTo(0.143832, 0.405345).lineTo(0.091530, 0.405345).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.750000)
solid=solid.union(solid0)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
