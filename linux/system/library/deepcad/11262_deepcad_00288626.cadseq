# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288626" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.000000, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.245888, 0.000000).lineTo(0.245888, 0.151316).lineTo(0.652549, 0.151316).lineTo(0.652549, 0.000000).lineTo(0.898438, 0.000000).lineTo(0.898438, 0.302632).lineTo(0.000000, 0.302632).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.406250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.898438, 0.000000).lineTo(0.898438, 0.406661).threePointArc((0.449219, 0.855880), (0.000000, 0.406661)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.289062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, -0.289062, 0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.205263, 0.000000).circle(0.205263)
loop3=wp_sketch2.moveTo(0.205263, 0.000000).circle(0.102632)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.164062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
