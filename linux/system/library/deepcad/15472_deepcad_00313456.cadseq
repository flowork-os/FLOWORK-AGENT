# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00313456" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.296875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.150000, -0.300000).lineTo(0.750000, -0.300000).lineTo(0.528947, 0.363158).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, -0.593750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.381250, 0.000000).lineTo(0.381250, 0.593750).lineTo(0.000000, 0.593750).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.262500, 0.131250).circle(0.050000)
loop3=wp_sketch1.moveTo(0.262500, 0.443750).circle(0.050000)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.054688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.054688, -0.015625, 0.046875), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 0.949528, 0.313682)))
loop4=wp_sketch2.moveTo(0.054605, 0.000000).lineTo(0.054605, 0.648438).lineTo(0.000000, 0.648438).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.054688)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.015625, 0.046875), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 0.949528, 0.313682)))
loop5=wp_sketch3.moveTo(0.443668, 0.000000).lineTo(0.443668, 0.648438).lineTo(0.000000, 0.648438).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.054688)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
