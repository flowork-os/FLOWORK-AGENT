import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.507812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.386842, -0.505263).lineTo(0.386842, -0.639474).threePointArc((0.561178, -0.602501), (0.710526, -0.505263)).threePointArc((0.751638, -0.398684), (0.710526, -0.292105)).threePointArc((0.384315, -0.075386), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
