wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.000000, 0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.068092, -0.166447).threePointArc((0.086492, -0.186392), (0.113487, -0.189145)).lineTo(0.718750, -0.037829).lineTo(0.718750, 0.226974).lineTo(0.461513, 0.166447).lineTo(0.143750, -0.037829).lineTo(0.090789, -0.037829).lineTo(0.037829, 0.022697).threePointArc((0.009365, 0.027264), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
