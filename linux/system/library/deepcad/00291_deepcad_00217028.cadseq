import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.000000, 0.523438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.294901, -0.455757).lineTo(0.294901, -1.273438).lineTo(0.482566, -1.273438).lineTo(0.482566, -0.254688).lineTo(0.053618, 0.067023).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.388734, -1.099178).circle(0.067023)
loop2=wp_sketch0.moveTo(0.388734, -0.388734).circle(0.067023)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
