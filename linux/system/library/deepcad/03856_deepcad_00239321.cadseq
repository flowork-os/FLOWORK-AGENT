# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239321" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.000000, -0.593750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.155592, -0.155592), (0.311184, 0.000000)).lineTo(0.311184, 1.188158).threePointArc((0.155592, 1.343750), (0.000000, 1.188158)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.155592, 0.000000).circle(0.028289)
loop2=wp_sketch0.moveTo(0.155592, 1.188158).circle(0.028289)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
