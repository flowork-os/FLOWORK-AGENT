wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.062500, -0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.058717, 0.000000).threePointArc((0.278906, -0.220189), (0.499095, 0.000000)).lineTo(0.557812, 0.000000).lineTo(0.557812, 0.645888).threePointArc((0.278906, 0.924794), (0.000000, 0.645888)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.193705, 0.203215), (0.469737, 0.254441)).lineTo(0.469737, 0.352303).lineTo(0.469737, 0.645888).threePointArc((0.278660, 0.836291), (0.097862, 0.636102)).lineTo(0.097862, 0.274013).lineTo(0.097862, 0.254441).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.234375)
