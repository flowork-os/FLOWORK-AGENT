# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((-0.005558, -0.043981), (0.006661, -0.086595)).lineTo(0.166530, -0.086595).threePointArc((0.210901, -0.131787), (0.226480, -0.193174)).lineTo(0.226480, -0.459622).threePointArc((0.313076, -0.480187), (0.399671, -0.459622)).lineTo(0.399671, -0.193174).threePointArc((0.418581, -0.130888), (0.466283, -0.086595)).lineTo(0.619490, -0.086595).threePointArc((0.633886, -0.033306), (0.619490, 0.019984)).lineTo(0.486266, 0.019984).lineTo(0.139885, 0.019984).lineTo(0.006661, 0.019984).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.125000)
