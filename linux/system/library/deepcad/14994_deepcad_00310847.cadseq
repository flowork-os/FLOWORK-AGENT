# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.350658, 0.000000).threePointArc((0.251018, 0.213358), (0.209046, 0.445066)).lineTo(0.175329, 0.640625).lineTo(0.141612, 0.445066).threePointArc((0.099640, 0.213358), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
