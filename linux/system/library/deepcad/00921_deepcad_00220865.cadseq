# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220865" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.445312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.445312, 0.000000).lineTo(1.445312, 0.882401).lineTo(0.000000, 0.882401).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.182566, 0.441201).circle(0.152138)
loop2=wp_sketch0.moveTo(1.262747, 0.441201).circle(0.152138)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, -0.445312, 0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.351562, -0.351562), (0.703125, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-1.000000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, -0.445312, 0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.351562, -0.351562), (0.703125, 0.000000)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.125000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
