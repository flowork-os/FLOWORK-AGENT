wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, 0.000000, -0.453125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.074187, -0.179103), (0.253289, -0.253289)).lineTo(0.607895, -0.253289).threePointArc((0.786997, -0.179103), (0.861184, 0.000000)).lineTo(0.861184, 0.949836).threePointArc((0.786997, 1.128938), (0.607895, 1.203125)).lineTo(0.253289, 1.203125).threePointArc((0.074187, 1.128938), (0.000000, 0.949836)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.430592, 0.772533).circle(0.341941)
loop2=wp_sketch0.moveTo(0.430592, 0.037993).circle(0.215296)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.125000)
