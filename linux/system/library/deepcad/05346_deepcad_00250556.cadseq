import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.195395, 0.000000).lineTo(0.195395, 0.065132).lineTo(0.081414, 0.065132).lineTo(0.081414, 0.073273).lineTo(0.195395, 0.073273).lineTo(0.195395, 0.692023).lineTo(0.081414, 0.692023).lineTo(0.081414, 0.708306).lineTo(0.195395, 0.708306).lineTo(0.195395, 0.773437).lineTo(0.000000, 0.773437).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.117188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
