# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00280908" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.492188, 0.000000).lineTo(1.492188, 0.989556).lineTo(0.000000, 0.989556).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.314145, 0.675411).circle(0.062829)
loop2=wp_sketch0.moveTo(1.178043, 0.675411).circle(0.062829)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, -0.312500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(1.492188, 0.000000).lineTo(1.492188, 0.125658).lineTo(0.000000, 0.125658).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.687500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.367188, -0.187500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.071053, 0.000000).circle(0.069572)
solid2=wp_sketch2.add(loop4).extrude(-0.125000)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.359375, -0.367188, -0.187500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.071053, 0.000000).circle(0.069572)
solid3=wp_sketch3.add(loop5).extrude(-0.125000)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, -0.687500, -0.187500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch4.moveTo(0.124342, 0.000000).lineTo(0.124342, 0.562500).lineTo(0.000000, 0.562500).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(0.687500)
solid=solid.union(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.054688, -0.687500, -0.187500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop7=wp_sketch5.moveTo(0.564474, 0.687500).lineTo(0.000000, 0.687500).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop7).extrude(-0.312500)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
