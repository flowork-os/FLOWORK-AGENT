# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00348813" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.076891, 0.000000).lineTo(0.429688, 0.000000).lineTo(0.429688, 0.167352).lineTo(0.162829, 0.393503).lineTo(0.000000, 0.393503).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.416118, 0.031661).lineTo(0.416118, 0.158306).lineTo(0.158306, 0.375411).lineTo(0.013569, 0.375411).lineTo(0.013569, 0.031661).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.515625, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.115461, 0.000000).lineTo(0.115461, 0.304688).lineTo(0.000000, 0.304688).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.015625)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
