loop0=wp_sketch0.moveTo(0.201316, -0.272368).threePointArc((0.210095, -0.289179), (0.213158, -0.307895)).lineTo(0.213158, -0.375000).lineTo(0.225000, -0.375000).lineTo(0.225000, -0.307895).threePointArc((0.220599, -0.284914), (0.209211, -0.264474)).lineTo(0.015789, 0.000000).lineTo(0.000000, 0.000000).close()
