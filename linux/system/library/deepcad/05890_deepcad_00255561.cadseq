# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00255561" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, 0.671875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.130263, 0.000000).lineTo(0.130263, -0.075987).lineTo(0.900987, -0.075987).lineTo(0.900987, 0.000000).lineTo(1.031250, 0.000000).lineTo(1.031250, 0.075987).lineTo(0.521053, 0.075987).lineTo(0.000000, 0.075987).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.312500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.595559, 0.000000).lineTo(0.796875, 0.000000).lineTo(0.796875, 0.159375).lineTo(0.595559, 0.117434).lineTo(0.377467, 0.117434).lineTo(0.377467, 0.075493).lineTo(0.327138, 0.067105).lineTo(0.092270, 0.067105).lineTo(0.092270, 0.016776).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-1.000000)
solid_temp=solid1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.595559, 0.000000).lineTo(0.796875, 0.000000).lineTo(0.796875, 0.159375).lineTo(0.595559, 0.117434).lineTo(0.377467, 0.117434).lineTo(0.377467, 0.075493).lineTo(0.327138, 0.067105).lineTo(0.092270, 0.067105).lineTo(0.092270, 0.016776).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.992188)
solid_temp=solid_temp.union(solid1)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
