# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00273701" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.078125, 0.117188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.398684, 0.000000).circle(0.398684)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.078906, 0.030995), (0.157812, 0.000000)).threePointArc((0.297761, -0.010809), (0.390378, -0.116283)).threePointArc((0.487148, -0.009119), (0.631250, 0.000000)).threePointArc((0.645788, 0.072823), (0.706003, 0.116283)).lineTo(0.490049, 0.116283).threePointArc((0.461491, 0.075874), (0.415296, 0.058141)).lineTo(0.415296, 0.091365).lineTo(0.406990, 0.074753).lineTo(0.390378, 0.074753).lineTo(0.373766, 0.074753).lineTo(0.365461, 0.091365).lineTo(0.365461, 0.058141).threePointArc((0.319265, 0.075874), (0.290707, 0.116283)).lineTo(0.074753, 0.116283).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.109375, 0.117188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.434211, 0.000000).circle(0.434211)
loop3=wp_sketch1.moveTo(0.434211, 0.000000).circle(0.407072)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
