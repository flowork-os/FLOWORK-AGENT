# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00281988" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.390625, 0.000000).lineTo(0.390625, 0.386513).lineTo(0.000000, 0.386513).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.197368, 0.201480).circle(0.082237)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, 0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.390625, 0.000000).lineTo(0.390625, 0.361842).lineTo(0.000000, 0.361842).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.259046, 0.111020).lineTo(0.259046, 0.238487).lineTo(0.131579, 0.238487).lineTo(0.131579, 0.111020).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.101562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
