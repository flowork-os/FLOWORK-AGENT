# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00295052" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.242188, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.010362, 0.000000).threePointArc((0.065049, 0.054687), (0.010362, 0.109375)).lineTo(0.000000, 0.109375).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.242188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.010362, 0.000000).lineTo(0.010362, 0.109375).lineTo(0.000000, 0.109375).threePointArc((-0.054687, 0.054687), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.242188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, -0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.067352, -0.077714).lineTo(0.424836, -0.077714).lineTo(0.492187, 0.000000).lineTo(0.492187, 0.113980).lineTo(0.492187, 0.222780).lineTo(0.492187, 0.336760).lineTo(0.424836, 0.419655).lineTo(0.067352, 0.419655).lineTo(0.000000, 0.336760).lineTo(0.000000, 0.222780).lineTo(0.000000, 0.113980).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.242188)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, -0.242188, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.185526, 0.000000).circle(0.185526)
solid3=wp_sketch3.add(loop3).extrude(0.507812)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
