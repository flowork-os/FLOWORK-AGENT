# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, -0.546875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.005345, 0.000000).lineTo(1.005345, 0.321711).lineTo(0.643421, 0.321711).lineTo(0.643421, 0.991941).lineTo(1.005345, 0.991941).lineTo(1.005345, 1.273438).lineTo(0.000000, 1.273438).lineTo(0.000000, 0.991941).lineTo(0.335115, 0.991941).lineTo(0.335115, 0.321711).lineTo(0.000000, 0.321711).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
