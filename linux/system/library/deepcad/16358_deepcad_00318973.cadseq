# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.153783, -0.630510).lineTo(0.738158, -0.907319).lineTo(1.322533, -0.615132).lineTo(1.460938, 0.015378).lineTo(1.045724, 0.522862).lineTo(0.399836, 0.507484).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.445970, -0.399836).lineTo(0.738158, -0.538240).lineTo(1.030345, -0.384457).lineTo(1.091859, -0.076891).lineTo(0.891941, 0.184539).lineTo(0.568997, 0.184539).lineTo(0.369079, -0.076891).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
