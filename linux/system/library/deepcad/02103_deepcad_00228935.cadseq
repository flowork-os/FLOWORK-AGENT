# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00228935" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.331579).lineTo(0.000000, 0.331579).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.045668, -0.110253), (0.155921, -0.155921)).lineTo(0.623684, -0.155921).lineTo(1.078454, -0.155921).threePointArc((1.188707, -0.110253), (1.234375, 0.000000)).lineTo(1.234375, 0.090954).lineTo(0.623684, 0.090954).lineTo(0.000000, 0.090954).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.155921, 0.000000).circle(0.038980)
loop3=wp_sketch1.moveTo(1.078454, 0.000000).circle(0.038980)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.195312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, 0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.623684, 0.000000).lineTo(1.234375, 0.000000).lineTo(1.234375, 0.090954).threePointArc((1.186016, 0.194710), (1.078454, 0.233882)).lineTo(0.623684, 0.233882).lineTo(0.155921, 0.233882).threePointArc((0.048359, 0.194710), (0.000000, 0.090954)).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.155921, 0.090954).circle(0.038980)
loop6=wp_sketch2.moveTo(0.454770, 0.090954).circle(0.038980)
loop7=wp_sketch2.moveTo(0.779605, 0.090954).circle(0.038980)
loop8=wp_sketch2.moveTo(1.078454, 0.090954).circle(0.038980)
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).add(loop7).add(loop8).extrude(0.195312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
