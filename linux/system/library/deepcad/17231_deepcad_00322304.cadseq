# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322304" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.426316, 0.000000).lineTo(0.426316, 0.310855).lineTo(0.595066, 0.310855).lineTo(0.595066, 0.150987).lineTo(0.595066, 0.000000).lineTo(0.843750, 0.000000).lineTo(0.843750, 0.843750).lineTo(0.000000, 0.843750).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.195395, 0.550658).lineTo(0.257566, 0.550658).lineTo(0.257566, 0.666118).lineTo(0.257566, 0.772697).lineTo(0.195395, 0.772697).lineTo(0.133224, 0.772697).lineTo(0.133224, 0.666118).lineTo(0.133224, 0.550658).close()
loop2=wp_sketch0.moveTo(0.648355, 0.541776).lineTo(0.710526, 0.541776).lineTo(0.710526, 0.657237).lineTo(0.710526, 0.772697).lineTo(0.648355, 0.772697).lineTo(0.577303, 0.772697).lineTo(0.577303, 0.657237).lineTo(0.577303, 0.541776).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.421875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, 0.000000, 0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.843750, 0.000000).lineTo(0.426316, 0.328618).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.421875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
