# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00252692" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.234375, 0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.515625, 0.000000).lineTo(0.515625, 0.059704).lineTo(0.000000, 0.059704).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.097697, 0.000000).lineTo(0.515625, 0.000000).lineTo(0.515625, 0.260526).lineTo(0.000000, 0.260526).lineTo(0.000000, 0.119408).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.097697, 0.119408).circle(0.037993)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.234375, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.417928, 0.000000).lineTo(0.515625, 0.000000).lineTo(0.515625, 0.119408).lineTo(0.515625, 0.260526).lineTo(0.000000, 0.260526).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.417928, 0.119408).circle(0.037993)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.078125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.515625, 0.000000).lineTo(0.515625, 0.059704).lineTo(0.000000, 0.059704).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.078125)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
