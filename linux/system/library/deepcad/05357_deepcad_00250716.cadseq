# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00250716" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.885197, 0.000000).lineTo(0.885197, 0.914062).lineTo(0.490707, 0.914062).lineTo(0.490707, 0.586924).lineTo(0.000000, 0.586924).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, 0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.045395, 0.000000).lineTo(0.045395, 0.323438).lineTo(0.539062, 0.323438).lineTo(0.539062, 0.346135).lineTo(0.000000, 0.346135).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.132812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.000000, 0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.492187, 0.000000).lineTo(0.492187, 0.321217).lineTo(0.000000, 0.321217).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.259046, 0.093257).lineTo(0.259046, 0.098437).lineTo(0.222780, 0.098437).lineTo(0.222780, 0.093257).close()
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.132812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
