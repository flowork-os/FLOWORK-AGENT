# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00283385" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.601562, 0.000000).lineTo(0.601562, 0.113980).lineTo(0.601562, 0.487582).lineTo(0.601562, 0.601562).lineTo(0.000000, 0.601562).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.525576, 0.075987).lineTo(0.525576, 0.525576).lineTo(0.075987, 0.525576).lineTo(0.075987, 0.075987).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.296875, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.453125, 0.000000).lineTo(0.453125, 0.381579).lineTo(0.000000, 0.381579).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.601562, 0.000000).lineTo(0.601562, 0.113980).lineTo(0.601562, 0.487582).lineTo(0.601562, 0.601562).lineTo(0.000000, 0.601562).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.525576, 0.075987).lineTo(0.525576, 0.525576).lineTo(0.075987, 0.525576).lineTo(0.075987, 0.075987).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
