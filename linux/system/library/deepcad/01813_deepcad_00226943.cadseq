# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00226943" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, -0.578125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.055921, 0.000000).lineTo(0.055921, 1.328125).lineTo(0.000000, 1.328125).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.013980, 1.314145).circle(0.013980)
loop2=wp_sketch0.moveTo(0.013980, 1.272204).circle(0.013980)
loop3=wp_sketch0.moveTo(0.041941, 1.286184).circle(0.013980)
loop4=wp_sketch0.moveTo(0.041941, 1.314145).circle(0.013980)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
