# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, -0.679688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.022039, -0.053207), (0.075247, -0.075247)).lineTo(0.737418, -0.075247).threePointArc((0.790625, -0.053207), (0.812664, 0.000000)).lineTo(0.812664, 1.354441).threePointArc((0.790625, 1.407648), (0.737418, 1.429688)).lineTo(0.075247, 1.429688).threePointArc((0.022039, 1.407648), (0.000000, 1.354441)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.075247, 0.015049).circle(0.030099)
loop2=wp_sketch0.moveTo(0.075247, 1.354441).circle(0.030099)
loop3=wp_sketch0.moveTo(0.722368, 0.015049).circle(0.030099)
loop4=wp_sketch0.moveTo(0.722368, 1.354441).circle(0.030099)
