# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00261568" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.124013, -0.076316).lineTo(0.391118, -0.076316).lineTo(0.772697, -0.076316).lineTo(0.906250, 0.076316).lineTo(0.906250, 0.314803).lineTo(0.877632, 0.343421).lineTo(0.581908, 0.343421).threePointArc((0.444488, 0.227227), (0.267105, 0.257566)).lineTo(0.152632, 0.276645).lineTo(0.076316, 0.276645).lineTo(0.000000, 0.200329).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.152632, 0.076316).circle(0.076316)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.484375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.234375, 0.000000, -0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.037710, -0.014804), (0.055263, -0.051316)).threePointArc((0.081267, -0.137564), (0.130263, -0.213158)).lineTo(0.189474, -0.213158).lineTo(0.375000, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.484375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
