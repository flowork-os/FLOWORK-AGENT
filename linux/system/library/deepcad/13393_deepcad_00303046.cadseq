# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00303046" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.087868, -0.212132), (0.300000, -0.300000)).lineTo(1.200000, -0.300000).threePointArc((1.412132, -0.212132), (1.500000, 0.000000)).lineTo(1.500000, 0.536842).threePointArc((1.412132, 0.748974), (1.200000, 0.836842)).lineTo(0.300000, 0.836842).threePointArc((0.087868, 0.748974), (0.000000, 0.536842)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
