# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00214710" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.271382, 0.000000).lineTo(0.271382, 0.143092).lineTo(0.271382, 0.286184).lineTo(0.000000, 0.286184).threePointArc((-0.471711, 0.143092), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.049342, 0.103618).lineTo(-0.049342, 0.143092).lineTo(-0.049342, 0.182566).lineTo(-0.113487, 0.182566).threePointArc((-0.325500, 0.143092), (-0.113487, 0.103618)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.109375, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.281250, 0.000000).lineTo(0.281250, 0.142105).lineTo(0.000000, 0.142105).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.242763, 0.038487).lineTo(0.242763, 0.103618).lineTo(0.142105, 0.103618).lineTo(0.038487, 0.103618).lineTo(0.038487, 0.038487).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.085938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.070312, -0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.359375, 0.000000).lineTo(0.359375, 0.219408).lineTo(0.181579, 0.219408).lineTo(0.000000, 0.219408).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.321546, 0.037829).lineTo(0.321546, 0.181579).lineTo(0.037829, 0.181579).lineTo(0.037829, 0.037829).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.085938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
