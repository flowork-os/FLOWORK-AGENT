# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.039474, 0.000000).lineTo(0.086842, 0.386842).lineTo(0.442105, 0.363158).lineTo(0.450000, 0.363158).lineTo(0.536842, 0.000000).lineTo(0.576316, 0.000000).lineTo(0.568421, 0.007895).lineTo(0.481579, 0.402632).lineTo(0.568421, 0.742105).lineTo(0.536842, 0.750000).lineTo(0.442105, 0.402632).lineTo(0.047368, 0.434211).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
