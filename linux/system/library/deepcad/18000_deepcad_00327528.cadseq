# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00327528" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.085938, -0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.164062, 0.000000).lineTo(0.164062, 0.082895).lineTo(0.000000, 0.082895).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.153701, 0.010362).lineTo(0.153701, 0.072533).lineTo(0.010362, 0.072533).lineTo(0.010362, 0.010362).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
