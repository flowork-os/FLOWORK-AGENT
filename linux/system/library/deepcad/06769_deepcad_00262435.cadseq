wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004047, -0.009769), (0.013816, -0.013816)).lineTo(0.095559, -0.013816).threePointArc((0.105328, -0.009769), (0.109375, 0.000000)).lineTo(0.109375, 0.081743).threePointArc((0.105328, 0.091513), (0.095559, 0.095559)).lineTo(0.013816, 0.095559).threePointArc((0.004047, 0.091513), (0.000000, 0.081743)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.011373, -0.006734), (0.024178, -0.003454)).lineTo(0.085197, -0.003454).threePointArc((0.094967, 0.000593), (0.099013, 0.010362)).lineTo(0.099013, 0.071382).threePointArc((0.094967, 0.081151), (0.085197, 0.085197)).lineTo(0.024178, 0.085197).threePointArc((0.014408, 0.081151), (0.010362, 0.071382)).lineTo(0.010362, 0.010362).close()
