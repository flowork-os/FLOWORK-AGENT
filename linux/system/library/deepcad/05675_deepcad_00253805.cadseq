# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00253805" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.168092, -0.234128).lineTo(0.450247, -0.204112).lineTo(0.570312, 0.060033).lineTo(0.396217, 0.288158).lineTo(0.120066, 0.264145).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.193421, -0.269408).lineTo(0.518092, -0.234868).lineTo(0.656250, 0.069079).lineTo(0.455921, 0.331579).lineTo(0.138158, 0.303947).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.214145, -0.227961).lineTo(0.490461, -0.200329).lineTo(0.614803, 0.062171).lineTo(0.442105, 0.297039).lineTo(0.158882, 0.269408).lineTo(0.041447, 0.006908).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
