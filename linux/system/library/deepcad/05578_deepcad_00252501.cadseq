# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00252501" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.250000, 0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.500000, 0.000000).lineTo(0.500000, 0.500000).lineTo(0.000000, 0.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.078947, 0.421053).circle(0.052632)
loop2=wp_sketch0.moveTo(0.252632, 0.252632).circle(0.068421)
loop3=wp_sketch0.moveTo(0.421053, 0.078947).circle(0.052632)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.500000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.281250, 0.648438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.051316, 0.000000).circle(0.050247)
loop5=wp_sketch1.moveTo(0.051316, 0.000000).circle(0.044901)
solid1=wp_sketch1.add(loop4).add(loop5).extrude(0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.617188, 0.304688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.050247, 0.000000).circle(0.050247)
loop7=wp_sketch2.moveTo(0.050247, 0.000000).circle(0.044901)
solid2=wp_sketch2.add(loop6).add(loop7).extrude(0.250000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
