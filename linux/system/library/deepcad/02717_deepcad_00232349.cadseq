# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232349" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.117105, 0.000000).circle(0.117105)
loop1=wp_sketch0.moveTo(1.156414, -0.234211).threePointArc((1.390625, 0.000000), (1.156414, 0.234211)).lineTo(0.117105, 0.234211).threePointArc((0.351316, 0.000000), (0.117105, -0.234211)).close()
loop2=wp_sketch0.moveTo(0.541612, -0.014638).circle(0.190296)
loop3=wp_sketch0.moveTo(1.171053, -0.087829).threePointArc((1.244243, -0.014638), (1.171053, 0.058553)).lineTo(0.878289, 0.058553).threePointArc((0.802980, -0.007839), (0.863651, -0.087829)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.312500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
