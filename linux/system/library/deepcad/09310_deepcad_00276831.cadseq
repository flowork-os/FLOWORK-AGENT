import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.065796, -0.124215), (0.197368, -0.173684)).lineTo(0.702632, -0.173684).threePointArc((0.736126, -0.159810), (0.750000, -0.126316)).lineTo(0.750000, 0.126316).threePointArc((0.736126, 0.159810), (0.702632, 0.173684)).lineTo(0.197368, 0.173684).threePointArc((0.065796, 0.124215), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.173684, 0.000000).circle(0.126316)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.351562, 0.171875, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.075000, 0.000000).circle(0.073438)
loop3=wp_sketch1.moveTo(0.075000, 0.000000).circle(0.037500)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.546875, 0.171875, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.075000, 0.000000).circle(0.073438)
loop5=wp_sketch2.moveTo(0.075000, 0.000000).circle(0.037500)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.007812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
