# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00335561" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.148438, 0.054688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.075604, -0.201499), (0.285444, -0.153701)).lineTo(0.622122, 0.322039).threePointArc((0.539233, 0.670665), (0.204934, 0.541612)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.071481, -0.191447), (0.270806, -0.146382)).lineTo(0.607484, 0.329359).threePointArc((0.530853, 0.653904), (0.219572, 0.534293)).lineTo(0.014638, -0.007319).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
