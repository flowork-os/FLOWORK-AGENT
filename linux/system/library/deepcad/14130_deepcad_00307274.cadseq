import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.000000, -0.343750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.523355, 0.000000).lineTo(0.523355, 0.148520).lineTo(0.374836, 0.148520).lineTo(0.374836, 0.523355).lineTo(0.523355, 0.523355).lineTo(0.523355, 0.664803).lineTo(0.523355, 0.671875).lineTo(0.000000, 0.671875).lineTo(0.000000, 0.523355).lineTo(0.148520, 0.523355).lineTo(0.148520, 0.148520).lineTo(0.000000, 0.148520).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.162664, 0.070724).circle(0.049507)
loop2=wp_sketch0.moveTo(0.261678, 0.495066).circle(0.084868)
loop3=wp_sketch0.moveTo(0.275822, 0.275822).circle(0.056579)
loop4=wp_sketch0.moveTo(0.282895, 0.148520).circle(0.049507)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.453125)
solid=solid0

