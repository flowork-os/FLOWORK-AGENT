wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.011369, -0.027447), (0.038816, -0.038816)).lineTo(0.883059, -0.038816).threePointArc((0.906076, -0.025754), (0.912171, 0.000000)).lineTo(0.863651, 0.145559).lineTo(0.921875, 0.281414).threePointArc((0.910367, 0.308722), (0.883059, 0.320230)).lineTo(0.747204, 0.320230).lineTo(0.174671, 0.320230).lineTo(0.038816, 0.320230).threePointArc((0.011369, 0.308861), (0.000000, 0.281414)).threePointArc((0.052302, 0.140707), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.155263, 0.009704).lineTo(0.203783, 0.058224).lineTo(0.135855, 0.077632).close()
loop2=wp_sketch0.moveTo(0.698684, 0.029112).lineTo(0.698684, 0.000000).lineTo(0.718092, 0.038816).lineTo(0.795724, 0.000000).lineTo(0.727796, 0.058224).lineTo(0.756908, 0.077632).lineTo(0.708388, 0.067928).lineTo(0.698684, 0.097039).lineTo(0.688980, 0.067928).lineTo(0.659868, 0.067928).lineTo(0.688980, 0.038816).lineTo(0.659868, 0.009704).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
