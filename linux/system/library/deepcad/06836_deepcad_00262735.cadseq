# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, 0.359375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.578125, 0.000000).threePointArc((0.289062, 0.161417), (0.000000, 0.000000)).close()
