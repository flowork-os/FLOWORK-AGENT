import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, -0.687500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.382812, 0.000000).lineTo(1.382812, 0.596793).lineTo(0.989803, 0.596793).lineTo(0.989803, 0.989803).lineTo(0.393010, 0.989803).lineTo(0.393010, 0.596793).lineTo(0.000000, 0.596793).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.593750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
