import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.040881, -0.061888), (0.111184, -0.085526)).lineTo(0.701316, -0.085526).threePointArc((0.771619, -0.061888), (0.812500, 0.000000)).lineTo(0.812500, 0.213816).threePointArc((0.771619, 0.275704), (0.701316, 0.299342)).lineTo(0.111184, 0.299342).threePointArc((0.040881, 0.275704), (0.000000, 0.213816)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
