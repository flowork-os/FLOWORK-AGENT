# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322608" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.562500, 0.000000).lineTo(0.562500, 1.012500).lineTo(0.421875, 1.251563).threePointArc((0.281250, 1.333521), (0.140625, 1.251563)).lineTo(0.000000, 1.012500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.464062, 0.182813).lineTo(0.464062, 0.942188).lineTo(0.098437, 0.942188).lineTo(0.098437, 0.182813).close()
loop2=wp_sketch0.moveTo(0.182813, 0.126562).circle(0.014063)
loop3=wp_sketch0.moveTo(0.182813, 1.012500).circle(0.014063)
loop4=wp_sketch0.moveTo(0.379688, 0.126562).circle(0.014063)
loop5=wp_sketch0.moveTo(0.379688, 1.012500).circle(0.014063)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.320312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
