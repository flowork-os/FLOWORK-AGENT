# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00287307" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, -0.531250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.062500, 0.000000).lineTo(1.062500, 1.062500).lineTo(0.000000, 1.062500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.536842, 0.536842).circle(0.458553)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.726562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, 0.726562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.501316, 0.000000).circle(0.501316)
loop3=wp_sketch1.moveTo(0.501316, 0.000000).circle(0.459539)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch2.moveTo(0.501316, 0.000000).circle(0.501316)
loop5=wp_sketch2.moveTo(0.501316, 0.000000).circle(0.459539)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(-0.023438)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop6=wp_sketch3.moveTo(0.461842, 0.000000).circle(0.461842)
loop7=wp_sketch3.moveTo(0.461842, 0.000000).circle(0.384868)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(-0.023438)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
