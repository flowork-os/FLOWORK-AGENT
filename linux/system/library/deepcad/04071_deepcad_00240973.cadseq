wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.105953, -0.017724), (0.194901, -0.077961)).threePointArc((0.506743, -0.213907), (0.818586, -0.077961)).threePointArc((0.907534, -0.017724), (1.013487, 0.000000)).threePointArc((1.235920, 0.214391), (1.013487, 0.428783)).threePointArc((0.907534, 0.446507), (0.818586, 0.506743)).threePointArc((0.513240, 0.635422), (0.207895, 0.506743)).threePointArc((0.112450, 0.445090), (0.000000, 0.428783)).threePointArc((-0.222433, 0.214391), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.207895).circle(0.090954)
loop2=wp_sketch0.moveTo(0.506743, 0.207895).circle(0.298849)
