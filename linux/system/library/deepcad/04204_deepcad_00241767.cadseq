# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00241767" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, -0.320312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.298561, -0.325376), (0.597122, 0.000000)).lineTo(0.518257, 0.867516).threePointArc((0.298561, 1.069106), (0.078865, 0.867516)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.304194, -0.022533).circle(0.168997)
loop2=wp_sketch0.moveTo(0.304194, 0.844984).circle(0.135197)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.406250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
