# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306474" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, -0.703125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.162500, 0.000000).lineTo(1.162500, 1.162500).threePointArc((1.077378, 1.368003), (0.871875, 1.453125)).lineTo(0.290625, 1.453125).threePointArc((0.085122, 1.368003), (0.000000, 1.162500)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.871875, 0.871875).lineTo(0.871875, 1.162500).lineTo(0.290625, 1.162500).lineTo(0.290625, 0.871875).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.289062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, 0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.578125, 0.000000).lineTo(0.578125, 0.292105).lineTo(0.000000, 0.292105).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.234375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
