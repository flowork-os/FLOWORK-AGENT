# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00279375" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.351562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.224507, 0.000000).lineTo(0.224507, -0.808224).lineTo(1.197368, -0.808224).lineTo(1.197368, 0.000000).lineTo(1.421875, 0.000000).lineTo(1.421875, 0.104770).lineTo(1.197368, 0.104770).lineTo(0.224507, 0.104770).lineTo(0.000000, 0.104770).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.242188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.453125, -0.109375), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.047368, 0.000000).threePointArc((0.500390, 0.110526), (0.047368, 0.221053)).lineTo(0.000000, 0.221053).threePointArc((-0.110526, 0.110526), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.263158, 0.110526).circle(0.084211)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.125000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.453125, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.082895, 0.000000).circle(0.082895)
solid2=wp_sketch2.add(loop3).extrude(0.226562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
