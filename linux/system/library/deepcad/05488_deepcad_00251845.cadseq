import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.312500, 0.281250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.076622, -0.263403), (0.031250, -0.515625)).lineTo(0.632812, -0.515625).threePointArc((0.740500, -0.204626), (0.585938, 0.085938)).lineTo(0.296875, 0.039062).threePointArc((0.227470, -0.014482), (0.148438, 0.023438)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.066474, -0.256719), (0.039062, -0.500000)).lineTo(0.625000, -0.500000).threePointArc((0.726031, -0.210378), (0.585938, 0.062500)).lineTo(0.304688, 0.023438).threePointArc((0.229013, -0.032777), (0.140625, 0.000000)).lineTo(0.007812, -0.015625).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.304688, 0.265625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.007566, -0.015132).threePointArc((-0.061772, -0.253575), (0.030263, -0.484211)).lineTo(0.620395, -0.484211).threePointArc((0.719317, -0.190764), (0.575000, 0.083224)).lineTo(0.295066, 0.045395).threePointArc((0.220050, -0.014880), (0.128618, 0.015132)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.031250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
