# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306495" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.343750, 0.000000).threePointArc((0.217613, 0.059438), (0.173684, 0.191776)).threePointArc((0.090596, 0.285494), (0.000000, 0.199013)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.086842, 0.199013).circle(0.043421)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.351562, 0.000000).lineTo(0.351562, 0.199836).threePointArc((0.264597, 0.284692), (0.177632, 0.199836)).threePointArc((0.125260, 0.067523), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.262747, 0.199836).circle(0.044408)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.695312, 0.000000).lineTo(0.695312, 0.109786).lineTo(0.343997, 0.109786).lineTo(0.000000, 0.109786).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.257812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, -0.226562, 0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.259786, 0.000000).threePointArc((0.303084, 0.043298), (0.259786, 0.086595)).lineTo(0.000000, 0.086595).threePointArc((0.043298, 0.043298), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop5).extrude(-0.171875)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
