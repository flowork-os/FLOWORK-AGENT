import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.007812, -0.132812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.022737, -0.009747), (0.032484, -0.032484)).lineTo(0.032484, -0.617188).lineTo(0.136431, -0.617188).lineTo(0.136431, 0.129934).threePointArc((-0.083341, 0.224102), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.006497, 0.129934).circle(0.051974)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.140625)
solid=solid0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.007812, -0.132812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.022737, -0.009747), (0.032484, -0.032484)).lineTo(0.032484, -0.617188).lineTo(0.136431, -0.617188).lineTo(0.136431, 0.129934).threePointArc((-0.083341, 0.224102), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.006497, 0.129934).circle(0.051974)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.140625)
