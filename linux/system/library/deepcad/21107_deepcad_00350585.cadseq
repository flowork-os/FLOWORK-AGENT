loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.022023, -0.007492), (0.014803, -0.029605)).threePointArc((0.658717, -0.394378), (1.302632, -0.029605)).threePointArc((1.295411, -0.007492), (1.317434, 0.000000)).threePointArc((1.313637, 0.735389), (0.680921, 1.110197)).threePointArc((0.658717, 1.088264), (0.636513, 1.110197)).threePointArc((0.003797, 0.735389), (0.000000, 0.000000)).close()
