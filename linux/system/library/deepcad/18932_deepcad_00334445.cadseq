# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00334445" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.335526, 0.000000).threePointArc((0.371136, 0.010772), (0.391447, 0.041941)).threePointArc((0.664062, 0.271326), (0.936678, 0.041941)).threePointArc((0.956989, 0.010772), (0.992599, 0.000000)).lineTo(1.328125, 0.000000).lineTo(1.328125, 0.069901).lineTo(1.034539, 0.069901).threePointArc((1.018202, 0.072178), (1.006579, 0.083882)).threePointArc((0.884506, 0.274408), (0.671053, 0.349507)).threePointArc((0.450609, 0.276813), (0.321546, 0.083882)).threePointArc((0.309923, 0.072178), (0.293586, 0.069901)).lineTo(0.000000, 0.069901).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.218750, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, 0.070312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.055263, 0.000000).circle(0.055263)
solid1=wp_sketch1.add(loop1).extrude(-0.554688)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.500000, 0.000000, 0.070312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.055263, 0.000000).circle(0.054112)
solid2=wp_sketch2.add(loop2).extrude(-0.554688)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
