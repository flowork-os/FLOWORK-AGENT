# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00269645" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.773437, 0.000000).lineTo(0.773437, 0.586184).lineTo(0.000000, 0.586184).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.635033, 0.024424).lineTo(0.635033, 0.333799).lineTo(0.749013, 0.333799).lineTo(0.749013, 0.569901).lineTo(0.024424, 0.569901).lineTo(0.024424, 0.024424).close()
loop2=wp_sketch0.moveTo(0.749013, 0.024424).lineTo(0.749013, 0.317516).lineTo(0.651316, 0.317516).lineTo(0.651316, 0.024424).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.367188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
