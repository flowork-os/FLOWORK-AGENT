# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00336318" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.063158).threePointArc((-0.366707, 0.031579), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.185526, 0.031579).circle(0.031579)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.063158).lineTo(0.000000, 0.063158).threePointArc((0.002719, 0.031579), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.002691, 0.031250), (0.000000, 0.062500)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.062500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.351562, 0.000000).lineTo(0.351562, 0.114720).lineTo(0.000000, 0.114720).lineTo(0.000000, 0.088816).lineTo(0.000000, 0.025905).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.421875)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, -0.148438, 0.078125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.063651, 0.000000).lineTo(0.063651, 0.335938).lineTo(0.000000, 0.335938).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(-0.328125)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, -0.171875, 0.078125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch5.moveTo(0.024753, 0.000000).lineTo(0.024753, 0.335938).lineTo(0.000000, 0.335938).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop6).extrude(-0.101562)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
