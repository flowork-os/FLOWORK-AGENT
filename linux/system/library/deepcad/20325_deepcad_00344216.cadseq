# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00344216" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.718750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.079441, 0.000000).lineTo(0.079441, 0.079441).lineTo(0.079441, 0.145641).lineTo(0.079441, 1.178372).lineTo(0.079441, 1.257812).lineTo(0.000000, 1.257812).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.367188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, 0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.109375, 0.000000).lineTo(1.109375, 0.070066).lineTo(0.000000, 0.070066).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.367188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.429688, 0.000000, -0.718750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.079441, 0.000000).lineTo(0.079441, 1.257812).lineTo(0.000000, 1.257812).lineTo(0.000000, 1.178372).lineTo(0.000000, 0.145641).lineTo(0.000000, 0.079441).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.367188)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, -0.640625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(1.109375, 0.000000).lineTo(1.109375, 0.070066).lineTo(0.000000, 0.070066).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.367188)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
