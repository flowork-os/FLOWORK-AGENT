# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382474" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, 0.351562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.039227, 0.000000).circle(0.039227)
loop1=wp_sketch0.moveTo(1.150658, -0.091530).threePointArc((1.242188, 0.000000), (1.150658, 0.091530)).lineTo(0.039227, 0.091530).threePointArc((0.130757, 0.000000), (0.039227, -0.091530)).close()
loop2=wp_sketch0.moveTo(1.150658, 0.000000).circle(0.039227)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
