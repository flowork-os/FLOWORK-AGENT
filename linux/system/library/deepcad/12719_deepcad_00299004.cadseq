import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, -0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.218750, 0.000000).lineTo(1.218750, 0.615789).lineTo(0.000000, 0.615789).lineTo(0.000000, 0.000000).close()
