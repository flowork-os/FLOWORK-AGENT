import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.000000, 0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.121053, -0.151316).lineTo(0.242105, -0.105921).lineTo(0.680921, -0.075658).lineTo(1.286184, -0.105921).lineTo(1.437500, 0.030263).lineTo(1.074342, 0.151316).lineTo(0.590132, 0.151316).lineTo(0.196711, 0.090789).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.343750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
