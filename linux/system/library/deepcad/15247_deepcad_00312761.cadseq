# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00312761" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.556579, 0.000000).circle(0.556579)
loop1=wp_sketch0.moveTo(0.289885, -0.324671).lineTo(0.324671, -0.243503).lineTo(0.371053, -0.324671).lineTo(0.452220, -0.278289).lineTo(0.521793, -0.324671).lineTo(0.602961, -0.197122).lineTo(0.672533, -0.324671).lineTo(0.730510, -0.231908).lineTo(0.811678, -0.324671).lineTo(0.916036, -0.104359).lineTo(0.197122, -0.104359).close()
loop2=wp_sketch0.moveTo(0.347862, 0.162336).lineTo(0.429030, 0.336266).lineTo(0.278289, 0.336266).close()
loop3=wp_sketch0.moveTo(0.788487, 0.127549).lineTo(0.881250, 0.336266).lineTo(0.742105, 0.336266).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(-0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, 0.539062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.189474, 0.085855).threePointArc((0.241499, 0.044433), (0.281250, -0.008882)).lineTo(0.281250, 0.213158).lineTo(0.000000, 0.213158).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop4).extrude(-0.250000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
