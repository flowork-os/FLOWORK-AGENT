wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.023922, -0.478008), (0.434211, -0.231579)).lineTo(0.810526, -0.231579).threePointArc((1.220815, -0.478008), (1.244737, 0.000000)).threePointArc((1.220815, 0.478008), (0.810526, 0.231579)).lineTo(0.723684, 0.231579).threePointArc((0.629605, 0.325658), (0.535526, 0.231579)).lineTo(0.434211, 0.231579).threePointArc((0.023922, 0.478008), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.622368, 0.231579).circle(0.043421)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
