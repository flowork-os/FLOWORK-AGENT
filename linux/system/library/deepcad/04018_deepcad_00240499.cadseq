# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00240499" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, -0.265625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.028125, -0.028125).lineTo(0.440625, 0.393750).lineTo(0.862500, -0.028125).lineTo(0.890625, 0.000000).lineTo(0.440625, 0.440625).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.554688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.304688, 0.179688, 0.000000), cq.Vector(0.707107, 0.707107, -0.000000), cq.Vector(0.707107, -0.707107, 0.000000)))
loop1=wp_sketch1.moveTo(0.040872, 0.000000).lineTo(0.040872, 0.554688).lineTo(0.000000, 0.554688).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.156250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, -0.156250, 0.000000), cq.Vector(-0.707107, 0.707107, -0.000000), cq.Vector(0.707107, 0.707107, 0.000000)))
loop2=wp_sketch2.moveTo(0.040872, 0.000000).lineTo(0.040872, 0.554688).lineTo(0.000000, 0.554688).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.039062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
