import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.000000, -0.398438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.259375, 0.000000).lineTo(1.037500, 0.000000).lineTo(1.296875, 0.000000).lineTo(1.296875, 0.136513).lineTo(1.296875, 0.518750).lineTo(1.296875, 0.655263).lineTo(1.037500, 0.655263).lineTo(0.259375, 0.655263).lineTo(0.000000, 0.655263).lineTo(0.000000, 0.518750).lineTo(0.000000, 0.136513).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.037500, 0.136513).lineTo(1.037500, 0.518750).lineTo(0.259375, 0.518750).lineTo(0.259375, 0.136513).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.390625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
