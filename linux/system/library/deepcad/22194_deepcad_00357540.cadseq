# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00357540" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.875000, 0.000000).lineTo(0.875000, 0.653947).lineTo(0.000000, 0.653947).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.218750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.093750, 0.218750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.110526, 0.000000).lineTo(0.545724, 0.656250).lineTo(0.000000, 0.656250).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.218750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.164062, 0.093750, 0.218750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.217599, 0.000000).lineTo(0.217599, 0.328125).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.218750)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
