# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00271563" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.445312, 0.037500).threePointArc((0.216077, 0.096880), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.328618, -0.474671).lineTo(0.912829, -0.425987).lineTo(1.156250, 0.097368).lineTo(0.827632, 0.572039).lineTo(0.778947, 0.572039).threePointArc((0.605811, -0.087895), (0.328618, 0.535526)).lineTo(0.243421, 0.523355).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.257812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.279680, -0.619259), (0.448273, 0.038980)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.023438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
