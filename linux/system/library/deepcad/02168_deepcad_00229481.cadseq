import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, -0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.248684, -0.193421).threePointArc((0.600987, -0.314621), (0.953289, -0.193421)).lineTo(1.201974, 0.000000).threePointArc((1.313234, 0.227961), (1.201974, 0.455921)).lineTo(0.953289, 0.635526).threePointArc((0.600987, 0.756726), (0.248684, 0.635526)).lineTo(0.000000, 0.455921).threePointArc((-0.111261, 0.227961), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.096711, 0.221053).circle(0.124342)
loop2=wp_sketch0.moveTo(0.635526, 0.207237).circle(0.303947)
loop3=wp_sketch0.moveTo(1.146711, 0.221053).circle(0.124342)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.296875)
