# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236122" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.054688, 0.554688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.015801, 0.038147), (0.053947, 0.053947)).lineTo(0.586678, 0.053947).threePointArc((0.624824, 0.038147), (0.640625, 0.000000)).lineTo(0.640625, 0.121382).lineTo(0.000000, 0.121382).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.500000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.523355, 0.000000).threePointArc((0.578125, 0.054770), (0.523355, 0.109539)).lineTo(0.000000, 0.109539).threePointArc((-0.054770, 0.054770), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.121711, 0.018257).threePointArc((0.158224, 0.054770), (0.121711, 0.091283)).lineTo(0.054770, 0.091283).threePointArc((0.091283, 0.054770), (0.054770, 0.018257)).close()
loop3=wp_sketch1.moveTo(0.468586, 0.018257).threePointArc((0.505099, 0.054770), (0.468586, 0.091283)).lineTo(0.401645, 0.091283).threePointArc((0.438158, 0.054770), (0.401645, 0.018257)).close()
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(-0.078125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
