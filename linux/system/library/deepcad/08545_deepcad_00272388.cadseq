# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272388" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, 0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.179688, 0.000000).lineTo(0.179688, 0.742188).lineTo(0.000000, 0.531250).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.039062, 0.507812).circle(0.023438)
loop2=wp_sketch0.moveTo(0.039062, 0.039062).circle(0.015625)
loop3=wp_sketch0.moveTo(0.125000, 0.070312).circle(0.007812)
loop4=wp_sketch0.moveTo(0.125000, 0.531250).circle(0.007812)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(-0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
