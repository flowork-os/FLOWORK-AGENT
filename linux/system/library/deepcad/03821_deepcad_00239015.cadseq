# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239015" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.351562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.329112, 0.000000).lineTo(0.686842, 0.000000).threePointArc((0.798142, -0.046102), (0.844243, -0.157401)).lineTo(0.844243, -0.214638).lineTo(1.359375, -0.214638).lineTo(1.359375, 0.143092).lineTo(1.359375, 0.915789).lineTo(1.302138, 0.915789).lineTo(0.000000, 0.915789).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.329112, 0.200329).circle(0.114474)
loop2=wp_sketch0.moveTo(1.216283, 0.586678).threePointArc((1.302138, 0.672533), (1.216283, 0.758388)).lineTo(0.529441, 0.758388).threePointArc((0.443586, 0.672533), (0.529441, 0.586678)).close()
loop3=wp_sketch0.moveTo(1.101809, 0.143092).circle(0.214638)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.273438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
