# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267493" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.378947, 0.000000).circle(0.378947)
loop1=wp_sketch0.moveTo(0.378947, 0.000000).circle(0.300000)
loop2=wp_sketch0.moveTo(0.418421, 0.315789).lineTo(0.418421, 0.355263).lineTo(0.331579, 0.355263).lineTo(0.331579, 0.315789).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.453125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.303947, 0.000000).circle(0.303947)
solid1=wp_sketch1.add(loop3).extrude(0.148438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, 0.312500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.078125, 0.000000).lineTo(0.078125, 0.044408).lineTo(0.000000, 0.044408).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
