# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00352603" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, -0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.178865, -0.059622).lineTo(1.132812, -0.059622).lineTo(1.132812, 0.381579).lineTo(0.178865, 0.381579).lineTo(0.000000, 0.321957).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.492188, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.257895, 0.221053).lineTo(0.000000, 0.437500).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.119737, 0.119737).lineTo(0.239474, 0.221053).lineTo(0.119737, 0.317763).lineTo(0.013816, 0.405263).lineTo(0.013816, 0.221053).lineTo(0.013816, 0.032237).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.187500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, -0.031250, 0.023438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.257812, 0.000000).lineTo(0.257812, 0.070559).lineTo(0.257812, 0.141118).lineTo(0.000000, 0.141118).lineTo(0.000000, 0.070559).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.320312)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
