# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00258637" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.507812, 0.000000).lineTo(0.507812, 0.331414).lineTo(0.000000, 0.331414).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.203125, 0.156250, 0.015625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.093750, 0.000000).lineTo(0.093750, 0.018750).lineTo(0.000000, 0.018750).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.312500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.156250, 0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.449095, 0.000000).lineTo(0.449095, 0.156661).lineTo(0.543092, 0.156661).lineTo(0.543092, 0.000000).lineTo(0.992188, 0.000000).lineTo(0.992188, 0.563980).lineTo(0.000000, 0.563980).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.078125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.203125, 0.156250, 0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.097039, 0.000000).lineTo(0.097039, 0.156250).lineTo(0.000000, 0.156250).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.078125)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
