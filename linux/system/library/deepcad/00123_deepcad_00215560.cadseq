# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00215560" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, -0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.407237, 0.000000).threePointArc((1.454002, 0.260033), (1.407237, 0.520066)).lineTo(0.000000, 0.520066).threePointArc((-0.046765, 0.260033), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.260033, 0.260033).circle(0.076480)
loop2=wp_sketch0.moveTo(0.703618, 0.260033).circle(0.122368)
loop3=wp_sketch0.moveTo(1.147204, 0.260033).circle(0.076480)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.296875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
