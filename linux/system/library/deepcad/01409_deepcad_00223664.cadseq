import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.100740, -0.071957).lineTo(0.431743, -0.071957).lineTo(0.546875, 0.043174).lineTo(0.777138, -0.043174).threePointArc((0.986873, -0.035937), (0.964227, 0.172697)).lineTo(1.151316, 0.532484).threePointArc((1.356551, 0.631972), (1.252056, 0.834704)).lineTo(0.949836, 0.935444).lineTo(0.417352, 0.575658).lineTo(0.100740, 0.575658).lineTo(0.000000, 0.489309).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.460938, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.070312, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.051316, 0.000000).circle(0.051316)
solid1=wp_sketch1.add(loop1).extrude(-0.460938, both=True)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.398438, 0.000000, 0.476562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.059211, 0.000000).circle(0.057977)
solid2=wp_sketch2.add(loop2).extrude(-0.460938, both=True)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.143750, -0.087500).lineTo(0.293750, -0.006250).lineTo(0.296875, 0.162500).lineTo(0.153125, 0.250000).lineTo(0.003125, 0.168750).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.460938, both=True)
