# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00375588" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.150658, 0.000000).threePointArc((1.235650, 0.084992), (1.150658, 0.169984)).lineTo(0.000000, 0.169984).threePointArc((-0.084992, 0.084992), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.086842, 0.000000).circle(0.085033)
solid1=wp_sketch1.add(loop1).extrude(0.578125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.664062, 0.000000, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.086842, 0.000000).circle(0.086842)
solid2=wp_sketch2.add(loop2).extrude(0.289062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.086842, 0.000000).circle(0.086842)
solid3=wp_sketch3.add(loop3).extrude(0.289062)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
