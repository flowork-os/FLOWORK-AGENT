# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00274155" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.253125, -0.351562).lineTo(0.675000, -0.492188).lineTo(1.082812, -0.351562).lineTo(1.335938, 0.000000).lineTo(1.335938, 0.435938).lineTo(1.082812, 0.787500).lineTo(0.675000, 0.914062).lineTo(0.253125, 0.787500).lineTo(0.000000, 0.435938).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.267188, -0.337500).lineTo(0.675000, -0.464062).lineTo(1.068750, -0.337500).lineTo(1.321875, 0.000000).lineTo(1.321875, 0.421875).lineTo(1.068750, 0.773438).lineTo(0.675000, 0.900000).lineTo(0.267188, 0.773438).lineTo(0.014063, 0.421875).lineTo(0.014063, 0.000000).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.031250)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
