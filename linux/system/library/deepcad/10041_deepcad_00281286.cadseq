# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00281286" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.468750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.165789, -0.283224).lineTo(0.490461, -0.283224).lineTo(0.656250, 0.000000).lineTo(0.490461, 0.283224).lineTo(0.165789, 0.283224).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.207237, -0.207237).lineTo(0.449013, -0.207237).lineTo(0.566447, 0.000000).lineTo(0.449013, 0.207237).lineTo(0.207237, 0.207237).lineTo(0.089803, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.281250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
