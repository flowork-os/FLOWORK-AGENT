# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00387362" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.445312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.078947).lineTo(1.200000, 0.078947).threePointArc((1.107626, 0.250364), (1.073684, 0.442105)).threePointArc((0.750000, 0.765789), (0.426316, 0.442105)).threePointArc((0.392374, 0.250364), (0.300000, 0.078947)).lineTo(0.000000, 0.078947).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.663158, 0.078947).lineTo(0.836842, 0.078947).lineTo(1.073684, 0.078947).threePointArc((1.045838, 0.167147), (1.010526, 0.252632)).threePointArc((0.750000, 0.119484), (0.489474, 0.252632)).threePointArc((0.453094, 0.167535), (0.426316, 0.078947)).close()
loop2=wp_sketch0.moveTo(0.757895, 0.442105).circle(0.236842)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.289062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.000000, -0.359375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.171875, 0.000000).lineTo(0.171875, 0.045230).threePointArc((0.085938, 0.034095), (0.000000, 0.045230)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.289062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
