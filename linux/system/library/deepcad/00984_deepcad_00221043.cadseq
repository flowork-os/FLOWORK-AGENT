# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00221043" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.292105, 0.000000).circle(0.292105)
loop1=wp_sketch0.moveTo(0.292105, 0.000000).circle(0.158224)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.507812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, -0.289062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.924507, 0.012664).threePointArc((1.199727, 0.291283), (0.924507, 0.569901)).lineTo(0.000000, 0.569901).threePointArc((0.281475, 0.284951), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.924507, 0.291283).circle(0.164638)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.507812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.468750, -0.281250, 0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.293586, 0.000000).lineTo(0.293586, 0.328125).lineTo(0.000000, 0.328125).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(-0.773438)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, -0.289062, 0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.703125, 0.000000).lineTo(0.703125, 0.333059).lineTo(0.000000, 0.333059).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(-0.773438)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, -0.265625, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.104357, 0.210622), (0.076974, 0.444079)).threePointArc((0.042983, 0.503405), (0.000000, 0.556579)).lineTo(0.005921, 0.556579).threePointArc((0.002979, 0.559558), (0.000000, 0.562500)).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(0.367188)
solid=solid.union(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.289062, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch5.moveTo(0.000000, 0.000000).threePointArc((0.041789, -0.051696), (0.074836, -0.109375)).threePointArc((0.044668, -0.051927), (0.005757, 0.000000)).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop7).extrude(0.367188)
solid=solid.union(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
