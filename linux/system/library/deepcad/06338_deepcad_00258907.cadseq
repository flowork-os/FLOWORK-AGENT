import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.429688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.032999, -0.079666), (0.112664, -0.112664)).lineTo(0.968914, -0.112664).threePointArc((1.042947, -0.077332), (1.070312, 0.000000)).lineTo(1.070312, 0.856250).threePointArc((1.042947, 0.933582), (0.968914, 0.968914)).lineTo(0.112664, 0.968914).threePointArc((0.032999, 0.935916), (0.000000, 0.856250)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.540789, 0.428125).circle(0.506990)
loop2=wp_sketch0.moveTo(0.112664, 0.000000).circle(0.056332)
loop3=wp_sketch0.moveTo(0.112664, 0.856250).circle(0.056332)
loop4=wp_sketch0.moveTo(0.968914, 0.000000).circle(0.056332)
loop5=wp_sketch0.moveTo(0.968914, 0.856250).circle(0.056332)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
