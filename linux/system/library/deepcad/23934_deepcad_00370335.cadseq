wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, -0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.219408, 0.000000).threePointArc((0.199098, 0.041612), (0.219408, 0.083224)).lineTo(0.105921, 0.083224).lineTo(0.105921, 0.620395).lineTo(0.196711, 0.620395).threePointArc((0.249671, 0.673355), (0.302632, 0.620395)).lineTo(0.340461, 0.620395).lineTo(0.340461, 0.718750).lineTo(0.000000, 0.718750).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.164062, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
