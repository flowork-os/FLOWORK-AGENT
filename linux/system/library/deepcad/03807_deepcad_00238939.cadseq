# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00238939" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, -0.437500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.667105, 0.000000).threePointArc((0.775207, -0.044777), (0.819984, -0.152878)).lineTo(0.819984, -0.208470).lineTo(1.070148, -0.208470).lineTo(1.320312, -0.208470).lineTo(1.320312, 0.569819).lineTo(1.320312, 0.889474).lineTo(0.000000, 0.889474).lineTo(0.000000, 0.194572).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.319655, 0.194572).circle(0.111184)
loop2=wp_sketch0.moveTo(1.181332, 0.569819).threePointArc((1.264720, 0.653207), (1.181332, 0.736595)).lineTo(0.514227, 0.736595).threePointArc((0.430839, 0.653207), (0.514227, 0.569819)).close()
loop3=wp_sketch0.moveTo(1.070148, 0.138980).circle(0.208470)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.109375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
