import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.426316, 0.000000).lineTo(0.843750, 0.000000).threePointArc((0.421875, 0.421875), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.399671, 0.044408).lineTo(0.417434, 0.044408).lineTo(0.168750, 0.284211).threePointArc((0.084255, 0.175885), (0.044408, 0.044408)).close()
loop2=wp_sketch0.moveTo(0.310855, 0.177632).lineTo(0.417434, 0.071053).lineTo(0.417434, 0.381908).threePointArc((0.295543, 0.360519), (0.186513, 0.301974)).close()
loop3=wp_sketch0.moveTo(0.799342, 0.044408).threePointArc((0.759495, 0.175885), (0.675000, 0.284211)).lineTo(0.435197, 0.044408).close()
loop4=wp_sketch0.moveTo(0.603947, 0.239803).lineTo(0.657237, 0.293092).threePointArc((0.553362, 0.355363), (0.435197, 0.381908)).lineTo(0.435197, 0.071053).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
