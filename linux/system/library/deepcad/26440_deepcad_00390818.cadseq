loop4=wp_sketch2.moveTo(0.289062, 0.000000).lineTo(0.289062, 0.079112).lineTo(0.000000, 0.079112).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(-0.054688)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.273438, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.289062, 0.000000).lineTo(0.289062, 0.079112).lineTo(0.000000, 0.079112).lineTo(0.000000, 0.000000).close()
