# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch4.moveTo(0.076069, 0.000000).lineTo(0.076069, 0.195312).lineTo(0.000000, 0.195312).lineTo(0.000000, 0.000000).close()
