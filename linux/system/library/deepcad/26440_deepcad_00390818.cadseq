wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.094737, -0.126316).lineTo(1.405263, -0.126316).lineTo(1.500000, 0.000000).lineTo(1.405263, 0.126316).lineTo(0.094737, 0.126316).lineTo(0.000000, 0.000000).close()
