# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00219506" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.112418, 0.000000).threePointArc((1.304688, 0.192270), (1.112418, 0.384539)).lineTo(0.000000, 0.384539).threePointArc((-0.192270, 0.192270), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.192270).circle(0.082401)
loop2=wp_sketch0.moveTo(1.112418, 0.192270).circle(0.082401)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, -0.125000, 0.187500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.648438, 0.000000).lineTo(0.648438, 0.259375).lineTo(0.000000, 0.259375).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.281250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
