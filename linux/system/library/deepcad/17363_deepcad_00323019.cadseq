# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00323019" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, -0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.727632, 0.000000).lineTo(0.727632, 0.727632).lineTo(0.350822, 1.234375).lineTo(0.000000, 0.727632).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.272862, 0.272862).circle(0.090954)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.726562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
