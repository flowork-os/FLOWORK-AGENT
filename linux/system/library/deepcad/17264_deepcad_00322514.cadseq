# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322514" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, -0.312500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.570395, 0.000000).lineTo(0.570395, 0.570395).lineTo(0.279605, 1.062500).lineTo(0.000000, 0.570395).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.223684, 0.212500).circle(0.067105)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.570312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
