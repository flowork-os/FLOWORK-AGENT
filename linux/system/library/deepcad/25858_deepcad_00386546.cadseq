import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.144737, -0.100164).threePointArc((1.355261, 0.093010), (1.144737, 0.286184)).lineTo(0.000000, 0.200329).threePointArc((-0.100164, 0.100164), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(1.144737, -0.071546).threePointArc((1.331870, 0.100164), (1.144737, 0.271875)).lineTo(0.000000, 0.171711).threePointArc((-0.071546, 0.100164), (0.000000, 0.028618)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.093750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
