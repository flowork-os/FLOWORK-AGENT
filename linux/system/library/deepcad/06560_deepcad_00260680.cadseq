# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00260680" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.390625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.078043, 0.000000).threePointArc((0.093032, 0.004437), (0.100493, 0.018174)).threePointArc((0.100625, 0.020313), (0.100493, 0.022451)).lineTo(0.100493, 0.101562).lineTo(0.090872, 0.101562).lineTo(0.090872, 0.021382).threePointArc((0.088165, 0.013780), (0.081250, 0.009622)).lineTo(0.000000, 0.009622).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.382812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.679688, 0.398438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.019737, 0.000000).circle(0.019737)
solid1=wp_sketch1.add(loop1).extrude(0.023438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
