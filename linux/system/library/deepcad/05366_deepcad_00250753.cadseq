# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00250753" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.493750, 0.000000).threePointArc((0.564461, 0.029289), (0.593750, 0.100000)).lineTo(0.593750, 0.425000).lineTo(0.543750, 0.425000).lineTo(0.543750, 0.100000).threePointArc((0.529105, 0.064645), (0.493750, 0.050000)).lineTo(0.000000, 0.050000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.507812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, -0.257812, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.078947, 0.000000).circle(0.078947)
solid1=wp_sketch1.add(loop1).extrude(-0.210938)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.929687, 0.000000).lineTo(0.929687, 0.508882).lineTo(0.000000, 0.508882).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.215296, 0.254441).circle(0.078289)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.054688)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
