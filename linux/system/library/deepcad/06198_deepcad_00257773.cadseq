# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257773" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.093750, 0.000000).threePointArc((0.117188, 0.023438), (0.093750, 0.046875)).lineTo(0.062911, 0.046875).lineTo(0.062911, 0.039474).lineTo(0.030839, 0.039474).lineTo(0.030839, 0.046875).lineTo(0.000000, 0.046875).threePointArc((-0.023438, 0.023438), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.023438).circle(0.009868)
loop2=wp_sketch0.moveTo(0.093750, 0.023438).circle(0.009868)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.390625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
