# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00364340" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).lineTo(0.757895, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.236842, 1.010526).lineTo(0.236842, 0.252632).lineTo(0.047368, 0.236842).lineTo(0.047368, 0.094737).lineTo(0.647368, 0.094737).lineTo(0.647368, 0.236842).lineTo(0.457895, 0.252632).lineTo(0.457895, 1.215789).lineTo(0.047368, 1.152632).lineTo(0.047368, 1.010526).close()
loop2=wp_sketch0.moveTo(0.378947, 1.389474).circle(0.063158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.265625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.192434, 0.000000).lineTo(0.192434, -0.760115).lineTo(0.000000, -0.779359).lineTo(0.000000, -0.914062).lineTo(0.606168, -0.914062).lineTo(0.606168, -0.779359).lineTo(0.413734, -0.760115).lineTo(0.413734, 0.202056).lineTo(0.000000, 0.125082).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.265625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.192434, 0.000000).lineTo(0.192434, -0.760115).lineTo(0.000000, -0.779359).lineTo(0.000000, -0.914062).lineTo(0.606168, -0.914062).lineTo(0.606168, -0.779359).lineTo(0.413734, -0.760115).lineTo(0.413734, 0.202056).lineTo(0.000000, 0.125082).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.046875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
