import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.126316, 0.000000).lineTo(0.126316, -0.110526).lineTo(1.373684, -0.110526).lineTo(1.373684, 0.000000).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.094737).threePointArc((1.453754, 0.206385), (1.342105, 0.252632)).lineTo(0.157895, 0.252632).threePointArc((0.046246, 0.206385), (0.000000, 0.094737)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.687500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
