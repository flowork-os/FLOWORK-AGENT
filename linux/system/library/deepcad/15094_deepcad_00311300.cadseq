# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00311300" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.452303, 0.000000).threePointArc((0.503184, -0.021076), (0.524260, -0.071957)).lineTo(0.524260, -0.102796).threePointArc((0.910324, -0.262709), (0.750411, 0.123355)).lineTo(0.390625, 0.123355).lineTo(0.390625, 0.164474).lineTo(0.000000, 0.164474).lineTo(0.000000, 0.123355).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.750411, -0.102796).circle(0.154194)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.500000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
