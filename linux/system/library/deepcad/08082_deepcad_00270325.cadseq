# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00270325" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.175658, -0.300082).lineTo(0.519655, -0.300082).lineTo(0.695312, 0.000000).lineTo(0.519655, 0.300082).lineTo(0.175658, 0.300082).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.241530, -0.190296).lineTo(0.351316, -0.190296).lineTo(0.453783, -0.190296).lineTo(0.563569, 0.000000).lineTo(0.453783, 0.190296).lineTo(0.241530, 0.190296).lineTo(0.131743, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
