# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00242998" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.284211, 0.000000).circle(0.284211)
loop1=wp_sketch0.moveTo(0.189474, 0.000000).circle(0.017763)
loop2=wp_sketch0.moveTo(0.284211, 0.000000).circle(0.065132)
loop3=wp_sketch0.moveTo(0.284211, -0.088816).circle(0.017763)
loop4=wp_sketch0.moveTo(0.284211, 0.088816).circle(0.017763)
loop5=wp_sketch0.moveTo(0.373026, 0.000000).circle(0.017763)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.757895)
loop7=wp_sketch1.moveTo(0.189474, 0.000000).circle(0.047368)
loop8=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.284211)
loop9=wp_sketch1.moveTo(0.757895, -0.568421).circle(0.047368)
loop10=wp_sketch1.moveTo(0.757895, 0.568421).circle(0.047368)
loop11=wp_sketch1.moveTo(1.310526, 0.000000).circle(0.047368)
solid1=wp_sketch1.add(loop6).add(loop7).add(loop8).add(loop9).add(loop10).add(loop11).extrude(0.093750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
