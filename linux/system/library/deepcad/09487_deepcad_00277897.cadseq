import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, 0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.067628, -0.112697), (0.032895, -0.197368)).lineTo(0.575658, -0.197368).lineTo(0.575658, -0.296053).threePointArc((0.678454, -0.398849), (0.781250, -0.296053)).lineTo(0.781250, 0.148026).threePointArc((0.746709, 0.212352), (0.674342, 0.222039)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.032895, -0.098684).circle(0.024671)
loop2=wp_sketch0.moveTo(0.682566, -0.296053).circle(0.016447)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
