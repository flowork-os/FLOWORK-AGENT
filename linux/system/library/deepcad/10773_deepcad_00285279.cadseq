wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.095724, -0.622204).lineTo(0.247286, -0.622204).lineTo(0.247286, -0.255263).threePointArc((0.378906, -0.123643), (0.510526, -0.255263)).lineTo(0.510526, -0.622204).lineTo(0.662089, -0.622204).lineTo(0.757812, 0.000000).lineTo(0.757812, 0.733882).lineTo(0.000000, 0.733882).lineTo(0.000000, 0.000000).close()
