wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.054688, -0.039062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.003758, -0.009071), (0.012829, -0.012829)).lineTo(0.088734, -0.012829).threePointArc((0.097805, -0.009071), (0.101562, 0.000000)).lineTo(0.101562, 0.075905).threePointArc((0.097805, 0.084976), (0.088734, 0.088734)).lineTo(0.012829, 0.088734).threePointArc((0.003758, 0.084976), (0.000000, 0.075905)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.005086, -0.005864), (0.012829, -0.006414)).lineTo(0.088734, -0.006414).threePointArc((0.093269, -0.004536), (0.095148, 0.000000)).lineTo(0.095148, 0.075905).threePointArc((0.093269, 0.080440), (0.088734, 0.082319)).lineTo(0.012829, 0.082319).threePointArc((0.008293, 0.080440), (0.006414, 0.075905)).lineTo(0.006414, 0.000000).close()
