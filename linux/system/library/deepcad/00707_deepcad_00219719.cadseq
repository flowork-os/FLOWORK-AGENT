# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, 0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.200329, 0.000000).lineTo(0.350576, -0.364885).lineTo(0.436431, -0.093010).lineTo(0.679688, -0.164556).lineTo(0.522286, 0.143092).lineTo(0.679688, 0.386349).lineTo(0.436431, 0.243257).lineTo(0.221793, 0.307648).lineTo(0.200329, 0.143092).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.203125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
