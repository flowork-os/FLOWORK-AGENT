wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.225000, -0.248684).lineTo(0.378947, -0.248684).threePointArc((0.675000, 0.047368), (0.971053, -0.248684)).lineTo(1.125000, -0.248684).lineTo(1.125000, 0.651316).lineTo(0.971053, 0.651316).lineTo(0.675000, 0.201316).lineTo(0.378947, 0.651316).lineTo(0.225000, 0.651316).lineTo(0.000000, 0.402632).threePointArc((-0.076240, 0.201316), (0.000000, 0.000000)).close()
