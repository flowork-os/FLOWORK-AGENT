# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00353664" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.789062, 0.000000).lineTo(0.789062, 0.473438).lineTo(0.631250, 0.473438).threePointArc((0.394531, 0.236719), (0.157812, 0.473438)).lineTo(0.000000, 0.473438).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.312500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
