# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, -0.109375, 0.679688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.796875, 0.000000).lineTo(0.796875, 0.075493).lineTo(0.000000, 0.075493).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.402632, 0.033553).circle(0.016776)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.015625)
