# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00307237" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, 0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.348191, -0.204112).lineTo(0.552303, -0.024013).lineTo(0.984539, -0.348191).lineTo(1.140625, -0.132072).lineTo(0.708388, 0.192105).lineTo(0.912500, 0.360197).lineTo(0.564309, 0.564309).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.671875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
