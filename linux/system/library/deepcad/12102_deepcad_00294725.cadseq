# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00294725" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, 0.000000, 0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.060440, -0.023314), (0.000000, -0.046628)).lineTo(0.572862, -0.046628).threePointArc((0.634424, -0.023314), (0.572862, 0.000000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(-0.026645, -0.026645).circle(0.013322)
loop2=wp_sketch0.moveTo(0.599507, -0.019984).circle(0.013322)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
