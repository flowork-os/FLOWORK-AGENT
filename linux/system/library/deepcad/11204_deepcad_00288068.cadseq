wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.020724, 0.000000).threePointArc((0.034786, 0.014063), (0.048849, 0.000000)).lineTo(0.070312, 0.000000).lineTo(0.070312, 0.020724).threePointArc((0.056250, 0.034786), (0.070312, 0.048849)).lineTo(0.070312, 0.070312).lineTo(0.048849, 0.070312).threePointArc((0.034786, 0.056250), (0.020724, 0.070312)).lineTo(0.000000, 0.070312).lineTo(0.000000, 0.048849).threePointArc((0.014063, 0.034786), (0.000000, 0.020724)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
