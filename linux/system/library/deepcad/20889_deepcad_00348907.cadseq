# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00348907" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.267956, -0.110991), (0.378947, -0.378947)).lineTo(0.746053, -0.378947).threePointArc((0.857044, -0.110991), (1.125000, 0.000000)).threePointArc((0.857044, 0.110991), (0.746053, 0.378947)).lineTo(0.378947, 0.378947).threePointArc((0.267956, 0.110991), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, -0.484375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.203125, -0.179611), (0.406250, 0.000000)).threePointArc((0.393597, 0.054961), (0.389145, 0.111184)).lineTo(0.017105, 0.111184).threePointArc((0.012653, 0.054961), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.484375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.012653, -0.054961), (0.017105, -0.111184)).lineTo(0.389145, -0.111184).threePointArc((0.393597, -0.054961), (0.406250, 0.000000)).threePointArc((0.203125, 0.179611), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
