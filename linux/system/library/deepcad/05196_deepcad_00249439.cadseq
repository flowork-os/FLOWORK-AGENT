# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00249439" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.011080, -0.009489), (0.020970, 0.001234)).lineTo(0.020970, 0.113487).threePointArc((0.010485, 0.103002), (0.000000, 0.113487)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.011102, 0.001234).circle(0.003701)
loop2=wp_sketch0.moveTo(0.011102, 0.113487).circle(0.003701)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
