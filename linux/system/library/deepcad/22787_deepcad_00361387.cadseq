import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.921875, 0.000000).lineTo(0.921875, 0.097039).lineTo(0.553125, 0.097039).threePointArc((0.424762, 0.146190), (0.368750, 0.271711)).lineTo(0.368750, 0.465789).threePointArc((0.184375, 0.650164), (0.000000, 0.465789)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.554688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
