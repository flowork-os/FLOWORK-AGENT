# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00390312" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.047368).lineTo(0.000000, 0.047368).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.150000, 0.023684).circle(0.015789)
loop2=wp_sketch0.moveTo(0.228947, 0.023684).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.132812, 0.023438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.019737, 0.000000).circle(0.019737)
loop4=wp_sketch1.moveTo(0.019737, 0.000000).circle(0.018092)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.156250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.210938, 0.023438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.019737, 0.000000).circle(0.019326)
loop6=wp_sketch2.moveTo(0.019737, 0.000000).circle(0.018092)
solid2=wp_sketch2.add(loop5).add(loop6).extrude(0.156250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
