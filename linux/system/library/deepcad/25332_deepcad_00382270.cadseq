# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382270" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.585938, 0.000000).lineTo(0.585938, 0.585938).lineTo(0.000000, 0.585938).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.579770, 0.006168).lineTo(0.579770, 0.579770).lineTo(0.006168, 0.579770).lineTo(0.006168, 0.006168).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.351562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.757812, 0.000000).lineTo(0.757812, 0.757812).lineTo(0.000000, 0.757812).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.678043, 0.079770).lineTo(0.678043, 0.678043).lineTo(0.079770, 0.678043).lineTo(0.079770, 0.079770).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.007812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
