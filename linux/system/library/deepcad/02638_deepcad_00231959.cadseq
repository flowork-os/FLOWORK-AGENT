import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, 0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.025254, -0.179275), (0.127220, -0.276891)).lineTo(0.628618, -0.276891).threePointArc((0.694949, -0.244284), (0.710938, -0.172122)).threePointArc((0.408498, 0.132973), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.421875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
