# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00356787" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.031250, 0.000000).lineTo(0.031250, 0.021711).threePointArc((0.024505, 0.024505), (0.021711, 0.031250)).lineTo(0.000000, 0.031250).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.015789, 0.000000).threePointArc((0.042744, 0.011165), (0.031579, -0.015789)).lineTo(0.031579, -0.031579).lineTo(1.500000, -0.031579).lineTo(1.500000, 0.300000).lineTo(0.000000, 0.300000).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.031579, 0.205263).circle(0.015789)
loop3=wp_sketch1.moveTo(0.268421, 0.252632).lineTo(0.410526, 0.252632).threePointArc((0.418421, 0.260526), (0.410526, 0.268421)).lineTo(0.268421, 0.268421).lineTo(0.142105, 0.268421).threePointArc((0.134211, 0.260526), (0.142105, 0.252632)).close()
loop4=wp_sketch1.moveTo(1.357895, 0.252632).threePointArc((1.365789, 0.260526), (1.357895, 0.268421)).lineTo(1.089474, 0.268421).threePointArc((1.081579, 0.260526), (1.089474, 0.252632)).close()
loop5=wp_sketch1.moveTo(1.468421, 0.000000).circle(0.015789)
loop6=wp_sketch1.moveTo(1.468421, 0.205263).circle(0.015789)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).extrude(0.007812, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
