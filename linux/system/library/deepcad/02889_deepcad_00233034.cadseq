# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00233034" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.024671, -0.141859).threePointArc((0.253864, -0.215292), (0.444079, -0.067845)).lineTo(0.585938, -0.067845).threePointArc((0.475917, 0.047920), (0.376234, 0.172697)).threePointArc((0.121578, 0.231308), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.209704, 0.037007).circle(0.104852)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.179688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.273438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.092763, -0.487007).threePointArc((0.180134, -0.643685), (0.347862, -0.707319)).lineTo(1.101562, -0.707319).lineTo(1.101562, -0.579770).lineTo(0.776891, -0.579770).threePointArc((0.863857, -0.492804), (0.776891, -0.405839)).lineTo(1.101562, -0.405839).lineTo(1.101562, -0.278289).threePointArc((0.818815, -0.128974), (0.568174, 0.069572)).lineTo(0.417434, 0.069572).threePointArc((0.227037, -0.075134), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.347862, -0.440625).circle(0.092763)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.343750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
