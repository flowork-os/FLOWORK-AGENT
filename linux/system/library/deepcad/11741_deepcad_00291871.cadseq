# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00291871" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.120884, -0.059245), (0.252632, -0.031579)).lineTo(0.750000, 0.268421).lineTo(0.363158, 0.157895).lineTo(0.213158, 0.118421).lineTo(0.189474, 0.110526).threePointArc((0.071846, 0.126548), (0.000000, 0.221053)).threePointArc((-0.029131, 0.110526), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.000000, 0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.017763, 0.000000).threePointArc((0.043584, 0.027328), (0.073026, 0.003947)).lineTo(0.093750, 0.007895).threePointArc((0.043794, 0.040529), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
