wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.000000, 0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.065708, -0.158634), (0.224342, -0.224342)).lineTo(0.463158, -0.224342).threePointArc((0.621792, -0.158634), (0.687500, 0.000000)).lineTo(0.687500, 0.289474).threePointArc((0.623291, 0.451726), (0.463158, 0.521053)).lineTo(0.224342, 0.521053).threePointArc((0.064209, 0.451726), (0.000000, 0.289474)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.246053, 0.151974).circle(0.137500)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.226562, both=True)
solid=solid0

if __name__ == '__main__':
