# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00291129" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, -0.351562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.460938, 0.000000).lineTo(1.460938, 0.784293).lineTo(0.000000, 0.784293).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.707401, 0.399836).circle(0.153783)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.281250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.515625, 0.000000, -0.351562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.244737, 0.000000).lineTo(0.244737, 0.484375).lineTo(0.000000, 0.484375).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.453125)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, -0.351562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.266859, 0.000000).lineTo(0.266859, 0.460938).lineTo(0.000000, 0.460938).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.343750)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, 0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.269408, 0.000000).lineTo(0.269408, 0.328125).lineTo(0.000000, 0.328125).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.468750)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
