# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, -0.539062, 0.359375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch3.moveTo(0.130263, 0.000000).circle(0.130263)
solid3=wp_sketch3.add(loop7).extrude(-0.296875)
