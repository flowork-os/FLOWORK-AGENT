import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.414803, 0.000000).lineTo(1.414803, 1.460938).lineTo(0.000000, 1.460938).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.707401, 0.753536).circle(0.599753)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.554688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.600000, 0.000000).circle(0.600000)
loop3=wp_sketch1.moveTo(0.600000, 0.000000).circle(0.500000)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.117188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(1.414803, 0.000000).lineTo(1.414803, 1.460938).lineTo(0.000000, 1.460938).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.707401, 0.753536).circle(0.599753)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(-0.117188)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, -0.218750, -0.750000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop6=wp_sketch3.moveTo(0.098684, 0.000000).circle(0.096628)
solid3=wp_sketch3.add(loop6).extrude(-0.312500)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.414062, -0.218750, -0.750000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop7=wp_sketch4.moveTo(0.098684, 0.000000).circle(0.096628)
solid4=wp_sketch4.add(loop7).extrude(-0.312500)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
