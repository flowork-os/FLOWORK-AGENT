import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.671053, 0.000000).lineTo(0.671053, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.639474, 0.023684).lineTo(0.639474, 0.315789).lineTo(0.031579, 0.315789).lineTo(0.031579, 0.023684).close()
loop2=wp_sketch0.moveTo(0.639474, 0.363158).lineTo(0.639474, 0.521053).lineTo(0.031579, 0.521053).lineTo(0.031579, 0.363158).close()
loop3=wp_sketch0.moveTo(0.639474, 0.568421).lineTo(0.639474, 0.726316).lineTo(0.031579, 0.726316).lineTo(0.031579, 0.568421).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(-0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
