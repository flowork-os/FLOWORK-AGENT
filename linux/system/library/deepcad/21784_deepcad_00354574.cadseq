# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00354574" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, -0.687500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.437500, 0.000000).lineTo(1.437500, 1.437500).lineTo(0.000000, 1.437500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.301316, 0.151316).lineTo(1.301316, 1.301316).lineTo(0.151316, 1.301316).lineTo(0.151316, 0.151316).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.289062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
