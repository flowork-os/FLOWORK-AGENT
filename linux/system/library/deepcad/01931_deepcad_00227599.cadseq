import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.109375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.176562, 0.000000).lineTo(0.176562, 0.130099).lineTo(0.483224, 0.130099).lineTo(0.483224, 0.000000).lineTo(0.613322, 0.000000).lineTo(0.613322, 0.176562).lineTo(0.882812, 0.176562).lineTo(0.882812, 0.529687).lineTo(0.000000, 0.529687).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.531250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
