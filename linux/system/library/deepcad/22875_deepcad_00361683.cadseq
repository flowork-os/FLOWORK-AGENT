# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00361683" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, 0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.045066, 0.000000).lineTo(0.078865, 0.000000).lineTo(0.123931, 0.000000).lineTo(0.157730, 0.000000).lineTo(0.214063, 0.000000).lineTo(0.743586, 0.000000).threePointArc((1.076401, 0.061965), (0.743586, 0.123931)).lineTo(0.000000, 0.123931).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.901316, 0.056332).circle(0.078865)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.032566, -0.070312).lineTo(0.065872, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.117188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.037747, 0.000000).lineTo(0.037747, 0.070312).lineTo(0.000000, 0.070312).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.117188)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.047368, 0.000000).lineTo(0.047368, 0.140625).lineTo(0.000000, 0.140625).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.117188)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
