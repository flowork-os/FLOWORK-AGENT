wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, 0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.053926, -0.194446), (0.006908, -0.386842)).lineTo(0.656250, -0.386842).threePointArc((0.636781, -0.184758), (0.552632, 0.000000)).lineTo(0.000000, 0.000000).close()
