loop2=wp_sketch0.moveTo(0.034539, -0.345395).circle(0.027632)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(-0.020477, -0.259375).threePointArc((0.057095, -0.159916), (0.047780, -0.034128)).threePointArc((0.081188, -0.041423), (0.102385, -0.068257)).threePointArc((0.117225, -0.092085), (0.143339, -0.102385)).lineTo(0.600658, -0.102385).threePointArc((0.634788, -0.088736), (0.648438, -0.054605)).threePointArc((0.626484, 0.082892), (0.573355, 0.211595)).threePointArc((0.555644, 0.227366), (0.532401, 0.232072)).lineTo(0.061431, 0.232072).threePointArc((0.036904, 0.224496), (0.020477, 0.204770)).threePointArc((-0.006235, 0.104032), (0.000000, 0.000000)).close()
