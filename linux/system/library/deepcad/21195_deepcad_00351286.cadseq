import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.000000, 0.703125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.035526, 0.000000).circle(0.035526)
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.000000, -0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.012645, -0.030529), (0.043174, -0.043174)).lineTo(0.647615, -0.043174).threePointArc((0.678144, -0.030529), (0.690789, 0.000000)).lineTo(0.690789, 1.324013).threePointArc((0.678144, 1.354542), (0.647615, 1.367188)).lineTo(0.244655, 1.367188).lineTo(0.244655, 1.280839).lineTo(0.000000, 1.280839).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.000000, 0.664062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.089474).lineTo(0.044737, 0.089474).threePointArc((0.013103, 0.076371), (0.000000, 0.044737)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.092105, 0.044737).circle(0.034211)
loop4=wp_sketch2.moveTo(0.200000, 0.044737).circle(0.018421)
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).extrude(0.062500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.000000, 0.703125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.019737, 0.000000).circle(0.019326)
solid3=wp_sketch3.add(loop5).extrude(0.062500)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
