import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.734375, 0.000000, 0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.019360, -0.048560), (0.017188, -0.085938)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, -0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.020035, 0.022333), (0.048355, 0.032237)).lineTo(0.515789, 0.032237).threePointArc((0.538265, 0.024027), (0.556086, 0.008059)).threePointArc((0.771429, 0.103127), (0.548026, 0.177303)).threePointArc((0.526641, 0.159628), (0.499671, 0.153125)).lineTo(0.064474, 0.153125).threePointArc((0.031806, 0.161437), (0.008059, 0.185362)).threePointArc((-0.339052, 0.107598), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(-0.233717, -0.040296).lineTo(-0.080592, -0.040296).lineTo(0.000000, 0.096711).lineTo(-0.080592, 0.241776).lineTo(-0.233717, 0.241776).lineTo(-0.314309, 0.096711).close()
loop3=wp_sketch1.moveTo(0.459375, 0.056414).threePointArc((0.427138, 0.088651), (0.459375, 0.120888)).lineTo(0.088651, 0.120888).threePointArc((0.056414, 0.088651), (0.088651, 0.056414)).close()
loop4=wp_sketch1.moveTo(0.588322, 0.024178).lineTo(0.693092, 0.024178).lineTo(0.733388, 0.128947).lineTo(0.644737, 0.193421).lineTo(0.556086, 0.128947).close()
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.031250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
