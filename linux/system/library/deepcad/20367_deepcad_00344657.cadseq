# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00344657" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.265625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.539062, 0.000000).lineTo(0.539062, 0.539062).lineTo(0.000000, 0.539062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.431250, 0.107813).lineTo(0.431250, 0.431250).lineTo(0.107813, 0.431250).lineTo(0.107813, 0.107813).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.640625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.320312, 0.000000).lineTo(0.320312, 0.320312).lineTo(0.000000, 0.320312).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.640625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.320312, 0.000000).lineTo(0.320312, 0.320312).lineTo(0.000000, 0.320312).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.539062)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.000000, 0.640625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.106579, 0.000000).circle(0.106579)
solid3=wp_sketch3.add(loop4).extrude(-0.109375)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.000000, 0.640625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.106579, 0.000000).circle(0.106579)
solid4=wp_sketch4.add(loop5).extrude(0.109375)
solid=solid.union(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.000000, 0.640625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch5.moveTo(0.161842, 0.000000).circle(0.161842)
loop7=wp_sketch5.moveTo(0.161842, 0.000000).circle(0.107895)
solid5=wp_sketch5.add(loop6).add(loop7).extrude(0.109375)
solid=solid.union(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
