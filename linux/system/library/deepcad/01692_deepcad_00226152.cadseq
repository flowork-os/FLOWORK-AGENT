import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.515625, 0.000000).lineTo(0.515625, 0.325658).lineTo(0.000000, 0.325658).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.429688, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.164062, 0.000000).lineTo(0.164062, 0.127796).lineTo(0.000000, 0.127796).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.070312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.593750, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.156250, 0.000000).lineTo(0.156250, 0.111842).lineTo(0.000000, 0.111842).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.070312)
