import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.129490, -0.312616), (0.442105, -0.442105)).lineTo(1.042105, -0.442105).threePointArc((1.362616, -0.315886), (1.500000, 0.000000)).lineTo(1.500000, 0.600000).threePointArc((1.362616, 0.915886), (1.042105, 1.042105)).lineTo(0.442105, 1.042105).threePointArc((0.129490, 0.912616), (0.000000, 0.600000)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
