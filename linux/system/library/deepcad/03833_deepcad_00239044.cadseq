# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239044" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.032967, -0.251877), (0.217105, -0.207237)).threePointArc((0.485258, -0.133240), (0.759868, -0.177632)).threePointArc((0.906999, -0.208323), (0.888158, -0.059211)).threePointArc((0.452664, 0.099175), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.078947, -0.138158).circle(0.088816)
loop2=wp_sketch0.moveTo(0.848684, -0.138158).circle(0.049342)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.171875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
