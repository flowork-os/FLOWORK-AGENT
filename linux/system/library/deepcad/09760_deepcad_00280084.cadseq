# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00280084" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.210938, 0.000000).lineTo(1.210938, 0.637336).lineTo(0.000000, 0.637336).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.509868, 0.216694).lineTo(0.509868, 0.420641).lineTo(0.305921, 0.420641).lineTo(0.305921, 0.216694).close()
loop2=wp_sketch0.moveTo(0.905016, 0.318668).circle(0.101974)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.156250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
