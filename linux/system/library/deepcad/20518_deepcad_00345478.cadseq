# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00345478" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, -0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.243503, 0.104359).lineTo(0.367188, 0.197122).lineTo(0.185526, 0.197122).lineTo(0.185526, 0.112089).lineTo(0.088898, 0.081168).lineTo(0.050247, 0.197122).lineTo(0.007730, 0.197122).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.445312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.226562, 0.000000).lineTo(0.226562, 0.090625).lineTo(0.124013, 0.090625).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.445312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.221793, 0.000000).lineTo(0.226562, 0.197944).lineTo(0.000000, 0.197944).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.445312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
