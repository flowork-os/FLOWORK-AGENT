# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00352532" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.695312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.039474, 0.000000).circle(0.039474)
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.695312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.059211, 0.000000).circle(0.057977)
loop2=wp_sketch1.moveTo(0.059211, 0.000000).circle(0.040707)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.187500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.632812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.104688, -0.087500).lineTo(0.148438, -0.043750).lineTo(0.060938, 0.060938).threePointArc((0.043975, 0.016963), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.148438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.554688, 0.054688), cq.Vector(0.707107, 0.707107, -0.000000), cq.Vector(0.707107, -0.707107, 0.000000)))
loop4=wp_sketch3.moveTo(0.031250, 0.000000).lineTo(0.031250, 0.031250).lineTo(0.000000, 0.031250).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(-0.148438)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, 0.664062, 0.187500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.007895, -0.007730).lineTo(0.015625, 0.000329).lineTo(0.007730, 0.007895).threePointArc((0.004132, 0.003686), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop5).extrude(-0.171875)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
