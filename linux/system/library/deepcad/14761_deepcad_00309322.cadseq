import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.307895, 0.000000).lineTo(0.307895, 0.086842).lineTo(0.221053, 0.086842).lineTo(0.221053, 0.307895).lineTo(0.307895, 0.307895).lineTo(0.307895, 0.375000).lineTo(0.000000, 0.375000).lineTo(0.000000, 0.307895).lineTo(0.086842, 0.307895).lineTo(0.086842, 0.086842).lineTo(0.000000, 0.086842).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.265625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
