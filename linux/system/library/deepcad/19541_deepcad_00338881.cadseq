wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000674, -0.001628), (0.002303, -0.002303)).lineTo(0.013322, -0.002303).threePointArc((0.014951, -0.001628), (0.015625, 0.000000)).lineTo(0.015625, 0.011020).threePointArc((0.014951, 0.012648), (0.013322, 0.013322)).lineTo(0.002303, 0.013322).threePointArc((0.000674, 0.012648), (0.000000, 0.011020)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001605, -0.001243), (0.003618, -0.000987)).lineTo(0.012007, -0.000987).threePointArc((0.013635, -0.000312), (0.014309, 0.001316)).lineTo(0.014309, 0.009704).threePointArc((0.013635, 0.011332), (0.012007, 0.012007)).lineTo(0.003618, 0.012007).threePointArc((0.001990, 0.011332), (0.001316, 0.009704)).lineTo(0.001316, 0.001316).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.001316, 0.001316).threePointArc((0.001060, -0.000698), (0.002303, -0.002303)).lineTo(0.013322, -0.002303).threePointArc((0.014951, -0.001628), (0.015625, 0.000000)).lineTo(0.015625, 0.011020).threePointArc((0.014951, 0.012648), (0.013322, 0.013322)).lineTo(0.002303, 0.013322).threePointArc((0.000674, 0.012648), (0.000000, 0.011020)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.001605, -0.001243), (0.003618, -0.000987)).lineTo(0.012007, -0.000987).threePointArc((0.013635, -0.000312), (0.014309, 0.001316)).lineTo(0.014309, 0.009704).threePointArc((0.013635, 0.011332), (0.012007, 0.012007)).lineTo(0.003618, 0.012007).threePointArc((0.001990, 0.011332), (0.001316, 0.009704)).lineTo(0.001316, 0.001316).close()
