# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00244528" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.453125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.300000).lineTo(1.263158, 0.300000).lineTo(1.263158, 0.600000).lineTo(1.500000, 0.600000).lineTo(1.500000, 0.900000).lineTo(0.000000, 0.900000).lineTo(0.000000, 0.600000).lineTo(0.236842, 0.600000).lineTo(0.236842, 0.300000).lineTo(0.000000, 0.300000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.757895, 0.457895).circle(0.094737)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.187500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
