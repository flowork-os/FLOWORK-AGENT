# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00299873" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.063158).lineTo(0.536842, 0.063158).threePointArc((0.465789, 0.134211), (0.536842, 0.205263)).lineTo(0.750000, 0.205263).lineTo(0.750000, 0.268421).lineTo(0.000000, 0.268421).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.132812, 0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.265625, 0.000000).lineTo(0.265625, 0.128618).threePointArc((0.132812, 0.261431), (0.000000, 0.128618)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.134211, 0.128618).circle(0.069901)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.265625, 0.132812, -0.125000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.132812, -0.132812), (0.265625, 0.000000)).lineTo(0.265625, 0.128618).lineTo(0.000000, 0.128618).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.134211, 0.000000).circle(0.069901)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.062500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
