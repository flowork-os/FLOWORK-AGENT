wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, -0.539062, -0.429688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop9=wp_sketch4.moveTo(0.217105, 0.000000).circle(0.217105)
