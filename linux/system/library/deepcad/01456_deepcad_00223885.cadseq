# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, -0.539062, -0.429688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.214063, 0.214063), (0.428125, 0.000000)).lineTo(0.428125, 0.856250).threePointArc((0.214063, 1.070312), (0.000000, 0.856250)).lineTo(0.000000, 0.000000).close()
loop8=wp_sketch3.moveTo(0.214063, 0.856250).circle(0.112664)
