import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.234375, 0.304688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.038640, -0.020891), (0.052220, -0.062664)).lineTo(0.052220, -0.992188).lineTo(0.229770, -0.992188).lineTo(0.229770, 0.219326).threePointArc((-0.140939, 0.377669), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.010444, 0.219326).circle(0.093997)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.476562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
