# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.656250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.097697, 0.000000).lineTo(0.281250, 0.000000).lineTo(0.281250, 0.097697).lineTo(0.000000, 0.097697).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.531250)
