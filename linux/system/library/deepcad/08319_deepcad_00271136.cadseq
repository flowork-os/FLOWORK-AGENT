# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00271136" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.092763, -0.139145).lineTo(0.231908, -0.046382).lineTo(0.405839, 0.023191).lineTo(0.811678, -0.301480).lineTo(0.579770, 0.081168).lineTo(1.101562, 0.069572).lineTo(0.672533, 0.255099).lineTo(0.521793, 0.336266).lineTo(0.208717, 0.800082).lineTo(0.173931, 0.707319).lineTo(0.382648, 0.255099).lineTo(0.231908, 0.208717).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.500000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.085938, -0.500000, 0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.031579, 0.000000).circle(0.031579)
solid1=wp_sketch1.add(loop1).extrude(-0.500000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.328125, -0.500000, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.062500, 0.000000).lineTo(0.062500, 0.016447).lineTo(0.000000, 0.016447).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.500000)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
