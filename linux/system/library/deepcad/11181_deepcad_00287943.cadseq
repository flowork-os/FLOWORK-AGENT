# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00287943" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.434211, 0.000000).circle(0.434211)
loop1=wp_sketch0.moveTo(0.434211, 0.000000).circle(0.325658)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.323684, 0.000000).circle(0.316941)
loop3=wp_sketch1.moveTo(0.323684, 0.000000).circle(0.215789)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.651316, 0.000000).circle(0.637747)
loop5=wp_sketch2.moveTo(0.108553, 0.000000).circle(0.054276)
loop6=wp_sketch2.moveTo(0.651316, 0.000000).circle(0.434211)
loop7=wp_sketch2.moveTo(0.651316, -0.542763).circle(0.054276)
loop8=wp_sketch2.moveTo(0.651316, 0.542763).circle(0.054276)
loop9=wp_sketch2.moveTo(1.180510, 0.000000).circle(0.054276)
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).add(loop7).add(loop8).add(loop9).extrude(0.320312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop10=wp_sketch3.moveTo(0.323684, 0.000000).circle(0.316941)
loop11=wp_sketch3.moveTo(0.323684, 0.000000).circle(0.215789)
solid3=wp_sketch3.add(loop10).add(loop11).extrude(0.429688)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
