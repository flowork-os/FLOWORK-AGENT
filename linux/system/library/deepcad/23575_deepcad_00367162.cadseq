# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.040707, 0.000000).lineTo(0.040707, -0.488487).lineTo(0.146546, -0.488487).lineTo(0.252385, -0.488487).lineTo(0.252385, 0.000000).lineTo(0.252385, 0.773437).lineTo(0.130263, 0.773437).lineTo(0.000000, 0.773437).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.024424, 0.749013).circle(0.008141)
loop2=wp_sketch0.moveTo(0.065132, -0.464062).circle(0.008141)
loop3=wp_sketch0.moveTo(0.065132, -0.024424).circle(0.008141)
loop4=wp_sketch0.moveTo(0.227961, -0.464062).circle(0.008141)
loop5=wp_sketch0.moveTo(0.227961, 0.749013).circle(0.008141)
