# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00241492" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.726562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.437500, 0.000000).lineTo(1.437500, 0.726316).lineTo(0.000000, 0.726316).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.429688, 0.000000).lineTo(1.414638, 0.255839).lineTo(1.008306, 0.481579).lineTo(0.406332, 0.481579).lineTo(0.000000, 0.255839).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.343750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.000000, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.071957, -0.071957).lineTo(0.904605, -0.071957).lineTo(0.976563, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.984375)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.531250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.106579, 0.000000).circle(0.104359)
solid3=wp_sketch3.add(loop3).extrude(0.476562)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
