# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00223804" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.059211, 0.000000).circle(0.059211)
loop1=wp_sketch0.moveTo(0.651316, -0.148026).lineTo(1.258224, -0.148026).threePointArc((1.406250, 0.000000), (1.258224, 0.148026)).lineTo(0.651316, 0.148026).lineTo(0.059211, 0.148026).threePointArc((0.207237, 0.000000), (0.059211, -0.148026)).close()
loop2=wp_sketch0.moveTo(1.258224, 0.000000).circle(0.059211)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, -0.109375, 0.195312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.390789, 0.000000).lineTo(0.773437, 0.000000).lineTo(0.773437, 0.211678).lineTo(0.390789, 0.211678).lineTo(0.000000, 0.211678).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.390625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
