# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00332993" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, -0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.328125, 0.000000).lineTo(1.328125, 0.139803).lineTo(0.419408, 0.754934).threePointArc((0.142668, 0.768784), (0.000000, 0.531250)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.265625, 0.531250).circle(0.139803)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.265625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
