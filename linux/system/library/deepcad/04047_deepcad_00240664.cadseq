import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.027156, 0.083529), (0.001809, 0.166447)).threePointArc((-0.115737, 0.084492), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.066941, 0.083224).circle(0.027138)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, -0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.056250, 0.000000).threePointArc((0.140625, -0.084375), (0.225000, 0.000000)).lineTo(0.281250, 0.000000).threePointArc((0.140625, 0.140625), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.054688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, -0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.140625, -0.140625), (0.281250, 0.000000)).lineTo(0.225000, 0.000000).threePointArc((0.140625, -0.084375), (0.056250, 0.000000)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.054688)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.119719, 0.081593), (0.003618, 0.168257)).threePointArc((0.030175, 0.083518), (0.000000, 0.000000)).close()
loop5=wp_sketch3.moveTo(0.068750, 0.086842).circle(0.027138)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.054688)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
