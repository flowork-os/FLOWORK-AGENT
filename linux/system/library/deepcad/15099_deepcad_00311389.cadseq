import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.156308, -0.377360), (0.221053, -0.221053)).threePointArc((0.248800, -0.154064), (0.315789, -0.126316)).lineTo(0.544737, -0.126316).lineTo(0.750000, -0.126316).lineTo(0.750000, 0.039474).lineTo(0.292105, 0.039474).lineTo(0.292105, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, -0.221053).circle(0.150000)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
