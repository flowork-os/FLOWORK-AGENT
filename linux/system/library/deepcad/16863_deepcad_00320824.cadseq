loop3=wp_sketch2.moveTo(0.067352, 0.000000).lineTo(0.067352, 0.101562).lineTo(0.000000, 0.101562).threePointArc((0.008811, 0.050781), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.257812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.054688, 0.000000, -0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.535526, 0.097368).threePointArc((0.307706, 0.289062), (0.535526, 0.480757)).lineTo(0.000000, 0.578125).threePointArc((0.243225, 0.289062), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop4).extrude(0.257812)
