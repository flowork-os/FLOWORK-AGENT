loop1=wp_sketch0.moveTo(0.154194, -0.049342).threePointArc((0.292969, -0.147078), (0.431743, -0.049342)).lineTo(0.493421, -0.049342).lineTo(0.493421, 0.049342).lineTo(0.431743, 0.049342).threePointArc((0.292969, 0.147078), (0.154194, 0.049342)).lineTo(0.092516, 0.049342).lineTo(0.092516, -0.049342).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.257812)
