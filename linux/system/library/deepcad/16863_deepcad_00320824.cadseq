# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.359375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.197368, 0.000000).circle(0.193257)
loop6=wp_sketch4.moveTo(0.197368, 0.000000).circle(0.148026)
