# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00270903" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, 0.664062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.265625, 0.000000).lineTo(1.265625, -0.406250).lineTo(1.484375, -0.406250).lineTo(1.484375, 0.078125).lineTo(0.000000, 0.078125).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.437500, -0.359375).lineTo(1.437500, -0.281250).lineTo(1.328125, -0.281250).lineTo(1.328125, -0.359375).close()
loop2=wp_sketch0.moveTo(1.437500, -0.218750).lineTo(1.437500, -0.140625).lineTo(1.328125, -0.140625).lineTo(1.328125, -0.218750).close()
loop3=wp_sketch0.moveTo(1.437500, -0.078125).lineTo(1.437500, 0.000000).lineTo(1.328125, 0.000000).lineTo(1.328125, -0.078125).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
