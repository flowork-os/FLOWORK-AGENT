solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.132812, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.049753, 0.000000).threePointArc((0.036297, 0.006361), (0.027138, 0.018092)).lineTo(0.407072, 0.018092).threePointArc((0.418645, 0.017155), (0.429688, 0.013569)).threePointArc((0.412157, 0.070107), (0.429688, 0.126645)).threePointArc((0.418158, 0.122677), (0.407072, 0.117599)).lineTo(0.027138, 0.117599).threePointArc((0.016710, 0.125848), (0.004523, 0.131168)).threePointArc((0.017412, 0.065061), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.361842, 0.045230).threePointArc((0.386719, 0.070107), (0.361842, 0.094984)).lineTo(0.063322, 0.094984).threePointArc((0.038446, 0.070107), (0.063322, 0.045230)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.101562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.546875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.102632, 0.000000).circle(0.102632)
