# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00326959" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.442105, 0.000000).lineTo(0.442105, 0.750000).lineTo(0.418421, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.418421, 0.023684).lineTo(0.418421, 0.726316).lineTo(0.023684, 0.726316).lineTo(0.023684, 0.023684).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.023438, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.043421, -0.079605).lineTo(0.332895, -0.578947).lineTo(0.390789, -0.687500).lineTo(0.405263, -0.687500).lineTo(0.405263, -0.665789).lineTo(0.325658, -0.528289).lineTo(0.014474, 0.021711).lineTo(0.000000, 0.021711).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.023438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
