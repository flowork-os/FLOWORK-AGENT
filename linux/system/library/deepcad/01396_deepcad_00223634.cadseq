wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.507812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.164062, 0.000000).lineTo(0.164062, 0.108799).lineTo(0.000000, 0.108799).lineTo(0.000000, 0.000000).close()
