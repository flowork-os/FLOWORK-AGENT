# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00299119" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.138158, -0.138158), (0.276316, 0.000000)).lineTo(0.276316, 0.607895).threePointArc((0.138158, 0.746053), (0.000000, 0.607895)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.142105, 0.607895).circle(0.071053)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
