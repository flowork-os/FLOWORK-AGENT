# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00342687" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, 0.000000, 0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.492928, 0.000000).lineTo(0.492928, 0.578125).lineTo(0.000000, 0.578125).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.225164, 0.091283).circle(0.012171)
loop2=wp_sketch0.moveTo(0.225164, 0.219079).circle(0.012171)
loop3=wp_sketch0.moveTo(0.352961, 0.091283).circle(0.012171)
loop4=wp_sketch0.moveTo(0.352961, 0.219079).circle(0.012171)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
