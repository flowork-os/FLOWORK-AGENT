# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00349912" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.247368).lineTo(0.000000, 0.247368).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.656250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, -0.656250, 0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.007812, 0.000000).lineTo(0.007812, 0.002632).threePointArc((0.003906, 0.003162), (0.000000, 0.002632)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.093750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, -0.656250, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.003906, 0.000531), (0.007812, 0.000000)).lineTo(0.007812, 0.003618).lineTo(0.000000, 0.003618).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.093750)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, -0.656250, 0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.011513, 0.000000).lineTo(0.011513, 0.003701).threePointArc((0.005757, -0.038684), (0.000000, 0.003701)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.093750)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
