import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.217105, 0.000000).circle(0.217105)
loop1=wp_sketch0.moveTo(0.217105, 0.000000).circle(0.108553)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.296875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.217105, 0.000000).lineTo(0.217105, 0.162829).lineTo(0.642270, 0.162829).lineTo(0.642270, 0.000000).lineTo(0.859375, 0.000000).lineTo(0.859375, 0.325658).lineTo(0.434211, 0.325658).lineTo(0.000000, 0.325658).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.429688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.434211, 0.000000).circle(0.434211)
loop4=wp_sketch2.moveTo(0.434211, 0.000000).circle(0.217105)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.125000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, 0.000000, -0.429688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.429688, 0.000000).threePointArc((0.125853, 0.125853), (0.000000, 0.429688)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.125000)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.429688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.429688, 0.000000).lineTo(0.429688, 0.429688).threePointArc((0.303835, 0.125853), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop6).extrude(0.125000)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
