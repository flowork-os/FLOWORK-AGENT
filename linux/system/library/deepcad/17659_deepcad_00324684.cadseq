# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00324684" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, -0.695312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.323602, 0.000000).lineTo(1.323602, 1.445312).lineTo(0.000000, 1.445312).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.064967, 0.486842).lineTo(1.064967, 1.019326).lineTo(0.228207, 1.019326).lineTo(0.228207, 0.486842).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
