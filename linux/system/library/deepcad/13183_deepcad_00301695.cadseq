# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00301695" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.039062, 0.000000).lineTo(0.039062, 0.039062).lineTo(0.000000, 0.039062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001489, 0.000106), (0.002467, 0.001234)).lineTo(0.036595, 0.001234).threePointArc((0.037468, 0.001595), (0.037829, 0.002467)).lineTo(0.037829, 0.036595).threePointArc((0.037468, 0.037468), (0.036595, 0.037829)).lineTo(0.002467, 0.037829).threePointArc((0.001595, 0.037468), (0.001234, 0.036595)).lineTo(0.001234, 0.002467).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
