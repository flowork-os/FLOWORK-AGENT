# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00324154" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, -0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.018997, 0.000000).lineTo(0.037993, 0.000000).lineTo(0.056990, 0.000000).lineTo(0.069655, 0.000000).lineTo(0.069655, 0.601562).lineTo(0.000000, 0.601562).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, -0.734375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.004441, -0.015625).lineTo(0.009046, 0.000000).lineTo(0.004441, 0.015625).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, -0.718750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.008882, -0.031086).lineTo(0.013322, -0.017763).lineTo(0.017763, 0.000000).lineTo(0.022204, -0.017763).lineTo(0.026645, -0.031086).lineTo(0.035526, 0.000000).lineTo(0.035526, 0.421875).lineTo(0.017763, 0.421875).lineTo(0.000000, 0.421875).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.109375)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
