# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00309338" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.061184, 0.000000).lineTo(0.061184, 0.726562).lineTo(0.000000, 0.726562).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.177632, 0.000000).lineTo(0.177632, 0.586184).lineTo(0.177632, 0.603947).lineTo(0.186513, 0.630592).lineTo(0.195395, 0.675000).lineTo(0.195395, 0.754934).lineTo(0.000000, 0.843750).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.124342, 0.017763).lineTo(0.124342, 0.754934).lineTo(0.071053, 0.754934).lineTo(0.071053, 0.017763).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.023438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
