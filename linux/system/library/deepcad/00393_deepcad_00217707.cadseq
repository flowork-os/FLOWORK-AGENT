# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00217707" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.562500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.125000, 0.000000).lineTo(1.125000, 1.125000).lineTo(0.000000, 1.125000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.355263, 0.355263).circle(0.047368)
loop2=wp_sketch0.moveTo(0.355263, 0.769737).circle(0.047368)
loop3=wp_sketch0.moveTo(0.568421, 0.568421).circle(0.189474)
loop4=wp_sketch0.moveTo(0.769737, 0.355263).circle(0.047368)
loop5=wp_sketch0.moveTo(0.769737, 0.769737).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
