import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, 0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.199836, -0.621711).lineTo(0.854852, -0.621711).lineTo(1.054688, 0.000000).lineTo(0.532895, 0.388569).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.399671, -0.377467).lineTo(0.655016, -0.377467).lineTo(0.777138, -0.166530).lineTo(0.655016, 0.055510).lineTo(0.399671, 0.055510).lineTo(0.277549, -0.166530).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
