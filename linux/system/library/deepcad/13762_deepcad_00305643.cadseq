# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00305643" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.000000, -0.515625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.445312, 0.000000).lineTo(1.445312, 1.034539).lineTo(0.000000, 1.034539).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.182566, 0.517270).circle(0.060855)
loop2=wp_sketch0.moveTo(1.110609, 0.121711).lineTo(1.110609, 0.912829).lineTo(0.334704, 0.912829).lineTo(0.334704, 0.121711).close()
loop3=wp_sketch0.moveTo(1.262747, 0.517270).circle(0.060855)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, -0.171875, -0.390625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.789062, 0.000000).lineTo(0.789062, 0.789062).lineTo(0.000000, 0.789062).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(0.755839, 0.033224).lineTo(0.755839, 0.755839).lineTo(0.033224, 0.755839).lineTo(0.033224, 0.033224).close()
solid1=wp_sketch1.add(loop4).add(loop5).extrude(0.578125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, -0.171875, -0.515625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch2.moveTo(1.445312, 0.000000).lineTo(1.445312, 1.034539).lineTo(0.000000, 1.034539).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch2.moveTo(0.182566, 0.517270).circle(0.121711)
loop8=wp_sketch2.moveTo(1.110609, 0.121711).lineTo(1.110609, 0.912829).lineTo(0.334704, 0.912829).lineTo(0.334704, 0.121711).close()
loop9=wp_sketch2.moveTo(1.262747, 0.517270).circle(0.121711)
solid2=wp_sketch2.add(loop6).add(loop7).add(loop8).add(loop9).extrude(0.578125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
