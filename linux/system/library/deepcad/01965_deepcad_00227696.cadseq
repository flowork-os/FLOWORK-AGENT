import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.148438, 0.000000).lineTo(1.148438, 0.580263).lineTo(0.930839, 0.785773).lineTo(0.689062, 0.785773).lineTo(0.531908, 0.749507).lineTo(0.411020, 0.749507).lineTo(0.398931, 0.749507).lineTo(0.302220, 0.749507).lineTo(0.229687, 0.749507).lineTo(0.217599, 0.604441).lineTo(0.000000, 0.265954).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
