import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.378947, 0.000000).circle(0.378947)
loop1=wp_sketch0.moveTo(0.378947, 0.000000).circle(0.205263)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.578125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.757895)
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.053264, 0.123920), (0.173684, 0.063158)).threePointArc((0.339405, 0.402700), (0.678947, 0.568421)).threePointArc((0.750000, 0.643973), (0.821053, 0.568421)).threePointArc((1.160595, 0.402700), (1.326316, 0.063158)).threePointArc((1.393473, 0.000000), (1.326316, -0.063158)).threePointArc((1.160595, -0.402700), (0.821053, -0.568421)).threePointArc((0.750000, -0.643973), (0.678947, -0.568421)).threePointArc((0.339405, -0.402700), (0.173684, -0.063158)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.203125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.132977, -0.048355).threePointArc((0.241336, -0.342505), (0.507730, -0.507730)).threePointArc((0.574219, -0.445201), (0.640707, -0.507730)).threePointArc((0.981908, -0.341200), (1.148438, 0.000000)).threePointArc((1.085908, 0.066488), (1.148438, 0.132977)).threePointArc((0.981908, 0.474177), (0.640707, 0.640707)).threePointArc((0.574219, 0.578178), (0.507730, 0.640707)).threePointArc((0.166530, 0.474177), (0.000000, 0.132977)).threePointArc((0.062529, 0.066488), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.580263, 0.072533).circle(0.374753)
