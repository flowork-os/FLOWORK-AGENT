# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00218157" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.568421).lineTo(0.000000, 0.568421).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.310526, 0.189474).threePointArc((1.405263, 0.284211), (1.310526, 0.378947)).lineTo(0.189474, 0.378947).threePointArc((0.094737, 0.284211), (0.189474, 0.189474)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.281250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
