# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285065" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.161842, 0.000000).circle(0.161842)
loop1=wp_sketch0.moveTo(0.161842, 0.000000).circle(0.121382)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, -0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.796875, 0.083882).threePointArc((0.708953, 0.163569), (0.796875, 0.243257)).lineTo(0.000000, 0.318750).threePointArc((0.144449, 0.159375), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.545230, 0.117434).threePointArc((0.587171, 0.159375), (0.545230, 0.201316)).lineTo(0.226480, 0.201316).threePointArc((0.184539, 0.159375), (0.226480, 0.117434)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.164062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.585938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.082895, 0.000000).circle(0.081168)
loop5=wp_sketch2.moveTo(0.082895, 0.000000).circle(0.041447)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.203125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
