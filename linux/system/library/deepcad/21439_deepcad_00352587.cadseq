import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.150987, -0.138405).lineTo(1.056908, -0.138405).lineTo(1.195312, 0.000000).lineTo(1.195312, 0.742352).lineTo(1.107237, 0.742352).lineTo(1.107237, 0.012582).lineTo(1.031743, -0.075493).lineTo(0.201316, -0.075493).lineTo(0.113240, 0.012582).lineTo(0.113240, 0.742352).lineTo(0.000000, 0.742352).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.281250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
