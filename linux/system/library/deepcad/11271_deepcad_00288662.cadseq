# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288662" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.640625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.106579, 0.000000).circle(0.106579)
loop1=wp_sketch0.moveTo(0.106579, 0.000000).circle(0.079934)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.398438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.578125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.011527, -0.042262), (0.008141, -0.085938)).threePointArc((0.037054, -0.050989), (0.080510, -0.037993)).threePointArc((0.035989, -0.028036), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.398438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, 0.539062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.042060, -0.012835), (0.069901, -0.046875)).threePointArc((0.066736, -0.004221), (0.078125, 0.037007)).threePointArc((0.043218, 0.009732), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.398438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.382812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.027138, 0.156401), (0.054276, 0.000000)).lineTo(0.054276, 0.029605).threePointArc((0.027138, 0.130064), (0.000000, 0.029605)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.398438)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
