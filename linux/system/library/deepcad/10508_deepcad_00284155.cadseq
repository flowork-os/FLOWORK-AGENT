loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.014886, -0.035937), (0.050822, -0.050822)).lineTo(0.753865, -0.050822).threePointArc((0.790354, -0.036489), (0.804688, 0.000000)).lineTo(0.804688, 0.304934).threePointArc((0.788048, 0.336636), (0.753865, 0.347286)).lineTo(0.050822, 0.347286).threePointArc((0.014886, 0.332401), (0.000000, 0.296464)).lineTo(0.000000, 0.000000).close()
