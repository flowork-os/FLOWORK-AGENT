import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.121760, -0.185837), (0.149671, -0.406250)).lineTo(0.261924, -0.406250).threePointArc((0.310279, -0.123067), (0.507812, 0.085526)).lineTo(0.416941, 0.240543).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.492188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.179688, 0.000000).lineTo(0.179688, 0.001891).lineTo(0.000000, 0.001891).threePointArc((-0.000006, 0.000946), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.101562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.492188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.179688, 0.000000).lineTo(0.179688, 0.001891).lineTo(0.000000, 0.001891).threePointArc((-0.000006, 0.000946), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.101562)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, -0.351562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.397697, -0.229441).lineTo(0.484375, -0.076480).threePointArc((0.321570, 0.076068), (0.244737, 0.285526)).lineTo(0.132566, 0.285526).threePointArc((0.090153, 0.131680), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(0.101562)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
