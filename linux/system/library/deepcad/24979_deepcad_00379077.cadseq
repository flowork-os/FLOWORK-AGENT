wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.004097, -0.021683), (0.015707, -0.031414)).lineTo(0.738240, -0.031414).lineTo(1.476480, -0.031414).threePointArc((1.488431, -0.015707), (1.476480, 0.000000)).lineTo(0.769655, 0.439803).threePointArc((0.746094, 0.446323), (0.722533, 0.439803)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
