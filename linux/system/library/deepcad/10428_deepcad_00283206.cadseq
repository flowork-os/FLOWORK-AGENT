# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00283206" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.031250, -0.750000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.063158, 0.000000).lineTo(0.063158, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 1.436842).lineTo(0.031579, 1.436842).lineTo(0.031579, 1.421053).lineTo(0.000000, 1.421053).lineTo(0.000000, 0.078947).lineTo(0.031579, 0.078947).lineTo(0.031579, 0.063158).lineTo(0.000000, 0.063158).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
