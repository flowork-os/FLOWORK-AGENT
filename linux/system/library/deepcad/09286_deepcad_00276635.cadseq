wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.063158, 0.000000).lineTo(0.063158, 0.047368).threePointArc((0.081656, 0.092028), (0.126316, 0.110526)).lineTo(0.686842, 0.110526).lineTo(0.686842, 0.197368).lineTo(0.750000, 0.284211).lineTo(0.102632, 0.284211).lineTo(0.102632, 0.260526).threePointArc((0.084133, 0.215867), (0.039474, 0.197368)).lineTo(0.000000, 0.197368).lineTo(0.000000, 0.000000).close()
