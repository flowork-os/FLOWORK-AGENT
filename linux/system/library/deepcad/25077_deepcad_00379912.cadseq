# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00379912" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.835938, -0.414062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.664062, 0.000000).lineTo(1.664062, 0.420395).lineTo(1.576480, 0.420395).lineTo(0.875822, 0.297780).lineTo(0.788240, 0.297780).lineTo(0.087582, 0.420395).lineTo(0.000000, 0.420395).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.914062, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.000000, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.539062, 0.000000).lineTo(0.539062, 0.289391).lineTo(0.164556, 0.289391).lineTo(0.000000, 0.317763).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.914062, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.539062, 0.000000).lineTo(0.539062, 0.317763).lineTo(0.374507, 0.289391).lineTo(0.000000, 0.289391).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.914062, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
