# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00353910" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.315789, -0.173684).lineTo(0.315789, 0.094737).lineTo(0.236842, 0.094737).lineTo(0.236842, -0.173684).close()
loop2=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.189474)
loop3=wp_sketch0.moveTo(0.931579, -0.584211).lineTo(0.931579, -0.457895).lineTo(0.663158, -0.457895).lineTo(0.663158, -0.584211).close()
loop4=wp_sketch0.moveTo(0.900000, 0.347368).lineTo(0.900000, 0.568421).lineTo(0.678947, 0.568421).lineTo(0.678947, 0.347368).close()
loop5=wp_sketch0.moveTo(1.278947, -0.173684).lineTo(1.278947, 0.094737).lineTo(1.200000, 0.094737).lineTo(1.200000, -0.173684).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.187500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
