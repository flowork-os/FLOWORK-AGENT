# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00265060" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.218750, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.531250, 0.000000).lineTo(0.531250, 0.195724).lineTo(0.531250, 0.391447).lineTo(0.000000, 0.391447).threePointArc((0.074123, 0.195724), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.210938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.296053, 0.000000).circle(0.296053)
loop2=wp_sketch1.moveTo(0.296053, 0.000000).circle(0.197368)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.242188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.179688, -0.078125, 0.242188), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.101562, 0.000000).threePointArc((0.111179, 0.074219), (0.101562, 0.148438)).lineTo(0.000000, 0.148438).threePointArc((0.014763, 0.074219), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.132812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.078125, 0.242188), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.101562, 0.000000).threePointArc((0.086799, 0.074219), (0.101562, 0.148438)).lineTo(0.000000, 0.148438).threePointArc((-0.009617, 0.074219), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop4).extrude(0.132812)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
