import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.247533, 0.000000).threePointArc((0.270592, 0.015818), (0.264803, 0.043174)).lineTo(0.135280, 0.175576).lineTo(0.046053, 0.086349).lineTo(0.054688, 0.077714).threePointArc((0.059515, 0.051796), (0.037418, 0.037418)).lineTo(0.000000, 0.037418).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.093750, -0.093750, 0.132812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(0.707107, 0.000000, 0.707107)))
loop1=wp_sketch1.moveTo(0.039474, 0.000000).circle(0.039474)
solid1=wp_sketch1.add(loop1).extrude(-0.312500)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.093750, 0.007812, 0.132812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(0.707107, 0.000000, 0.707107)))
loop2=wp_sketch2.moveTo(0.039474, 0.000000).circle(0.039474)
solid2=wp_sketch2.add(loop2).extrude(-0.312500)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.006937, -0.016747), (0.023684, -0.023684)).lineTo(0.750000, -0.023684).lineTo(0.750000, 0.221053).lineTo(0.023684, 0.221053).threePointArc((0.006937, 0.214116), (0.000000, 0.197368)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.048326, -0.006143), (0.086842, 0.023684)).lineTo(0.663158, 0.023684).threePointArc((0.679905, 0.030621), (0.686842, 0.047368)).lineTo(0.686842, 0.150000).threePointArc((0.679905, 0.166747), (0.663158, 0.173684)).lineTo(0.086842, 0.173684).threePointArc((0.070095, 0.166747), (0.063158, 0.150000)).lineTo(0.063158, 0.047368).close()
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.039062)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
