# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.703125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013874, -0.033495), (0.047368, -0.047368)).lineTo(1.452632, -0.047368).threePointArc((1.486126, -0.033495), (1.500000, 0.000000)).lineTo(1.500000, 1.405263).threePointArc((1.486126, 1.438758), (1.452632, 1.452632)).lineTo(0.047368, 1.452632).threePointArc((0.013874, 1.438758), (0.000000, 1.405263)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.126316, 0.078947).circle(0.031579)
loop2=wp_sketch0.moveTo(0.126316, 1.326316).circle(0.031579)
loop3=wp_sketch0.moveTo(1.373684, 0.078947).circle(0.031579)
loop4=wp_sketch0.moveTo(1.373684, 1.326316).circle(0.031579)
