# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00242463" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.173684, 0.000000).circle(0.173684)
loop1=wp_sketch0.moveTo(0.097697, -0.075987).circle(0.014474)
loop2=wp_sketch0.moveTo(0.097697, 0.075987).circle(0.014474)
loop3=wp_sketch0.moveTo(0.173684, 0.000000).circle(0.068750)
loop4=wp_sketch0.moveTo(0.246053, -0.075987).circle(0.014474)
loop5=wp_sketch0.moveTo(0.246053, 0.075987).circle(0.014474)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.156250, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.531250, 0.018750).threePointArc((0.593750, 0.081250), (0.531250, 0.143750)).lineTo(0.000000, 0.156250).threePointArc((0.019061, 0.078125), (0.000000, 0.000000)).close()
loop7=wp_sketch1.moveTo(0.531250, 0.056250).threePointArc((0.553125, 0.078125), (0.531250, 0.100000)).lineTo(0.493750, 0.100000).threePointArc((0.471875, 0.078125), (0.493750, 0.056250)).close()
solid1=wp_sketch1.add(loop6).add(loop7).extrude(0.070312)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
