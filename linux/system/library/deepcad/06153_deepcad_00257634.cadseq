# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257634" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.250000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.252632, 0.000000).circle(0.247368)
loop1=wp_sketch0.moveTo(0.252632, 0.000000).circle(0.126316)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.585938, -0.250000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(1.093750, 0.000000).threePointArc((0.846217, 0.247533), (1.093750, 0.495066)).lineTo(0.000000, 0.495066).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.656250, 0.080592).threePointArc((0.696546, 0.120888), (0.656250, 0.161184)).lineTo(0.161184, 0.161184).threePointArc((0.120888, 0.120888), (0.161184, 0.080592)).close()
loop4=wp_sketch1.moveTo(0.656250, 0.333882).threePointArc((0.696546, 0.374178), (0.656250, 0.414474)).lineTo(0.161184, 0.414474).threePointArc((0.120888, 0.374178), (0.161184, 0.333882)).close()
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).extrude(0.078125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
