# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236865" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, -0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.531250, 0.000000).threePointArc((0.621850, 0.208715), (0.419408, 0.104852)).lineTo(0.000000, 0.104852).threePointArc((-0.240353, 0.052426), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.111842, 0.048931).circle(0.069901)
loop2=wp_sketch0.moveTo(0.538240, 0.125822).circle(0.069901)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.257812, -0.750000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.071053, 0.000000).circle(0.069572)
solid1=wp_sketch1.add(loop3).extrude(-0.375000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.195312, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.011513, 0.000000).threePointArc((0.216754, 0.117121), (0.132401, -0.103618)).lineTo(0.077714, -0.103618).threePointArc((0.245691, 0.103316), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop4).extrude(-0.375000)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.195312, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.026435, -0.061419), (0.078701, -0.103125)).lineTo(0.130263, -0.103125).threePointArc((0.216024, 0.111507), (0.013569, 0.000000)).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch3.moveTo(0.132977, 0.021711).circle(0.070559)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(-0.375000)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
