# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288639" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.000000, 0.000000).lineTo(1.000000, 0.810526).lineTo(1.000000, 1.000000).lineTo(0.810526, 1.000000).lineTo(0.000000, 1.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.778947, 0.221053).lineTo(0.778947, 0.778947).lineTo(0.221053, 0.778947).lineTo(0.221053, 0.221053).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.312500, 0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.188816, 0.000000).lineTo(0.188816, -0.188816).lineTo(0.437500, 0.064474).lineTo(0.248684, 0.248684).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.375000, 0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.757812, 0.000000).lineTo(0.757812, 0.757812).lineTo(0.000000, 0.757812).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.654112, 0.103701).lineTo(0.654112, 0.654112).lineTo(0.103701, 0.654112).lineTo(0.103701, 0.103701).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.335938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
