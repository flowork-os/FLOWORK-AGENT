# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231400" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.859375, 0.000000).lineTo(0.859375, 0.497533).lineTo(0.000000, 0.497533).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, -0.375000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.078125, 0.000000).lineTo(1.078125, 0.794408).lineTo(0.000000, 0.794408).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.987336, 0.136184).lineTo(0.987336, 0.624178).lineTo(0.124836, 0.624178).lineTo(0.124836, 0.136184).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.375000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
