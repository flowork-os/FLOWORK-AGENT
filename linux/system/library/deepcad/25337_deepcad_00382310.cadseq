import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004914, -0.011863), (0.016776, -0.016776)).lineTo(0.116036, -0.016776).threePointArc((0.127899, -0.011863), (0.132812, 0.000000)).lineTo(0.132812, 0.099260).threePointArc((0.127899, 0.111123), (0.116036, 0.116036)).lineTo(0.016776, 0.116036).threePointArc((0.004914, 0.111123), (0.000000, 0.099260)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.116036, -0.001398).lineTo(0.116036, 0.100658).lineTo(0.016776, 0.100658).lineTo(0.016776, -0.001398).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
