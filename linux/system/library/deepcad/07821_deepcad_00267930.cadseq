# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267930" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, -0.640625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.289062, 0.000000).lineTo(1.289062, 1.289062).lineTo(0.000000, 1.289062).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.047368, 0.047368).circle(0.015789)
loop3=wp_sketch1.moveTo(0.047368, 1.452632).circle(0.015789)
loop4=wp_sketch1.moveTo(1.389474, 0.110526).lineTo(1.389474, 1.389474).lineTo(0.110526, 1.389474).lineTo(0.110526, 0.110526).close()
loop5=wp_sketch1.moveTo(1.452632, 0.047368).circle(0.015789)
loop6=wp_sketch1.moveTo(1.452632, 1.452632).circle(0.015789)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).extrude(0.054688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
