# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00353450" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.820313, 0.000000).lineTo(0.820313, 0.129523).lineTo(0.000000, 0.129523).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, -0.289062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.124836, 0.000000).lineTo(0.124836, 0.359375).lineTo(0.000000, 0.359375).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.070312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.127549, 0.000000).lineTo(0.257812, 0.130263).lineTo(0.257812, 0.257812).lineTo(0.203536, 0.257812).lineTo(0.000000, 0.054276).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.070312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.093750, -0.703125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.043421, 0.000000).circle(0.043421)
solid3=wp_sketch3.add(loop3).extrude(0.070312)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
