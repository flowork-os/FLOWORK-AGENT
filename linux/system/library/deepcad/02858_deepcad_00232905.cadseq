# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232905" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.474260, 0.000000).lineTo(0.474260, 0.048026).lineTo(0.474260, 0.144079).lineTo(0.570312, 0.144079).lineTo(0.570312, 0.378207).lineTo(0.144079, 0.378207).lineTo(0.144079, 0.288158).lineTo(0.000000, 0.288158).lineTo(0.000000, 0.156086).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.132072, 0.156086).circle(0.048026)
loop2=wp_sketch0.moveTo(0.426234, 0.048026).circle(0.036020)
loop3=wp_sketch0.moveTo(0.474260, 0.306168).circle(0.060033)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.117188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
