import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.023123, -0.055824), (0.078947, -0.078947)).lineTo(0.671053, -0.078947).threePointArc((0.726877, -0.055824), (0.750000, 0.000000)).lineTo(0.750000, 0.300000).threePointArc((0.726877, 0.355824), (0.671053, 0.378947)).lineTo(0.078947, 0.378947).threePointArc((0.023123, 0.355824), (0.000000, 0.300000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.078947, 0.000000).circle(0.031579)
loop2=wp_sketch0.moveTo(0.078947, 0.300000).circle(0.031579)
loop3=wp_sketch0.moveTo(0.671053, 0.000000).circle(0.031579)
loop4=wp_sketch0.moveTo(0.671053, 0.300000).circle(0.031579)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
