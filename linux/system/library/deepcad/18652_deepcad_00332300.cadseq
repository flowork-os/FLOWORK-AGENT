wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004625, -0.011165), (0.015789, -0.015789)).lineTo(0.734211, -0.015789).threePointArc((0.745375, -0.011165), (0.750000, 0.000000)).lineTo(0.750000, 0.378947).lineTo(0.489474, 0.584211).lineTo(0.260526, 0.584211).lineTo(0.000000, 0.378947).lineTo(0.000000, 0.000000).close()
