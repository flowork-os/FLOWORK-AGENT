# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297804" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.734211, 0.000000).circle(0.734211)
loop1=wp_sketch0.moveTo(0.734211, 0.000000).circle(0.122368)
loop2=wp_sketch0.moveTo(0.734211, -0.229441).circle(0.107072)
loop3=wp_sketch0.moveTo(0.734211, 0.229441).circle(0.107072)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(-0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.000000, 0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.110526, 0.000000).circle(0.110526)
loop5=wp_sketch1.moveTo(0.110526, 0.000000).circle(0.043750)
solid1=wp_sketch1.add(loop4).add(loop5).extrude(-0.039062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.000000, -0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch2.moveTo(0.110526, 0.000000).circle(0.110526)
loop7=wp_sketch2.moveTo(0.110526, 0.000000).circle(0.043750)
solid2=wp_sketch2.add(loop6).add(loop7).extrude(-0.039062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop8=wp_sketch3.moveTo(0.757895, 0.000000).circle(0.757895)
loop9=wp_sketch3.moveTo(0.757895, 0.000000).circle(0.726316)
solid3=wp_sketch3.add(loop8).add(loop9).extrude(-0.109375)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
