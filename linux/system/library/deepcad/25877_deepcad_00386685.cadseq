import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004625, -0.011165), (0.015789, -0.015789)).lineTo(0.734211, -0.015789).threePointArc((0.745375, -0.011165), (0.750000, 0.000000)).lineTo(0.750000, 0.260526).threePointArc((0.747010, 0.275639), (0.734211, 0.284211)).lineTo(0.015789, 0.284211).threePointArc((0.002990, 0.275639), (0.000000, 0.260526)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.150000, 0.134211).circle(0.015789)
loop2=wp_sketch0.moveTo(0.600000, 0.134211).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
