# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00334765" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.069079, -0.129523).lineTo(0.751234, -0.060444).lineTo(0.820313, 0.000000).lineTo(0.345395, 0.319490).lineTo(0.259046, 0.267681).lineTo(0.751234, 0.000000).lineTo(0.103618, -0.051809).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.242188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
