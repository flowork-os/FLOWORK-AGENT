# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00301517" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.300000, 0.000000).circle(0.300000)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.071875, -0.271875), (0.343750, -0.200000)).lineTo(0.343750, -0.125000).threePointArc((0.296875, -0.078125), (0.250000, -0.125000)).lineTo(0.250000, -0.200000).close()
loop2=wp_sketch0.moveTo(0.250000, -0.200000).threePointArc((0.459375, -0.084375), (0.343750, 0.125000)).lineTo(0.343750, 0.200000).threePointArc((0.296875, 0.153125), (0.250000, 0.200000)).lineTo(0.250000, 0.125000).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
