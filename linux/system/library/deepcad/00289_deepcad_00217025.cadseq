# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00217025" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, 0.429688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.180921, -0.271382).lineTo(0.180921, -0.781250).lineTo(0.279605, -0.781250).lineTo(0.279605, -0.156250).lineTo(0.032895, 0.041118).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.230263, -0.674342).circle(0.041118)
loop2=wp_sketch0.moveTo(0.230263, -0.238487).circle(0.041118)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.437500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.008388, -0.008388).lineTo(0.033553, 0.025164).lineTo(0.293586, -0.167763).lineTo(0.293586, -0.796875).lineTo(0.301974, -0.796875).lineTo(0.301974, -0.159375).lineTo(0.033553, 0.041941).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.085938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, 0.429688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.180921, -0.271382).lineTo(0.180921, -0.781250).lineTo(0.279605, -0.781250).lineTo(0.279605, -0.156250).lineTo(0.032895, 0.041118).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.230263, -0.674342).circle(0.041118)
loop6=wp_sketch2.moveTo(0.230263, -0.238487).circle(0.041118)
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).extrude(0.078125)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, -0.078125, 0.414062), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop7=wp_sketch3.moveTo(0.023684, 0.000000).circle(0.023191)
solid3=wp_sketch3.add(loop7).extrude(0.085938)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
