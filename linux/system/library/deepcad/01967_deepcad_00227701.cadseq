# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, -0.562500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.117188, 0.000000).lineTo(1.117188, 0.564474).lineTo(0.964309, 0.811431).lineTo(0.729112, 0.811431).lineTo(0.658553, 0.682072).lineTo(0.364556, 0.682072).lineTo(0.293997, 0.564474).lineTo(0.117599, 0.446875).lineTo(0.000000, 0.258717).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.296875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
