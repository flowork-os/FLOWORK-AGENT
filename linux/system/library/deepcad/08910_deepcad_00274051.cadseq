import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.531250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.164062, 0.000000).lineTo(1.164062, 1.164062).lineTo(0.000000, 1.164062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.588158, 0.588158).circle(0.453372)
