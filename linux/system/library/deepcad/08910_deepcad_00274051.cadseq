solid1=wp_sketch1.add(loop2).extrude(0.585938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.531250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(1.164062, 0.000000).lineTo(1.164062, 1.164062).lineTo(0.000000, 1.164062).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.588158, 0.588158).circle(0.453372)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.585938)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.453947, 0.000000).circle(0.453947)
loop6=wp_sketch3.moveTo(0.397204, 0.104030).lineTo(0.397204, -0.226974).lineTo(0.529605, -0.226974).lineTo(0.529605, 0.104030).lineTo(0.690378, 0.104030).lineTo(0.690378, 0.208059).lineTo(0.226974, 0.208059).lineTo(0.226974, 0.104030).close()
