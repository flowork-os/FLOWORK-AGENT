wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.568421, 0.000000).lineTo(0.568421, 0.450000).lineTo(0.568421, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.450000).lineTo(0.300000, 0.450000).threePointArc((0.316747, 0.443063), (0.323684, 0.426316)).lineTo(0.323684, 0.418421).threePointArc((0.316747, 0.401674), (0.300000, 0.394737)).lineTo(0.000000, 0.394737).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.157895, 0.244737).circle(0.031579)
loop2=wp_sketch0.moveTo(0.284211, 0.631579).circle(0.039474)
loop3=wp_sketch0.moveTo(0.371053, 0.110526).circle(0.039474)
