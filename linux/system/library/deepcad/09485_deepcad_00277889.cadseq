# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.023438, 0.000000).lineTo(1.023438, 0.344737).lineTo(0.463240, 0.344737).lineTo(0.463240, 0.290872).lineTo(0.409375, 0.290872).lineTo(0.409375, 0.344737).lineTo(0.312418, 0.344737).lineTo(0.312418, 0.290872).lineTo(0.269326, 0.290872).lineTo(0.269326, 0.344737).lineTo(0.000000, 0.344737).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
