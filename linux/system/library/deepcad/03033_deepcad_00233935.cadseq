import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.101562, 0.125000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.098602, 0.000000).lineTo(0.098602, -0.125493).lineTo(0.851562, -0.125493).threePointArc((0.631025, 0.406930), (0.098602, 0.627467)).lineTo(0.098602, 0.501974).lineTo(0.000000, 0.501974).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.412336, 0.188240).circle(0.089638)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
