# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239016" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).lineTo(1.500000, 0.000000).threePointArc((0.750000, 0.750000), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.710526, 0.078947).lineTo(0.284211, 0.489474).threePointArc((0.145962, 0.302019), (0.078947, 0.078947)).close()
loop2=wp_sketch0.moveTo(0.726316, 0.094737).lineTo(0.726316, 0.678947).threePointArc((0.498089, 0.629092), (0.300000, 0.505263)).close()
loop3=wp_sketch0.moveTo(0.773684, 0.094737).lineTo(1.200000, 0.505263).threePointArc((1.001911, 0.629092), (0.773684, 0.678947)).close()
loop4=wp_sketch0.moveTo(1.421053, 0.078947).threePointArc((1.354038, 0.302019), (1.215789, 0.489474)).lineTo(0.789474, 0.078947).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.062500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
