# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00321873" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.523438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.367188, 0.000000).lineTo(1.367188, 1.208882).lineTo(0.000000, 1.208882).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.201480, 0.388569).circle(0.100740)
loop2=wp_sketch0.moveTo(0.388569, 0.762747).circle(0.172697)
loop3=wp_sketch0.moveTo(1.165707, 0.388569).circle(0.100740)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.492188, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
