wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.296875, 0.256250).lineTo(0.000000, 0.256250).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(-0.226562)
solid_temp=solid_temp.union(solid4)
solid=solid.cut(solid_temp)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
