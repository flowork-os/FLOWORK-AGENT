loop3=wp_sketch2.moveTo(0.114474, 0.000000).lineTo(0.114474, 0.125000).lineTo(0.000000, 0.125000).threePointArc((-0.004996, 0.062500), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.242188)
solid=solid.union(solid2)
# workplane for sketch 3
