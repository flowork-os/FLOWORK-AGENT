# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00299627" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.055263).lineTo(0.505263, 0.055263).threePointArc((0.478655, 0.066738), (0.450000, 0.071053)).lineTo(0.355263, 0.126316).threePointArc((0.359800, 0.134211), (0.355263, 0.142105)).lineTo(0.260526, 0.197368).threePointArc((0.255200, 0.188285), (0.244737, 0.189474)).lineTo(0.157895, 0.244737).threePointArc((0.159530, 0.248684), (0.157895, 0.252632)).lineTo(0.181579, 0.292105).lineTo(0.173684, 0.300000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.050919, 0.011281), (0.078947, 0.055263)).lineTo(0.157895, 0.007895).lineTo(0.434211, 0.007895).threePointArc((0.463398, 0.029443), (0.450000, 0.063158)).lineTo(0.173684, 0.221053).threePointArc((0.152312, 0.225281), (0.134211, 0.213158)).lineTo(0.063158, 0.094737).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.289062, -0.023438, 0.179688), cq.Vector(0.870087, 0.000000, -0.492898), cq.Vector(0.492898, 0.000000, 0.870087)))
loop2=wp_sketch1.moveTo(0.039474, 0.000000).threePointArc((0.062171, 0.022697), (0.039474, 0.045395)).lineTo(0.000000, 0.045395).threePointArc((-0.022697, 0.022697), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(-0.031250)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
