# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00224873" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.664062, -0.015625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.119737, 0.000000).threePointArc((1.145556, 0.010694), (1.156250, 0.036513)).lineTo(1.156250, 0.121711).threePointArc((1.148076, 0.153615), (1.119737, 0.170395)).lineTo(0.000000, 0.170395).threePointArc((-0.085197, 0.085197), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.036513, 0.085197).circle(0.036513)
loop2=wp_sketch0.moveTo(0.292105, 0.085197).circle(0.036513)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
