# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00236194" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.468750, 0.000000, -0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.277961, 0.000000).lineTo(0.277961, 0.443668).threePointArc((0.138980, 0.304688), (0.000000, 0.443668)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.138980, 0.443668).circle(0.064145)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
