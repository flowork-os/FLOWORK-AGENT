solid1=wp_sketch1.add(loop1).extrude(-0.148438)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, -0.351562, 0.148438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.139885, 0.000000).lineTo(0.186513, 0.219819).lineTo(0.186513, 0.632812).lineTo(0.079934, 0.632812).lineTo(0.079934, 0.373026).lineTo(0.079934, 0.313076).lineTo(0.033306, 0.073273).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.148438)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.226562, 0.148438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.035526, 0.026645).lineTo(0.097697, 0.053289).lineTo(0.204276, 0.053289).lineTo(0.310855, 0.053289).lineTo(0.541776, 0.053289).lineTo(0.657237, 0.053289).lineTo(0.843750, 0.053289).lineTo(0.843750, 0.124342).lineTo(0.097697, 0.124342).lineTo(0.000000, 0.000000).close()
