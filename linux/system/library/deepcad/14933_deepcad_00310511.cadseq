# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.109375, -0.273438, 0.148438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
