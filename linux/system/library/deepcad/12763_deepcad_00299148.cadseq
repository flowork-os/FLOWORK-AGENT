# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00299148" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.631579, 0.000000).threePointArc((0.750000, 0.118421), (0.631579, 0.236842)).lineTo(0.000000, 0.236842).threePointArc((-0.118421, 0.118421), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.118421).circle(0.039474)
loop2=wp_sketch0.moveTo(0.631579, 0.071053).threePointArc((0.678947, 0.118421), (0.631579, 0.165789)).lineTo(0.213158, 0.165789).threePointArc((0.161459, 0.128385), (0.189474, 0.071053)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
