import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.070312, 0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.008166, -0.017245), (0.007155, -0.028618)).lineTo(0.393503, -0.028618).threePointArc((0.397792, -0.025753), (0.400658, -0.021464)).lineTo(0.672533, 0.250411).threePointArc((0.674186, 0.267015), (0.658224, 0.271875)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.386349, 0.000000).lineTo(0.600987, 0.214638).lineTo(0.078701, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.382812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
