# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00312038" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.640625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.141612, -0.640625).lineTo(0.350658, -0.640625).lineTo(0.121382, -0.060691).threePointArc((0.046566, -0.058596), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.476562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, 0.578125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.231250, -0.578125).lineTo(0.438158, -0.578125).lineTo(0.042599, 0.127796).threePointArc((0.050094, 0.054300), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.476562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.664062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.090789, 0.000000).circle(0.090789)
loop3=wp_sketch2.moveTo(0.090789, 0.000000).circle(0.030263)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.476562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
