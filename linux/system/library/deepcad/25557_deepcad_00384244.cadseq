# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00384244" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.068832, 0.000000).lineTo(0.068832, -0.466530).lineTo(0.726562, -0.466530).lineTo(0.726562, -0.374753).lineTo(0.198849, -0.374753).threePointArc((0.133569, -0.401793), (0.160609, -0.336513)).lineTo(0.160609, 0.374753).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.289062, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.172697, 0.000000).threePointArc((0.217599, 0.044901), (0.172697, 0.089803)).lineTo(0.000000, 0.089803).threePointArc((-0.044901, 0.044901), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.375000)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
