loop3=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.466401, -0.202615), (0.658717, -0.673355)).lineTo(0.695312, -0.673355).threePointArc((0.489539, -0.190168), (0.000000, 0.000000)).close()
