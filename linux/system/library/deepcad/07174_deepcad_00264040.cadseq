# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.492188, 0.000000).lineTo(1.492188, 0.502632).lineTo(0.801069, 0.502632).lineTo(0.753947, 0.628289).lineTo(0.502632, 0.628289).lineTo(0.502632, 0.502632).lineTo(0.628289, 0.502632).lineTo(0.628289, 0.376974).lineTo(0.125658, 0.376974).lineTo(0.125658, 0.502632).lineTo(0.251316, 0.502632).lineTo(0.251316, 0.628289).lineTo(0.000000, 0.628289).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.375000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
