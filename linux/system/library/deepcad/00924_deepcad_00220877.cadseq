# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220877" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, -0.585938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.814145, 0.000000).lineTo(0.814145, 1.171875).lineTo(0.000000, 1.171875).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.407072, 0.185033).circle(0.098684)
loop2=wp_sketch0.moveTo(0.394737, 1.036184).circle(0.086349)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.554688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, -0.289062, 0.554688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.296875, -0.296875), (0.593750, 0.000000)).lineTo(0.462500, 0.000000).threePointArc((0.296875, -0.165625), (0.131250, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.273438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
