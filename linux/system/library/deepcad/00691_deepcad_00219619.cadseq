loop3=wp_sketch3.moveTo(0.031579, 0.000000).lineTo(0.031579, 0.213158).lineTo(0.031579, 0.375000).lineTo(0.000000, 0.375000).lineTo(0.000000, 0.161842).lineTo(0.000000, 0.000000).close()
