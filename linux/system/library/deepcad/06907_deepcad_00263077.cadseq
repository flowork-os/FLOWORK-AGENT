wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.085526, -0.085526).lineTo(0.449013, -0.085526).threePointArc((0.479653, -0.095042), (0.502467, -0.117599)).threePointArc((0.528889, -0.226042), (0.587993, -0.320724)).lineTo(0.652138, -0.320724).lineTo(1.015625, 0.085526).lineTo(1.015625, 0.320724).lineTo(0.951480, 0.384868).lineTo(0.652138, 0.384868).threePointArc((0.546128, 0.292466), (0.406250, 0.277961)).lineTo(0.171053, 0.310033).lineTo(0.085526, 0.310033).lineTo(0.000000, 0.224507).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.171053, 0.085526).circle(0.085526)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.539062)
