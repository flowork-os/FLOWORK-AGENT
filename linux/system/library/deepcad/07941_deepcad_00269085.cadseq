# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00269085" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, -0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.114474, 0.000000).threePointArc((0.182848, 0.099094), (0.065132, 0.124342)).threePointArc((0.056245, 0.117445), (0.045395, 0.114474)).lineTo(0.000000, 0.114474).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, -0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.118421).threePointArc((-0.055263, 0.173684), (0.000000, 0.228947)).lineTo(0.292105, 0.228947).threePointArc((0.366852, 0.206712), (0.410526, 0.142105)).threePointArc((0.710417, 0.069471), (0.576316, 0.347368)).lineTo(0.000000, 0.347368).threePointArc((-0.173684, 0.173684), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.576316, 0.173684).circle(0.071053)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.171875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
