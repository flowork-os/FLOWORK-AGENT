# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232041" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.148438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.142105, -0.157895).lineTo(0.757895, -0.157895).lineTo(1.357895, -0.157895).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.300000).lineTo(1.357895, 0.457895).lineTo(0.757895, 0.457895).lineTo(0.142105, 0.457895).lineTo(0.000000, 0.300000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.140625, 0.078125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.123026, -0.138405).lineTo(1.337911, -0.138405).lineTo(1.460938, 0.000000).lineTo(1.460938, 0.292187).lineTo(1.337911, 0.430592).lineTo(0.123026, 0.430592).lineTo(0.000000, 0.292187).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.007812)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
