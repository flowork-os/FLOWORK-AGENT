# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00361070" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.338487, 0.000000).lineTo(0.338487, 0.048355).lineTo(0.545724, 0.048355).lineTo(0.545724, 0.656250).lineTo(0.283224, 0.656250).lineTo(0.283224, 0.552632).lineTo(0.151974, 0.552632).lineTo(0.151974, 0.310855).lineTo(0.000000, 0.310855).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.148438, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.205263, 0.000000).lineTo(0.205263, -0.044901).lineTo(0.545230, -0.044901).lineTo(0.545230, 0.262993).lineTo(0.391283, 0.262993).lineTo(0.391283, 0.506743).lineTo(0.256579, 0.506743).lineTo(0.256579, 0.609375).lineTo(0.000000, 0.609375).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.148438, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
