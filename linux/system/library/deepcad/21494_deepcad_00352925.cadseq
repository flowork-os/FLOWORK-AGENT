import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.076891, 0.000000).lineTo(0.076891, 0.085938).lineTo(0.000000, 0.085938).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.367188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.083224, 0.000000).lineTo(0.083224, 0.085938).lineTo(0.000000, 0.085938).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.367188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, 0.093750, 0.367188), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.390625, 0.000000).lineTo(0.390625, 0.131579).lineTo(0.000000, 0.131579).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.111020, 0.028783).lineTo(0.111020, 0.111020).lineTo(0.032895, 0.111020).lineTo(0.032895, 0.028783).close()
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.382812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.125000, 0.367188), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.076891, 0.000000).lineTo(0.076891, 0.085938).lineTo(0.000000, 0.085938).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.382812)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
