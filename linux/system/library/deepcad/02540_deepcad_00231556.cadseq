loop3=wp_sketch3.moveTo(0.115625, 0.000000).lineTo(0.296875, 0.000000).lineTo(0.296875, 0.053125).lineTo(0.000000, 0.053125).lineTo(0.000000, 0.050000).lineTo(0.000000, 0.025000).lineTo(0.000000, 0.000000).close()
