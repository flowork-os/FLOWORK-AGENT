# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch5.moveTo(0.335938, 0.000000).lineTo(0.265214, 0.084868).lineTo(0.070724, 0.084868).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop5).extrude(0.218750)
solid=solid.union(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
