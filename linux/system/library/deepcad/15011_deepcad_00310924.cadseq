# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.086842, 0.000000).circle(0.086842)
solid3=wp_sketch3.add(loop3).extrude(0.781250)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.335938, 0.000000).lineTo(0.335938, 0.106086).lineTo(0.000000, 0.106086).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.218750)
