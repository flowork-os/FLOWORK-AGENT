import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.382812, 0.000000).lineTo(1.382812, 0.262007).lineTo(0.000000, 0.262007).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, 0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.382812, 0.000000).lineTo(1.018914, 0.363898).lineTo(0.320230, 0.363898).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.226562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.000000, 0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.382813, 0.000000).lineTo(0.382813, 0.161184).lineTo(0.000000, 0.161184).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.218750)
