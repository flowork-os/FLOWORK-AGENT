# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00278883" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.045395, 0.000000).lineTo(0.045395, 0.045395).lineTo(0.045395, 0.179688).lineTo(0.000000, 0.179688).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.570312, 0.703125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.045888, 0.000000).lineTo(0.094737, 0.000000).lineTo(0.094737, -0.113980).lineTo(0.140625, -0.113980).lineTo(0.140625, 0.000000).lineTo(0.140625, 0.045888).lineTo(0.000000, 0.045888).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.117188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(1.132812, 0.000000).lineTo(1.132812, 0.047697).lineTo(0.000000, 0.047697).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.117188)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.570312, -0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.045888, 0.000000).lineTo(0.045888, 0.726562).lineTo(0.000000, 0.726562).lineTo(0.000000, 0.045888).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.117188)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
