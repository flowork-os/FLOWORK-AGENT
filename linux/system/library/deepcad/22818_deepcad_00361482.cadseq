# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00361482" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, -0.523438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.308306, 0.000000).lineTo(0.254688, 1.273438).lineTo(0.053618, 1.273438).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.086842, -0.048849).lineTo(0.171875, 0.000000).lineTo(0.171875, 0.099507).lineTo(0.086842, 0.148355).lineTo(0.000000, 0.099507).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.281250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.414062, -0.343750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.086842, -0.048849).lineTo(0.171875, 0.000000).lineTo(0.171875, 0.099507).lineTo(0.086842, 0.148355).lineTo(0.000000, 0.099507).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.281250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
