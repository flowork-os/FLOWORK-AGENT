# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00302419" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.453125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.087868, -0.212132), (0.300000, -0.300000)).lineTo(1.231579, -0.300000).threePointArc((1.421381, -0.221381), (1.500000, -0.031579)).lineTo(1.500000, 0.978947).threePointArc((1.435255, 1.135255), (1.278947, 1.200000)).lineTo(0.189474, 1.200000).threePointArc((0.055496, 1.144504), (0.000000, 1.010526)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
