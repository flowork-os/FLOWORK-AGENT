# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00214853" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
solid0=wp_sketch0.add(loop0).extrude(-0.218750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.757895)
loop2=wp_sketch1.moveTo(0.978947, -0.221053).threePointArc((1.067348, 0.000000), (0.978947, 0.221053)).lineTo(0.521053, 0.221053).threePointArc((0.432652, 0.000000), (0.521053, -0.221053)).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.546875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
