import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002890, -0.006978), (0.009868, -0.009868)).lineTo(0.068257, -0.009868).threePointArc((0.075235, -0.006978), (0.078125, 0.000000)).lineTo(0.078125, 0.058388).threePointArc((0.075235, 0.065366), (0.068257, 0.068257)).lineTo(0.009868, 0.068257).threePointArc((0.002890, 0.065366), (0.000000, 0.058388)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.003912, -0.004511), (0.009868, -0.004934)).lineTo(0.068257, -0.004934).threePointArc((0.071746, -0.003489), (0.073191, 0.000000)).lineTo(0.073191, 0.058388).threePointArc((0.071746, 0.061877), (0.068257, 0.063322)).lineTo(0.009868, 0.063322).threePointArc((0.006379, 0.061877), (0.004934, 0.058388)).lineTo(0.004934, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
