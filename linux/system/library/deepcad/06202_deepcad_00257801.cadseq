# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.678865, 0.000000).lineTo(0.992188, -0.041776).lineTo(0.992188, 0.177549).lineTo(0.511760, 0.177549).lineTo(0.511760, 0.355099).lineTo(0.417763, 0.574424).lineTo(0.417763, 0.710197).lineTo(0.177549, 0.710197).lineTo(0.177549, 0.553536).lineTo(0.000000, 0.417763).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.109375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
