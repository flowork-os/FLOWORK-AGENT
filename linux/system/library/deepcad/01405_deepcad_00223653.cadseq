# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00223653" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.382812, 0.000000).lineTo(1.382812, 0.145559).lineTo(1.382812, 0.189227).lineTo(1.382812, 0.334786).lineTo(0.000000, 0.334786).lineTo(0.000000, 0.189227).lineTo(0.000000, 0.145559).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.251809, 0.145559).lineTo(1.251809, 0.189227).lineTo(0.131003, 0.189227).lineTo(0.131003, 0.145559).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
