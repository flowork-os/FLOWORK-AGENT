# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00286432" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.336760, 0.000000).lineTo(0.336760, 0.507812).lineTo(0.000000, 0.507812).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.080181, 0.411595).circle(0.053454)
loop2=wp_sketch0.moveTo(0.122944, 0.112253).circle(0.016036)
loop3=wp_sketch0.moveTo(0.256579, 0.411595).circle(0.053454)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.085938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
