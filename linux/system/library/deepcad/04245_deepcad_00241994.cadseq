wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.096565, -0.016154), (0.177632, -0.071053)).threePointArc((0.461842, -0.192884), (0.746053, -0.071053)).threePointArc((0.827119, -0.016154), (0.923684, 0.000000)).threePointArc((1.126408, 0.195395), (0.923684, 0.390789)).threePointArc((0.827119, 0.406943), (0.746053, 0.461842)).threePointArc((0.461842, 0.583673), (0.177632, 0.461842)).threePointArc((0.096565, 0.406943), (0.000000, 0.390789)).threePointArc((-0.202724, 0.195395), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.011842, 0.189474).circle(0.082895)
