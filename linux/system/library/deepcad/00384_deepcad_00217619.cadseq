wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.222286, -0.091530).threePointArc((0.354649, -0.073411), (0.483799, -0.039227)).threePointArc((0.645126, 0.023049), (0.797615, 0.104605)).lineTo(1.202961, 0.366118).lineTo(1.242188, 0.575329).lineTo(1.046053, 0.627632).lineTo(0.784539, 0.470724).lineTo(0.876069, 0.339967).lineTo(0.679934, 0.209211).lineTo(0.588405, 0.353043).threePointArc((0.337158, 0.227597), (0.065378, 0.156908)).lineTo(0.000000, 0.000000).close()
