# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00291427" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.117188, 0.000000).lineTo(1.117188, 0.070559).lineTo(0.000000, 0.070559).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.523438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, -0.671875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.846711, 0.000000).lineTo(0.846711, 1.031250).lineTo(0.032566, 1.031250).lineTo(0.000000, 0.998684).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.423355, 0.575329).circle(0.119408)
loop3=wp_sketch1.moveTo(0.423355, 0.141118).circle(0.043421)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.523438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, -0.531250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.039474, 0.000000).circle(0.038651)
solid2=wp_sketch2.add(loop4).extrude(0.523438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
