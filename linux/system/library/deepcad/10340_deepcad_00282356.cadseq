# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00282356" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.260526, -0.181579).lineTo(0.221053, -0.600000).threePointArc((0.371053, -0.750000), (0.521053, -0.600000)).lineTo(0.481579, -0.181579).lineTo(0.742105, 0.000000).threePointArc((0.371053, 0.371053), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.371053, -0.600000).circle(0.055263)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
