# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00293834" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, -0.531250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.121382, 0.000000).lineTo(0.121382, -0.215789).lineTo(0.377632, -0.215789).lineTo(0.377632, 0.000000).lineTo(0.499013, 0.000000).lineTo(0.499013, 1.065461).lineTo(0.377632, 1.065461).lineTo(0.377632, 1.281250).lineTo(0.121382, 1.281250).lineTo(0.121382, 1.065461).lineTo(0.000000, 1.065461).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.256250, 0.337171).circle(0.053947)
loop2=wp_sketch0.moveTo(0.256250, 0.714803).circle(0.053947)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
