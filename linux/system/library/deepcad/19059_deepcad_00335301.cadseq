# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00335301" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.542434, 0.000000).threePointArc((0.757812, 0.215378), (0.542434, 0.430757)).lineTo(0.000000, 0.430757).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.215378, 0.215378).circle(0.111678)
loop2=wp_sketch0.moveTo(0.542434, 0.215378).circle(0.111678)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.218750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.187500, 0.218750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.425000, 0.000000).lineTo(0.425000, 0.318750).lineTo(0.425000, 0.425000).threePointArc((0.393880, 0.500130), (0.318750, 0.531250)).lineTo(0.318750, 0.318750).threePointArc((0.212500, 0.212500), (0.106250, 0.318750)).lineTo(0.106250, 0.531250).threePointArc((0.031120, 0.500130), (0.000000, 0.425000)).lineTo(0.000000, 0.318750).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.218750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.187500, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.429688, 0.000000).lineTo(0.429688, 0.217105).lineTo(0.000000, 0.217105).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.218750)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
