# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00277745" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.023123, -0.055824), (0.078947, -0.078947)).lineTo(1.421053, -0.078947).threePointArc((1.476877, -0.055824), (1.500000, 0.000000)).lineTo(1.500000, 0.268421).threePointArc((1.476877, 0.324245), (1.421053, 0.347368)).lineTo(0.078947, 0.347368).threePointArc((0.023123, 0.324245), (0.000000, 0.268421)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.142105, 0.126316).circle(0.078947)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.109375, 0.085938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.022401, -0.054080), (0.076480, -0.076480)).lineTo(1.376645, -0.076480).threePointArc((1.430724, -0.054080), (1.453125, 0.000000)).lineTo(1.453125, 0.214145).threePointArc((1.430724, 0.268224), (1.376645, 0.290625)).lineTo(0.076480, 0.290625).threePointArc((0.022401, 0.268224), (0.000000, 0.214145)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.122368, 0.107072).circle(0.076480)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.039062)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
