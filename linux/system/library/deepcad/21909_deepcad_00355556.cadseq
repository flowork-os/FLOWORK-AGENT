import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, 0.000000, 0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.414062, 0.000000).lineTo(1.414062, 0.342352).lineTo(0.937747, 0.342352).threePointArc((0.879121, 0.394605), (0.803783, 0.416776)).threePointArc((0.625894, 0.495727), (0.506086, 0.342352)).lineTo(0.000000, 0.342352).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.335938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
