import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, -0.671875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.021217, 0.000000).lineTo(0.021217, -0.077796).lineTo(0.035362, -0.077796).lineTo(0.035362, 0.671875).lineTo(0.021217, 0.671875).lineTo(0.021217, 0.594079).lineTo(0.000000, 0.594079).lineTo(0.000000, 0.438487).lineTo(0.021217, 0.438487).lineTo(0.021217, 0.360691).lineTo(0.000000, 0.360691).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
