# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00364488" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.664062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.118832, -0.664062).lineTo(0.167763, -0.664062).lineTo(0.034951, 0.076891).threePointArc((0.032903, 0.081834), (0.027961, 0.083882)).lineTo(0.000000, 0.076891).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
