# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00238932" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.139803, 0.000000).threePointArc((1.184578, 0.018547), (1.203125, 0.063322)).lineTo(1.203125, 0.329276).threePointArc((1.154904, 0.445693), (1.038487, 0.493914)).lineTo(0.873849, 0.493914).threePointArc((0.838028, 0.479077), (0.823191, 0.443257)).lineTo(0.823191, 0.329276).lineTo(0.493914, 0.329276).threePointArc((0.458094, 0.344114), (0.443257, 0.379934)).lineTo(0.443257, 0.493914).threePointArc((0.395035, 0.610331), (0.278618, 0.658553)).lineTo(0.050658, 0.658553).threePointArc((0.014837, 0.643715), (0.000000, 0.607895)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.820313, 0.000000).lineTo(0.820313, 0.656250).lineTo(0.000000, 0.328125).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.241776, 0.215872).circle(0.164063)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.273438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
