import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.000000, -0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.652138, 0.000000).lineTo(0.953125, -0.040132).lineTo(0.953125, 0.170559).lineTo(0.491612, 0.170559).lineTo(0.491612, 0.341118).lineTo(0.401316, 0.551809).lineTo(0.401316, 0.682237).lineTo(0.170559, 0.682237).lineTo(0.170559, 0.531743).lineTo(0.000000, 0.401316).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.109375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
