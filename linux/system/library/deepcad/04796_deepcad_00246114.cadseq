# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00246114" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.398438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.136924, 0.000000).lineTo(0.136924, -0.502056).lineTo(0.806332, -0.502056).lineTo(0.806332, -0.638980).lineTo(1.445312, -0.638980).lineTo(1.445312, -0.167352).lineTo(0.395559, 0.121711).lineTo(0.000000, 0.121711).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.201891, -0.395559).circle(0.106497)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.134868, 0.000000).lineTo(0.134868, 0.134868).lineTo(0.134868, 0.640625).lineTo(0.000000, 0.640625).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.562500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, -0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.664062, 0.000000).lineTo(0.664062, 0.139803).lineTo(0.000000, 0.139803).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.562500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
