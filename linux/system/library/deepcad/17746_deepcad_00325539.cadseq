# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00325539" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000169, -0.000407), (0.000576, -0.000576)).lineTo(0.007237, -0.000576).threePointArc((0.007644, -0.000407), (0.007812, 0.000000)).lineTo(0.007812, 0.006579).threePointArc((0.007661, 0.007027), (0.007237, 0.007237)).lineTo(0.000576, 0.007237).threePointArc((0.000152, 0.007027), (0.000000, 0.006579)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.007237, 0.000000).lineTo(0.007237, 0.006579).lineTo(0.000576, 0.006579).lineTo(0.000576, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
