import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.033240, -0.080247), (0.113487, -0.113487)).lineTo(0.964638, -0.113487).threePointArc((1.044885, -0.080247), (1.078125, 0.000000)).lineTo(1.078125, 0.431250).threePointArc((1.044885, 0.511497), (0.964638, 0.544737)).lineTo(0.113487, 0.544737).threePointArc((0.033240, 0.511497), (0.000000, 0.431250)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.113487, 0.000000).circle(0.045395)
loop2=wp_sketch0.moveTo(0.113487, 0.431250).circle(0.045395)
loop3=wp_sketch0.moveTo(0.964638, 0.000000).circle(0.045395)
loop4=wp_sketch0.moveTo(0.964638, 0.431250).circle(0.045395)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
