# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00317845" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.250000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.252632, 0.000000).circle(0.252632)
loop1=wp_sketch0.moveTo(0.252632, 0.000000).circle(0.126316)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.750000, -0.250000, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.018421, 0.000000).threePointArc((0.110661, 0.112756), (0.250000, 0.155263)).lineTo(0.000000, 0.155263).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.250000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.750000, 0.000000, 0.250000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.139339, -0.042507), (0.231579, -0.155263)).lineTo(0.250000, -0.155263).lineTo(0.250000, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.250000)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.750000, -0.234375, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.150411, 0.000000).threePointArc((0.230469, 0.030319), (0.310526, 0.000000)).lineTo(0.460938, 0.000000).threePointArc((0.230469, 0.156048), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop4).extrude(-0.250000)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.750000, -0.085938, 0.093750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop5=wp_sketch4.moveTo(0.164062, 0.000000).threePointArc((0.082031, 0.031066), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop5).extrude(-0.250000)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
