# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00379834" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.536842, -0.063158).lineTo(0.410526, -0.473684).lineTo(0.757895, -0.221053).lineTo(1.089474, -0.473684).lineTo(0.963158, -0.063158).lineTo(1.310526, 0.173684).lineTo(0.884211, 0.173684).lineTo(0.757895, 0.584211).lineTo(0.615789, 0.173684).lineTo(0.189474, 0.173684).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, 0.179688, 0.117188), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.341036, -0.246957).lineTo(0.211678, -0.658553).lineTo(0.564474, -0.411595).lineTo(0.905510, -0.658553).lineTo(0.776151, -0.246957).lineTo(1.117188, 0.000000).lineTo(0.693832, 0.000000).lineTo(0.564474, 0.411595).lineTo(0.423355, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.195312)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
