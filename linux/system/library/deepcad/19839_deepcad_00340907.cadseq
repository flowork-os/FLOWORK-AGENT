# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00340907" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.452632, 0.000000).threePointArc((0.486126, 0.013874), (0.500000, 0.047368)).lineTo(0.500000, 0.089474).threePointArc((0.486126, 0.122968), (0.452632, 0.136842)).lineTo(0.000000, 0.136842).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.110526, 0.026316).lineTo(0.110526, 0.110526).lineTo(0.026316, 0.110526).lineTo(0.026316, 0.026316).close()
loop2=wp_sketch0.moveTo(0.231579, 0.026316).lineTo(0.231579, 0.110526).lineTo(0.147368, 0.110526).lineTo(0.147368, 0.026316).close()
loop3=wp_sketch0.moveTo(0.310526, 0.068421).circle(0.052632)
loop4=wp_sketch0.moveTo(0.431579, 0.068421).circle(0.052632)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
