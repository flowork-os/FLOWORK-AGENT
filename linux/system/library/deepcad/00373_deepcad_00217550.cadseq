# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.063974, -0.154447), (0.218421, -0.218421)).lineTo(1.078454, -0.218421).threePointArc((1.232901, -0.154447), (1.296875, 0.000000)).lineTo(1.296875, 0.614309).threePointArc((1.232901, 0.768756), (1.078454, 0.832730)).lineTo(0.218421, 0.832730).threePointArc((0.063974, 0.768756), (0.000000, 0.614309)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.109375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
