# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220999" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, 0.000000, 0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.391594, -0.185353), (0.502138, 0.233553)).lineTo(0.040872, 0.221875).threePointArc((0.016665, 0.179844), (0.000000, 0.134293)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.274424, 0.011678).circle(0.105099)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.312500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, 0.554688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.460938, 0.004852).threePointArc((0.229191, 0.123802), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.312500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.273438, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.563076, 0.000000).lineTo(0.563076, 1.304688).lineTo(0.494408, 1.304688).threePointArc((0.387680, 0.890474), (0.000000, 1.071217)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.312500)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
