import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.593750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.046246, -0.111648), (0.157895, -0.157895)).lineTo(1.342105, -0.157895).threePointArc((1.453754, -0.111648), (1.500000, 0.000000)).lineTo(1.500000, 1.184211).threePointArc((1.453754, 1.295859), (1.342105, 1.342105)).lineTo(0.157895, 1.342105).threePointArc((0.046246, 1.295859), (0.000000, 1.184211)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.062597, -0.072175), (0.157895, -0.078947)).lineTo(1.342105, -0.078947).threePointArc((1.397929, -0.055824), (1.421053, 0.000000)).lineTo(1.421053, 1.184211).threePointArc((1.397929, 1.240035), (1.342105, 1.263158)).lineTo(0.157895, 1.263158).threePointArc((0.102071, 1.240035), (0.078947, 1.184211)).lineTo(0.078947, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, -0.593750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.070724, 0.000000).threePointArc((0.056076, -0.035362), (0.070724, -0.070724)).lineTo(1.273026, -0.070724).threePointArc((1.323036, -0.050009), (1.343750, 0.000000)).lineTo(1.343750, 1.188158).threePointArc((1.325965, 1.245239), (1.273026, 1.273026)).lineTo(0.070724, 1.273026).threePointArc((0.017785, 1.245239), (0.000000, 1.188158)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.070312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.070312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.382895, 0.000000).circle(0.382895)
solid2=wp_sketch2.add(loop3).extrude(-0.046875)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
