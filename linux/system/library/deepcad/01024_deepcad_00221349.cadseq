# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00221349" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.081250, 0.000000).lineTo(0.056250, 0.037500).lineTo(0.056250, 0.518750).lineTo(0.181250, 0.518750).lineTo(0.181250, -0.087500).lineTo(0.593750, -0.087500).lineTo(0.593750, 0.575000).lineTo(0.000000, 0.575000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.537500, -0.031250).lineTo(0.537500, 0.518750).lineTo(0.237500, 0.518750).lineTo(0.237500, -0.031250).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
