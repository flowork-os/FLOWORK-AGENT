# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00275436" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.609375, 0.000000).lineTo(0.609375, 0.551645).lineTo(0.000000, 0.551645).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, -0.625000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.035696, -0.086179), (0.121875, -0.121875)).lineTo(0.487500, -0.121875).threePointArc((0.573679, -0.086179), (0.609375, 0.000000)).lineTo(0.609375, 0.121875).lineTo(0.000000, 0.121875).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.243750, -0.089803).circle(0.012829)
loop3=wp_sketch1.moveTo(0.365625, -0.089803).circle(0.012829)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, -0.507812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.609375, 0.000000).lineTo(0.609375, 0.577303).lineTo(0.000000, 0.577303).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.243750, 0.243750).circle(0.006414)
loop6=wp_sketch2.moveTo(0.243750, 0.519572).circle(0.006414)
loop7=wp_sketch2.moveTo(0.365625, 0.243750).circle(0.006414)
loop8=wp_sketch2.moveTo(0.365625, 0.519572).circle(0.006414)
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).add(loop7).add(loop8).extrude(0.031250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
