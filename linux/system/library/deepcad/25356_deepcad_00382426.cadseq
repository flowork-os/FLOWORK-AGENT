# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382426" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.260526, 0.000000).circle(0.260526)
loop1=wp_sketch0.moveTo(0.260526, 0.000000).circle(0.151974)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.359375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.659211, 0.000000).circle(0.659211)
loop3=wp_sketch1.moveTo(0.206003, 0.000000).circle(0.123602)
loop4=wp_sketch1.moveTo(0.659211, 0.000000).circle(0.260937)
loop5=wp_sketch1.moveTo(0.659211, -0.439474).circle(0.123602)
loop6=wp_sketch1.moveTo(0.659211, 0.453207).circle(0.123602)
loop7=wp_sketch1.moveTo(1.126151, 0.000000).circle(0.123602)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).add(loop7).extrude(0.117188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop8=wp_sketch2.moveTo(0.757895, 0.000000).circle(0.742105)
loop9=wp_sketch2.moveTo(0.757895, 0.000000).circle(0.647368)
solid2=wp_sketch2.add(loop8).add(loop9).extrude(0.242188)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
