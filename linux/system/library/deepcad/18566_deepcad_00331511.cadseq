import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.227961, 0.000000).lineTo(0.227961, 0.155428).lineTo(0.870395, 0.155428).lineTo(0.870395, 0.000000).lineTo(0.984375, 0.000000).lineTo(0.984375, 0.279770).lineTo(0.227961, 0.279770).lineTo(0.227961, 0.621711).lineTo(0.000000, 0.279770).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.460938)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
