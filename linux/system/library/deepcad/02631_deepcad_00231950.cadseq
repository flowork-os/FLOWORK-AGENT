import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, 0.000000, 0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.043593, -0.214249), (0.137664, -0.336513)).lineTo(0.695970, -0.336513).threePointArc((0.683143, 0.085771), (0.390049, 0.390049)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.137664, -0.137664).circle(0.099424)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
