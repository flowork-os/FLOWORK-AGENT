# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00248326" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.521053).lineTo(0.000000, 0.521053).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.031579, 0.355263).circle(0.007895)
loop2=wp_sketch0.moveTo(0.055263, 0.228947).circle(0.007895)
loop3=wp_sketch0.moveTo(0.126316, 0.300000).lineTo(0.126316, 0.126316).lineTo(0.481579, 0.126316).lineTo(0.481579, 0.426316).lineTo(0.078947, 0.426316).lineTo(0.078947, 0.300000).close()
loop4=wp_sketch0.moveTo(0.410526, 0.442105).circle(0.007895)
loop5=wp_sketch0.moveTo(0.568421, 0.102632).circle(0.007895)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
