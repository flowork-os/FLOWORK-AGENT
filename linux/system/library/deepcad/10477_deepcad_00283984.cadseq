# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.009786, 0.000000).lineTo(0.009786, 0.132812).lineTo(0.000000, 0.132812).lineTo(0.000000, 0.000000).close()
