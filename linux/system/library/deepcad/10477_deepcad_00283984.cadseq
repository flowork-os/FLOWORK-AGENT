loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.002601, -0.006280), (0.008882, -0.008882)).lineTo(0.105099, -0.008882).threePointArc((0.111379, -0.006280), (0.113980, 0.000000)).lineTo(0.113980, 0.131743).threePointArc((0.111379, 0.138024), (0.105099, 0.140625)).lineTo(0.008882, 0.140625).threePointArc((0.002601, 0.138024), (0.000000, 0.131743)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.009622, -0.003985), (0.019243, 0.000000)).lineTo(0.051809, 0.000000).lineTo(0.062171, 0.000000).lineTo(0.094737, 0.000000).threePointArc((0.101757, 0.002295), (0.105099, 0.008882)).lineTo(0.105099, 0.121382).threePointArc((0.102064, 0.128709), (0.094737, 0.131743)).lineTo(0.062171, 0.131743).lineTo(0.051809, 0.131743).lineTo(0.019243, 0.131743).threePointArc((0.011916, 0.128709), (0.008882, 0.121382)).lineTo(0.008882, 0.008882).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.750000)
