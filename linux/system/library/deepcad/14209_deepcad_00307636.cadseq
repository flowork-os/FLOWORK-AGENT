import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, -0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.279934, 0.000000).lineTo(0.279934, 0.079441).lineTo(0.200493, 0.079441).lineTo(0.200493, 0.279934).lineTo(0.279934, 0.279934).lineTo(0.279934, 0.359375).lineTo(0.000000, 0.359375).lineTo(0.000000, 0.279934).lineTo(0.079441, 0.279934).lineTo(0.079441, 0.079441).lineTo(0.000000, 0.079441).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.242188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
