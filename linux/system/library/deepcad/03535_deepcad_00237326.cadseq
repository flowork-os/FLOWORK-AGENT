import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.622368, -0.173684).lineTo(0.492105, -0.738158).lineTo(0.839474, -0.159211).lineTo(1.346053, -0.492105).lineTo(1.085526, 0.000000).lineTo(1.375000, 0.390789).lineTo(0.911842, 0.275000).lineTo(0.550000, 0.694737).lineTo(0.492105, 0.260526).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.226562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
