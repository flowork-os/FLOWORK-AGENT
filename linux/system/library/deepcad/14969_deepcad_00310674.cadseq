# workplane for sketch 6
wp_sketch6 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch6.moveTo(0.000000, 0.000000).threePointArc((0.107344, -0.026599), (0.189474, -0.100658)).lineTo(0.420395, -0.450000).lineTo(0.562500, -0.450000).lineTo(0.562500, 0.000000).lineTo(0.000000, 0.000000).close()
