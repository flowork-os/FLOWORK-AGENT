# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, 0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch5.moveTo(0.142105, 0.000000).lineTo(0.373026, 0.349342).threePointArc((0.455156, 0.423401), (0.562500, 0.450000)).lineTo(0.000000, 0.450000).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop6).extrude(-0.445312)
