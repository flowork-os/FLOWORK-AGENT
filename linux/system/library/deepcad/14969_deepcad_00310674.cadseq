loop3=wp_sketch3.moveTo(0.835938, 0.000000).lineTo(0.835938, 0.387171).lineTo(0.000000, 0.387171).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.431168, 0.193586).circle(0.043997)
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.750000)
