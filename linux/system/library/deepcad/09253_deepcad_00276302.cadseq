wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.036455, 0.124459), (0.157895, 0.078947)).threePointArc((0.230419, 0.297597), (0.378947, 0.473684)).threePointArc((0.407507, 0.589645), (0.521053, 0.552632)).threePointArc((0.750000, 0.596713), (0.978947, 0.552632)).threePointArc((1.092493, 0.589645), (1.121053, 0.473684)).threePointArc((1.266856, 0.304789), (1.342105, 0.094737)).threePointArc((1.445351, 0.000000), (1.342105, -0.094737)).threePointArc((1.266856, -0.304789), (1.121053, -0.473684)).threePointArc((1.084598, -0.598143), (0.963158, -0.552632)).threePointArc((0.750000, -0.593673), (0.536842, -0.552632)).threePointArc((0.415402, -0.598143), (0.378947, -0.473684)).threePointArc((0.230419, -0.297597), (0.157895, -0.078947)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.398438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.125000, -0.062500).threePointArc((0.143712, -0.234627), (0.225000, -0.387500)).threePointArc((0.340642, -0.361579), (0.375000, -0.475000)).threePointArc((0.593750, -0.517118), (0.812500, -0.475000)).threePointArc((0.846858, -0.361579), (0.962500, -0.387500)).threePointArc((1.109910, -0.220946), (1.187500, -0.012500)).threePointArc((1.095741, 0.087500), (1.187500, 0.187500)).threePointArc((1.109910, 0.395946), (0.962500, 0.562500)).threePointArc((0.852664, 0.530329), (0.812500, 0.637500)).threePointArc((0.587500, 0.680822), (0.362500, 0.637500)).threePointArc((0.334392, 0.529885), (0.225000, 0.550000)).threePointArc((0.076398, 0.384161), (0.000000, 0.175000)).threePointArc((0.081283, 0.087500), (0.000000, 0.000000)).close()
