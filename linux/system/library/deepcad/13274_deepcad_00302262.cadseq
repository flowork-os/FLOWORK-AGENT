wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, -0.554688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.304688, 0.000000).lineTo(1.263487, 0.260937).threePointArc((1.256030, 0.274376), (1.249753, 0.288405)).lineTo(1.249753, 0.549342).threePointArc((1.044608, 1.044608), (0.549342, 1.249753)).lineTo(0.288405, 1.249753).threePointArc((0.274376, 1.256030), (0.260937, 1.263487)).lineTo(0.000000, 1.304688).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.351562)
