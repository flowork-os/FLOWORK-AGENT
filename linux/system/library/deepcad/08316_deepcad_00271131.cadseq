# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, 0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.376234, -0.090296).lineTo(0.767516, -0.090296).lineTo(1.023355, -0.045148).lineTo(1.234046, 0.060197).lineTo(1.429688, 0.285938).lineTo(1.128701, 0.361184).lineTo(0.677220, 0.406332).lineTo(0.210691, 0.331086).lineTo(0.000000, 0.180592).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.390625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
