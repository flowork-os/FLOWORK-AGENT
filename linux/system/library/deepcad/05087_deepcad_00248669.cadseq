loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.015897, -0.038379), (0.054276, -0.054276)).lineTo(1.099095, -0.054276).threePointArc((1.130690, -0.035569), (1.139803, 0.000000)).lineTo(1.139803, 1.234786).threePointArc((1.130690, 1.270355), (1.099095, 1.289062)).lineTo(0.054276, 1.289062).threePointArc((0.015897, 1.273165), (0.000000, 1.234786)).lineTo(0.000000, 0.000000).close()
