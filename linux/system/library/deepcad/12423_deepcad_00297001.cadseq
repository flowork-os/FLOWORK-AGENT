# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297001" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.663158, 0.000000).threePointArc((0.746053, 0.082895), (0.663158, 0.165789)).lineTo(0.000000, 0.165789).threePointArc((-0.082895, 0.082895), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.086842).circle(0.031579)
loop2=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.075490, -0.036900), (0.110526, 0.039474)).lineTo(0.560526, 0.039474).threePointArc((0.598947, 0.086746), (0.552632, 0.126316)).lineTo(0.110526, 0.126316).close()
loop3=wp_sketch0.moveTo(0.663158, 0.086842).circle(0.031579)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
