# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00303876" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.289062, -0.054688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.460938, 0.082484).lineTo(0.460938, 0.194079).lineTo(0.000000, 0.189227).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.164967, 0.067928).lineTo(0.164967, 0.155263).lineTo(0.038816, 0.150411).lineTo(0.038816, 0.043668).close()
loop2=wp_sketch0.moveTo(0.291118, 0.087336).lineTo(0.422122, 0.111595).lineTo(0.422122, 0.155263).lineTo(0.291118, 0.155263).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
