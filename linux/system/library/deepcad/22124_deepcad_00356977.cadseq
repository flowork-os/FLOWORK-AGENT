# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00356977" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.000000, 0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.023438, -0.004194).threePointArc((0.011770, -0.001809), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.257812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.000000, -0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.015711, 0.002317), (0.031250, 0.005592)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.257812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.359375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.197368, 0.000000).circle(0.193257)
loop3=wp_sketch2.moveTo(0.197368, 0.000000).circle(0.148026)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.257812)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.000000, -0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.030839, 0.006168).threePointArc((0.260379, 0.292969), (0.030839, 0.579770)).lineTo(0.006168, 0.585938).threePointArc((-0.328239, 0.296456), (0.000000, 0.000000)).close()
loop5=wp_sketch3.moveTo(-0.191201, 0.240543).threePointArc((-0.037007, 0.127645), (0.117188, 0.240543)).lineTo(0.160362, 0.240543).lineTo(0.160362, 0.339227).lineTo(0.117188, 0.339227).threePointArc((-0.037007, 0.452125), (-0.191201, 0.339227)).lineTo(-0.234375, 0.339227).lineTo(-0.234375, 0.240543).close()
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.257812)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
