# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00243083" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.019077, -0.046055), (0.065132, -0.065132)).lineTo(0.434211, -0.065132).threePointArc((0.480266, -0.046055), (0.499342, 0.000000)).lineTo(0.499342, 0.687500).lineTo(0.000000, 0.687500).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.125000, 0.125000, 0.125000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.248684, 0.000000).lineTo(0.248684, 0.248684).threePointArc((0.124342, 0.373026), (0.000000, 0.248684)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.125000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.250000, 0.750000, 0.125000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.250000, 0.000000).lineTo(0.250000, 0.250000).lineTo(0.126316, 0.250000).lineTo(0.126316, 0.126316).threePointArc((0.089319, 0.036997), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(-0.125000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.500000, 0.750000, 0.125000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.250000, 0.000000).threePointArc((0.161997, 0.037542), (0.126316, 0.126316)).lineTo(0.126316, 0.250000).threePointArc((0.037542, 0.214319), (0.000000, 0.126316)).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.125000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
