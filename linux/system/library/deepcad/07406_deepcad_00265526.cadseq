loop4=wp_sketch1.moveTo(0.064145, 0.256579).circle(0.010691)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).extrude(-0.023438)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.710938, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.007895, 0.000000).circle(0.007895)
solid2=wp_sketch2.add(loop5).extrude(-0.164062)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.703125, -0.281250, 0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.023684, 0.000000).circle(0.023191)
solid3=wp_sketch3.add(loop6).extrude(-0.164062)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.703125, -0.281250, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch4.moveTo(0.023684, 0.000000).circle(0.023191)
solid4=wp_sketch4.add(loop7).extrude(-0.164062)
