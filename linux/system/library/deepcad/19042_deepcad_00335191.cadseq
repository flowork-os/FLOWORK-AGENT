wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.019737, 0.000000).threePointArc((0.094737, 0.037752), (0.169737, 0.000000)).lineTo(0.187500, 0.000000).lineTo(0.187500, 0.019737).threePointArc((0.149748, 0.094737), (0.187500, 0.169737)).lineTo(0.187500, 0.187500).lineTo(0.122368, 0.187500).threePointArc((0.093750, 0.158882), (0.065132, 0.187500)).lineTo(0.000000, 0.187500).lineTo(0.000000, 0.169737).threePointArc((0.037752, 0.094737), (0.000000, 0.019737)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

