# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00250827" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, -0.492188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.984375, 0.000000).lineTo(0.984375, 0.984375).lineTo(0.000000, 0.984375).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.497368, 0.497368).circle(0.310855)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.367188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, -0.718750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(1.468750, 0.000000).lineTo(1.468750, 1.468750).lineTo(0.000000, 1.468750).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(1.221382, 0.231908).lineTo(1.221382, 1.205921).lineTo(0.247368, 1.205921).lineTo(0.247368, 0.231908).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.492188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
