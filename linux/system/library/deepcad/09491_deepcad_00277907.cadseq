loop8=wp_sketch4.moveTo(0.000000, 0.075493).lineTo(0.398438, 0.075493).lineTo(0.398438, -0.012582).threePointArc((0.249076, -0.051710), (0.138405, -0.159375)).threePointArc((-0.039633, -0.174203), (0.000000, 0.000000)).close()
