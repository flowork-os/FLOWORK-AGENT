loop6=wp_sketch3.moveTo(0.211678, -0.160362).lineTo(0.211678, -0.250164).lineTo(0.609375, -0.250164).lineTo(0.609375, -0.160362).lineTo(0.166776, 0.205263).threePointArc((-0.021794, 0.188092), (0.000000, 0.000000)).close()
loop7=wp_sketch3.moveTo(0.076974, 0.109046).circle(0.064145)
