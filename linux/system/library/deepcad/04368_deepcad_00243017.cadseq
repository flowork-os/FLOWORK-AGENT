# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00243017" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.484375, -0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.960938, 0.000000).lineTo(0.960938, 0.718174).lineTo(0.000000, 0.718174).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.485526, 0.040461).lineTo(0.920477, 0.040461).lineTo(0.920477, 0.677714).lineTo(0.485526, 0.677714).lineTo(0.040461, 0.677714).lineTo(0.040461, 0.040461).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
