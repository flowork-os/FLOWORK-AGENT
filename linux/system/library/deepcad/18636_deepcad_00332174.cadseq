wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, -0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.203125, 0.000000).lineTo(1.203125, 0.303947).lineTo(0.975164, 0.303947).threePointArc((0.926061, 0.322277), (0.899178, 0.367270)).threePointArc((0.612836, 0.600921), (0.316612, 0.379934)).threePointArc((0.272173, 0.323114), (0.202632, 0.303947)).lineTo(0.000000, 0.303947).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.607895, 0.303947).circle(0.151974)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
