# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00292139" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.000000, 0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.043668, 0.000000).circle(0.043668)
loop1=wp_sketch0.moveTo(1.237253, -0.145559).threePointArc((1.382812, 0.000000), (1.237253, 0.145559)).lineTo(0.043668, 0.145559).threePointArc((0.189227, 0.000000), (0.043668, -0.145559)).close()
loop2=wp_sketch0.moveTo(1.033470, -0.072780).threePointArc((1.106250, 0.000000), (1.033470, 0.072780)).lineTo(0.247451, 0.072780).threePointArc((0.320230, 0.000000), (0.247451, -0.072780)).close()
loop3=wp_sketch0.moveTo(1.237253, 0.000000).circle(0.043668)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.046875, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
