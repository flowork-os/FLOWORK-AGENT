# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00246036" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.101562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.128043, 0.000000).lineTo(0.128043, -0.483717).lineTo(0.754030, -0.483717).lineTo(0.754030, -0.611760).lineTo(1.351562, -0.611760).lineTo(1.351562, -0.156497).lineTo(0.369901, 0.099589).lineTo(0.000000, 0.099589).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.123931, -0.384128).circle(0.099589)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.710938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.126316).lineTo(0.126316, 0.126316).lineTo(0.126316, 0.607895).lineTo(0.000000, 0.607895).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.132812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
