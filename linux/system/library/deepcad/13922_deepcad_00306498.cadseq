# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306498" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.086842, 0.000000).lineTo(0.086842, -0.086842).lineTo(0.584211, -0.086842).lineTo(0.584211, 0.086842).lineTo(0.750000, 0.086842).lineTo(0.750000, 0.165789).lineTo(0.584211, 0.165789).lineTo(0.584211, 0.331579).lineTo(0.000000, 0.331579).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.414062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.250000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.580510, 0.000000).lineTo(0.580510, -0.163734).lineTo(0.744243, -0.163734).lineTo(0.744243, -0.253043).lineTo(1.414062, -0.253043).lineTo(1.414062, -0.089309).lineTo(0.669819, 0.416776).lineTo(0.253043, 0.416776).lineTo(0.000000, 0.416776).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.253043, 0.253043).circle(0.089309)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.335938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
