# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00263484" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.421875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.054687, 0.000000).lineTo(0.054687, 0.054687).lineTo(0.000000, 0.054687).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.093750, 0.000000).lineTo(0.093750, 0.093750).lineTo(0.000000, 0.093750).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.075987, 0.017763).lineTo(0.075987, 0.075987).lineTo(0.017763, 0.075987).lineTo(0.017763, 0.017763).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.187500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.406250, 0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.018092, 0.000000).lineTo(0.018092, 0.156250).lineTo(0.000000, 0.156250).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.039062)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.406250, 0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.018092, 0.000000).lineTo(0.018092, 0.156250).lineTo(0.000000, 0.156250).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(-0.039062)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.429688, 0.226562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.039062, 0.000000).lineTo(0.039062, 0.039062).lineTo(0.000000, 0.039062).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop5).extrude(-0.007812)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
