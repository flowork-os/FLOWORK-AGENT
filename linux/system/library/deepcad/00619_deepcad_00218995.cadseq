# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00218995" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, -0.734375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.234375, -0.015625).threePointArc((0.381827, 0.732920), (0.250000, 1.484375)).lineTo(0.000000, 1.484375).threePointArc((0.138184, 0.742188), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.742188, 0.085938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.009015, -0.021656), (0.017763, -0.043421)).lineTo(0.187500, -0.043421).lineTo(0.173684, -0.005921).lineTo(0.142105, -0.003947).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.039062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, -0.734375, 0.085938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.119408, -0.009046).lineTo(0.153783, -0.010855).lineTo(0.171875, 0.037993).lineTo(0.018092, 0.045230).threePointArc((0.008907, 0.022671), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.039062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, -0.695312, 0.085938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.073602, 0.000000).threePointArc((0.202288, 0.697942), (0.088322, 1.398438)).lineTo(0.000000, 1.398438).threePointArc((0.121326, 0.699219), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(-0.429688)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
