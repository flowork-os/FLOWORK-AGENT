# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257564" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.414062, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.931250, 0.000000).threePointArc((1.164062, 0.232813), (0.931250, 0.465625)).lineTo(0.624918, 0.465625).lineTo(0.624918, 0.392105).lineTo(0.306332, 0.392105).lineTo(0.306332, 0.465625).lineTo(0.000000, 0.465625).threePointArc((-0.232813, 0.232813), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.232813).circle(0.098026)
loop2=wp_sketch0.moveTo(0.931250, 0.232813).circle(0.098026)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.390625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
