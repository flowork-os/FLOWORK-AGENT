# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00291071" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.236842, 0.000000).circle(0.236842)
loop1=wp_sketch0.moveTo(0.236842, 0.000000).circle(0.138158)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.421875, 0.000000).threePointArc((0.326875, 0.188734), (0.421875, 0.377467)).lineTo(0.000000, 0.377467).threePointArc((-0.188734, 0.188734), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.000000, 0.186513).circle(0.071053)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.187500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.140625, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.400905, 0.000000).threePointArc((0.589021, 0.188117), (0.400905, 0.376234)).lineTo(0.000000, 0.376234).threePointArc((0.094690, 0.188117), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.400905, 0.117188).threePointArc((0.471834, 0.188117), (0.400905, 0.259046)).lineTo(0.191201, 0.259046).threePointArc((0.120271, 0.188117), (0.191201, 0.117188)).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.187500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.142105, 0.000000).circle(0.139145)
loop7=wp_sketch3.moveTo(0.142105, 0.000000).circle(0.094737)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.187500)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
