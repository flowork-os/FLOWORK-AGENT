# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00378826" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.263158, 0.000000).lineTo(1.263158, 0.047368).lineTo(0.536842, 0.047368).lineTo(0.536842, 0.063158).lineTo(1.500000, 0.063158).lineTo(1.500000, 0.110526).lineTo(0.536842, 0.110526).lineTo(0.536842, 0.126316).lineTo(1.263158, 0.126316).lineTo(1.263158, 0.173684).lineTo(0.000000, 0.173684).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.507812, -0.023438, 0.023438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.242188, 0.000000).lineTo(0.242188, 0.048438).lineTo(0.000000, 0.048438).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.023438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.632812, -0.023438, 0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.007895, 0.000000).circle(0.007895)
solid2=wp_sketch2.add(loop2).extrude(-0.148438)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
