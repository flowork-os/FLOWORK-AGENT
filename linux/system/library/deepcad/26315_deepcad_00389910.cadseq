# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00389910" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.429688, 0.000000).lineTo(0.812664, 0.285938).threePointArc((0.752467, 0.246775), (0.692270, 0.285938)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.053454, 0.090296).lineTo(0.752467, 0.240789).lineTo(0.421382, 0.090296).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.468750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.023766, 0.009786).threePointArc((0.063986, 0.069257), (0.102056, 0.008388)).lineTo(0.125822, -0.002796).threePointArc((0.065060, 0.095303), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.468750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.061644, -0.041976), (0.125000, -0.002632)).lineTo(0.101316, 0.009211).threePointArc((0.062072, -0.015384), (0.023684, 0.010526)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.046875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
