# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.585938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.050871, -0.122813), (0.173684, -0.173684)).lineTo(1.326316, -0.173684).threePointArc((1.449129, -0.122813), (1.500000, 0.000000)).lineTo(1.500000, 1.168421).threePointArc((1.445859, 1.283340), (1.326316, 1.326316)).lineTo(0.173684, 1.326316).threePointArc((0.054141, 1.283340), (0.000000, 1.168421)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.250000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
