import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.218750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.218670, -0.223931), (0.013158, -0.434211)).threePointArc((0.127285, -0.450047), (0.223684, -0.513158)).threePointArc((0.532895, -0.645706), (0.842105, -0.513158)).threePointArc((0.932686, -0.453424), (1.039474, -0.434211)).threePointArc((1.256579, -0.217105), (1.039474, 0.000000)).threePointArc((0.932686, 0.019214), (0.842105, 0.078947)).threePointArc((0.542199, 0.210880), (0.236842, 0.092105)).threePointArc((0.127288, 0.023252), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, -0.210526).circle(0.092105)
loop2=wp_sketch0.moveTo(0.539474, -0.210526).circle(0.302632)
loop3=wp_sketch0.moveTo(1.039474, -0.210526).circle(0.092105)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.171875)
solid=solid0

