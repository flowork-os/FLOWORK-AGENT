import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.476562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.332895, 0.000000).lineTo(0.694737, 0.000000).threePointArc((0.807316, -0.046632), (0.853947, -0.159211)).lineTo(0.853947, -0.217105).lineTo(1.375000, -0.217105).lineTo(1.375000, 0.767105).lineTo(1.375000, 0.926316).lineTo(0.000000, 0.926316).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.332895, 0.202632).circle(0.115789)
loop2=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.504441, 0.082915), (0.477632, 0.593421)).threePointArc((0.492105, 0.591906), (0.506579, 0.593421)).lineTo(1.186842, 0.593421).threePointArc((1.276610, 0.688347), (1.172368, 0.767105)).lineTo(0.506579, 0.767105).threePointArc((0.492105, 0.768621), (0.477632, 0.767105)).close()
loop3=wp_sketch0.moveTo(1.114474, 0.144737).circle(0.217105)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.273438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
