# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00235960" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.000000, -0.257812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.007812, 0.000000).lineTo(1.007812, 1.007812).lineTo(0.000000, 1.007812).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.084868, 0.084868).circle(0.010609)
loop2=wp_sketch0.moveTo(0.084868, 0.922944).circle(0.010609)
loop3=wp_sketch0.moveTo(0.509211, 0.509211).circle(0.010609)
loop4=wp_sketch0.moveTo(0.922944, 0.084868).circle(0.010609)
loop5=wp_sketch0.moveTo(0.922944, 0.922944).circle(0.010609)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
