# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00365668" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.509211, 0.000000).circle(0.509211)
solid0=wp_sketch0.add(loop0).extrude(-0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.678947, 0.000000).circle(0.678947)
loop2=wp_sketch1.moveTo(0.678947, 0.000000).circle(0.466776)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.453125)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.679688, 0.750000, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.686842, 0.000000).circle(0.672533)
loop4=wp_sketch2.moveTo(0.686842, 0.000000).circle(0.500822)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.148438)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.507812, 0.750000, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.509211, 0.000000).circle(0.509211)
loop6=wp_sketch3.moveTo(0.509211, 0.000000).circle(0.456168)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(-0.148438)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
