# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, -0.703125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch2.moveTo(0.039474, 0.000000).circle(0.038651)
solid2=wp_sketch2.add(loop6).extrude(0.023438, both=True)
solid=solid.union(solid2)

