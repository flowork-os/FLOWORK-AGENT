import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, -0.726562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.053536, -0.002630), (0.107072, 0.000000)).threePointArc((0.129994, -0.005011), (0.147862, 0.010197)).threePointArc((0.334255, 0.085525), (0.484375, 0.219243)).threePointArc((0.470939, 0.256794), (0.433388, 0.270230)).threePointArc((0.439830, 0.251868), (0.448684, 0.234539)).threePointArc((0.313146, 0.110155), (0.142763, 0.040789)).threePointArc((0.119683, 0.046432), (0.101974, 0.030592)).threePointArc((0.053411, 0.030762), (0.005099, 0.035691)).threePointArc((-0.090134, 0.031086), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.045888, 0.025493).circle(0.040789)
loop2=wp_sketch0.moveTo(0.127467, 0.020395).circle(0.015296)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, -0.726562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.053536, -0.002630), (0.107072, 0.000000)).threePointArc((0.129994, -0.005011), (0.147862, 0.010197)).threePointArc((0.334255, 0.085525), (0.484375, 0.219243)).threePointArc((0.470939, 0.256794), (0.433388, 0.270230)).threePointArc((0.439830, 0.251868), (0.448684, 0.234539)).threePointArc((0.313146, 0.110155), (0.142763, 0.040789)).threePointArc((0.119683, 0.046432), (0.101974, 0.030592)).threePointArc((0.053411, 0.030762), (0.005099, 0.035691)).threePointArc((-0.090134, 0.031086), (0.000000, 0.000000)).close()
loop4=wp_sketch1.moveTo(-0.045888, 0.025493).circle(0.040789)
