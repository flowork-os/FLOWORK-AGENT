# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306573" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.000000, 0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.372697, 0.000000).lineTo(0.372697, -0.110115).lineTo(0.482813, -0.110115).lineTo(0.482813, -0.160938).lineTo(0.372697, -0.160938).lineTo(0.372697, -0.271053).lineTo(0.804688, -0.271053).lineTo(0.804688, -0.110115).lineTo(0.431990, 0.271053).lineTo(0.000000, 0.271053).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.160938, 0.160938).circle(0.050822)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.210938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.056086, 0.000000).lineTo(0.056086, -0.056086).lineTo(0.377303, -0.056086).lineTo(0.377303, 0.056086).lineTo(0.484375, 0.056086).lineTo(0.484375, 0.107072).lineTo(0.377303, 0.107072).lineTo(0.377303, 0.214145).lineTo(0.000000, 0.214145).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.484375)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
