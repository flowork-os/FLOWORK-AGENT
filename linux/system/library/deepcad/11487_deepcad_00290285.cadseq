# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00290285" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.601562, -0.148438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.148438, 0.148438), (0.000000, 0.296875)).lineTo(0.000000, 0.193750).threePointArc((0.045313, 0.148438), (0.000000, 0.103125)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.601562, -0.148438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.103125).threePointArc((-0.045313, 0.148438), (0.000000, 0.193750)).lineTo(0.000000, 0.296875).threePointArc((-0.148438, 0.148438), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.093750)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.601562, -0.148438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(1.203125, 0.000000).lineTo(1.203125, 0.101316).threePointArc((1.158799, 0.145641), (1.203125, 0.189967)).lineTo(1.203125, 0.303947).lineTo(0.000000, 0.303947).lineTo(0.000000, 0.189967).threePointArc((0.044326, 0.145641), (0.000000, 0.101316)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(1.000493, 0.075987).threePointArc((1.076480, 0.151974), (1.000493, 0.227961)).lineTo(0.202632, 0.227961).threePointArc((0.126645, 0.151974), (0.202632, 0.075987)).close()
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.093750)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
