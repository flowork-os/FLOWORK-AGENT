# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00376447" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.505263).lineTo(0.000000, 0.505263).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.405263, 0.094737).lineTo(1.405263, 0.252632).lineTo(1.247368, 0.410526).lineTo(0.252632, 0.410526).lineTo(0.094737, 0.252632).lineTo(0.094737, 0.094737).close()
loop2=wp_sketch0.moveTo(0.126316, 0.378947).circle(0.015789)
loop3=wp_sketch0.moveTo(1.373684, 0.378947).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
