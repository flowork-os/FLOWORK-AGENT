# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322014" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.703125, 0.546875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.244737, -0.642434).lineTo(1.453125, -0.520066).lineTo(1.177796, 0.198849).lineTo(1.131908, 0.183553).lineTo(1.391941, -0.474178).lineTo(0.275329, -0.596546).lineTo(0.045888, 0.015296).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.226562, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.578125, 0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -0.932993, -0.359895)))
loop1=wp_sketch1.moveTo(0.023684, 0.000000).circle(0.023684)
solid1=wp_sketch1.add(loop1).extrude(-0.601562)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -0.098017, 0.995185)))
loop2=wp_sketch2.moveTo(0.023684, 0.000000).circle(0.023684)
solid2=wp_sketch2.add(loop2).extrude(-0.601562)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.023438, -0.546875, 0.289062), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 0.932993, 0.359895)))
loop3=wp_sketch3.moveTo(0.023684, 0.000000).circle(0.023684)
solid3=wp_sketch3.add(loop3).extrude(-0.601562)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
