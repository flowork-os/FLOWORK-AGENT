wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, -0.468750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.051316, 0.000000).lineTo(0.051316, 1.103289).threePointArc((0.090354, 1.169008), (0.166776, 1.167434)).threePointArc((0.188481, 1.138912), (0.192434, 1.103289)).threePointArc((0.211678, 1.081256), (0.230921, 1.103289)).threePointArc((0.232423, 1.116118), (0.230921, 1.128947)).threePointArc((0.104256, 1.216958), (0.000000, 1.103289)).lineTo(0.000000, 0.000000).close()
