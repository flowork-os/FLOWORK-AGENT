# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00384040" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, 0.000000, -0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.515625, 0.000000).lineTo(0.515625, 0.488487).lineTo(0.000000, 0.488487).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.617188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, -0.617188, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.113487, -0.182566).lineTo(0.409539, -0.182566).lineTo(0.468750, -0.069079).lineTo(0.449013, -0.069079).lineTo(0.370066, 0.083882).lineTo(0.458882, 0.212171).lineTo(0.399671, 0.305921).lineTo(0.103618, 0.305921).lineTo(0.000000, 0.108553).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.132812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
