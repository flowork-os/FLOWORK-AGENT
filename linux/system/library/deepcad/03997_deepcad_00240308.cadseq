# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00240308" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.898438, 0.000000).lineTo(0.898438, 0.075658).lineTo(0.000000, 0.075658).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.898438, 0.000000).lineTo(0.898438, 0.075658).lineTo(0.000000, 0.075658).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.078125, 0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.898438, 0.000000).lineTo(0.898438, 0.671464).lineTo(0.000000, 0.671464).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.245888, 0.302632).circle(0.141859)
loop4=wp_sketch2.moveTo(0.529605, 0.302632).circle(0.066201)
loop5=wp_sketch2.moveTo(0.747122, 0.075658).circle(0.047286)
loop6=wp_sketch2.moveTo(0.747122, 0.510691).circle(0.047286)
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).extrude(-0.078125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
