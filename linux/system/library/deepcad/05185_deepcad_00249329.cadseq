# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00249329" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.442105, -0.300000).lineTo(0.631579, -0.410526).lineTo(0.868421, -0.410526).lineTo(1.057895, -0.300000).lineTo(1.168421, -0.110526).lineTo(1.168421, 0.110526).lineTo(1.057895, 0.300000).lineTo(0.868421, 0.410526).lineTo(0.631579, 0.410526).lineTo(0.442105, 0.300000).lineTo(0.331579, 0.110526).lineTo(0.331579, -0.110526).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
