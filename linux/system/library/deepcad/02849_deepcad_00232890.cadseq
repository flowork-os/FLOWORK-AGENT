import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, -0.648438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.221793, 0.000000).lineTo(1.221793, 0.500493).lineTo(1.118750, 0.736020).lineTo(1.118750, 0.912664).lineTo(1.280674, 1.045148).lineTo(1.280674, 1.398438).lineTo(0.971546, 1.398438).lineTo(0.691859, 1.148191).lineTo(0.235526, 1.148191).lineTo(0.000000, 0.588816).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
