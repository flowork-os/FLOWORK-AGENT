import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.282237, -0.445066).lineTo(0.738158, -0.445066).lineTo(1.031250, 0.000000).lineTo(0.510197, 0.944408).lineTo(0.000000, 0.000000).close()
