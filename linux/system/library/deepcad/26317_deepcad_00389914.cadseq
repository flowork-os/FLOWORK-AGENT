solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.250411, -0.397204).lineTo(0.431743, -0.397204).lineTo(0.440378, -0.397204).lineTo(0.440378, -0.328125).lineTo(0.656250, 0.077714).lineTo(0.449013, 0.699424).lineTo(0.440378, 0.708059).lineTo(0.431743, 0.699424).lineTo(0.423109, -0.328125).lineTo(0.224507, 0.077714).lineTo(0.431743, 0.708059).lineTo(0.431743, 0.820313).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.388569, -0.310855).lineTo(0.397204, -0.310855).lineTo(0.397204, -0.293586).lineTo(0.181332, 0.086349).lineTo(0.051809, -0.025905).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.054688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.054688, -0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.335526, 0.285197).lineTo(0.209704, 0.398438).lineTo(0.000000, 0.000000).close()
