# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.335938, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.030437, 0.050781), (0.000000, 0.101562)).lineTo(0.000000, 0.053454).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.273438, 0.000000, 0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.062500, -0.044737).lineTo(0.062500, 0.004605).threePointArc((0.030582, 0.011365), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.273438, 0.000000, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.030230, -0.012979), (0.062500, -0.006579)).lineTo(0.062500, 0.044737).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.046875)
