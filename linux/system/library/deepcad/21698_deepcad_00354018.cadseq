# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.548684, 0.000000).lineTo(1.017352, 0.342928).lineTo(1.085938, 0.388651).lineTo(1.028783, 0.434375).lineTo(0.548684, 0.777303).lineTo(0.000000, 0.777303).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch3.moveTo(0.548684, 0.137171).lineTo(0.548684, 0.651563).lineTo(0.125740, 0.651563).lineTo(0.125740, 0.137171).close()
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.046875)
