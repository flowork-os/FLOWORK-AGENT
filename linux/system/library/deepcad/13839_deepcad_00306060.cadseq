loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001445, -0.003489), (0.004934, -0.004934)).lineTo(0.073191, -0.004934).threePointArc((0.076680, -0.003489), (0.078125, 0.000000)).lineTo(0.078125, 0.068257).threePointArc((0.076680, 0.071746), (0.073191, 0.073191)).lineTo(0.004934, 0.073191).threePointArc((0.001445, 0.071746), (0.000000, 0.068257)).lineTo(0.000000, 0.000000).close()
