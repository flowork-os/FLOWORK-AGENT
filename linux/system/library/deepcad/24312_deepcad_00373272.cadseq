wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.429688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.160855, 0.000000).threePointArc((0.636719, 0.475863), (1.112582, 0.000000)).lineTo(1.273438, 0.000000).lineTo(1.273438, 1.018750).threePointArc((1.261659, 1.047185), (1.233224, 1.058964)).lineTo(0.040214, 1.058964).threePointArc((0.011778, 1.047185), (0.000000, 1.018750)).lineTo(0.000000, 0.000000).close()
