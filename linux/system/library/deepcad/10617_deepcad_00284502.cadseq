# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284502" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.146382, 0.000000).threePointArc((1.321135, 0.174753), (1.146382, 0.349507)).lineTo(0.000000, 0.349507).threePointArc((-0.174753, 0.174753), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.382812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.554688, 0.000000).threePointArc((0.277344, 0.277344), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(-0.437500, both=True)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, 0.382812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.063158, 0.000000).circle(0.061842)
solid2=wp_sketch2.add(loop2).extrude(-0.875000)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.515625, 0.000000, 0.382812), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.061842, 0.000000).circle(0.061842)
solid3=wp_sketch3.add(loop3).extrude(-0.875000)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.781250, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(1.570312, 0.000000).lineTo(1.570312, 0.033059).lineTo(0.000000, 0.033059).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.437500, both=True)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
