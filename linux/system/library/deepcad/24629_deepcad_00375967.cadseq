solid1=wp_sketch1.add(loop3).add(loop4).extrude(-0.015625)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.156250, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch2.moveTo(0.157895, 0.000000).circle(0.157895)
loop6=wp_sketch2.moveTo(0.157895, 0.000000).circle(0.075658)
solid2=wp_sketch2.add(loop5).add(loop6).extrude(0.148438)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.226562, -0.187500, 0.250000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch3.moveTo(0.083224, 0.000000).threePointArc((0.086208, 0.030304), (0.083224, 0.060609)).lineTo(0.000000, 0.060609).threePointArc((0.006610, 0.030304), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop7).extrude(-0.039062)
