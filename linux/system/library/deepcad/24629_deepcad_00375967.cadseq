import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.156250, -0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.437500, 0.000000).threePointArc((0.593750, 0.156250), (0.437500, 0.312500)).lineTo(0.000000, 0.312500).threePointArc((-0.156250, 0.156250), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.156250).circle(0.075000)
loop2=wp_sketch0.moveTo(0.437500, 0.100000).threePointArc((0.493750, 0.156250), (0.437500, 0.212500)).lineTo(0.343750, 0.212500).threePointArc((0.287500, 0.156250), (0.343750, 0.100000)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.500000, -0.250000, 0.101562), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
