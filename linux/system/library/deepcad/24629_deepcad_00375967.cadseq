# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.187500, 0.250000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch4.moveTo(0.085938, 0.000000).threePointArc((0.079032, 0.031661), (0.085938, 0.063322)).lineTo(0.000000, 0.063322).threePointArc((-0.003118, 0.031661), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop8).extrude(-0.039062)
