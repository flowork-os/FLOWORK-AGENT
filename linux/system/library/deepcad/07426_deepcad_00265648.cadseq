# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00265648" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.000000, 0.000000).lineTo(1.000000, 0.084211).lineTo(0.747368, 0.084211).lineTo(0.747368, 0.336842).lineTo(0.663158, 0.336842).lineTo(0.536842, 0.221053).lineTo(0.536842, 0.136842).lineTo(0.463158, 0.136842).lineTo(0.463158, 0.221053).lineTo(0.336842, 0.336842).lineTo(0.252632, 0.336842).lineTo(0.252632, 0.084211).lineTo(0.000000, 0.084211).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.500000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
