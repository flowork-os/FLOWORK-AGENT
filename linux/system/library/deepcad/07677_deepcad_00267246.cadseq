# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267246" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.111020, -0.115461).lineTo(0.111020, -0.226480).lineTo(0.306414, -0.226480).lineTo(0.306414, -0.066612).lineTo(0.421875, -0.022204).lineTo(0.306414, 0.111020).lineTo(0.115461, 0.111020).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.367188, 0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.020983, -0.051550), (0.072533, -0.072533)).lineTo(0.382813, -0.008059).lineTo(0.382813, 0.221628).lineTo(0.257895, 0.306250).lineTo(0.000000, 0.213569).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.085938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
