wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001951, -0.004710), (0.006661, -0.006661)).lineTo(0.063651, -0.006661).threePointArc((0.068361, -0.004710), (0.070312, 0.000000)).lineTo(0.070312, 0.056990).threePointArc((0.068361, 0.061700), (0.063651, 0.063651)).lineTo(0.006661, 0.063651).threePointArc((0.001951, 0.061700), (0.000000, 0.056990)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.006661, -0.002759), (0.013322, 0.000000)).lineTo(0.056990, 0.000000).threePointArc((0.061700, 0.001951), (0.063651, 0.006661)).lineTo(0.063651, 0.050329).threePointArc((0.061700, 0.055039), (0.056990, 0.056990)).lineTo(0.013322, 0.056990).threePointArc((0.008612, 0.055039), (0.006661, 0.050329)).lineTo(0.006661, 0.006661).close()
