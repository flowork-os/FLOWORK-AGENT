# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00300738" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.648438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.255921, 0.000000).lineTo(1.255921, 1.296875).lineTo(0.000000, 1.296875).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.040954, 0.040954).circle(0.013651)
loop2=wp_sketch0.moveTo(0.040954, 1.255921).circle(0.013651)
loop3=wp_sketch0.moveTo(1.201316, 0.040954).circle(0.013651)
loop4=wp_sketch0.moveTo(1.201316, 1.255921).circle(0.013651)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.023438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.750000, 0.023438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.148438, 0.000000).lineTo(0.148438, 0.098438).lineTo(0.000000, 0.098438).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.148438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.648438, 0.023438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.148438, 0.000000).lineTo(0.148438, 0.098438).lineTo(0.000000, 0.098438).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(0.148438)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
