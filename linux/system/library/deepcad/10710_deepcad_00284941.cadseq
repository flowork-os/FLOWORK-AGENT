# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00284941" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.065461, 0.000000).threePointArc((1.281250, 0.215789), (1.065461, 0.431579)).lineTo(0.000000, 0.431579).threePointArc((-0.215789, 0.215789), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.215789).circle(0.040461)
loop2=wp_sketch0.moveTo(0.890132, 0.148355).threePointArc((0.957566, 0.215789), (0.890132, 0.283224)).lineTo(0.175329, 0.283224).threePointArc((0.107895, 0.215789), (0.175329, 0.148355)).close()
loop3=wp_sketch0.moveTo(1.065461, 0.215789).circle(0.040461)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(1.065461, 0.000000).threePointArc((1.281250, 0.215789), (1.065461, 0.431579)).lineTo(0.000000, 0.431579).threePointArc((-0.215789, 0.215789), (0.000000, 0.000000)).close()
loop5=wp_sketch1.moveTo(0.000000, 0.215789).circle(0.040461)
loop6=wp_sketch1.moveTo(0.890132, 0.148355).threePointArc((0.957566, 0.215789), (0.890132, 0.283224)).lineTo(0.175329, 0.283224).threePointArc((0.107895, 0.215789), (0.175329, 0.148355)).close()
loop7=wp_sketch1.moveTo(1.065461, 0.215789).circle(0.040461)
solid1=wp_sketch1.add(loop4).add(loop5).add(loop6).add(loop7).extrude(0.085938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
