import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.045395, 0.000000).lineTo(0.045395, -0.045395).lineTo(0.264803, -0.045395).lineTo(0.264803, 0.045395).lineTo(0.359375, 0.045395).lineTo(0.359375, 0.094572).lineTo(0.264803, 0.094572).lineTo(0.264803, 0.189145).lineTo(0.000000, 0.189145).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.234375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.750000, 0.000000, 0.046875), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.536842, 0.000000).lineTo(0.536842, 0.050329).lineTo(0.444572, 0.050329).lineTo(0.444572, 0.092270).lineTo(0.536842, 0.092270).lineTo(0.536842, 0.184539).lineTo(0.796875, 0.184539).lineTo(0.796875, 0.419408).lineTo(0.419408, 0.419408).lineTo(0.000000, 0.142599).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.654276, 0.327138).circle(0.050329)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.187500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.312500, 0.000000, 0.093750), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.094572, 0.000000).lineTo(0.094572, -0.045395).lineTo(0.313980, -0.045395).lineTo(0.359375, -0.045395).lineTo(0.359375, 0.139967).lineTo(0.094572, 0.139967).lineTo(0.094572, 0.045395).lineTo(0.000000, 0.045395).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.187500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.750000, 0.187500, 0.046875), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.140625, 0.000000).lineTo(0.140625, 0.234375).lineTo(0.000000, 0.140625).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(-0.125000)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
