# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285659" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, -0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.161349, 0.000000).lineTo(0.161349, 0.197204).lineTo(0.161349, 0.851562).lineTo(0.000000, 0.851562).lineTo(0.000000, 0.197204).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.080674, 0.098602).circle(0.044819)
loop2=wp_sketch0.moveTo(0.080674, 0.421299).circle(0.035855)
loop3=wp_sketch0.moveTo(0.080674, 0.743997).circle(0.035855)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
