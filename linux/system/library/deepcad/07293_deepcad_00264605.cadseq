# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.429688, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.159128, -0.351562).lineTo(0.321957, 0.000000).lineTo(0.262747, 0.044408).lineTo(0.196135, 0.059211).lineTo(0.133224, 0.059211).lineTo(0.059211, 0.048109).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.159128, -0.310855).lineTo(0.299753, -0.003701).lineTo(0.255345, 0.029605).lineTo(0.192434, 0.044408).lineTo(0.133224, 0.044408).lineTo(0.066612, 0.033306).lineTo(0.022204, -0.003701).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
