# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306513" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.375000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.625000, 0.000000).lineTo(0.625000, 0.217105).threePointArc((0.588388, 0.305494), (0.500000, 0.342105)).lineTo(0.125000, 0.342105).threePointArc((0.036612, 0.305494), (0.000000, 0.217105)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.500000, 0.144737).threePointArc((0.575658, 0.220395), (0.500000, 0.296053)).lineTo(0.125000, 0.296053).threePointArc((0.049342, 0.220395), (0.125000, 0.144737)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.085526, 0.000000).lineTo(0.085526, 0.065789).lineTo(0.539474, 0.065789).lineTo(0.539474, 0.000000).lineTo(0.625000, 0.000000).lineTo(0.625000, 0.375000).lineTo(0.000000, 0.375000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.312500, 0.312500, 0.375000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.126316, 0.000000).circle(0.126316)
loop4=wp_sketch2.moveTo(0.126316, 0.000000).circle(0.071053)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.093750)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
