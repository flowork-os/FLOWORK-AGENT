# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00227417" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.296875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.991776, 0.000000).lineTo(0.991776, 1.046875).lineTo(0.000000, 1.046875).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.253454, 0.297533).circle(0.055099)
loop2=wp_sketch0.moveTo(0.495888, 0.793421).circle(0.099178)
loop3=wp_sketch0.moveTo(0.749342, 0.297533).circle(0.055099)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.250000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
