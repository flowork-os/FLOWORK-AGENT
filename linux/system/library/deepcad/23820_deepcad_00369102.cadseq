# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00369102" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.070312, -0.320312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.011266, 0.000000).threePointArc((0.013783, 0.045597), (0.045066, 0.078865)).lineTo(0.045066, 0.619655).threePointArc((0.078865, 0.585855), (0.112664, 0.619655)).lineTo(0.112664, 0.078865).threePointArc((0.138314, 0.043542), (0.135197, 0.000000)).lineTo(0.146464, 0.000000).lineTo(0.146464, 1.070312).lineTo(0.000000, 1.070312).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.070312, 0.687500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.148438, 0.000000).lineTo(0.148438, 0.064063).lineTo(0.000000, 0.064063).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.578125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
