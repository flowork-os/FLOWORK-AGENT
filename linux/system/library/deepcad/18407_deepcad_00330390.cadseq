# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00330390" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.010526).lineTo(0.000000, 1.010526).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.452632, 0.015789).lineTo(1.452632, 0.978947).lineTo(0.047368, 0.978947).lineTo(0.047368, 0.015789).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.351562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.500000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.994737).lineTo(0.000000, 0.994737).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.031250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
