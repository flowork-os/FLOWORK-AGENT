loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.020112, -0.048555), (0.068668, -0.068668)).lineTo(1.236020, -0.068668).threePointArc((1.284575, -0.048555), (1.304688, 0.000000)).lineTo(1.304688, 0.892681).threePointArc((1.284575, 0.941236), (1.236020, 0.961349)).lineTo(0.068668, 0.961349).threePointArc((0.020112, 0.941236), (0.000000, 0.892681)).lineTo(0.000000, 0.000000).close()
