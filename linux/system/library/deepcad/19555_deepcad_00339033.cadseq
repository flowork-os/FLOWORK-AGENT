import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.062500, 0.000000).lineTo(0.062500, 0.003289).threePointArc((0.058839, 0.012128), (0.050000, 0.015789)).lineTo(0.028289, 0.015789).threePointArc((0.019451, 0.019451), (0.015789, 0.028289)).lineTo(0.015789, 0.050000).threePointArc((0.012128, 0.058839), (0.003289, 0.062500)).lineTo(0.000000, 0.062500).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
