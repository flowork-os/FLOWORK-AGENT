# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00227555" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, -0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.695148, 0.175987).threePointArc((0.834151, 0.356373), (0.695148, 0.536760)).lineTo(0.000000, 0.721546).threePointArc((0.278005, 0.360773), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.651151, 0.360773).circle(0.096793)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.281250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.375000, 0.000000).circle(0.367188)
loop3=wp_sketch1.moveTo(0.375000, 0.000000).circle(0.218750)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.554688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
