import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, 0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.009868, -0.937500).lineTo(0.789474, -0.937500).lineTo(0.789474, 0.000000).lineTo(0.621711, 0.108553).lineTo(0.167763, 0.108553).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.394737, -0.187500).circle(0.138158)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.429688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
