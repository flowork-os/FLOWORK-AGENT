# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00239037" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, 0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.123355, -0.123355).lineTo(0.123355, -0.251645).lineTo(0.340461, -0.251645).lineTo(0.340461, -0.074013).lineTo(0.468750, -0.024671).lineTo(0.340461, 0.123355).lineTo(0.123355, 0.123355).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.585938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.022401, -0.054080), (0.076480, -0.076480)).lineTo(0.117270, -0.076480).lineTo(0.484375, -0.035691).lineTo(0.484375, 0.219243).lineTo(0.295724, 0.326316).lineTo(0.000000, 0.219243).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.101562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
