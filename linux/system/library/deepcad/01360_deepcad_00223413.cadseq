loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001686, -0.004071), (0.005757, -0.005757)).lineTo(0.049507, -0.005757).threePointArc((0.053289, -0.003951), (0.054687, 0.000000)).lineTo(0.054687, 0.043750).threePointArc((0.053289, 0.047701), (0.049507, 0.049507)).lineTo(0.005757, 0.049507).threePointArc((0.001686, 0.047821), (0.000000, 0.043750)).lineTo(0.000000, 0.000000).close()
