# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00352545" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.694737, 0.000000).threePointArc((0.773684, 0.078947), (0.852632, 0.000000)).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.426316).lineTo(0.000000, 0.426316).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.221053, 0.205263).circle(0.063158)
loop2=wp_sketch0.moveTo(0.457895, 0.205263).circle(0.063158)
loop3=wp_sketch0.moveTo(1.278947, 0.110526).lineTo(1.278947, 0.300000).lineTo(1.073684, 0.300000).lineTo(1.073684, 0.110526).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.694737, 0.000000).threePointArc((0.773684, 0.078947), (0.852632, 0.000000)).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.426316).lineTo(0.000000, 0.426316).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(0.221053, 0.205263).circle(0.063158)
loop6=wp_sketch1.moveTo(0.457895, 0.205263).circle(0.063158)
loop7=wp_sketch1.moveTo(1.278947, 0.110526).lineTo(1.278947, 0.300000).lineTo(1.073684, 0.300000).lineTo(1.073684, 0.110526).close()
solid1=wp_sketch1.add(loop4).add(loop5).add(loop6).add(loop7).extrude(0.054688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
