wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.148438, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch2.moveTo(0.337500, 0.000000).lineTo(0.450000, -0.328125).lineTo(0.553125, 0.000000).lineTo(0.890625, 0.000000).lineTo(0.618750, 0.196875).lineTo(0.721875, 0.525000).lineTo(0.450000, 0.328125).lineTo(0.168750, 0.525000).lineTo(0.271875, 0.196875).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.156250)
