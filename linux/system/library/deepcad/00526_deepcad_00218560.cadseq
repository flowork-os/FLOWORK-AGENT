import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, -0.492188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.030592, -0.254934).lineTo(0.112171, -0.254934).lineTo(0.132566, 0.000000).lineTo(0.132566, 0.754605).lineTo(0.132566, 0.805592).threePointArc((0.134820, 0.851480), (0.132566, 0.897368)).threePointArc((0.066283, 0.963651), (0.000000, 0.897368)).threePointArc((-0.002254, 0.851480), (0.000000, 0.805592)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.071382, 0.897368).circle(0.030592)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, -0.492188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.030592, -0.254934).lineTo(0.112171, -0.254934).lineTo(0.132566, 0.000000).lineTo(0.132566, 0.754605).lineTo(0.132566, 0.805592).threePointArc((0.134820, 0.851480), (0.132566, 0.897368)).threePointArc((0.066283, 0.963651), (0.000000, 0.897368)).threePointArc((-0.002254, 0.851480), (0.000000, 0.805592)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.071382, 0.897368).circle(0.030592)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.164062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
