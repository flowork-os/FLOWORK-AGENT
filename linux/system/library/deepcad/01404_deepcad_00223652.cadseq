wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.078947).lineTo(0.750000, 0.102632).lineTo(0.750000, 0.181579).lineTo(0.000000, 0.181579).lineTo(0.000000, 0.102632).lineTo(0.000000, 0.078947).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.181579, 0.078947).lineTo(0.181579, 0.102632).lineTo(0.023684, 0.102632).lineTo(0.023684, 0.078947).close()
loop2=wp_sketch0.moveTo(0.339474, 0.078947).lineTo(0.339474, 0.102632).lineTo(0.260526, 0.102632).lineTo(0.260526, 0.078947).close()
loop3=wp_sketch0.moveTo(0.489474, 0.078947).lineTo(0.489474, 0.102632).lineTo(0.410526, 0.102632).lineTo(0.410526, 0.078947).close()
loop4=wp_sketch0.moveTo(0.726316, 0.078947).lineTo(0.726316, 0.102632).lineTo(0.568421, 0.102632).lineTo(0.568421, 0.078947).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.023438)
solid=solid0

