# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00381714" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.140625, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.141118, 0.000000).lineTo(0.275822, 0.000000).lineTo(0.275822, 0.609375).lineTo(0.141118, 0.609375).lineTo(0.000000, 0.609375).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.132977, -0.455921).lineTo(0.158306, -0.455921).lineTo(0.303947, -0.455921).lineTo(0.443257, -0.455921).lineTo(0.468586, -0.455921).lineTo(0.601562, 0.000000).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.132977, -0.246957).lineTo(0.303947, -0.246957).lineTo(0.468586, -0.246957).lineTo(0.531908, -0.050658).lineTo(0.069655, -0.050658).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.101562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.117188, 0.070312, 0.039062), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.226562, 0.000000).lineTo(0.226562, 0.016694).lineTo(0.000000, 0.016694).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-0.179688)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
