# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00293265" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, -0.171875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.296053, 0.000000).lineTo(0.296053, 0.320724).threePointArc((0.148026, 0.468750), (0.000000, 0.320724)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.276316, 0.024671).lineTo(0.276316, 0.320724).threePointArc((0.150493, 0.446546), (0.024671, 0.320724)).lineTo(0.024671, 0.024671).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.253125, 0.000000).lineTo(0.253125, 0.296875).lineTo(0.000000, 0.296875).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, 0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.257812, 0.000000).threePointArc((0.128906, 0.128906), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
