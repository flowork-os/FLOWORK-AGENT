# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00311423" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.066251, -0.114862), (0.198849, -0.115461)).lineTo(0.545230, 0.083388).threePointArc((0.612523, 0.198849), (0.545230, 0.314309)).lineTo(0.198849, 0.506743).threePointArc((0.068094, 0.509352), (0.000000, 0.397697)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.134704, 0.000000).circle(0.057730)
loop2=wp_sketch0.moveTo(0.134704, 0.397697).circle(0.057730)
loop3=wp_sketch0.moveTo(0.474671, 0.198849).circle(0.057730)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(-0.210938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, 0.000000, -0.046875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.209346, -0.574884), (0.324671, -0.276316)).threePointArc((0.347714, -0.198904), (0.421382, -0.165789)).lineTo(0.552632, -0.165789).lineTo(0.552632, 0.000000).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(0.000000, -0.331579).circle(0.193421)
solid1=wp_sketch1.add(loop4).add(loop5).extrude(0.328125, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, -0.632812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch2.moveTo(0.515625, 0.417928).lineTo(0.217105, 0.417928).threePointArc((0.142153, 0.383312), (0.119408, 0.303947)).threePointArc((0.099760, 0.136238), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop6).extrude(0.046875, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
