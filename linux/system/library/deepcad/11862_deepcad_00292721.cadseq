# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, 0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.038487, -0.025658).threePointArc((0.208470, 0.063864), (0.378454, -0.025658)).lineTo(0.416941, 0.000000).threePointArc((0.385355, 0.038973), (0.346382, 0.070559)).lineTo(0.346382, 0.609375).lineTo(0.076974, 0.609375).lineTo(0.076974, 0.070559).threePointArc((0.034793, 0.039309), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.044901, 0.019243).circle(0.006414)
loop2=wp_sketch0.moveTo(0.121875, 0.070559).circle(0.006414)
loop3=wp_sketch0.moveTo(0.211678, 0.089803).circle(0.006414)
loop4=wp_sketch0.moveTo(0.295066, 0.070559).circle(0.006414)
loop5=wp_sketch0.moveTo(0.372039, 0.019243).circle(0.006414)
