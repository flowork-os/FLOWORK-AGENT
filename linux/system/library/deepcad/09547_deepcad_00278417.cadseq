# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00278417" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.003597, -0.019310), (0.014309, -0.035773)).lineTo(0.100164, 0.050082).lineTo(0.100164, 0.593832).lineTo(0.014309, 0.679688).threePointArc((0.003597, 0.663224), (0.000000, 0.643914)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.042599, 0.000000).lineTo(0.042599, 0.109375).lineTo(0.000000, 0.109375).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.375000, both=True)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, -0.320312, 0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.039967, 0.039967).lineTo(0.039967, 0.592845).lineTo(0.000000, 0.632812).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.101562)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, -0.320312, 0.054688), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.632812, 0.000000).lineTo(0.632812, 0.632812).lineTo(0.000000, 0.632812).lineTo(0.039967, 0.592845).lineTo(0.039967, 0.039967).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.101562)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
