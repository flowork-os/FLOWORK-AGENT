import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, -0.671875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.568750, 0.000000).lineTo(0.568750, 1.347039).lineTo(0.568750, 1.421875).lineTo(0.000000, 1.421875).lineTo(0.000000, 1.347039).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.538816, 0.029934).lineTo(0.538816, 0.628618).lineTo(0.029934, 0.628618).lineTo(0.029934, 0.029934).close()
loop2=wp_sketch0.moveTo(0.538816, 0.658553).lineTo(0.538816, 0.718421).lineTo(0.029934, 0.718421).lineTo(0.029934, 0.658553).close()
loop3=wp_sketch0.moveTo(0.538816, 0.748355).lineTo(0.538816, 1.317105).lineTo(0.538816, 1.406908).lineTo(0.029934, 1.406908).lineTo(0.029934, 1.317105).lineTo(0.029934, 0.748355).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
