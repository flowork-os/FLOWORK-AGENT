wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.007755, -0.070422), (0.019408, -0.135855)).threePointArc((0.456086, -0.359029), (0.892763, -0.135855)).threePointArc((0.919926, -0.070422), (0.912171, 0.000000)).threePointArc((0.731180, 0.350961), (0.485197, 0.659868)).threePointArc((0.456086, 0.672348), (0.426974, 0.659868)).threePointArc((0.180991, 0.350961), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
