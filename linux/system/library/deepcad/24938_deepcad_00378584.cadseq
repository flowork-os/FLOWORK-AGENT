# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00378584" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.000000, 0.656250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.179959, -1.198184), (1.225658, -0.586184)).lineTo(0.479605, -0.586184).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.479605, -0.652796).circle(0.053289)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.429688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
