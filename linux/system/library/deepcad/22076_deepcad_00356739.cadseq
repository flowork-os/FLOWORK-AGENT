# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00356739" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.025822, 0.000000).threePointArc((1.258964, 0.233141), (1.025822, 0.466283)).lineTo(0.000000, 0.466283).threePointArc((-0.233141, 0.233141), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.239803).circle(0.119901)
loop2=wp_sketch0.moveTo(1.025822, 0.239803).circle(0.119901)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.562500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
