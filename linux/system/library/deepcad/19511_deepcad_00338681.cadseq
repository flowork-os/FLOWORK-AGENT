# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00338681" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.007812, 0.000000).lineTo(1.007812, 0.095477).lineTo(0.604688, 0.095477).lineTo(0.604688, 0.148520).lineTo(1.007812, 0.148520).lineTo(1.007812, 0.243997).lineTo(0.604688, 0.243997).lineTo(0.604688, 0.297039).lineTo(1.007812, 0.297039).lineTo(1.007812, 0.403125).lineTo(0.000000, 0.403125).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.398438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.007812, -0.195312, 0.156250), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.051316, 0.000000).circle(0.050247)
solid1=wp_sketch1.add(loop1).extrude(-0.593750)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
