# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00221023" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, -0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.351562, -0.231799), (0.703125, 0.000000)).lineTo(0.703125, 0.325658).lineTo(0.525493, 0.325658).lineTo(0.525493, 0.399671).lineTo(0.000000, 0.399671).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.173684, 0.000000).lineTo(0.173684, 0.276316).threePointArc((0.296053, 0.153947), (0.418421, 0.276316)).lineTo(0.418421, 0.000000).lineTo(0.600000, 0.000000).lineTo(0.600000, 0.410526).lineTo(0.528947, 0.410526).lineTo(0.528947, 0.497368).lineTo(0.528947, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.497368).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.250000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
