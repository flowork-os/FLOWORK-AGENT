# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00249455" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.000000, -0.718750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.068503, 0.000000).lineTo(1.068503, 1.429688).lineTo(0.000000, 1.429688).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.664062, -0.156250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.658553, -0.376316).lineTo(0.658553, 0.687500).lineTo(0.000000, 0.311184).threePointArc((-0.089407, 0.155592), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.086842, 0.151974).circle(0.086842)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.359375, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, -1.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.146382, 0.000000).lineTo(0.146382, 1.390625).lineTo(0.000000, 1.390625).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(-1.000000, both=True)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
