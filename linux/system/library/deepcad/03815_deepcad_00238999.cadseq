import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, -0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.734211, 0.000000).threePointArc((0.853186, -0.049281), (0.902467, -0.168257)).lineTo(0.902467, -0.229441).lineTo(1.453125, -0.229441).lineTo(1.453125, 0.978947).lineTo(0.000000, 0.978947).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.351809, 0.214145).circle(0.122368)
loop2=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.412862, 0.196356), (0.565954, 0.627138)).lineTo(1.300164, 0.627138).threePointArc((1.372708, 0.650851), (1.407237, 0.718914)).threePointArc((1.372708, 0.786978), (1.300164, 0.810691)).lineTo(0.565954, 0.810691).threePointArc((0.501058, 0.783810), (0.474178, 0.718914)).close()
loop3=wp_sketch0.moveTo(1.177796, 0.152961).circle(0.214145)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.296875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
