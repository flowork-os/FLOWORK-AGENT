# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00285074" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.367188, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.351562, 0.037007).threePointArc((0.312774, 0.072163), (0.351562, 0.107319)).lineTo(0.000000, 0.140625).threePointArc((0.063728, 0.070312), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.240543, 0.051809).threePointArc((0.222039, 0.070312), (0.240543, 0.088816)).lineTo(0.099918, 0.088816).threePointArc((0.081414, 0.070312), (0.099918, 0.051809)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.289062, 0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.071053, 0.000000).circle(0.069572)
loop3=wp_sketch1.moveTo(0.071053, 0.000000).circle(0.053289)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.679688, 0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.035526, 0.000000).circle(0.035526)
loop5=wp_sketch2.moveTo(0.035526, 0.000000).circle(0.017763)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.085938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
