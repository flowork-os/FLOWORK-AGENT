# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322670" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.343750, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004119, -0.009944), (0.014062, -0.014062)).lineTo(0.431250, -0.014062).threePointArc((0.441194, -0.009944), (0.445312, 0.000000)).lineTo(0.445312, 0.018750).lineTo(0.445312, 0.023438).threePointArc((0.443387, 0.032310), (0.435937, 0.037500)).threePointArc((0.359739, 0.067824), (0.314062, 0.135937)).threePointArc((0.157031, -0.021094), (0.000000, 0.135937)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.159375, 0.135937).circle(0.103125)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.031250, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.101562, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.034128, 0.000000).lineTo(0.034128, -0.027303).lineTo(0.627961, -0.027303).threePointArc((0.651850, -0.003413), (0.627961, 0.020477)).lineTo(0.000000, 0.020477).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.122862, -0.006826).circle(0.013651)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.015625, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
