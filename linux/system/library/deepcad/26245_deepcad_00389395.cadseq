wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, -0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.021317, -0.051463), (0.072780, -0.072780)).lineTo(1.310033, -0.072780).threePointArc((1.361496, -0.051463), (1.382812, 0.000000)).lineTo(1.382812, 0.494901).threePointArc((1.361496, 0.546364), (1.310033, 0.567681)).lineTo(0.072780, 0.567681).threePointArc((0.021317, 0.546364), (0.000000, 0.494901)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.116447, 0.305674).circle(0.072780)
loop2=wp_sketch0.moveTo(1.149918, 0.334786).circle(0.072780)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.156250)
