loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001180, -0.002849), (0.004030, -0.004030)).lineTo(0.050658, -0.004030).threePointArc((0.053507, -0.002849), (0.054687, 0.000000)).lineTo(0.054687, 0.025329).threePointArc((0.053388, 0.027890), (0.050658, 0.028783)).lineTo(0.004030, 0.028783).threePointArc((0.001299, 0.027890), (0.000000, 0.025329)).lineTo(0.000000, 0.000000).close()
