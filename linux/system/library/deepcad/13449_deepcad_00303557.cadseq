# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00303557" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.134211, 0.544737).lineTo(0.205263, 0.584211).lineTo(0.181579, 0.671053).lineTo(0.102632, 0.671053).lineTo(0.071053, 0.600000).close()
loop2=wp_sketch0.moveTo(0.378947, 0.378947).circle(0.142105)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.375000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
