# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00258176" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.134211, 0.000000).lineTo(0.134211, 0.434211).lineTo(0.134211, 0.442105).threePointArc((0.375000, 0.596662), (0.615789, 0.442105)).lineTo(0.615789, 0.434211).lineTo(0.615789, 0.000000).lineTo(0.750000, 0.000000).lineTo(0.750000, 0.528947).threePointArc((0.375000, 0.660535), (0.000000, 0.528947)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.398438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.087500).threePointArc((-0.021875, 0.109375), (0.000000, 0.131250)).lineTo(0.000000, 0.218750).threePointArc((-0.109375, 0.109375), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.531250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
