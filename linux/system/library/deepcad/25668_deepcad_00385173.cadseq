# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00385173" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.734375, -0.257812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.032035, -0.077340), (0.109375, -0.109375)).lineTo(1.375000, -0.109375).threePointArc((1.452340, -0.077340), (1.484375, 0.000000)).lineTo(1.484375, 0.578125).threePointArc((1.449104, 0.647652), (1.375000, 0.671875)).lineTo(0.109375, 0.671875).threePointArc((0.035271, 0.647652), (0.000000, 0.578125)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.734375, -0.257812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.032035, -0.077340), (0.109375, -0.109375)).lineTo(1.375000, -0.109375).threePointArc((1.452340, -0.077340), (1.484375, 0.000000)).lineTo(1.484375, 0.578125).threePointArc((1.449104, 0.647652), (1.375000, 0.671875)).lineTo(0.109375, 0.671875).threePointArc((0.035271, 0.647652), (0.000000, 0.578125)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.210938, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
