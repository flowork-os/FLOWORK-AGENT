# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00370960" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.189474, 0.000000).circle(0.189474)
loop1=wp_sketch0.moveTo(0.189474, 0.000000).circle(0.150000)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.375000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.150000, 0.000000).circle(0.150000)
loop3=wp_sketch1.moveTo(0.150000, 0.000000).circle(0.056250)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.386842, 0.000000).circle(0.386842)
loop5=wp_sketch2.moveTo(0.104770, 0.000000).circle(0.048355)
loop6=wp_sketch2.moveTo(0.386842, 0.000000).circle(0.185362)
loop7=wp_sketch2.moveTo(0.386842, -0.274013).circle(0.048355)
loop8=wp_sketch2.moveTo(0.386842, 0.274013).circle(0.048355)
loop9=wp_sketch2.moveTo(0.660855, 0.000000).circle(0.048355)
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).add(loop7).add(loop8).add(loop9).extrude(0.078125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
