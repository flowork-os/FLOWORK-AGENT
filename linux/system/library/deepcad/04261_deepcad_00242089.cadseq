import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.008344, -0.014568), (0.024178, -0.020148)).lineTo(0.189391, -0.020148).lineTo(0.358635, -0.020148).threePointArc((0.374468, -0.014568), (0.382813, 0.000000)).threePointArc((0.191406, 0.221893), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.189391, 0.028207).lineTo(0.326398, 0.028207).threePointArc((0.191406, 0.164866), (0.056414, 0.028207)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
