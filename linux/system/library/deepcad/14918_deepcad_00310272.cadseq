# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00310272" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.888158, 0.000000).threePointArc((1.165707, 0.277549), (0.888158, 0.555099)).lineTo(0.000000, 0.555099).threePointArc((0.277549, 0.277549), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.888158, 0.283717).circle(0.148026)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.280263, 0.000000).circle(0.280263)
loop3=wp_sketch1.moveTo(0.280263, 0.000000).circle(0.151809)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.242188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.280263, 0.000000).circle(0.280263)
loop5=wp_sketch2.moveTo(0.280263, 0.000000).circle(0.151809)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.476562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
