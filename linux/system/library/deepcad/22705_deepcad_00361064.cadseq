# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00361064" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.122368, 0.000000).circle(0.122368)
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, -0.398438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.937500, 0.000000).lineTo(0.937500, 0.394737).lineTo(0.937500, 0.799342).lineTo(0.000000, 0.799342).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.029605, 0.394737).circle(0.019737)
loop3=wp_sketch1.moveTo(0.473684, 0.394737).circle(0.118421)
loop4=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.631579, -0.276316), (0.907895, 0.355263)).lineTo(0.907895, 0.394737).lineTo(0.907895, 0.444079).threePointArc((0.888158, 0.463816), (0.868421, 0.444079)).lineTo(0.868421, 0.355263).close()
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.023438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
