# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257719" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.078125, 0.000000).lineTo(0.078125, 0.028783).lineTo(0.061678, 0.056743).lineTo(0.000000, 0.056743).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.013980, 0.035362).circle(0.007401)
loop2=wp_sketch0.moveTo(0.042763, 0.021382).circle(0.013980)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.359375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
