import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.087336, 0.000000).lineTo(0.087336, -0.029112).lineTo(1.295477, -0.029112).lineTo(1.295477, 0.000000).lineTo(1.382812, 0.000000).lineTo(1.382812, 0.262007).lineTo(1.295477, 0.262007).lineTo(1.295477, 0.291118).lineTo(0.087336, 0.291118).lineTo(0.087336, 0.262007).lineTo(0.000000, 0.262007).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
