wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.515625, -0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.126156, -0.008868), (0.232401, -0.077467)).threePointArc((0.544257, -0.190372), (0.839227, -0.038734)).threePointArc((0.918506, 0.002182), (1.007072, 0.012911)).threePointArc((1.230830, 0.225946), (1.007072, 0.438980)).threePointArc((0.901541, 0.455969), (0.813405, 0.516447)).threePointArc((0.468415, 0.644859), (0.154934, 0.451891)).threePointArc((0.086795, 0.421991), (0.012911, 0.413158)).threePointArc((-0.236019, 0.214156), (0.000000, 0.000000)).close()
