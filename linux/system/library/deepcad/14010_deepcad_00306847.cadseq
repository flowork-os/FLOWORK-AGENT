# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306847" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, -0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.658553, 0.000000).lineTo(0.658553, 0.812500).lineTo(0.000000, 0.812500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.590132, 0.059868).lineTo(0.590132, 0.752632).lineTo(0.059868, 0.752632).lineTo(0.059868, 0.059868).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.528289, 0.000000).lineTo(0.528289, 0.687500).lineTo(0.000000, 0.687500).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, -0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.658553, 0.000000).lineTo(0.658553, 0.812500).lineTo(0.000000, 0.812500).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.590132, 0.059868).lineTo(0.590132, 0.752632).lineTo(0.059868, 0.752632).lineTo(0.059868, 0.059868).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.015625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
