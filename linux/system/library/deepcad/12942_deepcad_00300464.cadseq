# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00300464" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.398438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.445312, 0.000000).lineTo(1.445312, 0.821546).lineTo(0.000000, 0.821546).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.212993, 0.228207).circle(0.152138)
loop2=wp_sketch0.moveTo(0.152138, 0.699836).circle(0.060855)
loop3=wp_sketch0.moveTo(1.095395, 0.258635).circle(0.197780)
loop4=wp_sketch0.moveTo(1.004112, 0.699836).circle(0.091283)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.429688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
