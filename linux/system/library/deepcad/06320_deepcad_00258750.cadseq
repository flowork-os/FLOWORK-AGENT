import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, -0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.851069, 0.000000).lineTo(0.851069, 0.107730).lineTo(0.592516, 0.107730).lineTo(0.592516, 0.420148).lineTo(1.023438, 0.420148).lineTo(1.023438, 0.560197).lineTo(0.506332, 0.538651).lineTo(0.183141, 0.538651).lineTo(0.183141, 0.430921).lineTo(0.430921, 0.430921).lineTo(0.430921, 0.118503).lineTo(0.000000, 0.118503).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
