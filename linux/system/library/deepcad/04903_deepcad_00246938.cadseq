# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00246938" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.648438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.294737).lineTo(0.000000, 1.294737).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.110526, 0.110526).circle(0.063158)
loop2=wp_sketch0.moveTo(0.110526, 1.184211).circle(0.063158)
loop3=wp_sketch0.moveTo(1.389474, 0.110526).circle(0.063158)
loop4=wp_sketch0.moveTo(1.389474, 1.184211).circle(0.063158)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.532895, 0.000000).circle(0.532895)
solid1=wp_sketch1.add(loop5).extrude(0.554688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.156250, 0.000000, -0.390625), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop6=wp_sketch2.moveTo(0.332895, 0.000000).lineTo(0.332895, 0.359375).lineTo(0.000000, 0.359375).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(0.390625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
