solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.327632, 0.000000).circle(0.327632)
loop3=wp_sketch1.moveTo(0.327632, 0.000000).circle(0.279852)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.281250, 0.000000).lineTo(0.281250, 0.038487).lineTo(0.000000, 0.038487).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.054688)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch3.moveTo(0.617188, 0.000000).lineTo(0.617188, 0.038980).lineTo(0.000000, 0.038980).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop5).extrude(0.046875)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.039062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch4.moveTo(0.281250, 0.000000).lineTo(0.281250, 0.038487).lineTo(0.000000, 0.038487).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(0.046875)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
