# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00322509" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, 0.000000, -0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.182813, 0.000000).lineTo(0.490707, 0.000000).lineTo(0.490707, 0.490707).lineTo(0.240543, 0.914062).lineTo(0.000000, 0.490707).lineTo(0.000000, 0.182813).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.182813, 0.182813).circle(0.057730)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.492188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
