import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.079934, -0.248684).lineTo(0.293092, -0.399671).lineTo(0.550658, -0.399671).lineTo(0.763816, -0.248684).lineTo(0.843750, 0.000000).lineTo(0.763816, 0.248684).lineTo(0.550658, 0.399671).lineTo(0.426316, 0.399671).lineTo(0.293092, 0.399671).lineTo(0.079934, 0.248684).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
