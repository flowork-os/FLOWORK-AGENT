# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00336662" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, -0.093750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004625, -0.011165), (0.015789, -0.015789)).lineTo(0.359211, -0.015789).threePointArc((0.370375, -0.011165), (0.375000, 0.000000)).lineTo(0.375000, 0.173684).threePointArc((0.370375, 0.184849), (0.359211, 0.189474)).lineTo(0.015789, 0.189474).threePointArc((0.004625, 0.184849), (0.000000, 0.173684)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.289062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, -0.242188, 0.093750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.043421, 0.000000).circle(0.043421)
solid1=wp_sketch1.add(loop1).extrude(0.656250)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
