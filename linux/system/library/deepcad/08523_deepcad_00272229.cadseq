# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272229" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, 0.000000, -0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.078125, 0.000000).lineTo(1.078125, 1.078125).lineTo(0.000000, 1.078125).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.944520, 0.177824), (0.306414, 0.896546)).threePointArc((0.176796, 0.962427), (0.181579, 0.817105)).close()
loop2=wp_sketch0.moveTo(0.385855, 0.215625).lineTo(0.567434, 0.283717).lineTo(0.749013, 0.272368).lineTo(0.590132, 0.442599).lineTo(0.499342, 0.351809).lineTo(0.431250, 0.419901).lineTo(0.340461, 0.329112).lineTo(0.283717, 0.453947).lineTo(0.170230, 0.238322).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.539062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
