import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.004625, -0.011165), (0.015789, -0.015789)).lineTo(1.484211, -0.015789).threePointArc((1.495375, -0.011165), (1.500000, 0.000000)).lineTo(1.500000, 0.521053).threePointArc((1.495375, 0.532217), (1.484211, 0.536842)).lineTo(0.015789, 0.536842).threePointArc((0.004625, 0.532217), (0.000000, 0.521053)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.268421, 0.268421).circle(0.031579)
loop2=wp_sketch0.moveTo(0.536842, 0.047368).circle(0.015789)
loop3=wp_sketch0.moveTo(0.536842, 0.473684).circle(0.015789)
loop4=wp_sketch0.moveTo(0.963158, 0.047368).circle(0.015789)
loop5=wp_sketch0.moveTo(0.963158, 0.473684).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
