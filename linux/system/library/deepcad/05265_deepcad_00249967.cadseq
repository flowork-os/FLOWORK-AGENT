# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00249967" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.289062, 0.000000, -0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.573602, 0.000000).lineTo(0.573602, 0.917763).threePointArc((0.286801, 1.204564), (0.000000, 0.917763)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.293174, 0.917763).circle(0.140214)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.234375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
