# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288535" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.656250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.119079, 0.000000).lineTo(1.119079, 1.312500).lineTo(0.000000, 1.312500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.566447, 0.663158).circle(0.303947)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.656250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.119079, 0.000000).lineTo(1.119079, 1.312500).lineTo(0.000000, 1.312500).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.566447, 0.663158).circle(0.303947)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.656250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(1.119079, 0.000000).lineTo(1.119079, 1.312500).lineTo(0.000000, 1.312500).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.566447, 0.663158).circle(0.303947)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(-0.375000)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
