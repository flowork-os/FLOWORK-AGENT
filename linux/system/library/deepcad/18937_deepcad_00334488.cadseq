wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.000000, -0.578125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.048848, -0.117929), (0.166776, -0.166776)).lineTo(1.084046, -0.166776).threePointArc((1.201975, -0.117929), (1.250822, 0.000000)).lineTo(1.250822, 1.153536).threePointArc((1.201975, 1.271465), (1.084046, 1.320312)).lineTo(0.166776, 1.320312).threePointArc((0.048848, 1.271465), (0.000000, 1.153536)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750)
solid=solid0

if __name__ == '__main__':
