# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00321374" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.398438, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.835938, 0.000000).lineTo(0.835938, 0.651151).lineTo(0.281579, 0.651151).lineTo(0.000000, 0.651151).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.422368, 0.325576).circle(0.184786)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.367188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
