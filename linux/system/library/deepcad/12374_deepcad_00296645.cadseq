# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00296645" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.078947, -0.078947).lineTo(0.750000, -0.078947).lineTo(0.750000, 0.150000).lineTo(0.750000, 0.378947).lineTo(0.078947, 0.378947).lineTo(0.000000, 0.300000).lineTo(0.000000, 0.150000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.150000, -0.015789).circle(0.023684)
loop2=wp_sketch0.moveTo(0.150000, 0.315789).circle(0.023684)
loop3=wp_sketch0.moveTo(0.497368, -0.015789).circle(0.023684)
loop4=wp_sketch0.moveTo(0.497368, 0.315789).circle(0.023684)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.047697, 0.000000).lineTo(0.047697, 0.228947).lineTo(0.047697, 0.453125).lineTo(0.000000, 0.453125).lineTo(0.000000, 0.228947).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.453125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
