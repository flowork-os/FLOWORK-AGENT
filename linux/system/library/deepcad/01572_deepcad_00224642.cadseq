import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.088322, 0.000000).lineTo(0.088322, -0.058882).lineTo(0.986266, -0.058882).lineTo(0.986266, -0.147204).lineTo(1.398438, -0.147204).lineTo(1.398438, 0.191365).lineTo(0.986266, 0.191365).lineTo(0.986266, 0.103043).lineTo(0.000000, 0.103043).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.335938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.000000, 0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.976563, 0.000000).lineTo(0.976563, 0.082237).lineTo(0.000000, 0.082237).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.335938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.976563, 0.000000).lineTo(0.976563, 0.082237).lineTo(0.082237, 0.082237).lineTo(0.082237, 0.143914).lineTo(0.000000, 0.143914).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.335938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
