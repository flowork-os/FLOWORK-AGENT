# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.231970, -0.372109), (0.631579, -0.552632)).lineTo(0.631579, -0.284211).threePointArc((0.534803, -0.213576), (0.473684, -0.110526)).lineTo(0.205263, -0.110526).close()
loop2=wp_sketch0.moveTo(0.473684, 0.110526).threePointArc((0.534803, 0.213576), (0.631579, 0.284211)).lineTo(0.631579, 0.552632).threePointArc((0.351365, 0.396240), (0.205263, 0.110526)).close()
loop3=wp_sketch0.moveTo(0.205263, 0.110526).threePointArc((0.716472, -0.165244), (1.294737, -0.110526)).lineTo(1.026316, -0.110526).threePointArc((0.965197, -0.213576), (0.868421, -0.284211)).lineTo(0.868421, -0.552632).close()
loop4=wp_sketch0.moveTo(0.868421, -0.552632).threePointArc((0.879296, -0.204845), (1.026316, 0.110526)).lineTo(1.294737, 0.110526).threePointArc((1.148635, 0.396240), (0.868421, 0.552632)).lineTo(0.868421, 0.284211).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.375000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
