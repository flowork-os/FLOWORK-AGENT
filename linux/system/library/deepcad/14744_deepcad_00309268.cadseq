# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.000000, 0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.091060, -0.185020), (0.106908, -0.390625)).threePointArc((0.164330, -0.228575), (0.205592, -0.061678)).threePointArc((0.111127, -0.003069), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.132812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
