wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.000000, 0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.129270, -0.434585), (0.485197, -0.715461)).threePointArc((0.592768, -0.721696), (0.682566, -0.781250)).lineTo(0.723684, -0.592105).threePointArc((0.655856, -0.466047), (0.542763, -0.378289)).threePointArc((0.566711, -0.452303), (0.542763, -0.526316)).threePointArc((0.219036, -0.317139), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.132812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.015625, 0.000000, -0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.057755, -0.115643), (0.084128, -0.242188)).threePointArc((0.103490, -0.058170), (0.025493, 0.109622)).threePointArc((0.013756, 0.054576), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.132812)
