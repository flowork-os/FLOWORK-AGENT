import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, -0.656250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.295970, -0.091769), (0.591941, 0.000000)).lineTo(0.591941, 0.862829).threePointArc((0.295970, 0.954597), (0.000000, 0.862829)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.274501, -0.066384), (0.531743, 0.050164)).lineTo(0.531743, 0.812664).threePointArc((0.422822, 0.871361), (0.300987, 0.892928)).threePointArc((0.290954, 0.894542), (0.280921, 0.892928)).threePointArc((0.159086, 0.871361), (0.050164, 0.812664)).lineTo(0.050164, 0.050164).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, 0.000000, 0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.484375, 0.000000).threePointArc((0.376218, 0.059248), (0.254934, 0.081579)).threePointArc((0.242188, 0.002358), (0.229441, 0.081579)).threePointArc((0.108157, 0.059248), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.062500)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
