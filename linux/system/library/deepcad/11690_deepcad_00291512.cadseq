# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.008936, -0.021574), (0.030510, -0.030510)).lineTo(0.383553, -0.030510).threePointArc((0.405126, -0.021574), (0.414062, 0.000000)).lineTo(0.414062, 0.226645).threePointArc((0.405126, 0.248218), (0.383553, 0.257155)).lineTo(0.030510, 0.257155).threePointArc((0.008936, 0.248218), (0.000000, 0.226645)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.126398, 0.026151).lineTo(0.126398, 0.200493).lineTo(0.013076, 0.200493).lineTo(0.013076, 0.026151).close()
loop2=wp_sketch0.moveTo(0.265872, 0.026151).lineTo(0.265872, 0.200493).lineTo(0.148191, 0.200493).lineTo(0.148191, 0.026151).close()
loop3=wp_sketch0.moveTo(0.400987, 0.026151).lineTo(0.400987, 0.200493).lineTo(0.287664, 0.200493).lineTo(0.287664, 0.026151).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
