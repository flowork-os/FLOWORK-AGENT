# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232090" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, -0.687500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.931579, 0.000000).lineTo(0.931579, 1.382812).lineTo(0.000000, 1.382812).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.687500, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop1=wp_sketch1.moveTo(0.931579, 0.000000).lineTo(0.931579, 1.382812).lineTo(0.000000, 1.382812).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.931579, 0.014556).lineTo(0.931579, 1.368257).lineTo(0.014556, 1.368257).lineTo(0.014556, 0.014556).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
