solid1=wp_sketch1.add(loop1).extrude(-0.148438)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.679688, 0.000000, 0.062500), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(1.359375, 0.000000).lineTo(1.359375, 0.558059).lineTo(0.000000, 0.558059).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.148438)
