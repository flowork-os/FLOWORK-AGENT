# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.234375, -0.359375, 0.335938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.102632, 0.000000).circle(0.102632)
solid3=wp_sketch3.add(loop3).extrude(-0.210938)
