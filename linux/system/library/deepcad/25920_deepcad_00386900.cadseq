wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.000000, 0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.127467, -1.210938).lineTo(0.229441, -1.210938).threePointArc((0.541735, -1.184044), (0.854030, -1.210938)).lineTo(0.956003, -1.210938).lineTo(1.083470, 0.000000).threePointArc((1.007225, 0.014155), (0.930510, 0.025493)).threePointArc((0.541735, 0.252078), (0.152961, 0.025493)).threePointArc((0.076246, 0.014155), (0.000000, 0.000000)).close()
