# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00360384" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, -0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.200329, 0.000000).lineTo(0.372039, 0.400658).lineTo(0.915789, 0.400658).lineTo(1.173355, 0.000000).lineTo(1.359375, 0.000000).lineTo(0.772697, 1.116118).lineTo(0.443586, 1.116118).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.872862, 0.643914).lineTo(0.744079, 0.987336).lineTo(0.500822, 0.987336).lineTo(0.414967, 0.643914).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.257812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
