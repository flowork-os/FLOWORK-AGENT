loop0=wp_sketch0.moveTo(0.442105, 0.000000).threePointArc((0.537638, 0.057931), (0.647368, 0.078947)).lineTo(0.757895, 0.078947).lineTo(0.852632, 0.078947).threePointArc((0.954468, 0.056512), (1.042105, 0.000000)).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.221053).lineTo(1.042105, 0.221053).threePointArc((0.953048, 0.172436), (0.852632, 0.157895)).lineTo(0.757895, 0.157895).lineTo(0.647368, 0.157895).threePointArc((0.539058, 0.171016), (0.442105, 0.221053)).lineTo(0.000000, 0.221053).lineTo(0.000000, 0.000000).close()
