import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.328125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.421875, 0.000000).lineTo(0.421875, 0.266447).lineTo(0.226480, 0.266447).lineTo(0.226480, 0.084375).lineTo(0.000000, 0.084375).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.355263, 0.119901).circle(0.017763)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.328125, 0.000000).lineTo(0.328125, 0.086349).lineTo(0.196875, 0.086349).lineTo(0.196875, 0.227961).lineTo(0.000000, 0.227961).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.069079, 0.120888).circle(0.017270)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.367188, 0.000000, 0.367188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.185362, 0.000000).lineTo(0.185362, -0.100740).lineTo(0.382813, -0.100740).lineTo(0.382813, 0.084622).lineTo(0.000000, 0.084622).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.314309, -0.036266).circle(0.020148)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.078125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.197122, 0.000000).lineTo(0.197122, 0.139145).lineTo(0.367188, 0.139145).lineTo(0.367188, 0.224178).lineTo(0.000000, 0.224178).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch3.moveTo(0.065707, 0.104359).circle(0.019326)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.078125)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
