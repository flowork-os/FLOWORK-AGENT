# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.398438, -0.632812, -0.390625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.600329, 0.000000).lineTo(0.600329, 0.781250).lineTo(0.000000, 0.781250).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.351562)
