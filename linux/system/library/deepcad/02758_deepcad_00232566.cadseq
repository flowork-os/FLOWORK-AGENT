loop3=wp_sketch3.moveTo(0.781250, 0.000000).lineTo(0.781250, 0.600329).lineTo(0.000000, 0.600329).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.351562)
