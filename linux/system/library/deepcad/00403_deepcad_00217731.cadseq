wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, -0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.280771, -0.278662), (0.662418, -0.382730)).lineTo(1.295395, -0.014720).threePointArc((1.396271, 0.368010), (1.295395, 0.750740)).lineTo(0.662418, 1.118750).threePointArc((0.280771, 1.014681), (0.000000, 0.736020)).lineTo(0.000000, 0.000000).close()
