# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00243308" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.321546, 0.000000).lineTo(0.321546, 0.370477).lineTo(0.342516, 0.370477).lineTo(0.342516, 0.000000).lineTo(0.664062, 0.000000).lineTo(0.538240, 0.601151).lineTo(0.125822, 0.601151).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.255592, 0.000000).lineTo(0.324671, 0.200329).lineTo(0.400658, 0.000000).lineTo(0.656250, 0.000000).lineTo(0.545724, 0.594079).lineTo(0.338487, 0.594079).lineTo(0.338487, 0.366118).lineTo(0.317763, 0.366118).lineTo(0.317763, 0.594079).lineTo(0.110526, 0.594079).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.273438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
