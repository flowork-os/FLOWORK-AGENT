# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00371297" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.054688, 0.000000, 0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.379688, 0.000000).lineTo(0.379688, 0.632812).lineTo(0.000000, 0.632812).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.053289, 0.266447).circle(0.013322)
loop2=wp_sketch0.moveTo(0.053289, 0.359704).circle(0.013322)
loop3=wp_sketch0.moveTo(0.326398, 0.266447).circle(0.013322)
loop4=wp_sketch0.moveTo(0.326398, 0.359704).circle(0.013322)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
