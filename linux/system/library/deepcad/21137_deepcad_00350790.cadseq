# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00350790" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, 0.000000, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.098273, -0.237253), (0.335526, -0.335526)).threePointArc((0.569284, -0.235805), (0.664062, 0.000000)).lineTo(0.664062, 0.615132).lineTo(0.000000, 0.615132).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.335526, 0.000000).circle(0.279605)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, -0.109375, 0.203125), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.090789, 0.000000).circle(0.090789)
solid1=wp_sketch1.add(loop2).extrude(-0.554688)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
