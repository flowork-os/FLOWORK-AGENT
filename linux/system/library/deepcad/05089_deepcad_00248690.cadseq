wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, -0.554688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.726974, 0.000000).lineTo(1.062500, -0.044737).lineTo(1.062500, 0.190132).lineTo(0.548026, 0.190132).lineTo(0.548026, 0.380263).lineTo(0.447368, 0.615132).lineTo(0.447368, 0.760526).lineTo(0.190132, 0.760526).lineTo(0.190132, 0.592763).lineTo(0.000000, 0.447368).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.117188)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
