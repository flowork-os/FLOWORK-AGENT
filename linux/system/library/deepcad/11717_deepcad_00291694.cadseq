# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00291694" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.507812, 0.000000).lineTo(0.507812, 0.320724).lineTo(0.000000, 0.320724).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.356250, 0.000000).lineTo(0.356250, 0.445312).lineTo(0.000000, 0.445312).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.018750, 0.018750).circle(0.014062)
loop3=wp_sketch1.moveTo(0.018750, 0.426563).circle(0.014062)
loop4=wp_sketch1.moveTo(0.337500, 0.018750).circle(0.014062)
loop5=wp_sketch1.moveTo(0.337500, 0.426563).circle(0.014062)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.117188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.359211, 0.000000).lineTo(0.359211, 0.656250).lineTo(0.000000, 0.656250).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch2.moveTo(0.027632, 0.027632).circle(0.013816)
loop8=wp_sketch2.moveTo(0.027632, 0.628618).circle(0.013816)
loop9=wp_sketch2.moveTo(0.331579, 0.027632).circle(0.013816)
loop10=wp_sketch2.moveTo(0.331579, 0.628618).circle(0.013816)
solid2=wp_sketch2.add(loop6).add(loop7).add(loop8).add(loop9).add(loop10).extrude(0.164062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
