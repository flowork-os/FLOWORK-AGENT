import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.205263, 0.000000).circle(0.205263)
solid0=wp_sketch0.add(loop0).extrude(0.062500, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.156250, 0.000000, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.593653, -0.099471), (0.012500, -0.256250)).lineTo(0.018750, -0.256250).threePointArc((0.564000, -0.087543), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.406250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.156250, 0.000000, 0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.426736, -0.064865), (0.038158, -0.252796)).lineTo(0.033388, -0.252796).threePointArc((0.452557, -0.068831), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.406250)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.008717, 0.000000).threePointArc((-0.411891, 0.179002), (0.039227, 0.252796)).threePointArc((-0.388043, 0.189655), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(0.406250)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.000000, -0.187500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.threePointArc((-0.576767, 0.169646), (0.018257, 0.255592)).threePointArc((0.015214, 0.255611), (0.012171, 0.255592)).threePointArc((-0.547116, 0.154139), (0.000000, 0.000000)).close()
solid4=wp_sketch4.add(loop4).extrude(0.406250)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
