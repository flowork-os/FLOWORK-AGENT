# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00244285" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.453125, 0.000000).lineTo(1.453125, 0.428289).lineTo(0.000000, 0.428289).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.437829, 0.015296).lineTo(1.437829, 0.412993).lineTo(0.015296, 0.412993).lineTo(0.015296, 0.015296).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
