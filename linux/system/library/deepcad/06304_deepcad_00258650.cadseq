# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00258650" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.044819, -0.013569).threePointArc((1.289171, 0.198338), (1.031250, 0.393503)).lineTo(0.081414, 0.393503).threePointArc((-0.199035, 0.246354), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.390625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.000000, 0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.044819, -0.013569).threePointArc((1.289171, 0.198338), (1.031250, 0.393503)).lineTo(0.081414, 0.393503).threePointArc((-0.199035, 0.246354), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.390625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
