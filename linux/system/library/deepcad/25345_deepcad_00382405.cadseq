# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00382405" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.244465, -0.245154), (0.273684, -0.590132)).threePointArc((0.748539, 0.111184), (0.273684, 0.812500)).threePointArc((0.248111, 0.462292), (0.000000, 0.213816)).threePointArc((-0.106908, 0.106908), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.111184).circle(0.059868)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.453125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
