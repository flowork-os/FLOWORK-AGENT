# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00296579" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.242188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.189474, 0.000000).lineTo(0.189474, -0.126316).lineTo(1.310526, -0.126316).lineTo(1.310526, 0.000000).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.489474).lineTo(1.310526, 0.489474).lineTo(1.310526, 0.615789).lineTo(0.189474, 0.615789).lineTo(0.189474, 0.489474).lineTo(0.000000, 0.489474).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.568421, 0.252632).circle(0.031579)
loop2=wp_sketch0.moveTo(0.931579, 0.252632).circle(0.031579)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
