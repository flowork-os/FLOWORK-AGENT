# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00303559" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.546875, 0.000000).lineTo(0.546875, 0.397204).lineTo(0.000000, 0.397204).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.074836, 0.299342).lineTo(0.115132, 0.339638).lineTo(0.086349, 0.385691).lineTo(0.034539, 0.374178).lineTo(0.028783, 0.316612).close()
loop2=wp_sketch0.moveTo(0.270559, 0.201480).circle(0.080592)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.117188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.296875, -0.046875, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch1.moveTo(0.043421, 0.000000).circle(0.043421)
solid1=wp_sketch1.add(loop3).extrude(-0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
