# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00276851" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.179688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.522286, 0.000000).threePointArc((0.556246, 0.014067), (0.570312, 0.048026)).lineTo(0.570312, 0.300164).threePointArc((0.557489, 0.337126), (0.522286, 0.354194)).lineTo(0.000000, 0.354194).threePointArc((-0.177097, 0.177097), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.174095).circle(0.126069)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.351562, 0.179688, 0.093750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.075000, 0.000000).circle(0.075000)
loop3=wp_sketch1.moveTo(0.075000, 0.000000).circle(0.034375)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.546875, 0.179688, 0.093750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.075000, 0.000000).circle(0.075000)
loop5=wp_sketch2.moveTo(0.075000, 0.000000).circle(0.034375)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.007812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
