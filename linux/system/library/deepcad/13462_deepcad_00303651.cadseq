wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.671875, 0.000000).lineTo(0.671875, 0.565789).lineTo(0.000000, 0.565789).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.176809, 0.049507).circle(0.028289)
