wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.465789, 0.000000).threePointArc((0.746053, 0.280263), (0.465789, 0.560526)).lineTo(0.000000, 0.560526).lineTo(0.000000, 0.000000).close()
