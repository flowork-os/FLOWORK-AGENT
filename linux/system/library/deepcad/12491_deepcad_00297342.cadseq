# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297342" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.664062, 0.000000).lineTo(0.664062, 0.272615).lineTo(0.000000, 0.272615).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.531250, 0.132812).circle(0.041941)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.089474, 0.000000).lineTo(0.089474, 0.265625).lineTo(0.000000, 0.265625).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.664062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.085938, -0.664062, 0.132812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.043421, 0.000000).circle(0.043421)
solid2=wp_sketch2.add(loop3).extrude(-1.000000)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
