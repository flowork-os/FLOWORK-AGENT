# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00304640" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.078125, 0.000000).lineTo(1.078125, 0.499342).lineTo(0.000000, 0.499342).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.055428, 0.022697).lineTo(1.055428, 0.476645).lineTo(0.022697, 0.476645).lineTo(0.022697, 0.022697).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
