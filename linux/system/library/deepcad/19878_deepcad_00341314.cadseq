# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00341314" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.437500, 0.000000).lineTo(0.437500, 0.147368).lineTo(0.290132, 0.147368).lineTo(0.147368, 0.147368).lineTo(0.000000, 0.147368).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.156579, 0.073684).circle(0.036842)
loop2=wp_sketch0.moveTo(0.280921, 0.073684).circle(0.036842)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.150247, 0.000000).lineTo(0.150247, 0.679688).lineTo(0.000000, 0.679688).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.035773, 0.643914).circle(0.021464)
loop5=wp_sketch1.moveTo(0.107319, 0.643914).circle(0.021464)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.070312)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
