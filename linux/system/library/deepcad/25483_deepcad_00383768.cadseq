import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, -0.406250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.839803, 0.000000).lineTo(0.839803, 1.156250).lineTo(0.000000, 1.156250).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.766776, 0.109539).lineTo(0.425987, 0.523355).lineTo(0.073026, 0.109539).close()
loop2=wp_sketch0.moveTo(0.340789, 0.584211).lineTo(0.073026, 0.839803).lineTo(0.073026, 0.316447).close()
loop3=wp_sketch0.moveTo(0.425987, 0.632895).lineTo(0.766776, 1.046711).lineTo(0.073026, 1.046711).close()
loop4=wp_sketch0.moveTo(0.766776, 0.316447).lineTo(0.766776, 0.839803).lineTo(0.499013, 0.584211).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
