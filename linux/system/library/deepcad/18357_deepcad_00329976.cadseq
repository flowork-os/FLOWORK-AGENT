# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00329976" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, 0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.525000, -0.382812).lineTo(1.039062, 0.000000).lineTo(0.842187, 0.612500).lineTo(0.196875, 0.612500).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.525000, 0.164062).circle(0.240625)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.164062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
