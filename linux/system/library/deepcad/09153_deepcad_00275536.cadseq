# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00275536" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.664062, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.658717, 0.000000).threePointArc((0.703125, 0.044408), (0.658717, 0.088816)).lineTo(0.170230, 0.088816).threePointArc((0.154078, 0.103819), (0.155428, 0.125822)).lineTo(0.281250, 0.362664).threePointArc((0.269967, 0.403056), (0.229441, 0.392270)).lineTo(0.081414, 0.125822).lineTo(0.029605, 0.155428).lineTo(0.081414, 0.244243).threePointArc((0.071491, 0.273095), (0.044408, 0.259046)).lineTo(0.000000, 0.177632).threePointArc((0.088816, 0.088816), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.304688, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, -0.617188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.030035, -0.084083), (0.104852, -0.132812)).lineTo(0.503289, -0.132812).threePointArc((0.578106, -0.084083), (0.608141, 0.000000)).lineTo(0.552220, 0.622122).threePointArc((0.536441, 0.653226), (0.503289, 0.664062)).lineTo(0.111842, 0.664062).threePointArc((0.075195, 0.654674), (0.055921, 0.622122)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.609375)
solid=solid.intersect(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, -0.664062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.050329, 0.000000).lineTo(0.100658, 0.000000).lineTo(0.100658, 0.796875).lineTo(0.050329, 0.796875).lineTo(0.000000, 0.796875).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.062500)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
