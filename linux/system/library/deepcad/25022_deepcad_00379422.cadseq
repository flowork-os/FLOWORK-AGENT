import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.481579, 0.000000).lineTo(0.953125, 0.000000).lineTo(0.953125, 0.652138).lineTo(0.953125, 0.752467).lineTo(0.892928, 0.752467).lineTo(0.892928, 0.060197).lineTo(0.481579, 0.060197).lineTo(0.060197, 0.060197).lineTo(0.060197, 0.752467).lineTo(0.000000, 0.752467).lineTo(0.000000, 0.652138).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.187500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
