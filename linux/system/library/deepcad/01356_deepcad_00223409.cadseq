import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.027748, -0.066989), (0.094737, -0.094737)).lineTo(0.655263, -0.094737).threePointArc((0.722252, -0.066989), (0.750000, 0.000000)).lineTo(0.750000, 0.047368).threePointArc((0.722252, 0.114357), (0.655263, 0.142105)).lineTo(0.094737, 0.142105).threePointArc((0.027748, 0.114357), (0.000000, 0.047368)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.655263, 0.023684).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
