# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.419408, -0.013980).threePointArc((0.363463, 0.150316), (0.517270, 0.069901)).lineTo(0.573191, 0.664062).threePointArc((0.426398, 0.531017), (0.279605, 0.664062)).lineTo(0.314556, 0.244655).threePointArc((0.297584, 0.187732), (0.244655, 0.160773)).lineTo(0.000000, 0.153783).threePointArc((0.079776, 0.076891), (0.000000, 0.000000)).close()
loop7=wp_sketch3.moveTo(0.426398, 0.314556).circle(0.027961)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.031250)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
