import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.090789, 0.000000).circle(0.088898)
loop1=wp_sketch0.moveTo(0.090789, 0.000000).circle(0.030263)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.150000, 0.000000).circle(0.150000)
loop3=wp_sketch1.moveTo(0.150000, 0.000000).circle(0.037500)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.075000, 0.000000).circle(0.075000)
loop5=wp_sketch2.moveTo(0.075000, 0.000000).circle(0.029688)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.031250)
