# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00292807" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.614063, 0.000000).lineTo(0.614063, 1.023438).lineTo(0.000000, 1.023438).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.484786, 0.183141).lineTo(0.484786, 0.894161).lineTo(0.420148, 0.894161).lineTo(0.420148, 0.280099).lineTo(0.215461, 0.280099).lineTo(0.215461, 0.894161).lineTo(0.150822, 0.894161).lineTo(0.150822, 0.183141).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.523438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
