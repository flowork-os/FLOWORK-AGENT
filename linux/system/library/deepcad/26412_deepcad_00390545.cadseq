# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00390545" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, 0.257812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.118421, 0.000000).circle(0.118421)
loop1=wp_sketch0.moveTo(0.118421, 0.000000).circle(0.024671)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.398438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.062500, 0.000000, 0.695312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.061678).threePointArc((-0.517312, -0.491033), (0.071957, -0.966283)).lineTo(0.071957, -0.894326).threePointArc((-0.411184, -0.483141), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(-0.483141, -0.483141).circle(0.030839)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.398438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
