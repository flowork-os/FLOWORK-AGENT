loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.011562, -0.027912), (0.039474, -0.039474)).lineTo(0.710526, -0.039474).threePointArc((0.738438, -0.027912), (0.750000, 0.000000)).lineTo(0.750000, 0.663158).threePointArc((0.740073, 0.695017), (0.710526, 0.710526)).lineTo(0.039474, 0.710526).threePointArc((0.009927, 0.695017), (0.000000, 0.663158)).lineTo(0.000000, 0.000000).close()
