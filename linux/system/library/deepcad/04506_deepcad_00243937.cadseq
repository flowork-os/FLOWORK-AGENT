# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.265625, 0.265625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
