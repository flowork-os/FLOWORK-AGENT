# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00386984" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, 0.062500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.064552, -0.155843), (0.220395, -0.220395)).lineTo(0.303043, -0.220395).threePointArc((0.458885, -0.155843), (0.523438, 0.000000)).lineTo(0.523438, 0.099178).lineTo(0.000000, 0.099178).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.648438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.047595, -0.114905), (0.162500, -0.162500)).lineTo(0.243750, -0.162500).threePointArc((0.358655, -0.114905), (0.406250, 0.000000)).lineTo(0.406250, 0.102632).lineTo(0.000000, 0.102632).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, -0.531250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.035552, -0.085830), (0.121382, -0.121382)).lineTo(0.198931, -0.121382).threePointArc((0.284761, -0.085830), (0.320312, 0.000000)).lineTo(0.320312, 0.101151).lineTo(0.000000, 0.101151).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.046875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
