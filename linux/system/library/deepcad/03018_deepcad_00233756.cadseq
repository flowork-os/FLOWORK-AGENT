wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, -0.578125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.587171, 0.000000).lineTo(1.188322, 0.000000).lineTo(1.076480, 1.328125).lineTo(0.936678, 1.328125).lineTo(0.936678, 1.118421).lineTo(0.587171, 1.118421).lineTo(0.251645, 1.118421).lineTo(0.097862, 1.118421).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.181743, 0.097862).lineTo(0.992599, 0.097862).lineTo(1.104441, 0.097862).lineTo(1.020559, 1.048520).lineTo(0.922697, 1.048520).lineTo(0.587171, 1.048520).lineTo(0.265625, 1.048520).lineTo(0.153783, 1.048520).lineTo(0.083882, 0.097862).close()
