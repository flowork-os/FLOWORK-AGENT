# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00347241" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.523438, 0.000000).lineTo(0.523438, 0.104687).lineTo(0.523438, 0.495888).lineTo(0.000000, 0.495888).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.359375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, -0.640625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.531250, 0.000000).lineTo(0.531250, 0.391447).lineTo(0.000000, 0.391447).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.359375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.718750, 0.359375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.010526, 0.000000).lineTo(0.463158, 0.000000).lineTo(0.463158, 0.094737).lineTo(1.000000, 0.094737).lineTo(1.000000, 0.431579).lineTo(0.000000, 0.421053).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.382812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
