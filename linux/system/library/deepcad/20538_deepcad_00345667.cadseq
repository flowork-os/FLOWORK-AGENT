wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.247368, 0.000000).lineTo(1.247368, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.126316, 0.063158).lineTo(1.121053, 0.063158).lineTo(1.184211, 0.063158).lineTo(1.184211, 0.126316).lineTo(1.184211, 1.373684).lineTo(1.184211, 1.436842).lineTo(1.121053, 1.436842).lineTo(0.126316, 1.436842).lineTo(0.063158, 1.436842).lineTo(0.063158, 1.373684).lineTo(0.063158, 0.126316).lineTo(0.063158, 0.063158).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.687500, 0.062500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
