# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.750000, 0.062500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(0.062500, 0.000000).lineTo(0.062500, 0.062500).lineTo(0.000000, 0.062500).lineTo(0.000000, 0.000000).close()
