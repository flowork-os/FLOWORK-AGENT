loop3=wp_sketch2.moveTo(0.062500, 0.000000).lineTo(0.062500, 0.062500).lineTo(0.000000, 0.062500).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.250000)
