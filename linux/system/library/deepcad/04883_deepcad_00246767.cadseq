# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.093750, 0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.040543, -0.023849).threePointArc((0.113927, 0.067474), (0.212253, 0.131168)).threePointArc((0.134969, 0.187479), (0.047697, 0.226562)).threePointArc((0.042076, 0.109444), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.750000)
