# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00246543" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, -0.687500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.390625, 0.000000).lineTo(1.390625, 0.468421).lineTo(0.380592, 0.731908).lineTo(0.000000, 0.731908).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.156414, 0.234211).circle(0.102467)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.132812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
