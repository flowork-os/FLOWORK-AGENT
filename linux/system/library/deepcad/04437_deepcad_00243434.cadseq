solid3=wp_sketch3.add(loop3).extrude(-0.039062)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.062500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.015625, 0.000000).lineTo(0.015625, 0.000164).threePointArc((0.007813, 0.000034), (0.000000, 0.000000)).close()
