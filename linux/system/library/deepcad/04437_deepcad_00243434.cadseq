# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, -0.750000, 0.062500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch5.moveTo(0.000000, 0.000000).threePointArc((0.015789, -0.000097), (0.031579, 0.000000)).lineTo(0.031579, 1.500000).threePointArc((0.015789, 1.500097), (0.000000, 1.500000)).lineTo(0.000000, 0.000000).close()
