import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.165789).lineTo(0.252632, 0.165789).lineTo(0.252632, 0.663158).lineTo(0.000000, 0.663158).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.335938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.296875, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.082895, 0.000000).circle(0.082895)
solid1=wp_sketch1.add(loop1).extrude(0.335938)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.546875, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.082895, 0.000000).circle(0.081168)
solid2=wp_sketch2.add(loop2).extrude(0.335938)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.250000, 0.414062), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.082895, 0.000000).circle(0.082895)
solid3=wp_sketch3.add(loop3).extrude(0.335938)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.250000, 0.421875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.085510, 0.081868), (0.168421, -0.002632)).lineTo(0.168421, 0.250000).lineTo(0.000000, 0.250000).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.335938)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
