# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00330574" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, -0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.945312, 0.000000).lineTo(0.945312, 0.268668).lineTo(0.000000, 0.268668).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.457730, 0.139309).circle(0.089556)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.484375, -0.156250, -0.054688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.304688, 0.000000).lineTo(0.304688, 0.214885).lineTo(0.000000, 0.214885).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.282237, 0.057730).lineTo(0.282237, 0.163569).lineTo(0.016036, 0.163569).lineTo(0.016036, 0.057730).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.265625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
