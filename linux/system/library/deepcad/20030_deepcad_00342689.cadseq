loop0=wp_sketch0.moveTo(0.042763, 0.000000).threePointArc((0.079979, -0.015415), (0.095395, -0.052632)).lineTo(0.095395, -0.095395).threePointArc((0.105312, -0.068164), (0.131579, -0.055921)).lineTo(0.174342, -0.055921).threePointArc((0.273679, 0.175958), (0.039474, 0.082237)).lineTo(0.039474, 0.039474).threePointArc((0.027912, 0.011562), (0.000000, 0.000000)).close()
