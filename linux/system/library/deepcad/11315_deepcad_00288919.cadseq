# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00288919" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.335938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.113322, 0.000000).threePointArc((0.241710, 0.170496), (0.414062, 0.296382)).lineTo(0.414062, 0.414062).lineTo(0.000000, 0.414062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.091530, 0.039227).threePointArc((0.214240, 0.197939), (0.374836, 0.318174)).lineTo(0.374836, 0.374836).lineTo(0.039227, 0.374836).lineTo(0.039227, 0.039227).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.328125, 0.632812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.039227, 0.039227).threePointArc((0.194875, -0.109181), (0.300740, -0.296382)).lineTo(0.414062, -0.296382).lineTo(0.414062, 0.117681).lineTo(0.000000, 0.117681).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.178729, -0.106675), (0.322533, -0.257155)).lineTo(0.374836, -0.257155).lineTo(0.374836, 0.078454).lineTo(0.039227, 0.078454).lineTo(0.039227, 0.021793).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.242188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
