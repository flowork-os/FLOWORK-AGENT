loop0=wp_sketch0.moveTo(0.195559, 0.000000).threePointArc((0.211237, 0.012094), (0.200329, 0.028618)).lineTo(0.047697, 0.052467).threePointArc((0.030454, 0.062344), (0.023849, 0.081086)).lineTo(0.023849, 0.372039).threePointArc((0.032638, 0.391868), (0.052467, 0.400658)).lineTo(0.200329, 0.424507).threePointArc((0.214638, 0.438816), (0.200329, 0.453125)).lineTo(0.000000, 0.453125).lineTo(0.000000, 0.000000).close()
