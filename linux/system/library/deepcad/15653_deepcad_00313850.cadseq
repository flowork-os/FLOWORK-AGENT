wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000120, -0.000291), (0.000411, -0.000411)).lineTo(0.004523, -0.000411).threePointArc((0.004814, -0.000291), (0.004934, 0.000000)).lineTo(0.004934, 0.007401).threePointArc((0.004814, 0.007692), (0.004523, 0.007812)).lineTo(0.000411, 0.007812).threePointArc((0.000120, 0.007692), (0.000000, 0.007401)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.004523, 0.000000).lineTo(0.004523, 0.007401).lineTo(0.000411, 0.007401).lineTo(0.000411, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
