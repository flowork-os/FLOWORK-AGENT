# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.242188, 0.156250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.481250, 0.000000).lineTo(0.481250, 0.350000).threePointArc((0.240625, 0.590625), (0.000000, 0.350000)).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch3.moveTo(0.243750, 0.350000).circle(0.118750)
