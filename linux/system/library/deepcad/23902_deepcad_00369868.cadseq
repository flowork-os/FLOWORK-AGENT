# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.242188, 0.156250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop8=wp_sketch4.moveTo(0.481250, 0.000000).lineTo(0.481250, 0.350000).threePointArc((0.240625, 0.590625), (0.000000, 0.350000)).lineTo(0.000000, 0.000000).close()
