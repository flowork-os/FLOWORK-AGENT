# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00353900" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.746053, 0.000000).circle(0.746053)
loop1=wp_sketch0.moveTo(0.730510, 0.000000).circle(0.186513)
loop2=wp_sketch0.moveTo(0.839309, 0.248684).lineTo(0.839309, 0.497368).lineTo(0.606168, 0.497368).lineTo(0.606168, 0.248684).close()
loop3=wp_sketch0.moveTo(1.087993, -0.543997).lineTo(1.087993, -0.373026).lineTo(0.854852, -0.373026).lineTo(0.854852, -0.543997).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.187500)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
