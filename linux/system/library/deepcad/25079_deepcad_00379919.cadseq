# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00379919" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.453125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009249, -0.022330), (0.031579, -0.031579)).lineTo(1.468421, -0.031579).threePointArc((1.490751, -0.022330), (1.500000, 0.000000)).lineTo(1.500000, 0.900000).threePointArc((1.494021, 0.930224), (1.468421, 0.947368)).lineTo(0.031579, 0.947368).threePointArc((0.005979, 0.930224), (0.000000, 0.900000)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.017144, -0.025600), (0.047368, -0.031579)).lineTo(1.452632, -0.031579).threePointArc((1.482856, -0.025600), (1.500000, 0.000000)).lineTo(1.500000, 0.900000).threePointArc((1.482856, 0.925600), (1.452632, 0.931579)).lineTo(0.047368, 0.931579).threePointArc((0.017144, 0.925600), (0.000000, 0.900000)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.156250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.453125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.009249, -0.022330), (0.031579, -0.031579)).lineTo(1.468421, -0.031579).threePointArc((1.490751, -0.022330), (1.500000, 0.000000)).lineTo(1.500000, 0.900000).threePointArc((1.494021, 0.930224), (1.468421, 0.947368)).lineTo(0.031579, 0.947368).threePointArc((0.005979, 0.930224), (0.000000, 0.900000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
