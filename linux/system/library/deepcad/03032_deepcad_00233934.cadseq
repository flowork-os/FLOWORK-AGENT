# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00233934" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.623684).lineTo(0.000000, 0.623684).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.031579, 0.015789).lineTo(0.031579, 0.094737).lineTo(0.015789, 0.094737).lineTo(0.015789, 0.015789).close()
loop2=wp_sketch0.moveTo(0.244737, 0.015789).lineTo(0.244737, 0.031579).lineTo(0.094737, 0.031579).lineTo(0.094737, 0.015789).close()
loop3=wp_sketch0.moveTo(0.410526, 0.015789).lineTo(0.410526, 0.031579).lineTo(0.339474, 0.031579).lineTo(0.339474, 0.015789).close()
loop4=wp_sketch0.moveTo(0.655263, 0.015789).lineTo(0.655263, 0.031579).lineTo(0.505263, 0.031579).lineTo(0.505263, 0.015789).close()
loop5=wp_sketch0.moveTo(0.734211, 0.015789).lineTo(0.734211, 0.094737).lineTo(0.718421, 0.094737).lineTo(0.718421, 0.015789).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(-0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
