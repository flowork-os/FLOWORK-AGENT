# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00279847" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.734375, 0.023438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.030757, -0.015378).lineTo(1.430181, -0.015378).lineTo(1.460938, 0.000000).threePointArc((1.444322, -0.005215), (1.430181, -0.015378)).lineTo(0.030757, -0.015378).threePointArc((0.016615, -0.005215), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.703125, 0.015625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.406250, 0.000000).threePointArc((1.374849, 0.013007), (1.361842, 0.044408)).lineTo(0.044408, 0.044408).threePointArc((0.031401, 0.013007), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.007812, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.047368, 0.000000).circle(0.046382)
loop3=wp_sketch2.moveTo(0.047368, 0.000000).circle(0.011842)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.007812, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.656250, 0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.047368, 0.000000).circle(0.046382)
loop5=wp_sketch3.moveTo(0.047368, 0.000000).circle(0.011842)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.007812, both=True)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
