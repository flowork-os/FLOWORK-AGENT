# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00229735" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.743832, 0.000000).lineTo(0.766036, 0.000000).lineTo(1.054688, 0.277549).lineTo(0.000000, 0.288651).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.289062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, -0.609375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(1.054688, 0.000000).lineTo(0.766036, 0.288651).lineTo(0.743832, 0.288651).lineTo(0.743832, 0.444079).lineTo(0.000000, 0.444079).lineTo(0.000000, 0.288651).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.289062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.742188, 0.000000).lineTo(0.742188, 0.164062).lineTo(0.000000, 0.164062).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.289062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
