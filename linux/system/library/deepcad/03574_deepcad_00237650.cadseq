# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00237650" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.171875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.578125, 0.000000).lineTo(0.578125, 0.176480).threePointArc((0.453335, 0.228170), (0.401645, 0.352961)).lineTo(0.000000, 0.352961).threePointArc((-0.176480, 0.176480), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.176480).circle(0.073026)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
