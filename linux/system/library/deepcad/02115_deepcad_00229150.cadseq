# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00229150" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.226562, 0.484375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.237933, -0.216907), (0.307566, -0.531250)).lineTo(0.313158, -0.531250).threePointArc((0.244410, -0.214111), (0.005592, 0.005592)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.005674, 0.000000).threePointArc((0.074393, 0.315230), (0.312089, 0.533388)).lineTo(0.312089, 0.539062).threePointArc((0.070657, 0.318966), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.069388, -0.225710), (0.228618, -0.400082)).lineTo(0.251480, -0.365789).threePointArc((0.542969, 0.554317), (0.834457, -0.365789)).lineTo(0.857319, -0.400082).threePointArc((1.016549, -0.225710), (1.085938, 0.000000)).lineTo(1.074507, 0.000000).threePointArc((1.005290, 0.317514), (0.765872, 0.537253)).lineTo(0.777303, 0.537253).threePointArc((0.542969, 0.589875), (0.308635, 0.537253)).lineTo(0.320066, 0.537253).threePointArc((0.080648, 0.317514), (0.011431, 0.000000)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
