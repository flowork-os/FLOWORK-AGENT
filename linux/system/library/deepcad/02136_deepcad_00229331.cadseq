wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.679688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.085362, 0.000000).lineTo(0.654441, 0.611760).threePointArc((0.675781, 0.607515), (0.697122, 0.611760)).lineTo(1.266201, 0.000000).lineTo(1.351562, 0.000000).lineTo(1.351562, 0.042681).lineTo(0.725576, 0.725576).threePointArc((0.675781, 0.747648), (0.625987, 0.725576)).lineTo(0.000000, 0.042681).lineTo(0.000000, 0.000000).close()
