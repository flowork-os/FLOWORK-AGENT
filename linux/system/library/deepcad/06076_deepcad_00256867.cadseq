wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013874, -0.033495), (0.047368, -0.047368)).lineTo(0.702632, -0.047368).threePointArc((0.736126, -0.033495), (0.750000, 0.000000)).lineTo(0.750000, 0.284211).threePointArc((0.736126, 0.317705), (0.702632, 0.331579)).lineTo(0.047368, 0.331579).threePointArc((0.013874, 0.317705), (0.000000, 0.284211)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.046875, 0.070312, 0.093750), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.006070, -0.014654), (0.020724, -0.020724)).lineTo(0.635526, -0.020724).threePointArc((0.650180, -0.014654), (0.656250, 0.000000)).lineTo(0.656250, 0.234868).threePointArc((0.650180, 0.249522), (0.635526, 0.255592)).lineTo(0.020724, 0.255592).threePointArc((0.006070, 0.249522), (0.000000, 0.234868)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.046875)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
