# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00313115" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, 0.000000, -0.648438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.234786, 0.000000).lineTo(1.234786, 1.289062).lineTo(0.000000, 1.289062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.108553, 0.081414).circle(0.027138)
loop2=wp_sketch0.moveTo(0.108553, 1.207648).circle(0.027138)
loop3=wp_sketch0.moveTo(0.624178, 0.651316).circle(0.447780)
loop4=wp_sketch0.moveTo(1.126234, 0.081414).circle(0.027138)
loop5=wp_sketch0.moveTo(1.126234, 1.207648).circle(0.027138)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.117188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.390625, 0.000000, 0.648438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.019737, 0.000000).circle(0.019326)
solid1=wp_sketch1.add(loop6).extrude(0.101562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.343750, 0.000000, 0.648438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch2.moveTo(0.019737, 0.000000).circle(0.019326)
solid2=wp_sketch2.add(loop7).extrude(0.101562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
