# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00252245" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.544737).lineTo(0.000000, 0.544737).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.371053, 0.276316).circle(0.086842)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.343750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.505016, 0.000000).lineTo(0.505016, 0.539062).lineTo(0.000000, 0.539062).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.243997, 0.272368).circle(0.096464)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.093750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
