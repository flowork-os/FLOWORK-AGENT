wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.284823, -0.389003), (0.729112, -0.576234)).lineTo(0.729112, 0.000000).lineTo(1.117188, 0.000000).lineTo(1.117188, 0.070559).lineTo(0.729112, 0.070559).lineTo(0.729112, 0.317516).threePointArc((0.566067, 0.477639), (0.341036, 0.517434)).threePointArc((0.042274, 0.343241), (0.000000, 0.000000)).close()
