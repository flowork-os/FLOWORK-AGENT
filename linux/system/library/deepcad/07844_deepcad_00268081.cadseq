import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.018499, -0.044659), (0.063158, -0.063158)).lineTo(1.436842, -0.063158).threePointArc((1.481501, -0.044659), (1.500000, 0.000000)).lineTo(1.500000, 0.836842).threePointArc((1.478231, 0.873607), (1.436842, 0.884211)).lineTo(0.063158, 0.884211).threePointArc((0.021769, 0.873607), (0.000000, 0.836842)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
