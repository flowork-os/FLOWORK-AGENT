# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00336672" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.265625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.500000, 0.000000).lineTo(0.500000, 0.110526).lineTo(0.000000, 0.110526).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.109375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, -0.375000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.505757, 0.000000).lineTo(0.505757, 0.640625).lineTo(0.000000, 0.640625).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.249507, 0.303454).circle(0.067434)
loop3=wp_sketch1.moveTo(0.249507, 0.505757).circle(0.067434)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.109375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.265625, 0.109375), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.500000, 0.000000).lineTo(0.500000, 0.110526).lineTo(0.000000, 0.110526).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.640625)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.265625, 0.453125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.067105, 0.000000).circle(0.067105)
solid3=wp_sketch3.add(loop5).extrude(-0.625000)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
