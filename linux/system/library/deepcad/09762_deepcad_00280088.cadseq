# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00280088" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.218750, 0.000000).lineTo(1.218750, 0.641447).lineTo(0.000000, 0.641447).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.410526, 0.218092).lineTo(0.410526, 0.423355).lineTo(0.192434, 0.423355).lineTo(0.192434, 0.218092).close()
loop2=wp_sketch0.moveTo(0.910855, 0.320724).circle(0.102632)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.156250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
