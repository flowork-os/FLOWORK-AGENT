# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306557" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.312500, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.125000, 0.000000).lineTo(0.125000, 0.065789).lineTo(0.500000, 0.065789).lineTo(0.500000, 0.000000).lineTo(0.625000, 0.000000).lineTo(0.625000, 0.375000).lineTo(0.000000, 0.375000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.312500, 0.375000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.625000, 0.000000).lineTo(0.625000, 0.092105).threePointArc((0.588388, 0.180494), (0.500000, 0.217105)).lineTo(0.125000, 0.217105).threePointArc((0.036612, 0.180494), (0.000000, 0.092105)).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.500000, 0.105263).threePointArc((0.536184, 0.141447), (0.500000, 0.177632)).lineTo(0.125000, 0.177632).threePointArc((0.161184, 0.141447), (0.125000, 0.105263)).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.125000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
