wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.328125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.276316, 0.000000).lineTo(0.276316, -0.134211).lineTo(0.528947, -0.134211).lineTo(0.528947, 0.047368).lineTo(0.750000, 0.047368).lineTo(0.750000, 0.086842).lineTo(0.544737, 0.086842).lineTo(0.544737, 0.118421).lineTo(0.750000, 0.118421).lineTo(0.750000, 0.157895).lineTo(0.528947, 0.157895).lineTo(0.528947, 0.331579).lineTo(0.000000, 0.331579).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.273438)
solid=solid0

if __name__ == '__main__':
