# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00265802" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.085938, 0.000000).lineTo(0.085938, 0.044326).threePointArc((0.042969, 0.043007), (0.000000, 0.044326)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.703125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.044655, 1.455057), (0.089309, 0.000000)).lineTo(0.089309, 0.044655).lineTo(0.000000, 0.044655).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.044655, 0.699589).circle(0.625164)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, -0.703125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.042969, -0.001319), (0.085938, 0.000000)).lineTo(0.085938, 0.041612).lineTo(0.000000, 0.041612).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.046875)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
