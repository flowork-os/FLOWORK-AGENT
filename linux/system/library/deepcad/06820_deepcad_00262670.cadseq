# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00262670" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757812, 0.000000).lineTo(0.757812, 0.470641).lineTo(0.000000, 0.470641).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.287171, 0.095724).lineTo(0.287171, 0.382895).lineTo(0.143586, 0.382895).lineTo(0.143586, 0.095724).close()
loop2=wp_sketch0.moveTo(0.382895, 0.095724).lineTo(0.382895, 0.382895).lineTo(0.335033, 0.382895).lineTo(0.335033, 0.095724).close()
loop3=wp_sketch0.moveTo(0.518503, 0.167516).circle(0.047862)
loop4=wp_sketch0.moveTo(0.518503, 0.311102).circle(0.047862)
loop5=wp_sketch0.moveTo(0.590296, 0.239309).circle(0.015954)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
