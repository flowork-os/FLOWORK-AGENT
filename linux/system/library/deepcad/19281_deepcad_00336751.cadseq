# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00336751" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.421875, 0.000000).lineTo(1.421875, 0.149671).lineTo(0.449013, 0.808224).threePointArc((0.152739, 0.823051), (0.000000, 0.568750)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.284375, 0.568750).circle(0.149671)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.281250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.281250, -0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(1.421875, 0.000000).lineTo(1.421875, 0.149671).lineTo(0.568750, 0.149671).lineTo(0.568750, 0.568750).lineTo(0.419079, 0.568750).threePointArc((0.284375, 0.434046), (0.149671, 0.568750)).lineTo(0.000000, 0.568750).lineTo(0.000000, 0.149671).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.281250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.281250, 0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.144079, 0.000000).threePointArc((0.285156, -0.141077), (0.426234, 0.000000)).lineTo(0.570312, 0.000000).threePointArc((0.285156, 0.285156), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(0.281250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
