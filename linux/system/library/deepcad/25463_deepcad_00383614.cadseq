# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, 0.320312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.148520, -0.537500).threePointArc((0.325329, -0.672025), (0.502138, -0.537500)).lineTo(0.650658, 0.000000).threePointArc((0.325329, 0.427587), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.141447, -0.452632).threePointArc((0.325329, -0.297909), (0.509211, -0.452632)).lineTo(0.509211, -0.198026).lineTo(0.502138, -0.198026).threePointArc((0.325329, -0.248126), (0.148520, -0.198026)).lineTo(0.141447, -0.198026).lineTo(0.141447, -0.452632).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
