# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00325674" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.091365, -0.481743).lineTo(0.581414, -0.548191).lineTo(0.789062, -0.099671).lineTo(0.431908, 0.240872).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.492188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.179688, 0.492188), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.078947, -0.457895).lineTo(0.544737, -0.528947).lineTo(0.750000, -0.110526).lineTo(0.410526, 0.221053).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.382812)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.296875, -0.359375, 0.492188), cq.Vector(0.415027, 0.906917, -0.072482), cq.Vector(0.890680, -0.421260, -0.170962)))
loop2=wp_sketch2.moveTo(0.078947, -0.371053).lineTo(0.375000, -0.351316).lineTo(0.375000, 0.031579).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.476562)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.234375, -0.132812, 0.132812), cq.Vector(0.986726, 0.004385, -0.162333), cq.Vector(0.162333, -0.053628, 0.985278)))
loop3=wp_sketch3.moveTo(0.043421, 0.000000).circle(0.043421)
solid3=wp_sketch3.add(loop3).extrude(0.117188)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
