# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.054688, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.030839, 0.030839).threePointArc((0.048418, 0.066303), (0.083882, 0.083882)).lineTo(0.114720, 0.114720).threePointArc((0.024866, 0.089854), (0.000000, 0.000000)).close()
