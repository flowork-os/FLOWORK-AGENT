wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, -0.601562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.006359, -0.015352), (0.021711, -0.021711)).lineTo(1.009539, -0.021711).threePointArc((1.024891, -0.015352), (1.031250, 0.000000)).lineTo(1.031250, 0.629605).threePointArc((1.024891, 0.644957), (1.009539, 0.651316)).lineTo(0.021711, 0.651316).threePointArc((0.006359, 0.644957), (0.000000, 0.629605)).lineTo(0.000000, 0.000000).close()
