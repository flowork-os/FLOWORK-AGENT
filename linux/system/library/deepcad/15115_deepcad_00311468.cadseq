# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00311468" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.203947, 0.000000).lineTo(0.458882, 0.000000).threePointArc((0.508845, -0.021418), (0.530263, -0.071382)).threePointArc((0.910905, -0.203893), (0.744408, 0.163158)).lineTo(0.000000, 0.163158).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.744408, -0.061184).circle(0.142763)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.242188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.000000, 0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.429688, -0.253289).threePointArc((0.352161, -0.176779), (0.321135, -0.072368)).threePointArc((0.299421, -0.021714), (0.248766, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.039062, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
