# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00348770" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.237171, -0.237171).lineTo(0.567516, -0.237171).lineTo(0.804688, 0.000000).lineTo(0.804688, 0.330345).lineTo(0.567516, 0.567516).lineTo(0.237171, 0.567516).lineTo(0.000000, 0.330345).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.254112, -0.194819).lineTo(0.550576, -0.194819).lineTo(0.770806, 0.016941).lineTo(0.770806, 0.321875).lineTo(0.550576, 0.533635).lineTo(0.254112, 0.533635).lineTo(0.033882, 0.321875).lineTo(0.033882, 0.016941).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.216447, -0.216447).lineTo(0.517928, -0.216447).lineTo(0.734375, 0.000000).lineTo(0.734375, 0.301480).lineTo(0.517928, 0.517928).lineTo(0.216447, 0.517928).lineTo(0.000000, 0.301480).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
