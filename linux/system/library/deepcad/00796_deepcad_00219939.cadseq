# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, -0.218750, -0.289062), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop2=wp_sketch2.moveTo(0.368832, 0.000000).lineTo(0.368832, 0.096464).lineTo(0.539062, 0.096464).lineTo(0.539062, 0.278043).threePointArc((0.272167, 0.531262), (0.000000, 0.283717)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.218750)
solid=solid.union(solid2)

