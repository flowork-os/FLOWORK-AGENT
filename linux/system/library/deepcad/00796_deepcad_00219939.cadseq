wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, -0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.361842, 0.000000).lineTo(0.361842, 0.230263).lineTo(0.534539, 0.230263).lineTo(0.534539, 0.781250).lineTo(0.402961, 0.781250).lineTo(0.402961, 0.600329).threePointArc((0.369239, 0.518919), (0.287829, 0.485197)).lineTo(0.246711, 0.485197).threePointArc((0.165300, 0.518919), (0.131579, 0.600329)).lineTo(0.131579, 0.781250).lineTo(0.000000, 0.781250).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.218750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.250000, 0.000000, -0.289062), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
