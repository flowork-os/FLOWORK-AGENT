# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.281250, 0.000000, 0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.030776, -0.133224), (0.000000, -0.266447)).lineTo(0.335526, -0.271382).threePointArc((0.471217, -0.135691), (0.335526, 0.000000)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.335526, -0.236842).threePointArc((0.436724, -0.133162), (0.330592, -0.034539)).lineTo(0.143092, -0.034539).threePointArc((0.041941, -0.135691), (0.143092, -0.236842)).close()
