# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00342016" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.382401, 0.000000).threePointArc((0.384127, 0.043402), (0.390625, 0.086349)).lineTo(0.230263, 0.086349).lineTo(0.000000, 0.086349).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.359375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.085938, 0.000000).threePointArc((0.371094, 0.285156), (0.656250, 0.000000)).lineTo(0.742188, 0.000000).threePointArc((0.371094, 0.371094), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.359375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.359375, 0.000000, 0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.006498, -0.042947), (0.008224, -0.086349)).lineTo(0.390625, -0.086349).lineTo(0.390625, 0.000000).lineTo(0.160362, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.359375)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
