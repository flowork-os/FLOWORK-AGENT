import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.331579, -0.566447).lineTo(0.980921, -0.566447).lineTo(1.312500, 0.000000).lineTo(0.980921, 0.566447).lineTo(0.331579, 0.566447).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.373026, -0.483553).lineTo(0.939474, -0.483553).lineTo(1.215789, 0.000000).lineTo(0.939474, 0.483553).lineTo(0.373026, 0.483553).lineTo(0.096711, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, 0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.282237, -0.482155).lineTo(0.834951, -0.482155).lineTo(1.117188, 0.000000).lineTo(0.834951, 0.482155).lineTo(0.282237, 0.482155).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.023438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.331579, -0.566447).lineTo(0.980921, -0.566447).lineTo(1.312500, 0.000000).lineTo(0.980921, 0.566447).lineTo(0.331579, 0.566447).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.373026, -0.483553).lineTo(0.939474, -0.483553).lineTo(1.215789, 0.000000).lineTo(0.939474, 0.483553).lineTo(0.373026, 0.483553).lineTo(0.096711, 0.000000).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.375000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
