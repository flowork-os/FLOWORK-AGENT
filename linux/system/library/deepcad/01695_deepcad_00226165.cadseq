# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00226165" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.156250, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.001295, 0.011687), (0.001727, 0.023438)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.000432, -0.011751), (0.001727, -0.023438)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.000000, -0.718750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.442105, -0.027632).threePointArc((0.518352, 0.000136), (0.552632, 0.073684)).lineTo(0.598684, 0.690789).lineTo(0.607895, 0.718421).threePointArc((0.446711, 0.879605), (0.285526, 0.718421)).lineTo(0.285526, 0.690789).lineTo(0.322368, 0.257895).threePointArc((0.302694, 0.201187), (0.248684, 0.175000)).lineTo(0.018421, 0.156579).threePointArc((-0.077169, 0.088452), (0.000000, 0.000000)).close()
loop3=wp_sketch2.moveTo(0.000000, 0.082895).circle(0.027632)
loop4=wp_sketch2.moveTo(0.442105, 0.718421).circle(0.036842)
loop5=wp_sketch2.moveTo(0.442105, 0.082895).circle(0.027632)
loop6=wp_sketch2.moveTo(0.442105, 0.285526).circle(0.027632)
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).extrude(0.031250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
