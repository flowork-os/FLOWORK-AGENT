# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00309092" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, -0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.687500, 0.036184).threePointArc((0.554481, 0.162829), (0.687500, 0.289474)).lineTo(0.000000, 0.325658).threePointArc((0.155026, 0.162829), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.130263, 0.000000).circle(0.130263)
loop2=wp_sketch1.moveTo(0.130263, 0.000000).circle(0.067845)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.062500, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.165789, 0.000000).circle(0.165789)
loop4=wp_sketch2.moveTo(0.165789, 0.000000).circle(0.096711)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.093750, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
