# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00310305" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.071957, 0.000000).threePointArc((1.289062, 0.217105), (1.071957, 0.434211)).lineTo(0.000000, 0.434211).threePointArc((-0.217105, 0.217105), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.217105).circle(0.067845)
loop2=wp_sketch0.moveTo(1.071957, 0.217105).circle(0.067845)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.210938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.109375, 0.210938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.212418, 0.000000).lineTo(0.212418, 0.212418).threePointArc((0.106209, 0.318627), (0.000000, 0.212418)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.107895, 0.212418).circle(0.043832)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.265625, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.109375, 0.109375, 0.429688), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.210938, 0.000000).lineTo(0.210938, 0.139885).lineTo(0.000000, 0.139885).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop5).extrude(-0.210938)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.109375, 0.109375, 0.375000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.105469, -0.105469), (0.210938, 0.000000)).lineTo(0.210938, 0.053289).lineTo(0.000000, 0.053289).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop6).extrude(-0.210938)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
