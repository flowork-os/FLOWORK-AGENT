import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.426316, 0.000000).lineTo(0.426316, 0.126316).lineTo(0.852632, 0.126316).lineTo(0.852632, 0.378947).threePointArc((0.993153, 0.750000), (0.852632, 1.121053)).lineTo(0.852632, 1.373684).lineTo(0.426316, 1.373684).lineTo(0.426316, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 1.121053).threePointArc((-0.140521, 0.750000), (0.000000, 0.378947)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.576316, 0.000000).circle(0.576316)
loop2=wp_sketch1.moveTo(0.576316, 0.000000).circle(0.492270)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.078125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, -0.085938, -0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((-0.002552, -0.004441), (0.000000, -0.008882)).lineTo(0.843750, -0.008882).threePointArc((0.846302, -0.004441), (0.843750, 0.000000)).lineTo(0.426316, 0.728289).threePointArc((0.421875, 0.730841), (0.417434, 0.728289)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch2.moveTo(0.417434, 0.000000).threePointArc((0.421875, -0.002552), (0.426316, 0.000000)).lineTo(0.630592, 0.355263).threePointArc((0.633144, 0.359704), (0.630592, 0.364145)).lineTo(0.213158, 0.364145).threePointArc((0.210606, 0.359704), (0.213158, 0.355263)).close()
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.078125)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
