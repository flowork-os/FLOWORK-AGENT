# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00257690" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.132812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.022451, -0.022451), (0.000000, -0.044901)).lineTo(0.179605, -0.044901).threePointArc((0.202056, -0.022451), (0.179605, 0.000000)).lineTo(0.119737, 0.000000).lineTo(0.119737, -0.014967).lineTo(0.059868, -0.014967).lineTo(0.059868, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, -0.023520).circle(0.019243)
loop2=wp_sketch0.moveTo(0.179605, -0.023520).circle(0.019243)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
