# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00313122" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.460938, 0.000000, 0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.215296, 0.000000).lineTo(0.215296, -0.151974).lineTo(0.462253, -0.151974).lineTo(0.462253, 0.056990).lineTo(0.291283, 0.056990).lineTo(0.291283, 0.240625).lineTo(0.094984, 0.240625).lineTo(0.094984, 0.601562).lineTo(0.000000, 0.601562).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.132812, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
