wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.083388, -0.083388), (0.166776, 0.000000)).lineTo(0.166776, 0.525987).threePointArc((0.083388, 0.609375), (0.000000, 0.525987)).lineTo(0.000000, 0.000000).close()
