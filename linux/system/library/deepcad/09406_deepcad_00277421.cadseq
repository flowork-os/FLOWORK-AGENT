# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, 0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop9=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((-0.075781, -0.091735), (0.015954, -0.167516)).lineTo(0.686020, -0.095724).threePointArc((0.757812, -0.007977), (0.670066, 0.063816)).lineTo(0.000000, 0.000000).close()
