# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.023438, 0.000000, 0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.157895, 0.000000).circle(0.157895)
solid3=wp_sketch3.add(loop3).extrude(-0.062500)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.484375, 0.000000, 0.312500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.156250, 0.000000).lineTo(0.156250, 0.082237).lineTo(0.000000, 0.082237).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(0.031250)
solid=solid.union(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.515625, 0.000000, 0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch5.moveTo(0.093750, 0.000000).lineTo(0.093750, 0.044408).lineTo(0.000000, 0.044408).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop5).extrude(0.031250)
solid=solid.union(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
