# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00319508" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.640625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.142023, 0.025822).lineTo(1.226562, 0.025822).lineTo(1.226562, 0.748849).lineTo(0.903783, 0.903783).lineTo(0.361513, 0.903783).lineTo(0.361513, 0.542270).lineTo(0.000000, 0.542270).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.359375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
