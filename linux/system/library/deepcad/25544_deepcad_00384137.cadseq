# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, -0.687500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.017728, -0.042799), (0.060526, -0.060526)).lineTo(1.180263, -0.060526).threePointArc((1.230628, -0.045932), (1.255921, 0.000000)).lineTo(1.255921, 1.376974).threePointArc((1.230628, 1.422906), (1.180263, 1.437500)).lineTo(0.060526, 1.437500).threePointArc((0.017728, 1.419772), (0.000000, 1.376974)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
