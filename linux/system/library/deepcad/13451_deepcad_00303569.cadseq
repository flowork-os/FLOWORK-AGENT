# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00303569" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.500000, 0.000000).threePointArc((0.561888, 0.014926), (0.625000, 0.006579)).lineTo(0.625000, 0.625000).lineTo(0.013158, 0.625000).threePointArc((0.019665, 0.557902), (0.000000, 0.493421)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.085526, 0.006579).lineTo(0.388158, 0.190789).lineTo(0.078947, 0.361842).close()
loop2=wp_sketch0.moveTo(0.421053, 0.421053).circle(0.171053)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.593750, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.173684, 0.000000).circle(0.173684)
solid1=wp_sketch1.add(loop3).extrude(0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, -0.578125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.173684, 0.000000).circle(0.173684)
solid2=wp_sketch2.add(loop4).extrude(0.250000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.070312, -0.250000, 0.445312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.059211, 0.000000).circle(0.059211)
solid3=wp_sketch3.add(loop5).extrude(-0.187500)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
