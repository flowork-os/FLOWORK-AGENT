# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00299803" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.421875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.164062, 0.000000).lineTo(1.164062, 0.845477).lineTo(0.747451, 0.845477).lineTo(0.747451, 0.612664).threePointArc((0.582031, 0.111933), (0.416612, 0.612664)).lineTo(0.416612, 0.845477).lineTo(0.000000, 0.845477).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, 0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.168380, -0.509693), (0.336760, 0.000000)).lineTo(0.336760, 0.224507).lineTo(0.165707, 0.224507).lineTo(0.000000, 0.224507).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.165707, -0.224507).circle(0.219161)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.421875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(1.164062, 0.000000).lineTo(1.164062, 0.845477).lineTo(0.747451, 0.845477).lineTo(0.747451, 0.612664).threePointArc((0.582031, 0.111933), (0.416612, 0.612664)).lineTo(0.416612, 0.845477).lineTo(0.000000, 0.845477).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.531250)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.421875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch3.moveTo(1.164062, 0.000000).lineTo(1.164062, 0.845477).lineTo(0.747451, 0.845477).lineTo(0.747451, 0.612664).threePointArc((0.582031, 0.111933), (0.416612, 0.612664)).lineTo(0.416612, 0.845477).lineTo(0.000000, 0.845477).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop4).extrude(0.218750)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
