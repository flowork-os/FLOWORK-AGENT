# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00328487" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.015789, 0.000000).lineTo(0.015789, 0.015789).lineTo(0.015789, 0.473684).lineTo(0.015789, 0.505263).lineTo(0.015789, 1.357895).lineTo(0.015789, 1.373684).lineTo(0.015789, 1.484211).lineTo(0.015789, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.601562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.515625, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.015789, 0.000000).lineTo(0.015789, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 1.484211).lineTo(0.000000, 1.373684).lineTo(0.000000, 1.357895).lineTo(0.000000, 1.089474).lineTo(0.000000, 1.073684).lineTo(0.000000, 0.789474).lineTo(0.000000, 0.773684).lineTo(0.000000, 0.505263).lineTo(0.000000, 0.473684).lineTo(0.000000, 0.015789).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.601562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
