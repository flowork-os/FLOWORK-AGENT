loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002023, -0.004885), (0.006908, -0.006908)).lineTo(0.102467, -0.006908).threePointArc((0.107352, -0.004885), (0.109375, 0.000000)).lineTo(0.109375, 0.095559).threePointArc((0.107352, 0.100444), (0.102467, 0.102467)).lineTo(0.006908, 0.102467).threePointArc((0.002023, 0.100444), (0.000000, 0.095559)).lineTo(0.000000, 0.000000).close()
