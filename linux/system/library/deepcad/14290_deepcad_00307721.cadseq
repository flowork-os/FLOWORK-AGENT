import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.006086, 0.000000).lineTo(0.006086, 0.001727).lineTo(0.004359, 0.001727).lineTo(0.004359, 0.006086).lineTo(0.006086, 0.006086).lineTo(0.006086, 0.007812).lineTo(0.000000, 0.007812).lineTo(0.000000, 0.006086).lineTo(0.001727, 0.006086).lineTo(0.001727, 0.001727).lineTo(0.000000, 0.001727).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
