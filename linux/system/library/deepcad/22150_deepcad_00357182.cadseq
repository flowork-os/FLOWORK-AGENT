# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00357182" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, 0.000000, -0.500000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.320312, 0.000000).lineTo(1.320312, 0.986760).lineTo(0.000000, 0.986760).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.585938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.168421).lineTo(0.000000, 1.168421).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(1.405263, 0.094737).lineTo(1.405263, 1.073684).lineTo(0.094737, 1.073684).lineTo(0.094737, 0.094737).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.031250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.055510, -0.000740).threePointArc((0.025804, 0.032792), (0.061431, 0.059951)).lineTo(0.000000, 0.070312).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.031250, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.023438, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.031579, 0.000000).circle(0.030921)
loop5=wp_sketch3.moveTo(0.031579, 0.000000).circle(0.019737)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.031250, both=True)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
