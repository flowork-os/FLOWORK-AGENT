# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00302546" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.252632).lineTo(0.000000, 0.252632).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.126316, 0.126316).circle(0.031579)
loop2=wp_sketch0.moveTo(0.623684, 0.126316).circle(0.031579)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.032566, 0.000000).circle(0.032566)
loop4=wp_sketch1.moveTo(0.219079, -0.062171).threePointArc((0.281250, 0.000000), (0.219079, 0.062171)).lineTo(0.032566, 0.062171).threePointArc((0.094737, 0.000000), (0.032566, -0.062171)).close()
loop5=wp_sketch1.moveTo(0.219079, 0.000000).circle(0.032566)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch2.moveTo(0.031579, 0.000000).circle(0.031579)
solid2=wp_sketch2.add(loop6).extrude(0.093750)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch3.moveTo(0.031579, 0.000000).circle(0.031579)
solid3=wp_sketch3.add(loop7).extrude(-0.062500)
solid_temp=solid3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch3.moveTo(0.031579, 0.000000).circle(0.031579)
solid3=wp_sketch3.add(loop7).extrude(-0.031250)
solid_temp=solid_temp.union(solid3)
solid=solid.union(solid_temp)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch4.moveTo(0.031250, 0.000000).circle(0.031250)
loop9=wp_sketch4.moveTo(0.531250, -0.062500).threePointArc((0.593750, 0.000000), (0.531250, 0.062500)).lineTo(0.031250, 0.062500).threePointArc((0.093750, 0.000000), (0.031250, -0.062500)).close()
loop10=wp_sketch4.moveTo(0.531250, 0.000000).circle(0.031250)
solid4=wp_sketch4.add(loop8).add(loop9).add(loop10).extrude(0.062500)
solid=solid.union(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
