# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00316727" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.304688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.921875, 0.000000).lineTo(0.921875, 0.252303).lineTo(0.000000, 0.252303).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.174671, 0.126151).circle(0.087336)
loop2=wp_sketch0.moveTo(0.456086, 0.126151).circle(0.087336)
loop3=wp_sketch0.moveTo(0.756908, 0.126151).circle(0.087336)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.226562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.125000, -0.304688), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch1.moveTo(0.140789, 0.000000).lineTo(0.140789, 0.835938).lineTo(0.000000, 0.835938).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch1.moveTo(0.079194, 0.193586).circle(0.043997)
loop6=wp_sketch1.moveTo(0.079194, 0.395970).circle(0.043997)
loop7=wp_sketch1.moveTo(0.079194, 0.642352).circle(0.043997)
solid1=wp_sketch1.add(loop4).add(loop5).add(loop6).add(loop7).extrude(-0.031250)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
