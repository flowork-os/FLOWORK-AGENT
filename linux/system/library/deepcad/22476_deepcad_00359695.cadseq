import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.142105, -0.442105).lineTo(0.521053, -0.710526).lineTo(0.978947, -0.710526).lineTo(1.357895, -0.442105).lineTo(1.500000, 0.000000).lineTo(1.357895, 0.442105).lineTo(0.978947, 0.710526).lineTo(0.757895, 0.710526).lineTo(0.521053, 0.710526).lineTo(0.142105, 0.442105).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.442105, -0.221053).lineTo(0.631579, -0.363158).lineTo(0.868421, -0.363158).lineTo(1.057895, -0.221053).lineTo(1.121053, 0.000000).lineTo(1.057895, 0.221053).lineTo(0.868421, 0.363158).lineTo(0.757895, 0.363158).lineTo(0.631579, 0.363158).lineTo(0.442105, 0.221053).lineTo(0.378947, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.539062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
