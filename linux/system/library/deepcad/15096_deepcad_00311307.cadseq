# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00311307" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.347368, -0.593421).lineTo(1.027632, -0.593421).lineTo(1.375000, 0.000000).lineTo(1.027632, 0.593421).lineTo(0.347368, 0.593421).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.361842, -0.564474).lineTo(1.013158, -0.564474).lineTo(1.331579, 0.000000).lineTo(1.013158, 0.564474).lineTo(0.361842, 0.564474).lineTo(0.043421, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.327632, -0.559704).lineTo(0.969243, -0.559704).lineTo(1.296875, 0.000000).lineTo(0.969243, 0.559704).lineTo(0.327632, 0.559704).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.039062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
