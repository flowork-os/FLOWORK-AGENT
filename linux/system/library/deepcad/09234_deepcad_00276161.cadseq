# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00276161" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.062500), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.134211).lineTo(0.000000, 0.134211).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.086842, 0.063158).circle(0.039474)
loop2=wp_sketch0.moveTo(0.260526, 0.063158).circle(0.039474)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.132812, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.695312, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.411595, 0.000000).lineTo(0.411595, 0.507812).lineTo(0.283306, 0.507812).lineTo(0.283306, 0.133635).lineTo(0.000000, 0.133635).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.347451, 0.443668).circle(0.032072)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.265625, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
