# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272531" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, 0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.289062, 0.000000).lineTo(1.289062, 0.325658).lineTo(1.221217, 0.325658).lineTo(0.094984, 0.325658).lineTo(0.000000, 0.325658).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.963405, 0.081414).lineTo(0.963405, 0.244243).lineTo(0.162829, 0.244243).lineTo(0.162829, 0.081414).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, 0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(1.125000, 0.000000).threePointArc((0.562500, 0.346602), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.078125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
