wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.018499, -0.044659), (0.063158, -0.063158)).lineTo(1.436842, -0.063158).threePointArc((1.481501, -0.044659), (1.500000, 0.000000)).lineTo(1.500000, 0.852632).threePointArc((1.478231, 0.889396), (1.436842, 0.900000)).lineTo(0.063158, 0.900000).threePointArc((0.021769, 0.889396), (0.000000, 0.852632)).lineTo(0.000000, 0.000000).close()
