wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.347985, -0.457365), (0.695970, 0.000000)).lineTo(0.561266, 0.493914).threePointArc((0.347985, 0.656189), (0.134704, 0.493914)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.162178, -0.849745), (0.389145, -0.014967)).lineTo(0.389145, 0.029934).threePointArc((0.347985, 0.071094), (0.306826, 0.029934)).lineTo(0.306826, -0.014967).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.218750)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
