loop3=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.024368, -0.113203), (0.091365, -0.207648)).lineTo(0.490049, -0.207648).threePointArc((0.557047, -0.113203), (0.581414, 0.000000)).lineTo(0.581414, 0.390378).lineTo(0.789062, 0.390378).lineTo(0.789062, 0.539885).lineTo(0.157812, 0.539885).lineTo(0.157812, 0.390378).lineTo(0.365461, 0.390378).lineTo(0.365461, 0.000000).threePointArc((0.245025, -0.120436), (0.124589, 0.000000)).lineTo(0.000000, 0.000000).close()
