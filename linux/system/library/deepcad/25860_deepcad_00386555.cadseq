# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00386555" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, 0.117188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.007812, 0.000658).threePointArc((0.003902, 0.000377), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, 0.000000, -0.054688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.677632, -0.059293).threePointArc((0.804963, 0.050498), (0.686102, 0.169408)).lineTo(0.677632, 0.169408).lineTo(0.000000, 0.118586).threePointArc((-0.059293, 0.059293), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.033882, 0.008470).lineTo(0.626809, -0.033882).lineTo(0.677632, -0.042352).threePointArc((0.788406, 0.059293), (0.677632, 0.160938)).lineTo(0.000000, 0.101645).threePointArc((-0.042352, 0.059293), (0.000000, 0.016941)).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.054688)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
