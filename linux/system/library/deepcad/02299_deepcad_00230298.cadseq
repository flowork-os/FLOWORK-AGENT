wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, -0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.013079, -0.031576), (0.044655, -0.044655)).lineTo(1.369408, -0.044655).threePointArc((1.400983, -0.031576), (1.414062, 0.000000)).lineTo(1.414062, 0.833553).threePointArc((1.400983, 0.865128), (1.369408, 0.878207)).lineTo(0.044655, 0.878207).threePointArc((0.013079, 0.865128), (0.000000, 0.833553)).lineTo(0.000000, 0.000000).close()
