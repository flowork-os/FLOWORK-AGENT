wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.125000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.303125, 0.000000).lineTo(0.303125, 0.119655).lineTo(0.358964, 0.000000).lineTo(0.598273, 0.000000).lineTo(0.598273, 0.757812).lineTo(0.343010, 0.757812).lineTo(0.343010, 0.598273).lineTo(0.295148, 0.757812).lineTo(0.000000, 0.757812).lineTo(0.000000, 0.000000).close()
