# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00372980" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.531250, 0.000000, -0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.070312, 0.000000).lineTo(1.070312, 0.540789).lineTo(0.000000, 0.540789).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.156250, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, 0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.031086, 0.000000).lineTo(0.031086, 0.031086).lineTo(0.984375, 0.196875).lineTo(0.953289, 0.373026).threePointArc((0.844490, 0.450740), (0.766776, 0.341941)).lineTo(0.797862, 0.196875).lineTo(0.000000, 0.051809).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.109375, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.351562, 0.000000, 0.625000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.126316, 0.000000).circle(0.126316)
solid2=wp_sketch2.add(loop2).extrude(0.078125, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.398438, 0.085938, -0.265625), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop3=wp_sketch3.moveTo(0.026480, 0.000000).lineTo(0.026480, 0.179688).lineTo(0.000000, 0.179688).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.195312)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
