# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.289062, -0.125000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch5.moveTo(0.118421, 0.000000).circle(0.118421)
