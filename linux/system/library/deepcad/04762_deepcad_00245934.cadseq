loop3=wp_sketch3.moveTo(0.539062, 0.000000).lineTo(0.539062, 0.300740).lineTo(0.000000, 0.300740).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.562500)
