wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.046875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.009868, 0.000000).lineTo(0.009868, 0.005428).lineTo(0.035033, 0.010362).threePointArc((0.035800, 0.011075), (0.036513, 0.011842)).lineTo(0.041447, 0.037007).lineTo(0.046875, 0.037007).lineTo(0.046875, 0.046875).threePointArc((0.013729, 0.033146), (0.000000, 0.000000)).close()
