import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.601562, 0.000000, 0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.369901, 0.000000).lineTo(0.384128, 0.014227).lineTo(0.981661, 0.014227).lineTo(0.981661, 0.000000).lineTo(1.351562, 0.000000).lineTo(1.351562, 0.099589).lineTo(0.981661, 0.099589).lineTo(0.981661, 0.142270).lineTo(0.369901, 0.142270).lineTo(0.369901, 0.099589).lineTo(0.000000, 0.099589).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.406250, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
