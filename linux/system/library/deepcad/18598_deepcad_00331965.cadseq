# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00331965" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, 0.000000, -0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.202056).threePointArc((-0.018317, 0.246278), (0.025905, 0.227961)).lineTo(0.435197, 0.227961).threePointArc((0.482010, 0.252532), (0.466283, 0.202056)).lineTo(0.466283, 0.000000).threePointArc((0.482010, -0.050476), (0.435197, -0.025905)).lineTo(0.025905, -0.025905).threePointArc((-0.018317, -0.044222), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, -0.070312, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.122368, 0.000000).circle(0.122368)
solid1=wp_sketch1.add(loop1).extrude(0.585938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
