# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00389801" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.525658, 0.000000).lineTo(0.525658, 0.391447).lineTo(0.536842, 0.391447).lineTo(0.536842, 0.000000).lineTo(1.062500, 0.000000).lineTo(1.062500, 0.771711).lineTo(0.000000, 0.771711).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.161184, 0.000000).lineTo(0.161184, 0.765625).lineTo(0.000000, 0.765625).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.080592, 0.193421).circle(0.024178)
loop3=wp_sketch1.moveTo(0.080592, 0.604441).circle(0.024178)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.007812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.476562, 0.000000, -0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.161184, 0.000000).lineTo(0.161184, 0.765625).lineTo(0.000000, 0.765625).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.080592, 0.193421).circle(0.024178)
loop6=wp_sketch2.moveTo(0.080592, 0.604441).circle(0.024178)
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).extrude(0.007812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
