# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00329530" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.039474, 0.000000).circle(0.039474)
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.039474, 0.000000).circle(0.039474)
loop2=wp_sketch1.moveTo(0.039474, 0.000000).circle(0.029605)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.273438)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.031579, 0.000000).circle(0.031579)
loop4=wp_sketch2.moveTo(0.031579, 0.000000).circle(0.026974)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(-0.148438)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch3.moveTo(0.027632, 0.000000).circle(0.027632)
loop6=wp_sketch3.moveTo(0.027632, 0.000000).circle(0.026480)
solid3=wp_sketch3.add(loop5).add(loop6).extrude(-0.078125)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.750000, 0.000000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop7=wp_sketch4.moveTo(0.039474, 0.000000).circle(0.039474)
loop8=wp_sketch4.moveTo(0.039474, 0.000000).circle(0.024671)
solid4=wp_sketch4.add(loop7).add(loop8).extrude(-0.054688)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
