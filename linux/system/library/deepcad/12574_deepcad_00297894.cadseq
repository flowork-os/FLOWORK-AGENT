# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00297894" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, 0.539062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.219572, 0.000000).lineTo(0.219572, -0.380592).lineTo(0.219572, -0.541612).lineTo(0.849013, -0.541612).lineTo(0.849013, -0.644079).lineTo(0.219572, -0.644079).lineTo(0.219572, -0.746546).lineTo(1.390625, -0.746546).lineTo(1.390625, -0.322039).lineTo(0.541612, 0.102467).lineTo(0.000000, 0.102467).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.024671, -0.541612).circle(0.102467)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.210938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, -0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.213158, 0.000000).lineTo(0.213158, 0.110526).lineTo(0.213158, 0.213158).lineTo(0.213158, 0.378947).lineTo(0.213158, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.640625, 0.000000).lineTo(0.640625, 0.107895).lineTo(0.000000, 0.107895).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
