import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.051316, 0.000000).circle(0.051316)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009913, -0.022752), (0.029934, -0.037418)).lineTo(0.045970, -0.005345).threePointArc((0.050781, -0.007201), (0.055592, -0.005345)).lineTo(0.071628, -0.037418).threePointArc((0.087908, -0.021741), (0.094079, 0.000000)).lineTo(0.057730, -0.001069).threePointArc((0.057035, 0.003497), (0.053454, 0.006414)).lineTo(0.072697, 0.037418).threePointArc((0.050781, 0.043338), (0.028865, 0.037418)).lineTo(0.048109, 0.006414).threePointArc((0.044527, 0.003497), (0.043832, -0.001069)).lineTo(0.007484, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.679688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
