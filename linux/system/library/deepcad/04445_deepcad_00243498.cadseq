loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.091722, -0.221436), (0.313158, -0.313158)).lineTo(0.738158, -0.313158).threePointArc((0.965186, -0.223752), (1.062500, 0.000000)).lineTo(1.062500, 0.425000).threePointArc((0.965186, 0.648752), (0.738158, 0.738158)).lineTo(0.313158, 0.738158).threePointArc((0.091722, 0.646436), (0.000000, 0.425000)).lineTo(0.000000, 0.000000).close()
