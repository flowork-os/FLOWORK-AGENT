solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.094737, 0.000000).lineTo(0.094737, 0.221053).lineTo(0.647368, 0.221053).lineTo(0.647368, 0.268421).lineTo(0.852632, 0.268421).lineTo(0.852632, 0.221053).lineTo(1.405263, 0.221053).lineTo(1.405263, 0.000000).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.300000).threePointArc((1.474400, 0.317144), (1.468421, 0.347368)).lineTo(0.031579, 0.347368).threePointArc((0.025600, 0.317144), (0.000000, 0.300000)).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch1.moveTo(0.126316, 0.284211).circle(0.015789)
