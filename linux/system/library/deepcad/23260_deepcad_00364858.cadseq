wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.022330, -0.009249), (0.031579, -0.031579)).lineTo(1.468421, -0.031579).threePointArc((1.477670, -0.009249), (1.500000, 0.000000)).lineTo(1.500000, 0.300000).lineTo(1.405263, 0.300000).lineTo(1.405263, 0.094737).lineTo(0.094737, 0.094737).lineTo(0.094737, 0.300000).lineTo(0.000000, 0.300000).lineTo(0.000000, 0.000000).close()
