# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00286450" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.181579, 0.000000).circle(0.177796)
loop1=wp_sketch0.moveTo(0.181579, 0.000000).circle(0.136184)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.273438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.554688, 0.000000, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.890625, 0.093750).threePointArc((0.792360, 0.182812), (0.890625, 0.271875)).lineTo(0.000000, 0.356250).threePointArc((0.161443, 0.178125), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.609375, 0.131250).threePointArc((0.656250, 0.178125), (0.609375, 0.225000)).lineTo(0.253125, 0.225000).threePointArc((0.206250, 0.178125), (0.253125, 0.131250)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.179688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.242188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.090789, 0.000000).circle(0.088898)
loop5=wp_sketch2.moveTo(0.090789, 0.000000).circle(0.045395)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.226562)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
