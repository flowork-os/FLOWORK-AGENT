# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00321106" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, -0.281250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.837500, 0.000000).threePointArc((1.046875, 0.209375), (0.837500, 0.418750)).lineTo(0.000000, 0.418750).threePointArc((0.209375, 0.209375), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.210938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.015625, -0.171875, 0.210938), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.418750, 0.000000).threePointArc((0.523438, 0.104687), (0.418750, 0.209375)).lineTo(0.000000, 0.209375).threePointArc((0.104687, 0.104687), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(-0.210938)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
