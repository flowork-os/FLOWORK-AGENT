import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.265625, -0.687500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.019366, -0.046753), (0.066118, -0.066118)).lineTo(0.330592, -0.066118).threePointArc((0.377345, -0.046753), (0.396711, 0.000000)).lineTo(0.396711, 0.980757).threePointArc((0.377345, 1.027509), (0.330592, 1.046875)).lineTo(0.066118, 1.046875).threePointArc((0.019366, 1.027509), (0.000000, 0.980757)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.198355, 0.969737).circle(0.033059)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.257812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
