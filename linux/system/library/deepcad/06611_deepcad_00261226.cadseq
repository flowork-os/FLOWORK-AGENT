# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00261226" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.757895, 0.000000).circle(0.757895)
loop1=wp_sketch0.moveTo(0.363158, -0.142105).threePointArc((0.426126, -0.160201), (0.473684, -0.205263)).threePointArc((0.750000, -0.346480), (1.026316, -0.205263)).threePointArc((1.073874, -0.160201), (1.136842, -0.142105)).lineTo(1.263158, -0.142105).lineTo(1.263158, 0.142105).lineTo(1.136842, 0.142105).threePointArc((1.073874, 0.160201), (1.026316, 0.205263)).threePointArc((0.750000, 0.346480), (0.473684, 0.205263)).threePointArc((0.426126, 0.160201), (0.363158, 0.142105)).lineTo(0.236842, 0.142105).lineTo(0.236842, -0.142105).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.414062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
