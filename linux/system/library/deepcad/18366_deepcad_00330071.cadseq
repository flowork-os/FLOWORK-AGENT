# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00330071" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.546875, 0.000000, -0.460938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.203947, 0.000000).lineTo(0.203947, 0.573602).lineTo(0.101974, 0.573602).lineTo(0.101974, 0.637336).lineTo(0.203947, 0.637336).lineTo(0.203947, 1.210938).lineTo(0.000000, 1.210938).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
