# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00231948" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, 0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.055781, -0.274146), (0.176151, -0.430592)).lineTo(0.890543, -0.430592).threePointArc((0.874129, 0.109751), (0.499095, 0.499095)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.176151, -0.176151).circle(0.127220)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.625000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
