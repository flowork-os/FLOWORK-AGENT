import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, -0.197368).lineTo(0.407072, -0.197368).lineTo(0.407072, 0.302220).lineTo(0.585938, 0.302220).lineTo(0.585938, 0.388569).lineTo(0.037007, 0.388569).lineTo(0.037007, 0.302220).lineTo(0.252878, 0.302220).lineTo(0.252878, -0.080181).lineTo(0.104852, -0.080181).lineTo(0.104852, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.164062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
