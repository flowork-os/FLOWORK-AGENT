# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00240149" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.523438, -0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.051151, 0.000000).lineTo(1.051151, 1.203125).lineTo(0.000000, 1.203125).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.013158, 0.050658).lineTo(1.013158, 1.152467).lineTo(0.050658, 1.152467).lineTo(0.050658, 0.050658).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
