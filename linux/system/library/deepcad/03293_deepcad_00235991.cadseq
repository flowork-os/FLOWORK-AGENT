# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.054688, -0.179688, 0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch4.moveTo(0.001069, -0.002138).lineTo(0.038487, -0.002138).lineTo(0.038487, -0.045970).lineTo(0.073766, -0.047039).lineTo(0.101562, -0.004276).lineTo(0.082319, 0.033141).lineTo(0.021382, 0.033141).lineTo(0.000000, 0.000000).close()
