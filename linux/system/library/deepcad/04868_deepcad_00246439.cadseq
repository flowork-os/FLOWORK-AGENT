import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.070312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.079934, 0.000000).lineTo(0.079934, -0.213158).lineTo(0.079934, -0.293092).lineTo(0.470724, -0.293092).lineTo(0.470724, -0.373026).lineTo(0.701645, -0.373026).lineTo(0.843750, -0.373026).lineTo(0.843750, -0.230921).lineTo(0.843750, -0.097697).lineTo(0.230921, 0.071053).lineTo(0.000000, 0.071053).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.701645, -0.230921).circle(0.062171)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.281250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.079934, 0.000000).lineTo(0.079934, 0.210938).lineTo(0.000000, 0.210938).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.328125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.445312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.081168, 0.000000).lineTo(0.081168, 0.081168).lineTo(0.081168, 0.164062).lineTo(0.000000, 0.164062).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.328125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.671875, 0.000000, -0.445312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.390625, 0.000000).lineTo(0.390625, 0.082237).lineTo(0.000000, 0.082237).lineTo(0.000000, 0.000000).close()
