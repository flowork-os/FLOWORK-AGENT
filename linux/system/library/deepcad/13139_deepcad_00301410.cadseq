wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.323684, 0.000000).threePointArc((0.347368, 0.023684), (0.323684, 0.047368)).lineTo(0.078947, 0.086842).threePointArc((0.050407, 0.103190), (0.039474, 0.134211)).lineTo(0.039474, 0.615789).threePointArc((0.050407, 0.646810), (0.078947, 0.663158)).lineTo(0.331579, 0.702632).threePointArc((0.349633, 0.729983), (0.323684, 0.750000)).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.625000, both=True)
solid=solid0

