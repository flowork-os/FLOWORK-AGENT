import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.718750, 0.000000, 0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.031982, -0.105344), (0.042928, -0.186020)).lineTo(1.359375, -0.186020).lineTo(1.359375, -0.143092).lineTo(0.042928, -0.143092).threePointArc((0.007401, -0.089402), (0.028618, -0.028618)).lineTo(0.500822, 0.429276).lineTo(0.457895, 0.457895).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.250000, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
