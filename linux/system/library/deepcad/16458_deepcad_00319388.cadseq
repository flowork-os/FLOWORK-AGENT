# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00319388" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.210938, 0.000000, -0.554688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.700411, 0.000000).lineTo(0.700411, 0.700411).lineTo(0.343339, 1.304688).lineTo(0.000000, 0.700411).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.260937, 0.260937).circle(0.137336)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.703125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
