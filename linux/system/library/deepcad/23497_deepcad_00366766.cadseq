# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.000000, 0.007812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.034172, -0.106840), (0.133882, -0.158224)).lineTo(0.937171, -0.206908).threePointArc((1.153353, -0.006086), (0.937171, 0.194737)).lineTo(0.474671, 0.158224).threePointArc((0.327321, 0.204134), (0.255592, 0.340789)).lineTo(0.243421, 0.559868).threePointArc((0.139967, 0.655972), (0.036513, 0.559868)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.146053, -0.012171).circle(0.036513)
loop2=wp_sketch0.moveTo(0.146053, 0.559868).circle(0.036513)
loop3=wp_sketch0.moveTo(0.401645, -0.012171).circle(0.036513)
loop4=wp_sketch0.moveTo(0.949342, -0.012171).circle(0.048684)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.023438, both=True)
solid=solid0

