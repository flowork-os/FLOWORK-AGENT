wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.126316, -0.126316).lineTo(0.252632, -0.126316).lineTo(0.252632, -0.213158).lineTo(0.307895, -0.213158).lineTo(0.307895, -0.126316).lineTo(0.378947, -0.126316).lineTo(0.378947, 0.418421).lineTo(0.592105, 0.631579).lineTo(0.592105, 0.750000).lineTo(0.228947, 0.750000).lineTo(0.228947, 0.631579).lineTo(0.094737, 0.631579).lineTo(0.000000, 0.536842).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.410526, 0.631579).circle(0.015789)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.148438)
