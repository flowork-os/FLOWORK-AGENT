wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.015625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.023191, -0.626151).threePointArc((0.055663, -0.701903), (0.131414, -0.734375)).lineTo(0.587500, -0.734375).threePointArc((0.663252, -0.701903), (0.695724, -0.626151)).lineTo(0.718914, 0.000000).threePointArc((0.714498, 0.011044), (0.703454, 0.015461)).lineTo(0.015461, 0.015461).threePointArc((0.004417, 0.011044), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
