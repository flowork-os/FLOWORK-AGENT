loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.003902, -0.009420), (0.013322, -0.013322)).lineTo(0.197615, -0.013322).threePointArc((0.207035, -0.009420), (0.210938, 0.000000)).lineTo(0.210938, 0.184293).threePointArc((0.207035, 0.193713), (0.197615, 0.197615)).lineTo(0.013322, 0.197615).threePointArc((0.003902, 0.193713), (0.000000, 0.184293)).lineTo(0.000000, 0.000000).close()
