import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, 0.000000, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.742434, 0.000000).lineTo(0.742434, 0.210691).lineTo(0.531743, 0.210691).lineTo(0.531743, 0.742434).lineTo(0.742434, 0.742434).lineTo(0.742434, 0.953125).lineTo(0.000000, 0.953125).lineTo(0.000000, 0.742434).lineTo(0.210691, 0.742434).lineTo(0.210691, 0.210691).lineTo(0.000000, 0.210691).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.632812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
