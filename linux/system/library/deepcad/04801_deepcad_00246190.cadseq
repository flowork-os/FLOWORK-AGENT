wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.226562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.025725, -0.062104), (0.087829, -0.087829)).lineTo(0.607484, -0.087829).threePointArc((0.669588, -0.062104), (0.695312, 0.000000)).lineTo(0.695312, 0.439145).threePointArc((0.669588, 0.501249), (0.607484, 0.526974)).lineTo(0.087829, 0.526974).threePointArc((0.025725, 0.501249), (0.000000, 0.439145)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.085938)
solid=solid0

