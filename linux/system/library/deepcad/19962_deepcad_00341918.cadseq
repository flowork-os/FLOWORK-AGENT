wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.086311, -0.406068), (0.333882, -0.739309)).lineTo(0.369655, -0.739309).threePointArc((0.112533, -0.407521), (0.011924, 0.000000)).threePointArc((0.566406, 0.554482), (1.120888, 0.000000)).threePointArc((1.017913, -0.406375), (0.763158, -0.739309)).lineTo(0.787007, -0.739309).threePointArc((1.040539, -0.407368), (1.132812, 0.000000)).threePointArc((0.566406, 0.566406), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.125000)
solid=solid0

if __name__ == '__main__':
