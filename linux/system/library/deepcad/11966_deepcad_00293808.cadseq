# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00293808" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.134211, -0.195724).lineTo(0.374671, -0.206908).lineTo(0.531250, -0.033553).lineTo(0.492105, 0.201316).lineTo(0.285197, 0.318750).lineTo(0.067105, 0.229276).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.406250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.257812, -0.351562, 0.179688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(0.985278, 0.000000, 0.170962)))
loop1=wp_sketch1.moveTo(0.185033, 0.000000).lineTo(0.185033, 0.195312).lineTo(0.000000, 0.195312).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.093750)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.375000, 0.140625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.199656, -0.053894), (0.319737, 0.114474)).threePointArc((0.049550, 0.365366), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.539062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.312500, 0.359375, 0.539062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.013816, -0.082895).lineTo(0.086842, -0.122368).lineTo(0.163816, -0.090789).lineTo(0.187500, -0.009868).lineTo(0.138158, 0.057237).lineTo(0.055263, 0.063158).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.710938)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
