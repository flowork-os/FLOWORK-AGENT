import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.695312, -0.750000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.227632, 0.000000).lineTo(0.227632, 0.754030).lineTo(0.611760, 0.355674).lineTo(0.995888, 0.754030).lineTo(0.995888, 0.000000).lineTo(1.223520, 0.000000).lineTo(1.223520, 1.351562).lineTo(0.995888, 1.351562).lineTo(0.583306, 0.725576).lineTo(0.184951, 1.351562).lineTo(0.000000, 1.351562).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.296875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
