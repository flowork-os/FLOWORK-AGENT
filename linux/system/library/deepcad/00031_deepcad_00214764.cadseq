# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00214764" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.062500, -0.507812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.506579, 0.000000).lineTo(0.539474, 0.111842).lineTo(0.625000, 0.111842).lineTo(0.625000, 0.118421).lineTo(0.000000, 0.118421).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, -0.062500, -0.507812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.117188, 0.000000).lineTo(0.117188, 0.111020).lineTo(0.029605, 0.111020).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.064145, 0.061678).circle(0.014803)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.015625)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
