import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, -0.445312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.059128, 0.000000).threePointArc((1.238362, 0.317754), (0.967599, 0.562253)).threePointArc((0.947530, 0.773491), (0.836842, 0.954523)).lineTo(0.000000, 0.954523).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.065378, 0.889145).circle(0.026151)
loop2=wp_sketch0.moveTo(0.496875, 0.627632).circle(0.130757)
loop3=wp_sketch0.moveTo(0.496875, 0.065378).circle(0.026151)
loop4=wp_sketch0.moveTo(0.902220, 0.523026).circle(0.026151)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
