import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.299342, 0.000000).lineTo(0.299342, 0.092105).lineTo(0.211842, 0.092105).lineTo(0.211842, 0.340789).lineTo(0.299342, 0.340789).lineTo(0.299342, 0.437500).lineTo(0.000000, 0.437500).lineTo(0.000000, 0.340789).lineTo(0.087500, 0.340789).lineTo(0.087500, 0.092105).lineTo(0.000000, 0.092105).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.296875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
