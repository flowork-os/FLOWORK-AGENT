# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00313375" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, 0.000000, -0.601562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.312500, 0.000000).lineTo(1.312500, 0.980921).lineTo(0.980921, 0.980921).lineTo(0.663158, 0.607895).lineTo(0.331579, 0.980921).lineTo(0.000000, 0.980921).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.328125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
