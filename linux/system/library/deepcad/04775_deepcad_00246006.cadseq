# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00246006" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.265625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.138405, 0.000000).lineTo(0.138405, -0.507484).lineTo(0.815049, -0.507484).lineTo(0.815049, -0.645888).lineTo(1.460938, -0.645888).lineTo(1.460938, -0.169161).lineTo(0.399836, 0.123026).lineTo(0.000000, 0.123026).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.122615, -0.307566).circle(0.107648)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.382812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.136513, 0.000000).lineTo(0.136513, 0.136513).lineTo(0.136513, 0.648438).lineTo(0.000000, 0.648438).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.570312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.609375, 0.000000, -0.382812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.671875, 0.000000).lineTo(0.671875, 0.141447).lineTo(0.000000, 0.141447).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.570312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
