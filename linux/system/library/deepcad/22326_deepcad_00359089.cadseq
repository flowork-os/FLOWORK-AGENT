loop6=wp_sketch3.moveTo(0.000000, 0.000000).threePointArc((0.018547, -0.044776), (0.063322, -0.063322)).lineTo(0.177303, -0.063322).threePointArc((0.145532, 0.171409), (0.227961, -0.050658)).lineTo(0.772533, 0.189967).threePointArc((0.554037, 0.441259), (0.861184, 0.569901)).lineTo(0.278618, 1.152467).threePointArc((0.111837, 0.945549), (0.177303, 1.203125)).lineTo(0.063322, 1.203125).threePointArc((0.018547, 1.184578), (0.000000, 1.139803)).lineTo(0.000000, 0.569901).lineTo(0.000000, 0.000000).close()
