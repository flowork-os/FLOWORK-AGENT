# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, -0.046875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.754934, 0.000000).lineTo(0.754934, 0.260033).lineTo(0.570395, 0.369079).lineTo(0.570395, 0.469737).lineTo(0.754934, 0.578783).lineTo(0.754934, 0.796875).lineTo(0.562007, 0.796875).lineTo(0.385855, 0.712993).lineTo(0.109046, 0.712993).lineTo(0.000000, 0.369079).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
