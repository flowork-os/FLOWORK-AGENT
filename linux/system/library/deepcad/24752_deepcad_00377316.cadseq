# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00377316" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.110526, 0.000000).lineTo(0.110526, 0.457895).lineTo(0.805263, 0.584211).lineTo(0.805263, 0.757895).lineTo(0.110526, 0.757895).lineTo(0.110526, 1.326316).lineTo(0.584211, 1.326316).lineTo(0.584211, 1.421053).lineTo(0.110526, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.234375, both=True)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
