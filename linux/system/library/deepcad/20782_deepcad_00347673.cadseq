# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.296875, 0.101562, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop6=wp_sketch2.moveTo(0.106908, 0.000000).lineTo(0.106908, 0.203125).lineTo(0.000000, 0.203125).lineTo(0.000000, 0.000000).close()
