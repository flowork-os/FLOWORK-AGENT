wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.515625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.386842, 0.000000).threePointArc((0.418948, -0.007960), (0.442105, -0.031579)).lineTo(0.639474, -0.426316).threePointArc((0.714474, -0.453947), (0.742105, -0.378947)).lineTo(0.544737, 0.015789).threePointArc((0.480330, 0.089475), (0.386842, 0.118421)).lineTo(0.000000, 0.118421).threePointArc((-0.059211, 0.059211), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.055263).circle(0.007895)
loop2=wp_sketch0.moveTo(0.694737, -0.402632).circle(0.007895)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438)
solid=solid0

