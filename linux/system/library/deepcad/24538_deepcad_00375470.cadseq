loop4=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.369642, -0.352472), (0.823191, -0.117599)).lineTo(0.192434, -0.117599).close()
loop5=wp_sketch2.moveTo(0.694901, 0.213816).circle(0.149671)
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.289062)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.304688, 0.000000, 0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch3.moveTo(0.067105, 0.000000).circle(0.067105)
solid3=wp_sketch3.add(loop6).extrude(0.289062)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.062500, 0.000000, 0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop7=wp_sketch4.moveTo(0.067105, 0.000000).circle(0.067105)
