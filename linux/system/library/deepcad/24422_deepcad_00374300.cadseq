import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, -0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.251316, 0.047122).threePointArc((0.746094, 0.635145), (1.240872, 0.047122)).lineTo(1.476480, 0.000000).threePointArc((0.738240, 0.877368), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.109951, 0.125658).circle(0.047122)
loop2=wp_sketch0.moveTo(0.738240, 0.691118).circle(0.047122)
loop3=wp_sketch0.moveTo(1.366530, 0.125658).circle(0.047122)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, -0.062500, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch1.moveTo(0.250000, 0.000000).threePointArc((0.243794, 0.077632), (0.250000, 0.155263)).lineTo(0.000000, 0.155263).threePointArc((-0.004291, 0.077632), (0.000000, 0.000000)).close()
loop5=wp_sketch1.moveTo(0.121053, 0.078947).circle(0.047368)
solid1=wp_sketch1.add(loop4).add(loop5).extrude(0.062500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.492188, -0.062500, -0.078125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch2.moveTo(0.252385, 0.000000).threePointArc((0.256735, 0.078701), (0.252385, 0.157401)).lineTo(0.000000, 0.157401).threePointArc((0.006291, 0.078701), (0.000000, 0.000000)).close()
loop7=wp_sketch2.moveTo(0.132977, 0.078701).circle(0.046135)
solid2=wp_sketch2.add(loop6).add(loop7).extrude(0.062500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, -0.062500, 0.695312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop8=wp_sketch3.moveTo(0.031579, 0.000000).circle(0.031579)
solid3=wp_sketch3.add(loop8).extrude(-0.062500)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.007812, 0.000000, 0.625000), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop9=wp_sketch4.moveTo(0.007895, 0.000000).circle(0.007895)
solid4=wp_sketch4.add(loop9).extrude(-0.062500)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
