solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.179688)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, -0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.359375, 0.000000).lineTo(0.359375, 0.359375).lineTo(0.000000, 0.359375).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.268586, 0.090789).lineTo(0.268586, 0.181579).threePointArc((0.179688, 0.092681), (0.090789, 0.181579)).lineTo(0.090789, 0.090789).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.179688)
