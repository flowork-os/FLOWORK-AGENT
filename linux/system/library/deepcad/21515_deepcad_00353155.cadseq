# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.359375, 0.000000).lineTo(0.359375, 0.359375).lineTo(0.000000, 0.359375).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch3.moveTo(0.181579, 0.090789).threePointArc((0.270477, 0.179688), (0.181579, 0.268586)).lineTo(0.090789, 0.268586).lineTo(0.090789, 0.090789).close()
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.179688)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.031250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch4.moveTo(0.359375, 0.000000).lineTo(0.359375, 0.359375).lineTo(0.000000, 0.359375).lineTo(0.000000, 0.000000).close()
loop9=wp_sketch4.moveTo(0.268586, 0.090789).lineTo(0.268586, 0.268586).lineTo(0.090789, 0.268586).lineTo(0.090789, 0.090789).close()
