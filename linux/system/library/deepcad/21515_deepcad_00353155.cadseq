import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.390625, 0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.359375, 0.000000).lineTo(0.359375, 0.359375).lineTo(0.000000, 0.359375).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.090789, 0.177796).threePointArc((0.181579, 0.090789), (0.268586, 0.181579)).lineTo(0.268586, 0.268586).lineTo(0.087007, 0.268586).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.179688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.390625, -0.359375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.359375, 0.000000).lineTo(0.359375, 0.359375).lineTo(0.000000, 0.359375).lineTo(0.000000, 0.000000).close()
