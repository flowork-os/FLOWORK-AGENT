# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00245869" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, -0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.012500, 0.000000).threePointArc((1.187500, 0.175000), (1.012500, 0.350000)).lineTo(0.000000, 0.350000).threePointArc((-0.175000, 0.175000), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.025000, 0.162500).circle(0.125000)
loop2=wp_sketch0.moveTo(1.012500, 0.112500).threePointArc((1.080812, 0.161854), (1.025000, 0.225000)).lineTo(0.712500, 0.225000).threePointArc((0.656250, 0.168750), (0.712500, 0.112500)).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.289062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.382812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.213158, 0.000000).circle(0.213158)
solid1=wp_sketch1.add(loop3).extrude(0.734375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.134211, 0.000000).circle(0.134211)
solid2=wp_sketch2.add(loop4).extrude(0.992188)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
