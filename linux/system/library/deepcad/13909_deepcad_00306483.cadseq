# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306483" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.331579).threePointArc((0.655263, 0.426316), (0.560526, 0.331579)).lineTo(0.560526, 0.189474).threePointArc((0.539715, 0.139232), (0.489474, 0.118421)).lineTo(0.378947, 0.118421).lineTo(0.260526, 0.118421).threePointArc((0.210285, 0.139232), (0.189474, 0.189474)).lineTo(0.189474, 0.331579).threePointArc((0.094737, 0.426316), (0.000000, 0.331579)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.094737, 0.331579).circle(0.047368)
loop2=wp_sketch0.moveTo(0.655263, 0.331579).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.054688, -0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.051812, -0.021461), (0.073273, -0.073273)).lineTo(0.073273, -0.113240).threePointArc((0.101159, -0.187223), (0.173191, -0.219819)).lineTo(0.459622, -0.219819).threePointArc((0.531654, -0.187223), (0.559539, -0.113240)).lineTo(0.559539, -0.073273).threePointArc((0.581001, -0.021461), (0.632812, 0.000000)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.459622, -0.159868).threePointArc((0.506250, -0.113240), (0.459622, -0.066612)).lineTo(0.173191, -0.066612).threePointArc((0.126562, -0.113240), (0.173191, -0.159868)).close()
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.117188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
