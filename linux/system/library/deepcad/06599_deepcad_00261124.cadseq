# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00261124" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.173684).lineTo(0.000000, 0.173684).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.101562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.063158).lineTo(1.436842, 0.063158).threePointArc((1.389474, 0.110526), (1.436842, 0.157895)).lineTo(1.500000, 0.157895).lineTo(1.500000, 0.205263).lineTo(0.000000, 0.205263).lineTo(0.000000, 0.157895).lineTo(0.063158, 0.157895).threePointArc((0.110526, 0.110526), (0.063158, 0.063158)).lineTo(0.000000, 0.063158).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(1.121053, 0.015789).lineTo(1.121053, 0.189474).lineTo(0.378947, 0.189474).lineTo(0.378947, 0.015789).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.023438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
