import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.476562, -0.078125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.953125, 0.000000).lineTo(0.953125, 0.040132).lineTo(0.411349, 0.040132).lineTo(0.411349, 0.060197).lineTo(0.953125, 0.060197).lineTo(0.953125, 0.110362).lineTo(0.411349, 0.110362).lineTo(0.411349, 0.130428).lineTo(0.953125, 0.130428).lineTo(0.953125, 0.160526).lineTo(0.000000, 0.160526).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
