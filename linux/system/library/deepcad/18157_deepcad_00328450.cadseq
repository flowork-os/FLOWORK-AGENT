# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00328450" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, -0.414062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.460938, 0.000000).lineTo(1.460938, 0.830428).lineTo(0.000000, 0.830428).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.599753, 0.076891).lineTo(0.599753, 0.123026).lineTo(0.707401, 0.123026).lineTo(0.707401, 0.076891).lineTo(1.384046, 0.076891).lineTo(1.384046, 0.768914).lineTo(0.061513, 0.768914).lineTo(0.061513, 0.076891).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.640625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
