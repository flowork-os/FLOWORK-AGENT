# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00219735" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, -0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.160362, 0.000000).threePointArc((1.328125, 0.167763), (1.160362, 0.335526)).lineTo(0.000000, 0.335526).threePointArc((-0.167763, 0.167763), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.167763).circle(0.055921)
loop2=wp_sketch0.moveTo(1.160362, 0.167763).circle(0.055921)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.085938, 0.195312), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.163569, 0.000000).lineTo(0.163569, 0.221299).threePointArc((0.081785, 0.303084), (0.000000, 0.221299)).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.083388, 0.221299).circle(0.035280)
solid1=wp_sketch1.add(loop3).add(loop4).extrude(0.265625, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, 0.375000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.132566, -0.132566), (0.265132, 0.000000)).lineTo(0.265132, 0.484375).lineTo(0.000000, 0.484375).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop5).extrude(-0.132812, both=True)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
