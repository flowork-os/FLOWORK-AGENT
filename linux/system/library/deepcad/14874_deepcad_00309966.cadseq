wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002620, -0.036028), (0.034868, -0.052303)).lineTo(0.801974, -0.052303).threePointArc((0.806332, -0.053509), (0.810691, -0.052303)).lineTo(0.828125, -0.017434).threePointArc((0.829331, -0.013076), (0.828125, -0.008717)).lineTo(0.409704, 0.618914).threePointArc((0.405345, 0.620006), (0.400987, 0.618914)).lineTo(0.339967, 0.618914).threePointArc((0.335609, 0.620121), (0.331250, 0.618914)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.078454, 0.008717).circle(0.026151)
