# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00227546" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.164062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.506743, 0.084457).threePointArc((0.617359, 0.201131), (0.532730, 0.337829)).lineTo(0.045477, 0.506743).threePointArc((0.217982, 0.235850), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.487253, 0.214391).circle(0.064967)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.429688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.268421, 0.000000).circle(0.268421)
loop3=wp_sketch1.moveTo(0.268421, 0.000000).circle(0.162171)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.398438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
