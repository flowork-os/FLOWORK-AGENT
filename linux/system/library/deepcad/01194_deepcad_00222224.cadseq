# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00222224" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.039062, 0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.002192, -0.005292), (0.007484, -0.007484)).lineTo(0.703454, -0.007484).threePointArc((0.708746, -0.005292), (0.710938, 0.000000)).lineTo(0.710938, 0.037418).threePointArc((0.708746, 0.042709), (0.703454, 0.044901)).lineTo(0.007484, 0.044901).threePointArc((0.002192, 0.042709), (0.000000, 0.037418)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.666036, 0.014967).circle(0.007484)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.007812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.002746, -0.006629), (0.009375, -0.009375)).lineTo(0.435937, -0.009375).threePointArc((0.442567, -0.006629), (0.445312, 0.000000)).lineTo(0.445312, 0.037500).threePointArc((0.442567, 0.044129), (0.435937, 0.046875)).lineTo(0.009375, 0.046875).threePointArc((0.002746, 0.044129), (0.000000, 0.037500)).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.417187, 0.018750).circle(0.009375)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.007812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
