# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00218189" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.266365, 0.000000).threePointArc((1.341698, 0.191780), (1.149918, 0.116447)).threePointArc((1.133802, 0.093315), (1.106250, 0.087336)).lineTo(0.160115, 0.087336).threePointArc((0.132564, 0.093315), (0.116447, 0.116447)).threePointArc((-0.075333, 0.191780), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.116447).circle(0.072780)
loop2=wp_sketch0.moveTo(1.266365, 0.116447).circle(0.072780)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.625000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
