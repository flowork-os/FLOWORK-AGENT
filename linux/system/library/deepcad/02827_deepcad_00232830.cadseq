# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232830" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.394737).lineTo(0.000000, 0.394737).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.315789, 0.047368).lineTo(0.315789, 0.347368).lineTo(0.047368, 0.205263).close()
loop2=wp_sketch0.moveTo(1.452632, 0.205263).lineTo(1.184211, 0.347368).lineTo(1.184211, 0.047368).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.398438)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.265625, -0.153783).lineTo(0.265625, 0.153783).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(-0.203125)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.203125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(1.500000, 0.000000).lineTo(1.500000, 0.394737).lineTo(0.000000, 0.394737).lineTo(0.000000, 0.000000).close()
loop5=wp_sketch2.moveTo(0.315789, 0.047368).lineTo(0.315789, 0.347368).lineTo(0.047368, 0.205263).close()
loop6=wp_sketch2.moveTo(1.452632, 0.205263).lineTo(1.184211, 0.347368).lineTo(1.184211, 0.047368).close()
solid2=wp_sketch2.add(loop4).add(loop5).add(loop6).extrude(-0.203125)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.437500, -0.156250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch3.moveTo(0.262993, 0.153947).lineTo(0.000000, 0.304688).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop7).extrude(-0.203125)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
