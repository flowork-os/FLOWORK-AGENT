import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, 0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.481579, -0.270888).lineTo(0.361184, -0.812664).lineTo(0.767516, -0.436431).lineTo(1.249095, -0.707319).lineTo(1.023355, -0.210691).lineTo(1.429688, 0.150493).lineTo(0.887911, 0.090296).lineTo(0.662171, 0.601974).lineTo(0.541776, 0.060197).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.257812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
