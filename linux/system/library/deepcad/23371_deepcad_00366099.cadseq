wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.353043, -0.509951).lineTo(0.627632, -0.117681).lineTo(0.889145, -0.509951).lineTo(1.242188, 0.000000).lineTo(0.627632, 0.810691).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.320516, -0.315076), (0.627632, 0.013076)).threePointArc((0.831604, -0.088728), (0.928372, 0.117681)).threePointArc((0.806305, 0.323989), (0.627632, 0.483799)).threePointArc((0.621094, 0.485783), (0.614556, 0.483799)).threePointArc((0.435883, 0.323989), (0.313816, 0.117681)).close()
