# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00256791" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.085938, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.060526, 0.000000).lineTo(0.060526, 0.121053).lineTo(0.189145, 0.245888).lineTo(0.310197, 0.124836).lineTo(0.310197, 0.000000).lineTo(0.359375, 0.000000).lineTo(0.359375, 0.143750).lineTo(0.189145, 0.317763).lineTo(0.083224, 0.211842).lineTo(0.049178, 0.242105).lineTo(0.000000, 0.192928).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.101562, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.070312, 0.289062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -0.707107, 0.707107)))
loop1=wp_sketch1.moveTo(0.187500, 0.000000).lineTo(0.187500, 0.037500).lineTo(0.000000, 0.037500).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.122368, 0.011842).threePointArc((0.114474, 0.019737), (0.122368, 0.027632)).lineTo(0.065132, 0.027632).threePointArc((0.057237, 0.019737), (0.065132, 0.011842)).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(-0.203125)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.078125, 0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -0.707107, 0.707107)))
loop3=wp_sketch2.moveTo(0.054687, 0.000000).threePointArc((0.047492, 0.007196), (0.054687, 0.014391)).lineTo(0.000000, 0.014391).threePointArc((-0.007196, 0.007196), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop3).extrude(-0.203125)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
