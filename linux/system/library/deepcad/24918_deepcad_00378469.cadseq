# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00378469" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.570312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.189474, 0.000000).lineTo(1.357895, 0.000000).lineTo(1.500000, 0.000000).lineTo(1.500000, 0.157895).lineTo(1.500000, 1.136842).lineTo(0.000000, 1.136842).lineTo(0.000000, 0.205263).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.152632, 0.252632).lineTo(1.152632, 0.884211).lineTo(0.347368, 0.884211).lineTo(0.347368, 0.252632).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.039062, -0.570312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.359375, 0.000000).lineTo(0.000000, 0.317763).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.156250)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
