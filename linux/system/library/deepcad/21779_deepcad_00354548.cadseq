wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.041622, -0.100484), (0.142105, -0.142105)).lineTo(0.607895, -0.142105).threePointArc((0.708378, -0.100484), (0.750000, 0.000000)).lineTo(0.750000, 0.465789).threePointArc((0.708378, 0.566273), (0.607895, 0.607895)).lineTo(0.142105, 0.607895).threePointArc((0.041622, 0.566273), (0.000000, 0.465789)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.091863, -0.079673), (0.213158, -0.071053)).lineTo(0.536842, -0.071053).threePointArc((0.637326, -0.029431), (0.678947, 0.071053)).lineTo(0.678947, 0.394737).threePointArc((0.637326, 0.495220), (0.536842, 0.536842)).lineTo(0.213158, 0.536842).threePointArc((0.112674, 0.495220), (0.071053, 0.394737)).lineTo(0.071053, 0.071053).close()
