loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.656250, 0.085032), (1.312500, 0.000000)).threePointArc((1.259792, 0.393403), (1.077632, 0.746053)).lineTo(1.077632, 0.511184).threePointArc((0.656250, 0.661957), (0.234868, 0.511184)).lineTo(0.234868, 0.746053).threePointArc((0.064438, 0.389710), (0.000000, 0.000000)).close()
