loop2=wp_sketch0.moveTo(0.262500, 0.331579).threePointArc((0.615672, 0.158287), (1.008553, 0.138158)).threePointArc((1.065521, 0.226486), (1.063816, 0.331579)).threePointArc((0.881275, 0.331145), (0.718421, 0.248684)).close()
