# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00268608" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.250000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.994737, -0.994737).lineTo(1.500000, -0.994737).lineTo(1.500000, 0.505263).lineTo(0.000000, 0.505263).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.252632, 0.252632).circle(0.047368)
loop2=wp_sketch0.moveTo(0.757895, 0.252632).circle(0.047368)
loop3=wp_sketch0.moveTo(1.247368, -0.757895).circle(0.047368)
loop4=wp_sketch0.moveTo(1.247368, -0.252632).circle(0.047368)
loop5=wp_sketch0.moveTo(1.247368, 0.252632).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.031250)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
