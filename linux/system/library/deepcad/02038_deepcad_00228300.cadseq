# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, -0.460938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.054884, -0.271299), (0.307566, -0.158306)).lineTo(0.429688, 0.321135).threePointArc((0.386533, 0.341602), (0.352796, 0.375411)).lineTo(0.221628, -0.135691).threePointArc((0.096700, -0.193318), (0.067845, -0.058799)).lineTo(0.199013, 0.099507).lineTo(0.149260, 0.176398).lineTo(0.076891, 0.090461).lineTo(0.072368, 0.090461).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.335938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, -0.312500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.116447, -0.053289).lineTo(0.187500, 0.031579).lineTo(0.114474, 0.136184).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.335938)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
