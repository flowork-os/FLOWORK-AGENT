import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.164062, 0.000000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.335526, 0.000000).threePointArc((0.246919, 0.196582), (0.300576, 0.405428)).threePointArc((0.164268, 0.664249), (0.027961, 0.405428)).threePointArc((0.085112, 0.197808), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
