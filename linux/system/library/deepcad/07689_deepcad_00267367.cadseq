# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00267367" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.500000, -0.250000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.502549, 0.000000).threePointArc((0.753824, 0.251275), (0.502549, 0.502549)).lineTo(0.000000, 0.502549).threePointArc((-0.251275, 0.251275), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.255263).circle(0.047862)
loop2=wp_sketch0.moveTo(0.494572, 0.255263).circle(0.047862)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
