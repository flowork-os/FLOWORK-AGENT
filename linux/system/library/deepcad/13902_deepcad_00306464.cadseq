# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306464" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, 0.000000, 0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.406250, 0.000000).threePointArc((0.203125, 0.203125), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.203125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, 0.000000, -0.546875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.606250, 0.000000).lineTo(0.606250, 0.542434).lineTo(0.606250, 0.654112).threePointArc((0.532923, 0.684485), (0.502549, 0.757812)).lineTo(0.103701, 0.757812).threePointArc((0.073327, 0.684485), (0.000000, 0.654112)).lineTo(0.000000, 0.542434).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.203125)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
