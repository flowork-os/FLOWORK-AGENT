import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, 0.000000, -0.015625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.298191, -0.080592).threePointArc((0.373657, -0.069362), (0.419079, -0.008059)).lineTo(0.620559, 0.685033).threePointArc((0.579063, 0.762025), (0.499671, 0.725329)).lineTo(0.249836, 0.112829).lineTo(0.008059, 0.104770).threePointArc((-0.040600, 0.055818), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.322368, 0.016118).circle(0.048355)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
