# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.664062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.069079, -0.059211).lineTo(0.069079, -0.937500).lineTo(0.523026, -0.937500).lineTo(0.523026, -0.789474).lineTo(0.236842, -0.789474).lineTo(0.236842, -0.493421).lineTo(0.523026, -0.493421).lineTo(0.523026, -0.355263).lineTo(0.236842, -0.355263).lineTo(0.236842, -0.059211).lineTo(0.523026, -0.059211).lineTo(0.523026, 0.088816).lineTo(0.000000, 0.088816).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.296875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
