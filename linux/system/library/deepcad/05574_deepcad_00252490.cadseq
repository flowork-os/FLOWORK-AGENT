import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.234375, -0.523438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.231579, -0.231579).lineTo(0.473684, 0.000000).lineTo(0.294737, 0.368421).lineTo(0.473684, 0.642105).lineTo(0.231579, 1.000000).lineTo(0.000000, 0.642105).lineTo(0.178947, 0.368421).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.231579, 0.915789).circle(0.042105)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
