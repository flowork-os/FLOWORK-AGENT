# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.242188, 0.000000, -0.687500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.480345, 0.000000).lineTo(0.480345, 1.382812).lineTo(0.000000, 1.382812).lineTo(0.000000, 0.000000).close()
