# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00366526" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.554688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.236842, -0.631579).lineTo(1.263158, -0.631579).lineTo(1.500000, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.284211, -0.552632).lineTo(1.215789, -0.552632).lineTo(1.389474, -0.078947).lineTo(0.110526, -0.078947).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.218750, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.445312, -0.078125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.345806, 0.000000).lineTo(0.333882, 0.083470).lineTo(0.226562, 0.631990).lineTo(0.655839, 0.631990).lineTo(0.548520, 0.083470).lineTo(0.536595, -0.011924).lineTo(1.132812, -0.011924).lineTo(1.132812, 0.882401).lineTo(0.000000, 0.882401).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.804688, both=True)
solid=solid.cut(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
