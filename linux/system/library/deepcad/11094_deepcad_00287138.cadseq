# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00287138" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.040707, 0.004523).threePointArc((0.213313, 0.214844), (0.040707, 0.425164)).lineTo(0.000000, 0.429688).threePointArc((-0.214844, 0.214844), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.217105).circle(0.162829)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.320312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(1.031250, 0.108553).threePointArc((0.928125, 0.211678), (1.031250, 0.314803)).lineTo(0.000000, 0.423355).threePointArc((0.173719, 0.211678), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.705592, 0.151974).threePointArc((0.759868, 0.206250), (0.705592, 0.260526)).lineTo(0.282237, 0.260526).threePointArc((0.227961, 0.206250), (0.282237, 0.151974)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.210938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.429688, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.106579, 0.000000).circle(0.104359)
loop5=wp_sketch2.moveTo(0.106579, 0.000000).circle(0.053289)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.265625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
