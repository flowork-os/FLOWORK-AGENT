# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00256578" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.156250, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.725000, 0.000000).threePointArc((0.906250, 0.181250), (0.725000, 0.362500)).lineTo(0.486513, 0.362500).lineTo(0.486513, 0.305263).lineTo(0.238487, 0.305263).lineTo(0.238487, 0.362500).lineTo(0.000000, 0.362500).threePointArc((0.181250, 0.181250), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.117188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, 0.000000, 0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.181579, 0.000000).circle(0.177796)
loop2=wp_sketch1.moveTo(0.181579, 0.000000).circle(0.075658)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.117188)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.390625, 0.000000, 0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.181579, 0.000000).circle(0.177796)
loop4=wp_sketch2.moveTo(0.181579, 0.000000).circle(0.075658)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.117188)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
