# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00335165" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.126316, 0.126316).circle(0.031579)
loop2=wp_sketch0.moveTo(0.126316, 1.373684).circle(0.031579)
loop3=wp_sketch0.moveTo(1.263158, 0.236842).lineTo(1.263158, 1.263158).lineTo(0.236842, 1.263158).lineTo(0.236842, 0.236842).close()
loop4=wp_sketch0.moveTo(1.373684, 0.126316).circle(0.031579)
loop5=wp_sketch0.moveTo(1.373684, 1.373684).circle(0.031579)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.414062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.000000, -0.507812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch1.moveTo(1.015625, 0.000000).lineTo(1.015625, 1.015625).lineTo(0.000000, 1.015625).lineTo(0.000000, 0.000000).close()
loop7=wp_sketch1.moveTo(0.513158, 0.513158).circle(0.310033)
solid1=wp_sketch1.add(loop6).add(loop7).extrude(0.414062)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
