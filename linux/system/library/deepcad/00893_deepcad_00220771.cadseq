# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220771" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.216488, 0.216488), (0.432977, 0.000000)).lineTo(0.432977, 0.832648).threePointArc((0.216488, 1.049137), (0.000000, 0.832648)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.222039, 0.832648).circle(0.099918)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(-0.187500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.000000, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.221053, 0.000000).circle(0.221053)
loop3=wp_sketch1.moveTo(0.221053, 0.000000).circle(0.101316)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.750000)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
