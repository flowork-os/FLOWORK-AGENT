# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00302065" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.187500, 0.000000, -0.242188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.195025, 0.025270), (0.390049, 0.000000)).threePointArc((0.724306, 0.244737), (0.390049, 0.489474)).threePointArc((0.195520, 0.460380), (0.000000, 0.481826)).threePointArc((-0.351145, 0.240913), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.091776, 0.244737).circle(0.084128)
loop2=wp_sketch0.moveTo(0.466530, 0.244737).circle(0.084128)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.078125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.090789, 0.000000).circle(0.088898)
solid1=wp_sketch1.add(loop3).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.177632, 0.000000).circle(0.177632)
loop5=wp_sketch2.moveTo(0.177632, 0.000000).circle(0.088816)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.375000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
