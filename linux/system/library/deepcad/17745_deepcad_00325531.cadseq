import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.484375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750411, 0.000000).lineTo(0.750411, 0.976563).lineTo(0.000000, 0.976563).lineTo(0.000000, 0.822368).lineTo(0.154194, 0.822368).lineTo(0.596217, 0.822368).lineTo(0.596217, 0.154194).lineTo(0.154194, 0.154194).lineTo(0.000000, 0.154194).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
