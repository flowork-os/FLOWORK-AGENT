# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00224078" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.179688, 0.382812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.069572, 0.000000).lineTo(0.069572, -0.158470).lineTo(0.297615, -0.158470).lineTo(0.297615, 0.000000).lineTo(0.367188, 0.000000).lineTo(0.367188, 0.255099).lineTo(0.000000, 0.255099).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.203125, -0.226562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.090625, 0.000000).lineTo(0.314803, 0.000000).lineTo(0.405428, 0.000000).lineTo(0.405428, 0.453125).lineTo(0.314803, 0.453125).lineTo(0.090625, 0.453125).lineTo(0.000000, 0.453125).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.179688, -0.640625), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.359211, 0.000000).lineTo(0.359211, 0.248026).lineTo(0.290789, 0.248026).lineTo(0.290789, 0.406250).lineTo(0.068421, 0.406250).lineTo(0.068421, 0.248026).lineTo(0.000000, 0.248026).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.750000, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
