wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.031250, 0.000000, -0.031250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.000963, -0.002326), (0.003289, -0.003289)).lineTo(0.059211, -0.003289).threePointArc((0.061537, -0.002326), (0.062500, 0.000000)).lineTo(0.062500, 0.056579).threePointArc((0.061400, 0.058576), (0.059211, 0.059211)).lineTo(0.003289, 0.059211).threePointArc((0.001100, 0.058576), (0.000000, 0.056579)).lineTo(0.000000, 0.000000).close()
