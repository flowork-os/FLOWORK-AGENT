# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00298884" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.367188, 0.000000, -0.195312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.726562, 0.000000).lineTo(0.726562, 0.367105).lineTo(0.000000, 0.367105).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.367188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.195312, 0.000000, -0.046875), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.367188, 0.000000).lineTo(0.367188, 0.115954).lineTo(0.000000, 0.115954).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.077303, 0.046382).circle(0.027056)
loop3=wp_sketch1.moveTo(0.177796, 0.057977).circle(0.038651)
loop4=wp_sketch1.moveTo(0.270559, 0.054112).circle(0.023191)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.148438)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.171875, -0.164062, 0.164062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch2.moveTo(0.312500, 0.000000).lineTo(0.174342, 0.134868).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop5).extrude(0.070312)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
