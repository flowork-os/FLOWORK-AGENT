# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00241494" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.679688, 0.000000).lineTo(0.679688, 0.135937).lineTo(0.472204, 0.343421).lineTo(0.200329, 0.343421).lineTo(0.000000, 0.135937).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.476562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.679688, 0.000000).lineTo(0.679688, 0.135937).lineTo(0.472204, 0.343421).lineTo(0.200329, 0.343421).lineTo(0.000000, 0.135937).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.476562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(1.359375, 0.000000).lineTo(1.359375, 0.243257).lineTo(0.844243, 0.744079).lineTo(0.515132, 0.744079).lineTo(0.000000, 0.243257).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.132812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
