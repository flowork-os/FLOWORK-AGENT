# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.047368, 0.000000).threePointArc((0.225000, 0.177632), (0.402632, 0.000000)).lineTo(0.450000, 0.000000).lineTo(0.450000, 0.521053).threePointArc((0.225000, 0.746053), (0.000000, 0.521053)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.156266, 0.163938), (0.378947, 0.205263)).lineTo(0.378947, 0.521053).threePointArc((0.228947, 0.671053), (0.078947, 0.521053)).lineTo(0.078947, 0.205263).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
