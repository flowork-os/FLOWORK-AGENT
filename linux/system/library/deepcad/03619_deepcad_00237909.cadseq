solid1=wp_sketch1.add(loop2).add(loop3).extrude(-0.015625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.234375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.478947, 0.000000).threePointArc((0.710938, 0.231990), (0.478947, 0.463980)).lineTo(0.000000, 0.463980).threePointArc((-0.231990, 0.231990), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.478947, 0.007484).threePointArc((0.703454, 0.231990), (0.478947, 0.456497)).lineTo(0.000000, 0.456497).threePointArc((-0.224507, 0.231990), (0.000000, 0.007484)).close()
