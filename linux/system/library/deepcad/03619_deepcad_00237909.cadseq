wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.273438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.473684, 0.000000).threePointArc((0.746053, 0.272368), (0.473684, 0.544737)).lineTo(0.000000, 0.544737).threePointArc((-0.272368, 0.272368), (0.000000, 0.000000)).close()
