# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00252495" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.335938, 0.000000, 0.226562), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.414062, 0.000000).lineTo(0.414062, 0.414062).lineTo(0.000000, 0.414062).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.047944, 0.366118).circle(0.026151)
loop2=wp_sketch0.moveTo(0.209211, 0.209211).circle(0.056661)
loop3=wp_sketch0.moveTo(0.366118, 0.047944).circle(0.026151)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.234375)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
