import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.000000, -0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.039727, 0.006885), (0.076974, -0.008553)).lineTo(0.076974, 0.000000).lineTo(0.094079, 0.812500).lineTo(0.017105, 0.812500).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.062500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.437500, 0.000000, 0.257812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.038816, -0.018359), (0.077632, 0.000000)).lineTo(0.077632, 0.076316).threePointArc((0.125547, 0.004605), (0.077632, -0.067105)).lineTo(0.000000, -0.064474).threePointArc((-0.046848, 0.006579), (0.000000, 0.077632)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.070312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, 0.000000, -0.617188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.039727, 0.006885), (0.076974, -0.008553)).lineTo(0.076974, 0.000000).lineTo(0.094079, 0.812500).lineTo(0.017105, 0.812500).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.070312)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, 0.000000, -0.679688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.071053, 0.000000).circle(0.071053)
loop4=wp_sketch3.moveTo(0.045888, -0.037007).lineTo(0.090296, -0.039967).lineTo(0.115461, -0.002961).lineTo(0.094737, 0.037007).lineTo(0.050329, 0.039967).lineTo(0.025164, 0.002961).close()
solid3=wp_sketch3.add(loop3).add(loop4).extrude(0.070312)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
