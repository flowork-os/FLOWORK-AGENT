import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.078125, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.068503, 0.000000).lineTo(0.060444, 0.382813).lineTo(0.000000, 0.382813).threePointArc((-0.098725, 0.284087), (0.000000, 0.185362)).threePointArc((0.092681, 0.092681), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.286102).circle(0.040296)
loop2=wp_sketch0.moveTo(0.000000, 0.092681).circle(0.040296)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.328125, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch1.moveTo(0.139145, 0.000000).lineTo(0.139145, 0.367188).lineTo(0.000000, 0.367188).lineTo(0.000000, 0.301480).lineTo(0.073438, 0.301480).lineTo(0.073438, 0.220312).lineTo(0.000000, 0.220312).lineTo(0.000000, 0.123684).lineTo(0.073438, 0.123684).lineTo(0.073438, 0.050247).lineTo(0.000000, 0.050247).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.195312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.088898, 0.000000).lineTo(0.088898, 0.255099).lineTo(0.270559, 0.000000).lineTo(0.359457, 0.000000).lineTo(0.359457, 0.367188).lineTo(0.270559, 0.367188).lineTo(0.270559, 0.096628).lineTo(0.088898, 0.367188).lineTo(0.000000, 0.367188).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.031250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
