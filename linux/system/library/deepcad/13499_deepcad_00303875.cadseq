# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00303875" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.125000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.046875, 0.000000).lineTo(1.046875, 0.264474).lineTo(0.264474, 0.264474).lineTo(0.000000, 0.132237).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.275493, 0.055099).lineTo(0.275493, 0.209375).lineTo(0.055099, 0.099178).lineTo(0.055099, 0.055099).close()
loop2=wp_sketch0.moveTo(0.539967, 0.055099).lineTo(0.539967, 0.209375).lineTo(0.330592, 0.209375).lineTo(0.330592, 0.055099).close()
loop3=wp_sketch0.moveTo(0.771382, 0.055099).lineTo(0.771382, 0.209375).lineTo(0.595066, 0.209375).lineTo(0.595066, 0.055099).close()
loop4=wp_sketch0.moveTo(0.991776, 0.055099).lineTo(0.991776, 0.209375).lineTo(0.826480, 0.209375).lineTo(0.826480, 0.055099).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.015625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
