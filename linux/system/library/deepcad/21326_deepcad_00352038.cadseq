# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00352038" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.304688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.189474, 0.000000).threePointArc((0.238717, 0.144626), (0.378947, 0.205263)).lineTo(0.750000, 0.205263).lineTo(0.750000, 0.300000).lineTo(0.750000, 0.394737).lineTo(0.378947, 0.394737).threePointArc((0.252234, 0.441088), (0.189474, 0.560526)).lineTo(0.000000, 0.560526).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.093750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.093750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.378947, 0.000000).threePointArc((0.515230, -0.062387), (0.560526, -0.205263)).lineTo(0.750000, -0.205263).lineTo(0.750000, 0.355263).lineTo(0.560526, 0.355263).threePointArc((0.503236, 0.233400), (0.378947, 0.181579)).lineTo(0.000000, 0.181579).lineTo(0.000000, 0.094737).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.093750)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
