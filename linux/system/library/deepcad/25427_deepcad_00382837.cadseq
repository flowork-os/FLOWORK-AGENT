import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, 0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.004276, 0.000000).lineTo(0.004276, 0.031250).lineTo(0.000000, 0.031250).lineTo(0.000000, 0.019079).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.312500)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.734375, 0.000000, -0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.382813, 0.000000).lineTo(0.382813, 0.012089).lineTo(0.000000, 0.012089).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.312500)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.012336, 0.000000).lineTo(0.390625, 0.000000).lineTo(0.390625, 0.012336).lineTo(0.000000, 0.012336).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.312500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.210938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.011842, 0.000000).lineTo(0.011842, 0.011842).lineTo(0.011842, 0.375000).lineTo(0.000000, 0.375000).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.312500)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.539062, -0.195312, -0.210938), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch4.moveTo(0.027632, 0.000000).circle(0.027632)
solid4=wp_sketch4.add(loop4).extrude(-0.007812)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
