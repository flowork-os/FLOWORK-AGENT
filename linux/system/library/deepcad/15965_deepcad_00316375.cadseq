loop4=wp_sketch3.moveTo(0.150082, -0.086349).threePointArc((0.173865, -0.049008), (0.195312, -0.010280)).lineTo(0.045230, 0.078125).threePointArc((0.024294, 0.038091), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop4).extrude(-0.156250)
