import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, -0.218750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.109951, 0.000000).lineTo(0.109951, 0.188487).lineTo(0.329852, 0.188487).lineTo(0.329852, 0.000000).lineTo(0.502632, 0.000000).lineTo(0.502632, 0.188487).lineTo(0.738240, 0.188487).lineTo(0.738240, 0.000000).lineTo(1.492188, 0.000000).lineTo(1.492188, 0.596875).lineTo(0.000000, 0.596875).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
