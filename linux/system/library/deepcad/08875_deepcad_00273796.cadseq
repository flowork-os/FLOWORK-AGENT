# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00273796" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, -0.554688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.074342, 0.000000).lineTo(1.074342, 1.109375).lineTo(0.000000, 1.109375).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.560526, 0.525493).circle(0.233553)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.539062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
