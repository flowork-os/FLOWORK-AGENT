# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00272431" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.406250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.082895, 0.000000).circle(0.082895)
solid0=wp_sketch0.add(loop0).extrude(0.335938)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, 0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.021711, -0.021711).lineTo(0.043421, -0.048849).lineTo(0.515625, 0.124836).lineTo(0.331086, 0.141118).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.335938)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.695312, 0.000000, 0.132812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.007895, -0.024671).lineTo(0.093750, 0.000000).lineTo(0.072039, 0.022697).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.335938)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
