# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00367759" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, 0.000000, -0.179688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.450000, 0.000000).threePointArc((0.750000, 0.300000), (0.450000, 0.600000)).lineTo(0.000000, 0.600000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.450000, 0.300000).circle(0.150000)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.601562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.585938, -0.210938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.573355, 0.000000).lineTo(0.573355, 0.648438).lineTo(0.000000, 0.648438).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(-0.281250, both=True)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.281250, -0.585938, -0.179688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.576234, 0.000000).lineTo(0.576234, 0.601562).lineTo(0.000000, 0.601562).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.898438)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, -0.492188, 0.117188), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.197368, 0.000000).circle(0.197368)
loop5=wp_sketch3.moveTo(0.197368, 0.000000).circle(0.152138)
solid3=wp_sketch3.add(loop4).add(loop5).extrude(0.453125)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, -0.601562, 0.343750), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop6=wp_sketch4.moveTo(0.601562, 0.000000).lineTo(0.601562, 0.075987).lineTo(0.000000, 0.075987).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop6).extrude(-1.000000)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.296875, -0.601562, -0.179688), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop7=wp_sketch5.moveTo(0.601562, 0.000000).lineTo(0.601562, 0.075987).lineTo(0.000000, 0.075987).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop7).extrude(-1.000000)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
