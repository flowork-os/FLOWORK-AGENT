wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.179688, -0.382812), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.159375, 0.000000).lineTo(0.159375, -0.131250).lineTo(0.296875, -0.131250).lineTo(0.296875, 0.000000).lineTo(0.275000, 0.000000).lineTo(0.275000, -0.109375).lineTo(0.181250, -0.109375).lineTo(0.181250, 0.000000).threePointArc((0.128163, 0.128163), (0.000000, 0.181250)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.500000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.007812, 0.109375, -0.515625), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.268148, -0.234603), (0.515625, 0.021711)).lineTo(0.504770, 0.021711).threePointArc((0.257812, -0.225247), (0.010855, 0.021711)).lineTo(0.010855, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.132812)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.007812, 0.109375, -0.492188), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.000206, -0.011731), (0.000987, -0.023438)).lineTo(0.011842, -0.023438).lineTo(0.011842, 0.000000).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.132812)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
