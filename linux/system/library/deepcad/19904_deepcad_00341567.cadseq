solid0=wp_sketch0.add(loop0).extrude(-0.359375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.101562, 0.000000, 0.265625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.058594, -0.010538), (0.117188, 0.000000)).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.484375)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.265625, 0.023438, 0.265625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.059121, 0.125000), (0.000000, 0.250000)).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.484375)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.101562, 0.000000, 0.265625), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.111842, 0.000000).threePointArc((0.135920, 0.011317), (0.157895, 0.026316)).lineTo(0.157895, 0.276316).threePointArc((-0.083217, 0.230823), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop3).extrude(0.484375)
