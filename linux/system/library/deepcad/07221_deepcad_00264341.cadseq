import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.359375, 0.000000, -0.710938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.722368, 0.000000).lineTo(0.722368, 1.429688).lineTo(0.000000, 1.429688).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.234375, both=True)
solid=solid0
# workplane for sketch 1
