solid2=wp_sketch2.add(loop3).extrude(0.242188, both=True)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.046875, 0.000000, -0.140625), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch3.moveTo(0.492187, 0.165789).lineTo(0.170970, 0.165789).threePointArc((0.124705, 0.150020), (0.098437, 0.108799)).threePointArc((0.063557, 0.041427), (0.000000, 0.000000)).close()
solid3=wp_sketch3.add(loop4).extrude(0.039062, both=True)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.265625, -0.148438, 0.148438), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch4.moveTo(0.000000, 0.000000).threePointArc((0.049027, -0.085821), (0.147862, -0.086678)).lineTo(0.448684, 0.086678).threePointArc((0.483842, 0.147862), (0.448684, 0.209046)).lineTo(0.147862, 0.382401).threePointArc((0.049027, 0.381545), (0.000000, 0.295724)).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch4.moveTo(0.127467, 0.000000).circle(0.045888)
