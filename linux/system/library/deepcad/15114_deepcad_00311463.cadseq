# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.094089, -0.037242), (0.142105, -0.126316)).lineTo(0.213158, -0.126316).lineTo(0.544737, -0.126316).lineTo(0.750000, -0.126316).lineTo(0.750000, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.242188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.148438, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.150000, 0.000000).circle(0.146875)
loop2=wp_sketch1.moveTo(0.150000, 0.000000).circle(0.112500)
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.242188, both=True)
solid=solid.union(solid1)
