# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00321661" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.117188, 0.070312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.001848, -0.139556), (0.118668, -0.209951)).lineTo(0.766776, -0.209951).threePointArc((0.865772, -0.113832), (0.775905, -0.009128)).threePointArc((0.501072, 0.078086), (0.273849, 0.255592)).threePointArc((0.207653, 0.283192), (0.146053, 0.246464)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.118668, -0.073026).circle(0.091283)
loop2=wp_sketch0.moveTo(0.209951, 0.209951).circle(0.045641)
loop3=wp_sketch0.moveTo(0.766776, -0.109539).circle(0.073026)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.046875, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.093750, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.094737, 0.000000).circle(0.092763)
solid1=wp_sketch1.add(loop4).extrude(-0.015625)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.101562, 0.000000, 0.046875), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch2.moveTo(0.102632, 0.000000).circle(0.102632)
loop6=wp_sketch2.moveTo(0.102632, 0.000000).circle(0.091941)
solid2=wp_sketch2.add(loop5).add(loop6).extrude(-0.015625)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
