# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00225188" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.126316, 0.000000).circle(0.126316)
loop1=wp_sketch0.moveTo(0.126316, 0.000000).circle(0.052632)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.101562)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.054688, 0.117188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.168989, -0.065527), (0.097286, -0.231990)).threePointArc((0.370988, -0.170201), (0.651069, -0.187089)).threePointArc((0.552893, -0.032553), (0.710938, 0.059868)).threePointArc((0.349895, 0.096117), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop2).extrude(0.101562)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.500000, 0.054688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch2.moveTo(0.126316, 0.000000).circle(0.123684)
loop4=wp_sketch2.moveTo(0.126316, 0.000000).circle(0.052632)
solid2=wp_sketch2.add(loop3).add(loop4).extrude(0.101562)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.570312, 0.054688, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop5=wp_sketch3.moveTo(0.055263, 0.000000).circle(0.055263)
solid3=wp_sketch3.add(loop5).extrude(-0.046875)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.531250, 0.054688, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop6=wp_sketch4.moveTo(0.090789, 0.000000).circle(0.088898)
loop7=wp_sketch4.moveTo(0.090789, 0.000000).circle(0.052961)
solid4=wp_sketch4.add(loop6).add(loop7).extrude(-0.046875)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
