# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.710938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.009249, -0.022330), (0.031579, -0.031579)).lineTo(1.468421, -0.031579).threePointArc((1.490751, -0.022330), (1.500000, 0.000000)).lineTo(1.500000, 1.421053).threePointArc((1.494021, 1.451277), (1.468421, 1.468421)).lineTo(0.031579, 1.468421).threePointArc((0.005979, 1.451277), (0.000000, 1.421053)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.078947, 0.031579).circle(0.047368)
loop2=wp_sketch0.moveTo(0.078947, 1.389474).circle(0.047368)
loop3=wp_sketch0.moveTo(1.421053, 0.031579).circle(0.047368)
loop4=wp_sketch0.moveTo(1.421053, 1.389474).circle(0.047368)
