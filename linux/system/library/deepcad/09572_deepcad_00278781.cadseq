# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00278781" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.000000, 0.625000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.057155, -0.628701).lineTo(0.091447, -1.085938).lineTo(0.537253, -1.085938).lineTo(0.582977, -0.628701).lineTo(0.628701, 0.000000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.320066, -0.148602).circle(0.057155)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.140625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.546875, -0.460938), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.273438, -0.290752), (0.546875, 0.000000)).lineTo(0.437500, 0.000000).lineTo(0.402961, 0.000000).threePointArc((0.279194, -0.141712), (0.155428, 0.000000)).lineTo(0.155428, 0.449013).lineTo(0.138158, 0.449013).lineTo(0.000000, 0.449013).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop2).extrude(0.218750, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
