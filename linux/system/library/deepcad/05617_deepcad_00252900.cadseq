# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00252900" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, 0.000000, -0.156250), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.011719, -0.000432), (0.023438, 0.000000)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.195312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.039062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((-0.001107, -0.046563), (0.012993, -0.090954)).threePointArc((0.049965, -0.109974), (0.090954, -0.116941)).lineTo(0.116941, -0.116941).lineTo(1.182401, -0.116941).threePointArc((1.225234, -0.017370), (1.221382, 0.090954)).threePointArc((1.195395, 0.097803), (1.169408, 0.090954)).lineTo(0.987500, 0.194901).lineTo(0.363816, 0.194901).lineTo(0.233882, 0.090954).threePointArc((0.109623, 0.064293), (0.000000, 0.000000)).close()
loop2=wp_sketch1.moveTo(0.363816, -0.090954).circle(0.012993)
loop3=wp_sketch1.moveTo(0.935526, -0.090954).circle(0.012993)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).extrude(0.195312)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
