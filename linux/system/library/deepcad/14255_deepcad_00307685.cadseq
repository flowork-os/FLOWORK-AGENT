# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00307685" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.703125, 0.000000, -0.609375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.453125, 0.000000).lineTo(1.453125, 1.238980).lineTo(1.040132, 1.238980).lineTo(1.040132, 0.412993).lineTo(0.412993, 0.412993).lineTo(0.412993, 0.825987).lineTo(0.000000, 0.825987).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.625000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
