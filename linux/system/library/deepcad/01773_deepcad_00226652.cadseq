# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00226652" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.453125, -0.398438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.987829, 0.000000).lineTo(0.987829, 0.481250).lineTo(1.203125, 0.481250).lineTo(1.203125, 0.721875).lineTo(0.000000, 0.721875).lineTo(0.000000, 0.367270).lineTo(0.000000, 0.354605).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.164062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.125000, 0.000000, 0.164062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.122368, 0.000000).circle(0.122368)
solid1=wp_sketch1.add(loop1).extrude(-0.195312)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, -0.398438, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.239638, 0.000000).lineTo(0.239638, 0.355592).lineTo(0.239638, 0.367188).lineTo(0.000000, 0.367188).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.476562)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, -0.031250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.236842, 0.000000).lineTo(0.236842, 0.351562).lineTo(0.000000, 0.351562).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.531250)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
