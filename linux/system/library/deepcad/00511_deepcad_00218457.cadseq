import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.852632, 0.000000).lineTo(0.852632, 1.500000).lineTo(0.584211, 1.500000).lineTo(0.584211, 1.452632).lineTo(0.805263, 1.452632).lineTo(0.805263, 0.047368).lineTo(0.047368, 0.047368).lineTo(0.047368, 1.452632).lineTo(0.268421, 1.452632).lineTo(0.268421, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.164062, 0.703125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.320312, 0.000000).lineTo(0.320312, 0.047204).lineTo(0.000000, 0.047204).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.031250)
