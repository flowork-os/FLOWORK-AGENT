# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, -0.703125, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.754934, 0.000000).lineTo(0.754934, 1.406250).lineTo(0.547697, 1.406250).lineTo(0.222039, 1.406250).lineTo(0.000000, 1.406250).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.031250)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.429688, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.852632, 0.000000).lineTo(0.852632, 1.500000).lineTo(0.584211, 1.500000).lineTo(0.584211, 1.452632).lineTo(0.805263, 1.452632).lineTo(0.805263, 0.047368).lineTo(0.047368, 0.047368).lineTo(0.047368, 1.452632).lineTo(0.268421, 1.452632).lineTo(0.268421, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
