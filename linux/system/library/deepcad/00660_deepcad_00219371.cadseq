import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.054276, 0.000000).lineTo(0.054276, 0.031661).lineTo(0.040707, 0.031661).lineTo(0.040707, 0.321135).lineTo(0.108553, 0.321135).lineTo(0.108553, 0.388980).lineTo(0.398026, 0.388980).lineTo(0.398026, 0.375411).lineTo(0.429688, 0.375411).lineTo(0.429688, 0.429688).lineTo(0.000000, 0.429688).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
