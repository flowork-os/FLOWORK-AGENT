import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.320312, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.639474, 0.000000).lineTo(0.639474, 0.007895).lineTo(0.331579, 0.371053).lineTo(0.655263, 0.742105).lineTo(0.655263, 0.750000).lineTo(0.568421, 0.750000).lineTo(0.086842, 0.750000).lineTo(0.007895, 0.750000).lineTo(0.007895, 0.742105).lineTo(0.323684, 0.371053).lineTo(0.000000, 0.007895).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.631579, 0.007895).lineTo(0.323684, 0.371053).lineTo(0.007895, 0.007895).close()
loop2=wp_sketch0.moveTo(0.323684, 0.378947).lineTo(0.647368, 0.742105).lineTo(0.015789, 0.742105).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.023438, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.250000, 0.000000, 0.742188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.078125, 0.000000).lineTo(0.078125, 0.006579).lineTo(0.000000, 0.006579).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.109375, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.312500, 0.000000, 0.742188), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.078125, 0.000000).lineTo(0.078125, 0.006579).lineTo(0.000000, 0.006579).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(0.109375, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
