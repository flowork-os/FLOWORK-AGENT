# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306512" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.347368).threePointArc((0.675000, 0.422368), (0.600000, 0.347368)).lineTo(0.600000, 0.205263).threePointArc((0.576877, 0.149439), (0.521053, 0.126316)).lineTo(0.228947, 0.126316).threePointArc((0.173123, 0.149439), (0.150000, 0.205263)).lineTo(0.150000, 0.347368).threePointArc((0.075000, 0.422368), (0.000000, 0.347368)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.078947, 0.347368).circle(0.047368)
loop2=wp_sketch0.moveTo(0.671053, 0.347368).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(-0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.126316).lineTo(0.521053, 0.126316).lineTo(0.228947, 0.126316).lineTo(0.000000, 0.126316).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop3).extrude(0.398438)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
