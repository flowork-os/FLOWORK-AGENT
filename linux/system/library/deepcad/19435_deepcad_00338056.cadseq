# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00338056" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, -0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.171875, 0.000000).lineTo(1.171875, 0.740132).lineTo(0.000000, 0.740132).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, -0.375000, -0.226562), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.757812, 0.000000).lineTo(0.757812, 0.454688).lineTo(0.000000, 0.454688).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.749836, 0.199424).lineTo(0.749836, 0.255263).lineTo(0.007977, 0.255263).lineTo(0.007977, 0.199424).close()
solid1=wp_sketch1.add(loop1).add(loop2).extrude(0.164062)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.585938, -0.367188, -0.031250), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch2.moveTo(0.742188, 0.000000).lineTo(0.742188, 0.062500).lineTo(0.000000, 0.062500).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop3).extrude(0.164062)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
