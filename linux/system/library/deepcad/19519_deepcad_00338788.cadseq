# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00338788" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.351562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.049178, 0.000000).lineTo(0.049178, 0.203125).lineTo(0.000000, 0.203125).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.078125, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.062500, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.049178, 0.000000).lineTo(0.049178, 0.203125).lineTo(0.000000, 0.203125).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.078125, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.710938, -0.265625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.000000, 0.765296).threePointArc((-0.024598, 0.824680), (0.034786, 0.800082)).lineTo(1.020395, 0.800082).threePointArc((1.085576, 0.838677), (1.066776, 0.765296)).lineTo(1.066776, 0.000000).threePointArc((1.085576, -0.073381), (1.020395, -0.034786)).lineTo(0.533388, -0.034786).lineTo(0.034786, -0.034786).threePointArc((-0.024598, -0.059384), (0.000000, 0.000000)).close()
loop3=wp_sketch2.moveTo(0.000000, -0.034786).circle(0.011595)
loop4=wp_sketch2.moveTo(0.000000, 0.800082).circle(0.011595)
loop5=wp_sketch2.moveTo(0.591365, 0.069572).lineTo(0.591365, 0.150740).lineTo(0.475411, 0.150740).lineTo(0.475411, 0.069572).close()
loop6=wp_sketch2.moveTo(1.066776, -0.034786).circle(0.011595)
loop7=wp_sketch2.moveTo(1.066776, 0.800082).circle(0.011595)
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).add(loop7).extrude(0.015625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
