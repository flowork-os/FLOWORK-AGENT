# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00360787" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.378947, 0.000000).lineTo(0.378947, 0.750000).lineTo(0.000000, 0.750000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.347368, 0.623684).lineTo(0.347368, 0.726316).lineTo(0.023684, 0.726316).lineTo(0.023684, 0.623684).close()
loop2=wp_sketch0.moveTo(0.102632, 0.378947).circle(0.039474)
loop3=wp_sketch0.moveTo(0.276316, 0.031579).lineTo(0.276316, 0.094737).lineTo(0.197368, 0.094737).lineTo(0.197368, 0.031579).close()
loop4=wp_sketch0.moveTo(0.276316, 0.378947).circle(0.039474)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.007812)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
