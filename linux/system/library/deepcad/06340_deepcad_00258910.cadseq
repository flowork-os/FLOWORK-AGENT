# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00258910" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.750000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.500000, 0.000000).lineTo(1.500000, 1.500000).lineTo(0.000000, 1.500000).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.078947, 0.078947).circle(0.047368)
loop2=wp_sketch0.moveTo(0.078947, 1.421053).circle(0.047368)
loop3=wp_sketch0.moveTo(1.421053, 0.078947).circle(0.047368)
loop4=wp_sketch0.moveTo(1.421053, 1.421053).circle(0.047368)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.039062)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.179688, -0.179688, 0.039062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch1.moveTo(0.367188, 0.000000).lineTo(0.367188, 0.367188).lineTo(0.000000, 0.367188).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop5).extrude(0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.507812, 0.750000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop6=wp_sketch2.moveTo(1.023438, 0.000000).lineTo(1.023438, 0.226234).lineTo(0.000000, 0.226234).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(0.093750)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.132812, 0.000000, 0.289062), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch3.moveTo(0.130263, 0.000000).circle(0.130263)
solid3=wp_sketch3.add(loop7).extrude(0.007812)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
