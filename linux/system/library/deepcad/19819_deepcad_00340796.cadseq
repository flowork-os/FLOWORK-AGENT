# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00340796" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.195312, 0.000000, -0.304688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.348273, -0.318421).lineTo(0.945312, -0.318421).lineTo(0.945312, 0.268668).lineTo(0.248766, 0.268668).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.278618, 0.009951).circle(0.099507)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.195312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
