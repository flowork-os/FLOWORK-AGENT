# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00232904" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.656250, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.300493, -0.093010).lineTo(0.679688, 0.035773).lineTo(0.679688, 0.507977).lineTo(0.472204, 0.507977).lineTo(0.472204, 0.372039).lineTo(0.271875, 0.372039).lineTo(0.271875, 0.507977).lineTo(0.000000, 0.507977).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.007812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.675658, 0.000000).lineTo(0.675658, 0.205263).lineTo(0.812500, 0.205263).lineTo(0.812500, 0.538816).lineTo(0.205263, 0.538816).lineTo(0.205263, 0.410526).lineTo(0.000000, 0.410526).lineTo(0.000000, 0.000000).close()
loop2=wp_sketch1.moveTo(0.145395, 0.128289).circle(0.068421)
loop3=wp_sketch1.moveTo(0.581579, 0.076974).circle(0.051316)
loop4=wp_sketch1.moveTo(0.650000, 0.436184).circle(0.085526)
solid1=wp_sketch1.add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.171875)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
