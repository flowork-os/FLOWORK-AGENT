# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00360143" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.457895, 0.000000).threePointArc((0.750000, 0.292105), (0.457895, 0.584211)).lineTo(0.000000, 0.584211).threePointArc((-0.292105, 0.292105), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.000000, 0.292105).circle(0.023684)
loop2=wp_sketch0.moveTo(0.457895, 0.292105).circle(0.023684)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.468750)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.460938, 0.585938, 0.156250), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.006908, 0.000000).lineTo(0.006908, 0.164062).lineTo(0.000000, 0.164062).threePointArc((-0.082031, 0.082031), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop3).extrude(-1.000000)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.453125, 0.585938, 0.156250), cq.Vector(-1.000000, 0.000000, -0.000000), cq.Vector(0.000000, 1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.184539, 0.000000).threePointArc((0.265625, 0.081086), (0.184539, 0.162171)).lineTo(0.000000, 0.162171).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop4).extrude(-1.000000)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
