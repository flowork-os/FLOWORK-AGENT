# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00237558" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, 0.000000, 0.382812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.323684, 0.000000).circle(0.323684)
loop1=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.046815, -0.128436), (0.161842, -0.202303)).lineTo(0.209046, -0.026974).lineTo(0.087664, 0.101151).close()
loop2=wp_sketch0.moveTo(0.350658, 0.107895).lineTo(0.525987, 0.155099).threePointArc((0.391274, 0.245581), (0.229276, 0.236020)).close()
loop3=wp_sketch0.moveTo(0.323684, 0.000000).circle(0.053947)
loop4=wp_sketch0.moveTo(0.229276, 0.236020).threePointArc((0.354622, 0.039800), (0.573191, -0.040461)).lineTo(0.397862, -0.080921).lineTo(0.350658, -0.256250).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.054688)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.726562, -0.054688, 0.382812), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch1.moveTo(0.323684, 0.000000).circle(0.323684)
loop6=wp_sketch1.moveTo(0.350658, -0.256250).threePointArc((0.265345, -0.197444), (0.161842, -0.202303)).threePointArc((0.250885, -0.248055), (0.350658, -0.256250)).threePointArc((0.498304, -0.185872), (0.573191, -0.040461)).threePointArc((0.569038, 0.062014), (0.525987, 0.155099)).threePointArc((0.391274, 0.245581), (0.229276, 0.236020)).threePointArc((0.145057, 0.182670), (0.087664, 0.101151)).close()
solid1=wp_sketch1.add(loop5).add(loop6).extrude(0.257812)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
