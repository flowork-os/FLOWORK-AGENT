# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00327689" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.640625, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.082895, 0.000000).circle(0.082895)
solid0=wp_sketch0.add(loop0).extrude(-0.515625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.484375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.082895, 0.000000).circle(0.082895)
solid1=wp_sketch1.add(loop1).extrude(-0.515625)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.562500, -0.187500, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(1.119079, 0.000000).threePointArc((1.305592, 0.186513), (1.119079, 0.373026)).lineTo(0.000000, 0.373026).threePointArc((-0.186513, 0.186513), (0.000000, 0.000000)).close()
solid2=wp_sketch2.add(loop2).extrude(0.187500)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.632812, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.078947, 0.000000).circle(0.077303)
solid3=wp_sketch3.add(loop3).extrude(0.460938)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(0.484375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch4.moveTo(0.078947, 0.000000).circle(0.078947)
solid4=wp_sketch4.add(loop4).extrude(0.460938)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(-0.335938, -0.117188, 0.187500), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch5.moveTo(0.671875, 0.000000).lineTo(0.671875, 0.233388).lineTo(0.000000, 0.233388).lineTo(0.000000, 0.000000).close()
solid5=wp_sketch5.add(loop5).extrude(0.250000)
solid=solid.union(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
