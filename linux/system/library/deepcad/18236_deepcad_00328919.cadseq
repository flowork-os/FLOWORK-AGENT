# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00328919" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.320312, 0.000000).lineTo(0.320312, 0.320312).lineTo(0.000000, 0.320312).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.161842, 0.161842).circle(0.053947)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.320312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.320312, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.266859, 0.000000).threePointArc((0.427426, 0.160567), (0.266859, 0.321135)).lineTo(0.108553, 0.321135).lineTo(0.000000, 0.321135).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.108553, 0.108553).circle(0.027138)
loop4=wp_sketch1.moveTo(0.108553, 0.217105).circle(0.027138)
loop5=wp_sketch1.moveTo(0.266859, 0.108553).circle(0.027138)
loop6=wp_sketch1.moveTo(0.266859, 0.217105).circle(0.027138)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).add(loop5).add(loop6).extrude(0.320312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.320312, -0.320312, 0.320312), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch2.moveTo(0.266859, 0.000000).threePointArc((0.427426, 0.160567), (0.266859, 0.321135)).lineTo(0.000000, 0.321135).lineTo(0.000000, 0.000000).close()
loop8=wp_sketch2.moveTo(0.108553, 0.108553).circle(0.027138)
loop9=wp_sketch2.moveTo(0.108553, 0.217105).circle(0.027138)
loop10=wp_sketch2.moveTo(0.266859, 0.108553).circle(0.027138)
loop11=wp_sketch2.moveTo(0.266859, 0.217105).circle(0.027138)
solid2=wp_sketch2.add(loop7).add(loop8).add(loop9).add(loop10).add(loop11).extrude(-0.109375)
solid=solid.cut(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.320312, 0.000000, 0.000000), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop12=wp_sketch3.moveTo(0.266859, 0.000000).threePointArc((0.427426, 0.160567), (0.266859, 0.321135)).lineTo(0.000000, 0.321135).lineTo(0.000000, 0.000000).close()
loop13=wp_sketch3.moveTo(0.108553, 0.108553).circle(0.027138)
loop14=wp_sketch3.moveTo(0.108553, 0.217105).circle(0.027138)
loop15=wp_sketch3.moveTo(0.266859, 0.108553).circle(0.027138)
loop16=wp_sketch3.moveTo(0.266859, 0.217105).circle(0.027138)
solid3=wp_sketch3.add(loop12).add(loop13).add(loop14).add(loop15).add(loop16).extrude(-0.109375)
solid=solid.cut(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
