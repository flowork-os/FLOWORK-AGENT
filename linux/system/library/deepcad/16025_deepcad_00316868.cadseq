import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.179688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.052750, -0.127349), (0.180099, -0.180099)).lineTo(0.408224, -0.180099).lineTo(0.408224, 0.102056).lineTo(0.180099, 0.570312).lineTo(0.114062, 0.570312).lineTo(0.042023, 0.456250).lineTo(0.042023, 0.390214).lineTo(0.000000, 0.390214).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.180099, 0.006003).circle(0.096053)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.078125)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
