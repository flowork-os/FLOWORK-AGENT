# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00384430" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, 0.671875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.176809, -0.671875).lineTo(0.205099, -0.671875).lineTo(0.205099, -0.664803).lineTo(0.021217, 0.035362).lineTo(0.021217, 0.042434).threePointArc((0.014603, 0.037982), (0.007072, 0.035362)).lineTo(0.007072, 0.028289).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.031250)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.029934, 0.000000).lineTo(0.209539, 0.666036).lineTo(0.202056, 0.695970).lineTo(0.194572, 0.703454).threePointArc((0.191315, 0.707681), (0.187089, 0.710938)).lineTo(0.187089, 0.703454).lineTo(0.000000, 0.007484).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.031250)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.007812, 0.000000, 0.703125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.001480, -0.004934).lineTo(0.008882, -0.034046).lineTo(0.016776, -0.004934).lineTo(0.018257, 0.000000).threePointArc((0.009128, 0.047409), (0.000000, 0.000000)).close()
loop3=wp_sketch2.moveTo(0.008882, 0.022697).circle(0.020230)
solid2=wp_sketch2.add(loop2).add(loop3).extrude(0.031250)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
