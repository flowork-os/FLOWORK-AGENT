wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.039062, 0.000000, -0.484375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.005099, -0.061184).lineTo(0.020395, -0.117270).lineTo(0.045888, -0.178454).lineTo(0.076480, -0.229441).lineTo(0.112171, -0.270230).lineTo(0.142763, -0.244737).lineTo(0.107072, -0.203947).lineTo(0.081579, -0.158059).lineTo(0.056086, -0.107072).lineTo(0.045888, -0.050987).lineTo(0.040789, 0.000000).lineTo(0.040789, 0.484375).lineTo(0.000000, 0.484375).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.679688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
