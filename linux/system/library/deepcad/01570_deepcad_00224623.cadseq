# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00224623" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.000000, 0.570312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.004276, -0.406250).lineTo(0.106908, -0.277961).lineTo(0.106908, 0.000000).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.000000, 0.164062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.804688, 0.008470).lineTo(0.389638, 0.482813).lineTo(0.101645, 0.127056).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, 0.000000, -0.695312), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.255592, 0.000000).lineTo(0.447286, 0.000000).lineTo(0.803289, 0.000000).lineTo(0.803289, 0.867188).lineTo(0.000000, 0.858059).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch2.moveTo(0.100411, 0.556826).lineTo(0.200822, 0.556826).lineTo(0.191694, 0.693750).lineTo(0.100411, 0.693750).close()
loop4=wp_sketch2.moveTo(0.638980, 0.556826).lineTo(0.638980, 0.356003).lineTo(0.730263, 0.356003).lineTo(0.721135, 0.693750).lineTo(0.629852, 0.693750).close()
solid2=wp_sketch2.add(loop2).add(loop3).add(loop4).extrude(0.750000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
