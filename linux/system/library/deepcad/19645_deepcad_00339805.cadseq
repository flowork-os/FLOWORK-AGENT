# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00339805" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.539062, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.048355, -0.328125).lineTo(0.165789, -0.310855).lineTo(0.113980, 0.027632).threePointArc((0.056311, 0.016616), (0.000000, 0.000000)).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.570312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop1=wp_sketch1.moveTo(0.050658, -0.343750).lineTo(0.170066, -0.325658).lineTo(0.119408, 0.003618).threePointArc((0.059615, 0.004742), (0.000000, 0.000000)).close()
solid1=wp_sketch1.add(loop1).extrude(0.750000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.085938, 0.601562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch2.moveTo(0.003947, -0.030263).threePointArc((0.064344, -0.024658), (0.125000, -0.025000)).lineTo(0.125000, -0.021053).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.750000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.203125, 0.546875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop3=wp_sketch3.moveTo(0.000000, -0.003701).threePointArc((0.057867, 0.013981), (0.117188, 0.025905)).lineTo(0.112253, 0.055510).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(0.750000)
solid=solid.union(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.109375, 0.218750, 0.375000), cq.Vector(0.989177, 0.146730, -0.000000), cq.Vector(0.146730, -0.989177, 0.000000)))
loop4=wp_sketch4.moveTo(0.078947, 0.000000).circle(0.078947)
solid4=wp_sketch4.add(loop4).extrude(-0.312500)
solid=solid.cut(solid4)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
