import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, -0.328125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((-0.001129, -0.005674), (0.000000, -0.011349)).lineTo(0.022697, -0.022697).lineTo(0.022697, 1.078125).lineTo(0.000000, 1.066776).threePointArc((-0.001129, 1.061102), (0.000000, 1.055428)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.039062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
