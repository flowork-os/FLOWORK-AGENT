# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00249134" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.593750, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.234375, 0.000000).lineTo(1.234375, 1.182401).lineTo(0.000000, 1.182401).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(1.104441, 0.155921).lineTo(1.104441, 1.039474).lineTo(0.129934, 1.039474).lineTo(0.129934, 0.155921).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.539062)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
