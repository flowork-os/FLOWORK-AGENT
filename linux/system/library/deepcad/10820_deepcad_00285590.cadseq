import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.609375, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.041622, -0.100484), (0.142105, -0.142105)).lineTo(1.357895, -0.142105).threePointArc((1.458378, -0.100484), (1.500000, 0.000000)).lineTo(1.500000, 1.215789).threePointArc((1.458378, 1.316273), (1.357895, 1.357895)).lineTo(0.142105, 1.357895).threePointArc((0.041622, 1.316273), (0.000000, 1.215789)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.173684, 0.031579).circle(0.031579)
loop2=wp_sketch0.moveTo(0.173684, 1.184211).circle(0.031579)
loop3=wp_sketch0.moveTo(1.326316, 0.031579).circle(0.031579)
loop4=wp_sketch0.moveTo(1.326316, 1.184211).circle(0.031579)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.046875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
