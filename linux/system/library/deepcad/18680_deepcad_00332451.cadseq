wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.617188, -0.210938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.431743, -0.201480).threePointArc((0.618832, -0.242288), (0.805921, -0.201480)).lineTo(1.237664, 0.000000).threePointArc((1.371608, 0.208676), (1.237664, 0.417352)).lineTo(0.805921, 0.618832).threePointArc((0.618832, 0.659640), (0.431743, 0.618832)).lineTo(0.000000, 0.417352).threePointArc((-0.133943, 0.208676), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.100740, 0.201480).circle(0.086349)
loop2=wp_sketch0.moveTo(0.618832, 0.201480).circle(0.316612)
loop3=wp_sketch0.moveTo(1.136924, 0.201480).circle(0.086349)
