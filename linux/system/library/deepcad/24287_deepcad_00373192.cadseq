import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.750000, -0.375000), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.359375, 0.000000).lineTo(1.259211, 0.286184).lineTo(0.829934, 0.286184).lineTo(0.715461, 0.472204).lineTo(0.357730, 0.472204).lineTo(0.257566, 0.600987).lineTo(0.000000, 0.600987).lineTo(0.000000, 0.057237).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.257812)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.695312, -0.328125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop1=wp_sketch1.moveTo(1.226562, 0.000000).lineTo(1.162007, 0.193668).lineTo(0.748849, 0.193668).lineTo(0.632648, 0.374424).lineTo(0.258224, 0.374424).lineTo(0.167845, 0.503536).lineTo(0.000000, 0.503536).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.257812)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(0.257812, -0.718750, -0.328125), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop2=wp_sketch2.moveTo(1.257812, 0.000000).lineTo(1.191612, 0.198602).lineTo(0.754687, 0.198602).lineTo(0.648766, 0.383964).lineTo(0.278043, 0.383964).lineTo(0.185362, 0.503125).lineTo(0.000000, 0.503125).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(-0.257812)
solid=solid.cut(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
