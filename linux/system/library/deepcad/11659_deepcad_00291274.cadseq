# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00291274" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.648438, 0.000000, 0.468750), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.050329, 0.000000).circle(0.050329)
loop1=wp_sketch0.moveTo(0.645888, -0.150987).threePointArc((0.796875, 0.000000), (0.645888, 0.150987)).lineTo(0.050329, 0.150987).threePointArc((0.201316, 0.000000), (0.050329, -0.150987)).close()
loop2=wp_sketch0.moveTo(0.645888, 0.000000).circle(0.050329)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.101562)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
