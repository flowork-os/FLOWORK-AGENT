# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00315513" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.398438, -0.429688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.259128, 0.000000).lineTo(0.259128, 1.070312).lineTo(0.000000, 1.070312).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.123931, 0.901316).circle(0.067599)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.320312)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, -0.429688, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.249671, 0.000000).lineTo(0.249671, 1.078125).lineTo(0.000000, 1.078125).lineTo(0.000000, 0.000000).close()
loop3=wp_sketch1.moveTo(0.124836, 0.930592).circle(0.068092)
loop4=wp_sketch1.moveTo(0.124836, 0.113487).circle(0.056743)
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).extrude(0.320312)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.218750, 0.632812, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop5=wp_sketch2.moveTo(0.078947, 0.000000).circle(0.077303)
solid2=wp_sketch2.add(loop5).extrude(0.515625)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, 0.492188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.063158, 0.000000).circle(0.063158)
solid3=wp_sketch3.add(loop6).extrude(-0.320312, both=True)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.687500, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop7=wp_sketch4.moveTo(0.063158, 0.000000).circle(0.061842)
solid4=wp_sketch4.add(loop7).extrude(-0.320312, both=True)
solid=solid.cut(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.460938, 0.476562, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop8=wp_sketch5.moveTo(0.067105, 0.000000).circle(0.067105)
solid5=wp_sketch5.add(loop8).extrude(-0.320312, both=True)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
