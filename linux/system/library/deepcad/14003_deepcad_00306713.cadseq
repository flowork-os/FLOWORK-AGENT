# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00306713" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.492188, -0.265625, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(1.242188, 0.000000).lineTo(1.242188, 0.536102).lineTo(0.000000, 0.536102).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.104605, 0.183059).lineTo(0.104605, 0.353043).lineTo(0.091530, 0.353043).lineTo(0.091530, 0.183059).close()
loop2=wp_sketch0.moveTo(0.196135, 0.183059).lineTo(0.196135, 0.353043).lineTo(0.183059, 0.353043).lineTo(0.183059, 0.183059).close()
loop3=wp_sketch0.moveTo(0.640707, 0.183059).lineTo(0.640707, 0.353043).lineTo(0.627632, 0.353043).lineTo(0.627632, 0.183059).close()
loop4=wp_sketch0.moveTo(1.176809, 0.183059).lineTo(1.176809, 0.353043).lineTo(1.150658, 0.353043).lineTo(1.150658, 0.183059).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
