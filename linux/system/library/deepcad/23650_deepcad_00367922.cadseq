import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.000000, -0.296875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.396711, 0.000000).lineTo(0.396711, 1.046875).lineTo(0.000000, 1.046875).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.231414, 0.528947).lineTo(0.231414, 1.013816).lineTo(0.066118, 1.013816).lineTo(0.066118, 0.528947).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.023438)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
