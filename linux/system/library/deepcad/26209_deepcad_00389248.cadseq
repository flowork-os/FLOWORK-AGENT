# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00389248" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.355263).lineTo(0.000000, 0.355263).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.078947, 0.126316).circle(0.023684)
loop2=wp_sketch0.moveTo(0.378947, 0.173684).circle(0.094737)
loop3=wp_sketch0.moveTo(0.671053, 0.126316).circle(0.023684)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.171875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.468750, 0.171875, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch1.moveTo(0.098684, 0.000000).circle(0.098684)
loop5=wp_sketch1.moveTo(0.098684, 0.000000).circle(0.074013)
solid1=wp_sketch1.add(loop4).add(loop5).extrude(0.062500)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
