import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.750000).threePointArc((0.219670, 0.530330), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(0.584211, 0.094737).threePointArc((0.615134, 0.134866), (0.655263, 0.165789)).lineTo(0.655263, 0.576316).threePointArc((0.336563, 0.413437), (0.173684, 0.094737)).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.234375, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.000000, -0.750000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.347368, 0.189474).threePointArc((0.828947, 1.018421), (0.000000, 1.500000)).lineTo(0.000000, 0.757895).lineTo(0.000000, 0.000000).close()
