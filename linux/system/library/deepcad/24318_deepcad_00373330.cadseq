loop4=wp_sketch1.moveTo(0.094737, 0.173684).threePointArc((0.083352, 0.509355), (0.157895, 0.836842)).lineTo(0.568421, 0.836842).threePointArc((0.410767, 1.158212), (0.094737, 1.326316)).lineTo(0.094737, 0.915789).close()
solid1=wp_sketch1.add(loop2).add(loop3).add(loop4).extrude(0.234375, both=True)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch2.moveTo(0.047368, 0.457895).threePointArc((0.148521, -0.291572), (0.750000, -0.750000)).lineTo(0.750000, 0.000000).lineTo(0.000000, 0.000000).close()
loop6=wp_sketch2.moveTo(0.000000, 0.000000).threePointArc((0.234394, -0.394168), (0.655263, -0.576316)).lineTo(0.655263, -0.165789).threePointArc((0.615134, -0.134866), (0.584211, -0.094737)).lineTo(0.173684, -0.094737).close()
solid2=wp_sketch2.add(loop5).add(loop6).extrude(0.234375, both=True)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
