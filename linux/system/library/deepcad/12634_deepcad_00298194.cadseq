# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00298194" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.625000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.059211, 0.000000).circle(0.059211)
loop1=wp_sketch0.moveTo(0.059211, 0.000000).circle(0.034539)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.742188)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.046875, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.082895, 0.000000).circle(0.082895)
loop3=wp_sketch1.moveTo(0.000000, 0.000000).threePointArc((0.059003, -0.067208), (0.136431, -0.022451)).threePointArc((0.149383, -0.012952), (0.139885, 0.000000)).threePointArc((0.093556, 0.057577), (0.027632, 0.024178)).threePointArc((0.013667, 0.013837), (0.024178, 0.000000)).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.742188)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
