# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00220889" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.742188, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.319737, 0.000000).circle(0.319737)
loop1=wp_sketch0.moveTo(0.319737, 0.000000).circle(0.206497)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.453125)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.421875, -0.320312, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.801809, 0.000000).threePointArc((1.178263, 0.320724), (0.801809, 0.641447)).lineTo(0.000000, 0.641447).threePointArc((0.320724, 0.320724), (0.000000, 0.000000)).close()
loop3=wp_sketch1.moveTo(0.851151, 0.320724).circle(0.172697)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.226562)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
