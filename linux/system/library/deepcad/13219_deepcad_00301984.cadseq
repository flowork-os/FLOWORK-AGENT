import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.090789, 0.000000).circle(0.090789)
loop1=wp_sketch0.moveTo(0.090789, 0.000000).circle(0.028372)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.046875)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.359375, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop2=wp_sketch1.moveTo(0.090789, 0.000000).circle(0.090789)
loop3=wp_sketch1.moveTo(0.090789, 0.000000).circle(0.028372)
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.046875)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop4=wp_sketch2.moveTo(0.675000, -0.047368).lineTo(1.125000, 0.000000).threePointArc((1.027007, 0.088816), (1.125000, 0.177632)).lineTo(0.663158, 0.225000).lineTo(0.000000, 0.177632).threePointArc((0.093286, 0.088816), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.663158, 0.094737).circle(0.023684)
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.046875)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.664062, -0.085938, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch3.moveTo(0.675000, -0.047368).lineTo(1.125000, 0.000000).threePointArc((1.027007, 0.088816), (1.125000, 0.177632)).lineTo(0.663158, 0.225000).lineTo(0.000000, 0.177632).threePointArc((0.093286, 0.088816), (0.000000, 0.000000)).close()
loop7=wp_sketch3.moveTo(0.663158, 0.094737).circle(0.023684)
solid3=wp_sketch3.add(loop6).add(loop7).extrude(0.046875)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
