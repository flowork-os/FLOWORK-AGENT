# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00315298" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.382812, 0.000000, -0.234375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.310855, 0.000000).lineTo(0.310855, 0.351562).lineTo(0.000000, 0.351562).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.062911, 0.092516).circle(0.040707)
loop2=wp_sketch0.moveTo(0.074013, 0.266447).circle(0.044408)
loop3=wp_sketch0.moveTo(0.236842, 0.096217).circle(0.037007)
loop4=wp_sketch0.moveTo(0.251645, 0.236842).circle(0.040707)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).extrude(0.140625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
