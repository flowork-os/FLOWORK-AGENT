# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00262424" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, 0.000000, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.320312, 0.000000).lineTo(1.320312, 0.833882).lineTo(0.000000, 0.833882).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.359375)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.234375, -0.359375, 0.421875), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.984375, -0.497368).lineTo(0.984375, 0.000000).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(-0.359375)
solid=solid.cut(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.570312, -0.359375, -0.414062), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.119737, 0.000000).lineTo(0.119737, 0.710938).lineTo(0.000000, 0.710938).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.250000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, -0.609375, -0.171875), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop3=wp_sketch3.moveTo(0.162829, 0.468750).lineTo(0.000000, 0.468750).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop3).extrude(-0.359375)
solid=solid.cut(solid3)
# workplane for sketch 4
wp_sketch4 = cq.Workplane(cq.Plane(cq.Vector(-0.445312, -0.359375, -0.414062), cq.Vector(0.999398, 0.024541, 0.024534), cq.Vector(0.024541, 0.000000, -0.999699)))
loop4=wp_sketch4.moveTo(0.445312, 0.000000).lineTo(0.000000, 0.248437).lineTo(0.000000, 0.000000).close()
solid4=wp_sketch4.add(loop4).extrude(-0.156250)
solid=solid.union(solid4)
# workplane for sketch 5
wp_sketch5 = cq.Workplane(cq.Plane(cq.Vector(0.437500, -0.359375, -0.203125), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop5=wp_sketch5.moveTo(0.106579, 0.000000).circle(0.106579)
solid5=wp_sketch5.add(loop5).extrude(-0.359375)
solid=solid.cut(solid5)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
