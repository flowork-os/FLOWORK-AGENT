# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00319045" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.143750, -0.088898).lineTo(0.179688, -0.030263).lineTo(0.088898, 0.024589).lineTo(0.143750, 0.111595).lineTo(0.090789, 0.143750).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.640625)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.218750, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop1=wp_sketch1.moveTo(0.123026, 0.000000).lineTo(0.123026, 0.687500).lineTo(0.000000, 0.492105).lineTo(0.000000, 0.000000).close()
solid1=wp_sketch1.add(loop1).extrude(0.640625)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.226562, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch2.moveTo(0.142105, 0.000000).lineTo(0.442105, 0.489474).lineTo(0.568421, 0.686842).lineTo(0.465789, 0.750000).lineTo(0.039474, 0.055263).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop2).extrude(0.640625)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
