# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00280280" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.544737).lineTo(0.000000, 0.544737).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.276316, 0.323684).lineTo(0.276316, 0.473684).lineTo(0.063158, 0.473684).lineTo(0.063158, 0.323684).close()
loop2=wp_sketch0.moveTo(0.584211, 0.386842).circle(0.110526)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.250000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop3=wp_sketch1.moveTo(0.750000, 0.000000).lineTo(0.750000, 0.544737).lineTo(0.000000, 0.544737).lineTo(0.000000, 0.000000).close()
loop4=wp_sketch1.moveTo(0.276316, 0.323684).lineTo(0.276316, 0.473684).lineTo(0.063158, 0.473684).lineTo(0.063158, 0.323684).close()
loop5=wp_sketch1.moveTo(0.584211, 0.386842).circle(0.110526)
solid1=wp_sketch1.add(loop3).add(loop4).add(loop5).extrude(0.250000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.070312, 0.000000, -0.109375), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop6=wp_sketch2.moveTo(0.175987, 0.000000).lineTo(0.175987, 0.835938).lineTo(0.000000, 0.835938).lineTo(0.000000, 0.659951).lineTo(0.070395, 0.659951).lineTo(0.070395, 0.087993).lineTo(0.000000, 0.087993).lineTo(0.000000, 0.000000).close()
solid2=wp_sketch2.add(loop6).extrude(0.250000)
solid=solid.union(solid2)
# workplane for sketch 3
wp_sketch3 = cq.Workplane(cq.Plane(cq.Vector(0.000000, 0.187500, -0.109375), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop7=wp_sketch3.moveTo(0.133224, 0.000000).lineTo(0.133224, 0.150987).lineTo(0.044408, 0.150987).lineTo(0.044408, 0.666118).lineTo(0.133224, 0.666118).lineTo(0.133224, 0.843750).lineTo(0.026645, 0.843750).lineTo(0.000000, 0.843750).lineTo(0.000000, 0.000000).close()
solid3=wp_sketch3.add(loop7).extrude(0.250000)
solid=solid.union(solid3)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
