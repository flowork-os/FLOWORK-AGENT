import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.406250, 0.000000, 0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.006398, -0.059239), (0.059868, -0.085526)).lineTo(0.401974, -0.085526).lineTo(0.752632, -0.085526).threePointArc((0.801826, -0.056885), (0.803947, 0.000000)).lineTo(0.538816, 0.573026).threePointArc((0.401974, 0.659681), (0.265132, 0.573026)).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.059868, -0.025658).circle(0.025658)
loop2=wp_sketch0.moveTo(0.401974, 0.513158).circle(0.085526)
loop3=wp_sketch0.moveTo(0.752632, -0.025658).circle(0.025658)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).extrude(0.054688)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
