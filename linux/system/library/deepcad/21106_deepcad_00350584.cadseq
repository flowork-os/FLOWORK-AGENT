wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.656250, -0.367188, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.022023, -0.007492), (0.014803, -0.029605)).threePointArc((0.662850, -0.381776), (1.302632, -0.014803)).threePointArc((1.302722, -0.000090), (1.317434, 0.000000)).threePointArc((1.305885, 0.744353), (0.666118, 1.125000)).threePointArc((0.651316, 1.110378), (0.636513, 1.125000)).threePointArc((-0.000396, 0.742790), (0.000000, 0.000000)).close()
