# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00235934" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.578125, 0.000000, -0.085938), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.818586, 0.000000).threePointArc((0.985816, 0.082895), (0.818586, 0.165789)).lineTo(0.000000, 0.165789).threePointArc((-0.164684, 0.082895), (0.000000, 0.000000)).close()
loop1=wp_sketch0.moveTo(-0.062171, 0.082895).circle(0.082895)
loop2=wp_sketch0.moveTo(0.880757, 0.082895).circle(0.082895)
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).extrude(0.070312)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
