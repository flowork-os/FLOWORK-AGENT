# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00357115" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.625000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop0=wp_sketch0.moveTo(0.635526, 0.000000).circle(0.622286)
loop1=wp_sketch0.moveTo(0.370724, -0.132401).lineTo(0.503125, 0.000000).lineTo(0.370724, 0.132401).lineTo(0.225082, 0.000000).close()
loop2=wp_sketch0.moveTo(0.635526, 0.158882).lineTo(0.767928, 0.291283).lineTo(0.635526, 0.436924).lineTo(0.489885, 0.291283).close()
loop3=wp_sketch0.moveTo(0.635526, -0.410444).lineTo(0.767928, -0.278043).lineTo(0.622286, -0.145641).lineTo(0.489885, -0.291283).close()
loop4=wp_sketch0.moveTo(0.635526, 0.000000).circle(0.092681)
loop5=wp_sketch0.moveTo(0.913569, -0.145641).lineTo(1.059211, 0.000000).lineTo(0.913569, 0.145641).lineTo(0.767928, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).add(loop2).add(loop3).add(loop4).add(loop5).extrude(0.367188, both=True)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, 0.000000), cq.Vector(0.000000, 0.000000, 1.000000)))
loop6=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.757895)
loop7=wp_sketch1.moveTo(0.757895, 0.000000).circle(0.631579)
solid1=wp_sketch1.add(loop6).add(loop7).extrude(0.429688, both=True)
solid=solid.union(solid1)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
