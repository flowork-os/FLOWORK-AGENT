# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00370808" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, 0.000000), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.125000, 0.000000).lineTo(1.125000, 0.284211).lineTo(0.556579, 0.698684).lineTo(0.000000, 0.698684).lineTo(0.000000, 0.000000).close()
loop1=wp_sketch0.moveTo(0.414474, 0.355263).circle(0.106579)
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.421875)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
