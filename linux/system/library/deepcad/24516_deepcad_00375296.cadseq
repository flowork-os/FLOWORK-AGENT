# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00375296" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.375000, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.189474, 0.000000).circle(0.189474)
loop1=wp_sketch0.moveTo(0.114474, -0.126316).lineTo(0.260526, -0.126316).lineTo(0.331579, 0.000000).lineTo(0.260526, 0.126316).lineTo(0.114474, 0.126316).lineTo(0.043421, 0.000000).close()
solid0=wp_sketch0.add(loop0).add(loop1).extrude(0.125000)
solid=solid0
# workplane for sketch 1
wp_sketch1 = cq.Workplane(cq.Plane(cq.Vector(0.500000, 0.000000, -0.062500), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop2=wp_sketch1.moveTo(0.126316, 0.000000).circle(0.126316)
loop3=wp_sketch1.moveTo(0.071053, -0.076316).lineTo(0.178947, -0.076316).lineTo(0.213158, 0.028947).lineTo(0.126316, 0.094737).lineTo(0.036842, 0.028947).close()
solid1=wp_sketch1.add(loop2).add(loop3).extrude(0.125000)
solid=solid.union(solid1)
# workplane for sketch 2
wp_sketch2 = cq.Workplane(cq.Plane(cq.Vector(-0.015625, 0.000000, -0.148438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop4=wp_sketch2.moveTo(0.080592, 0.063322).threePointArc((0.061365, 0.032784), (0.028783, 0.017270)).lineTo(0.512336, 0.017270).threePointArc((0.527678, 0.019146), (0.541118, 0.011513)).threePointArc((0.519274, 0.087300), (0.546875, 0.161184)).threePointArc((0.534478, 0.149225), (0.518092, 0.143914)).lineTo(0.028783, 0.143914).threePointArc((0.011887, 0.148376), (0.000000, 0.161184)).threePointArc((0.018098, 0.080592), (0.000000, 0.000000)).close()
loop5=wp_sketch2.moveTo(0.460526, 0.051809).threePointArc((0.492188, 0.083470), (0.460526, 0.115132)).lineTo(0.080592, 0.115132).threePointArc((0.048931, 0.083470), (0.080592, 0.051809)).close()
solid2=wp_sketch2.add(loop4).add(loop5).extrude(0.125000)
solid=solid.union(solid2)

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
