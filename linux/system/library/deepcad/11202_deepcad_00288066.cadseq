wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.023438, 0.000000, -0.023438), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.013816, 0.000000).threePointArc((0.023191, 0.009375), (0.032566, 0.000000)).lineTo(0.046875, 0.000000).lineTo(0.046875, 0.013816).threePointArc((0.037500, 0.023191), (0.046875, 0.032566)).lineTo(0.046875, 0.046875).lineTo(0.032566, 0.046875).threePointArc((0.023191, 0.037500), (0.013816, 0.046875)).lineTo(0.000000, 0.046875).lineTo(0.000000, 0.032566).threePointArc((0.009375, 0.023191), (0.000000, 0.013816)).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.750000)
solid=solid0

