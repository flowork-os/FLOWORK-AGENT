loop0=wp_sketch0.moveTo(0.000000, 0.000000).threePointArc((0.041447, -1.350550), (0.082895, 0.000000)).lineTo(0.082895, 0.096711).lineTo(0.041447, 0.096711).lineTo(0.000000, 0.096711).lineTo(0.000000, 0.000000).close()
