wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(0.000000, -0.109375, 0.023438), cq.Vector(0.000000, 1.000000, -0.000000), cq.Vector(1.000000, 0.000000, 0.000000)))
loop0=wp_sketch0.moveTo(0.210938, 0.000000).lineTo(0.210938, 0.015543).lineTo(0.157648, 0.015543).threePointArc((0.138807, 0.023347), (0.131003, 0.042188)).lineTo(0.131003, 0.048849).lineTo(0.079934, 0.048849).lineTo(0.079934, 0.042188).threePointArc((0.072130, 0.023347), (0.053289, 0.015543)).lineTo(0.000000, 0.015543).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(-0.750000)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
