# [FL_INDEX: keywords="deepcad, cad_sequence, sketch_extrude, parametric_primitives, deepcad_00313518" | COT="DeepCAD sketch-extrude sequence from 3DCodeverse"]
import cadquery as cq
# workplane for sketch 0
wp_sketch0 = cq.Workplane(cq.Plane(cq.Vector(-0.750000, 0.000000, -0.679688), cq.Vector(1.000000, 0.000000, -0.000000), cq.Vector(0.000000, -1.000000, 0.000000)))
loop0=wp_sketch0.moveTo(1.375000, 0.000000).lineTo(1.375000, 1.172368).lineTo(0.984211, 1.172368).lineTo(0.984211, 0.390789).lineTo(0.390789, 0.390789).lineTo(0.390789, 0.781579).lineTo(0.000000, 0.781579).lineTo(0.000000, 0.000000).close()
solid0=wp_sketch0.add(loop0).extrude(0.390625)
solid=solid0

if __name__ == '__main__':
    import sys
    out = sys.argv[1] if len(sys.argv) > 1 else '/tmp/out.step'
    cq.exporters.export(solid, out)
