{
  "$schema": "https://floworkos.com/schemas/barrier.v1.json",
  "pipeline_id": "software_company_engineering_dag",
  "version": "1.0.0",
  "barriers": [
    {
      "id": "barrier_1_specs",
      "name": "Specification Approval Gate",
      "required_artifacts": [
        "specs/01_product_requirement_document.md",
        "specs/02_system_architecture_design.md"
      ],
      "unblocks": [
        "node_backend_engineering",
        "node_frontend_engineering"
      ]
    },
    {
      "id": "barrier_2_code_complete",
      "name": "Code Complete Gate",
      "required_artifacts": [
        "src/ipc/gateway.rs",
        "src/ui/client.ts"
      ],
      "unblocks": [
        "node_security_audit",
        "node_quality_control"
      ]
    },
    {
      "id": "barrier_3_release_clearance",
      "name": "Production Release Gate",
      "required_conditions": {
        "security_audit_verdict": "APPROVED",
        "max_critical_cve": 0,
        "qc_terminal_exit_code": 0
      },
      "unblocks": [
        "node_release_deployment"
      ]
    }
  ]
}
