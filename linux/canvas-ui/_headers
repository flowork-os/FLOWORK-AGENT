/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Headers: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS

/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/canvas/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/tools/*
  Cache-Control: public, max-age=14400, must-revalidate

/canvas/tools/*
  Cache-Control: public, max-age=14400, must-revalidate
