{
  "name": "quant_risk_engine",
  "version": "1.0.0",
  "description": "Deterministic quantitative analysis, risk metrics calculation (VaR, Sharpe, Kelly Criterion, volatility), and trade execution order structuring.",
  "category": "finance",
  "entrypoint": "engine.py",
  "command": "python3 engine.py",
  "parameters": {
    "action": {
      "type": "string",
      "required": true,
      "enum": ["quant_analysis", "risk_sizing", "structure_order"],
      "description": "Calculation routine to perform"
    },
    "ticker": {
      "type": "string",
      "required": false,
      "description": "Asset ticker (e.g. BTC, ETH, NVDA, AAPL)"
    },
    "price": {
      "type": "number",
      "required": false,
      "description": "Current asset price"
    },
    "portfolio_value": {
      "type": "number",
      "required": false,
      "description": "Total portfolio account balance"
    },
    "risk_tolerance_pct": {
      "type": "number",
      "required": false,
      "description": "Max account risk percentage per trade (e.g. 1.0 - 2.5)"
    },
    "entry_price": {
      "type": "number",
      "required": false,
      "description": "Planned entry level"
    },
    "stop_loss": {
      "type": "number",
      "required": false,
      "description": "Planned stop loss level"
    },
    "take_profit": {
      "type": "number",
      "required": false,
      "description": "Planned take profit target level"
    },
    "win_rate": {
      "type": "number",
      "required": false,
      "description": "Historical win rate estimate (0.0 - 1.0)"
    }
  }
}