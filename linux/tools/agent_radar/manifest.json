{
  "name": "agent_radar",
  "category": "orchestration",
  "description": "Scans and discovers the optimal autonomous specialist subagent from system/subagent registry based on task intent and input contracts.",
  "command": "node tools/agent_radar/main.mjs",
  "entry": "main.mjs",
  "author": "Flowork Sovereign Core",
  "version": "1.0.0",
  "keywords": [
    "agent",
    "agents",
    "agent_discovery",
    "agent_radar",
    "agent_search",
    "delegation",
    "dispatcher",
    "orchestration",
    "persona",
    "quality_control",
    "radar",
    "red_team",
    "roles",
    "routing",
    "security_auditor",
    "specialist",
    "subagent",
    "subagent_discovery",
    "subagents",
    "swarm"
  ],
  "exclude_keywords": [
    "chat_bot",
    "hallucination",
    "unverified"
  ],
  "parameters": {
    "query": {
      "type": "string",
      "description": "Description of the task intent, technical domain, or problem to find specialist subagents for",
      "default": "api database backend implementation"
    }
  }
}
