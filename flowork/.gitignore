# [FL_INDEX: keywords="gitignore, security, credentials, dev_flowork, hygiene" | purpose="Standard Git ignore rules to prevent credential and residual leak"]
# Flowork OS & Developer sensitive files
**/.flowork/*.flowork
**/.flowork/dev.flowork
!**/.flowork/.gitkeep
*.flowork
*.secret
*.key
*.pem
*.token
*.env
*.env.*
!.env.example

# Temporary and cache directories
.FL_BIN/scratch/
.FL_BIN/screenshots/
**/target/
**/node_modules/
**/__pycache__/
*.pyc
*.log

# OS generated files
.DS_Store
Thumbs.db
